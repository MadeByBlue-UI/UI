        end
    end)
    UIS.InputChanged:Connect(function(input)
        if X.mdrag and input.UserInputType == Enum.UserInputType.MouseMovement then
            local h = math.max(vp.AbsoluteSize.Y, 1)
            X.panX = math.clamp(X.panX - (input.Position.X - X.lastMX) / h, -0.8, 0.8)
            X.panY = math.clamp(X.panY + (input.Position.Y - X.lastMY) / h, -0.8, 0.8)
            X.lastMX, X.lastMY = input.Position.X, input.Position.Y
        elseif dragging3d and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            angle -= (input.Position.X - lastX) * 0.012
            lastX = input.Position.X
        elseif X.rdrag and input.UserInputType == Enum.UserInputType.MouseMovement then
            angle -= (input.Position.X - lastX) * 0.012
            X.pitch = math.clamp(X.pitch + (input.Position.Y - X.lastY) * 0.008, -1.2, 1.2)
            lastX, X.lastY = input.Position.X, input.Position.Y
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
