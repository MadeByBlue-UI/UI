    function startView()
        if viewConn then return end
        tickAcc, lastSig, lastChar, lastWorn = 0.5, "", nil, nil
        if S.previewSrc ~= "Jeu" then loadBase() end
        viewConn = RunS.Heartbeat:Connect(function(dt)
            tickAcc += dt
            if tickAcc >= 0.2 then
                tickAcc = 0
                local char = lp.Character
                if S.previewSrc == "Jeu" or X.baseFailed then
                    -- ancien mode : on reconstruit la copie quand ton perso change
                    local sig = char and buildSig(char) or nil
                    if sig and (sig ~= lastSig or char ~= lastChar) then
                        lastSig, lastChar = sig, char
                        local okR, errR = pcall(rebuildModel)
                        if not okR then
                            setStatus("Erreur aperçu : " .. tostring(errR))
                            warn("[Catalogue] erreur aperçu :", errR)
                        end
                    end
                elseif X.base then
                    -- mode Compte : avatar construit une fois, puis on ne touche qu'aux objets qui changent
                    if lastSig ~= "compte" then
                        lastSig = "compte"
                        local okR, errR = pcall(rebuildModel)
                        if not okR then warn("[Catalogue] erreur aperçu :", errR) end
                    else
                        local okS, errS = pcall(X.syncAcc)
                        if not okS then warn("[Catalogue] erreur aperçu :", errS) end
                    end
                end
                local key, ids = wornKey()
                if key ~= lastWorn then
                    lastWorn = key
                    rebuildList(ids)
                end
            end
            if autoRot and not dragging3d and not X.rdrag and not X.mdrag then angle += dt * 0.7 end
            if X.pose > 1 and model then
                pcall(poseStep, X.joints)
                if X.joints2 then pcall(poseStep, X.joints2) end
            end
            pcall(X.sideStep)
            updateCam()
        end)
    end

    function stopView()
        if viewConn then viewConn:Disconnect(); viewConn = nil end
