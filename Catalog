        local function buildCard(i, pz, srcRig)
            local frame = Instance.new("TextButton")
            frame.LayoutOrder = i
            frame.BackgroundColor3 = Color3.new(1, 1, 1)
            frame.BackgroundTransparency = 0.9
            frame.BorderSizePixel = 0
            frame.Text = ""
            frame.AutoButtonColor = false
            frame.ZIndex = 10
            frame.Parent = bgrid
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)
            local stroke = Instance.new("UIStroke", frame)
            stroke.Color = Color3.fromRGB(255, 205, 90)
            stroke.Thickness = 1.5
            stroke.Transparency = 1
            local sc = Instance.new("UIScale", frame)
            sc.Scale = 0.6

            local vf = Instance.new("ViewportFrame")
            vf.Position = UDim2.fromOffset(2, 2)
            vf.Size = UDim2.new(1, -4, 1, -24)
            vf.BackgroundTransparency = 1
            vf.Ambient = Color3.fromRGB(175, 175, 190)
            vf.LightColor = Color3.new(1, 1, 1)
            vf.ZIndex = 11
            vf.Active = false
            vf.Parent = frame

            local nm = Instance.new("TextLabel")
            nm.Position = UDim2.new(0, 2, 1, -22)
            nm.Size = UDim2.new(1, -4, 0, 20)
            nm.BackgroundTransparency = 1
            nm.Text = pz[1]
            nm.TextColor3 = Color3.new(1, 1, 1)
            nm.Font = Enum.Font.GothamBold
            nm.TextSize = 10
            nm.TextTruncate = Enum.TextTruncate.AtEnd
            nm.ZIndex = 12
            nm.Parent = frame

            local entry = { frame = frame, stroke = stroke, name = nm, scale = sc, anim = false, name_ = pz[1] }

            local m = miniSource()
            if m then
                -- WorldModel : nécessaire pour que les articulations (poses) s'actualisent dans un ViewportFrame
                local wm = Instance.new("WorldModel")
                wm.Parent = vf
                m.Parent = wm
                m:PivotTo(CFrame.new(0, 0, 0))
                local J = {}
                for _, d in ipairs(m:GetDescendants()) do
                    if d:IsA("Motor6D") then J[d.Name] = d end
                end
                local cam2 = Instance.new("Camera")
                cam2.FieldOfView = 40
                vf.CurrentCamera = cam2
                cam2.Parent = vf
                local cf, size = m:GetBoundingBox()
                local center = cf.Position
                local aspect = 78 / 88
                local th = math.tan(math.rad(20))
                local need = math.max(math.max(size.Y, 5.4) / 2 / th, 5.8 / 2 / (th * aspect)) * 1.12
                cam2.CFrame = CFrame.lookAt(center + Vector3.new(0, 0.2, need), center + Vector3.new(0, 0, 0))
                entry.J = J
                local nme = pz[1]
                if i > 1 then
                    if X.FIXED[nme] then
                        pcall(X.poseApply, J, nme, 0)
                    else
                        entry.anim = true
                        pcall(X.poseApply, J, nme, 0.3)
                    end
                end
            end

            frame.MouseEnter:Connect(function()
                if i ~= X.pose then tween(frame, 0.12, { BackgroundTransparency = 0.78 }) end
            end)
            frame.MouseLeave:Connect(function() paintCards() end)
            frame.MouseButton1Click:Connect(function()
                setPose(i)
                closeBubble()
            end)
            cards[i] = entry
            return entry
        end

        local function ensureCards()
            if #cards > 0 then return end
            buildTok += 1
            local my = buildTok
            for _, c in ipairs(cards) do c.frame:Destroy() end
            cards = {}
            task.spawn(function()
                for i, pz in ipairs(X.POSES) do
                    if my ~= buildTok or not bubble.Parent then return end
                    local e = buildCard(i, pz)
                    paintCards()
                    -- apparition en cascade
                    tween(e.scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
                    task.wait(0.03) -- une carte par image : pas de freeze
                end
            end)
        end

