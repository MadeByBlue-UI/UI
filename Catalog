        f.BorderSizePixel = 0
        f.Rotation = rot or 0
        f.Parent = parent
        if round then Instance.new("UICorner", f).CornerRadius = round end
        return f
    end
    local function ring(parent, w, h, x, y, col, th)
        local f = blk(parent, w, h, x, y, col, 1, UDim.new(1, 0))
        local st = Instance.new("UIStroke", f)
        st.Color = col
        st.Thickness = th or 2
