    -- Tri des listes locales (Favoris / Récents / Collections), prix compris
    function X.sortLocal(list, kind)
        local sn = SORT_LIST[S.sortIdx]
        if sn == "PriceLowToHigh" or sn == "PriceHighToLow" then
            local asc = (sn == "PriceLowToHigh")
            table.sort(list, function(a, b)
                local pa = a.Price or (asc and math.huge or -1)
                local pb = b.Price or (asc and math.huge or -1)
                if pa ~= pb then
                    if asc then return pa < pb else return pa > pb end
                end
                return a.Name < b.Name
            end)
        elseif kind ~= "recent" then
            table.sort(list, function(a, b) return a.Name < b.Name end)
        end
    end

    -- ---------- Recherche ----------
    function runSearch(keyword)
        searchId += 1
        local mySearch = searchId
        currentKeyword = keyword or ""
        clearGrid()
        pages = nil

        -- Onglets Récents / Favoris / Collec. : pas de recherche réseau
        if not FILTERS[currentFilter][2] then
            local kind = FILTERS[currentFilter][3]
            local list = {}
            local kw = currentKeyword:lower()
            local function add(id, nm, pr)
                if id and (kw == "" or tostring(nm):lower():find(kw, 1, true)) then
                    table.insert(list, { Id = id, Name = tostring(nm), Price = pr })
                end
            end
            if kind == "recent" then
                for _, r in ipairs(X.recents) do add(r.id, r.name, r.p) end
            elseif kind == "fav" then
                for key, e in pairs(favs) do add(tonumber(key), e.n, e.p) end
            elseif kind == "coll" then
                if X.activeColl then
                    for key, e in pairs(X.activeColl.items) do add(tonumber(key), e.n, e.p) end
                end
            end
            X.sortLocal(list, kind)
            fillPage(list, mySearch)
            if kind == "recent" then
                setStatus(#list == 0 and "Rien porté récemment" or (#list .. " récents"))
            elseif kind == "fav" then
                setStatus(#list == 0 and "Aucun favori (clique sur Fav sur une carte)" or (#list .. " favoris"))
            else
                if not X.activeColl then
                    setStatus("Aucune collection active : crée-en une dans l'onglet Collec.")
                else
                    setStatus(#list == 0 and ("« " .. X.activeColl.name .. " » est vide (bouton +Col sur les cartes)")
                        or ("« " .. X.activeColl.name .. " » : " .. #list .. " objets"))
                end
            end
            return
        end

        if currentKeyword ~= "" then addHistory(currentKeyword) end
        setStatus("Recherche...")

        local params = CatalogSearchParams.new()
        params.SearchKeyword = currentKeyword
        if FILTERS[currentFilter][3] == "bundle" then
            pcall(function() params.BundleTypes = { Enum.BundleType.BodyParts } end)
        else
            params.AssetTypes = FILTERS[currentFilter][2]
        end
        local sortName = SORT_LIST[S.sortIdx] or "Auto"
        if sortName == "Auto" then
            params.SortType = currentKeyword ~= "" and Enum.CatalogSortType.Relevance or Enum.CatalogSortType.Bestselling
        else
            params.SortType = Enum.CatalogSortType[sortName]
        end
        params.IncludeOffSale = S.offSale
        params.Limit = S.pageLimit
        pcall(function()
            if S.freeOnly then
                params.MinPrice = 0
                params.MaxPrice = 0
            else
                local pmin, pmax = S.priceMin, S.priceMax
                if pmax > 0 and pmin > pmax then pmin, pmax = pmax, pmin end
                if pmin > 0 then params.MinPrice = pmin end
                if pmax > 0 then params.MaxPrice = pmax end
            end
        end)
        dprint("recherche", currentKeyword, sortName, S.pageLimit)

        local ok, res
        for i = 1, 3 do
            ok, res = pcall(function() return AES:SearchCatalog(params) end)
            if ok and res then break end
            task.wait(0.5 * i)
        end
        if mySearch ~= searchId then return end
        if not ok or not res then
            setStatus("Erreur de recherche (réessaie)")
            say("Recherche impossible pour le moment.")
            return
        end

        pages = res
        local okp, cur = pcall(function() return res:GetCurrentPage() end)
        if not okp then setStatus("Erreur de lecture") return end
        dprint("page:", #cur, cur[1] and tostring(cur[1].ItemType), cur[1] and cur[1].Name)
        fillPage(cur, mySearch)
        -- CORRECTIF : page vide après filtrage -> on charge les suivantes (max 5)
        local tries = 0
        while cardCount == 0 and pages and not pages.IsFinished and tries < 5 and mySearch == searchId do
            tries += 1
            loadMore()
        end
        if mySearch ~= searchId then return end
        setStatus(cardCount == 0 and "Aucun résultat" or (cardCount .. " objets"))
    end

    function loadMore()
        if loadingMore or not pages or pages.IsFinished then return end
        loadingMore = true
        local mySearch = searchId
        local ok = pcall(function() pages:AdvanceToNextPageAsync() end)
        if ok and mySearch == searchId then
            local okp, cur = pcall(function() return pages:GetCurrentPage() end)
            if okp then
                fillPage(cur, mySearch)
                setStatus(cardCount .. " objets")
            end
        end
        loadingMore = false
    end

