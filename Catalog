    function X.parseCode(text)
        local body = (text or ""):match("^%s*CAT1:(.+)$")
        if not body then return nil end
        local ok, d = pcall(function() return HttpS:JSONDecode(body) end)
        if not ok or type(d) ~= "table" or type(d.i) ~= "table" then return nil end
        local ids = {}
        for _, v in ipairs(d.i) do
            if type(v) == "number" and #ids < 20 then table.insert(ids, v) end
        end
        local ib
        if type(d.b) == "table" then
            ib = {}
            for g, bid in pairs(d.b) do
                if type(g) == "string" and type(bid) == "number" then ib[g] = bid end
            end
            if next(ib) == nil then ib = nil end
        end
        if #ids == 0 and not ib then return nil end
        return tostring(d.n or "Importé"), ids, ib
    end

