    -- 45000 -> "45,000"  |  1 200 000 -> "1.2M"
    function fmtNum(n)
        n = math.floor(n)
        if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
        local s = tostring(n):reverse():gsub("(%d%d%d)", "%1,"):reverse()
        if s:sub(1, 1) == "," then s = s:sub(2) end
        return s
    end

    -- CORRECTIF : détection d'un personnage (bundle) tolérante
    function X.isBundle(item)
        local t = item.ItemType
        if t == Enum.AvatarItemType.Bundle then return true end
        if t ~= nil and tostring(t):find("Bundle") then return true end
        if item.BundleType ~= nil then return true end
        return false
    end

