    function addSlider(label, key, min, max, step, fmt, onChange)
        local r = baseRow(label)
        local val = Instance.new("TextLabel")
        val.Size = UDim2.fromOffset(60, 20)
        val.AnchorPoint = Vector2.new(1, 0.5)
        val.Position = UDim2.new(1, -16, 0.5, 0)
        val.BackgroundTransparency = 1
        val.TextColor3 = Color3.fromRGB(200, 200, 200)
        val.Font = Enum.Font.GothamBold
        val.TextSize = 12
        val.TextXAlignment = Enum.TextXAlignment.Right
        val.Parent = r

        local hit = Instance.new("Frame")
        hit.Size = UDim2.fromOffset(220, 26)
        hit.AnchorPoint = Vector2.new(1, 0.5)
        hit.Position = UDim2.new(1, -86, 0.5, 0)
        hit.BackgroundTransparency = 1
        hit.Parent = r

        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, 0, 0, 6)
        bar.AnchorPoint = Vector2.new(0, 0.5)
        bar.Position = UDim2.new(0, 0, 0.5, 0)
        bar.BackgroundColor3 = Color3.new(1, 1, 1)
        bar.BackgroundTransparency = 0.85
        bar.BorderSizePixel = 0
        bar.Parent = hit
        Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = ACC.main
        reg(fill, "BackgroundColor3", "main")
        fill.BorderSizePixel = 0
        fill.Parent = bar
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(14, 14)
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.BorderSizePixel = 0
        knob.Parent = hit
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local function paint()
            local v = S[key]
            local a = math.clamp((v - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(a, 0, 1, 0)
            knob.Position = UDim2.new(a, 0, 0.5, 0)
            val.Text = fmt and fmt(v) or tostring(v)
        end

        local function setFromX(x)
            local rel = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
            local v = min + (max - min) * rel
            v = math.floor(v / step + 0.5) * step
            v = math.clamp(math.floor(v * 1000 + 0.5) / 1000, min, max)
            if v ~= S[key] then
                S[key] = v
                paint()
                if onChange then onChange(v) end
            end
        end

        hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                activeDrag = setFromX
                setFromX(input.Position.X)
            end
        end)

        table.insert(rows, { key = key, refresh = paint, apply = onChange })
        paint()
    end

    UIS.InputChanged:Connect(function(input)
        if activeDrag and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
