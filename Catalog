    -- Transparence des objets portés : réglage global (S.wornAlpha) + slider propre à chaque objet (adj[id].tr)
    function applyWornAlpha(acc, id)
        if not acc then return end
        -- Utiliser l'ID passé en paramètre ou le récupérer de l'attribut
        id = id or acc:GetAttribute("CatId")
        local a = id and adj[tostring(id)]
        local own = (a and a.tr) or 0
        local k = 1 - (1 - S.wornAlpha) * (1 - own)
        for _, d in ipairs(acc:GetDescendants()) do
            if d:IsA("BasePart") then
                if d:GetAttribute("OrigT") == nil then d:SetAttribute("OrigT", d.Transparency) end
                local o = d:GetAttribute("OrigT")
                d.Transparency = o + (1 - o) * k
            end
        end
    end

