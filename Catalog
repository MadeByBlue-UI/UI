            -- clic molette (ou Shift + clic) : déplacer l'avatar
            X.mdrag = true
            X.lastMX, X.lastMY = input.Position.X, input.Position.Y
        elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            dragging3d = true
            lastX = input.Position.X
        elseif t == Enum.UserInputType.MouseButton2 then
            -- clic droit maintenu : orbite complète (gauche/droite + haut/bas)
            X.rdrag = true
            lastX, X.lastY = input.Position.X, input.Position.Y
        end
    end)
    vp.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
