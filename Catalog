    end

    -- icône ronde dans un badge 30x30 : kind = scale | alpha | move | rot | color ; axis = x | y | z | nil
    function X.adjIcon(parent, kind, axis, col)
        local b = Instance.new("Frame")
        b.Size = UDim2.fromOffset(30, 30)
        b.AnchorPoint = Vector2.new(0, 0.5)
        b.Position = UDim2.new(0, 0, 0.5, 0)
        b.BackgroundColor3 = col
        b.BackgroundTransparency = 0.82
        b.BorderSizePixel = 0
        b.Parent = parent
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
        local st = Instance.new("UIStroke", b)
        st.Color = col
        st.Transparency = 0.35
        st.Thickness = 1.5
        local c = 15 -- centre
        if kind == "scale" then
            local o = blk(b, 18, 18, c, c, col, 1, UDim.new(0, 3))
            local s = Instance.new("UIStroke", o)
            s.Color, s.Thickness = col, 2
            blk(b, 8, 8, c + 3, c + 3, col, 0, UDim.new(0, 2))
        elseif kind == "alpha" then
            for gx = 0, 1 do
                for gy = 0, 1 do
                    local on = (gx + gy) % 2 == 0
                    blk(b, 8, 8, c - 4 + gx * 8, c - 4 + gy * 8, col, on and 0.05 or 0.65, UDim.new(0, 2))
                end
            end
        elseif kind == "move" then
            if axis == "z" then
                ring(b, 17, 17, c, c, col, 2)
                blk(b, 6, 6, c, c, col, 0, UDim.new(1, 0))
            elseif axis == "x" then
                blk(b, 17, 3, c, c, col, 0, UDim.new(1, 0))
                blk(b, 7, 7, c + 8, c, col, 0, nil, 45)
                blk(b, 7, 7, c - 8, c, col, 0, nil, 45)
            else
                blk(b, 3, 17, c, c, col, 0, UDim.new(1, 0))
                blk(b, 7, 7, c, c - 8, col, 0, nil, 45)
                blk(b, 7, 7, c, c + 8, col, 0, nil, 45)
            end
        elseif kind == "rot" then
            local w, h = 18, 18
            if axis == "x" then h = 8 elseif axis == "y" then w = 8 end
            ring(b, w, h, c, c, col, 2)
            blk(b, 6, 6, c + w / 2 * 0.7, c - h / 2 * 0.7, col, 0, UDim.new(1, 0))
        elseif kind == "color" then
            blk(b, 16, 16, c, c, col, 0, UDim.new(1, 0))
            ring(b, 20, 20, c, c, col, 1.5)
        elseif kind == "sparkle" then
            -- Icône de particules : étoile avec des petits points autour
            -- Étoile centrale
            blk(b, 2, 10, c, c, col, 0, UDim.new(1, 0))
            blk(b, 10, 2, c, c, col, 0, UDim.new(1, 0))
            blk(b, 7, 7, c, c, col, 0, nil, 45)
            blk(b, 7, 7, c, c, col, 0, nil, -45)
            -- Petits points autour
            for angle = 0, 270, 90 do
                local rad = math.rad(angle)
                local px = c + math.cos(rad) * 9
                local py = c + math.sin(rad) * 9
                blk(b, 3, 3, px, py, col, 0, UDim.new(1, 0))
            end
        end
        if axis then
            local t = Instance.new("TextLabel")
            t.Size = UDim2.fromOffset(12, 12)
            t.Position = UDim2.fromOffset(18, 18)
            t.BackgroundTransparency = 1
            t.Text = axis:upper()
            t.TextColor3 = Color3.new(1, 1, 1)
            t.Font = Enum.Font.GothamBlack
            t.TextSize = 10
            t.Parent = b
        end
        return b
    end

