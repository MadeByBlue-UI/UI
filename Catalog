    -- Charge ton avatar du compte Roblox (une seule fois, en arrière-plan)
    function loadBase()
        if X.base or X.baseLoading or X.baseFailed then return end
        X.baseLoading = true
        setStatus("Chargement de ton avatar...")
        task.spawn(function()
            local m
            local ok, desc = pcall(function() return Plrs:GetHumanoidDescriptionFromUserId(lp.UserId) end)
            if ok and desc then
                local ok2, res = pcall(function()
                    return Plrs:CreateHumanoidModelFromDescription(desc, X.baseRig())
                end)
                if ok2 and res then m = res end
