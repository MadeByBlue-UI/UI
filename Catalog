    -- =====================================================================
    -- v7.5 : avatars partagés entre les utilisateurs du script (via un petit serveur relais)
    -- Conçu anti-lag : requêtes espacées (6 s), un seul aller-retour par cycle,
    -- seulement les DIFFÉRENCES sont appliquées, 1 tâche toutes les 0.12 s.
    -- =====================================================================
    X.net = {
        remote = {},      -- [uid] = { sig, ids = {}, body = {}, acc = {[id]=Accessory}, orig = Folder, char }
        queue = {},       -- tâches à exécuter (étalées dans le temps)
        lastSig = "", lastSync = 0, count = 0, status = "inactif", running = true, busy = false,
        forceSync = false, -- pour le mode manuel
    }
    local NET = X.net
    NET.MAX_PLAYERS, NET.MAX_IDS = 10, 20

    function X.netReq(path, tbl)
        local req = (syn and syn.request) or http_request or request or (http and http.request) or (fluxus and fluxus.request)
        if type(req) ~= "function" then return nil, "requêtes HTTP indisponibles" end
        local base = tostring(S.netUrl or ""):gsub("%s+", ""):gsub("/+$", "")
        if base == "" then return nil, "adresse du serveur non définie" end
        local ok, res = pcall(req, {
            Url = base .. path, Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpS:JSONEncode(tbl),
        })
        if not ok or type(res) ~= "table" then return nil, "serveur injoignable" end
        local code = res.StatusCode
        if code and code ~= 200 then return nil, "erreur serveur " .. tostring(code) end
        local ok2, data = pcall(function() return HttpS:JSONDecode(res.Body or "") end)
        if not ok2 or type(data) ~= "table" then return nil, "réponse illisible" end
        return data
    end

    -- ----- Mode sans serveur : relais public ntfy.sh (utilisé quand l'adresse est vide) -----
    function X.rawReq(opts)
        local req = (syn and syn.request) or http_request or request or (http and http.request) or (fluxus and fluxus.request)
        if type(req) ~= "function" then return nil, "requêtes HTTP indisponibles" end
        local ok, res = pcall(req, opts)
        if not ok or type(res) ~= "table" then return nil, "relais injoignable" end
        if res.StatusCode and res.StatusCode ~= 200 then return nil, "erreur relais " .. tostring(res.StatusCode) end
        return res
    end

    function X.ntfyUrl()
        local t = X.netRoom():gsub("[^%w]", ""):sub(1, 60)
        return "https://ntfy.sh/catpanel" .. t
    end

    function X.ntfyPublish(tbl)
        return X.rawReq({
            Url = X.ntfyUrl(), Method = "POST",
            Headers = { ["Content-Type"] = "text/plain" },
            Body = HttpS:JSONEncode(tbl),
        })
    end

    NET.board = {}   -- [uid] = dernière tenue publiée par ce joueur
    function X.ntfyPoll()
        local res, err = X.rawReq({ Url = X.ntfyUrl() .. "/json?poll=1&since=" .. (NET.since or "12h"), Method = "GET" })
        if not res then return nil, err end
        for line in tostring(res.Body or ""):gmatch("[^\n]+") do
            local ok, o = pcall(function() return HttpS:JSONDecode(line) end)
            if ok and type(o) == "table" and o.event == "message" then
                if o.id then NET.since = o.id end
                local ok2, d = pcall(function() return HttpS:JSONDecode(o.message or "") end)
                if ok2 and type(d) == "table" and type(d.uid) == "number" then NET.board[d.uid] = d end
            end
        end
        local list = {}
        for uid, d in pairs(NET.board) do
            if uid ~= lp.UserId and not d.off then
                table.insert(list, { uid = uid, ids = d.ids, body = d.body })
            end
        end
        return list
    end

    function X.netRoom()
        local j = game.JobId
        if j == nil or j == "" then j = "place" .. tostring(game.PlaceId) end
        return j
    end

    function X.netMine(forceCurrent)
        local sa = (not forceCurrent) and X.sharedAvatar and X.sharedAvatar()
        if sa then
            local sids = {}
            for _, v in ipairs(sa.ids or {}) do
                if type(v) == "number" and #sids < NET.MAX_IDS then table.insert(sids, v) end
            end
            return sids, sa.body, sa.adj  -- Inclure les personnalisations sauvegardées
        end
        local ids = {}
        for id in pairs(worn) do table.insert(ids, id) end
        table.sort(ids)
        while #ids > NET.MAX_IDS do table.remove(ids) end
        local body
        for g, bid in pairs(X.bodyMap) do
            body = body or {}
            body[g] = bid
        end
        -- Collecter les personnalisations des objets portés
        local adjData = {}
        for id in pairs(worn) do
            local k = tostring(id)
            if adj[k] then
                adjData[k] = adj[k]
            end
        end
        return ids, body, next(adjData) and adjData or nil
    end

    function X.netSig(ids, body, adjData)
        local parts = { table.concat(ids, ",") }
        local keys = {}
        if body then for g in pairs(body) do table.insert(keys, g) end end
        table.sort(keys)
        for _, g in ipairs(keys) do table.insert(parts, g .. "=" .. tostring(body[g])) end
        -- Inclure une signature des personnalisations
        if adjData then
            local adjKeys = {}
            for k in pairs(adjData) do table.insert(adjKeys, k) end
            table.sort(adjKeys)
            for _, k in ipairs(adjKeys) do
                local a = adjData[k]
                local sig = string.format("adj%s=%s", k, 
                    tostring(a.px or 0) .. "," .. tostring(a.py or 0) .. "," .. tostring(a.pz or 0) .. "," ..
                    tostring(a.rx or 0) .. "," .. tostring(a.ry or 0) .. "," .. tostring(a.rz or 0) .. "," ..
                    tostring(a.sc or 1) .. "," .. tostring(a.tr or 0) .. "," ..
                    tostring(a.cr or 255) .. "," .. tostring(a.cg or 255) .. "," .. tostring(a.cb or 255) .. "," ..
                    tostring(a.tint and 1 or 0) .. "," .. tostring(a.mat or ""))
                table.insert(parts, sig)
            end
        end
        return table.concat(parts, "|")
    end

    -- ----- appliquer / retirer sur un autre joueur -----
    function X.netClean(info)
        for _, a in pairs(info.acc) do pcall(function() a:Destroy() end) end
        info.acc = {}
        if info.orig and info.char and info.char.Parent then
            local rg = X.rigOf(info.char)
            for g, _ in pairs(info.bodyApplied or {}) do
                for _, nm in ipairs(X.GROUPS[rg][g] or {}) do
                    pcall(X.swapPart, info.char, nm, info.orig)
                end
            end
        end
        if info.orig then pcall(function() info.orig:Destroy() end) end
        info.orig, info.bodyApplied = nil, nil
    end

    function X.netPush(job) table.insert(NET.queue, job) end

    function X.netApplyAcc(uid, info, id)
        local char = info.char
        if not (char and char.Parent) or info.acc[id] then return end
        local tpl = fetchTemplate(id)
        if not tpl or not (char and char.Parent) or info.acc[id] or not info.ids[id] then return end
        
        -- Appliquer les personnalisations reçues via X.applyAdj au lieu de modifier adj globale
        local a = attachTo(char, tpl, id)
        if a then 
            info.acc[id] = a
            -- Appliquer les personnalisations distantes directement sur l'accessoire
            if info.adj and info.adj[tostring(id)] then
                local tempAdj = adj[tostring(id)]  -- Sauvegarder l'original
                adj[tostring(id)] = info.adj[tostring(id)]  -- Temporairement
                X.applyAdj(a, id)  -- Appliquer
                adj[tostring(id)] = tempAdj  -- Restaurer l'original
            end
        end
    end

    function X.netApplyBody(uid, info)
        local char = info.char
        if not (char and char.Parent) then return end
        local rg = X.rigOf(char)
        info.orig = info.orig or Instance.new("Folder")
        info.bodyApplied = info.bodyApplied or {}
        local want = info.body or {}
        -- retirer les parties qui ne sont plus voulues
        for g in pairs(info.bodyApplied) do
            if not want[g] then
                for _, nm in ipairs(X.GROUPS[rg][g] or {}) do pcall(X.swapPart, char, nm, info.orig) end
                info.bodyApplied[g] = nil
            end
        end
        for g, bid in pairs(want) do
            if info.bodyApplied[g] ~= bid and X.GROUPS[rg][g] then
                local e = X.loadBundle(bid, "Personnage " .. bid)
                local src = e and X.bodyRig(e, rg)
                if src and char.Parent then
                    for _, nm in ipairs(X.GROUPS[rg][g]) do
                        local part = char:FindFirstChild(nm)
                        if part and not info.orig:FindFirstChild(nm) then
                            local c = part:Clone()
                            for _, ch in ipairs(c:GetChildren()) do
                                if ch:IsA("JointInstance") then ch:Destroy() end
                            end
                            c.Parent = info.orig
                        end
                        pcall(X.swapPart, char, nm, src)
                    end
                    info.bodyApplied[g] = bid
                end
                task.wait(0.1)
            end
        end
    end

    -- reçoit la liste des autres joueurs et programme les différences
    function X.netReceive(list)
        local seen, n = {}, 0
        for _, p in ipairs(list) do
            if type(p) == "table" and type(p.uid) == "number" and p.uid ~= lp.UserId and n < NET.MAX_PLAYERS then
                local pl = Plrs:GetPlayerByUserId(p.uid)
                if pl then
                    n += 1
                    seen[p.uid] = true
                    local ids, idset = {}, {}
                    if type(p.ids) == "table" then
                        for _, v in ipairs(p.ids) do
                            if type(v) == "number" and #ids < NET.MAX_IDS then
                                table.insert(ids, v)
                                idset[v] = true
                            end
                        end
                    end
                    local body = {}
                    if type(p.body) == "table" then
                        for g, bid in pairs(p.body) do
                            if type(g) == "string" and type(bid) == "number" then body[g] = bid end
                        end
                    end
                    
                    -- Parser les personnalisations reçues
                    local adjData = {}
                    if type(p.adj) == "table" then
                        for k, a in pairs(p.adj) do
                            if type(k) == "string" and type(a) == "table" then
                                adjData[k] = a
                            end
                        end
                    end
                    
                    local sig = X.netSig(ids, body, adjData)
                    local info = NET.remote[p.uid]
                    if not info then
                        info = { sig = "", ids = {}, body = {}, acc = {} }
                        NET.remote[p.uid] = info
                    end
                    local char = pl.Character
                    -- respawn : l'ancien personnage a disparu, on recommence
                    if info.char ~= char then
                        info.acc, info.orig, info.bodyApplied = {}, nil, nil
                        info.char = char
                        info.sig = ""
                    end
                    if char and sig ~= info.sig then
                        info.sig = sig
                        info.ids, info.body = idset, body
                        local uid = p.uid
                        -- retirer ce qui n'est plus porté
                        for id, a in pairs(info.acc) do
                            if not idset[id] then
                                pcall(function() a:Destroy() end)
                                info.acc[id] = nil
                            end
                        end
                        for _, id in ipairs(ids) do
                            if not info.acc[id] then
                                X.netPush(function() X.netApplyAcc(uid, info, id) end)
                            end
                        end
                        X.netPush(function() X.netApplyBody(uid, info) end)
                    end
                end
            end
        end
        -- joueurs partis ou qui ont arrêté de partager
        for uid, info in pairs(NET.remote) do
            if not seen[uid] then
                X.netClean(info)
                NET.remote[uid] = nil
            end
        end
        NET.count = n
    end

    -- ----- Étiquette « Catalogue 👀 » au-dessus des autres utilisateurs (visible à travers les murs, de loin) -----
