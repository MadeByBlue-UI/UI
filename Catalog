    -- ---------- Anti-collision ----------
    function ghostPart(part)
        if not part:IsA("BasePart") then return end
        part.CanCollide = false
        part.CanTouch   = false
        part.CanQuery   = false
        part.Massless   = true
        if not guarded[part] then
            guarded[part] = true
            part:GetPropertyChangedSignal("CanCollide"):Connect(function()
                if part.CanCollide then part.CanCollide = false end
            end)
        end
    end

    -- ---------- Chargement / port d'un accessoire ----------
    function loadAsset(id)
        local ok, res = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
        if ok and type(res) == "table" and res[1] then return res[1] end
        local ok2, model = pcall(function() return InsertS:LoadAsset(id) end)
        if ok2 and model then return model end
        return nil
    end

    -- Chargement unique par objet (pas de doublon) + préchargement des meshes/textures
    function fetchTemplate(id)
        if templates[id] then return templates[id] end
        if X.inflight[id] then
            while X.inflight[id] do task.wait() end
            return templates[id]
        end
        X.inflight[id] = true
        local acc
        pcall(function()
            local obj = loadAsset(id)
            if not obj then return end
            local a = obj:IsA("Accessory") and obj or obj:FindFirstChildWhichIsA("Accessory", true)
            if not a or not a:FindFirstChild("Handle") then obj:Destroy() return end
            a.Parent = nil
            for _, d in ipairs(a:GetDescendants()) do
                if d:IsA("LuaSourceContainer") then d:Destroy() end
            end
            acc = a
        end)
        if acc then
            -- précharge en arrière-plan (max 3 s) : évite le gros à-coup à l'affichage
            local done = false
            task.spawn(function()
                pcall(function() X.CP:PreloadAsync({ acc }) end)
                done = true
            end)
            local t0 = os.clock()
            while not done and os.clock() - t0 < 3 do task.wait() end
            templates[id] = acc
        end
        X.inflight[id] = nil
        return acc
    end

    -- Colle un accessoire sur n'importe quel perso (le tien, ou la copie de l'aperçu)
    function attachTo(char, acc, id)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end

        local clone  = acc:Clone()
        local handle = clone:FindFirstChild("Handle")
        if not handle then clone:Destroy(); return nil end

        local target, c0, c1
        for _, att in ipairs(handle:GetChildren()) do
            if att:IsA("Attachment") then
                for _, part in ipairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        local ca = part:FindFirstChild(att.Name)
                        if ca and ca:IsA("Attachment") then
                            target, c0, c1 = part, att.CFrame, ca.CFrame
                            break
                        end
                    end
                end
            end
            if target then break end
        end

        if not target then
            -- anciens accessoires sans attachment : placement sur la tête
            local head = char:FindFirstChild("Head")
            if not head then clone:Destroy(); return nil end
            target = head
            c0 = clone.AttachmentPoint
            c1 = CFrame.new(0, head.Size.Y / 2, 0)
        end

        for _, d in ipairs(clone:GetDescendants()) do
            if d.Name == "AccessoryWeld" then
                d:Destroy()
            elseif d:IsA("BasePart") then
                d.Anchored = false
                ghostPart(d)
            end
        end

        local c1a = c1 * adjCFrame(id) -- placement réglé par l'utilisateur
        handle.CFrame = target.CFrame * c1a * c0:Inverse()

        local w = Instance.new("Weld")
        w.Name  = "AccessoryWeld"
        w.Part0 = handle
        w.Part1 = target
        w.C0    = c0
        w.C1    = c1a
        w:SetAttribute("BaseC0", c0)
        w:SetAttribute("BaseC1", c1)
        w.Parent = handle

        clone:SetAttribute("CatId", id) -- sert au mode "Sans objets" de l'aperçu + à la transparence par objet
        clone.Parent = char
        X.applyAdj(clone, id)           -- placement + taille + couleur + matière + transparence
        return clone
    end

    function attach(acc, id)
        return attachTo(lp.Character, acc, id)
    end

