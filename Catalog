    -- Prix arc-en-ciel : chaque lettre est un TextLabel qui rebondit
    function X.rainbowLabel(card, txt, pos, anchor)
        local size = 11
        local widths, total = {}, 0
        for i = 1, #txt do
            local ch = txt:sub(i, i)
            local w = X.cw[ch]
            if not w then
                local ok, v = pcall(function()
                    return game:GetService("TextService"):GetTextSize(ch, size, Enum.Font.GothamBold, Vector2.new(200, 50)).X
                end)
                w = (ok and v) or 7
                if ch == " " then w = math.max(w, 3) end
                X.cw[ch] = w
            end
            widths[i] = w
            total += w
        end

        local holder = Instance.new("Frame")
        holder.Size = UDim2.fromOffset(total + 14, 26)
        holder.AnchorPoint = anchor or Vector2.new(1, 0)
        holder.Position = pos or UDim2.new(1, -8, 0, 6)
        holder.BackgroundColor3 = Color3.new(0, 0, 0)
        holder.BackgroundTransparency = 0.25
        holder.BorderSizePixel = 0
        holder.ZIndex = 3
        holder.Parent = card
        Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)

        local letters, x = {}, 7
        for i = 1, #txt do
            local l = Instance.new("TextLabel")
            l.Size = UDim2.fromOffset(widths[i] + 1, 16)
            l.Position = UDim2.fromOffset(x, 8)
            l.BackgroundTransparency = 1
