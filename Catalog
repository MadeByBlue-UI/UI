    function pushUndo(kind, id, name)
        table.insert(X.undo, { kind, id, name })
        while #X.undo > 30 do table.remove(X.undo, 1) end
    end

    function unwear(id, noUndo)
        local a = worn[id]
        if a then
            a:Destroy()
            if not noUndo then
                pushUndo("unwear", id, (templates[id] and templates[id].Name) or ("Objet " .. id))
                sfx("unwear")
            end
        end
        worn[id] = nil
        for i = #X.wearOrder, 1, -1 do
            if X.wearOrder[i] == id then table.remove(X.wearOrder, i) end
        end
        refreshWearButtons(id)
        saveState()
    end

    local wearing = {}
    function toggleWear(id, name, noRecent, noUndo, price)
        if wearing[id] then return end
        if type(price) == "number" then X.prices[tostring(id)] = price end
        if worn[id] then
            unwear(id, noUndo)
            setStatus("Retiré : " .. name)
            return
        end
        local count = 0
        for _ in pairs(worn) do count += 1 end
        if count >= S.maxWorn then
            setStatus("Limite atteinte (" .. S.maxWorn .. " objets) — change-la dans Réglages")
            say("Limite d'objets portés atteinte.")
            return
        end
        wearing[id] = true
        setStatus("Chargement de " .. name .. "...")
        dprint("wear", id, name)
        local tpl = fetchTemplate(id)
        if not tpl then
            setStatus("Impossible de charger : " .. name)
            say("Objet non chargeable (peut-être pas un accessoire rigide).")
            wearing[id] = nil
            return
        end
        local a = attach(tpl, id)
        if a then
            worn[id] = a
            table.insert(X.wearOrder, id)
            if not noRecent then addRecent(id, name, X.prices[tostring(id)]) end
            if not noUndo then pushUndo("wear", id, name) end
            applyWornAlpha(a, id)  -- Passer l'ID
            saveState()
            sfx("wear")
            local m = UIS:GetMouseLocation()
            burst(m.X, m.Y)
            setStatus("Porté : " .. name)
        else
            setStatus("Pas de personnage disponible")
        end
        wearing[id] = nil
        refreshWearButtons(id)
    end

    -- Ctrl+Z : annule la dernière action (porter / retirer)
    function undoLast()
        local act = table.remove(X.undo)
        if not act then
            setStatus("Rien à annuler")
            return
        end
        if act[1] == "wear" then
            if worn[act[2]] then unwear(act[2], true) end
            setStatus("Annulé : " .. tostring(act[3]) .. " retiré")
        else
            if not worn[act[2]] then task.spawn(toggleWear, act[2], tostring(act[3]), true, true) end
            setStatus("Annulé : " .. tostring(act[3]) .. " remis")
        end
        sfx("click")
    end

    -- Ctrl+Retour arrière : retire le dernier objet porté
    function X.removeLast()
        local id = X.wearOrder[#X.wearOrder]
        while id and not worn[id] do
            table.remove(X.wearOrder)
            id = X.wearOrder[#X.wearOrder]
        end
        if not id then
            setStatus("Aucun objet à retirer")
            return
        end
        local nm = (templates[id] and templates[id].Name) or ("Objet " .. id)
        unwear(id)
        setStatus("Retiré : " .. nm .. "  (Ctrl+Z pour annuler)")
    end

