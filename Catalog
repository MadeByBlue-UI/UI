    importBtn.MouseButton1Click:Connect(function()
        local text = (codeBox.Text or ""):match("^%s*(.-)%s*$")
        local body = text:match("^CAT1:(.+)$")
        if not body then say("Code invalide.") return end
        local ok, data = pcall(function() return HttpS:JSONDecode(body) end)
        if not ok or type(data) ~= "table" or type(data.i) ~= "table" then say("Code invalide.") return end
        local ids = {}
        for _, v in ipairs(data.i) do
            if type(v) == "number" then table.insert(ids, v) end
        end
        if #ids == 0 then say("Code vide.") return end
        local ib
        if type(data.b) == "table" then
            ib = {}
            for g, bid in pairs(data.b) do
                if type(g) == "string" and type(bid) == "number" then ib[g] = bid end
            end
            if next(ib) == nil then ib = nil end
        end
        table.insert(outfits, { name = tostring(data.n or "Importé"), ids = ids, body = ib })
        codeBox.Text = ""
        saveState()
        rebuildOutfits()
        say("Outfit importé.")
    end)

