    function applyAdjLive(id)
        local acc = worn[id]
        if acc and acc.Parent then
            -- Vérifier qu'il n'y a pas de doublons dans le personnage
            local char = lp.Character
            if char then
                local toRemove = {}
                for _, child in ipairs(char:GetChildren()) do
                    if child:IsA("Accessory") and child:GetAttribute("CatId") == id and child ~= acc then
                        -- C'est un doublon, le marquer pour suppression
                        table.insert(toRemove, child)
                    end
