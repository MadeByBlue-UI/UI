        local char = lp.Character or lp.CharacterAdded:Wait()
        char:WaitForChild("Humanoid", 10)
        char:WaitForChild("HumanoidRootPart", 10)
        local t0 = os.clock()
        while not lp:HasAppearanceLoaded() and os.clock() - t0 < 5 do task.wait(0.1) end
        task.wait(0.6)
        for _, id in ipairs(savedData.worn) do
            if type(id) == "number" and not worn[id] and lp.Character == char then
                local tpl = fetchTemplate(id)
                if tpl then
                    local a = attach(tpl, id)
                    if a then
                        worn[id] = a
                        table.insert(X.wearOrder, id)
                        applyWornAlpha(a, id)
                    end
                end
            end
        end
        dprint("objets restaurés", #savedData.worn)
    end)

