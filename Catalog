    -- Poses faites à la main (les animations Roblox ne tournent pas dans un ViewportFrame)
    function X.poseApply(J, name, t)
        if not J then return end
        local A = CFrame.Angles
        for _, j in pairs(J) do j.Transform = CFrame.new() end
        local function set(n, cf)
            local j = J[n]
            if j then j.Transform = cf end
        end

        -- poses fixes : on applique les angles tels quels
        local fx = X.FIXED[name]
        if fx then
            local spec = J["Right Shoulder"] and fx.r6 or fx.r15
            for jn, a in pairs(spec or {}) do set(jn, A(a[1], a[2], a[3])) end
            return
        end

        -- ===== R6 : articulations "Right Shoulder", "Left Shoulder", "Right Hip", "Left Hip", "Neck", "RootJoint" =====
        if J["Right Shoulder"] then
            if name == "Idle" then
                local b = math.sin(t * 2) * 0.02
                set("Right Shoulder", A(-0.22 - b, 0, 0))
                set("Left Shoulder", A(-0.22 - b, 0, 0))
                set("Neck", A(math.sin(t * 1.3) * 0.04, 0, math.sin(t * 0.8) * 0.12))

            elseif name == "Danse" then
                local s = math.sin(t * 6)
                set("RootJoint", CFrame.new(0, 0, math.abs(s) * 0.25) * A(0, 0, math.sin(t * 3) * 0.3))
                set("Neck", A(0, s * 0.1, -math.sin(t * 3) * 0.25))
                set("Right Shoulder", A(-(2.0 + s * 0.7), 0, 0))
                set("Left Shoulder", A(-(2.0 - s * 0.7), 0, 0))
                set("Right Hip", A(0, 0, s * 0.35))
                set("Left Hip", A(0, 0, -s * 0.35))

            elseif name == "Salut" then
                set("Right Shoulder", A(-(2.6 + math.sin(t * 8) * 0.3), 0, 0))
                set("Left Shoulder", A(-0.08, 0, 0))
                set("Neck", A(0, 0.08, 0.15))

            elseif name == "Joie" then
                local s = math.sin(t * 8)
                set("RootJoint", CFrame.new(0, 0, math.abs(s) * 0.35))
                set("Right Shoulder", A(-(2.9 + s * 0.15), 0, 0))
                set("Left Shoulder", A(-(2.9 - s * 0.15), 0, 0))
                set("Neck", A(-0.15, 0, 0))
                set("Right Hip", A(-0.2, 0, 0))
                set("Left Hip", A(-0.2, 0, 0))

            elseif name == "Rire" then
                local s = math.sin(t * 18)
                set("RootJoint", CFrame.new(0, 0, math.abs(s) * 0.05) * A(-0.12 + s * 0.05, 0, 0))
                set("Neck", A(-0.35 + s * 0.05, 0, 0))
                set("Right Shoulder", A(0, 0, 0.7))
                set("Left Shoulder", A(0, 0, -0.7))
            end
            return
        end

        -- ===== R15 =====
        if name == "Idle" then
            set("Waist", A(math.sin(t * 2) * 0.02, 0, 0))
            set("RightShoulder", A(0, 0, 0.22 + math.sin(t * 2) * 0.02))
            set("LeftShoulder", A(0, 0, -0.22 - math.sin(t * 2) * 0.02))
            set("RightElbow", A(0.12, 0, 0))
            set("LeftElbow", A(0.12, 0, 0))
            set("Neck", A(math.sin(t * 1.3) * 0.04, math.sin(t * 0.8) * 0.1, 0))

        elseif name == "Danse" then
            local s = math.sin(t * 6)
            set("RootJoint", CFrame.new(0, math.abs(s) * 0.25, 0) * A(0, math.sin(t * 3) * 0.3, 0))
            set("Waist", A(0, math.sin(t * 3) * 0.3, math.sin(t * 6) * 0.08))
            set("Neck", A(0, -math.sin(t * 3) * 0.25, math.sin(t * 6) * 0.1))
            set("RightShoulder", A(0, 0, 2.0 + s * 0.7))
            set("LeftShoulder", A(0, 0, -(2.0 - s * 0.7)))
            set("RightElbow", A(0.6, 0, 0))
            set("LeftElbow", A(0.6, 0, 0))
            set("RightHip", A(s * 0.35, 0, 0))
            set("LeftHip", A(-s * 0.35, 0, 0))
            set("RightKnee", A(math.max(0, -s) * 0.6, 0, 0))
            set("LeftKnee", A(math.max(0, s) * 0.6, 0, 0))

        elseif name == "Salut" then
            set("RightShoulder", A(0, 0, 2.7))
            set("RightElbow", A(0.3, 0, math.sin(t * 8) * 0.55))
            set("LeftShoulder", A(0, 0, -0.08))
            set("Neck", A(0, 0.15, 0.08))
            set("Waist", A(0, 0.08, 0))

        elseif name == "Joie" then
            local s = math.sin(t * 8)
            set("RootJoint", CFrame.new(0, math.abs(s) * 0.35, 0))
            set("RightShoulder", A(0, 0, 2.9 + s * 0.15))
            set("LeftShoulder", A(0, 0, -(2.9 - s * 0.15)))
            set("Neck", A(-0.15, 0, 0))
            set("RightHip", A(-0.15, 0, 0.1))
            set("LeftHip", A(-0.15, 0, -0.1))
            set("RightKnee", A(0.3 + math.max(0, -s) * 0.3, 0, 0))
            set("LeftKnee", A(0.3 + math.max(0, -s) * 0.3, 0, 0))

        elseif name == "Rire" then
            local s = math.sin(t * 18)
            set("RootJoint", CFrame.new(0, math.abs(s) * 0.05, 0))
            set("Waist", A(-0.12 + s * 0.06, 0, 0))
            set("Neck", A(-0.35 + s * 0.05, 0, 0))
            set("RightShoulder", A(0.5, 0, 0.25))
            set("LeftShoulder", A(0.5, 0, -0.25))
            set("RightElbow", A(1.5, 0, 0))
            set("LeftElbow", A(1.5, 0, 0))
        end
    end

    function poseStep(J)
        if not J or X.pose <= 1 then return end
        X.poseApply(J, X.POSES[X.pose][1], os.clock() * X.poseSpeed)
    end

    -- Mode "côte à côte" : les deux avatars tournent sur eux-mêmes, la caméra reste fixe
    function X.sideActive()
        return X.side and model ~= nil and X.model2 ~= nil and X.pivot1 ~= nil and modelFront ~= nil
    end

    function X.sideStep()
        if not X.sideActive() then return end
        local P = X.pivot1
        local right = (-modelFront):Cross(Vector3.yAxis)
        local rot = CFrame.Angles(0, angle, 0)
        local base = P - P.Position
        model:PivotTo(CFrame.new(P.Position) * rot * base)
        X.model2:PivotTo(CFrame.new(P.Position + right * X.sideGap) * rot * base)
    end

    function updateCam()
        if not model or not modelCenter then return end
        local side = X.sideActive()
        local vsz = vp.AbsoluteSize
        local aspect = math.max(vsz.X, 1) / math.max(vsz.Y, 1)
        local tanHalf = math.tan(math.rad(cam.FieldOfView / 2))
        local gap = side and X.sideGap or 0
        local h = modelSize.Y * 1.15
        local w = (math.max(modelSize.X, modelSize.Z) + gap) * 1.15
        local dist = math.max(h / (2 * tanHalf), w / (2 * tanHalf * aspect)) * zoom * S.avatarZoom
        local camAngle = side and 0 or angle
        local flat = CFrame.Angles(0, camAngle, 0):VectorToWorldSpace(modelFront)
        local cp = math.cos(X.pitch)
        local dir = Vector3.new(flat.X * cp, math.sin(X.pitch), flat.Z * cp)
        -- le texte d'aide cache ~22px en bas : on remonte l'avatar de la moitié
        local visH = 2 * dist * tanHalf
        local shift = visH * (11 / math.max(vsz.Y, 1))
        local right = (-modelFront):Cross(Vector3.yAxis)
        local center = modelCenter + (side and right * (gap / 2) or Vector3.zero)
        local target = center - Vector3.new(0, shift + S.avatarY * modelSize.Y, 0)
        local camCF = CFrame.lookAt(target + dir * dist, target)
        -- déplacement de l'avatar (clic molette) : on translate la caméra
        local pan = camCF.RightVector * (X.panX * visH) + camCF.UpVector * (X.panY * visH)
        cam.CFrame = camCF + pan

        -- étiquettes "Avec objets / Sans objets"
        local l1, l2 = X.sideLbl1, X.sideLbl2
        if side then
            local foot = Vector3.new(0, modelSize.Y / 2 + 0.2, 0)
            local p1 = cam:WorldToViewportPoint(modelCenter - foot)
            local p2 = cam:WorldToViewportPoint(modelCenter + right * gap - foot)
            l1.Position = UDim2.fromOffset(p1.X, math.min(p1.Y, vsz.Y - 40))
            l2.Position = UDim2.fromOffset(p2.X, math.min(p2.Y, vsz.Y - 40))
            l1.Visible, l2.Visible = true, true
        else
            l1.Visible, l2.Visible = false, false
        end
    end

