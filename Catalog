    function setSettingsOpen(open)
        if open == settingsOpen then return end
        settingsOpen = open
        if open then
            page.Parent = win
            page.Visible = true
            page.Position = UDim2.fromOffset(0, 70)
            page.GroupTransparency = 1
            tween(page, 0.35, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 48) }, Enum.EasingStyle.Quint)
            settingsBtn.Text = "Retour"
            title.Text = "RÉGLAGES"
        else
            tween(page, 0.22, { GroupTransparency = 1, Position = UDim2.fromOffset(0, 70) })
            settingsBtn.Text = "Réglages"
            title.Text = "CATALOGUE"
            task.delay(0.25, function()
                if not settingsOpen then
                    page.Visible = false
                    page.Parent = nil
                end
            end)
        end
    end

