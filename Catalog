            -- ancien mode : copie de ton perso en jeu
            local char = lp.Character
            if not char then return end
            local wasArch = char.Archivable
            char.Archivable = true
            local ok, c = pcall(function() return char:Clone() end)
            char.Archivable = wasArch
            if not ok or not c then return end
            clone = c
        else
            -- nouveau mode : ton avatar du COMPTE Roblox, propre, sans les modifs du jeu
            local pb = X.previewBase()
            if not pb then return end
            clone = pb:Clone()
        end

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then d:Destroy() end
        end
        local hum = clone:FindFirstChildOfClass("Humanoid")
        if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
        local root = clone:FindFirstChild("HumanoidRootPart")
        if root then root.Anchored = true end
        do -- parties de corps choisies (Personnages)
            local okB, nB = pcall(X.applyBodyOps, clone)
            if #X.mappedGroups() > 0 then
                setStatus("Aperçu : " .. tostring(okB and nB or 0) .. " pièce(s) du personnage appliquée(s)")
            end
        end

        -- mode "côte à côte" : deuxième avatar SANS les objets du catalogue
        if X.side then
            local c2 = clone:Clone()
            for _, c in ipairs(c2:GetChildren()) do
                if c:IsA("Accessory") and c:GetAttribute("CatId") then c:Destroy() end
            end
            X.model2 = c2
        end

        -- mode "Sans objets" (ancien mode) : on enlève les objets du catalogue de la copie
        if useGame and X.compare then
            for _, c in ipairs(clone:GetChildren()) do
                if c:IsA("Accessory") and c:GetAttribute("CatId") then c:Destroy() end
            end
        end

        -- WorldModel = la méthode officielle pour animer / simuler un modèle dans un ViewportFrame
        if not X.world or X.world.Parent ~= vp then
            X.world = Instance.new("WorldModel")
            X.world.Name = "PreviewWorld"
            X.world.Parent = vp
        end
        clone.Parent = X.world
        model = clone
        if X.model2 then X.model2.Parent = X.world end
        X.pivot1 = model:GetPivot()

        if useGame then
            -- objets en "Essayer" (aperçu seulement)
            if not X.compare then
                for tid in pairs(tryOn) do
                    local tpl = templates[tid]
                    if tpl then
                        local c = attachTo(clone, tpl, tid)
                        if c then c.Name = "TRY" .. tid end
                    end
                end
            end
        else
            -- objets portés + essayés : posés une seule fois, ensuite mise à jour incrémentale
            X.syncAcc(true)
        end

        X.frame()

        local lv = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
        modelFront = Vector3.new(lv.X, 0, lv.Z)
        if modelFront.Magnitude < 0.01 then modelFront = Vector3.new(0, 0, -1) end
        modelFront = modelFront.Unit

        -- poses : on récupère les articulations (Motor6D) du clone, elles sont animées à la main
        X.joints = {}
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Motor6D") then X.joints[d.Name] = d end
        end
        if X.model2 then
            X.joints2 = {}
            for _, d in ipairs(X.model2:GetDescendants()) do
                if d:IsA("Motor6D") then X.joints2[d.Name] = d end
            end
        end
    end

    -- cadrage : on centre sur le CORPS seul, les accessoires servent juste au zoom
    function X.frame()
        local clone = model
        if not clone then return end
        local bMin, bMax, aMin, aMax
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.99 then
                local lo, hi = boundsOf(d)
                aMin = aMin and aMin:Min(lo) or lo
                aMax = aMax and aMax:Max(hi) or hi
                if d.Parent == clone then -- partie du corps
                    bMin = bMin and bMin:Min(lo) or lo
                    bMax = bMax and bMax:Max(hi) or hi
                end
            end
        end
        if bMin and bMax then
            local c = (bMin + bMax) / 2
            local halfY = math.max(aMax.Y - c.Y, c.Y - aMin.Y)
            local halfXZ = math.max(aMax.X - c.X, c.X - aMin.X, aMax.Z - c.Z, c.Z - aMin.Z)
            modelCenter = c
            modelSize = Vector3.new(halfXZ * 2, halfY * 2, halfXZ * 2)
        else
            local cf, size = clone:GetBoundingBox()
            modelCenter, modelSize = cf.Position, size
        end
        if not (modelSize.Y > 1) or modelSize.Y ~= modelSize.Y then
            local cf, size = clone:GetBoundingBox()
            modelCenter, modelSize = cf.Position, size
        end
    end

    -- Met à jour UNIQUEMENT les accessoires de l'aperçu (mode "Compte"), sans refaire l'avatar.
    -- C'est ce qui supprime les freezes quand on porte / essaie un objet.
    function X.syncAcc(noFrame)
        if not model or S.previewSrc == "Jeu" or X.baseFailed then return end
        local want = {}
        if not X.compare then
            for id, a in pairs(worn) do
                local h = a:FindFirstChild("Handle")
                local wd = h and h:FindFirstChild("AccessoryWeld")
                want["w" .. id] = {
                    id = id, worn = true,
                    sig = (h and (tostring(h.Color) .. tostring(h.Transparency) .. tostring(h.Size) .. h.Material.Name) or "")
                        .. (wd and (tostring(wd.C1) .. tostring(wd.C0)) or "") .. tostring(S.wornAlpha),
                }
            end
            for id in pairs(tryOn) do
                if not worn[id] then want["t" .. id] = { id = id, sig = "try" } end
            end
        end
        local changed, adds = false, 0
        for key, e in pairs(want) do
            local cur = X.pv[key]
            if not cur or cur.sig ~= e.sig then
                if adds >= 3 then break end -- on étale sur plusieurs ticks
                adds += 1
                if cur and cur.acc then cur.acc:Destroy() end
                X.pv[key] = nil
                local tpl = templates[e.id]
                if tpl then
                    local c = attachTo(model, tpl, e.id)
                    if c then
                        if e.worn then applyWornAlpha(c, e.id) else c.Name = "TRY" .. e.id end
                        X.pv[key] = { acc = c, sig = e.sig }
                    end
                end
                changed = true
            end
        end
        for key, cur in pairs(X.pv) do
            if not want[key] then
                if cur.acc then cur.acc:Destroy() end
                X.pv[key] = nil
                changed = true
            end
        end
        if changed and not noFrame then X.frame() end
    end

