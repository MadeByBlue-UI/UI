    function buildSig(char)
        local parts = {}
        for _, c in ipairs(char:GetChildren()) do
            local extra = ""
            if c:IsA("MeshPart") then
                extra = c.MeshId
            elseif c:IsA("Shirt") then
                extra = c.ShirtTemplate
            elseif c:IsA("Pants") then
                extra = c.PantsTemplate
            elseif c:IsA("Accessory") then
                local h = c:FindFirstChild("Handle")
                if h then
                    local wd = h:FindFirstChild("AccessoryWeld")
                    extra = (h:IsA("MeshPart") and h.MeshId or "") .. tostring(h.Transparency)
                        .. tostring(h.Color) .. tostring(h.Size) .. h.Material.Name
                        .. (wd and (tostring(wd.C1) .. tostring(wd.C0)) or "")
                end
            end
            table.insert(parts, c.ClassName .. c.Name .. extra)
        end
        return table.concat(parts, "|")
    end

    -- boîte englobante (alignée sur les axes) d'une pièce
    function boundsOf(d)
        local cf0, sz = d.CFrame, d.Size
        local r, u, l = cf0.RightVector, cf0.UpVector, cf0.LookVector
        local ex = (math.abs(r.X) * sz.X + math.abs(u.X) * sz.Y + math.abs(l.X) * sz.Z) / 2
        local ey = (math.abs(r.Y) * sz.X + math.abs(u.Y) * sz.Y + math.abs(l.Y) * sz.Z) / 2
        local ez = (math.abs(r.Z) * sz.X + math.abs(u.Z) * sz.Y + math.abs(l.Z) * sz.Z) / 2
        local p = cf0.Position
        return Vector3.new(p.X - ex, p.Y - ey, p.Z - ez), Vector3.new(p.X + ex, p.Y + ey, p.Z + ez)
    end

