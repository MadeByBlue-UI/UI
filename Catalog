    -- ----- Diagnostic : voyants vert / rouge pour chaque service -----
    function X.showDiag()
        local box, close = X.modal(540, 450, "DIAGNOSTIC")
        local GRN, RED, YEL, GRY = Color3.fromRGB(90, 220, 140), Color3.fromRGB(255, 120, 120),
            Color3.fromRGB(255, 200, 80), Color3.fromRGB(120, 120, 130)

        local TESTS = {
            { "Catalogue (recherche)", function()
                local p = CatalogSearchParams.new()
                p.SearchKeyword = "hat"
                p.Limit = 10
                local ok, res = pcall(function() return AES:SearchCatalog(p) end)
                if not ok or not res then return false, tostring(res) end
                local okp, cur = pcall(function() return res:GetCurrentPage() end)
                if not okp then return false, "lecture impossible" end
                return true, #cur .. " résultats"
            end },
            { "Avatar de ton compte", function(ctx)
                local ok, d = pcall(function() return Plrs:GetHumanoidDescriptionFromUserId(lp.UserId) end)
                if not ok or not d then return false, tostring(d) end
                ctx.desc = d
                return true, "description reçue"
            end },
            { "Création d'un modèle", function(ctx)
                if not ctx.desc then return false, "pas d'avatar de compte" end
                local ok, m = pcall(function()
                    return Plrs:CreateHumanoidModelFromDescription(ctx.desc, X.baseRig())
                end)
                if not ok or not m then return false, tostring(m) end
                m:Destroy()
                return true, X.myRigName()
            end },
            { "Chargement d'un objet", function()
                local o = loadAsset(1029025)
                if not o then return false, "GetObjects / LoadAsset refusés" end
                o:Destroy()
                return true, "ok"
            end },
            { "Requêtes HTTP (exécuteur)", function()
                local d = X.httpJson("https://catalog.roblox.com/v1/bundles/1/details")
                if d then return true, "ok" end
                return false, "indisponible (méthode de secours des personnages)"
            end },
            { "Sauvegarde fichier", function()
                if canSave() then return true, "ok" end
                return false, "writefile / readfile absents"
            end },
            { "Presse-papiers", function()
                if typeof(setclipboard) == "function" then return true, "ok" end
                return false, "setclipboard absent"
            end },
            { "Ton rig en jeu", function()
                return true, X.rigOf(lp.Character)
            end },
        }

        local rowsUi = {}
        for i, t in ipairs(TESTS) do
            local y = 56 + (i - 1) * 34
            local dot = Instance.new("Frame")
            dot.Size = UDim2.fromOffset(12, 12)
            dot.Position = UDim2.fromOffset(24, y + 11)
            dot.BackgroundColor3 = GRY
            dot.BorderSizePixel = 0
            dot.Parent = box
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

            local nm = Instance.new("TextLabel")
            nm.Size = UDim2.fromOffset(190, 34)
            nm.Position = UDim2.fromOffset(46, y)
            nm.BackgroundTransparency = 1
            nm.Text = t[1]
            nm.TextColor3 = Color3.new(1, 1, 1)
            nm.Font = Enum.Font.GothamBold
            nm.TextSize = 12
            nm.TextXAlignment = Enum.TextXAlignment.Left
            nm.Parent = box

            local det = Instance.new("TextLabel")
            det.Size = UDim2.fromOffset(270, 34)
            det.Position = UDim2.fromOffset(244, y)
            det.BackgroundTransparency = 1
            det.Text = "en attente"
            det.TextColor3 = Color3.fromRGB(180, 180, 190)
            det.Font = Enum.Font.Gotham
            det.TextSize = 11
            det.TextXAlignment = Enum.TextXAlignment.Left
            det.TextTruncate = Enum.TextTruncate.AtEnd
            det.Parent = box
            rowsUi[i] = { dot = dot, det = det }
        end

        local summary = Instance.new("TextLabel")
        summary.Size = UDim2.new(1, -44, 0, 20)
        summary.Position = UDim2.fromOffset(22, 340)
        summary.BackgroundTransparency = 1
        summary.Text = ""
        summary.TextColor3 = Color3.fromRGB(200, 200, 210)
        summary.Font = Enum.Font.GothamBold
        summary.TextSize = 12
        summary.TextXAlignment = Enum.TextXAlignment.Left
        summary.Parent = box

        local report, running = {}, false
        local function run()
            if running then return end
            running = true
            report = {}
            summary.Text = "Tests en cours..."
            for i = 1, #TESTS do
                rowsUi[i].dot.BackgroundColor3 = YEL
                rowsUi[i].det.Text = "test en cours..."
            end
            task.spawn(function()
                local ctx, okCount = {}, 0
                for i, t in ipairs(TESTS) do
                    local okc, r1, r2 = pcall(t[2], ctx)
                    local pass = (okc and r1) and true or false
                    local detail = okc and tostring(r2 or "") or tostring(r1)
                    if pass then okCount += 1 end
                    local u = rowsUi[i]
                    if u.dot.Parent then
                        u.dot.BackgroundColor3 = pass and GRN or RED
                        u.det.Text = detail
                    end
                    table.insert(report, (pass and "[OK] " or "[ECHEC] ") .. t[1] .. " : " .. detail)
                end
                if summary.Parent then summary.Text = okCount .. " / " .. #TESTS .. " tests réussis" end
                running = false
            end)
        end

        local again = miniBtn(box, "Relancer", UDim2.fromOffset(22, 400), UDim2.fromOffset(130, 30))
