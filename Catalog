        -- ---- aperçu 3D qui tourne ----
        local function buildPreview(e)
            local src = e[X.myRigName()] or e.R15 or e.R6
            if not src then return end
            local m = src:Clone()
            for _, d in ipairs(m:GetDescendants()) do
                if d:IsA("LuaSourceContainer") then d:Destroy() end
            end
            local root = m:FindFirstChild("HumanoidRootPart")
            if root then root.Anchored = true end
            local hum = m:FindFirstChildOfClass("Humanoid")
            if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
            m.Parent = pv
            local cf, size = m:GetBoundingBox()
            local center = cf.Position
            local lv = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
            lv = Vector3.new(lv.X, 0, lv.Z)
            if lv.Magnitude < 0.01 then lv = Vector3.new(0, 0, -1) end
            lv = lv.Unit
            local dist = size.Y * 1.3 / (2 * math.tan(math.rad(pcam.FieldOfView / 2)))
            local ang = 0
            if conns.rot then conns.rot:Disconnect() end
            conns.rot = RunS.Heartbeat:Connect(function(dt)
                if not pv:IsDescendantOf(game) then return end
                ang += dt * 0.9
                local dir = CFrame.Angles(0, ang, 0):VectorToWorldSpace(lv)
                pcam.CFrame = CFrame.lookAt(center + dir * dist + Vector3.new(0, size.Y * 0.04, 0), center)
            end)
            tween(th, 0.5, { ImageTransparency = 1 })
        end

        -- ---- chargement ----
        local function load()
            if not alive then return end
            loaded = nil
            retry.Visible = false
            shimmer(true)
            setInfo("Chargement du personnage...")
            task.spawn(function()
                local e, err = X.loadBundle(id, name)
                if not alive then return end
                shimmer(false)
                if e then
                    loaded = e
                    if X.rigOf(lp.Character) == "R6" then
                        setInfo("Ton perso est en R6 : aperçu en R15, ton vrai corps change peu.")
                    else
                        setInfo("Prêt : clique sur une partie du corps.")
                    end
                    pcall(buildPreview, e)
                    paint()
                else
                    setInfo("Échec du chargement : " .. tostring(err), RED)
                    retry.Visible = true
                end
            end)
        end
        retry.MouseButton1Click:Connect(function()
            sfx("click")
            load()
        end)

        -- ouverture animée
        tween(box, 0.3, { GroupTransparency = 0 })
        tween(bscale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
        load()
    end

