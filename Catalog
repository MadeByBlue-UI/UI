    -- Décalage de placement d'un objet (réglé avec les sliders "Placer")
    function adjCFrame(id)
        local a = id and adj[tostring(id)]
        if not a then return CFrame.new() end
        return CFrame.new(a.px or 0, a.py or 0, a.pz or 0)
            * CFrame.Angles(math.rad(a.rx or 0), math.rad(a.ry or 0), math.rad(a.rz or 0))
    end

    function adjScale(id)
        local a = id and adj[tostring(id)]
        return (a and a.sc) or 1
    end

    -- Taille de l'objet (slider "Taille")
    function applyScale(acc, id)
        if not acc then return end
        local s = adjScale(id)
        for _, d in ipairs(acc:GetDescendants()) do
            if d:IsA("BasePart") then
                if d:GetAttribute("OrigSize") == nil then d:SetAttribute("OrigSize", d.Size) end
                d.Size = d:GetAttribute("OrigSize") * s
            elseif d:IsA("SpecialMesh") then
                if d:GetAttribute("OrigScale") == nil then d:SetAttribute("OrigScale", d.Scale) end
                d.Scale = d:GetAttribute("OrigScale") * s
            end
        end
    end

    -- Multiplicateur de particules
    function applyParticles(acc, id)
        if not acc then return end
        local a = id and adj[tostring(id)]
        local mult = (a and a.particles) or 1
        for _, d in ipairs(acc:GetDescendants()) do
            if d:IsA("ParticleEmitter") then
                -- Sauvegarder les valeurs originales
                if d:GetAttribute("OrigRate") == nil then 
                    d:SetAttribute("OrigRate", d.Rate) 
                end
                -- Appliquer le multiplicateur
                local origRate = d:GetAttribute("OrigRate")
                d.Rate = origRate * mult
                -- Optionnel : augmenter aussi le nombre de particules
                if d:GetAttribute("OrigSpeed") == nil then
                    d:SetAttribute("OrigSpeed", d.Speed.Min)
                    d:SetAttribute("OrigSpeedMax", d.Speed.Max)
                end
            end
        end
    end

    -- Teinte de couleur + matière d'un objet (sliders R/G/B, couleurs prédéfinies, matière)
    function applyTint(acc, id)
        if not acc then return end
        local a = id and adj[tostring(id)]
        local on = a and a.tint
        local mat = a and a.mat
        local r, g, b = (a and a.cr) or 255, (a and a.cg) or 255, (a and a.cb) or 255
        for _, d in ipairs(acc:GetDescendants()) do
            if d:IsA("BasePart") then
                if d:GetAttribute("OrigColor") == nil then d:SetAttribute("OrigColor", d.Color) end
                if d:GetAttribute("OrigMat") == nil then d:SetAttribute("OrigMat", d.Material.Name) end
                d.Color = on and Color3.fromRGB(r, g, b) or d:GetAttribute("OrigColor")
                local mname = mat or d:GetAttribute("OrigMat")
                pcall(function() d.Material = Enum.Material[mname] end)
            elseif d:IsA("SpecialMesh") then
                if d:GetAttribute("OrigVC") == nil then d:SetAttribute("OrigVC", d.VertexColor) end
                d.VertexColor = on and Vector3.new(r / 255, g / 255, b / 255) or d:GetAttribute("OrigVC")
            end
        end
    end

    -- Applique placement + taille + couleur + matière + transparence + particules à un accessoire (clone)
    function X.applyAdj(acc, id)
        if not acc then return end
        
        -- Appliquer d'abord les modifications visuelles qui ne touchent pas au placement
        applyScale(acc, id)
        applyTint(acc, id)
        applyWornAlpha(acc, id)
        applyParticles(acc, id)
        
        -- Ensuite gérer le placement (weld)
        local h = acc:FindFirstChild("Handle")
        local w = h and h:FindFirstChild("AccessoryWeld")
        if w then
            local b1, b0 = w:GetAttribute("BaseC1"), w:GetAttribute("BaseC0")
            if b1 then 
                w.C1 = b1 * adjCFrame(id)
            end
            if b0 then
                local s = adjScale(id)
                w.C0 = CFrame.new(b0.Position * s) * (b0 - b0.Position)
            end
        end
    end

