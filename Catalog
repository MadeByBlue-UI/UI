            LeftUpperArm = Color3.fromRGB(245, 205, 48), LeftLowerArm = Color3.fromRGB(245, 205, 48), LeftHand = Color3.fromRGB(245, 205, 48),
            RightUpperArm = Color3.fromRGB(245, 205, 48), RightLowerArm = Color3.fromRGB(245, 205, 48), RightHand = Color3.fromRGB(245, 205, 48),
            UpperTorso = Color3.fromRGB(13, 105, 172), LowerTorso = Color3.fromRGB(13, 105, 172),
            LeftUpperLeg = Color3.fromRGB(75, 151, 75), LeftLowerLeg = Color3.fromRGB(75, 151, 75), LeftFoot = Color3.fromRGB(75, 151, 75),
            RightUpperLeg = Color3.fromRGB(75, 151, 75), RightLowerLeg = Color3.fromRGB(75, 151, 75), RightFoot = Color3.fromRGB(75, 151, 75),
        }
        local function noobTemplate()
            if X.noobTpl then return X.noobTpl end
            local ok, m = pcall(function()
                return Plrs:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
            end)
            if not ok or not m then return nil end
            for _, d in ipairs(m:GetDescendants()) do
                if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic")
                    or d:IsA("BodyColors") or d:IsA("Humanoid") or d:IsA("LuaSourceContainer")
                    or d:IsA("Animator") or d:IsA("SurfaceAppearance") then
                    d:Destroy()
                end
            end
            for _, d in ipairs(m:GetDescendants()) do
                if d:IsA("BasePart") then
                    local c = NOOB[d.Name]
                    if c then
                        d.Color = c
                        d.Material = Enum.Material.Plastic
                        if d:IsA("MeshPart") then pcall(function() d.TextureID = "" end) end
                    end
                end
            end
            local head = m:FindFirstChild("Head")
            if head and not head:FindFirstChildWhichIsA("Decal") then
                local f = Instance.new("Decal")
                f.Name = "face"
                f.Texture = "rbxasset://textures/face.png"
                f.Face = Enum.NormalId.Front
                f.Parent = head
            end
            X.noobTpl = m
            return m
        end

        local function miniSource()
