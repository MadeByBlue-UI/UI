    -- Petits points gris sombres qui tombent doucement (façon étoiles)
    local TILT = 0
    local rng = Random.new()
    local stars, starConn = {}, nil
    local dirX, dirY = -math.sin(math.rad(TILT)), math.cos(math.rad(TILT))
    local STAR_COLORS = {
        Color3.fromRGB(120, 120, 130), Color3.fromRGB(90, 90, 100), Color3.fromRGB(150, 150, 160),
    }
    onTheme(function() STAR_COLORS[2] = ACC.main:Lerp(Color3.new(0, 0, 0), 0.6) end)

    function buildStar()
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.BorderSizePixel = 0
        f.BackgroundColor3 = Color3.fromRGB(120, 120, 130)
        f.ZIndex = 3
        f.Parent = backdrop
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        return { f = f, x = 0, y = 0, speed = 60 }
    end

    function resetStar(s, initial)
        local size = backdrop.AbsoluteSize
        local x
        if rng:NextNumber() < 0.75 then -- la plupart tombent sur les côtés
            if rng:NextNumber() < 0.5 then
                x = rng:NextNumber(0, size.X * 0.14)
            else
                x = rng:NextNumber(size.X * 0.86, size.X + size.X * 0.08)
            end
        else
            x = rng:NextNumber(0, size.X)
        end
        s.x = x
        s.y = initial and rng:NextNumber(0, size.Y) or -rng:NextNumber(10, 120)
        s.speed = rng:NextNumber(25, 95)

        local sz = rng:NextInteger(2, 4)
        s.f.Size = UDim2.fromOffset(sz, sz)
        s.f.BackgroundColor3 = STAR_COLORS[rng:NextInteger(1, #STAR_COLORS)]
        s.t = rng:NextNumber(0.4, 0.85)
        s.f.BackgroundTransparency = 1 - (1 - s.t) * X.starFade
        s.f.Position = UDim2.fromOffset(s.x, s.y)
    end

    function syncStarCount()
        while #stars < S.starCount do
            local s = buildStar()
            table.insert(stars, s)
            resetStar(s, true)
        end
        while #stars > S.starCount do
            local s = table.remove(stars)
            s.f:Destroy()
        end
    end

    function startStars()
        if not S.stars then return end
        X.starTarget = 1                  -- fondu d'apparition
        if starConn then return end       -- déjà en cours (ex : réouverture pendant le fondu)
        syncStarCount()
        X.starFade = 0
        for _, s in ipairs(stars) do
            s.f.Visible = true
            resetStar(s, true)
        end
        starConn = RunS.Heartbeat:Connect(function(dt)
            -- fondu : 0.5 s pour apparaître, 0.22 s pour disparaître (comme la fenêtre)
            if X.starTarget > X.starFade then
                X.starFade = math.min(1, X.starFade + dt / 0.5)
            elseif X.starTarget < X.starFade then
                X.starFade = math.max(0, X.starFade - dt / 0.22)
            end
            local size = backdrop.AbsoluteSize
            for _, s in ipairs(stars) do
                local sp = s.speed * S.starSpeed
                s.x += dirX * sp * dt
                s.y += dirY * sp * dt
                if s.y > size.Y + 20 or s.x < -60 then resetStar(s, false) end
                s.f.Position = UDim2.fromOffset(s.x, s.y)
                s.f.BackgroundTransparency = 1 - (1 - s.t) * X.starFade
            end
            -- fondu terminé : on arrête tout
            if X.starTarget == 0 and X.starFade <= 0 then
                for _, s in ipairs(stars) do s.f.Visible = false end
                starConn:Disconnect()
                starConn = nil
            end
        end)
    end

    -- arrêt immédiat (réglages / nettoyage)
    function stopStars()
        X.starTarget, X.starFade = 0, 0
        if starConn then starConn:Disconnect(); starConn = nil end
        for _, s in ipairs(stars) do s.f.Visible = false end
    end

