    X.bodyErr = {}

    -- requête HTTP via l'exécuteur (si dispo)
    function X.httpJson(url)
        local req = (syn and syn.request) or http_request or request or (http and http.request) or (fluxus and fluxus.request)
        if type(req) ~= "function" then return nil end
        local ok, res = pcall(req, { Url = url, Method = "GET" })
        if not ok or type(res) ~= "table" then return nil end
        local body = res.Body
        if type(body) ~= "string" or body == "" then return nil end
        local ok2, data = pcall(function() return HttpS:JSONDecode(body) end)
        if ok2 then return data end
        return nil
    end

    -- cherche dans une table (peu importe sa forme) l'entrée { Type = "UserOutfit", Id = ... }
    function X.findOutfitId(t, depth)
        if type(t) ~= "table" or depth > 5 then return nil end
        local ty = t.Type or t.type
        if ty ~= nil and tostring(ty) == "UserOutfit" then
            local oid = tonumber(t.Id or t.id)
            if oid then return oid end
        end
        for _, v in pairs(t) do
            if type(v) == "table" then
                local r = X.findOutfitId(v, depth + 1)
                if r then return r end
            end
        end
        return nil
    end

    function X.bundleOutfitId(id)
        local det
        pcall(function() det = AES:GetItemDetails(id, Enum.AvatarItemType.Bundle) end)
        local oid = X.findOutfitId(det, 0)
        if oid then return oid end
        for _, url in ipairs({
            "https://catalog.roblox.com/v1/bundles/" .. id .. "/details",
            "https://catalog.roproxy.com/v1/bundles/" .. id .. "/details",
        }) do
            oid = X.findOutfitId(X.httpJson(url), 0)
            if oid then return oid end
        end
        return nil
    end

    function X.bundleDesc(oid)
        for i = 1, 3 do
            local ok, d = pcall(function() return Plrs:GetHumanoidDescriptionFromOutfitId(oid) end)
            if ok and d then return d end
            task.wait(0.4 * i)
        end
        return nil
    end

    -- Crée (si besoin) le corps R6 ou R15 du personnage
    function X.bodyRig(e, rg)
        if e[rg] then return e[rg] end
        if not e.desc then return nil end
        for _ = 1, 2 do
            local ok, m = pcall(function()
                return Plrs:CreateHumanoidModelFromDescription(e.desc, Enum.HumanoidRigType[rg])
            end)
            if ok and m then
                for _, d in ipairs(m:GetDescendants()) do
                    if d:IsA("LuaSourceContainer") then d:Destroy() end
                end
                e[rg] = m
                return m
            end
            X.lastErr = tostring(m)
            task.wait(0.3)
        end
        return nil
    end

    function X.myRigName()
        return (X.baseRig() == Enum.HumanoidRigType.R15) and "R15" or "R6"
    end

    -- Charge un personnage : renvoie (entrée) ou (nil, raison de l'échec)
    function X.loadBundle(id, name)
        if X.bodies[id] then return X.bodies[id] end
        if X.bodyLoading[id] then
            while X.bodyLoading[id] do task.wait() end
            return X.bodies[id], X.bodyErr[id]
        end
        X.bodyLoading[id] = true
        local entry, err
        local ok, e = pcall(function()
            local oid = X.bundleOutfitId(id)
            if not oid then err = "infos du personnage introuvables" return end
            local desc = X.bundleDesc(oid)
            if not desc then err = "apparence du personnage introuvable" return end
            local en = { name = name, desc = desc }
            if not X.bodyRig(en, X.myRigName()) then
                err = "modèle impossible à créer (" .. tostring(X.lastErr or "?") .. ")"
                return
            end
            entry = en
        end)
        if not ok then err = tostring(e) end
        X.bodies[id] = entry
        X.bodyErr[id] = (not entry) and (err or "inconnu") or nil
        X.bodyLoading[id] = nil
        dprint("personnage", id, entry and "ok" or ("échec : " .. tostring(X.bodyErr[id])))
        return entry, X.bodyErr[id]
    end

    -- Remplace UNE pièce du corps (char) par la même pièce prise dans le modèle src
    function X.swapPart(char, name, src)
        -- Nettoyer d'abord toutes les anciennes parties avec ce nom
        for _, child in ipairs(char:GetChildren()) do
            if child.Name:match("^_OldPart_" .. name) or child.Name == "_OldPart" then
                pcall(function() child:Destroy() end)
            end
        end
        
        local old = char:FindFirstChild(name)
        local from = src:FindFirstChild(name)
        if not (old and from and old:IsA("BasePart") and from:IsA("BasePart")) then 
            dprint("swapPart: part not found", name, "old:", tostring(old), "from:", tostring(from))
            return false 
        end

        dprint("swapPart: replacing", name)

        -- CACHER IMMÉDIATEMENT l'ancienne partie
        pcall(function() old.Transparency = 1 end)
        for _, c in ipairs(old:GetDescendants()) do
            pcall(function()
                if c:IsA("Decal") then
                    c.Transparency = 1
                elseif c:IsA("BasePart") then
                    c.Transparency = 1
                elseif c:IsA("SpecialMesh") then
                    c.Scale = Vector3.new(0, 0, 0)
                elseif c:IsA("SurfaceAppearance") then
                    c.Parent = nil
                end
            end)
        end
        
        -- Cloner la nouvelle partie avec TOUTES ses propriétés
        local new = from:Clone()
        new.Name = name
        new.Anchored = old.Anchored
        new.CanCollide = old.CanCollide
        new.CFrame = old.CFrame
        
        -- Supprimer les scripts et joints du clone
        for _, c in ipairs(new:GetDescendants()) do
            pcall(function()
                if c:IsA("LuaSourceContainer") or c:IsA("JointInstance") then 
                    c:Destroy() 
                end
            end)
        end
        
        -- Sauvegarder TOUS les Motor6D et Attachments qui référencent l'ancienne partie
        local connections = {}
        for _, d in ipairs(char:GetDescendants()) do
            pcall(function()
                if d:IsA("Motor6D") then
                    local p0, p1 = d.Part0 == old, d.Part1 == old
                    if p0 or p1 then
                        table.insert(connections, {motor = d, isPart0 = p0, isPart1 = p1})
                    end
                elseif d:IsA("Weld") or d:IsA("WeldConstraint") then
                    local p0, p1 = d.Part0 == old, d.Part1 == old
                    if p0 or p1 then
                        table.insert(connections, {weld = d, isPart0 = p0, isPart1 = p1})
                    end
                end
            end)
        end
        
        -- Renommer l'ancienne pièce
        old.Name = "_OldPart_" .. name .. "_" .. tick()
        
        -- Parenter la nouvelle partie
        new.Parent = char
        
        -- Reconstruire toutes les connexions vers la nouvelle partie
        for _, conn in ipairs(connections) do
            pcall(function()
                if conn.motor then
                    if conn.isPart0 then conn.motor.Part0 = new end
                    if conn.isPart1 then conn.motor.Part1 = new end
                elseif conn.weld then
                    if conn.isPart0 then conn.weld.Part0 = new end
                    if conn.isPart1 then conn.weld.Part1 = new end
                end
            end)
        end
        
        -- Copier les propriétés Motor6D du modèle source
        local srcMotors = {}
        for _, d in ipairs(src:GetDescendants()) do
            if d:IsA("Motor6D") then srcMotors[d.Name] = d end
        end
        
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Motor6D") and srcMotors[d.Name] then
                pcall(function()
                    if d.Part1 == new then d.C1 = srcMotors[d.Name].C1 end
                    if d.Part0 == new then d.C0 = srcMotors[d.Name].C0 end
                end)
            end
        end
        
        -- Copier Attachments manquants de la source
        for _, srcAtt in ipairs(from:GetChildren()) do
            if srcAtt:IsA("Attachment") and not new:FindFirstChild(srcAtt.Name) then
                pcall(function()
                    local att = srcAtt:Clone()
                    att.Parent = new
                end)
            end
        end
        
        -- Mettre à jour BodyColors
        local bc = char:FindFirstChildOfClass("BodyColors")
        local prop = X.COLORPROP[name]
        if bc and prop then 
            pcall(function() bc[prop] = from.Color end) 
        end
        
        -- Détruire l'ancienne partie
        task.delay(0.05, function()
            pcall(function() 
                if old and old.Parent then 
                    old:Destroy() 
                end 
            end)
        end)
        
        dprint("swapPart: success", name)
        return true
    end

    -- Aperçu : applique les parties choisies sur la copie de ton avatar
    function X.applyBodyOps(char)
        local rg = X.rigOf(char)
        local n = 0
        for g, bid in pairs(X.bodyMap) do
            local e = X.bodies[bid]
            local src = e and e[rg]
            local names = X.GROUPS[rg][g]
            if src and names then
                for _, nm in ipairs(names) do
                    local okS, did = pcall(X.swapPart, char, nm, src)
                    if okS and did then n += 1 end
                end
            end
        end
        return n
    end

    -- Ton vrai perso : applique (ou remet) les parties de la liste "groups"
    function X.applyReal(groups)
        local char = lp.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then 
            dprint("applyReal: no character or humanoid")
            return false 
        end
        local rg = X.rigOf(char)

        -- Créer ou recréer le snapshot si nécessaire
        if X.snapChar ~= char or not X.snap then 
            dprint("Creating new snapshot for character")
            X.snap = nil 
        end
        
        if not X.snap then
            local was = char.Archivable
            char.Archivable = true
            local ok, c = pcall(function() return char:Clone() end)
            char.Archivable = was
            if not ok or not c then 
                dprint("applyReal: failed to clone character")
                return false 
            end
            for _, d in ipairs(c:GetDescendants()) do
                if d:IsA("LuaSourceContainer") then d:Destroy() end
            end
            X.snap, X.snapChar = c, char
            dprint("Snapshot created successfully")
        end

        local rn = hum.RequiresNeck
        pcall(function() hum.RequiresNeck = false end) -- évite de "mourir" pendant l'échange de tête / torse
        
        local success = 0
        for _, g in ipairs(groups) do
            local bid = X.bodyMap[g]
            local src
            if bid then
                local e = X.bodies[bid]
                src = e and X.bodyRig(e, rg)
                if not src then
                    dprint("applyReal: no source for group " .. g .. " bundle " .. tostring(bid))
                end
            else
                src = X.snap
            end
            local names = X.GROUPS[rg][g]
            if src and names then
                for _, nm in ipairs(names) do 
                    local ok = pcall(X.swapPart, char, nm, src)
                    if ok then success = success + 1 end
                end
            end
        end
        
        pcall(function() hum.RequiresNeck = rn end)
        dprint("applyReal: " .. success .. " parts swapped successfully")
        return success > 0
    end

