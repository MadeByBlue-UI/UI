    -- Avatar de ton compte en R15 (pour l'aperçu quand ton perso est en R6)
    function X.ensureBaseR15()
        if X.baseR15 then return X.baseR15 end
        local ok, desc = pcall(function() return Plrs:GetHumanoidDescriptionFromUserId(lp.UserId) end)
        if not ok or not desc then return nil end
        local ok2, m = pcall(function()
            return Plrs:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
        end)
        if not ok2 or not m then return nil end
        for _, d in ipairs(m:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then d:Destroy() end
        end
        m.Name = "PreviewAvatarR15"
        X.baseR15 = m
        return m
    end

    function X.previewBase()
        if X.baseR15 and X.rigOf(lp.Character) == "R6" and #X.mappedGroups() > 0 then
            return X.baseR15
        end
        return X.base
    end

    -- Applique des parties (ou tout) d'un personnage : renvoie (ok, raison)
    function X.setBody(bid, groups)
        local e = X.bodies[bid]
        if not e then return false, "personnage non chargé" end
        local rg = X.rigOf(lp.Character)
        if not X.bodyRig(e, rg) then
            return false, "corps " .. rg .. " impossible à créer"
        end
        X.bodyRig(e, X.myRigName())
        if rg == "R6" then
            X.bodyRig(e, "R15")   -- l'aperçu passe en R15 pour montrer les vraies formes
            X.ensureBaseR15()
        end
        for _, g in ipairs(groups) do X.bodyMap[g] = bid end
        local ok = X.applyReal(groups)
        X.previewDirty()
        sfx("wear")
        setStatus(ok and "Personnage appliqué" or "Pas de personnage disponible (aperçu seulement)")
        return ok
    end

    -- Applique les parties de corps retenues par un outfit
    function X.applyOutfitBody(body)
        local byBundle = {}
        for g, bid in pairs(body) do
            if type(bid) == "number" then
                byBundle[bid] = byBundle[bid] or {}
                table.insert(byBundle[bid], g)
            end
        end
        for bid, groups in pairs(byBundle) do
            local e = X.loadBundle(bid, "Personnage " .. bid)
            if e then
                X.setBody(bid, groups)
            else
                say("Personnage " .. bid .. " introuvable pour cet outfit.")
            end
        end
    end

    -- Remet ton corps d'origine pour certaines parties seulement
    function X.revertGroups(groups)
        for _, g in ipairs(groups) do X.bodyMap[g] = nil end
        X.applyReal(groups)
        X.previewDirty()
        sfx("unwear")
        setStatus("Partie d'origine remise")
    end

    function X.resetBody()
        local gs = X.mappedGroups()
        if #gs == 0 then
            setStatus("Ton corps est déjà d'origine")
            return
        end
        X.bodyMap = {}
        X.applyReal(gs)
        X.previewDirty()
        sfx("unwear")
        setStatus("Corps d'origine remis")
    end

