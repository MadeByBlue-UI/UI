            l.Font = Enum.Font.GothamBold
            l.TextSize = size
            l.TextStrokeTransparency = 0.6
            l.ZIndex = 4
            l.Parent = holder
            table.insert(letters, { l = l, x = x })
            x += widths[i]
        end
        table.insert(X.rb, { holder = holder, letters = letters })
    end

    X.fxConn = RunS.Heartbeat:Connect(function(dt)
        if not isOpen then return end
        local t = os.clock()
        dt = math.min(dt, 0.05)

        -- points flottants
        local m = UIS:GetMouseLocation()
        for _, g in ipairs(X.dotGroups) do
            local host = g.host
            if host.Visible and host:IsDescendantOf(gui) then
                local W, H = host.AbsoluteSize.X, host.AbsoluteSize.Y
                if W > 0 and H > 0 then
                    local mx, my = m.X - host.AbsolutePosition.X, m.Y - host.AbsolutePosition.Y
                    local relax = math.min(1, dt * 0.8)
                    for _, d in ipairs(g.dots) do
                        local dx, dy = d.x - mx, d.y - my
                        local dist = math.sqrt(dx * dx + dy * dy)
                        if dist < 80 and dist > 0.01 then
                            local f = (80 - dist) / 80 * 320 * dt
                            d.vx += dx / dist * f
                            d.vy += dy / dist * f
                        end
                        d.vx += (d.bx - d.vx) * relax
                        d.vy += (d.by - d.vy) * relax
                        d.x += d.vx * dt
                        d.y += d.vy * dt
                        if d.x < 0 or d.x > W then d.vx = -d.vx; d.bx = -d.bx; d.x = math.clamp(d.x, 0, W) end
                        if d.y < 0 or d.y > H then d.vy = -d.vy; d.by = -d.by; d.y = math.clamp(d.y, 0, H) end
                        d.f.Position = UDim2.fromOffset(d.x, d.y)
                    end
                end
            end
        end

        -- prix arc-en-ciel qui rebondissent
        for i = #X.rb, 1, -1 do
            local e = X.rb[i]
            if not e.holder.Parent then
                table.remove(X.rb, i)
            else
                for k, L in ipairs(e.letters) do
                    local b = math.abs(math.sin(t * 7 - k * 0.6)) * 6
