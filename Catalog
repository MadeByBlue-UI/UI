    -- list = joueurs détectés (relais) ; on garde seulement ceux présents dans la partie
    function X.netTags(list)
        if not S.netTag then X.netClearTags() return end
        local seen = {}
        for _, p in ipairs(list or {}) do
            if type(p) == "table" and type(p.uid) == "number" and p.uid ~= lp.UserId then
                local pl = Plrs:GetPlayerByUserId(p.uid)
                local head = pl and pl.Character and pl.Character:FindFirstChild("Head")
                if head then
                    seen[p.uid] = true
                    local t = NET.tags[p.uid]
                    if not t or t.Adornee ~= head or not t.Parent then
                        if t then pcall(function() t:Destroy() end) end
                        NET.tags[p.uid] = X.netMakeTag(pl, head)
                    end
                end
            end
        end
        for uid, t in pairs(NET.tags) do
            if not seen[uid] then
                pcall(function() t:Destroy() end)
                NET.tags[uid] = nil
            end
        end
    end

    function X.netClearAll()
        for uid, info in pairs(NET.remote) do
            pcall(X.netClean, info)
            NET.remote[uid] = nil
        end
        NET.queue = {}
        NET.count = 0
    end

    -- un cycle réseau (dans sa propre tâche : ne bloque jamais l'interface)
    function X.netSync(force)
        if NET.busy then return end
        NET.busy = true
        task.spawn(function()
            local ids, body, adjData = X.netMine()
            if (S.netUrl or "") == "" then
                -- mode sans serveur (ntfy.sh) : on publie seulement quand la tenue change
                local sig = X.netSig(ids, body)
                local err
                if S.netShare or S.netTag then
                    local psig = S.netShare and sig or "tag"
                    if psig ~= NET.pubSig and os.clock() - (NET.lastPub or 0) >= 4 then
                        local msg = { uid = lp.UserId, ids = {} }
                        if S.netShare then msg.ids, msg.body = ids, body end
                        local r, e = X.ntfyPublish(msg)
                        if r then NET.pubSig, NET.lastPub = psig, os.clock() else err = e end
                    end
                elseif NET.pubSig then
                    local r = X.ntfyPublish({ uid = lp.UserId, off = true })
                    if r then NET.pubSig = nil end
                end
                local list
                if (S.netView or S.netTag) and not err then list, err = X.ntfyPoll() end
                NET.lastSync = os.clock()
                NET.busy = false
                if err then NET.status = "erreur : " .. tostring(err) return end
                NET.status = "connecté (relais public)"
                if list then
                    if S.netView then X.netReceive(list) end
                    X.netTags(list)
                end
                return
            end
            local payload = {
                room = X.netRoom(), uid = lp.UserId, name = lp.Name,
                share = (S.netShare or S.netTag) and true or false,
            }
            if S.netShare then 
                payload.ids, payload.body, payload.adj = ids, body, adjData 
            end
            local data, err = X.netReq("/sync", payload)
            NET.lastSync = os.clock()
            NET.busy = false
            if not data then
                NET.status = "erreur : " .. tostring(err)
                return
            end
            NET.status = "connecté"
            if type(data.players) == "table" then
                if S.netView then X.netReceive(data.players) end
                X.netTags(data.players)
            end
        end)
    end

    -- boucle principale : très légère (1 réveil par seconde)
    task.spawn(function()
        while NET.running do
            task.wait(1)
            if not (S.netShare or S.netView or S.netTag) then
                if next(NET.remote) then X.netClearAll() end
                X.netClearTags()
                NET.status = "inactif"
            else
                local ids, body, adjData = X.netMine()
                local sig = X.netSig(ids, body, adjData)
                local since = os.clock() - NET.lastSync
                local interval = (S.netView or S.netTag) and S.netViewInterval or S.netIdleInterval
                local shareChanged = S.netShare and sig ~= NET.lastSig and since >= S.netShareDelay
                local timeToSync = since >= interval
                
                -- Mode manuel : ne partage que sur demande explicite (via bouton)
                if S.netManualSync then
                    shareChanged = NET.forceSync and since >= S.netShareDelay
                    timeToSync = false  -- En mode manuel, pas de synchronisation automatique
                    if not NET.forceSync then
                        shareChanged = false  -- Pas de partage automatique non plus
                    end
                    NET.forceSync = false
                end
                
                if shareChanged or timeToSync then
                    NET.lastSig = sig
                    X.netSync()
                end
                if not S.netView and next(NET.remote) then X.netClearAll() end
                if not S.netTag and next(NET.tags) then X.netClearTags() end
            end
        end
    end)

    -- exécuteur de tâches : 1 tâche toutes les 0.12 s (aucun freeze)
    task.spawn(function()
        while NET.running do
            local job = table.remove(NET.queue, 1)
            if job then
                pcall(job)
                task.wait(0.12)
            else
                task.wait(0.4)
            end
        end
    end)

    function X.netStop()
        NET.running = false
