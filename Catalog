    UIS.InputBegan:Connect(function(input, gpe)
        if gpe or not S.shortcuts or not isOpen then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if not UIS:IsKeyDown(Enum.KeyCode.LeftControl) then return end
        if input.KeyCode == Enum.KeyCode.F then
            if settingsOpen then setSettingsOpen(false) end
            task.defer(function() searchBox:CaptureFocus() end)
        elseif input.KeyCode == Enum.KeyCode.One then
            setTab("worn")
        elseif input.KeyCode == Enum.KeyCode.Two then
            setTab("out")
        elseif input.KeyCode == Enum.KeyCode.Three then
            setTab("coll")
        elseif input.KeyCode == Enum.KeyCode.R then
            doSurprise()
        elseif input.KeyCode == Enum.KeyCode.Z then
            undoLast()
        elseif input.KeyCode == Enum.KeyCode.Backspace then
            X.removeLast()
        elseif input.KeyCode == Enum.KeyCode.H then
            X.showHelp()
        end
    end)

