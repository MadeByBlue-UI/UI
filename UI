                ---------------------------------------------------------- état
                local function GetSelectedList()
                    local list = {}
                    for _, o in ipairs(Options) do
                        if SelectedSet[o] then table.insert(list, o) end
                    end
                    return list
                end

                local function TitleText()
                    local base = Cfg.Name or "Dropdown"
                    if Multi then
                        local names = {}
                        for _, o in ipairs(GetSelectedList()) do table.insert(names, tostring(o)) end
                        if #names == 0 then return base end
                        return base .. " - " .. table.concat(names, ", ")
                    end
                    if Selected ~= nil then
                        return base .. " - " .. tostring(Selected)
                    end
                    return base
                end

                local function IsSelected(item)
                    if Multi then return SelectedSet[item] == true end
                    return Selected == item
                end

                local function ApplyVisual(item, btn)
                    local sel = IsSelected(item)
                    btn.Text = ((Multi and sel) and "✓  " or "") .. tostring(item)
                    btn.TextColor3 = sel and SelectedTheme.ElementAccent or SelectedTheme.TextDark
                    btn.BackgroundColor3 = SelectedTheme.Main
                    btn.BackgroundTransparency = sel and 0.45 or 0.8
                end

                local function RefreshVisuals()
                    for item, btn in pairs(ItemButtons) do
                        ApplyVisual(item, btn)
                    end
                end

                local function CurrentValue()
                    if Multi then return GetSelectedList() end
                    return Selected
                end

                local function Commit()
                    DTitle.Text = TitleText()
                    local value = CurrentValue()
                    Library.Flags[Flag] = value
                    if Cfg.Callback then
                        Cfg.Callback(value)
                    end
                end

                ---------------------------------------------------------- taille / recherche
                local function VisibleCount()
                    local n = 0
                    for _, btn in pairs(ItemButtons) do
                        if btn.Visible then n = n + 1 end
                    end
                    return n
                end

                local function ConfigureSearch()
                    local show = Cfg.Search == true or (Cfg.Search ~= false and #Options > 8)
                    SearchFrame.Visible = show
                    SearchH = show and 32 or 0
                end

                local function Resize()
                    local n = VisibleCount()
                    local listH = math.min(n * 32 + 10, MaxListH)
                    Container.CanvasSize = UDim2.new(0, 0, 0, n * 32 + 10)
                    Container.Position = UDim2.new(0, 0, 0, 34 + SearchH)
                    Tween(Container, 0.25, {Size = UDim2.new(1, 0, 0, listH)})
                    Tween(Drop, 0.35, {Size = UDim2.new(1, 0, 0, Expanded and (34 + SearchH + listH) or 34)})
                end

                local function ApplySearch()
                    local q = DropSearchBox.Text:lower()
                    for item, btn in pairs(ItemButtons) do
                        btn.Visible = (q == "") or (tostring(item):lower():find(q, 1, true) ~= nil)
                    end
                    Resize()
                end

                local function Collapse()
                    Expanded = false
                    DropSearchBox.Text = ""
                    Tween(Arrow, 0.4, {Rotation = 0})
                    Resize()
                end

                DropSearchBox:GetPropertyChangedSignal("Text"):Connect(ApplySearch)
                DropSearchBox.Focused:Connect(function()
                    TS:Create(DropSearchStroke, TweenInfo.new(0.3), {Color = SelectedTheme.ElementAccent, Transparency = 0}):Play()
                end)
                DropSearchBox.FocusLost:Connect(function()
                    TS:Create(DropSearchStroke, TweenInfo.new(0.3), {Color = SelectedTheme.TextDark, Transparency = 0.8}):Play()
                end)

                ---------------------------------------------------------- liste
                local function RefreshList(newOptions)
                    Options = newOptions or Options

                    for _, v in pairs(Container:GetChildren()) do
                        if v:IsA("TextButton") then v:Destroy() end
                    end
                    ItemButtons = {}

                    -- Retire de la sélection ce qui n'existe plus dans la liste
                    local lookup = {}
                    for _, o in ipairs(Options) do lookup[o] = true end
                    if Multi then
                        for k in pairs(SelectedSet) do
                            if not lookup[k] then SelectedSet[k] = nil end
                        end
                    elseif Selected ~= nil and not lookup[Selected] then
                        Selected = nil
                    end
                    DTitle.Text = TitleText()

                    for index, item in ipairs(Options) do
                        -- (pas dans ThemeObjects.TextDark : la couleur dépend de l'état sélectionné, gérée par ApplyVisual)
                        local Btn = Create("TextButton", {
                            Parent = Container,
                            Size = UDim2.new(1, 0, 0, 28),
                            BackgroundColor3 = SelectedTheme.Main,
                            BackgroundTransparency = 0.8,
                            Text = tostring(item),
                            Font = Library.GlobalFont,
                            TextColor3 = SelectedTheme.TextDark,
                            TextSize = 13,
                            ZIndex = 9,
                            LayoutOrder = index,
                            TextXAlignment = Enum.TextXAlignment.Center,
                            AutoButtonColor = false
                        })
                        AddCorner(Btn, 6)
                        ItemButtons[item] = Btn
                        ApplyVisual(item, Btn)

                        local hoverTweenBtn, leaveTweenBtn
                        Btn.MouseEnter:Connect(function()
                            PlaySound("Hover")
                            if leaveTweenBtn then leaveTweenBtn:Cancel() end
                            hoverTweenBtn = TS:Create(Btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.2, TextColor3 = SelectedTheme.Text})
                            hoverTweenBtn:Play()
                        end)
                        Btn.MouseLeave:Connect(function()
                            if hoverTweenBtn then hoverTweenBtn:Cancel() end
                            local sel = IsSelected(item)
                            leaveTweenBtn = TS:Create(Btn, TweenInfo.new(0.2), {
                                BackgroundTransparency = sel and 0.45 or 0.8,
                                TextColor3 = sel and SelectedTheme.ElementAccent or SelectedTheme.TextDark
                            })
                            leaveTweenBtn:Play()
                        end)
                        Btn.MouseButton1Click:Connect(function()
                            PlaySound("Click")
                            if Multi then
                                SelectedSet[item] = (not SelectedSet[item]) or nil
                                RefreshVisuals()
                                Commit()
                            else
                                Selected = item
                                RefreshVisuals()
                                Commit()
                                Collapse()
                            end
                        end)
                    end

                    ConfigureSearch()
                    ApplySearch()
                end

                RefreshList(Options)
                Library.Flags[Flag] = CurrentValue()

                if Cfg.Default ~= nil and Cfg.Callback then
                    task.spawn(Cfg.Callback, CurrentValue())
                end

