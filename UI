    local function BuildRow(e, i, tokens, animate)
        local y = (i - 1) * (ROW_H + ROW_GAP)
        local kc = KindColor(e.kind)
        local anim = animate and i <= 12

        local row = N("CanvasGroup", {
            Parent = List, Size = UDim2.new(1, -12, 0, ROW_H), Position = UDim2.new(0, anim and 22 or 6, 0, y),
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 25003, GroupTransparency = anim and 1 or 0
        })
        local hit = N("TextButton", {
            Parent = row, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 25003
        })
        local icon = N("Frame", {
            Parent = row, Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0, 10, 0.5, -15),
            BackgroundColor3 = kc, BackgroundTransparency = 0.78, BorderSizePixel = 0, ZIndex = 25004
        })
        Round(icon, 8)
        N("TextLabel", {
            Parent = icon, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = KIND_GLYPH[e.kind] or "•",
            TextColor3 = kc, TextSize = 14, Font = Library.GlobalFontBold, ZIndex = 25005
        })

        local cw = CTRL_W[e.kind] or 0
        local rightPad = cw > 0 and (cw + 26) or 14

        N("TextLabel", {
            Parent = row, Size = UDim2.new(1, -(50 + rightPad), 0, 18), Position = UDim2.new(0, 50, 0, 7),
            BackgroundTransparency = 1, RichText = true, Text = Highlight(e.name, tokens), TextSize = 14,
            TextColor3 = SelectedTheme.Text, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 25004
        })
        local crumb = e.tabName .. ((e.blockName ~= "") and ("  ›  " .. e.blockName) or "")
        N("TextLabel", {
            Parent = row, Size = UDim2.new(1, -(50 + rightPad), 0, 14), Position = UDim2.new(0, 50, 0, 26),
            BackgroundTransparency = 1, Text = crumb, TextSize = 11, TextColor3 = SelectedTheme.TextDark,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 25004
        })

        local refresh
        if cw > 0 and CONTROLS[e.kind] then
            local ctrl = N("Frame", {
                Parent = row, Size = UDim2.fromOffset(cw, 26), AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0), BackgroundTransparency = 1, ZIndex = 25005
