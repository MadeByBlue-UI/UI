        local function SyncText()
            local text = SearchBox.Text
            local new = {}
            local okU = pcall(function()
                for _, cp in utf8.codes(text) do new[#new + 1] = utf8.char(cp) end
            end)
            if not okU then
                new = {}
                for i = 1, #text do new[i] = text:sub(i, i) end
            end

            local oldN, newN = #Chars, #new
            -- partie commune au début et à la fin : ces lettres sont conservées (elles glissent juste à leur nouvelle place)
            local p = 0
            while p < oldN and p < newN and Chars[p + 1].ch == new[p + 1] do p += 1 end
            local s = 0
            while s < oldN - p and s < newN - p and Chars[oldN - s].ch == new[newN - s] do s += 1 end

            local xs, acc = {}, ""
            for i = 1, newN do
                xs[i] = Measure(acc)
                acc = acc .. new[i]
            end

            for i = p + 1, oldN - s do FadeOut(Chars[i].label) end

            local out = {}
            for i = 1, p do out[i] = Chars[i] end
            for i = p + 1, newN - s do out[i] = {ch = new[i], label = MakeChar(new[i], xs[i])} end
            for k = 0, s - 1 do
                local oldC = Chars[oldN - s + 1 + k]
                local i = newN - s + 1 + k
                out[i] = oldC
                Tween(oldC.label, 0.22, {Position = UDim2.new(0, xs[i], 0.5, 0)}, Enum.EasingStyle.Quint)
            end
            Chars = out
