            -- 🎚️ SLIDER AVEC DÉCIMALES
            -- Options : Min, Max, Default, Decimals (0-6), Step, Suffix
            --   CreateSlider({Name="Speed", Min=0, Max=5, Decimals=2, Suffix="x", Default=1})
            --   CreateSlider({Name="Smoothing", Min=0, Max=1, Step=0.05})  -- Decimals déduit du Step
            -- Retourne {Set, Get}.
            function Elements:CreateSlider(Cfg)
                ElementOrder = ElementOrder + 1
                local Min = Cfg.Min or 0
                local Max = Cfg.Max or 100
                local Flag = Cfg.Flag or Cfg.Name
                local Suffix = Cfg.Suffix or ""

                local Decimals = Cfg.Decimals
                if Decimals == nil then
                    Decimals = 0
                    if Cfg.Step then
                        local frac = tostring(Cfg.Step):match("%.(%d+)")
                        Decimals = frac and #frac or 0
                    end
                end
                Decimals = math.clamp(Decimals, 0, 6)
                local Step = Cfg.Step or (10 ^ -Decimals)
                local range = math.max(Max - Min, 1e-9)

                local function Snap(v)
                    v = math.clamp(v, Min, Max)
                    v = Min + math.floor((v - Min) / Step + 0.5) * Step
                    local m = 10 ^ Decimals
                    return math.clamp(math.floor(v * m + 0.5) / m, Min, Max)
                end

                local function Format(v)
                    return string.format("%." .. Decimals .. "f", v) .. Suffix
                end

                local Val = Snap(Cfg.Default or Min)
                Library.Flags[Flag] = Val

                local Frame = Create("Frame", {
                    Parent = TargetParent,
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = SelectedTheme.Second,
                    BackgroundTransparency = 0.5,
                    ZIndex = 7,
                    LayoutOrder = ElementOrder,
                    ThemeTag = "Second"
                })
