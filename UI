                    ZIndex = 6,
                    ThemeTag = "Text"
                })
                AttachTooltip(BlockTitle, BlockCfg.Tooltip or BlockCfg.Description)

                -- 🎯 BOUTON COLLAPSE/EXPAND
                local isCollapsed = false

                local CollapseButton = Create("TextButton", {
                    Parent = BlockFrame,
                    Size = UDim2.new(0, 32, 0, 32),
                    Position = UDim2.new(1, -36, 0, 2),
                    BackgroundColor3 = SelectedTheme.Main,
                    BackgroundTransparency = 0.7,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 7,
                    ThemeTag = "Main"
                })
                AddCorner(CollapseButton, 6)

                local CollapseArrow = Create("TextLabel", {
                    Parent = CollapseButton,
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Text = "▼",
                    Font = Enum.Font.GothamBold,
                    TextColor3 = SelectedTheme.Accent,
                    TextSize = 14,
                    ZIndex = 8,
                    ThemeTag = "Accent"
                })

                CollapseButton.MouseEnter:Connect(function()
                    PlaySound("Hover")
                    Tween(CollapseButton, 0.2, { BackgroundTransparency = 0.3 })
                    Tween(CollapseArrow, 0.2, { TextSize = 16 })
                end)

                CollapseButton.MouseLeave:Connect(function()
                    Tween(CollapseButton, 0.2, { BackgroundTransparency = 0.7 })
                    Tween(CollapseArrow, 0.2, { TextSize = 14 })
                end)

                local BlockContent = Create("Frame", {
                    Parent = BlockFrame,
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 0, 42),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    ZIndex = 5
                })

                Create("UIListLayout", { Parent = BlockContent, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) })
                Create("UIPadding", { Parent = BlockContent, PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) })

                -- 🎬 COLLAPSE/EXPAND : la hauteur d'ouverture est recalculée depuis le contenu (animation fluide dans les 2 sens)
                local function SetCollapsed(state)
                    isCollapsed = state

                    local startH = BlockFrame.AbsoluteSize.Y
                    BlockFrame.AutomaticSize = Enum.AutomaticSize.None
                    BlockFrame.Size = UDim2.new(1, 0, 0, startH)

                    local targetH = isCollapsed and 42 or (42 + BlockContent.AbsoluteSize.Y)

                    local blockTween = Tween(BlockFrame, 0.4, {Size = UDim2.new(1, 0, 0, targetH)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                    Tween(CollapseArrow, 0.4, {Rotation = isCollapsed and -90 or 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

                    if not isCollapsed then
                        blockTween.Completed:Connect(function()
                            if not isCollapsed then
                                BlockFrame.AutomaticSize = Enum.AutomaticSize.Y
                            end
                        end)
                    end
                end

                CollapseButton.MouseButton1Click:Connect(function()
                    PlaySound("Click")
                    SetCollapsed(not isCollapsed)
                end)

                -- permet à la recherche de rouvrir un bloc replié avant d'y aller
                Library.BlockSetters[BlockFrame] = function(collapsed)
                    if isCollapsed == collapsed then return false end
                    SetCollapsed(collapsed)
                    return true
                end

                return GetElements(BlockContent, BlockFrame, BlockName)
            end
        end

        return TabElements, Activate
    end

