    -- 🎨 Application complète d'un thème (presets, thèmes sauvegardés, imports, reset)
    local ApplyingTheme = false

    local function ApplyTheme(NewTheme, quiet)
        ApplyingTheme = true

        MainBgColor.BackgroundColor3 = NewTheme.Main
        SetImageAsync(MainBgImage, "Image", NewTheme.Background or "")
        MainBgColor.BackgroundTransparency = NewTheme.Transparency or 0.25
        MainBgImage.ImageTransparency = NewTheme.ImageTransparency or 0
        OrbsTrans = NewTheme.OrbsTransparency or 0.5

        for _, child in pairs(OrbContainer:GetChildren()) do
            if child:IsA("Frame") then
                child.BackgroundTransparency = OrbsTrans
            end
        end

        SelectedTheme = NewTheme
        for _, k in ipairs(THEME_COLOR_KEYS) do
            Themes.Default[k] = NewTheme[k]
        end
        Themes.Default.Gradient = NewTheme.Gradient or GetGradientSeq(NewTheme)

        if NewTheme.Font then
            UpdateFonts(NewTheme.Font)
        end

        UpdateThemeObjects()
        UpdateGradients(Themes.Default.Gradient)

        local function SetItem(flag, value)
            local it = Library.Items[flag]
            if it and value ~= nil then pcall(it.Set, value) end
        end
        SetItem("Settings_MainColor", NewTheme.Main)
        SetItem("Settings_SecondColor", NewTheme.Second)
        SetItem("Settings_AccentColor", NewTheme.Accent)
        SetItem("Settings_ElementColor", NewTheme.ElementAccent)
        SetItem("Settings_TextColor", NewTheme.Text)
        SetItem("Settings_TextDarkColor", NewTheme.TextDark)
        SetItem("Settings_GradStart", NewTheme.GradientStart or NewTheme.Accent)
        SetItem("Settings_GradEnd", NewTheme.GradientEnd or NewTheme.Accent)
        SetItem("Settings_BgTrans", math.floor((NewTheme.Transparency or 0.25) * 100 + 0.5))
        SetItem("Settings_ImageTrans", math.floor((NewTheme.ImageTransparency or 0) * 100 + 0.5))
        SetItem("Settings_OrbTrans", math.floor((NewTheme.OrbsTransparency or 0.5) * 100 + 0.5))
        SetItem("Settings_BgImage", NewTheme.Background or "")
        if NewTheme.Font then SetItem("Settings_Font", NewTheme.Font) end
        SetItem("Settings_CornerRadius", math.clamp(NewTheme.CornerRadius or Library.GlobalCornerValue, 0, 50))

        ApplyingTheme = false
        UpdateThemeObjects()
        if not quiet then
            Library:Notify({Title = "Theme Loaded", Content = "Theme applied", Type = "Success"})
        end
    end

