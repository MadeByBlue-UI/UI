                    task.spawn(Cfg.Callback, Color)
                end

                local function VisualUpdate(newH, newS, newV)
                    h = newH or h
                    s = newS or s
                    v = newV or v
                    Update(Color3.fromHSV(h, s, v), true)
                end

                local function ChannelInput(box, channel)
                    box.FocusLost:Connect(function()
                        local n = tonumber(box.Text)
                        if not n then
                            box.Text = tostring(R255(Color[channel]))
                            return
                        end
                        n = math.clamp(math.floor(n + 0.5), 0, 255)
                        local r, g, b = R255(Color.R), R255(Color.G), R255(Color.B)
                        if channel == "R" then r = n elseif channel == "G" then g = n else b = n end
                        Update(Color3.fromRGB(r, g, b))
                    end)
                end
                ChannelInput(RInput, "R")
                ChannelInput(GInput, "G")
                ChannelInput(BInput, "B")

