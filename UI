    local allSearchableElements = {}
    local searchBlocks = {}
    local searchTabs = {}
    local IndexingEnabled = true -- les Settings sont maintenant indexés aussi

    local ACCENTS = {
        ["à"] = "a", ["â"] = "a", ["ä"] = "a", ["á"] = "a", ["ã"] = "a", ["å"] = "a",
        ["ç"] = "c", ["é"] = "e", ["è"] = "e", ["ê"] = "e", ["ë"] = "e",
        ["î"] = "i", ["ï"] = "i", ["í"] = "i", ["ô"] = "o", ["ö"] = "o", ["ó"] = "o", ["õ"] = "o",
        ["ù"] = "u", ["û"] = "u", ["ü"] = "u", ["ú"] = "u", ["ñ"] = "n", ["œ"] = "oe", ["ÿ"] = "y",
        ["É"] = "e", ["È"] = "e", ["Ê"] = "e", ["À"] = "a", ["Ç"] = "c", ["Ô"] = "o", ["Î"] = "i", ["Û"] = "u"
    }

    local function Norm(s)
        s = tostring(s or ""):lower()
        for k, v in pairs(ACCENTS) do
            s = s:gsub(k, v)
        end
        return s
    end

    local function Esc(s)
        return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
    end

    -- Distance d'édition (avec sortie anticipée)
    local function Lev(a, b, max)
        local la, lb = #a, #b
        if math.abs(la - lb) > max then return max + 1 end
        local prev = {}
        for j = 0, lb do prev[j] = j end
        for i = 1, la do
            local cur = {[0] = i}
            local best = i
            for j = 1, lb do
                local cost = (a:byte(i) == b:byte(j)) and 0 or 1
                local v = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
                cur[j] = v
                if v < best then best = v end
            end
            if best > max then return max + 1 end
            prev = cur
        end
        return prev[lb]
    end

    -- Lettres dans l'ordre ("shtp" -> "Show Tooltips"), retourne aussi l'écart
    local function Subseq(q, s)
        local qi, first = 1, nil
        local qb = q:byte(1)
        for i = 1, #s do
            if s:byte(i) == qb then
                first = first or i
                qi += 1
                if qi > #q then return true, (i - first + 1) - #q end
                qb = q:byte(qi)
            end
        end
        return false, 0
    end

    local function AddToSearch(element, name, tabRec, blockFrame, blockName, kind, cfg, extra)
        if not IndexingEnabled then return end
        cfg = cfg or {}
        kind = kind or "Label"
        local kw = cfg.Keywords
        if type(kw) == "table" then kw = table.concat(kw, " ") end
        table.insert(allSearchableElements, {
            element = element,
            name = tostring(name),
            kind = kind,
            tab = tabRec,
            tabName = tabRec and tabRec.Name or "",
            block = blockFrame,
            blockName = blockName or "",
            flag = (kind ~= "Label" and kind ~= "Button") and (cfg.Flag or cfg.Name) or nil,
            tip = cfg.Tooltip or cfg.Description or "",
            keywords = kw or "",
            meta = extra or {},
            uses = 0,
            lastUsed = 0,
            order = #allSearchableElements + 1
        })
    end

    local function Prep(e)
        if e.prepped then return end
        e.prepped = true
        e.nName = Norm(e.name)
        e.nTab = Norm(e.tabName)
        e.nBlock = Norm(e.blockName)
        e.nTip = Norm(e.tip)
        e.nKeys = Norm(e.keywords)
        e.nKind = Norm(e.kind .. " " .. (KIND_ALIASES[e.kind] or ""))
        e.words = {}
        for w in e.nName:gmatch("%w+") do table.insert(e.words, w) end
    end

    local function TokenScore(e, t, strict)
        local best = 0
        local n = e.nName
        if n == t then
            best = 100
        elseif n:sub(1, #t) == t then
            best = 82
        else
            for _, w in ipairs(e.words) do
                if w:sub(1, #t) == t then best = 66 break end
            end
            if best == 0 and n:find(t, 1, true) then best = 48 end
        end
        if best == 0 and not strict and #t >= 2 then
            local ok, gaps = Subseq(t, n)
            local tol = (#t >= 4) and (#t * 2 + 2) or #t
            if ok and gaps <= tol then best = math.max(8, 26 - gaps) end
        end
        if best == 0 and not strict and #t >= 4 then
            local maxd = (#t >= 7) and 2 or 1
            for _, w in ipairs(e.words) do
                if #w >= 3 and Lev(t, w, maxd) <= maxd then best = 30 break end
            end
        end
        if best < 36 then
            if e.nKeys ~= "" and e.nKeys:find(t, 1, true) then best = math.max(best, 36) end
            if e.nTab:find(t, 1, true) or e.nBlock:find(t, 1, true) then best = math.max(best, 26) end
            if e.nKind:find(t, 1, true) then best = math.max(best, 20) end
            if e.nTip ~= "" and e.nTip:find(t, 1, true) then best = math.max(best, 14) end
        end
        return best > 0 and best or nil
    end

    local function Expand(t)
        local list = {}
        local syn = Library.Synonyms[t]
        if syn then
            for _, s in ipairs(syn) do table.insert(list, Norm(s)) end
        end
        return list
    end

    local function DidYouMean(q)
        local best, bd
        local lim = math.max(2, math.floor(#q / 3))
        for _, e in ipairs(allSearchableElements) do
            if e.element and e.element.Parent and e.kind ~= "Label" then
                Prep(e)
                local d = Lev(q, e.nName, lim)
                for _, w in ipairs(e.words) do
                    d = math.min(d, Lev(q, w, lim))
                end
                if d <= lim and (not bd or d < bd) then best, bd = e.name, d end
            end
        end
        return best
    end

    local Filter = 1

    -- Retourne : liste {e, score}, tokens, titre, suggestion
    local function Compute(raw)
        local q = Norm(raw):gsub("^%s+", ""):gsub("%s+$", "")
        local tokens, tabToks = {}, {}
        for tok in q:gmatch("%S+") do
            if tok:sub(1, 1) == "@" then
                if #tok > 1 then table.insert(tabToks, tok:sub(2)) end
            else
                table.insert(tokens, tok)
            end
        end

        local fset = FILTERS[Filter].Kinds
        local out = {}

        local function valid(e)
            if not (e.element and e.element.Parent) then return false end
            if e.tab and e.tab.Internal and Config.SearchSettings == false then return false end
            if fset and not fset[e.kind] then return false end
            return true
        end

        -- Barre vide : récents puis suggestions
        if #tokens == 0 and #tabToks == 0 then
            local recents = {}
            for _, e in ipairs(allSearchableElements) do
                if e.uses > 0 and valid(e) then table.insert(recents, e) end
            end
            table.sort(recents, function(a, b) return a.lastUsed > b.lastUsed end)
            local seen = {}
            for i = 1, math.min(#recents, 6) do
                seen[recents[i]] = true
                table.insert(out, {e = recents[i], score = 0})
            end
            local nbRecent = #out
            for _, e in ipairs(allSearchableElements) do
                if #out >= 8 then break end
                if not seen[e] and valid(e) and e.kind ~= "Label" and (not (e.tab and e.tab.Internal)) then
                    table.insert(out, {e = e, score = 0})
                end
            end
            return out, tokens, nbRecent > 0 and "Récents" or "Suggestions", nil
        end

        for _, e in ipairs(allSearchableElements) do
            if valid(e) then
                Prep(e)
                local ok = true
                for _, tt in ipairs(tabToks) do
                    if not e.nTab:find(tt, 1, true) then ok = false break end
                end
                if ok then
                    local total = 0
                    for _, t in ipairs(tokens) do
                        local s = TokenScore(e, t)
                        if not s then
                            local best
                            for _, alt in ipairs(Expand(t)) do
                                local s2 = TokenScore(e, alt, true)
                                if s2 then
                                    s2 = s2 * 0.8
                                    if not best or s2 > best then best = s2 end
                                end
                            end
                            s = best
                        end
                        if not s then ok = false break end
                        total = total + s
                    end
                    if ok then
                        if #tokens == 0 then total = 1 end
                        if e.kind == "Label" then total = total * 0.6 end
                        if e.tab and e.tab.Internal then total = total - 2 end
                        if ActiveTab and e.tab and ActiveTab.Btn == e.tab.Btn then total = total + 4 end
                        total = total + math.min(e.uses, 5) * 2
                        table.insert(out, {e = e, score = total})
                    end
                end
            end
        end

        table.sort(out, function(a, b)
            if a.score ~= b.score then return a.score > b.score end
            return a.e.order < b.e.order
        end)
        while #out > MAX_RESULTS do table.remove(out) end

        local dym
        if #out == 0 and #tokens > 0 then dym = DidYouMean(table.concat(tokens, " ")) end
        return out, tokens, nil, dym
    end

    -- Surligne les lettres trouvées dans le nom (RichText)
    local function Highlight(name, tokens)
        local n = Norm(name)
        if #tokens == 0 or #n ~= #name then return Esc(name) end
        local mark = {}
        for _, t in ipairs(tokens) do
            local s, f = n:find(t, 1, true)
            if s then
                for i = s, f do mark[i] = true end
            elseif #t >= 2 then
                local tmp, qi = {}, 1
                for i = 1, #n do
                    if qi <= #t and n:byte(i) == t:byte(qi) and n:byte(i) < 128 then
                        tmp[#tmp + 1] = i
                        qi += 1
                    end
                end
                if qi > #t then
                    for _, i in ipairs(tmp) do mark[i] = true end
                end
            end
        end
        local hex = SelectedTheme.ElementAccent:ToHex()
        local out, i = {}, 1
        while i <= #name do
            local j = i
            local m = mark[i] == true
            while j + 1 <= #name and (mark[j + 1] == true) == m do j += 1 end
            local piece = Esc(name:sub(i, j))
            out[#out + 1] = m and ('<font color="#' .. hex .. '"><b>' .. piece .. '</b></font>') or piece
            i = j + 1
        end
        return table.concat(out)
    end

