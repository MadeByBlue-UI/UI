        local currentToggle = Library.ToggleKey
        if Library.Flags["Settings_ToggleKey"] then
            local s, k = pcall(function() return Enum.KeyCode[Library.Flags["Settings_ToggleKey"]] end)
            if s and k then
                currentToggle = k
