                -- keepHSV = true : on garde la teinte / saturation courantes
                -- (sinon, un gris ou un noir ferait retomber la teinte à 0 et le sélecteur sautait)
                local function Update(col, keepHSV)
                    Color = col
                    if not keepHSV then
                        h, s, v = Color:ToHSV()
