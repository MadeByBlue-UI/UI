                    GInput.Text = tostring(R255(Color.G))
                    BInput.Text = tostring(R255(Color.B))
                    HexInput.Text = "#" .. Color:ToHex()
                    Library.Flags[Flag] = {R = Color.R, G = Color.G, B = Color.B}
                    if Cfg.Callback then
                        Cfg.Callback(Color)
                    end
