-- 🎨 Sérialisation des thèmes (fichiers + export/import)
local THEME_COLOR_KEYS = {"Main", "Second", "Accent", "ElementAccent", "Text", "TextDark", "Error", "GradientStart", "GradientEnd"}

local function SerializeTheme(t, extra)
    local out = {_type = "theme"}
    for _, k in ipairs(THEME_COLOR_KEYS) do
        local c = t[k] or t.Accent
        out[k] = {R = c.R, G = c.G, B = c.B}
    end
    out.Background = t.Background or ""
    for k, v in pairs(extra or {}) do
        out[k] = v
    end
    return out
end

local function RestoreTheme(parsed)
    local restored = {}
    for k, v in pairs(parsed) do
        if type(v) == "table" and v.R then
            restored[k] = Color3.new(v.R, v.G, v.B)
        else
            restored[k] = v
        end
    end
    local base = BaseThemes.Default
    for _, k in ipairs({"Main", "Second", "Accent", "Text", "TextDark", "Error"}) do
        if typeof(restored[k]) ~= "Color3" then restored[k] = base[k] end
    end
    if typeof(restored.ElementAccent) ~= "Color3" then restored.ElementAccent = restored.Accent end
    if typeof(restored.GradientStart) ~= "Color3" then restored.GradientStart = restored.Accent end
    if typeof(restored.GradientEnd) ~= "Color3" then restored.GradientEnd = restored.Accent end
    restored.Gradient = GetGradientSeq(restored)
    if type(restored.Font) ~= "string" then restored.Font = "Gotham" end
    if type(restored.Transparency) ~= "number" then restored.Transparency = 0.25 end
    if type(restored.ImageTransparency) ~= "number" then restored.ImageTransparency = 0 end
    if type(restored.OrbsTransparency) ~= "number" then restored.OrbsTransparency = 0.9 end
    if type(restored.Background) ~= "string" then restored.Background = "" end
    if type(restored.CornerRadius) ~= "number" then restored.CornerRadius = Library.GlobalCornerValue end
    return restored
end

local function GetTheme(cfg)
    if type(cfg) == "table" then
        local mapped = {}
        mapped.Main = cfg["Main color"] or cfg.Main
        mapped.Second = cfg["SecondColor"] or cfg.Second
        mapped.Accent = cfg["AccentColor"] or cfg.Accent
        mapped.ElementAccent = cfg["ElementColor"] or cfg.ElementAccent
        mapped.Text = cfg["TextColor"] or cfg.Text
        mapped.GradientStart = cfg["GradientStart"] or mapped.Accent
        mapped.GradientEnd = cfg["GradientEnd"] or mapped.Accent

        if cfg["BGTransparency"] then
            mapped.Transparency = tonumber(cfg["BGTransparency"]) / 100
        else
            mapped.Transparency = cfg.Transparency
        end

        if cfg["ImageTransparency"] then
            mapped.ImageTransparency = tonumber(cfg["ImageTransparency"]) / 100
        else
            mapped.ImageTransparency = cfg.ImageTransparency
        end

        if cfg["OrbsTransparency"] then
            mapped.OrbsTransparency = tonumber(cfg["OrbsTransparency"]) / 100
        else
            mapped.OrbsTransparency = cfg.OrbsTransparency
        end

        if cfg["BackgroundID"] then
            mapped.Background = GetAssetId(cfg["BackgroundID"])
        else
            mapped.Background = GetAssetId(cfg.Background)
        end

        if cfg["Font"] then
            mapped.Font = cfg["Font"]
        end

        if cfg["CornerRadius"] ~= nil then
            mapped.CornerRadius = cfg["CornerRadius"]
        end

        local base = BaseThemes.Default
        if not mapped.Main then mapped.Main = base.Main end
        if not mapped.Second then mapped.Second = base.Second end
        if not mapped.Accent then mapped.Accent = base.Accent end
        if not mapped.ElementAccent then mapped.ElementAccent = mapped.Accent end
        if not mapped.Text then mapped.Text = base.Text end
        if not mapped.TextDark then mapped.TextDark = Color3.fromRGB(170, 170, 170) end
        if not mapped.Error then mapped.Error = Color3.fromRGB(255, 60, 60) end
        if not mapped.GradientStart then mapped.GradientStart = mapped.Accent end
        if not mapped.GradientEnd then mapped.GradientEnd = mapped.Accent end

        mapped.Gradient = GetGradientSeq(mapped)
        return mapped
    end

    local okFile, exists = pcall(function()
        return isfile(Library.ThemeFolder .. "/" .. tostring(cfg) .. ".json")
    end)
    if okFile and exists then
        local content = readfile(Library.ThemeFolder .. "/" .. tostring(cfg) .. ".json")
        local parsed = HS:JSONDecode(content)
        return RestoreTheme(parsed)
    end
    -- Toujours une copie : SelectedTheme est modifié en direct par les color pickers
    return Clone(BaseThemes[cfg] or BaseThemes.Default)
end

local function Create(class, properties)
    local tag = properties.ThemeTag
    properties.ThemeTag = nil
    local instance = Instance.new(class)
    for k, v in pairs(properties) do
        instance[k] = v
    end
    if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
        table.insert(Library.TextObjects, instance)
        if not properties.Font then
            instance.Font = Library.GlobalFont
        end
    end
    if tag and Library.ThemeObjects[tag] then
        table.insert(Library.ThemeObjects[tag], instance)
    end
    return instance
end

local function UpdateFonts(FontName)
    local okFont, found = pcall(function() return Enum.Font[FontName] end)
    local NewFont = (okFont and found) or Enum.Font.Gotham
    Library.GlobalFont = NewFont
    local okBold, foundBold = pcall(function() return Enum.Font[FontName .. "Bold"] end)
    if okBold and foundBold then
        Library.GlobalFontBold = foundBold
    else
        Library.GlobalFontBold = NewFont
    end

    for _, obj in pairs(Library.TextObjects) do
        if obj and obj.Parent then
            local s = tostring(obj.Font)
            if s:find("Bold") then
                obj.Font = Library.GlobalFontBold
            else
                obj.Font = Library.GlobalFont
            end
        end
    end
end

-- Parcourt une liste d'objets thémés : chaque objet est protégé par pcall,
-- une erreur sur un seul objet n'empêche plus les autres d'être mis à jour
local function Each(list, fn, getInst)
    for i = #list, 1, -1 do
        local obj = list[i]
        local inst = obj
        if getInst then inst = obj and getInst(obj) end
        if inst and inst.Parent then
            pcall(fn, obj)
        else
            table.remove(list, i)
        end
    end
end

local function UpdateThemeObjects()
    local T = Themes.Default
    local O = Library.ThemeObjects

    Each(O.Main, function(obj) obj.BackgroundColor3 = T.Main end)
    Each(O.Second, function(obj) obj.BackgroundColor3 = T.Second end)

    Each(O.Accent, function(obj)
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            obj.ImageColor3 = T.Accent
        elseif obj:IsA("UIStroke") then
            obj.Color = T.Accent
        elseif obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then
            obj.TextColor3 = T.Accent
        else
            obj.BackgroundColor3 = T.Accent
        end
    end)

    Each(O.ElementAccent, function(obj)
        if obj:IsA("ImageLabel") then
            obj.ImageColor3 = T.ElementAccent
        elseif obj:IsA("UIStroke") then
            obj.Color = T.ElementAccent
        else
            obj.BackgroundColor3 = T.ElementAccent
        end
    end)

    Each(O.Text, function(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then
            obj.TextColor3 = T.Text
        elseif obj:IsA("Frame") then
            obj.BackgroundColor3 = T.Text
        end
    end)

    Each(O.TextDark, function(obj)
        if obj:IsA("ImageLabel") then
            obj.ImageColor3 = T.TextDark
        elseif obj:IsA("Frame") then
            obj.BackgroundColor3 = T.TextDark
        elseif obj:IsA("UIStroke") then
            obj.Color = T.TextDark
        else
            obj.TextColor3 = T.TextDark
        end
    end)

    Each(O.Toggles, function(t)
        if t.State() then
            t.Stroke.Color = T.ElementAccent
            t.Stroke.Transparency = 0
            t.Square.BackgroundColor3 = T.ElementAccent
        else
            t.Stroke.Color = T.TextDark
            t.Stroke.Transparency = 0.8
            t.Square.BackgroundColor3 = T.TextDark
        end
    end, function(t) return t.Box end)

    Each(O.TabLabels, function(tab)
        local active = tab.Btn.BackgroundTransparency < 0.8
        tab.Label.TextColor3 = active and T.Text or T.TextDark
        if tab.Icon then
            tab.Icon.ImageColor3 = active and T.Accent or T.TextDark
        end
        if tab.Line then
            tab.Line.BackgroundColor3 = T.Accent
        end
    end, function(tab) return tab.Label end)

    Each(O.Keybinds, function(btn)
        if btn.Text == "..." then
            btn.TextColor3 = T.Accent
        else
            btn.TextColor3 = T.TextDark
        end
    end)

    -- Éléments qui se redessinent eux-mêmes (dropdowns, etc.)
    for i = #Library.ThemeRefreshers, 1, -1 do
        local ok, keep = pcall(Library.ThemeRefreshers[i])
        if ok and keep == false then
            table.remove(Library.ThemeRefreshers, i)
        end
    end
end

