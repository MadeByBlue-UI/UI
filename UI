local KeybindListeners = {}

local function KeybindsChanged()
    for i = #KeybindListeners, 1, -1 do
        local ok, keep = pcall(KeybindListeners[i])
        if ok and keep == false then
            table.remove(KeybindListeners, i)
        end
    end
end

-- Enregistre une connexion pour pouvoir la nettoyer dans Library:Destroy()
local function Bind(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Library.Connections, c)
    return c
end

-- Helper de tween (utilisé partout)
local function Tween(obj, time, props, style, dir)
    local t = TS:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

-- UIScale partagé (hover + animation d'entrée) : ne casse jamais les layouts
local function GetPopScale(obj)
    local s = obj:FindFirstChild("PopScale")
    if not s then
        s = Instance.new("UIScale")
        s.Name = "PopScale"
        s.Parent = obj
    end
    return s
end

-- Exécute un callback sans jamais casser l'UI : l'erreur est affichée en notif + console
local function SafeCall(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[UI Callback Error] " .. tostring(err))
        Library:Notify({Title = "Callback Error", Content = tostring(err), Type = "Error", Duration = 5})
    end
end

local function Clone(t)
    local c = {}
    for k, v in pairs(t) do c[k] = v end
    return c
end

-- 📋 Presse-papier (export / import)
local function CopyText(text)
    local fn = setclipboard or toclipboard or (syn and syn.write_clipboard) or (Clipboard and Clipboard.set)
    if not fn then return false end
    return (pcall(fn, text))
end

local function PasteText()
    local fn = getclipboard or fromclipboard
    if not fn then return nil end
    local ok, res = pcall(fn)
    if ok and type(res) == "string" then return res end
    return nil
end

