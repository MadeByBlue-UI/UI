    local function MarkUsed(e)
        e.uses += 1
        e.lastUsed = os.clock()
    end

    local function ScrollTo(i)
        local y = (i - 1) * (ROW_H + ROW_GAP)
        local top = List.CanvasPosition.Y
        local h = List.AbsoluteWindowSize.Y
        if y < top then
            Tween(List, 0.15, {CanvasPosition = Vector2.new(0, math.max(0, y - 4))})
        elseif y + ROW_H > top + h - 4 then
            Tween(List, 0.15, {CanvasPosition = Vector2.new(0, y + ROW_H - h + 8)})
        end
    end

    local function Select(i, fromKeyboard)
        if #Results == 0 then
            Selected = 0
            Selector.Visible = false
            return
        end
        i = math.clamp(i, 1, #Results)
        local first = (Selected == 0) or not Selector.Visible
        Selected = i
        Selector.Visible = true
        local pos = UDim2.new(0, 6, 0, (i - 1) * (ROW_H + ROW_GAP))
        if first then
            Selector.Position = pos
        else
            Tween(Selector, 0.18, {Position = pos}, Enum.EasingStyle.Quint)
        end
        if fromKeyboard then ScrollTo(i) end
    end

