        end
        local m = UIS:GetMouseLocation() - GuiService:GetGuiInset()
        local p, s = TipTarget.AbsolutePosition, TipTarget.AbsoluteSize
        if m.X < p.X or m.Y < p.Y or m.X > p.X + s.X or m.Y > p.Y + s.Y then
            HideTip()
            return
        end
        PositionTip()
    end)

    local function AttachTooltip(obj, text)
        if not obj or text == nil or text == "" then return end
        obj.MouseEnter:Connect(function()
            if not Library.TooltipsEnabled then return end
            TipToken = TipToken + 1
            local my = TipToken
            task.delay(0.45, function()
                if my ~= TipToken or not obj.Parent or not Library.UIOpen or not Library.TooltipsEnabled then return end
                TipTarget = obj
                TipLabel.Text = tostring(text)
                TipFrame.Visible = true
                PositionTip()
            end)
        end)
        obj.MouseLeave:Connect(function()
            TipToken = TipToken + 1
            if TipTarget == obj then HideTip() end
        end)
        obj.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and TipTarget == obj then
                HideTip()
            end
        end)
    end

    function Library:AddTooltip(obj, text)
        AttachTooltip(obj, text)
    end

