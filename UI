                    if not dragConnection then
                        dragConnection = RS.RenderStepped:Connect(function()
                            local m = UIS:GetMouseLocation() - GuiService:GetGuiInset()
                            if draggingSV then
                                VisualUpdate(nil,
                                    math.clamp((m.X - SVMap.AbsolutePosition.X) / SVMap.AbsoluteSize.X, 0, 1),
                                    1 - math.clamp((m.Y - SVMap.AbsolutePosition.Y) / SVMap.AbsoluteSize.Y, 0, 1))
                            elseif draggingHue then
                                VisualUpdate(math.clamp((m.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X, 0, 1), nil, nil)
                            end
                        end)
                        table.insert(Library.Connections, dragConnection)
                    end
                end

