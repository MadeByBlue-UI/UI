    local function InRect(obj, m)
        local p, s = obj.AbsolutePosition, obj.AbsoluteSize
        return m.X >= p.X and m.Y >= p.Y and m.X <= p.X + s.X and m.Y <= p.Y + s.Y
    end

    local function OverSearch()
        local m = UIS:GetMouseLocation() - GuiService:GetGuiInset()
        if InRect(SearchContainer, m) then return true end
        return PanelOpen and Panel.Visible and InRect(Panel, m)
    end

    local function UpdateBarVisuals()
        local has = SearchBox.Text ~= ""
        ClearBtn.Visible = has
        Badge.Visible = (not IsMobile) and (not has) and (not SearchBox:IsFocused())
    end

