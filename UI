                AddStroke(Frame, SelectedTheme).Transparency = 0.8

                Create("TextLabel", {
                    Parent = Frame,
                    Size = UDim2.new(1, -85, 0, 24),
                    Position = UDim2.new(0, 12, 0, 2),
                    BackgroundTransparency = 1,
                    Text = Cfg.Name,
                    Font = Library.GlobalFont,
                    TextColor3 = SelectedTheme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ThemeTag = "Text"
                })

                local ValBg = Create("ScrollingFrame", {
                    Parent = Frame,
                    Size = UDim2.new(0, 52, 0, 20),
                    Position = UDim2.new(1, -64, 0, 4),
                    BackgroundColor3 = Color3.new(0, 0, 0),
                    BackgroundTransparency = 0.85,
                    ZIndex = 8,
                    ClipsDescendants = true,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    ScrollBarThickness = 0,
                    ScrollingDirection = Enum.ScrollingDirection.X,
                    AutomaticCanvasSize = Enum.AutomaticSize.X
                })
                AddCorner(ValBg, 4)
                Create("UIPadding", { Parent = ValBg, PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) })

                local ValLbl = Create("TextBox", {
                    Parent = ValBg,
                    Size = UDim2.new(1, 0, 1, 0),
                    AutomaticSize = Enum.AutomaticSize.X,
                    BackgroundTransparency = 1,
                    Text = Format(Val),
                    Font = Library.GlobalFontBold,
                    TextColor3 = SelectedTheme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 9,
                    ThemeTag = "Text",
                    TextWrapped = false,
                    ClearTextOnFocus = false
                })
                AttachHorizontalScroll(ValLbl, ValBg, Enum.TextXAlignment.Center)

                local SlideBar = Create("TextButton", {
                    Parent = Frame,
                    Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.new(0, 12, 0, 28),
                    BackgroundColor3 = Color3.fromRGB(40, 40, 45),
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 8
                })
                AddCorner(SlideBar, 10)

                SlideBar.MouseEnter:Connect(function()
                    PlaySound("Hover")
                end)

                local Fill = Create("Frame", {
                    Parent = SlideBar,
                    Size = UDim2.new((Val - Min) / range, 0, 1, 0),
                    BackgroundColor3 = SelectedTheme.ElementAccent,
                    BorderSizePixel = 0,
                    ZIndex = 9,
                    ThemeTag = "ElementAccent"
                })
                AddCorner(Fill, 10)

                local Thumb = Create("Frame", {
                    Parent = Fill,
                    Size = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new(1, -7, 0.5, -7),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    ZIndex = 10
                })
                AddCorner(Thumb, 10)

                -- force = true : déclenche le callback même si la valeur n'a pas changé
                local function Update(v, force)
                    v = Snap(v)
                    local changed = v ~= Val
                    Val = v
                    Library.Flags[Flag] = Val
                    ValLbl.Text = Format(Val)
                    TS:Create(Fill, TweenInfo.new(0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new((Val - Min) / range, 0, 1, 0)}):Play()
                    if (changed or force) and Cfg.Callback then
                        Cfg.Callback(Val)
                    end
                end

                if Cfg.Default ~= nil then
                    Update(Val, true)
                elseif Cfg.Callback then
                    task.spawn(Cfg.Callback, Val)
                end

                local Dragging = false

                local function DragUpdate(input)
                    local p = math.clamp((input.Position.X - SlideBar.AbsolutePosition.X) / SlideBar.AbsoluteSize.X, 0, 1)
                    Update(Min + (Max - Min) * p)
                end

                SlideBar.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        Dragging = true
                        DragUpdate(i)
                        TS:Create(Thumb, TweenInfo.new(0.2), {Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(1, -9, 0.5, -9)}):Play()
                    end
                end)

                Bind(UIS.InputEnded, function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        if Dragging then
                            Dragging = false
                            TS:Create(Thumb, TweenInfo.new(0.2), {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(1, -7, 0.5, -7)}):Play()
                        end
                    end
                end)

                Bind(UIS.InputChanged, function(i)
                    if Dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                        DragUpdate(i)
                    end
                end)

                -- Saisie manuelle : accepte "0.75", "75%", "1,5x"... (virgule tolérée)
                ValLbl.FocusLost:Connect(function()
                    local number = tonumber((ValLbl.Text:gsub(",", "."):match("-?%d+%.?%d*")))
                    if number then
                        Update(number)
                    end
                    ValLbl.Text = Format(Val)
                end)

                local Object = {
                    Set = function(v)
                        if type(v) == "number" then Update(v) end
                    end,
                    Get = function() return Val end
                }
                Library.Items[Flag] = Object

                Tip(Frame, Cfg)
                Index(Frame, Cfg.Name or "Slider", "Slider", Cfg, {Min = Min, Max = Max, Decimals = Decimals, Suffix = Suffix})

                return Object
            end

