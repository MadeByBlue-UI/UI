        sw.MouseButton1Click:Connect(function()
            local item = Library.Items[e.flag]
            if item then
                PlaySound("Toggle")
                MarkUsed(e)
                item.Set(not (Library.Flags[e.flag] == true))
                refresh(true)
            end
        end)
        refresh(false)
        return refresh
    end

