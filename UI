local POOL_SIZE = 4

Library.SoundsEnabled = true

local function PlaySound(soundName)
    if not Library.SoundsEnabled then return end
    local data = Sounds[soundName]
    if not data then return end

    local now = os.clock()
    if now - (data.Last or 0) < (data.Cooldown or 0.03) then return end
    data.Last = now

    data.Pool = data.Pool or {}
    local idx = ((data.Next or 0) % POOL_SIZE) + 1
    data.Next = idx

    local sound = data.Pool[idx]
    if not sound or not sound.Parent then
        sound = Instance.new("Sound")
        sound.SoundId = data.Id
        sound.Volume = data.Volume
        sound.PlaybackSpeed = data.Pitch
        sound.Parent = SoundService
        data.Pool[idx] = sound
    end
    sound.TimePosition = 0
    sound:Play()
end

