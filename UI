                    local txt = HexInput.Text:gsub("%s", "")
                    local success, c = pcall(function() return Color3.fromHex(txt) end)
                    if success and typeof(c) == "Color3" then
                        Update(c)
                    else
                        HexInput.Text = "#" .. Color:ToHex()
                    end
                end)

