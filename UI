        ZIndex = 25000,
        ThemeTag = "Second"
    })
    Create("UICorner", {Parent = TipFrame, CornerRadius = UDim.new(0, 6)})
    do
        local s = Create("UIStroke", {Parent = TipFrame, Color = SelectedTheme.TextDark, Transparency = 0.6, Thickness = 1})
        table.insert(Library.ThemeObjects.TextDark, s)
    end
    Create("UIPadding", {
        Parent = TipFrame,
        PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9),
        PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6)
    })
    local TipLabel = Create("TextLabel", {
        Parent = TipFrame,
        Size = UDim2.fromOffset(0, 0),
        AutomaticSize = Enum.AutomaticSize.XY,
        BackgroundTransparency = 1,
        Text = "",
        TextWrapped = true,
        TextSize = 12,
        TextColor3 = SelectedTheme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 25001,
        ThemeTag = "Text"
    })
    Create("UISizeConstraint", {Parent = TipLabel, MaxSize = Vector2.new(240, 1000)})

    local TipTarget, TipToken = nil, 0

    local function HideTip()
        TipTarget = nil
        TipToken = TipToken + 1
        TipFrame.Visible = false
    end

    local function PositionTip()
        local m = UIS:GetMouseLocation() - GuiService:GetGuiInset()
        local screen = ScreenGui.AbsoluteSize
        local sz = TipFrame.AbsoluteSize
        local x, y = m.X + 16, m.Y + 18
        if x + sz.X > screen.X - 6 then x = m.X - sz.X - 10 end
        if y + sz.Y > screen.Y - 6 then y = m.Y - sz.Y - 10 end
