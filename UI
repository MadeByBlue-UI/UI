            local on = Library.Flags[e.flag] == true
            if on == last then return end
            last = on
            local p1 = {
                BackgroundColor3 = on and SelectedTheme.ElementAccent or SelectedTheme.TextDark,
                BackgroundTransparency = on and 0.05 or 0.55
