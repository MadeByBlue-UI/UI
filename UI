    local function ValueText(v)
        if type(v) == "table" then
            if v.R then return "" end
            local t = {}
            for _, x in ipairs(v) do t[#t + 1] = tostring(x) end
            return #t > 0 and table.concat(t, ", ") or "—"
        end
        if v == nil or v == "" then return "—" end
        return tostring(v)
    end

    local function MakePill(ctrl, e, getText, onClick)
        local pill = N("TextButton", {
            Parent = ctrl, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 0.8, Text = "", AutoButtonColor = false, ZIndex = 25006
        })
        Round(pill, 7)
        N("UIStroke", {Parent = pill, Color = SelectedTheme.TextDark, Transparency = 0.8, Thickness = 1})
        local lbl = N("TextLabel", {
            Parent = pill, Size = UDim2.new(1, -12, 1, 0), Position = UDim2.new(0, 6, 0, 0), BackgroundTransparency = 1,
            Text = "", TextSize = 12, Font = Library.GlobalFontBold, TextColor3 = SelectedTheme.Text,
            TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 25007
        })
        local last
        local function refresh()
            local t = getText()
            if t ~= last then
