-- ⌨️ Liste triée de tous les keybinds connus (fixes + enregistrés)
function Library:GetKeybindEntries()
    local list = {}
    for _, e in ipairs(Library.StaticKeybinds) do
        table.insert(list, {Name = e.Name, Key = e.Key, Static = true})
    end
    for flag, e in pairs(Library.KeybindRegistry) do
        table.insert(list, {Name = e.Name, Key = KeyMap[e.Key] or e.Key, Raw = e.Key, Flag = flag})
    end
    table.sort(list, function(a, b)
        if (a.Static or false) ~= (b.Static or false) then
            return a.Static == true
        end
        return tostring(a.Name):lower() < tostring(b.Name):lower()
    end)
    return list
end

local function KeybindConflicts(entries)
    local count, conflicts = {}, {}
    for _, e in ipairs(entries) do
        if e.Raw then count[e.Raw] = (count[e.Raw] or 0) + 1 end
    end
    for k, n in pairs(count) do
        if n > 1 then conflicts[k] = true end
    end
    return conflicts
end

-- Nettoyage complet : connexions, sons, GUI, tables internes
function Library:Destroy()
    for _, c in ipairs(Library.Connections) do
        pcall(function() c:Disconnect() end)
    end
    Library.Connections = {}

    for _, data in pairs(Sounds) do
        if data.Pool then
            for _, s in pairs(data.Pool) do
                pcall(function() s:Destroy() end)
            end
            data.Pool = nil
        end
    end

    if Library.CurrentGui then
        pcall(function() Library.CurrentGui:Destroy() end)
        Library.CurrentGui = nil
    end

    if Library.SearchBlurObj then
        pcall(function() Library.SearchBlurObj:Destroy() end)
        Library.SearchBlurObj = nil
    end

    Library.Flags = {}
    Library.Items = {}
    Library.TextObjects = {}
    Library.GradientObjects = {}
    Library.CornerObjects = {}
    Library.ThemeRefreshers = {}
    Library.KeybindRegistry = {}
    KeybindListeners = {}
    for k in pairs(Library.ThemeObjects) do
        Library.ThemeObjects[k] = {}
    end
    Library.UIOpen = true
    function Library:Notify() end
    function Library:AddTooltip() end
end

