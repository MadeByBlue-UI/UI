                    leaveTween = TS:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.5})
                    leaveTween:Play()
                    Tween(pop, 0.2, {Scale = 1})
                end)
                btn.MouseButton1Down:Connect(function()
                    Tween(pop, 0.08, {Scale = 0.97})
