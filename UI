        local txt = texts[math.clamp(math.floor(a * #texts) + 1, 1, #texts)]
        if Status.Text ~= txt then Status.Text = txt end
        if a >= 1 then break end
        RS.RenderStepped:Wait()
    end

    -- Sortie : petit "pop" puis fondu
