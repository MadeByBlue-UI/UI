        Callback = function(val)
            Library:SetTooltipsEnabled(val)
        end
    })

    UIBlock:CreateToggle({
        Name = "🔊 Enable UI Sounds",
        Flag = "Settings_SoundsEnabled",
        Default = true,
        Tooltip = "Click, hover and notification sounds",
        Callback = function(val)
            Library.SoundsEnabled = val
        end
    })

    UIBlock:CreateToggle({
        Name = "⌨ Keybind List (HUD)",
        Flag = "Settings_KeybindHud",
        Default = false,
        Tooltip = "Floating draggable list of all your keybinds",
        Callback = function(val)
            Library:SetKeybindHud(val)
        end
    })

    UIBlock:CreateButton({
        Name = "Reset UI Position / Size",
        Tooltip = "Restore the default position and size of the panels",
        Callback = function()
            ResetLayout()
            Library:Notify({Title = "Layout Reset", Content = "Position and size restored", Type = "Success"})
        end
    })

    local KeyBlock = SettingsTab:CreateBlock({Name = "Keybinds", Side = "Left"})

    KeyBlock:CreateKeybind({
        Name = "Toggle UI",
        Flag = "Settings_ToggleKey",
        Default = Library.ToggleKey,
        Tooltip = "Show / hide the whole interface",
        Callback = function() end
    })

    KeyBlock:CreateLabel({Text = "All keybinds. Click a key then press a new one (Esc = cancel). Red = conflict."})
    KeyBlock:CreateKeybindList({})

    local ConfigBlock = SettingsTab:CreateBlock({Name = "Config Manager", Side = "Left"})

    local ConfigNameInput = "MyConfig"
    local ImportConfigBuffer = ""
    local LoadDropCfg

    ConfigBlock:CreateInput({
        Name = "Config Name",
        Flag = "Settings_CfgName",
        Default = "MyConfig",
        Callback = function(v)
            ConfigNameInput = v
        end
    })

    ConfigBlock:CreateButton({
        Name = "Save Config",
        Tooltip = "Save every option to a file with this name",
        Callback = function()
            Library:SaveConfig(ConfigNameInput)
            if LoadDropCfg then LoadDropCfg:Refresh(Library:GetConfigs()) end
        end
    })

    LoadDropCfg = ConfigBlock:CreateDropdown({
        Name = "Load Config",
        Flag = "Settings_CfgLoad",
        Items = Library:GetConfigs(),
        Tooltip = "Pick a saved config to load it",
        UpdateList = function()
            return Library:GetConfigs()
        end,
        Callback = function(val)
            Library:LoadConfig(val)
            if Library.Flags["Settings_AutoLoadToggle"] then
                writefile(AutoloadPath, val)
            end
        end
    })

    ConfigBlock:CreateButton({
        Name = "Delete Selected Config",
        Callback = function()
            local sel = LoadDropCfg:Get()
            if sel and isfile(Library.ConfigFolder .. "/" .. sel .. ".json") then
                Library:DeleteConfig(sel)
                LoadDropCfg:Refresh(Library:GetConfigs())
            end
        end
    })

    ConfigBlock:CreateToggle({
        Name = "Auto Load Selected Config",
        Flag = "Settings_AutoLoadToggle",
        Default = true,
        Tooltip = "Load the selected config automatically at startup",
        Callback = function(val)
            if val then
                local sel = LoadDropCfg and LoadDropCfg:Get()
                if sel then
                    writefile(AutoloadPath, sel)
                end
            else
                if isfile(AutoloadPath) then
                    delfile(AutoloadPath)
                end
            end
        end
    })

    ConfigBlock:CreateSection("Share")

    ConfigBlock:CreateButton({
        Name = "📤 Export Config (Copy)",
        Tooltip = "Copy all your options as text to share them",
        Callback = function()
            Library:ExportConfig()
        end
    })

    ConfigBlock:CreateInput({
        Name = "Import Data",
        Flag = "Settings_ImportConfigData",
        Placeholder = "Paste config...",
        Tooltip = "Paste an exported config here (or leave empty to use the clipboard)",
        Callback = function(v)
            ImportConfigBuffer = v or ""
        end
    })

    ConfigBlock:CreateButton({
        Name = "📥 Import Config",
        Tooltip = "Apply the pasted config, saved under the config name above",
        Callback = function()
            local str = (ImportConfigBuffer ~= "" and ImportConfigBuffer) or PasteText()
            if not str or str == "" then
                Library:Notify({Title = "Import Error", Content = "Paste a config first (or copy one to the clipboard)", Type = "Error"})
                return
            end
            if Library:ImportConfig(str, ConfigNameInput) and LoadDropCfg then
                LoadDropCfg:Refresh(Library:GetConfigs())
            end
        end
    })

    local HelpBlock = SettingsTab:CreateBlock({Name = "Aide", Side = "Left"})

    HelpBlock:CreateParagraph({
        Title = "Recherche rapide",
        Content = "Ctrl + F ouvre la recherche : tape un mot (accents et petites fautes tolérés). @onglet cible un onglet, Tab change de filtre, Entrée utilise l'option, Maj + Entrée y va directement.",
        Keywords = {"aide", "help", "raccourci", "recherche", "search"}
    })

    -- Colonne droite : couleurs / thèmes
    local ColorBlock = SettingsTab:CreateBlock({Name = "Theme Colors", Side = "Right"})

    -- Un seul helper pour tous les color pickers du thème
    local function ThemeColor(name, flag, key, tip)
        ColorBlock:CreateColorPicker({
            Name = name,
            Flag = flag,
            Default = SelectedTheme[key] or SelectedTheme.Accent,
            Tooltip = tip,
            Callback = function(c)
                SelectedTheme[key] = c
                Themes.Default[key] = c
                if key == "GradientStart" or key == "GradientEnd" then
                    SelectedTheme.Gradient = GetGradientSeq(SelectedTheme)
                    Themes.Default.Gradient = SelectedTheme.Gradient
                    if not ApplyingTheme then UpdateGradients(SelectedTheme.Gradient) end
                elseif not ApplyingTheme then
                    UpdateThemeObjects()
                end
            end
        })
    end

    ThemeColor("Main Color", "Settings_MainColor", "Main", "Window background color")
    ThemeColor("Second Color", "Settings_SecondColor", "Second", "Color of cards and elements")
    ThemeColor("Accent Color", "Settings_AccentColor", "Accent", "Tab indicator, search bar, arrows")
    ThemeColor("Element Color", "Settings_ElementColor", "ElementAccent", "Sliders, toggles, focus highlights")
    ThemeColor("Text Color", "Settings_TextColor", "Text", "Main text color")
    ThemeColor("Dim Text Color", "Settings_TextDarkColor", "TextDark", "Secondary / inactive text color")
    ThemeColor("Gradient Start", "Settings_GradStart", "GradientStart", "First color of the animated borders")
    ThemeColor("Gradient End", "Settings_GradEnd", "GradientEnd", "Second color of the animated borders")

    local ThemeBlock = SettingsTab:CreateBlock({Name = "Theme Manager", Side = "Right"})

    local PresetNames = {}
    for name in pairs(BaseThemes) do table.insert(PresetNames, name) end
    table.sort(PresetNames)

    ThemeBlock:CreateDropdown({
        Name = "Theme Preset",
        Flag = "Settings_ThemePreset",
        Items = PresetNames,
        Tooltip = "Built-in themes (Blood, Ocean, Vaporwave...)",
        Callback = function(val)
            if BaseThemes[val] then
                ApplyTheme(Clone(BaseThemes[val]))
            end
        end
    })

    ThemeBlock:CreateButton({
        Name = "Reset Theme",
        Tooltip = "Go back to the theme the UI started with",
        Callback = function()
            ApplyTheme(Clone(InitialTheme))
        end
    })

    ThemeBlock:CreateSection("My themes")

    local ThemeNameInput = "MyTheme"
    local ImportThemeBuffer = ""
    local LoadDrop

    ThemeBlock:CreateInput({
        Name = "Theme Name",
        Flag = "Settings_ThemeName",
        Default = "MyTheme",
        Callback = function(v)
            ThemeNameInput = v
        end
    })

    ThemeBlock:CreateButton({
        Name = "Save Theme",
        Tooltip = "Save the current colors, fonts and transparencies",
        Callback = function()
            writefile(Library.ThemeFolder .. "/" .. ThemeNameInput .. ".json", HS:JSONEncode(ThemeSnapshot()))
            Library:Notify({Title = "Theme Saved", Content = "Saved as " .. ThemeNameInput, Type = "Success"})
            if LoadDrop then LoadDrop:Refresh(Library:GetThemes()) end
        end
    })

    LoadDrop = ThemeBlock:CreateDropdown({
        Name = "Load Theme",
        Flag = "Settings_ThemeLoad",
        Items = Library:GetThemes(),
        Tooltip = "Pick one of your saved themes",
        UpdateList = function()
            return Library:GetThemes()
        end,
        Callback = function(val)
            ApplyTheme(GetTheme(val))
        end
    })

    ThemeBlock:CreateButton({
        Name = "Delete Selected Theme",
        Callback = function()
            local selected = LoadDrop:Get()
            if selected and isfile(Library.ThemeFolder .. "/" .. selected .. ".json") then
                delfile(Library.ThemeFolder .. "/" .. selected .. ".json")
                Library:Notify({Title = "Theme Deleted", Content = "Deleted " .. selected})
                LoadDrop:Refresh(Library:GetThemes())
            else
                Library:Notify({Title = "Error", Content = "Select a valid theme first", Type = "Error"})
            end
        end
    })

    ThemeBlock:CreateSection("Share")

    ThemeBlock:CreateButton({
        Name = "📤 Export Theme (Copy)",
        Tooltip = "Copy the current theme as text to share it",
        Callback = function()
            local str = HS:JSONEncode(ThemeSnapshot())
            if CopyText(str) then
                Library:Notify({Title = "Theme Exported", Content = "Copied to clipboard", Type = "Success"})
            else
                warn("[Export] Clipboard unavailable. Theme string:\n" .. str)
                Library:Notify({Title = "Export", Content = "Clipboard unavailable, string printed in console (F9)", Type = "Warning", Duration = 5})
            end
        end
    })

    ThemeBlock:CreateInput({
        Name = "Import Data",
        Flag = "Settings_ImportThemeData",
        Placeholder = "Paste theme...",
        Tooltip = "Paste an exported theme here (or leave empty to use the clipboard)",
        Callback = function(v)
            ImportThemeBuffer = v or ""
        end
    })

    ThemeBlock:CreateButton({
        Name = "📥 Import Theme",
        Tooltip = "Apply the pasted theme and save it under the theme name above",
        Callback = function()
            local str = (ImportThemeBuffer ~= "" and ImportThemeBuffer) or PasteText()
            if not str or str == "" then
                Library:Notify({Title = "Import Error", Content = "Paste a theme first (or copy one to the clipboard)", Type = "Error"})
                return
            end
            local ok, parsed = pcall(function() return HS:JSONDecode(str) end)
            if not ok or type(parsed) ~= "table" or type(parsed.Main) ~= "table" then
                Library:Notify({Title = "Import Error", Content = "Invalid theme data", Type = "Error"})
                return
            end
            local theme = RestoreTheme(parsed)
            ApplyTheme(theme, true)
            if ThemeNameInput ~= "" then
                pcall(function()
                    writefile(Library.ThemeFolder .. "/" .. ThemeNameInput .. ".json", HS:JSONEncode(ThemeSnapshot()))
                end)
                LoadDrop:Refresh(Library:GetThemes())
            end
            Library:Notify({Title = "Theme Imported", Content = "Theme applied and saved as " .. ThemeNameInput, Type = "Success"})
        end
    })

    -- À partir d'ici, tout ce que l'utilisateur crée est indexé dans la recherche (Settings inclus)
    IndexingEnabled = true

    return Funcs
end

return Library
