        local success = CopyText(LinkToCopy)
        if success then
            PlaySound("Success")
            Status.Text = "Link copied to clipboard!"
            Status.TextColor3 = SelectedTheme.Accent
        else
            PlaySound("Error")
            Status.Text = "Clipboard unavailable (F9)"
            Status.TextColor3 = SelectedTheme.Error
            warn("[KeySystem] Link: " .. LinkToCopy)
        end
        task.wait(2)
        Status.Text = "Protected System"
        Status.TextColor3 = SelectedTheme.TextDark
    end)

    CheckBtn.MouseButton1Click:Connect(function()
        if Input.Text == Key then
            PlaySound("Success")
            TS:Create(KeyContainer, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.fromOffset(0, 0)}):Play()
            TS:Create(Shadow1, TweenInfo.new(0.4), {ImageTransparency = 1}):Play()
            TS:Create(Shadow2, TweenInfo.new(0.4), {ImageTransparency = 1}):Play()
            task.wait(0.4)
            ScreenGui:Destroy()
            Validated = true
        else
            PlaySound("Error")
            Status.Text = "Incorrect or Invalid Key!"
            Status.TextColor3 = SelectedTheme.Error
            InputStroke.Color = SelectedTheme.Error
            InputStroke.Transparency = 0

            local x = KeyContainer.Position.X.Scale
            local y = KeyContainer.Position.Y.Scale
            for i = 1, 5 do
                KeyContainer.Position = UDim2.fromScale(x + math.random(-1, 1) / 150, y)
                task.wait(0.04)
            end

            KeyContainer.Position = UDim2.fromScale(x, y)
            task.wait(1)

            InputStroke.Color = Color3.new(1, 1, 1)
            InputStroke.Transparency = 0.8
            Status.Text = "Protected System"
            Status.TextColor3 = SelectedTheme.TextDark
        end
    end)

    repeat
        task.wait()
    until Validated
end

function Library:CreateWindow(Settings)
    -- Évite les doublons si CreateWindow est appelé deux fois
    if Library.CurrentGui then
        Library:Destroy()
    end

    local Config = Settings or {}
    local Title = Config.Title or "UI"
    local SelectedTheme = GetTheme(Config.Theme)
    local InitialTheme = Clone(SelectedTheme) -- pour le bouton "Reset Theme"

    Library.GlobalCornerValue = Config.CornerRadius or SelectedTheme.CornerRadius or 35

    Library.ConfigFolder = Config.ConfigFolder or "SolarisUI-Configs"
    if not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
    if not isfolder(Library.ThemeFolder) then makefolder(Library.ThemeFolder) end

    for _, k in ipairs(THEME_COLOR_KEYS) do
        Themes.Default[k] = SelectedTheme[k]
    end
    Themes.Default.Gradient = SelectedTheme.Gradient

    if SelectedTheme.Font then
        UpdateFonts(SelectedTheme.Font)
    end

    Library.ToggleKey = Config.ToggleKey or Enum.KeyCode.RightControl
    local WindowTrans = SelectedTheme.Transparency or Config.Transparency or 0.25
    local ImageTrans = SelectedTheme.ImageTransparency or 0
    local OrbsTrans = SelectedTheme.OrbsTransparency or 0.90

    local WatermarkConfig = { Enabled = true, Title = true, User = true, FPS = true, Time = true, Ping = true }
    if type(Config.ShowWatermark) == "table" then
        for k, v in pairs(Config.ShowWatermark) do
            WatermarkConfig[k] = v
        end
    elseif Config.ShowWatermark == false then
        WatermarkConfig.Enabled = false
    end

    local CustomIconID = Config.CustomIcon

    local ScreenGui = Create("ScreenGui", {
        Name = "MainUI",
        ResetOnSpawn = false,
        DisplayOrder = 10000
    })

    if RS:IsStudio() then
        ScreenGui.Parent = LP:WaitForChild("PlayerGui")
    else
        pcall(function()
            ScreenGui.Parent = CG
        end)
        if not ScreenGui.Parent then
            ScreenGui.Parent = LP:WaitForChild("PlayerGui")
        end
    end
    Library.CurrentGui = ScreenGui
    Library.UIOpen = true

    -- 🚀 Écran de chargement d'intro (désactivable avec Intro = false)
    if Config.Intro ~= false then
        PlayIntro(ScreenGui, SelectedTheme, Config, Title, (CustomIconID and CustomIconID ~= "") and CustomIconID or "rbxassetid://5436396975")
    end

    -- Compteur FPS (lié à la fenêtre, donc nettoyé par Destroy)
    do
        local frames, lastTick = 0, os.clock()
        Bind(RS.Heartbeat, function()
            frames = frames + 1
            local now = os.clock()
            if now - lastTick >= 1 then
                CurrentFPS = frames
                frames = 0
                lastTick = now
            end
        end)
    end

    -- ✨ Les bordures dégradées tournent en continu (en pause quand l'UI est fermée)
    do
        local lastRot = 0
        Bind(RS.RenderStepped, function()
            if not Library.UIOpen then return end
            local now = os.clock()
            if now - lastRot < 1 / 30 then return end
            lastRot = now
            local r = (now * 40) % 360
            for _, g in ipairs(Library.GradientObjects) do
                if g.Parent then g.Rotation = r end
            end
        end)
    end

    function Library:GetThemes()
        local list = {}
        if isfolder(Library.ThemeFolder) then
            for _, file in pairs(listfiles(Library.ThemeFolder)) do
                if file:sub(-5) == ".json" then
                    table.insert(list, (file:match("([^/\\]+)%.json$") or file))
                end
            end
        end
        return list
    end

    function Library:GetConfigs()
        local list = {}
        if isfolder(Library.ConfigFolder) then
            for _, file in pairs(listfiles(Library.ConfigFolder)) do
                if file:sub(-5) == ".json" then
                    local success, decoded = pcall(function()
                        return HS:JSONDecode(readfile(file))
                    end)
                    if success and type(decoded) == "table" and decoded["Settings_Identifier"] == Title then
                        table.insert(list, file:match("([^/\\]+)%.json$") or file)
                    end
                end
            end
        end
        return list
    end

    local function CollectFlags()
        local out = {}
        for flag, value in pairs(Library.Flags) do
            if string.sub(flag, 1, 9) ~= "Settings_" then
                out[flag] = value
            end
        end
        return out
    end

    function Library:SaveConfig(Name)
        local ConfigToSave = CollectFlags()
        ConfigToSave["Settings_Identifier"] = Title
        local json = HS:JSONEncode(ConfigToSave)
        local path = Library.ConfigFolder .. "/" .. Name .. ".json"
        writefile(path, json)
        Library:Notify({Title = "Config Saved", Content = "Successfully saved " .. Name, Duration = 3})
    end

    function Library:LoadConfig(Name)
        local path = Library.ConfigFolder .. "/" .. Name .. ".json"
        if isfile(path) then
            local success = pcall(function()
                local json = readfile(path)
                local data = HS:JSONDecode(json)
                for flag, value in pairs(data) do
                    if Library.Items[flag] then
                        task.spawn(function()
                            Library.Items[flag].Set(value)
                        end)
                    end
                end
            end)
            if success then
                Library:Notify({Title = "Config Loaded", Content = "Successfully loaded " .. Name, Duration = 3})
            else
                Library:Notify({Title = "Config Error", Content = "Corrupted JSON file", Duration = 3})
            end
        end
    end

    function Library:DeleteConfig(Name)
        local path = Library.ConfigFolder .. "/" .. Name .. ".json"
        if isfile(path) then
            delfile(path)
            Library:Notify({Title = "Config Deleted", Content = "Deleted " .. Name, Duration = 3})
        end
    end

    -- 📤 EXPORT : chaîne JSON copiée dans le presse-papier (et retournée)
    function Library:ExportConfig()
        local str = HS:JSONEncode({_type = "config", title = Title, flags = CollectFlags()})
        if CopyText(str) then
            Library:Notify({Title = "Config Exported", Content = "Copied to clipboard (" .. #str .. " chars)", Type = "Success"})
        else
            warn("[Export] Clipboard unavailable. Config string:\n" .. str)
            Library:Notify({Title = "Export", Content = "Clipboard unavailable, string printed in console (F9)", Type = "Warning", Duration = 5})
        end
        return str
    end

    -- 📥 IMPORT : applique une chaîne exportée (ou un JSON de flags brut). SaveAs = nom de fichier optionnel
    function Library:ImportConfig(str, SaveAs)
        local ok, data = pcall(function() return HS:JSONDecode(str) end)
        if not ok or type(data) ~= "table" then
            Library:Notify({Title = "Import Error", Content = "Invalid config data", Type = "Error"})
            return false
        end
        local flags = type(data.flags) == "table" and data.flags or data
        local applied = 0
        local toSave = {}
        for flag, value in pairs(flags) do
            if type(flag) == "string" and string.sub(flag, 1, 9) ~= "Settings_" then
                toSave[flag] = value
                local item = Library.Items[flag]
                if item then
                    applied = applied + 1
                    task.spawn(function()
                        local okSet, err = pcall(item.Set, value)
                        if not okSet then warn("[Import] " .. flag .. ": " .. tostring(err)) end
                    end)
                end
            end
        end
        if SaveAs and SaveAs ~= "" then
            toSave["Settings_Identifier"] = Title
            pcall(function()
                writefile(Library.ConfigFolder .. "/" .. SaveAs .. ".json", HS:JSONEncode(toSave))
            end)
        end
        Library:Notify({
            Title = "Config Imported",
            Content = applied .. " option(s) applied" .. ((SaveAs and SaveAs ~= "") and (", saved as " .. SaveAs) or ""),
            Type = "Success"
        })
        return true
    end

    local AutoloadPath = Library.ConfigFolder .. "/Autoload.txt"
    if isfile(AutoloadPath) then
        local cfgToLoad = readfile(AutoloadPath)
        if cfgToLoad ~= "" then
            task.delay(1, function()
                Library:LoadConfig(cfgToLoad)
            end)
        end
    end

    if WatermarkConfig.Enabled then
        local HudFrame = Create("Frame", {
