        local thumb = N("Frame", {
            Parent = fill, Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 25009
        })
        Round(thumb, 100)
        local val = N("TextLabel", {
            Parent = ctrl, Size = UDim2.new(0, 52, 1, 0), Position = UDim2.new(0, 80, 0, 0), BackgroundTransparency = 1,
            Text = "", TextSize = 12, Font = Library.GlobalFontBold, TextColor3 = SelectedTheme.Text,
            TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 25006
        })
        local last
        local function refresh(animate)
            local v = Library.Flags[e.flag]
            if type(v) ~= "number" or v == last then return end
            last = v
            val.Text = string.format("%." .. Dec .. "f", v) .. (m.Suffix or "")
            local size = UDim2.fromScale(math.clamp((v - Min) / range, 0, 1), 1)
            if animate then
                Tween(fill, 0.1, {Size = size}, Enum.EasingStyle.Sine)
            else
                fill.Size = size
            end
        end
        local function apply(input)
            local p = math.clamp((input.Position.X - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
            local item = Library.Items[e.flag]
            if item then
                item.Set(Min + (Max - Min) * p)
                refresh(true)
            end
        end
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                SliderDrag = {apply = apply}
                MarkUsed(e)
                apply(i)
                Tween(thumb, 0.15, {Size = UDim2.fromOffset(14, 14)})
            end
        end)
        hit.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                Tween(thumb, 0.15, {Size = UDim2.fromOffset(10, 10)})
            end
        end)
        refresh(false)
        return refresh
    end

