-- Particules : RenderStepped + dt, en pause quand l'UI est fermée, connexion auto-nettoyée
local function AddSoftOrbs(parent, theme)
    local Container = Create("Frame", {
        Parent = parent,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 2,
        ClipsDescendants = true
    })
    AddCorner(Container, 12)

    local particles = {}

    for i = 1, math.random(40, 50) do
        local size = math.random(2, 5)
        local Particle = Create("Frame", {
            Parent = Container,
            Size = UDim2.fromOffset(size, size),
            Position = UDim2.fromScale(math.random(0, 100) / 100, math.random(0, 100) / 100),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = math.random(75, 92) / 100,
            BorderSizePixel = 0,
            ZIndex = 2
        })
        AddCorner(Particle, 1000)
        table.insert(particles, {
            frame = Particle,
            velocity = Vector2.new(math.random(-20, 20) / 100, math.random(-20, 20) / 100)
        })
    end

    local conn
    conn = RS.RenderStepped:Connect(function(dt)
        if not Container.Parent then
            conn:Disconnect()
            return
        end
        if not Library.UIOpen then return end

        dt = math.min(dt, 0.1)
        local f = dt * 60

        local containerSize = Container.AbsoluteSize
        if containerSize.X <= 0 or containerSize.Y <= 0 then return end

        local mousePos = UIS:GetMouseLocation() - GuiService:GetGuiInset()
        local containerPos = Container.AbsolutePosition
        local mx = (mousePos.X - containerPos.X) / containerSize.X
        local my = (mousePos.Y - containerPos.Y) / containerSize.Y

        for _, p in ipairs(particles) do
            local pos = p.frame.Position
            local x, y = pos.X.Scale, pos.Y.Scale

            local dx, dy = x - mx, y - my
            local distance = math.sqrt(dx * dx + dy * dy)
            if distance < 0.15 and distance > 0 then
                local force = (0.15 - distance) / 0.15 * 0.02 * f
                p.velocity = p.velocity + Vector2.new(dx / distance * force, dy / distance * force)
            end

            x = x + p.velocity.X * dt
            y = y + p.velocity.Y * dt

            if x <= 0 or x >= 1 then
                p.velocity = Vector2.new(-p.velocity.X, p.velocity.Y)
                x = math.clamp(x, 0, 1)
            end
            if y <= 0 or y >= 1 then
                p.velocity = Vector2.new(p.velocity.X, -p.velocity.Y)
                y = math.clamp(y, 0, 1)
            end

            p.velocity = p.velocity * (0.98 ^ f)
            -- petite dérive pour que les particules ne s'arrêtent jamais
            if p.velocity.Magnitude < 0.03 then
                p.velocity = p.velocity + Vector2.new(math.random(-10, 10) / 1000, math.random(-10, 10) / 1000) * f
            end

            p.frame.Position = UDim2.fromScale(x, y)
        end
    end)
    table.insert(Library.Connections, conn)

    return Container
end

