            local cp = SearchBox.CursorPosition
            task.defer(function() SearchBox.CursorPosition = cp end)
            if #Results > 0 then
                local nextI = Selected + (k == Enum.KeyCode.Down and 1 or -1)
                if nextI > #Results then nextI = 1 elseif nextI < 1 then nextI = #Results end
                PlaySound("Hover")
