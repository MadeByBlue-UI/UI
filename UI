                GroupTransparency = 0, Position = UDim2.new(0, 6, 0, y)
            }):Play()
        end
        return row, refresh
    end

    ----------------------------------------------------------------------
    -- 🚀 ACTIONS : aller à l'élément / action rapide
    ----------------------------------------------------------------------
    local function Flash(obj)
        if not obj or not obj.Parent then return end
        local f = N("Frame", {
            Parent = obj, Size = UDim2.fromScale(1, 1), BackgroundColor3 = SelectedTheme.ElementAccent,
            BackgroundTransparency = 1, BorderSizePixel = 0, Active = false, ZIndex = (obj.ZIndex or 7) + 4
        })
        Round(f, 8)
        for _ = 1, 2 do
            if not f.Parent then return end
            TS:Create(f, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundTransparency = 0.55}):Play()
            task.wait(0.28)
            TS:Create(f, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
            task.wait(0.38)
        end
        f:Destroy()
    end

    Go = function(e)
        MarkUsed(e)
        CloseResults()
        SearchBox:ReleaseFocus()
        SearchBox.Text = ""
        task.spawn(function()
            local tab = e.tab
            if tab and not (ActiveTab and ActiveTab.Btn == tab.Btn) then
                tab.Activate()
                task.wait(0.15)
            end
            local setter = e.block and Library.BlockSetters[e.block]
            if setter and setter(false) then task.wait(0.45) end
            local el = e.element
            local page = tab and tab.Page
            if el and el.Parent and page and page.Parent then
                local rel = el.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y
                local maxScroll = math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y)
                local target = math.clamp(rel - (page.AbsoluteWindowSize.Y / 2 - el.AbsoluteSize.Y / 2), 0, maxScroll)
                Tween(page, 0.4, {CanvasPosition = Vector2.new(0, target)}, Enum.EasingStyle.Quart)
                task.wait(0.3)
                Flash(el)
            end
        end)
    end

    local function RefreshRows(animate)
        for _, f in ipairs(RowRefresh) do pcall(f, animate) end
    end

    -- Entrée : action principale selon le type (Shift+Entrée = aller à l'élément)
    local function Primary(e, forceGo)
        if forceGo then
            Go(e)
        elseif e.kind == "Toggle" then
            local item = Library.Items[e.flag]
            if item then
                PlaySound("Toggle")
                MarkUsed(e)
                item.Set(not (Library.Flags[e.flag] == true))
                RefreshRows(true)
            end
            task.delay(0.03, function()
                if PanelOpen then SearchBox:CaptureFocus() end
            end)
        elseif e.kind == "Button" and e.meta.Run then
            PlaySound("Click")
            MarkUsed(e)
            e.meta.Run()
            CloseResults()
        else
            Go(e)
        end
    end

    ----------------------------------------------------------------------
    -- 🎬 OUVERTURE / FERMETURE / RENDU
    ----------------------------------------------------------------------
    Render = function(animate)
        local out, tokens, header, dym = Compute(SearchBox.Text)

        for _, r in ipairs(RowObjects) do r:Destroy() end
        RowObjects, RowRefresh, Results = {}, {}, {}
        for _, r in ipairs(out) do Results[#Results + 1] = r.e end

        local n = #Results
        local listH
        List.CanvasPosition = Vector2.new(0, 0)
        Selected = 0

        if n > 0 then
            Empty.Visible = false
            for i, e in ipairs(Results) do
                local row, refresh = BuildRow(e, i, tokens, animate)
                RowObjects[#RowObjects + 1] = row
                if refresh then RowRefresh[#RowRefresh + 1] = refresh end
            end
            listH = math.clamp(n * (ROW_H + ROW_GAP) + 8, ROW_H + 12, MAX_LIST_H)
            List.CanvasSize = UDim2.fromOffset(0, n * (ROW_H + ROW_GAP) + 8)
            Select(1)
            CountLabel.Text = header or (n .. (n > 1 and " résultats" or " résultat"))
        else
            Selector.Visible = false
            List.CanvasSize = UDim2.new()
            listH = 96
            Empty.Visible = true
            if EmptyConn then EmptyConn:Disconnect() EmptyConn = nil end
            if #tokens > 0 or SearchBox.Text ~= "" then
                EmptyTitle.Text = "Aucun résultat pour « " .. SearchBox.Text .. " »"
                if dym then
                    EmptySub.Text = "Vous vouliez dire :  " .. dym .. " ?"
                    EmptyConn = EmptySub.MouseButton1Click:Connect(function()
                        SearchBox.Text = dym
                        SearchBox:CaptureFocus()
                    end)
                else
                    EmptySub.Text = "Essaie un autre mot, ou change de filtre"
                end
            else
                EmptyTitle.Text = "Rien à afficher pour ce filtre"
                EmptySub.Text = ""
            end
            CountLabel.Text = "0 résultat"
        end

        if animate then
            Tween(Panel, 0.32, {Size = UDim2.new(1, 0, 0, CHIPS_H + listH + FOOT_H)}, Enum.EasingStyle.Quart)
            Tween(List, 0.32, {Size = UDim2.new(1, 0, 0, listH)}, Enum.EasingStyle.Quart)
            Tween(Footer, 0.32, {Position = UDim2.new(0, 0, 0, CHIPS_H + listH)}, Enum.EasingStyle.Quart)
        else
            Panel.Size = UDim2.new(1, 0, 0, CHIPS_H + listH + FOOT_H)
            List.Size = UDim2.new(1, 0, 0, listH)
            Footer.Position = UDim2.new(0, 0, 0, CHIPS_H + listH)
        end
    end

