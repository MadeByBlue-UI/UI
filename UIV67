	BUILD.Toggle = function(f, e)
		local it = e.Item
		local hdr = newHeader(f, e, 56)
		local sw = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0),
