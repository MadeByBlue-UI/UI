		mainEntry.BaseRadius = base
		horizonEntry.BaseRadius = math.max(base - 1, 0)
		sheenEntry.BaseRadius = base
		glintEntry.BaseRadius = base
		for _, e in ipairs({ mainEntry, horizonEntry, sheenEntry, glintEntry }) do
			if Library.SquareMode then
				if e.Corner:GetAttribute("SqOrig") == nil then e.Corner:SetAttribute("SqOrig", e.Corner.CornerRadius) end
				e.Corner.CornerRadius = UDim.new(0, 0)
			else
				e.Corner.CornerRadius = UDim.new(0, math.floor(e.BaseRadius * Library.GlobalCornerValue / 10))
			end
		end
