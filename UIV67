--- Used by Label and Toggle: `self.Addons` is the right-aligned container.
function Addons:AddColorPicker(idx, info)
    info = info or {}
    local picker = {
        Type = "ColorPicker",
        Index = idx,
        Title = info.Title or "Color picker",
        Callback = info.Callback,
        Changed = Signal.new(),
        Rainbow = false,
        Open = false,
        Parent = self,
    }

    local initial = info.Default or Color3.new(1, 1, 1)
    picker.Hue, picker.Sat, picker.Vib = initial:ToHSV()
    picker.Value = initial
    if info.Transparency ~= nil then
        picker.Transparency = info.Transparency
        picker.HasAlpha = true
    end

    -- Swatch in the addon row
    local swatch = Library:Create("TextButton", {
        Name = "ColorSwatch",
        Size = UDim2.fromOffset(26, 14),
        Text = "",
        BackgroundColor3 = initial,
        ZIndex = 5,
        LayoutOrder = #self.Addons:GetChildren(),
        Parent = self.Addons,
    })
    Library:AddCorner(swatch, 4)
    Library:AddStroke(swatch, "OutlineColor", 1)
    picker.Swatch = swatch

    if info.Tooltip then
        Library:AddTooltip(info.Tooltip, swatch)
    end

    -- ── Popup (built lazily) ────────────────────────────────────────────
    local built = false
    local popup, svFrame, svCursor, hueFrame, hueCursor, alphaFrame, alphaCursor
    local alphaGradientHolder, hexBox, rainbowButton

    local function build()
        built = true
        local height = picker.HasAlpha and 268 or 248
        popup = Library:Create("Frame", {
            Name = "ColorPickerPopup",
            Size = UDim2.fromOffset(236, height),
            Visible = false,
            ZIndex = 520,
            ["@BackgroundColor3"] = "BackgroundColor",
            Parent = Library.PopupLayer,
        })
        Library:AddCorner(popup, 6)
        Library:AddStroke(popup, "AccentColor", 1, 0.35)

        Library:Create("TextLabel", {
            Position = UDim2.fromOffset(10, 6),
            Size = UDim2.new(1, -20, 0, 16),
            Text = picker.Title,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 521,
            ["@TextColor3"] = "FontColor",
            Parent = popup,
        })

        -- Saturation / value square
        svFrame = Library:Create("Frame", {
            Position = UDim2.fromOffset(10, 28),
            Size = UDim2.fromOffset(216, 130),
            ZIndex = 521,
            BackgroundColor3 = Color3.fromHSV(picker.Hue, 1, 1),
            Parent = popup,
        })
        Library:AddCorner(svFrame, 4)

        local white = Library:Create("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(1, 1, 1),
            ZIndex = 522,
            Parent = svFrame,
        })
        Library:AddCorner(white, 4)
        Library:Create("UIGradient", {
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(1, 1),
            }),
            Parent = white,
        })

        local black = Library:Create("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(0, 0, 0),
            ZIndex = 523,
            Parent = svFrame,
        })
        Library:AddCorner(black, 4)
        Library:Create("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 0),
            }),
            Parent = black,
        })

        svCursor = Library:Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(10, 10),
            BackgroundTransparency = 1,
            ZIndex = 525,
            Parent = svFrame,
        })
        Library:AddCorner(svCursor, 9999)
        Library:AddStroke(svCursor, Color3.new(1, 1, 1), 2)

        -- Hue bar
        hueFrame = Library:Create("Frame", {
            Position = UDim2.fromOffset(10, 166),
            Size = UDim2.fromOffset(216, 12),
            BackgroundColor3 = Color3.new(1, 1, 1),
            ZIndex = 521,
            Parent = popup,
        })
        Library:AddCorner(hueFrame, 4)
        Library:Create("UIGradient", { Color = RAINBOW_SEQUENCE, Parent = hueFrame })
        hueCursor = Library:Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(4, 16),
            BackgroundColor3 = Color3.new(1, 1, 1),
            ZIndex = 523,
            Parent = hueFrame,
        })
        Library:AddCorner(hueCursor, 2)
        Library:AddStroke(hueCursor, Color3.new(0, 0, 0), 1, 0.3)

        local nextY = 186

        -- Alpha bar
        if picker.HasAlpha then
            alphaFrame = Library:Create("Frame", {
                Position = UDim2.fromOffset(10, nextY),
                Size = UDim2.fromOffset(216, 12),
                BackgroundColor3 = picker.Value,
                ZIndex = 521,
                Parent = popup,
            })
            Library:AddCorner(alphaFrame, 4)
            Library:Create("UIGradient", {
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1),
                }),
                Parent = alphaFrame,
            })
            alphaGradientHolder = alphaFrame
            alphaCursor = Library:Create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0, 0.5),
                Size = UDim2.fromOffset(4, 16),
                BackgroundColor3 = Color3.new(1, 1, 1),
                ZIndex = 523,
                Parent = alphaFrame,
            })
            Library:AddCorner(alphaCursor, 2)
            Library:AddStroke(alphaCursor, Color3.new(0, 0, 0), 1, 0.3)
            nextY = nextY + 20
        end

        -- Hex + rainbow row
        hexBox = Library:Create("TextBox", {
            Position = UDim2.fromOffset(10, nextY),
            Size = UDim2.fromOffset(110, 22),
            Text = "#" .. Library:ColorToHex(picker.Value),
            PlaceholderText = "#RRGGBB",
            ClearTextOnFocus = false,
            ZIndex = 521,
            ["@BackgroundColor3"] = "MainColor",
            ["@TextColor3"] = "FontColor",
            Parent = popup,
        })
        Library:AddCorner(hexBox, 4)
        Library:AddStroke(hexBox, "OutlineColor", 1)

        rainbowButton = Library:Create("TextButton", {
            Position = UDim2.fromOffset(126, nextY),
            Size = UDim2.fromOffset(100, 22),
            Text = "Rainbow: off",
            ZIndex = 521,
            ["@BackgroundColor3"] = "MainColor",
            ["@TextColor3"] = "MutedColor",
            Parent = popup,
        })
        Library:AddCorner(rainbowButton, 4)
        Library:AddStroke(rainbowButton, "OutlineColor", 1)

        -- Copy / paste row
        local copyButton = Library:Create("TextButton", {
            Position = UDim2.fromOffset(10, nextY + 28),
            Size = UDim2.fromOffset(105, 22),
            Text = "Copy color",
            ZIndex = 521,
            ["@BackgroundColor3"] = "MainColor",
            ["@TextColor3"] = "FontColor",
            Parent = popup,
        })
        Library:AddCorner(copyButton, 4)
        Library:AddStroke(copyButton, "OutlineColor", 1)

        local pasteButton = Library:Create("TextButton", {
            Position = UDim2.fromOffset(121, nextY + 28),
            Size = UDim2.fromOffset(105, 22),
            Text = "Paste color",
            ZIndex = 521,
            ["@BackgroundColor3"] = "MainColor",
            ["@TextColor3"] = "FontColor",
            Parent = popup,
        })
        Library:AddCorner(pasteButton, 4)
        Library:AddStroke(pasteButton, "OutlineColor", 1)

        -- Interaction
        Library:BindDrag(svFrame, function(point)
            local x, y = Library:GetRatio(svFrame, point)
            picker.Sat = x
            picker.Vib = 1 - y
            picker:Update()
        end)

        Library:BindDrag(hueFrame, function(point)
            local x = Library:GetRatio(hueFrame, point)
            picker.Rainbow = false
            picker.Hue = math.clamp(x, 0, 0.999)
            picker:Update()
        end)

        if alphaFrame then
            Library:BindDrag(alphaFrame, function(point)
                local x = Library:GetRatio(alphaFrame, point)
                picker.Transparency = x
                picker:Update()
            end)
        end

        hexBox.FocusLost:Connect(function()
            local color = Library:HexToColor(hexBox.Text)
            if color then
                picker:SetValueRGB(color)
            else
                hexBox.Text = "#" .. Library:ColorToHex(picker.Value)
            end
        end)

        rainbowButton.MouseButton1Click:Connect(function()
            picker:SetRainbow(not picker.Rainbow)
        end)

        copyButton.MouseButton1Click:Connect(function()
            Library.ColorClipboard = picker.Value
            Library:CopyToClipboard("#" .. Library:ColorToHex(picker.Value))
            Library:Notify({ Title = "Color", Description = "Copied #" .. Library:ColorToHex(picker.Value), Time = 2 })
        end)

        pasteButton.MouseButton1Click:Connect(function()
            if Library.ColorClipboard then
                picker:SetValueRGB(Library.ColorClipboard)
            end
        end)
    end

    function picker:Display()
        local color = Color3.fromHSV(self.Hue, self.Sat, self.Vib)
        self.Value = color
        swatch.BackgroundColor3 = color
        swatch.BackgroundTransparency = self.HasAlpha and (self.Transparency * 0.85) or 0

        if built then
            svFrame.BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1)
            svCursor.Position = UDim2.fromScale(self.Sat, 1 - self.Vib)
            hueCursor.Position = UDim2.fromScale(self.Hue, 0.5)
            if alphaFrame then
                alphaFrame.BackgroundColor3 = color
                alphaCursor.Position = UDim2.fromScale(self.Transparency, 0.5)
            end
            if not hexBox:IsFocused() then
                hexBox.Text = "#" .. Library:ColorToHex(color)
            end
            rainbowButton.Text = self.Rainbow and "Rainbow: on" or "Rainbow: off"
            rainbowButton.TextColor3 = self.Rainbow and Library.Theme.AccentColor or Library.Theme.MutedColor
        end
    end

    function picker:Update()
        self:Display()
        Library:SafeCallback(self.Callback, self.Value, self.Transparency)
        self.Changed:Fire(self.Value, self.Transparency)
    end

    function picker:OnChanged(fn)
        return self.Changed:Connect(fn)
    end

    function picker:SetValue(hsv, transparency)
        self.Hue = math.clamp(hsv[1], 0, 1)
        self.Sat = math.clamp(hsv[2], 0, 1)
        self.Vib = math.clamp(hsv[3], 0, 1)
        if transparency ~= nil and self.HasAlpha then
            self.Transparency = transparency
        end
        self:Update()
    end

    function picker:SetValueRGB(color, transparency)
        local h, s, v = color:ToHSV()
        self.Rainbow = false
        self:SetValue({ h, s, v }, transparency)
    end

    function picker:SetRainbow(state)
        local new = state and true or false
        local changed = new ~= self.Rainbow
        self.Rainbow = new
        self:Display()
        if changed then
            self.Changed:Fire(self.Value, self.Transparency)
        end
    end

    function picker:GetValue()
        return self.Value
    end

    function picker:SetVisible(visible)
        swatch.Visible = visible
    end

    function picker:Show()
        if not built then
            build()
        end
        Library:CloseAllPopups(popup)
        self.Open = true
        popup.Visible = true
        self:Display()
        Library:PositionPopup(popup, swatch, 236, 6)
        Library:OpenPopup(popup, function()
            picker:Hide()
        end, swatch)
        self.PositionHandle = Library:AddAnimation(function()
            if not picker.Open or not swatch.Parent then
                return
            end
            Library:PositionPopup(popup, swatch, 236, 6)
        end)
    end

    function picker:Hide()
        self.Open = false
        if popup then
            popup.Visible = false
            Library:ClosePopup(popup)
        end
        if self.PositionHandle then
            self.PositionHandle:Stop()
            self.PositionHandle = nil
        end
    end

    swatch.MouseButton1Click:Connect(function()
        if picker.Open then
            picker:Hide()
        else
            picker:Show()
        end
    end)

    swatch.MouseButton2Click:Connect(function()
        picker:SetRainbow(not picker.Rainbow)
    end)

    local lastRainbowFire = 0
    Library:AddAnimation(function(_, clock)
        if not picker.Rainbow or not swatch.Parent then
            return
        end
        picker.Hue = (clock * 0.25) % 1
        if clock - lastRainbowFire > 0.04 then
            lastRainbowFire = clock
            picker.TickFire = true
            picker:Update()
            picker.TickFire = false
        else
            picker:Display()
        end
    end)

    picker:Display()
    Library.Options[idx] = picker
    return self
end

