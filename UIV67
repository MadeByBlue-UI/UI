	notes:CreateTextArea({ Name = "Notes (sauvegardées automatiquement)", Flag = "ui.home.notes", Height = 130, MaxLength = 4000,
		Placeholder = "Pseudos, coordonnées, idées, rappels..." })

	-- ----- amis : dans le serveur + en ligne (à inviter)
	local fr = subInfo:CreateBlock({ Name = "Amis", Side = "Left" })
	local frInfo = fr:CreateLabel({ Text = "Chargement de tes amis…" })
	local frRow = makeRow(fr, 236, "Amis")
	local sf = new("ScrollingFrame", { Position = UDim2.new(0, 4, 0, 4), Size = UDim2.new(1, -8, 1, -8), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.Accent, ScrollBarImageTransparency = 0.5,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = AY }, frRow)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = BYORDER }, sf)

	local friendList, friendLoaded, friendAt, friendBusy, friendsDirty = {}, false, 0, false, false
	local ordN = 0
	local function nextOrd() ordN += 1 return ordN end
	local function clearRows()
		for _, c in ipairs(sf:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		ordN = 0
	end
	local function addHeader(text)
		label(sf, string.upper(text), 10, { Size = UDim2.new(1, -6, 0, 18), Font = F_BOLD, TextColor3 = T.ElementAccent, LayoutOrder = nextOrd() })
	end
	local function inviteFriend(id, nm)
		local ok, err = pcall(function()
			local SocialService = game:GetService("SocialService")
			local can = true
			pcall(function() can = SocialService:CanSendGameInviteAsync(lp, id) end)
			if not can then error("invitation impossible pour le moment") end
			local opts = Instance.new("GameInvitePromptOptions")
			opts.InviteUser = id
			SocialService:PromptGameInvite(lp, opts)
		end)
		if not ok then
			Library:Notify({ Title = "Invitation", Content = "Impossible d'inviter " .. tostring(nm) .. " : " .. tostring(err),
				Type = "Warning", Duration = 4 })
		end
	end
	local function addRow(f, status, scol, canInvite)
		local uname, dname = f.Username or "", f.DisplayName or ""
		local r = new("Frame", { Size = UDim2.new(1, -6, 0, 40), BackgroundColor3 = T.Element, BackgroundTransparency = 0.5,
			BorderSizePixel = 0, LayoutOrder = nextOrd() }, sf)
		corner(r, 8)
		local img = new("ImageLabel", { Position = UDim2.new(0, 6, 0.5, -15), Size = UDim2.fromOffset(30, 30), BackgroundColor3 = T.Off,
			BorderSizePixel = 0, Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(f.Id) .. "&w=150&h=150" }, r)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, img)
		local rightPad = canInvite and 76 or 10
		local title = (dname ~= "" and dname ~= uname) and (dname .. "  (@" .. uname .. ")") or uname
		label(r, title, 12, { Position = UDim2.new(0, 44, 0, 4), Size = UDim2.new(1, -44 - rightPad, 0, 16) })
		label(r, status, 11, { Position = UDim2.new(0, 44, 0, 21), Size = UDim2.new(1, -44 - rightPad, 0, 14), Font = F_REG, TextColor3 = scol })
		if canInvite then
			local b = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(60, 24),
				BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, Text = "Inviter", TextColor3 = T.Text, TextSize = 12,
				Font = F_MED, AutoButtonColor = false, BorderSizePixel = 0 }, r)
			corner(b, 6)
			b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.8 }, 0.15) end)
			b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = 0.9 }, 0.2) end)
			b.MouseButton1Click:Connect(function() inviteFriend(f.Id, title) end)
		end
	end
	local function byName(a, b) return string.lower(a.DisplayName ~= "" and a.DisplayName or a.Username) < string.lower(b.DisplayName ~= "" and b.DisplayName or b.Username) end
	local function rebuildFriends()
		friendsDirty = false
		clearRows()
		local inSrv, online = {}, {}
		for _, f in ipairs(friendList) do
			local present = Players:GetPlayerByUserId(f.Id) ~= nil or (f.GameId ~= nil and game.JobId ~= "" and f.GameId == game.JobId)
			if present then inSrv[#inSrv + 1] = f else online[#online + 1] = f end
		end
		table.sort(inSrv, byName)
		table.sort(online, byName)
		frInfo.SetText(string.format("%d dans ce serveur  ·  %d en ligne ailleurs", #inSrv, #online))
		if #inSrv > 0 then
			addHeader("Dans ce serveur (" .. #inSrv .. ")")
			for _, f in ipairs(inSrv) do addRow(f, "Dans ce serveur", HOME_GOOD, false) end
		end
		if #online > 0 then
			addHeader("En ligne · à inviter (" .. #online .. ")")
			for i, f in ipairs(online) do
				if i > 80 then break end
				local st = "En ligne"
				if f.PlaceId ~= nil and f.PlaceId == game.PlaceId then
					st = "Dans ce jeu · autre serveur"
				elseif f.Where and f.Where ~= "" then
					st = tostring(f.Where)
				end
				addRow(f, st, Color3.fromRGB(165, 165, 172), true)
			end
		end
		if #inSrv == 0 and #online == 0 then
			addHeader("Aucun ami en ligne pour le moment")
		end
	end
	local function fetchOnlineFriends()
		local out = {}
		local okA, res = pcall(function() return lp:GetFriendsOnline(200) end)
		if okA and type(res) == "table" then
			for _, e in ipairs(res) do
				if e.IsOnline ~= false and e.VisitorId then
					out[#out + 1] = { Id = e.VisitorId, Username = e.UserName or "", DisplayName = e.DisplayName or "",
						Where = e.LastLocation, PlaceId = e.PlaceId, GameId = e.GameId }
				end
			end
			return out, true
		end
		local okB = pcall(function()   -- repli : GetFriendsAsync (champ IsOnline)
			local pages = Players:GetFriendsAsync(lp.UserId)
			while true do
				for _, f in ipairs(pages:GetCurrentPage()) do
					if f.IsOnline then out[#out + 1] = { Id = f.Id, Username = f.Username or "", DisplayName = f.DisplayName or "" } end
				end
				if pages.IsFinished then break end
				pages:AdvanceToNextPageAsync()
			end
		end)
		return out, okB
	end
	local function refreshFriends()
		if friendBusy then return end
		friendBusy = true
		task.spawn(function()
			local list, ok = fetchOnlineFriends()
			friendBusy = false
			friendAt = os.clock()
			if ok then
				friendList, friendLoaded, friendsDirty = list, true, true
			elseif not friendLoaded then
				frInfo.SetText("Impossible de charger tes amis pour le moment.")
			end
		end)
	end
	fr:CreateButton({ Name = "Actualiser les amis", Favorite = false, Callback = refreshFriends })
	track(Players.PlayerAdded:Connect(function() friendsDirty = true end))
	track(Players.PlayerRemoving:Connect(function() task.defer(function() friendsDirty = true end) end))
	task.delay(2.5, refreshFriends)

	-- ===================== COLONNE DROITE =====================
	-- ----- en direct
	local live = subInfo:CreateBlock({ Name = "En direct", Side = "Right" })
	local st = live:CreateStats({ Columns = 2, CellHeight = 48, Items = {
		{ Id = "fps", Name = "FPS" }, { Id = "ping", Name = "Ping" },
		{ Id = "players", Name = "Joueurs" }, { Id = "mem", Name = "Mémoire" },
		{ Id = "session", Name = "Session" }, { Id = "uptime", Name = "Serveur actif" },
	} })

	-- ----- graphiques FPS / ping (historique ~45 s)
	local gb = subInfo:CreateBlock({ Name = "Graphiques", Side = "Right" })
	local gFps = gb:CreateGraph({ Name = "FPS", MinMax = 60, Height = 62, Samples = 90, ColorFn = fpsColor })
	local gPing = gb:CreateGraph({ Name = "Ping", Unit = " ms", MinMax = 100, Height = 62, Samples = 90, ColorFn = pingColor })

	-- ----- session : jauge + temps de jeu total + alerte
	local ses = subInfo:CreateBlock({ Name = "Session", Side = "Right" })
	local gauge = ses:CreateProgress({ Name = "Durée de la session", Min = 0, Max = 7200, Default = 0,
		Format = function(v, _, max) return fmtDur(v) .. " / " .. fmtDur(max) end })
	local sst = ses:CreateStats({ Columns = 2, CellHeight = 46, Items = {
		{ Id = "total", Name = "Temps de jeu total" }, { Id = "left", Name = "Avant la limite" },
	} })
	ses:CreateSlider({ Name = "Limite de session", Flag = "ui.home.limit", Min = 15, Max = 480, Step = 15, Default = 120, Suffix = " min" })
	ses:CreateToggle({ Name = "Me prévenir à la limite", Flag = "ui.home.limitalert", Default = true, Keybind = false })
	local baseTotal = 0   -- secondes jouées lors des sessions précédentes (restauré depuis les réglages)
	local function totalNow() return baseTotal + (os.clock() - started) end
	Library.Items["ui.home.playtime"] = {
		Get = function() return math.floor(totalNow()) end,
		Set = function(_, v)
			baseTotal = math.max(0, tonumber(v) or 0)
			Library.Flags["ui.home.playtime"] = math.floor(totalNow())
		end,
	}
	local function limitSec() return math.clamp(tonumber(Library.Flags["ui.home.limit"]) or 120, 15, 480) * 60 end
	local lastLimit, nextAlert = nil, nil

	-- ----- heure & météo (réelles, chez toi)
	local wb = subInfo:CreateBlock({ Name = "Heure & météo", Side = "Right" })
	local wst = wb:CreateStats({ Columns = 2, CellHeight = 46, Items = {
		{ Id = "time", Name = "Heure", Value = "--:--:--" }, { Id = "date", Name = "Date", Size = 13 },
		{ Id = "temp", Name = "Température", Value = "…" }, { Id = "sky", Name = "Ciel", Size = 13 },
	} })
	local wplace = wb:CreateLabel({ Text = "Lieu : …" })
	local geo, wState, wBusy, wDirty = nil, nil, false, true
	local function weatherOn() return Library.Flags["ui.home.weather"] ~= false end
	local function cityFlag() return string.gsub(string.gsub(tostring(Library.Flags["ui.home.city"] or ""), "^%s+", ""), "%s+$", "") end
	local function resolveGeo(city)
		if city ~= "" then
			local d = homeJson("https://geocoding-api.open-meteo.com/v1/search?name=" .. HttpService:UrlEncode(city) .. "&count=1&language=fr&format=json")
			local r = d and d.results and d.results[1]
			if r and r.latitude and r.longitude then
				return { key = city, lat = r.latitude, lon = r.longitude, place = tostring(r.name) .. (r.country and (", " .. r.country) or "") }
			end
			return nil
		end
		local d = homeJson("https://ipwho.is/")
		if d and d.success ~= false and d.latitude and d.longitude then
			return { key = city, lat = d.latitude, lon = d.longitude, place = tostring(d.city or "?") .. (d.country and (", " .. d.country) or "") }
		end
		d = homeJson("https://ipapi.co/json/")
		if d and d.latitude and d.longitude then
			return { key = city, lat = d.latitude, lon = d.longitude, place = tostring(d.city or "?") .. (d.country_name and (", " .. d.country_name) or "") }
		end
		return nil
	end
	local function updateWeather()
		if wBusy then return end
		if not weatherOn() then wDirty = true return end
		wBusy = true
		task.spawn(function()
			local ok = pcall(function()
				local city = cityFlag()
				if not geo or geo.key ~= city then geo = resolveGeo(city) end
				if not geo then
					wState = { err = city ~= "" and "Ville introuvable" or "Position inconnue" }
					return
				end
				local d = homeJson(string.format("https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f&current=temperature_2m,weather_code,wind_speed_10m,is_day&timezone=auto", geo.lat, geo.lon))
				local c = d and d.current
				if c then
					wState = { temp = c.temperature_2m, code = c.weather_code, wind = c.wind_speed_10m, day = c.is_day == 1 }
				else
					wState = { err = "Météo indisponible" }
				end
			end)
			if not ok then wState = { err = "Météo indisponible" } end
			wBusy = false
			wDirty = true
		end)
	end
	local function applyWeather()
		wDirty = false
		local function r(x) return math.floor((tonumber(x) or 0) + 0.5) end
		if not weatherOn() then
			wst:Set("temp", "—")
			wst:Set("sky", "Désactivée")
			wplace.SetText("Lieu : — (aucune requête en ligne)")
		elseif not wState then
			wst:Set("temp", "…")
			wst:Set("sky", "Chargement…")
		elseif wState.err then
			wst:Set("temp", "—")
			wst:Set("sky", wState.err)
			wplace.SetText("Lieu : " .. (geo and geo.place or "—"))
		else
			wst:Set("temp", r(wState.temp) .. " °C")
			wst:Set("sky", WMO[wState.code] or "—")
			wplace.SetText("Lieu : " .. (geo and geo.place or "—") .. "  ·  vent " .. r(wState.wind) .. " km/h  ·  " .. (wState.day and "jour" or "nuit"))
		end
	end
	wb:CreateToggle({ Name = "Météo en ligne", Flag = "ui.home.weather", Default = true, Keybind = false,
		Tooltip = "Demande ta position approximative (via ton IP) à ipwho.is, puis la météo à Open-Meteo. Désactive pour ne rien envoyer.",
		Callback = function() wDirty = true updateWeather() end })
	wb:CreateInput({ Name = "Ville (vide = auto)", Flag = "ui.home.city", Placeholder = "ex. Avignon",
		Callback = function() geo = nil wDirty = true updateWeather() end })
	wb:CreateButton({ Name = "Actualiser la météo", Favorite = false, Callback = function() geo = nil updateWeather() end })
	task.delay(3, updateWeather)

	-- ----- serveur
	local srv = subInfo:CreateBlock({ Name = "Serveur", Side = "Right" })
	local exName = "Inconnu"
	pcall(function()
		local n, v = identifyexecutor()
		exName = tostring(n) .. (v and (" " .. tostring(v)) or "")
	end)
	local jid = tostring(game.JobId)
	local sv = srv:CreateStats({ Columns = 1, CellHeight = 44, Items = {
		{ Id = "place", Name = "Jeu", Value = "…" },
		{ Id = "placeid", Name = "Place ID", Value = tostring(game.PlaceId) },
		{ Id = "job", Name = "Job ID", Value = (jid ~= "" and (string.sub(jid, 1, 8) .. "…") or "Studio / local") },
		{ Id = "exec", Name = "Exécuteur", Value = exName },
		{ Id = "ui", Name = "Version de l'UI", Value = "v" .. tostring(Library.Version) },
	} })
	task.spawn(function()
		local ok, info = pcall(function() return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId) end)
		if ok and type(info) == "table" and info.Name then sv:Set("place", info.Name) end
	end)

	-- ----- mises à jour (depuis GitHub)
	if Library.UpdateURL and Library.UpdateURL ~= "" then
		local up = subUpdates:CreateBlock({ Name = "Mises à jour", Side = "Left" })
		local us = up:CreateStats({ Columns = 1, CellHeight = 44, Items = {
			{ Id = "cur", Name = "Version chargée", Value = "v" .. tostring(Library.Version) },
			{ Id = "rem", Name = "Dernier commit GitHub", Value = "…" },
			{ Id = "last", Name = "Dernière vérification", Value = "—" },
		} })
		Library._updRefresh = function()
			local st = Library.UpdateStatus
			pcall(function()
				us:Set("cur", "v" .. tostring(Library.Version) .. (st.Loaded and ("  ·  #" .. st.Loaded) or ""))
				if st.Error then us:Set("rem", st.Error, Color3.fromRGB(255, 120, 120))
				elseif st.Remote then
					us:Set("rem", "#" .. st.Remote .. (st.Available and "  (nouvelle !)" or "  (à jour)"),
						st.Available and Color3.fromRGB(120, 255, 160) or nil)
				end
				if st.Last then us:Set("last", os.date("%H:%M:%S", st.Last)) end
			end)
		end
		up:CreateToggle({ Name = "Vérifier automatiquement", Favorite = false, Keybind = false,
			Default = Library.AutoUpdateCheck ~= false, Callback = function(v) Library.AutoUpdateCheck = v end })
		up:CreateButton({ Name = "Vérifier maintenant", Favorite = false, Callback = function()
			task.spawn(function()
				local ok = Library:CheckUpdate(true)
				local st = Library.UpdateStatus
				Library:Notify({ Title = "Mises à jour", Duration = 3, Type = ok and (st.Available and "Info" or "Success") or "Error",
					Content = ok and (st.Available and ("Version v" .. tostring(st.Remote) .. " disponible : voir les nouveautés ci-dessous.") or "Tu as déjà la dernière version.") or tostring(st.Error) })
			end)
		end })
		up:CreateButton({ Name = "Recharger maintenant", Favorite = false, Callback = function()
			if Library.OnReload then
				task.spawn(function()
					local u = Library.UpdateURL
					local src = homeHttpGet(u .. (u:find("?", 1, true) and "&" or "?") .. "t=" .. os.time())
					pcall(Library.OnReload, src or u)
				end)
			else
				Library:Notify({ Title = "Mises à jour", Type = "Info", Duration = 4,
					Content = "Relance simplement ton script : il rechargera la dernière version depuis GitHub." })
			end
		end })
		Library._updRefresh()
	else
		local up = subUpdates:CreateBlock({ Name = "Mises à jour", Side = "Left" })
		up:CreateParagraph({ Title = "Version v" .. tostring(Library.Version),
			Content = "Les mises à jour automatiques sont désactivées. Pour les activer, donne le lien raw GitHub de ton script : CreateWindow({ UpdateURL = \"TON_LIEN_RAW\" }). L'UI lira alors toute seule les commits et les affichera ici." })
	end

	-- ----- Explication : présentation de l'UI + démos en direct
	do
		local oke, erre = pcall(Library._buildHomeExplain, Library, subExplain)
		if not oke then warn("[Ui-Lib] Home > Explication : " .. tostring(erre)) end
	end

	-- ----- nouveautés (automatiques, dans « Mises à jour »)
	Library:_buildChangelog(tab)

	-- ===================== BOUCLE DE MISE À JOUR (2 fois par seconde) =====================
	local lastFlag, lastWeather = os.clock(), os.clock()
	local pingItem
	pcall(function() pingItem = Stats.Network.ServerStatsItem["Data Ping"] end)
	track(Ticker.connect(function(_, now)
		local fps = math.floor(Ticker.Fps + 0.5)
		local ping = 0
		if pingItem then
			local ok, v = pcall(function() return pingItem:GetValue() end)
			if ok and v then ping = math.floor(v + 0.5) end
		end
		-- l'historique et la session avancent même quand Home est caché
		gFps:Push(fps)
		gPing:Push(ping)
		local elapsed = now - started
		local limit = limitSec()
		if limit ~= lastLimit then
			lastLimit = limit
			nextAlert = (math.floor(elapsed / limit) + 1) * limit
			gauge:SetMax(limit)
		end
		if elapsed >= nextAlert then
			nextAlert = (math.floor(elapsed / limit) + 1) * limit
			if Library.Flags["ui.home.limitalert"] ~= false then
				Library:Notify({ Title = "Session longue", Content = "Tu joues depuis " .. fmtDur(elapsed) .. ". Pense à faire une pause !",
					Type = "Warning", Duration = 7 })
			end
		end
		if now - lastFlag >= 60 then   -- temps de jeu total : écrit dans les réglages toutes les minutes
			lastFlag = now
			Library.Flags["ui.home.playtime"] = math.floor(totalNow())
		end
		if now - lastWeather >= 900 then
			lastWeather = now
			updateWeather()
		end
		if not shown() then return end

		st:SetNumber("fps", fps, nil, fpsColor(fps))
		st:SetNumber("ping", ping, function(x) return math.floor(x + 0.5) .. " ms" end, pingColor(ping))
		st:Set("players", #Players:GetPlayers() .. " / " .. tostring(Players.MaxPlayers))
		local okm, mem = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
		if okm and mem then st:SetNumber("mem", mem, function(x) return math.floor(x + 0.5) .. " MB" end) else st:Set("mem", "—") end
		st:Set("session", fmtDur(elapsed))
		st:Set("uptime", fmtDur(workspace.DistributedGameTime))
		gFps:Flush()
		gPing:Flush()

		local ratio = elapsed / limit
		gauge:Set(math.min(elapsed, limit))
		gauge:SetColor(ratio >= 1 and HOME_BAD or (ratio >= 0.75 and HOME_MID or T.Accent))
		sst:Set("total", fmtDur(totalNow()))
		sst:Set("left", elapsed >= limit and "Limite dépassée" or fmtDur(limit - elapsed), elapsed >= limit and HOME_BAD or nil)

		local t = os.date("*t")
		wst:Set("time", string.format("%02d:%02d:%02d", t.hour, t.min, t.sec))
		wst:Set("date", string.format("%s %d %s %d", DAYS[t.wday] or "", t.day, MONTHS[t.month] or "", t.year))
		if wDirty then applyWeather() end

		if friendsDirty and friendLoaded then rebuildFriends() end
		if friendLoaded and not friendBusy and now - friendAt > 90 then refreshFriends() end
	end, { rate = 2 }))
	return tab
end
end -- fin de la portée réduite

-- sous-titre affiché dans l'en-tête du type d'interface « Éclipse »
function Tab:SetSubtitle(text)
	self.Subtitle = text ~= nil and tostring(text) or nil
	local w = self.Win
	if w and w.Current == self and w._ecPage then w._ecPage(self) end
end

function Tab:ClearBlocks()
	for _, b in ipairs(self.Blocks) do
		if b._float and Library.AttachBlock then Library:AttachBlock(b) end
		if b.Frame then b.Frame:Destroy() end
	end
	self.Blocks = {}
	self.DefaultBlock = nil
	self.Order = 0
end
-- tous les blocs de l'onglet, sous-onglets compris (recherche, tout replier...)
function Tab:_allBlocks()
	local out = {}
	for _, b in ipairs(self.Blocks) do out[#out + 1] = b end
	for _, s in ipairs(self.SubTabs or {}) do
		for _, b in ipairs(s.Blocks) do out[#out + 1] = b end
	end
	return out
end
-- replie / déplie une liste de blocs en cascade (petit décalage entre chaque bloc, ordre d'affichage)
function Library:_cascadeCollapse(blocks, c)
	local list = {}
	for _, b in ipairs(blocks) do list[#list + 1] = b end
	table.sort(list, function(a, b)
		local fa, fb = a.Frame, b.Frame
		local ya = (fa and fa.Parent) and fa.AbsolutePosition.Y or 0
		local yb = (fb and fb.Parent) and fb.AbsolutePosition.Y or 0
		if ya ~= yb then return ya < yb end
		return (a.Index or 0) < (b.Index or 0)
	end)
	Library._cascadeGen = (Library._cascadeGen or 0) + 1
	local gen = Library._cascadeGen
	local step = math.min(0.05, 0.4 / math.max(#list, 1)) / math.max(Library.AnimSpeed or 1, 0.05)
	for i, b in ipairs(list) do
		if not Library.Animations or i == 1 then
			b:SetCollapsed(c)
		else
			task.delay((i - 1) * step, function()
				if Library._cascadeGen == gen then b:SetCollapsed(c) end
			end)
		end
	end
end
function Tab:CollapseAll(c)
	Library:_cascadeCollapse(self:_allBlocks(), c ~= false)
end
function Tab:ExpandAll() self:CollapseAll(false) end

-- ============================================================================
-- ONGLETS & BLOCS
-- ============================================================================
-- Colonne (1..n) d'un bloc : 2 colonnes = Side Left/Right comme avant, 3-4 colonnes = répartition à tour de rôle
function Tab:_columnFor(idx, side, n)
	n = n or self.NumCols or 1
	if n <= 1 then return 1 end
	if n == 2 then return side == "right" and 2 or 1 end
	return ((idx - 1) % n) + 1
end


-- ---------------------------------------------------------------------------
-- DISPOSITION DES BLOCS : où va chaque bloc, selon la disposition sauvegardée
-- ---------------------------------------------------------------------------
function Tab:_savedFor(n)
	local t = Library.BlockLayout[tostring(self.Name)]
	local s = type(t) == "table" and t[tostring(n)]
	if type(s) == "table" and next(s) then return s end
	return nil
end

-- renvoie (colonne, LayoutOrder) d'un bloc pour n colonnes
function Tab:_placeOf(b, n)
	n = n or self.NumCols
	local s = self:_savedFor(n)
	if s then
		local e = s[b.Key]
		if type(e) == "table" and tonumber(e.c) and tonumber(e.o) then
			return math.clamp(math.floor(e.c), 1, n), math.floor(e.o)
		end
		return self:_columnFor(b.Index, b.Side, n), 100000 + b.DefOrder   -- bloc jamais déplacé : en bas
	end
	return self:_columnFor(b.Index, b.Side, n), b.DefOrder
end

function Tab:_reapplyLayout()
	local n = self.NumCols
	if n < 1 then return end
	for _, b in ipairs(self.Blocks) do
		local ci, o = self:_placeOf(b, n)
		local col = self.Cols[ci]
		if col and not b._float then
			if b.Frame.Parent ~= col then b.Frame.Parent = col end
			b.Frame.LayoutOrder = o
			b.Scroll = col
		end
	end
end

-- écrit la disposition actuelle de l'onglet (pour le nombre de colonnes affiché)
function Tab:_commitLayout()
	local n = self.NumCols
	local L = Library.BlockLayout
	local tk, ns = tostring(self.Name), tostring(n)
	if type(L[tk]) ~= "table" then L[tk] = {} end
	if type(L[tk][ns]) ~= "table" then L[tk][ns] = {} end
	local store = L[tk][ns]
	for ci, col in ipairs(self.Cols) do
		local list = {}
		for _, b in ipairs(self.Blocks) do
			if b.Frame.Parent == col then list[#list + 1] = b end
		end
		table.sort(list, function(a, c)
			if a.Frame.LayoutOrder ~= c.Frame.LayoutOrder then return a.Frame.LayoutOrder < c.Frame.LayoutOrder end
			return a.Index < c.Index
		end)
		for j, b in ipairs(list) do
			b.Frame.LayoutOrder = j
			b.Scroll = col
			store[b.Key] = { c = ci, o = j }
		end
	end
end

function Library:_reapplyLayouts()
	local w = Library.Window
	if not (w and w.Tabs) then return end
	for _, t in ipairs(w.Tabs) do
		t:_reapplyLayout()
		for _, s in ipairs(t.SubTabs or {}) do s:_reapplyLayout() end
	end
end

-- appelé par la restauration des réglages (clé « ui.blocklayout »)
function Library:_setBlockLayout(d)
	local L = Library.BlockLayout
	for k in pairs(L) do L[k] = nil end
	if type(d) == "table" then
		for tk, tv in pairs(d) do
			if type(tk) == "string" and type(tv) == "table" then L[tk] = copyVal(tv) end
		end
	end
	Library:_reapplyLayouts()
end

function Library:ResetBlockLayout(tabName)
	local L = Library.BlockLayout
	if tabName == nil then
		for k in pairs(L) do L[k] = nil end
	else
		L[tostring(tabName)] = nil
	end
	Library:_reapplyLayouts()
end

function Library:SetLayoutEdit(v)
	v = v and true or false
	Library.LayoutEdit = v
	local w = Library.Window
	if not (w and w.Tabs) then return end
	for _, t in ipairs(w.Tabs) do
		for _, b in ipairs(t:_allBlocks()) do
			if b._setEdit then b._setEdit(v) end
		end
	end
end

-- Glisser un bloc par son en-tête : un emplacement suit le curseur, le bloc « fantôme » est le curseur.
-- Les autres blocs s'écartent en glissant : l'emplacement visé GRANDIT de 0 à la hauteur du bloc, l'ancien se REFERME,
-- et le trou laissé par le bloc soulevé se referme aussi. Les LayoutOrder sont pairs (2, 4, 6...) pendant le geste,
-- les emplacements prennent les impairs : un emplacement qui se referme ne change donc jamais de place.
function Library:_dragBlock(blk, startPos)
	local win, tab = Library.Window, blk.Tab
	if not (win and win.Gui) or Library._blockDragging then return end
	Library._blockDragging = true

	local sc = pxScale()
	local frame = blk.Frame
	local fAbs, fSize = frame.AbsolutePosition, frame.AbsoluteSize
	local gx = math.clamp(startPos.X - fAbs.X, 12, math.max(12, fSize.X - 12))
	local headH = 34 * sc
	local slotH = math.max(fSize.Y / math.max(sc, 0.05), 34)   -- hauteur du bloc, en unités d'UI : celle de l'emplacement

	local last = startPos
	local moved = false
	local ghost, placeholder, hb, originGap
	local curCol, curAt
	local dying = {}
	local SLIDE = 0.26

	local function makeSlot(parent, order, h, transp)
		local f = new("Frame", { Name = "BlockPlaceholder", Size = UDim2.new(1, 0, 0, h), LayoutOrder = order,
			BackgroundColor3 = T.Accent, BackgroundTransparency = transp, BorderSizePixel = 0 }, parent)
		new("UICorner", { CornerRadius = UDim.new(0, 10) }, f)
		new("UIStroke", { Color = T.Accent, Transparency = (transp >= 1) and 1 or 0.45, Thickness = 1.5, ApplyStrokeMode = BORDER }, f)
		return f
	end
	local function growSlot(f)
		tween(f, { Size = UDim2.new(1, 0, 0, slotH), BackgroundTransparency = 0.9 }, SLIDE, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut)
		local st = f:FindFirstChildOfClass("UIStroke")
		if st then tween(st, { Transparency = 0.45 }, SLIDE) end
	end
	local function shrinkSlot(f)
		if not f then return end
		dying[f] = true
		tween(f, { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 }, 0.22, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut)
		local st = f:FindFirstChildOfClass("UIStroke")
		if st then tween(st, { Transparency = 1 }, 0.18) end
		task.delay(0.4, function()
			dying[f] = nil
			if f.Parent then f:Destroy() end
		end)
	end

	-- ordres pairs et stables dans chaque colonne (l'ordre visible ne change pas)
	local function normalise()
		for _, col in ipairs(tab.Cols) do
			local list = {}
			for _, b in ipairs(tab.Blocks) do
				if b.Frame.Parent == col then list[#list + 1] = b end
			end
			table.sort(list, function(x, y)
				if x.Frame.LayoutOrder ~= y.Frame.LayoutOrder then return x.Frame.LayoutOrder < y.Frame.LayoutOrder end
				return x.Index < y.Index
			end)
			for j, b in ipairs(list) do b.Frame.LayoutOrder = j * 2 end
		end
	end

	local function create()
		moved = true
		normalise()
		-- le bloc soulevé laisse un trou de sa hauteur, qui se referme doucement
		originGap = makeSlot(frame.Parent, frame.LayoutOrder, slotH, 1)
		ghost = new("Frame", { Name = "BlockGhost", Size = UDim2.fromOffset(fSize.X, headH), ZIndex = 500,
			BackgroundColor3 = T.Second, BackgroundTransparency = 0.12, BorderSizePixel = 0 }, win.Gui)
		new("UICorner", { CornerRadius = UDim.new(0, math.floor(10 * sc)) }, ghost)
		new("UIStroke", { Color = T.Accent, Transparency = 0.2, Thickness = 1.5, ApplyStrokeMode = BORDER }, ghost)
		local lb = label(ghost, blk.Name, 13, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0),
			Font = F_BOLD, ZIndex = 501 })
		lb.TextSize = math.max(9, math.floor(13 * sc * (Library.FontScale or 1) + 0.5))
		frame.Visible = false
		shrinkSlot(originGap)
		uiSnd("fold")
	end

	local function step()
		Library._busyUntil = os.clock() + 0.3
		if not moved then
			if (last - startPos).Magnitude > 5 then create() else return end
		end
		local cur = Library._pointerPos(last)
		ghost.Position = UDim2.fromOffset(cur.X - gx, cur.Y - headH / 2)

		-- colonne visée : la plus proche horizontalement
		local best, bd = 1, nil
		for i, col in ipairs(tab.Cols) do
			local ap, as = col.AbsolutePosition, col.AbsoluteSize
			local d = 0
			if cur.X < ap.X then d = ap.X - cur.X elseif cur.X > ap.X + as.X then d = cur.X - ap.X - as.X end
			if not bd or d < bd then best, bd = i, d end
		end
		local col = tab.Cols[best]

		-- défilement automatique près des bords
		local ap, as = col.AbsolutePosition, col.AbsoluteSize
		local edge = 46
		if cur.Y < ap.Y + edge then
			col.CanvasPosition = Vector2.new(0, math.max(0, col.CanvasPosition.Y - 14))
		elseif cur.Y > ap.Y + as.Y - edge then
			col.CanvasPosition = Vector2.new(0, col.CanvasPosition.Y + 14)
		end

		-- position d'insertion parmi les blocs visibles de la colonne
		local sibs = {}
		for _, b in ipairs(tab.Blocks) do
			if b ~= blk and b.Frame.Parent == col and b.Frame.Visible then sibs[#sibs + 1] = b end
		end
		table.sort(sibs, function(x, y)
			if x.Frame.LayoutOrder ~= y.Frame.LayoutOrder then return x.Frame.LayoutOrder < y.Frame.LayoutOrder end
			return x.Index < y.Index
		end)
		local at = #sibs + 1
		for k, b in ipairs(sibs) do
			local f = b.Frame
			if cur.Y < f.AbsolutePosition.Y + f.AbsoluteSize.Y / 2 then at = k break end
		end
		if col ~= curCol or at ~= curAt then
			curCol, curAt = col, at
			if placeholder then shrinkSlot(placeholder) end   -- l'ancien emplacement se referme...
			local ord
			if #sibs == 0 then ord = 1
			elseif at <= #sibs then ord = sibs[at].Frame.LayoutOrder - 1
			else ord = sibs[#sibs].Frame.LayoutOrder + 1 end
			placeholder = makeSlot(col, ord, 0, 1)           -- ...et le nouveau s'ouvre : les blocs voisins glissent
			growSlot(placeholder)
		end
	end

	hb = Ticker.connect(step)

	startDrag(function(p) last = p end, blk.Scroll, startPos, function()
		if hb then hb:Disconnect() hb = nil end
		Library._blockDragging = false
		if not moved then return end
		local pp, ps = ghost.Position, Vector2.new(fSize.X, headH)
		if placeholder then
			pp = placeholder.AbsolutePosition
			ps = Vector2.new(placeholder.AbsoluteSize.X, slotH * sc)
		end
		if curCol and placeholder then
			frame.Parent = curCol
			frame.LayoutOrder = placeholder.LayoutOrder
			blk.Scroll = curCol
		end
		frame.Visible = true
		for f in pairs(dying) do if f.Parent then f:Destroy() end end
		table.clear(dying)
		if placeholder then placeholder:Destroy() end
		if originGap and originGap.Parent then originGap:Destroy() end
		tab:_commitLayout()
		-- le fantôme glisse vers l'emplacement puis disparaît
		tween(ghost, { Position = UDim2.fromOffset(pp.X, pp.Y), Size = UDim2.fromOffset(ps.X, ps.Y),
			BackgroundTransparency = 1 }, 0.2)
		for _, d in ipairs(ghost:GetDescendants()) do
			if d:IsA("TextLabel") then tween(d, { TextTransparency = 1 }, 0.18) end
			if d:IsA("UIStroke") then tween(d, { Transparency = 1 }, 0.18) end
		end
		local g = ghost
		task.delay(0.25, function() g:Destroy() end)
	end)
end

function Tab:_layoutColumns()
	local n, gap = self.NumCols, 10
	for i, c in ipairs(self.Cols) do
		c.Position = UDim2.new((i - 1) / n, (i - 1) * gap / n, 0, 0)
		c.Size = UDim2.new(1 / n, -gap * (n - 1) / n, 1, 0)
	end
end

-- ---------------------------------------------------------------------------
-- GLISSEMENT DES BLOCS AU CHANGEMENT DE COLONNES
-- Avant le changement : on photographie (Clone) chaque bloc visible + sa position. Après : les vraies colonnes sont masquées
-- quelques instants, et les copies glissent de l'ancienne place vers la nouvelle. La cible est relue à CHAQUE image (le layout
-- continue de se calculer même masqué), donc la copie suit aussi l'agrandissement de la fenêtre.
-- ---------------------------------------------------------------------------
function Library._guiShown(g)
	while g and g ~= game do
		if g:IsA("GuiObject") and not g.Visible then return false end
		if g:IsA("ScreenGui") and not g.Enabled then return false end
		g = g.Parent
	end
	return g == game
end

function Library._endGlide()
	local g = Library._glide
	if not g then return end
	Library._glide = nil
	Library._glideOn = false
	if g.conn then g.conn:Disconnect() end
	if g.overlay then g.overlay:Destroy() end
	for _, col in ipairs(g.cols or {}) do
		if col.Parent then col.Visible = true end
	end
end

function Library._snapBlocks(tab)
	local win = Library.Window
	if not (Library.Animations and win and win.Gui and win.Gui.Parent and win.Open and win.Content) then return nil end
	local snap = {}
	for _, b in ipairs(tab.Blocks) do
		local f = b.Frame
		if #snap >= 40 then break end
		if not b._float and f and f.Parent and Library._guiShown(f) and f.AbsoluteSize.X > 4 and f.AbsoluteSize.Y > 4 then
			local ok, c = pcall(function() return f:Clone() end)
			if ok and c then snap[#snap + 1] = { blk = b, clone = c, pos = f.AbsolutePosition, size = f.AbsoluteSize } end
		end
	end
	if #snap == 0 then return nil end
	Library._endGlide()   -- un glissement précédent encore en cours : on le termine proprement
	return snap
end

function Library._glideBlocks(tab, snap)
	local win = Library.Window
	if not snap then return end
	local content = win.Content
	local sc = math.max(pxScale(), 0.05)
	local overlay = new("Frame", { Name = "ColumnGlide", BackgroundTransparency = 1, BorderSizePixel = 0,
		ClipsDescendants = true, ZIndex = 400, Active = false }, win.Gui)
	local used = {}
	for _, s in ipairs(snap) do
		local h = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 400 }, overlay)
		new("UIScale", { Scale = sc }, h)
		local c = s.clone
		c.AutomaticSize = AN
		c.Size = UDim2.fromScale(1, 1)
		c.Position = UDim2.new()
		c.Parent = h
		s.holder = h
		used[#used + 1] = s
	end
	local cols = {}
	for _, col in ipairs(tab.Cols) do cols[#cols + 1] = col col.Visible = false end

	local g = { overlay = overlay, cols = cols }
	Library._glide = g
	Library._glideOn = true
	Library._busyUntil = os.clock() + 0.7
	local t0 = os.clock()
	local dur = 0.46 / math.max(Library.AnimSpeed or 1, 0.05)
	g.conn = Ticker.connect(function()
		if Library._glide ~= g then return end
		local ok = pcall(function()
			local cp, cs = content.AbsolutePosition, content.AbsoluteSize
			overlay.Position = UDim2.fromOffset(cp.X, cp.Y)
			overlay.Size = UDim2.fromOffset(cs.X, cs.Y)
			local a = math.clamp((os.clock() - t0) / dur, 0, 1)
			local e = TweenService:GetValue(a, QUINT, OUT)
			for _, s in ipairs(used) do
				local f = s.blk.Frame
				local np, ns = f.AbsolutePosition, f.AbsoluteSize
				local x = s.pos.X + (np.X - s.pos.X) * e
				local y = s.pos.Y + (np.Y - s.pos.Y) * e
				local w = s.size.X + (ns.X - s.size.X) * e
				local h = s.size.Y + (ns.Y - s.size.Y) * e
				s.holder.Position = UDim2.fromOffset(x - cp.X, y - cp.Y)
				s.holder.Size = UDim2.fromOffset(math.max(w, 1) / sc, math.max(h, 1) / sc)
			end
			Library._busyUntil = os.clock() + 0.3
			if a >= 1 then Library._endGlide() end
		end)
		if not ok then Library._endGlide() end
	end)
end

-- Change le nombre de colonnes (1 à 4) et replace tous les blocs déjà créés
function Tab:SetColumns(n)
	n = math.clamp(math.floor(tonumber(n) or 1), 1, 4)
	for _, s in ipairs(self.SubTabs or {}) do s:SetColumns(n) end   -- les sous-onglets suivent
	if n == self.NumCols then return end
	local snap = Library._snapBlocks(self)   -- photo des blocs avant le changement (voir plus haut)
	self.NumCols = n
	self.TwoCols = n >= 2
	while #self.Cols < n do self.Cols[#self.Cols + 1] = self._newColumn() end
	for _, b in ipairs(self.Blocks) do
		local ci, o = self:_placeOf(b, n)
		local col = self.Cols[ci]
		if not b._float then
			if b.Frame.Parent ~= col then b.Frame.Parent = col end
			b.Frame.LayoutOrder = o
			b.Scroll = col
		end
	end
	while #self.Cols > n do table.remove(self.Cols):Destroy() end
	self:_layoutColumns()
	self.ColL, self.ColR = self.Cols[1], self.Cols[math.min(2, n)]
	if snap then Library._glideBlocks(self, snap) end
end

-- ───────────── Type « Carré » : colonnes plus aérées + bloc dont le titre est posé sur la bordure ─────────────
function Library._sqApplyCol(sf)
	if not (sf and sf.Parent) then return end
	local lay = sf:FindFirstChildOfClass("UIListLayout")
	local pad = sf:FindFirstChildOfClass("UIPadding")
	local on = Library.SquareMode and Library.Square.TitleOnBorder ~= false
	if lay then lay.Padding = UDim.new(0, on and 16 or 8) end
	if pad then pad.PaddingTop = UDim.new(0, on and 10 or 2) end
end

function Library._sqApplyBlock(blk)
	local sq = blk and blk._sq
	if not (sq and sq.head and sq.head.Parent) then return end
	local on = Library.SquareMode and Library.Square.TitleOnBorder ~= false
	local nameLbl, arrow = sq.name, sq.arrow
	local pad = nameLbl:FindFirstChild("SqPad")
	local pop = sq.head:FindFirstChild("Detach")
	if on then
		sq.head.Size = UDim2.new(1, 0, 0, 14)
		nameLbl.AnchorPoint = Vector2.new(0, 0.5)
		nameLbl.Position = UDim2.new(0, 8, 0, 0)
		nameLbl.AutomaticSize = Enum.AutomaticSize.X
		nameLbl.Size = UDim2.new(0, 0, 0, 14)
		nameLbl.TextTruncate = Enum.TextTruncate.None
		nameLbl.BackgroundColor3 = T.Main
		nameLbl.BackgroundTransparency = 0
		nameLbl.ZIndex = 3
		if not pad then
			new("UIPadding", { Name = "SqPad", PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, nameLbl)
		end
		arrow.AnchorPoint = Vector2.new(1, 0.5)
		arrow.Position = UDim2.new(1, -8, 0, 0)
		arrow.Size = UDim2.new(0, 16, 0, 14)
		arrow.BackgroundColor3 = T.Main
		arrow.BackgroundTransparency = 0
		arrow.ZIndex = 3
		if pop then pop.Visible = false end
		if sq.line then sq.line.Visible = false end
	else
		sq.head.Size = UDim2.new(1, 0, 0, 34)
		nameLbl.AnchorPoint = Vector2.new(0, 0.5)
		nameLbl.Position = UDim2.new(0, sq.x, 0.5, 0)
		nameLbl.AutomaticSize = Enum.AutomaticSize.None
		nameLbl.Size = UDim2.new(1, -sq.x - 58, 1, 0)
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
		nameLbl.BackgroundTransparency = 1
		nameLbl.ZIndex = 1
		if pad then pad:Destroy() end
		arrow.AnchorPoint = Vector2.new(0.5, 0.5)
		arrow.Position = UDim2.new(1, -20, 0.5, 0)
		arrow.Size = UDim2.new(0, 16, 1, 0)
		arrow.BackgroundTransparency = 1
		arrow.ZIndex = 1
		if pop then pop.Visible = true end
		if sq.line then sq.line.Visible = true end
	end
end

-- réapplique le type Carré (colonnes + blocs) à tous les onglets de la fenêtre
function Library._sqRefreshAll(win)
	if not (win and win.Tabs) then return end
	local function doTab(t)
		for _, sf in ipairs(t.Cols or {}) do Library._sqApplyCol(sf) end
		for _, b in ipairs(t:_allBlocks()) do Library._sqApplyBlock(b) end
		for _, st in ipairs(t.SubTabs or {}) do
			for _, sf in ipairs(st.Cols or {}) do Library._sqApplyCol(sf) end
		end
	end
	for _, t in ipairs(win.Tabs) do pcall(doTab, t) end
end

-- Library:SetSquareOption("Mono" | "TitleOnBorder", vrai/faux)
function Library:SetSquareOption(k, v)
	local o = Library.Square
	if type(k) ~= "string" or o[k] == nil then return false end
	o[k] = v and true or false
	if k == "Mono" then Library:SetFont(Library.FontFamily or "Gotham") end
	local w = Library.Window
	if w then
		Library._sqRefreshAll(w)
		if w.RefreshLayoutStyle then w:RefreshLayoutStyle() end
		if w.ApplyTitle then w:ApplyTitle() end
	end
	return true
end

function Tab:CreateBlock(o)
	o = o or {}
	local side = tostring(o.Side):lower() == "right" and "right" or "left"
	local idx = #self.Blocks + 1
	self.Order = (self.Order or 0) + 1
	-- clé stable du bloc (nom ; « #2 » si deux blocs portent le même nom dans l'onglet)
	local bkey = tostring(o.Name or "Block")
	do
		local used = {}
		for _, b in ipairs(self.Blocks) do used[b.Key] = true end
		local base, k = bkey, 1
		while used[bkey] do k += 1 bkey = base .. "#" .. k end
	end
	local defOrder = self.Order
	local colIdx, layoutOrder = self:_placeOf({ Key = bkey, Index = idx, Side = side, DefOrder = defOrder })
	local col = self.Cols[colIdx]

	local frame = new("Frame", {
		Name = "BlockBackground", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY,
		BackgroundColor3 = T.Second, BackgroundTransparency = 0.35, BorderSizePixel = 0, LayoutOrder = layoutOrder,
	}, col)
	corner(frame, 10)
	trackStyled(frame, stroke(frame, 0.9), "block")
	new("UIListLayout", { SortOrder = BYORDER }, frame)

	local head = new("TextButton", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, LayoutOrder = 1 }, frame)
	local x = 12
	if o.ImageID and o.ImageID ~= "" then
		new("ImageLabel", { BackgroundTransparency = 1, Image = o.ImageID, ImageColor3 = T.Text,
			Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 12, 0.5, -8) }, head)
		x = 34
	end
	local nameLbl = label(head, o.Name or "Block", 13, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, x, 0.5, 0),
		Size = UDim2.new(1, -x - 58, 1, 0), Font = F_BOLD })
	local arrow = label(head, ">", 13, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -20, 0.5, 0),
		Size = UDim2.new(0, 16, 1, 0), TextXAlignment = CENTER, Font = F_BOLD, TextColor3 = T.ElementAccent, Rotation = 90 })

	new("UICorner", { CornerRadius = UDim.new(0, 10) }, head)
	head.BackgroundColor3 = T.Accent
	local function hoverFx(on)
		if Library.LayoutEdit then on = false end
		tween(head, { BackgroundTransparency = on and 0.9 or 1 }, 0.2)
		tween(nameLbl, { TextColor3 = on and T.Text or T.Text }, 0.2)
		tween(arrow, { TextColor3 = on and T.Text or T.ElementAccent }, 0.2)
	end
	head.MouseEnter:Connect(function() hoverFx(true) end)
	head.MouseLeave:Connect(function() hoverFx(false) end)
	local headLine = fadeLine(head, { Position = UDim2.new(0, 10, 1, -1), Size = UDim2.new(1, -20, 0, 1) })

	-- Corps repliable (animé)
	local clip = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
		ClipsDescendants = true, LayoutOrder = 2, BorderSizePixel = 0 }, frame)
	local body = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1 }, clip)
	local lay = new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = BYORDER }, body)
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }, body)

	local flagKey = "__block:" .. tostring(self.Name or "Tab") .. "/" .. tostring(o.Name or "Block")
	local collapsed = false
	local foldGen, foldConn = 0, nil   -- jeton + animation en cours : évite les animations qui se battent quand on spamme
	-- hauteur réelle du corps (même valeur que celle que prendra clip en AutomaticSize) : plus d'écart d'un pixel à la fin
	local function contentH() return body.AbsoluteSize.Y / math.max(pxScale(), 0.05) end
	-- hauteur arrondie au pixel écran (évite un reste fractionnaire qui « saute » à la fin de l'animation)
	local function snapH(h)
		local sc = math.max(pxScale(), 0.05)
		return math.max(math.floor(h * sc + 0.5) / sc, 0)
	end
	local function stopFold() if foldConn then foldConn:Disconnect() foldConn = nil end end
	local function setCollapsed(c)
		if c == collapsed then return end
		collapsed = c
		foldGen += 1
		Library.Flags[flagKey] = c
		tween(arrow, { Rotation = c and 0 or 90 }, 0.3)
		Library._busyUntil = os.clock() + 0.45
		stopFold()
		-- on part de la hauteur RÉELLEMENT affichée ; la cible est relue à chaque image (le texte à retour à la ligne,
		-- les tiroirs, etc. changent de hauteur) : plus d'arrêt à mi-course suivi d'un saut à la fin.
		local startH = clip.AbsoluteSize.Y / math.max(pxScale(), 0.05)
		clip.Visible = true
		clip.AutomaticSize = AN
		clip.Size = UDim2.new(1, 0, 0, snapH(startH))
		local dur = Library.Animations and (0.36 / math.max(Library.AnimSpeed or 1, 0.05)) or 0
		local function finish()
			stopFold()
			if c then
				clip.Size = UDim2.new(1, 0, 0, 0)
				clip.Visible = false   -- replié : plus rien d'affiché (un cadre de hauteur 0 laissait parfois dépasser 1 px)
			else
				clip.AutomaticSize = AY
				clip.Size = UDim2.new(1, 0, 0, 0)
			end
		end
		if dur <= 0 then finish() return end
		local t0 = os.clock()
		local gen = foldGen
		foldConn = Ticker.connect(function()
			if gen ~= foldGen or not clip.Parent then stopFold() return end
			local a = math.clamp((os.clock() - t0) / dur, 0, 1)
			-- Cubic InOut : Quint OUT traînait sur le dernier pixel (1 px visible pendant ~0.1 s puis disparition brusque)
			local e = TweenService:GetValue(a, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut)
			local goal = c and 0 or contentH()
			if a >= 1 then
				-- dernière image : valeur EXACTE (sans arrondi) = celle qu'AutomaticSize prendra juste après -> aucun saut
				clip.Size = UDim2.new(1, 0, 0, goal)
				finish()
			else
				clip.Size = UDim2.new(1, 0, 0, snapH(startH + (goal - startH) * e))
			end
		end)
	end
	head.MouseButton1Click:Connect(function()
		if Library.LayoutEdit then return end   -- en mode édition l'en-tête sert à déplacer le bloc
		uiSnd("fold") setCollapsed(not collapsed)
	end)
	if o.Collapsed then
		collapsed = true
		clip.AutomaticSize = AN
		clip.Size = UDim2.new(1, 0, 0, 0)
		clip.Visible = false
		arrow.Rotation = 0
	end

	local blk = setmetatable({
		Frame = frame, Body = body, Scroll = col, Tab = self, Name = o.Name or "Block", Side = side, Index = idx,
		Key = bkey, DefOrder = defOrder,
		Entries = {}, _collapse = setCollapsed, _isCollapsed = function() return collapsed end,
	}, Block)
	self.Blocks[#self.Blocks + 1] = blk
	Library.Flags[flagKey] = collapsed
	Library.Items[flagKey] = {
		Get = function() return collapsed end,
		Set = function(_, v) setCollapsed(v and true or false) end,
	}

	-- Mode édition de la disposition : poignée ⠿ à la place de la flèche + en-tête surligné, glisser pour déplacer
	do
		local overlay = new("Frame", { Name = "EditOverlay", Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6),
			BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 0 }, head)
		new("UICorner", { CornerRadius = UDim.new(0, 8) }, overlay)
		local grip = new("Frame", { Name = "Grip", BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16),
			Position = UDim2.new(1, -28, 0.5, -8), Visible = false }, head)
		for cx = 0, 1 do
			for ry = 0, 2 do
				local dot = new("Frame", { Size = UDim2.fromOffset(3, 3), Position = UDim2.fromOffset(3 + cx * 7, 2 + ry * 5),
					BackgroundColor3 = T.Text, BorderSizePixel = 0 }, grip)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
			end
		end
		blk._setEdit = function(on)
			overlay.BackgroundColor3 = T.Accent
			overlay.Visible = true
			tween(overlay, { BackgroundTransparency = on and 0.9 or 1 }, 0.25)
			task.delay(on and 0 or 0.26, function() if Library.LayoutEdit == on then overlay.Visible = on end end)
			grip.Visible = on
			arrow.Visible = not on
		end
		head.InputBegan:Connect(function(i)
			if Library.LayoutEdit and isPress(i) then Library:_dragBlock(blk, i.Position) end
		end)
		if Library.LayoutEdit then blk._setEdit(true) end
	end
	-- bouton « détacher en mini-fenêtre » (re-cliquer = remettre le bloc à sa place)
	do
		local popBtn = new("TextButton", { Name = "Detach", Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -54, 0.5, -11),
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3 }, head)
		local icoStrokes = {}
		for _, p in ipairs({ { 4, 8 }, { 9, 4 } }) do
			local ic = new("Frame", { Position = UDim2.fromOffset(p[1], p[2]), Size = UDim2.fromOffset(9, 9),
				BackgroundTransparency = 1, BorderSizePixel = 0 }, popBtn)
			icoStrokes[#icoStrokes + 1] = new("UIStroke", { Color = T.ElementAccent, Thickness = 1, Transparency = 0.2,
				ApplyStrokeMode = BORDER }, ic)
		end
		popBtn.MouseEnter:Connect(function() for _, s2 in ipairs(icoStrokes) do tween(s2, { Transparency = 0 }, 0.15) end end)
		popBtn.MouseLeave:Connect(function() for _, s2 in ipairs(icoStrokes) do tween(s2, { Transparency = 0.2 }, 0.2) end end)
		popBtn.MouseButton1Click:Connect(function()
			if Library.LayoutEdit then return end
			uiSnd("click")
			if blk._float then Library:AttachBlock(blk) else Library:DetachBlock(blk) end
		end)
	end
	blk._sq = { head = head, name = nameLbl, arrow = arrow, line = headLine, x = x }
	if Library.SquareMode then Library._sqApplyBlock(blk) end
	return blk
end

-- Recherche globale : filtre les éléments de tous les onglets
local function applySearch(win, q)
	q = string.lower(q or "")
	local mf = Library.ModFilter == true
	local active = q ~= "" or mf
	local expand = mf and Library._modExpandOnce
	Library._modExpandOnce = nil
	local firstHit, curHit
	for _, tab in ipairs(win.Tabs) do
		local total = 0
		for _, blk in ipairs(tab:_allBlocks()) do
			local blockHit = q ~= "" and string.find(string.lower(blk.Name), q, 1, true) ~= nil
			local n = 0
			for _, e in ipairs(blk.Entries) do
				local vis = true
				if active then
					if q ~= "" then
						vis = blockHit or (e.Name ~= "" and string.find(string.lower(e.Name), q, 1, true) ~= nil)
					end
					if vis and mf then vis = Library:_isModifiedFrame(e.Frame) end
				end
				e.Frame.Visible = vis
				if active and vis then n = n + 1 end
			end
			local show = (not active) or n > 0 or (blockHit and not mf)
			blk.Frame.Visible = show
			if active and show then total = total + math.max(n, 1) end
			if expand and n > 0 and blk._isCollapsed and blk._isCollapsed() then blk:SetCollapsed(false) end
		end
		tab._hits = active and total or 0
		tween(tab.Dot, { BackgroundTransparency = (active and total > 0) and 0.1 or 1 }, 0.25)
		tween(tab.Label, { TextTransparency = (active and total == 0) and 0.6 or 0 }, 0.25)
		if active and total > 0 and not firstHit then firstHit = tab end
		if tab == win.Current then curHit = total > 0 end
	end
	-- onglets parents : pastille allumée (et dépliés pendant une recherche) si un de leurs enfants a un résultat
	for i = #win.Tabs, 1, -1 do   -- les enfants sont créés après leur parent : on remonte du dernier au premier
		local t = win.Tabs[i]
		local p = t.ParentTab
		if p and active and (t._hits or 0) > 0 then
			if (p._hits or 0) == 0 then
				tween(p.Dot, { BackgroundTransparency = 0.1 }, 0.25)
				tween(p.Label, { TextTransparency = 0 }, 0.25)
			end
			p._hits = (p._hits or 0) + t._hits
			if q ~= "" then p:SetExpanded(true) end
		end
	end
	if active and firstHit and not curHit then firstHit:Select() end
end
Library._applySearch = applySearch

-- Transition d'onglet (Paramètres > Animations & performances > « Transition des onglets »)
--   Glisser (défaut) : la page glisse de 16 px · Fondu : la page sort doucement du voile · Zoom : la page grossit depuis son centre
Library.TabTransitions = { "Glisser", "Fondu", "Zoom" }
Library.TabTransition = "Glisser"
function Library:SetTabTransition(n)
	for _, v in ipairs(Library.TabTransitions) do
		if v == n then
			Library.TabTransition = n
			return true
		end
	end
	return false
end

function Window:CreateTab(name, _, icon, parentTab)
	local win = self
	-- parentTab (optionnel, interne) : fait de cet onglet un ENFANT déplié sous parentTab (voir Tab:CreateChildTab)
	local depth = parentTab and ((parentTab.Depth or 0) + 1) or 0
	local fullName = parentTab and (tostring(parentTab.Name) .. " / " .. tostring(name or "Tab")) or name
	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, parentTab and 30 or 34), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, ClipsDescendants = true,
		-- ordre pair = onglet, ordre impair juste après = son conteneur d'enfants
		LayoutOrder = parentTab and ((#parentTab.Children + 1) * 2) or ((#self.Tabs + 1) * 2),
	}, parentTab and parentTab:_childHolder() or self.Sidebar)
	new("UICorner", { CornerRadius = UDim.new(0, 8) }, btn)
	local bar = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 3, 0, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, btn)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local dot = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0, 5, 0, 5), BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0 }, btn)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	local x0 = 12 + depth * 10        -- retrait des onglets enfants
	local x = x0
	if icon and icon ~= "" then
		local isz = win._iconSize or 16   -- V5.8 : l'icône de Home est plus grande (22)
		if string.sub(icon, 1, 6) == "glyph:" then   -- icône dessinée par un caractère (ex. "glyph:⌂")
			label(btn, string.sub(icon, 7), isz + 1, { Font = Enum.Font.GothamBold, TextXAlignment = CENTER, TextTruncate = Enum.TextTruncate.None,
				Size = UDim2.new(0, isz, 0, isz), Position = UDim2.new(0, x0, 0.5, -isz / 2) })
		else
			new("ImageLabel", { BackgroundTransparency = 1, Image = icon, ImageColor3 = T.Text,
				Size = UDim2.new(0, isz, 0, isz), Position = UDim2.new(0, x0, 0.5, -isz / 2) }, btn)
		end
		x = x0 + isz + 6
	end
	local txt = label(btn, name or "Tab", parentTab and 12 or 13, { Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -x - 14, 1, 0),
		TextColor3 = T.ElementAccent })

	local page = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false }, self.Content)

	local function newColumn()
		local sf = new("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0), Visible = not page:GetAttribute("HasSubs"),
			BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, VerticalScrollBarInset = Enum.ScrollBarInset.Always, HorizontalScrollBarInset = Enum.ScrollBarInset.None, ScrollBarImageColor3 = T.Accent,
			ScrollBarImageTransparency = 0.5, CanvasSize = UDim2.new(), AutomaticCanvasSize = AY,
		}, page)
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = BYORDER }, sf)
		new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingTop = UDim.new(0, 2) }, sf)
		if Library.SquareMode then Library._sqApplyCol(sf) end
		return sf
	end

	local tab = setmetatable({ Name = fullName, Page = page, Button = btn, Blocks = {}, Cols = {}, NumCols = 0,
		_newColumn = newColumn, Win = win, ParentTab = parentTab, Depth = depth, Children = {}, Expanded = false }, Tab)
	tab:SetColumns(self.EffCols or (self.TwoCols and 2 or 1))

	function tab:Select()
		for _, t in ipairs(win.Tabs) do
			if t ~= tab then
				t.Page.Visible = false
				tween(t.Bar, { Size = UDim2.new(0, 3, 0, 0) }, 0.25)
				tween(t.Button, { BackgroundTransparency = 1 }, 0.25)
				tween(t.Label, { TextColor3 = T.ElementAccent }, 0.25)
			end
		end
		-- les parents d'un onglet enfant se déplient et restent « allumés » tant qu'il est actif
		do
			local p = tab.ParentTab
			while p do
				p:SetExpanded(true)
				tween(p.Label, { TextColor3 = T.Text }, 0.25)
				tween(p.Bar, { Size = UDim2.new(0, 3, 0, 8) }, 0.35)
				p = p.ParentTab
			end
		end
		page.Visible = true
		Library._busyUntil = os.clock() + 0.55
		if win._selSet and win._selSet(tab) then
			-- la pastille de la sidebar glisse jusqu'à cet onglet : pas de fond ni de barre propres au bouton
			tween(bar, { Size = UDim2.new(0, 3, 0, 0) }, 0.2)
			tween(btn, { BackgroundTransparency = 1 }, 0.25)
		else
			tween(bar, { Size = UDim2.new(0, 3, 0, 16) }, 0.45, BACK)
			tween(btn, { BackgroundTransparency = 0.92 }, 0.25)
		end
		tween(txt, { TextColor3 = T.Text }, 0.25)
		if Library._openDD then Library._openDD(false) end

		-- transition : la page sort de l'ombre (glisser / fondu / zoom, au choix dans les Paramètres)
		if win.Current ~= tab and win.Veil then
			local mode = Library.TabTransition
			local zoom = page:FindFirstChild("TabZoom")
			page.AnchorPoint = Vector2.new(0, 0)
			page.Position = UDim2.new(0, 0, 0, 0)
			if zoom then zoom.Scale = 1 end
			local fadeT = 0.42
			if mode == "Zoom" then
				if not zoom then zoom = new("UIScale", { Name = "TabZoom", Scale = 1 }, page) end
				page.AnchorPoint = Vector2.new(0.5, 0.5)
				page.Position = UDim2.new(0.5, 0, 0.5, 0)   -- page pleine taille : identique à (0, 0) quand l'échelle vaut 1
				zoom.Scale = 0.9
				tween(zoom, { Scale = 1 }, 0.5, BACK)
			elseif mode == "Fondu" then
				fadeT = 0.6
			else
				page.Position = UDim2.new(0, 16, 0, 0)
				tween(page, { Position = UDim2.new(0, 0, 0, 0) }, 0.5)
			end
			win.VeilToken = (win.VeilToken or 0) + 1
			local my = win.VeilToken
			win.Veil.Visible = true
			win.Veil.BackgroundTransparency = Sty.VeilTr
			local tw = tween(win.Veil, { BackgroundTransparency = 1 }, fadeT)
			tw.Completed:Connect(function()
				if win.VeilToken == my then win.Veil.Visible = false end
			end)
		end
		win.Current = tab
		if Library._settingsReady then Library.Flags["ui.lasttab"] = tostring(tab.Name) end   -- mémorisé (sauvegarde auto)
		if win._ecTabSelected then win._ecTabSelected(tab) end
		if tab.OnSelect then tab.OnSelect() end
	end
	tab.Bar, tab.Label, tab.Dot = bar, txt, dot
	tab.Corner = btn:FindFirstChildOfClass("UICorner")
	if win._ecStyleTab then win._ecStyleTab(tab) end
	btn.MouseEnter:Connect(function()
		if win.Current ~= tab then uiSnd("tabhover") tween(btn, { BackgroundTransparency = 0.95 }, 0.2) end
		if not txt:GetAttribute("BaseX") then txt:SetAttribute("BaseX", txt.Position.X.Offset) end
		tween(txt, { Position = UDim2.new(0, txt:GetAttribute("BaseX") + 4, 0, 0) }, 0.25)
	end)
	btn.MouseLeave:Connect(function()
		if win.Current ~= tab then tween(btn, { BackgroundTransparency = 1 }, 0.25) end
		local bx = txt:GetAttribute("BaseX")
		if bx then tween(txt, { Position = UDim2.new(0, bx, 0, 0) }, 0.3) end
	end)
	btn.MouseButton1Click:Connect(function()
		ripple(btn)
		local was = win.Current == tab
		if not was then uiSnd("tab") end
		tab:Select()
		if tab._holder then
			if was then tab:SetExpanded(not tab.Expanded)   -- déjà actif : plier / déplier
			else tab:SetExpanded(true) end                  -- sinon : l'afficher et déplier
		end
	end)

	table.insert(self.Tabs, tab)
	if parentTab then table.insert(parentTab.Children, tab) end
	if not self.Current and not self._noSelect then tab:Select() end
	-- on rouvre l'onglet qui était affiché la dernière fois (sans animation de transition)
	if Library._lastTab and not self._noSelect and self.Current ~= tab and tostring(tab.Name) == Library._lastTab then
		local veil = self.Veil
		self.Veil = nil
		pcall(tab.Select, tab)
		self.Veil = veil
	end
	return tab
end

-- ============================================================================
-- SOUS-ONGLETS : une barre de pastilles en haut d'un onglet, chaque pastille ouvre sa propre page de blocs
--   local subs = tab:CreateSubTabs({ "Combat", "Visuel", { Name = "Divers", Icon = "rbxassetid://..." } })
--   subs[1]:CreateBlock({ Name = "...", Side = "Left" })   -- ou subs.Combat / tab:GetSubTab("Combat")
--   Chaque sous-onglet se comporte comme un onglet (CreateBlock, CreateToggle direct, ClearBlocks...).
--   subs[2]:Select() / tab:SelectSub("Visuel").  Les blocs des sous-onglets sont inclus dans la recherche,
--   « tout replier » et les favoris. Les blocs créés directement sur l'onglet parent ne sont plus affichés.
-- ============================================================================
function Tab:CreateSubTabs(list)
	local parent = self
	if parent.SubTabs and #parent.SubTabs > 0 then return parent.SubTabs end
	parent.SubTabs = {}
	parent.Page:SetAttribute("HasSubs", true)
	for _, c in ipairs(parent.Cols) do c.Visible = false end

	-- V5.7 : plus de grossissement au survol (le texte était déformé et rognait sur les bords). Une seule pastille
	-- « curseur » glisse et se redimensionne d'un sous-onglet à l'autre ; les textes gardent toujours la même taille.
	local strip = new("ScrollingFrame", { Name = "SubTabs", Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.X }, parent.Page)

	local GAP, X0, H = 6, 2, 24
	local canvasW = 0
	local ind = new("Frame", { Name = "Indicator", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, X0, 0.5, 0),
		Size = UDim2.new(0, 0, 0, H), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.82, BorderSizePixel = 0,
		Visible = false, ZIndex = 1 }, strip)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, ind)
	new("UIStroke", { Color = T.Accent, Thickness = 1, Transparency = 0.4, ApplyStrokeMode = BORDER }, ind)

	-- place la pastille sous le sous-onglet actif (avec transition) et le fait défiler dans la vue si besoin
	local function moveIndicator(animate)
		local sub = parent.CurrentSub
		if not sub or not sub.PillW then return end
		local pos, size = UDim2.new(0, sub.PillX, 0.5, 0), UDim2.new(0, sub.PillW, 0, H)
		if animate and ind.Visible then
			Library._spring(ind, { Position = pos, Size = size }, "snappy")
		else
			Library._springStop(ind)
			ind.Position, ind.Size = pos, size
			ind.Visible = true
		end
		local vis = strip.AbsoluteSize.X / pxScale()
		local cx = strip.CanvasPosition.X
		if vis > 0 and (sub.PillX < cx or sub.PillX + sub.PillW > cx + vis) then
			local target = math.clamp(sub.PillX - 12, 0, math.max(0, canvasW - vis))
			tween(strip, { CanvasPosition = Vector2.new(target, 0) }, 0.35)
		end
	end

	-- positions des pastilles (placées à la main : leur largeur suit le texte)
	local function relayout()
		local x = X0
		for _, s in ipairs(parent.SubTabs) do
			s.PillX = x
			s.Pill.Position = UDim2.new(0, x, 0.5, 0)
			x = x + (s.PillW or 60) + GAP
		end
		canvasW = x + 4
		strip.CanvasSize = UDim2.fromOffset(canvasW, 0)
		moveIndicator(false)
	end

	local function select(sub)
		local prev = parent.CurrentSub
		local prevIdx = prev and table.find(parent.SubTabs, prev)
		local newIdx = table.find(parent.SubTabs, sub)
		for _, s in ipairs(parent.SubTabs) do
			local on = s == sub
			if on then
				if not s.Page.Visible then
					-- la page arrive du côté d'où l'on vient (droite si on avance, gauche si on recule)
					local dir = (prevIdx and newIdx and newIdx < prevIdx) and -1 or 1
					s.Page.Position = UDim2.new(0, 14 * dir, 0, 36)
					tween(s.Page, { Position = UDim2.new(0, 0, 0, 36) }, 0.4)
				end
				s.Page.Visible = true
			else
				s.Page.Visible = false
			end
			tween(s.Pill, { BackgroundTransparency = 1 }, 0.2)
			tween(s.PillLabel, { TextColor3 = on and T.Text or T.ElementAccent }, 0.25)
			if s.PillIcon then tween(s.PillIcon, { ImageColor3 = on and T.Text or T.ElementAccent }, 0.25) end
		end
		parent.CurrentSub = sub
		if sub.OnShow and prev ~= nil then pcall(sub.OnShow) end
		moveIndicator(prev ~= nil)
		Library._busyUntil = os.clock() + 0.5
		if Library._openDD then Library._openDD(false) end
	end

	for idx, d in ipairs(list or {}) do
		local name = type(d) == "table" and tostring(d.Name or d[1] or ("Page " .. idx)) or tostring(d)
		local icon = type(d) == "table" and d.Icon or nil
		local hasIcon = icon and icon ~= ""
		local padL, padR = hasIcon and 30 or 14, 14   -- marges de la pastille (gauche / droite)

		-- zone cliquable transparente ; la largeur est calculée depuis le texte (jamais d'AutomaticSize : voir plus haut)
		local pill = new("TextButton", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, X0, 0.5, 0),
			Size = UDim2.new(0, 60, 0, H), BackgroundColor3 = T.Accent, BackgroundTransparency = 1, Text = "",
			AutoButtonColor = false, BorderSizePixel = 0, ClipsDescendants = false, ZIndex = 2 }, strip)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, pill)
		local pic
		if hasIcon then
			pic = new("ImageLabel", { BackgroundTransparency = 1, Image = icon, ImageColor3 = T.ElementAccent,
				Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, 10, 0.5, -7), ZIndex = 3 }, pill)
		end
		local pl = new("TextLabel", { Position = UDim2.new(0, padL, 0, 0), Size = UDim2.new(1, -padL, 1, 0),
			BackgroundTransparency = 1, Text = name, TextColor3 = T.ElementAccent, TextSize = 12, Font = F_MED,
			TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.None, ZIndex = 3 }, pill)
		-- texte centré dans la zone restante (après l'icône s'il y en a une) : une petite erreur de mesure se répartit des deux côtés
		pl.Position = UDim2.new(0, hasIcon and 28 or 0, 0, 0)
		pl.Size = UDim2.new(1, hasIcon and -28 or 0, 1, 0)

		local page = new("Frame", { Name = "Sub_" .. name, Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 1, -36),
			BackgroundTransparency = 1, Visible = false }, parent.Page)
		local function newColumn()
			local sf = new("ScrollingFrame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
				ScrollBarThickness = 2, VerticalScrollBarInset = Enum.ScrollBarInset.Always, HorizontalScrollBarInset = Enum.ScrollBarInset.None, ScrollBarImageColor3 = T.Accent, ScrollBarImageTransparency = 0.5,
				CanvasSize = UDim2.new(), AutomaticCanvasSize = AY }, page)
			new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = BYORDER }, sf)
			new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingTop = UDim.new(0, 2) }, sf)
			return sf
		end
		local sub = setmetatable({ Name = tostring(parent.Name) .. " / " .. name, SubName = name, Page = page,
			Button = parent.Button, Blocks = {}, Cols = {}, NumCols = 0, _newColumn = newColumn, Parent = parent,
			Pill = pill, PillLabel = pl, PillIcon = pic }, Tab)
		sub:SetColumns(parent.NumCols)
		function sub:Select()
			local win = Library.Window
			if win and win.Current ~= parent then parent:Select() end
			select(sub)
		end

		parent.SubTabs[#parent.SubTabs + 1] = sub
		parent.SubTabs[name] = sub

		-- largeur = texte + marges ; recalculée si la police / la taille change
		local function measure()
			local tb = pl.TextBounds.X
			if tb <= 0 then   -- pas encore calculé (police pas chargée) : estimation par TextService
				local ok, b = pcall(function()
					return game:GetService("TextService"):GetTextSize(pl.Text, pl.TextSize, pl.Font, Vector2.new(10000, 100)).X
				end)
				tb = ok and b or (#name * pl.TextSize * 0.6)
			end
			local w = math.ceil(tb) + padL + padR + 6   -- +6 : marge de sécurité pour que le titre ne soit jamais rogné
			if w ~= sub.PillW then
				sub.PillW = w
				pill.Size = UDim2.new(0, w, 0, H)
				relayout()
			end
		end
		measure()
		pl:GetPropertyChangedSignal("TextBounds"):Connect(measure)
		pl:GetPropertyChangedSignal("Font"):Connect(measure)
		pl:GetPropertyChangedSignal("TextSize"):Connect(measure)
		task.defer(measure)
		task.delay(0.5, measure)   -- re-mesure une fois la police chargée

		-- survol : simple éclaircissement du fond et du texte (aucun changement de taille)
		pill.MouseEnter:Connect(function()
			if parent.CurrentSub ~= sub then
				uiSnd("tabhover")
				tween(pill, { BackgroundTransparency = 0.92 }, 0.18)
				tween(pl, { TextColor3 = T.Text }, 0.18)
				if pic then tween(pic, { ImageColor3 = T.Text }, 0.18) end
			end
		end)
		pill.MouseLeave:Connect(function()
			if parent.CurrentSub ~= sub then
				tween(pill, { BackgroundTransparency = 1 }, 0.25)
				tween(pl, { TextColor3 = T.ElementAccent }, 0.25)
				if pic then tween(pic, { ImageColor3 = T.ElementAccent }, 0.25) end
			end
		end)
		pill.MouseButton1Click:Connect(function()
			-- (ClipsDescendants ignore les coins arrondis : l'onde sortait en rectangle) -> petit flash arrondi sur la pastille
			if Library.Animations then
				ind.BackgroundTransparency = 0.55
				tween(ind, { BackgroundTransparency = 0.82 }, 0.35)
			end
			if parent.CurrentSub ~= sub then uiSnd("tab") end
			select(sub)
		end)
	end
	relayout()
	if parent.SubTabs[1] then select(parent.SubTabs[1]) end
	return parent.SubTabs
end

function Tab:GetSubTab(name) return self.SubTabs and self.SubTabs[name] end
function Tab:SelectSub(name)
	local s = self:GetSubTab(name)
	if s then s:Select() end
	return s
end


-- ============================================================================
-- ONGLETS DANS UN ONGLET : une flèche › sur l'onglet de la barre latérale déplie ses onglets enfants
--   (hauteur + fondu + glissement, fermeture identique à l'envers). Imbrication illimitée.
--
--   local combat = Window:CreateTab("Combat", nil, icon)
--   local aim    = combat:CreateChildTab("Aimbot", nil, icon)     -- alias : combat:CreateTab("Aimbot")
--   local kids   = combat:CreateChildTabs({ "ESP", { Name = "Divers", Icon = "rbxassetid://..." } })  -- kids[1], kids.ESP
--   combat:SetExpanded(true)  /  combat:ToggleExpanded()  /  combat.Expanded  /  combat:GetChildTab("Aimbot")
--   Un enfant est un onglet à part entière : CreateBlock, CreateSubTabs, Select, recherche, favoris, disposition...
-- ============================================================================
local function fadeChildren(tab, to, t)
	if canvasSupported then
		tween(tab._holder, { GroupTransparency = to }, t)
	else   -- pas de CanvasGroup : on fait fondre les textes des enfants
		for _, c in ipairs(tab.Children) do tween(c.Label, { TextTransparency = to }, t) end
	end
end

-- crée (une seule fois) la flèche et le conteneur des enfants ; renvoie le Frame « Inner » où se placent les boutons enfants
function Tab:_childHolder()
	if self._holder then return self._holder.Inner end
	local tab, btn = self, self.Button

	local holder = new(canvasSupported and "CanvasGroup" or "Frame", {
		Name = "Children", Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
		ClipsDescendants = true, Visible = false, LayoutOrder = btn.LayoutOrder + 1,
	}, btn.Parent)
	if canvasSupported then holder.GroupTransparency = 1 end
	local inner = new("Frame", { Name = "Inner", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY,
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, -10, 0, 0) }, holder)
	local list = new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = BYORDER }, inner)
	self._holder, self._list = holder, list

	-- si du contenu est ajouté / retiré pendant que c'est ouvert (ou pendant l'animation d'un sous-menu), la hauteur suit
	list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		if tab.Expanded and not tab._animating then
			holder.Size = UDim2.new(1, 0, 0, list.AbsoluteContentSize.Y)
		end
	end)

	-- flèche à droite de l'onglet (sous la pastille de recherche)
	local arrow = new("TextButton", { Name = "Arrow", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -21, 0.5, 0),
		Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Text = "›", TextColor3 = T.ElementAccent,
		TextSize = 20, Font = F_BOLD, AutoButtonColor = false, ZIndex = 2 }, btn)
	self._arrow = arrow
	-- le texte raccourcit pour laisser la place à la flèche
	self.Label.Size = UDim2.new(self.Label.Size.X.Scale, self.Label.Size.X.Offset - 20, self.Label.Size.Y.Scale, self.Label.Size.Y.Offset)
	arrow.MouseEnter:Connect(function() tween(arrow, { TextColor3 = T.Text }, 0.15) end)
	arrow.MouseLeave:Connect(function()
		tween(arrow, { TextColor3 = tab.Expanded and T.Text or T.ElementAccent }, 0.25)
	end)
	arrow.MouseButton1Click:Connect(function()
		uiSnd(tab.Expanded and "off" or "on")
		tab:SetExpanded(not tab.Expanded)
	end)
	return inner
end

function Tab:SetExpanded(on, instant)
	local holder = self._holder
	if not holder then return end
	if Library.SquareMode then return end   -- type Carré : les onglets enfants sont à plat dans la barre du haut
	on = on and true or false
	if self.Expanded == on then return end
	self.Expanded = on
	self._expTok = (self._expTok or 0) + 1
	local my = self._expTok
	local list, inner, arrow = self._list, holder.Inner, self._arrow
	local function d(t) return instant and 0 or t end
	self._animating = true

	if on then
		local H = list.AbsoluteContentSize.Y
		if H <= 0 then H = #self.Children * 33 end   -- le layout n'a pas encore calculé : estimation, corrigée à la fin
		holder.Visible = true
		local tw = tween(holder, { Size = UDim2.new(1, 0, 0, H) }, d(0.45))
		fadeChildren(self, 0, d(0.45))
		tween(inner, { Position = UDim2.new(0, 0, 0, 0) }, d(0.5))
		tween(arrow, { Rotation = 90, TextColor3 = T.Text }, d(0.4), BACK)
		tw.Completed:Connect(function()
			if self._expTok ~= my then return end
			self._animating = false
			local ch = list.AbsoluteContentSize.Y
			local fin = ch > 0 and ch or H
			-- si la hauteur réelle diffère de l'estimation : on glisse jusqu'à elle au lieu de sauter d'un coup
			if math.abs(fin - H) >= 1 and not instant then
				tween(holder, { Size = UDim2.new(1, 0, 0, fin) }, 0.15)
			else
				holder.Size = UDim2.new(1, 0, 0, fin)
			end
		end)
	else
		local tw = tween(holder, { Size = UDim2.new(1, 0, 0, 0) }, d(0.38), Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut)
		fadeChildren(self, 1, d(0.24))
		tween(inner, { Position = UDim2.new(0, -10, 0, 0) }, d(0.38))
		tween(arrow, { Rotation = 0, TextColor3 = T.ElementAccent }, d(0.32))
		tw.Completed:Connect(function()
			if self._expTok ~= my then return end
			self._animating = false
			holder.Visible = false
		end)
	end
end

function Tab:ToggleExpanded() self:SetExpanded(not self.Expanded) end

function Tab:CreateChildTab(name, _, icon)
	local win = self.Win
	if not win then
		warn("[Ui-Lib] CreateChildTab : à appeler sur un onglet (Window:CreateTab), pas sur un sous-onglet.")
		return nil
	end
	return win:CreateTab(name, nil, icon, self)
end
Tab.CreateTab = Tab.CreateChildTab   -- alias : combat:CreateTab("Aimbot")

function Tab:CreateChildTabs(list)
	local out = {}
	for idx, d in ipairs(list or {}) do
		local name = type(d) == "table" and tostring(d.Name or d[1] or ("Page " .. idx)) or tostring(d)
		local child = self:CreateChildTab(name, nil, type(d) == "table" and d.Icon or nil)
		if child then
			out[#out + 1] = child
			out[name] = child
		end
	end
	return out
end

function Tab:GetChildTab(name)
	for _, c in ipairs(self.Children or {}) do
		if c.Name == tostring(self.Name) .. " / " .. tostring(name) then return c end
	end
	return nil
end
function Tab:SelectChild(name)
	local c = self:GetChildTab(name)
	if c then c:Select() end
	return c
end

-- Interface de gestion des configs (utilisée par l'onglet Config et par l'onglet Paramètres)
local function buildConfigUI(blk)
	local function toast(ok, okMsg, errMsg)
		Library:Notify({ Title = "Config", Content = ok and okMsg or errMsg, _cfgSummary = true,
			Type = ok and "Success" or "Error", Duration = 3 })
	end
	blk:CreateSection("Fichier")
	local nameBox = blk:CreateInput({ Name = "Nom", Placeholder = "ma-config", Favorite = false })
	local dd = blk:CreateDropdown({ Name = "Existantes", Items = Library:ListConfigs(), Favorite = false,
		UpdateList = function() return Library:ListConfigs() end })
	local function currentName()
		local n = nameBox.Get()
		if n == nil or n == "" then n = dd.Get() end
		return n
	end
	blk:CreateButton({ Name = "Sauvegarder", Favorite = false, Callback = function()
		local n = currentName()
		local ok, err = Library:SaveConfig(n)
		toast(ok, "Sauvegardée : " .. tostring(n), "Échec : " .. tostring(err))
		dd.Refresh(Library:ListConfigs())
	end })
	blk:CreateButton({ Name = "Charger", Favorite = false, Callback = function()
		local n = currentName()
		local ok, err = Library:LoadConfig(n)
		toast(ok, "Chargée : " .. tostring(n) .. " (" .. tostring(Library._lastCfgCount or 0) .. " changement(s), détails dans Réglages)",
			"Échec : " .. tostring(err))
	end })
	local target = blk:CreateInput({ Name = "Vers (nouveau nom)", Placeholder = "autre-nom", Favorite = false })
	blk:CreateButton({ Name = "Dupliquer vers ce nom", Favorite = false, Callback = function()
		local ok, err = Library:DuplicateConfig(currentName(), target.Get())
		toast(ok, "Dupliquée", "Échec : " .. tostring(err))
		dd.Refresh(Library:ListConfigs())
	end })
	blk:CreateButton({ Name = "Renommer vers ce nom", Favorite = false, Callback = function()
		local ok, err = Library:RenameConfig(currentName(), target.Get())
		toast(ok, "Renommée", "Échec : " .. tostring(err))
		dd.Refresh(Library:ListConfigs(), true)
	end })
	blk:CreateButton({ Name = "Supprimer", Confirm = true, Favorite = false, Callback = function()
		local n = currentName()
		local ok = Library:DeleteConfig(n)
		Library:Notify({ Title = "Config", Content = ok and ("Supprimée : " .. tostring(n)) or "Suppression impossible",
			Type = ok and "Warning" or "Error", Duration = 3 })
		dd.Refresh(Library:ListConfigs(), true)
	end })

	blk:CreateSection("Démarrage")
	local autoInfo = blk:CreateParagraph({ Title = "Config auto-chargée", Content = "" })
	local function refreshAuto()
		local a = Library:GetAutoLoad()
		autoInfo.Set({ Title = a and ("Auto-chargement : " .. a) or "Auto-chargement : aucun",
			Content = a and "Cette config s'applique toute seule à chaque lancement du script."
				or "Choisis une config puis clique sur « Charger automatiquement cette config »." })
	end
	refreshAuto()
	blk:CreateButton({ Name = "Charger automatiquement cette config", Favorite = false, Callback = function()
		local n = currentName()
		if n == nil or safeName(n) == "" then toast(false, "", "Choisis d'abord une config.") return end
		if not table.find(Library:ListConfigs(), safeName(n)) then
			toast(false, "", "Cette config n'existe pas encore : sauvegarde-la d'abord.")
			return
		end
		Library:SetAutoLoad(n)
		refreshAuto()
		toast(true, "Auto-chargement : " .. tostring(n), "")
	end })
	blk:CreateButton({ Name = "Désactiver l'auto-chargement", Favorite = false, Callback = function()
		Library:SetAutoLoad("")
		refreshAuto()
		toast(true, "Auto-chargement désactivé", "")
	end })

	blk:CreateSection("Valeurs")
	blk:CreateButton({ Name = "Réinitialiser les options du script", Confirm = true, Favorite = false,
		Tooltip = "Remet chaque option du script à sa valeur de départ (l'apparence n'est pas touchée).",
		Callback = function()
			local n = Library:ResetConfig(false)
			toast(true, n .. " options réinitialisées", "")
		end })

	blk:CreateSection("Partage")
	local code = blk:CreateInput({ Name = "Code", Placeholder = "colle un code de config ici", Favorite = false })
	blk:CreateButton({ Name = "Exporter (copie le code)", Favorite = false, Callback = function()
		local s = Library:ExportConfig()
		code.Set(s)
		local ok = Library:CopyText(s)
		toast(true, ok and "Code copié dans le presse-papiers." or "Presse-papiers indisponible : copie le code du champ.", "")
	end })
	blk:CreateButton({ Name = "Importer depuis le champ", Favorite = false, Callback = function()
