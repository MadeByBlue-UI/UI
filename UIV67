	local sheen = new("Frame", { Name = "Sheen", Size = UDim2.new(1, 0, 0.6, 0), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 2 }, card)
	new("UICorner", { CornerRadius = UDim.new(0, 22) }, sheen)
