function Library:BuildToggleButton()
    local size = 46
    local button = self:Create("TextButton", {
        Name = "ToggleButton",
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 10),
        Size = UDim2.fromOffset(size, size),
        Text = "",
        ZIndex = 650,
        Visible = false,
        ["@BackgroundColor3"] = "BackgroundColor",
        Parent = self.Root,
    })
    self:AddCorner(button, 9999)
    self:AddStroke(button, "AccentColor", 1.5, 0.2)

    local icon = self:CreateSingularityIcon(button, size - 12, {
        Position = UDim2.fromOffset(6, 6),
        ZIndex = 651,
    })
    icon.Active = false

    local dragMoved = false
    local startPosition
    self:MakeDraggable(button, button, {
        OnStart = function()
            dragMoved = false
            startPosition = button.Position
        end,
        OnMove = function(position)
            if startPosition and (position.X.Offset ~= startPosition.X.Offset
                or position.Y.Offset ~= startPosition.Y.Offset) then
                dragMoved = true
            end
        end,
    })

    button.MouseButton1Click:Connect(function()
        if not dragMoved then
            self:Toggle()
        end
    end)

    self.ToggleButton = button
end

function Library:SetToggleButtonVisibility(visible)
    self.ShowToggleButton = visible
    if self.ToggleButton then
        self.ToggleButton.Visible = visible
    end
end

function Library:Init()
    if self.Initialized then
        return
    end
    self.Initialized = true
    self:BuildScreenGui()
    self:BuildTooltip()
    self:BuildWatermark()
    self:BuildKeybindList()
    self:BuildToggleButton()
    self:BuildSpotlight()
    self.ToggleButton.Visible = self.ShowToggleButton and self.IsMobile
    env.SingularityLibrary = self
end

-- ════════════════════════════════════════════════════════════════════════
--  Show / hide / unload
-- ════════════════════════════════════════════════════════════════════════

function Library:Toggle(state)
    if state == nil then
        state = not self.Toggled
    end
    self.Toggled = state
    self:CloseAllPopups()
    for _, window in ipairs(self.Windows) do
        window.Holder.Visible = state
    end
    if self.DialogLayer then
        self.DialogLayer.Visible = state and #self.DialogLayer:GetChildren() > 0
    end
    if self.ToggleSignal then
        self.ToggleSignal:Fire(state)
    end
end

Library.ToggleSignal = Signal.new()

function Library:Unload()
    if self.Unloaded then
        return
    end
    self.Unloaded = true

    for _, callback in ipairs(self.UnloadSignals) do
        self:SafeCallback(callback)
    end

    self.Maid:Clean()
    for _, handle in ipairs(self.Animations) do
        handle.Active = false
    end
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
    if env.SingularityLibrary == self then
        env.SingularityLibrary = nil
    end
end

