-- CONFIGURATIONS  (nécessite writefile / readfile)
-- ============================================================================
local function safeName(n)
	local s = tostring(n or "")
	s = s:gsub("[^%w%-_ ]", "")
	s = s:gsub("^%s+", "")
	s = s:gsub("%s+$", "")
	return s
end

function Library:ListConfigs()
	local out = {}
	pcall(function()
		if listfiles and isfolder and isfolder(Library.ConfigFolder) then
			for _, p in ipairs(listfiles(Library.ConfigFolder)) do
				local n = tostring(p):match("([^/\\]+)%.json$")
				if n then out[#out + 1] = n end
			end
		end
	end)
	table.sort(out)
	return out
end

function Library:SaveConfig(name)
	name = safeName(name)
	if name == "" then return false, "nom vide" end
	if not writefile then return false, "writefile indisponible" end
	local folder = Library.ConfigFolder
	pcall(function()
		if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end
	end)
	local ok, err = pcall(function()
		writefile(folder .. "/" .. name .. ".json", HttpService:JSONEncode(Library.Flags))
	end)
	return ok, err
end

function Library:LoadConfig(name, keepPending)
	name = safeName(name)
	if name == "" then return false, "nom vide" end
	if not (readfile and isfile) then return false, "readfile indisponible" end
	local path = Library.ConfigFolder .. "/" .. name .. ".json"
	if not isfile(path) then return false, "introuvable" end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "fichier invalide" end
	Library:_applyFlags(data, name)
	if keepPending then
		-- garde les valeurs 15 s : les éléments que ton script crée plus tard les récupèrent (voir register)
		Library._pendingFlags = data
		local mine = data
		task.delay(15, function()
			if Library._pendingFlags == mine then Library._pendingFlags = nil end
		end)
	end
	return true
end

function Library:DeleteConfig(name)
	name = safeName(name)
	if name == "" or not delfile then return false end
	local ok = pcall(function() delfile(Library.ConfigFolder .. "/" .. name .. ".json") end)
	return ok
end

-- ---------------------------------------------------------------------------
-- Auto-load : une config chargée automatiquement au démarrage
-- ---------------------------------------------------------------------------
local function autoPath() return Library.ConfigFolder .. "/_autoload.txt" end

function Library:GetAutoLoad()
	local n
	pcall(function()
		if isfile and readfile and isfile(autoPath()) then n = safeName(readfile(autoPath())) end
	end)
	if n == "" then n = nil end
	return n
end

function Library:SetAutoLoad(name)
	name = safeName(name)
	pcall(function()
		if makefolder and isfolder and not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
		if name == "" then
			if delfile and isfile and isfile(autoPath()) then delfile(autoPath()) end
		elseif writefile then
			writefile(autoPath(), name)
		end
	end)
	return true
end

-- À appeler à la fin de ton script (sinon appelé tout seul ~1,2 s après CreateWindow)
function Library:AutoLoad()
	if Library._autoDone then return end
	Library._autoDone = true
	local n = Library:GetAutoLoad()
	if not n then return end
	local ok, err = Library:LoadConfig(n, true)
	if ok and Library.AutoSaveSettings ~= false then Library:LoadSettings() end   -- tes réglages gardent la priorité
	Library:Notify({ Title = "Config", _cfgSummary = true,
		Content = ok and ("Auto-chargée : " .. n .. " (détails dans Réglages > Changements de config)")
			or ("Auto-load échoué : " .. tostring(err)),
		Type = ok and "Success" or "Error", Duration = 3 })
end

-- ---------------------------------------------------------------------------
-- Sauvegarde AUTOMATIQUE des paramètres : tous les réglages de l'onglet Paramètres (flags « ui.* » : position et
-- durée des notifications, thème, couleurs, colonnes, sons, trou noir...) sont écrits tout seuls dans
-- <ConfigFolder>/_settings.json dès qu'ils changent, et restaurés à chaque lancement.
-- Library.AutoSaveSettings = false pour couper (aussi dans Paramètres > Fenêtre).
-- ---------------------------------------------------------------------------
Library.AutoSaveSettings = true
local function settingsPath() return Library.ConfigFolder .. "/_settings.json" end

local function settingsSnapshot()
	local snap, keys = {}, {}
	for k, v in pairs(Library.Flags) do
		if type(k) == "string" and string.sub(k, 1, 3) == "ui." then
			if pcall(function() return HttpService:JSONEncode({ v = v }) end) then   -- uniquement des valeurs enregistrables
				snap[k] = v
				keys[#keys + 1] = k
			end
		end
	end
	table.sort(keys)
	local parts = {}
	for i, k in ipairs(keys) do parts[i] = k .. "=" .. HttpService:JSONEncode({ v = snap[k] }) end
	return snap, table.concat(parts, "|")
end

function Library:SaveSettings()
	if not writefile then return false, "writefile indisponible" end
	local snap, sig = settingsSnapshot()
	local ok, err = pcall(function()
		if makefolder and isfolder and not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
		writefile(settingsPath(), HttpService:JSONEncode(snap))
	end)
	if ok then Library._settingsSig = sig end
	return ok, err
end

function Library:LoadSettings()
	if not (readfile and isfile) then return false end
	local data
	pcall(function()
		if isfile(settingsPath()) then data = HttpService:JSONDecode(readfile(settingsPath())) end
	end)
	if type(data) ~= "table" then return false end
	if type(data["ui.lasttab"]) == "string" then
		Library._lastTab = data["ui.lasttab"]               -- dernier onglet utilisé (restauré à la création de l'onglet)
		Library.Flags["ui.lasttab"] = data["ui.lasttab"]
	end
	local sub = {}
	for k, v in pairs(data) do
		if type(k) == "string" and string.sub(k, 1, 3) == "ui." then sub[k] = v end
	end
	Library._restoring = (Library._restoring or 0) + 1
	pcall(Library._applyFlags, Library, sub)
	Library._restoring = math.max((Library._restoring or 1) - 1, 0)
	local _, sig = settingsSnapshot()
	Library._settingsSig = sig   -- ce qui vient d'être restauré est déjà sur le disque
	return true
end

-- surveille les réglages : écrit le fichier quand une valeur a changé et s'est stabilisée (~1 s)
function Library:_startSettingsWatcher(win)
	if not writefile then return end
	local token = (Library._settingsToken or 0) + 1
	Library._settingsToken = token
	task.spawn(function()
		local _, seen = settingsSnapshot()
		local changedAt = os.clock()
		while Library.Window == win and Library._settingsToken == token do
			task.wait(1.5)
			-- inutile de comparer tous les réglages quand l'interface est masquée (rien ne peut changer)
			if Library.AutoSaveSettings ~= false and Library.Window == win and win.Open then
				local _, sig = settingsSnapshot()
				if sig ~= seen then
					seen, changedAt = sig, os.clock()
				elseif sig ~= Library._settingsSig and os.clock() - changedAt >= 0.8 then
					Library:SaveSettings()
				end
			end
		end
	end)
end

