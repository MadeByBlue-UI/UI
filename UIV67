-- ───────────── Effet « papier froissé aspiré par un trou noir » ─────────────
-- La carte se brouille (images fantômes qui tremblent), se plisse (arêtes et facettes claires), se tasse en boule de
-- papier pendant qu'un trou noir s'ouvre derrière elle, puis la boule spirale vers le centre du trou et disparaît.
-- De petits morceaux de papier s'en détachent et sont aspirés eux aussi. Une onde de choc referme tout. Noir & blanc.
local function blackHoleOut(slot, card, cardScale, h, accent)
	local k = 1 / math.max(Library.AnimSpeed or 1, 0.05)
	local cw = card.AbsoluteSize.X / math.max(cardScale.Scale, 0.01)
	if cw < 10 then cw = Library.NotifWidth or 300 end
	local cy = h / 2
	local dirSpin = (math.random() < 0.5) and -1 or 1
	local WHITE, BLACK = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
	local KP = NumberSequenceKeypoint.new
	local rnd, sin, cos, clamp = math.random, math.sin, math.cos, math.clamp
	local IN = Enum.EasingDirection.In
	local TOT = 1.0            -- durée du mouvement (en « secondes animation »)
	local BALL_W, BALL_H = 70, 46
	local R0 = math.min(cw * 0.2, 52)

	-- on fige la carte (taille en pixels) et on la recentre pour qu'elle se froisse autour de son milieu
	card.AutomaticSize = AN
	card.Size = UDim2.fromOffset(cw, h)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.new(0.5, 0, 0, cy)
	card.ZIndex = 10
	local cardCornerObj = card:FindFirstChildOfClass("UICorner")

	-- images fantômes (effet de flou de mouvement), prises avant que la carte ne change
	local ghosts = {}
	if canvasSupported then
		for i = 1, 2 do
			local g = card:Clone()
			g.Name = "Ghost"
			g.ZIndex = 8
			g.GroupTransparency = 0.62
			for _, d in ipairs(g:GetDescendants()) do
				if d:IsA("GuiButton") then d.Active = false end
			end
			g.Parent = slot
			ghosts[i] = g
		end
	end

	-- le contenu s'efface vite : il ne reste qu'une feuille noire qui se plisse (le contour blanc reste)
	local keep = card:FindFirstChild("Outline")
	for _, d in ipairs(card:GetDescendants()) do
		if d ~= keep and not (keep and d:IsDescendantOf(keep)) then
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				tween(d, { TextTransparency = 1, BackgroundTransparency = 1 }, 0.2)
			elseif d:IsA("GuiObject") then
				tween(d, { BackgroundTransparency = 1 }, 0.2)
			elseif d:IsA("UIStroke") then
				tween(d, { Transparency = 1 }, 0.2)
			end
		end
	end

	-- plis : arêtes claires + facettes douces, qui apparaissent l'une après l'autre
	local folds = {}
	for i = 1, 6 do
		local f = new("Frame", { Name = "Fold", AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.1 + rnd() * 0.8, 0, 0.1 + rnd() * 0.8, 0), Size = UDim2.new(0.4 + rnd() * 0.5, 0, 0, 1),
			Rotation = rnd(-70, 70), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0,
			ZIndex = 40 }, card)
		folds[#folds + 1] = { f = f, d = 0.02 + i * 0.035, to = 0.4 + rnd() * 0.25 }
	end
	for i = 1, 4 do
		local f = new("Frame", { Name = "Facet", AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.15 + rnd() * 0.7, 0, 0.2 + rnd() * 0.6, 0),
			Size = UDim2.new(0.5 + rnd() * 0.4, 0, 0.9, 0), Rotation = rnd(-60, 60), BackgroundColor3 = WHITE,
			BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 39 }, card)
		new("UIGradient", { Rotation = rnd(0, 180), Transparency = NumberSequence.new({ KP(0, 0), KP(1, 1) }) }, f)
		folds[#folds + 1] = { f = f, d = 0.05 + i * 0.04, to = 0.8 + rnd() * 0.08 }
	end

	-- le trou noir (derrière la carte) : disque noir, anneau photonique, deux bras qui tournent, halo
	local hole = new("Frame", { Name = "BlackHole", AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, cy), Size = UDim2.fromOffset(160, 160), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 3 }, slot)
	local holeScale = new("UIScale", { Scale = 0 }, hole)
	local function disc(d, z, fill, ftr)
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(d, d), BackgroundColor3 = fill or BLACK, BackgroundTransparency = ftr or 1,
			BorderSizePixel = 0, ZIndex = z }, hole)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		return f
	end
	local function ring(d, z, thick, tr, seq)
		local f = disc(d, z)
		local st = new("UIStroke", { Color = WHITE, Thickness = thick, Transparency = tr, ApplyStrokeMode = BORDER }, f)
		local g = new("UIGradient", { Transparency = seq }, st)
		return g
	end
	disc(150, 1, WHITE, 0.965)
	ring(150, 1, 1, 0.8, NumberSequence.new(0))
	local arm1 = ring(128, 2, 2, 0.1, NumberSequence.new({ KP(0, 0), KP(0.38, 0.1), KP(0.5, 1), KP(1, 1) }))
	local arm2 = ring(100, 3, 3, 0.05, NumberSequence.new({ KP(0, 1), KP(0.5, 1), KP(0.58, 0.1), KP(1, 0) }))
	ring(78, 4, 2.5, 0, NumberSequence.new(0))
	disc(72, 5, BLACK, 0)
	TweenService:Create(arm1, TweenInfo.new(1.1 * k, LINEAR, OUT, -1), { Rotation = 360 * dirSpin }):Play()
	TweenService:Create(arm2, TweenInfo.new(0.75 * k, LINEAR, OUT, -1), { Rotation = -360 * dirSpin }):Play()

	local wave = new("Frame", { Name = "Shock", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, cy),
		Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 11 }, slot)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, wave)
	local wst = new("UIStroke", { Color = WHITE, Thickness = 2, Transparency = 1, ApplyStrokeMode = BORDER }, wave)

	-- morceaux de papier arrachés, aspirés en spirale
	local scraps = {}
	for i = 1, 12 do
		local sx, sy = (rnd() - 0.5) * cw * 0.85, (rnd() - 0.5) * h * 0.8
		local f = new("Frame", { Name = "Scrap", AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(rnd(3, 6), rnd(2, 4)), BackgroundColor3 = (i % 3 == 0) and Color3.fromRGB(190, 190, 195) or WHITE,
			BackgroundTransparency = 1, BorderSizePixel = 0, Rotation = rnd(0, 180), ZIndex = 12 }, slot)
		scraps[i] = { f = f, r0 = math.sqrt(sx * sx + sy * sy), a0 = math.atan2(sy, sx), d = 0.06 + rnd() * 0.3,
			s = 4 + rnd() * 3, rot = (rnd() - 0.5) * 900 }
	end

	-- ouverture du trou noir, puis fermeture dans une onde de choc
	task.delay(0.05 * k, function()
		if hole.Parent then tween(holeScale, { Scale = 1 }, 0.35, BACK) end
	end)
	task.delay(0.9 * k, function()
		if not hole.Parent then return end
		tween(holeScale, { Scale = 0 }, 0.2, QUINT, IN)
		wave.Size = UDim2.fromOffset(40, 40)
		wst.Transparency = 0.1
		tween(wave, { Size = UDim2.fromOffset(190, 190) }, 0.35)
		tween(wst, { Transparency = 1 }, 0.35)
	end)
	task.delay(0.7 * k, function()
		if slot.Parent then tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, 0.3) end
	end)

	-- mouvement de la carte (une seule boucle : froissage, puis spirale vers le centre)
	local ang0 = rnd() * math.pi * 2
	local t0 = os.clock()
	task.spawn(function()
		while slot.Parent and card.Parent do
			local t = (os.clock() - t0) / k
			if t > TOT then break end
			local A = clamp(t / 0.34, 0, 1)                 -- froissage
			local eA = 1 - (1 - A) ^ 3
			local B = clamp((t - 0.2) / 0.75, 0, 1)         -- aspiration
			local shrink = 1 - B ^ 2.2
			local jit = 1 - B
			local w = (cw + (BALL_W - cw) * eA) * shrink * (1 + 0.05 * sin(t * 47) * jit)
			local hh = (h + (BALL_H - h) * eA) * shrink * (1 + 0.08 * sin(t * 53 + 1) * jit)
			card.Size = UDim2.fromOffset(math.max(w, 0), math.max(hh, 0))
			local r = R0 * (1 - B) * math.min(B * 4, 1)
			local ang = ang0 + dirSpin * (B * 7 + B * B * 6)
			local px, py = cos(ang) * r, sin(ang) * r * 0.8
			card.Position = UDim2.new(0.5, px, 0, cy + py)
			card.Rotation = 7 * sin(t * 36) * (1 - A) + dirSpin * 640 * B ^ 1.7
			if cardCornerObj then cardCornerObj.CornerRadius = UDim.new(0, 22 + 24 * eA) end
			local fade = clamp((B - 0.7) / 0.3, 0, 1)
			if canvasSupported then card.GroupTransparency = fade else card.BackgroundTransparency = fade end

			for _, p in ipairs(folds) do
				local u = clamp((t - p.d) / 0.1, 0, 1)
				p.f.BackgroundTransparency = 1 - u * (1 - p.to) * (1 - fade)
			end

			local gt = clamp(t / 0.42, 0, 1)
			for i, g in ipairs(ghosts) do
				if gt >= 1 then
					g.Visible = false
				else
					local amp = 7 * (1 - gt)
					g.Size = card.Size
					g.Position = UDim2.new(0.5, px + sin(t * 70 + i * 2.1) * amp, 0, cy + py + cos(t * 83 + i * 1.3) * amp)
					g.Rotation = card.Rotation + ((i == 1) and 3 or -3) * (1 - gt)
					g.GroupTransparency = 0.6 + 0.4 * gt
				end
			end

			for _, p in ipairs(scraps) do
				local u = clamp((t - p.d) / 0.55, 0, 1)
				if u > 0 then
					local e = u * u
					local rr = p.r0 * (1 - e)
					local aa = p.a0 + dirSpin * p.s * e
					p.f.Position = UDim2.new(0.5, cos(aa) * rr, 0, cy + sin(aa) * rr)
					p.f.Rotation = p.rot * u
					local tr = (u < 0.12) and (1 - u / 0.12 * 0.9) or 0.1
					if u > 0.8 then tr = math.min(1, 0.1 + (u - 0.8) * 4.5) end
					p.f.BackgroundTransparency = tr
				end
			end
			Ticker.wait()
		end
		for _, g in ipairs(ghosts) do g:Destroy() end
		for _, p in ipairs(scraps) do p.f:Destroy() end
	end)
end

-- ───────────── V9 : STYLES DE FERMETURE DES NOTIFICATIONS ─────────────
-- Library:SetNotifExit("Briser")   ·   Library.NotifExit   ·   Library.NotifExitStyles (liste des noms)
-- Library.NotifExitByType = { Error = "Briser", Success = "Tourbillon" }   (style différent selon le type)
-- Une notification peut aussi choisir le sien : Library:Notify({ ..., Exit = "Effacer vers le haut" })
-- Pour ajouter un style : ajoute son nom dans NotifExitStyles puis une fonction EXITS["Nom"] plus bas ;
-- elle reçoit (slot, card, cardScale, h) et renvoie la durée de l'animation en secondes.
Library.NotifExit = "Trou noir"
Library.NotifExitStyles = { "Trou noir", "Fondu", "Rétrécir", "Tourbillon", "Briser", "Casser", "Dissoudre",
	"Effacer vers le haut", "Effacer vers le bas", "Effacer vers la gauche", "Effacer vers la droite",
	"Glisser", "Aléatoire" }
Library.NotifExitByType = {}

local EXIT_SET = {}
for _, n in ipairs(Library.NotifExitStyles) do EXIT_SET[n] = true end

local function resolveExit(s)
	if type(s) ~= "string" or not EXIT_SET[s] then s = Library.NotifExit end
	if not EXIT_SET[s] then s = "Trou noir" end
	if s == "Aléatoire" then
		local pool = {}
		for _, n in ipairs(Library.NotifExitStyles) do
			if n ~= "Aléatoire" and n ~= "Glisser" then pool[#pool + 1] = n end
		end
		s = pool[math.random(#pool)]
	end
	if s == "Trou noir" and Library.NotifBlackHole == false then s = "Glisser" end
	return s
end

function Library:SetNotifExit(s)
	if EXIT_SET[s] then
		Library.NotifExit = s
		return true
	end
	return false
end

-- ───────────── V10 : STYLES D'ENTRÉE DES NOTIFICATIONS ─────────────
-- Désactivés par défaut (Library.NotifEntryCustom = false) : l'entrée classique (glissement + rebond) est gardée.
-- Library:SetNotifEntryEnabled(true) · Library:SetNotifEntry("Éclats") · Library.NotifEntryStyles (liste des noms)
-- Library.NotifEntryByType = { Error = "Éclats", Success = "Trou noir" } · Library:Notify({ ..., Entry = "Balayage depuis la gauche" })
Library.NotifEntryCustom = false
Library.NotifEntry = "Trou noir"
Library.NotifEntryStyles = { "Trou noir", "Éclats", "Balayage depuis la gauche", "Balayage depuis la droite",
	"Balayage depuis le haut", "Balayage depuis le bas", "Aléatoire" }
Library.NotifEntryByType = {}

local ENTRY_SET = {}
for _, n in ipairs(Library.NotifEntryStyles) do ENTRY_SET[n] = true end

local function resolveEntry(explicit, kind)
	if explicit == false or explicit == "Glisser" then return nil end
	local s
	if type(explicit) == "string" and ENTRY_SET[explicit] then
		s = explicit
	else
		if not Library.NotifEntryCustom then return nil end
		s = Library.NotifEntryByType and Library.NotifEntryByType[kind]
		if type(s) ~= "string" or not ENTRY_SET[s] then s = Library.NotifEntry end
		if not ENTRY_SET[s] then s = "Trou noir" end
	end
	if s == "Aléatoire" then
		local pool = {}
		for _, n in ipairs(Library.NotifEntryStyles) do
			if n ~= "Aléatoire" then pool[#pool + 1] = n end
		end
		s = pool[math.random(#pool)]
	end
	return s
end

function Library:SetNotifEntry(s)
	if ENTRY_SET[s] then
		Library.NotifEntry = s
		return true
	end
	return false
end

function Library:SetNotifEntryEnabled(v)
	Library.NotifEntryCustom = v and true or false
end

do
	local EXITS = {}
	local KP = NumberSequenceKeypoint.new
	local IN, INOUT = Enum.EasingDirection.In, Enum.EasingDirection.InOut
	local WHITE = Color3.new(1, 1, 1)
	local function K() return 1 / math.max(Library.AnimSpeed or 1, 0.05) end

	-- fige la carte en pixels (sa hauteur automatique ne doit plus bouger) et renvoie sa largeur
	local function freezeCard(card, cardScale, h)
		local cw = card.AbsoluteSize.X / math.max(cardScale.Scale, 0.01)
		if cw < 10 then cw = Library.NotifWidth or 300 end
		card.AutomaticSize = AN
		card.Size = UDim2.fromOffset(cw, h)
		cardScale.Scale = 1
		return cw
	end
	local function fadeCard(card, to, t, style, dir)
		if canvasSupported then
			tween(card, { GroupTransparency = to }, t, style, dir)
		else
			tween(card, { BackgroundTransparency = (to >= 1) and 1 or (Sty.NotifTr or 0.03) }, t, style, dir)
		end
	end
	-- la place de la notification se referme (les autres remontent / descendent en douceur)
	local function collapse(slot, delay, t)
		task.delay(delay * K(), function()
			if slot.Parent then tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, t) end
		end)
	end

	-- FONDU : la carte s'efface sur place
	EXITS["Fondu"] = function(slot, card, cardScale, h)
		collapse(slot, 0.3, 0.3)
		fadeCard(card, 1, 0.4)
		tween(cardScale, { Scale = 0.96 }, 0.4)
		return 0.7
	end

	-- RÉTRÉCIR : la carte se rétracte vers son centre
	EXITS["Rétrécir"] = function(slot, card, cardScale, h)
		freezeCard(card, cardScale, h)
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.new(0.5, 0, 0, h / 2)
		tween(cardScale, { Scale = 0 }, 0.45, BACK, IN)
		fadeCard(card, 1, 0.45, QUINT, IN)
		collapse(slot, 0.3, 0.3)
		return 0.75
	end

	-- TOURBILLON : la carte tourne de plus en plus vite dans un anneau de vortex et se fait aspirer
	EXITS["Tourbillon"] = function(slot, card, cardScale, h)
		freezeCard(card, cardScale, h)
		local k = K()
		local dirSpin = (math.random() < 0.5) and -1 or 1
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.new(0.5, 0, 0, h / 2)
		card.ZIndex = 10
		local function vortex(d, thick, tr, dur)
			local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, h / 2),
				Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3 }, slot)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
			local st = new("UIStroke", { Color = T.Accent, Thickness = thick, Transparency = tr, ApplyStrokeMode = BORDER }, f)
			local g = new("UIGradient", { Color = ColorSequence.new(WHITE, Color3.fromRGB(60, 60, 68)),
				Transparency = ringSeq() }, st)
			tween(f, { Size = UDim2.fromOffset(d, d) }, 0.35, BACK)
			TweenService:Create(g, TweenInfo.new(dur * k, LINEAR, OUT, -1), { Rotation = 360 * dirSpin }):Play()
			task.delay(0.72 * k, function()
				if f.Parent then tween(f, { Size = UDim2.fromOffset(0, 0) }, 0.25, QUINT, IN) end
			end)
		end
		vortex(150, 2, 0.1, 0.6)
		vortex(104, 1.5, 0.4, -0.45)
		tween(card, { Rotation = dirSpin * 620 }, 0.85, QUINT, IN)
		tween(cardScale, { Scale = 0 }, 0.85, QUINT, IN)
		task.delay(0.5 * k, function()
			if card.Parent then fadeCard(card, 1, 0.3) end
		end)
		collapse(slot, 0.6, 0.3)
		return 1.0
	end

	-- EFFACER vers le haut / bas / gauche / droite : un masque rogne la carte, un trait lumineux suit le bord
	local function wipe(slot, card, cardScale, h, side)
		local cw = freezeCard(card, cardScale, h)
		card.AnchorPoint = Vector2.new(0, 0)
		local mask = new("Frame", { Name = "Wipe", BackgroundTransparency = 1, BorderSizePixel = 0,
			ClipsDescendants = true, ZIndex = 10 }, slot)
		local line = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0,
			BackgroundTransparency = 0.15, ZIndex = 30 }, slot)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, line)
		local vertical = (side == "up" or side == "down")
		new("UIGradient", { Rotation = vertical and 0 or 90,
			Transparency = NumberSequence.new({ KP(0, 1), KP(0.5, 0), KP(1, 1) }) }, line)
		local goalSize, lineFrom, lineTo
		if side == "up" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 0), UDim2.fromOffset(0, 0), UDim2.fromOffset(cw, h)
			card.Position = UDim2.fromOffset(0, 0)
			goalSize = UDim2.fromOffset(cw, 0)
			line.Size = UDim2.fromOffset(cw - 30, 2)
			lineFrom, lineTo = UDim2.fromOffset(cw / 2, h), UDim2.fromOffset(cw / 2, 0)
		elseif side == "down" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 1), UDim2.new(0, 0, 1, 0), UDim2.fromOffset(cw, h)
			card.Position = UDim2.new(0, 0, 1, -h)
			goalSize = UDim2.fromOffset(cw, 0)
			line.Size = UDim2.fromOffset(cw - 30, 2)
			lineFrom, lineTo = UDim2.fromOffset(cw / 2, 0), UDim2.fromOffset(cw / 2, h)
		elseif side == "left" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 0), UDim2.fromOffset(0, 0), UDim2.fromOffset(cw, h)
			card.Position = UDim2.fromOffset(0, 0)
			goalSize = UDim2.fromOffset(0, h)
			line.Size = UDim2.fromOffset(2, h - 20)
			lineFrom, lineTo = UDim2.fromOffset(cw, h / 2), UDim2.fromOffset(0, h / 2)
		else
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(1, 0), UDim2.new(1, 0, 0, 0), UDim2.fromOffset(cw, h)
			card.Position = UDim2.new(1, -cw, 0, 0)
			goalSize = UDim2.fromOffset(0, h)
			line.Size = UDim2.fromOffset(2, h - 20)
			lineFrom, lineTo = UDim2.fromOffset(0, h / 2), UDim2.fromOffset(cw, h / 2)
		end
		line.Position = lineFrom
		card.Parent = mask
		tween(mask, { Size = goalSize }, 0.55, QUINT, INOUT)
		tween(line, { Position = lineTo }, 0.55, QUINT, INOUT)
		task.delay(0.45 * K(), function()
			if line.Parent then tween(line, { BackgroundTransparency = 1 }, 0.15) end
		end)
		collapse(slot, 0.4, 0.3)
		return 0.8
	end
	EXITS["Effacer vers le haut"]    = function(s, c, cs, h) return wipe(s, c, cs, h, "up") end
	EXITS["Effacer vers le bas"]     = function(s, c, cs, h) return wipe(s, c, cs, h, "down") end
	EXITS["Effacer vers la gauche"]  = function(s, c, cs, h) return wipe(s, c, cs, h, "left") end
	EXITS["Effacer vers la droite"]  = function(s, c, cs, h) return wipe(s, c, cs, h, "right") end

	-- BRISER / CASSER / DISSOUDRE : la carte est découpée en morceaux (copies rognées) qui s'envolent
	--   shatter : grille de 6x3 éclats projetés + gravité · crack : cassée en deux (trait de fissure) ·
	--   dissolve : fine grille de 9x3 qui s'efface de gauche à droite en s'élevant
	local function shards(slot, card, cardScale, h, mode)
		local cw = freezeCard(card, cardScale, h)
		local k = K()
		local cols, rows
		if mode == "crack" then cols, rows = 2, 1
		elseif mode == "dissolve" then cols, rows = 9, 3
		else cols, rows = 6, 3 end
		local sw, sh = cw / cols, h / rows
		local rng = Random.new()
		local pieces, total = {}, 0

		for r = 0, rows - 1 do
			for c = 0, cols - 1 do
				local x, y = c * sw, r * sh
				local box = new(canvasSupported and "CanvasGroup" or "Frame", { AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(x + sw / 2, y + sh / 2),
					Size = UDim2.fromOffset(math.ceil(sw) + 1, math.ceil(sh) + 1), BackgroundTransparency = 1,
					BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 10 }, slot)
				local bs = new("UIScale", { Scale = 1 }, box)
				local cl = card:Clone()
				cl.Name = "Shard"
				cl.AutomaticSize = AN
				cl.Size = UDim2.fromOffset(cw, h)
				cl.AnchorPoint = Vector2.new(0, 0)
				cl.Position = UDim2.fromOffset(-math.floor(x), -math.floor(y))
				cl.Rotation = 0
				cl.Visible = true
				if canvasSupported then cl.GroupTransparency = 0 end
				local us = cl:FindFirstChildOfClass("UIScale")
				if us then us.Scale = 1 end
				for _, d in ipairs(cl:GetDescendants()) do
					if d:IsA("GuiButton") then d.Active = false end
				end
				cl.Parent = box

				local cx = ((c + 0.5) / cols) * 2 - 1
				local cy = ((r + 0.5) / rows) * 2 - 1
				local p = { box = box, bs = bs, x = x + sw / 2, y = y + sh / 2, rot = 0 }
				if mode == "crack" then
					p.d, p.life, p.g = 0.3, 0.95, 900
					p.vx, p.vy = cx * 55, 0
					p.rv = cx * 150
				elseif mode == "dissolve" then
					p.d = (c / cols) * 0.32 + rng:NextNumber(0, 0.18)
					p.life, p.g = 0.32, 0
					p.vx, p.vy = rng:NextNumber(-16, 16), rng:NextNumber(-70, -20)
					p.rv = rng:NextNumber(-40, 40)
				else
					p.d = rng:NextNumber(0, 0.1) + math.abs(cx) * 0.04
					p.life, p.g = 0.95, 1000
					p.vx = cx * rng:NextNumber(70, 200) + rng:NextNumber(-40, 40)
					p.vy = cy * rng:NextNumber(40, 100) - rng:NextNumber(60, 180)
					p.rv = rng:NextNumber(-280, 280)
				end
				total = math.max(total, p.d + p.life)
				pieces[#pieces + 1] = p
			end
		end
		card.Visible = false

		if mode == "crack" then
			local segs = 4
			local segH = h / segs
			for i = 1, segs do
				local odd = (i % 2 == 1)
				local sg = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(cw / 2 + (odd and -4 or 4), (i - 0.5) * segH),
					Size = UDim2.fromOffset(2, segH * 1.3), Rotation = odd and -14 or 14, BackgroundColor3 = WHITE,
					BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 40 }, slot)
				task.delay(0.28 * k, function()
					if sg.Parent then tween(sg, { BackgroundTransparency = 1 }, 0.3) end
				end)
			end
		end

		collapse(slot, mode == "dissolve" and 0.45 or 0.55, 0.3)
		task.spawn(function()
			local t0 = os.clock()
			local last = t0
			while slot.Parent do
				Ticker.wait()
				local now = os.clock()
				local dt = math.min(now - last, 0.05) / k
				last = now
				local t = (now - t0) / k
				if t > total then break end
				for _, p in ipairs(pieces) do
					local u = t - p.d
					if u > 0 and p.box.Parent then
						p.vy = p.vy + p.g * dt
						p.x = p.x + p.vx * dt
						p.y = p.y + p.vy * dt
						p.rot = p.rot + p.rv * dt
						local f = math.clamp(u / p.life, 0, 1)
						p.box.Position = UDim2.fromOffset(p.x, p.y)
						p.box.Rotation = p.rot
						if canvasSupported then
							p.box.GroupTransparency = f ^ 1.4
							p.bs.Scale = (mode == "dissolve") and (1 - 0.4 * f) or 1
						else
							p.bs.Scale = math.max(1 - f, 0)
						end
					end
				end
			end
		end)
		return total + 0.1
	end
	EXITS["Briser"]    = function(s, c, cs, h) return shards(s, c, cs, h, "shatter") end
	EXITS["Casser"]    = function(s, c, cs, h) return shards(s, c, cs, h, "crack") end
	EXITS["Dissoudre"] = function(s, c, cs, h) return shards(s, c, cs, h, "dissolve") end

	-- ─────────── STYLES D'ENTRÉE ───────────
	-- Chaque style reçoit (slot, card, cardScale, h, cw) et renvoie (durée en secondes d'animation, fonction de nettoyage).
	-- La carte est remise en état normal par Notify (settleCard) une fois l'animation finie.
	local ENTER = {}

	-- TROU NOIR : un trou noir s'ouvre, la carte en sort en tournant et s'agrandit, puis le trou se referme
	ENTER["Trou noir"] = function(slot, card, cardScale, h, cw)
		local k = K()
		local dirSpin = (math.random() < 0.5) and -1 or 1
		freezeCard(card, cardScale, h)
		if canvasSupported then card.GroupTransparency = 0 end
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.new(0.5, 0, 0, h / 2)
		card.ZIndex = 10
		cardScale.Scale = 0
		card.Rotation = dirSpin * -240
		local made = {}
		local function ring(d, thick, tr, dur, black)
			local fr = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, h / 2),
				Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = black and 0 or 1, BorderSizePixel = 0, ZIndex = 3 }, slot)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, fr)
			local sk = new("UIStroke", { Color = T.Accent, Thickness = thick, Transparency = tr, ApplyStrokeMode = BORDER }, fr)
			local g = new("UIGradient", { Color = ColorSequence.new(WHITE, Color3.fromRGB(60, 60, 68)),
				Transparency = ringSeq() }, sk)
			tween(fr, { Size = UDim2.fromOffset(d, d) }, 0.3, BACK)
			TweenService:Create(g, TweenInfo.new(math.abs(dur) * k, LINEAR, OUT, -1),
				{ Rotation = 360 * ((dur < 0) and -dirSpin or dirSpin) }):Play()
			task.delay(0.55 * k, function()
				if fr.Parent then tween(fr, { Size = UDim2.fromOffset(0, 0) }, 0.3, QUINT, IN) end
			end)
			made[#made + 1] = fr
		end
		local D = math.clamp(cw * 0.45, 110, 160)
		ring(D, 2, 0.1, 0.6, true)
		ring(D * 0.7, 1.5, 0.4, -0.45, false)
		task.delay(0.1 * k, function()
			if not card.Parent then return end
			tween(cardScale, { Scale = 1 }, 0.6, BACK)
			tween(card, { Rotation = 0 }, 0.6)
		end)
		return 0.9, function()
			for _, fr in ipairs(made) do fr:Destroy() end
		end
	end

	-- ÉCLATS : la carte est découpée en 6x3 morceaux, dispersés, qui volent vers leur place et se recomposent
	ENTER["Éclats"] = function(slot, card, cardScale, h, cw)
		local k = K()
		freezeCard(card, cardScale, h)
		card.AnchorPoint = Vector2.new(0, 0)
		card.Position = UDim2.new(0, 0, 0, 0)
		if canvasSupported then card.GroupTransparency = 0 end
		local cols, rows = 6, 3
		local sw, sh = cw / cols, h / rows
		local rng = Random.new()
		local pieces, total = {}, 0
		local alive = true
		local function clear()
			for _, p in ipairs(pieces) do
				if p.box.Parent then p.box:Destroy() end
			end
		end
		for r = 0, rows - 1 do
			for c = 0, cols - 1 do
				local x, y = c * sw, r * sh
				local hx, hy = x + sw / 2, y + sh / 2
				local cx = ((c + 0.5) / cols) * 2 - 1
				local cy = ((r + 0.5) / rows) * 2 - 1
				local p = { hx = hx, hy = hy, d = rng:NextNumber(0, 0.18), life = 0.55,
					sx = hx + cx * rng:NextNumber(70, 190) + rng:NextNumber(-40, 40),
					sy = hy + cy * rng:NextNumber(30, 90) - rng:NextNumber(50, 150),
					sr = rng:NextNumber(-260, 260) }
				local box = new(canvasSupported and "CanvasGroup" or "Frame", { Name = "ShardIn",
					AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(p.sx, p.sy), Rotation = p.sr,
					Size = UDim2.fromOffset(math.ceil(sw) + 1, math.ceil(sh) + 1), BackgroundTransparency = 1,
					BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 10 }, slot)
				if canvasSupported then box.GroupTransparency = 1 end
				local bs = new("UIScale", { Scale = canvasSupported and 1 or 0 }, box)
				local cl = card:Clone()
				cl.Name = "Shard"
				cl.AutomaticSize = AN
				cl.Size = UDim2.fromOffset(cw, h)
				cl.AnchorPoint = Vector2.new(0, 0)
				cl.Position = UDim2.fromOffset(-math.floor(x), -math.floor(y))
				cl.Rotation = 0
				cl.Visible = true
				if canvasSupported then cl.GroupTransparency = 0 end
				for _, d in ipairs(cl:GetDescendants()) do
					if d:IsA("GuiButton") then d.Active = false end
				end
				cl.Parent = box
				p.box, p.bs = box, bs
				total = math.max(total, p.d + p.life)
				pieces[#pieces + 1] = p
			end
		end
		card.Visible = false
		task.spawn(function()
			local t0 = os.clock()
			while alive and slot.Parent do
				Ticker.wait()
				local t = (os.clock() - t0) / k
				if t > total then break end
				for _, p in ipairs(pieces) do
					local u = t - p.d
					if u > 0 and p.box.Parent then
						local f = math.clamp(u / p.life, 0, 1)
						local e = 1 - (1 - f) ^ 3
						p.box.Position = UDim2.fromOffset(p.sx + (p.hx - p.sx) * e, p.sy + (p.hy - p.sy) * e)
						p.box.Rotation = p.sr * (1 - e)
						if canvasSupported then
							p.box.GroupTransparency = math.clamp(1 - f * 2.2, 0, 1)
						else
							p.bs.Scale = e
						end
					end
				end
			end
			if alive then
				alive = false
				clear()
				if card.Parent then card.Visible = true end
			end
		end)
		return total + 0.05, function()
			alive = false
			clear()
			card.Visible = true
		end
	end

	-- BALAYAGE : un masque révèle la carte depuis un côté, un trait lumineux suit le bord
	local function wipeIn(slot, card, cardScale, h, cw, side)
		local k = K()
		freezeCard(card, cardScale, h)
		if canvasSupported then card.GroupTransparency = 0 end
		card.AnchorPoint = Vector2.new(0, 0)
		local mask = new("Frame", { Name = "WipeIn", BackgroundTransparency = 1, BorderSizePixel = 0,
			ClipsDescendants = true, ZIndex = 10 }, slot)
		local line = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0,
			BackgroundTransparency = 0.15, ZIndex = 30 }, slot)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, line)
		local vertical = (side == "top" or side == "bottom")
		new("UIGradient", { Rotation = vertical and 0 or 90,
			Transparency = NumberSequence.new({ KP(0, 1), KP(0.5, 0), KP(1, 1) }) }, line)
		local goal, lineFrom, lineTo
		if side == "left" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 0), UDim2.fromOffset(0, 0), UDim2.fromOffset(0, h)
			card.Position = UDim2.fromOffset(0, 0)
			line.Size = UDim2.fromOffset(2, h - 20)
			lineFrom, lineTo = UDim2.fromOffset(0, h / 2), UDim2.fromOffset(cw, h / 2)
		elseif side == "right" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(1, 0), UDim2.fromOffset(cw, 0), UDim2.fromOffset(0, h)
			card.Position = UDim2.new(1, -cw, 0, 0)
			line.Size = UDim2.fromOffset(2, h - 20)
			lineFrom, lineTo = UDim2.fromOffset(cw, h / 2), UDim2.fromOffset(0, h / 2)
		elseif side == "top" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 0), UDim2.fromOffset(0, 0), UDim2.fromOffset(cw, 0)
			card.Position = UDim2.fromOffset(0, 0)
			line.Size = UDim2.fromOffset(cw - 30, 2)
			lineFrom, lineTo = UDim2.fromOffset(cw / 2, 0), UDim2.fromOffset(cw / 2, h)
		else
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 1), UDim2.fromOffset(0, h), UDim2.fromOffset(cw, 0)
			card.Position = UDim2.new(0, 0, 1, -h)
			line.Size = UDim2.fromOffset(cw - 30, 2)
			lineFrom, lineTo = UDim2.fromOffset(cw / 2, h), UDim2.fromOffset(cw / 2, 0)
		end
		goal = UDim2.fromOffset(cw, h)
		line.Position = lineFrom
		card.Parent = mask
		tween(mask, { Size = goal }, 0.55, QUINT, INOUT)
		tween(line, { Position = lineTo }, 0.55, QUINT, INOUT)
		task.delay(0.45 * k, function()
			if line.Parent then tween(line, { BackgroundTransparency = 1 }, 0.15) end
		end)
		return 0.7, function()
			if card.Parent == mask then card.Parent = slot end
			mask:Destroy()
			line:Destroy()
		end
	end
	ENTER["Balayage depuis la gauche"] = function(s, c, cs, h, cw) return wipeIn(s, c, cs, h, cw, "left") end
	ENTER["Balayage depuis la droite"] = function(s, c, cs, h, cw) return wipeIn(s, c, cs, h, cw, "right") end
	ENTER["Balayage depuis le haut"]   = function(s, c, cs, h, cw) return wipeIn(s, c, cs, h, cw, "top") end
	ENTER["Balayage depuis le bas"]    = function(s, c, cs, h, cw) return wipeIn(s, c, cs, h, cw, "bottom") end

	-- appelé par l'entrée : renvoie (durée en secondes d'animation, fonction de nettoyage)
	V6.enter = function(style, slot, card, cardScale, h, cw)
		local f = ENTER[style]
		if f then
			local ok, d, c = pcall(f, slot, card, cardScale, h, cw)
			if ok and tonumber(d) then
				return d, (type(c) == "function") and c or function() end
			end
			warn("[Ui-Lib] Style d'entrée « " .. tostring(style) .. " » : " .. tostring(d))
		end
		return 0.01, function() end
	end
	V6.resolveEntry = resolveEntry

	-- appelé par la fermeture : renvoie la durée (en secondes d'animation)
	V6.exit = function(style, slot, card, cardScale, h)
		local f = EXITS[style]
		if f then
			local ok, d = pcall(f, slot, card, cardScale, h)
			if ok and tonumber(d) then return d end
			warn("[Ui-Lib] Style de fermeture « " .. tostring(style) .. " » : " .. tostring(d))
		end
		fadeCard(card, 1, 0.35)
		collapse(slot, 0.2, 0.3)
		return 0.6
	end
	V6.resolveExit = resolveExit
end

	V6.play, V6.refresh, V6.hole = playNotifSound, refreshStack, blackHoleOut
end

function Library:Notify(o)
	if type(o) ~= "table" then o = { Content = tostring(o) } end
	local kind = NOTIF_ICON[o.Type] and o.Type or "Info"
	if (o.Progress ~= nil or o.Loading) and not NOTIF_ICON[o.Type] then kind = "Loading" end

	-- chargement de config en cours : les notifications des callbacks (« X activé »...) sont retenues, elles sont résumées
	-- dans Réglages > Changements de config + une seule notification « Config chargée »
	if (Library._cfgCapture or 0) > 0 and Library.CfgQuiet ~= false and not o.Force and not o._cfgSummary and kind ~= "Error" then
		return noopHandle()
	end

	-- historique (même si « Ne pas déranger »)
	local hist = Library.NotifHistory
	hist[#hist + 1] = { Time = os.time(), Title = tostring(o.Title or "Notification"),
		Content = tostring(o.Content or ""), Type = kind }
	while #hist > 50 do table.remove(hist, 1) end
	if Library.NotifMuted and not o.Force and kind ~= "Error" then return noopHandle() end

	-- doublon : on empile (x2, x3...) au lieu d'ajouter une carte
	local stackable = (o.Stack ~= false) and o.Progress == nil and not o.Loading
		and kind ~= "Loading" and not o.Actions
	local key = kind .. "|" .. tostring(o.Title or "") .. "|" .. tostring(o.Content or "")
	-- « ne plus afficher » : cette notification a été masquée par l'utilisateur
	if Library.NotifSilenced[key] and not o.Force then return noopHandle() end
	if stackable and Library.NotifStack then
		for _, e in ipairs(notifEntries) do
			if not e.dead and e.stackable and e.key == key then
				e.bump()
				V6.play(kind)
				return e.handle
			end
		end
	end

	ensureNotif()
	V6.play(kind)
	notifCount = notifCount + 1
	local top, left, center = notifSide()
	local width = Library.NotifWidth or 300

	-- mode : timer | progress | loading | sticky
	local dur = o.Duration
	if dur == nil then dur = Library.NotifDuration or 4 end
	dur = tonumber(dur) or 4
	local finiteDur = dur > 0 and dur < math.huge
	local mode
	if o.Progress ~= nil then mode = "progress"
	elseif o.Loading or kind == "Loading" then mode = "loading"
	elseif not finiteDur then mode = "sticky"
	else mode = "timer" end
	if not finiteDur then dur = Library.NotifDuration or 4 end
	local progress = math.clamp(tonumber(o.Progress) or 0, 0, 1)

	local function farOffset(sign)
		if center then return UDim2.new(0, 0, 0, top and -90 or 90) end
		local s = sign or (left and -1 or 1)
		return UDim2.new(0, s * (width + 40), 0, 0)
	end
	local inward = center and 0 or (left and 1 or -1)
	local nudge = UDim2.new(0, inward * 6, 0, center and (top and 3 or -3) or 0)
	local ZERO = UDim2.new(0, 0, 0, 0)

	-- ---------------------------------------------------------------- carte
	local slot = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AN, BackgroundTransparency = 1, BorderSizePixel = 0,
		LayoutOrder = top and -notifCount or notifCount,
	}, notifHolder)
	local card = new(canvasSupported and "CanvasGroup" or "Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Position = farOffset(),
