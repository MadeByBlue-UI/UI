	return tab
end

-- Onglet « Favoris » : regroupe les éléments marqués d'une étoile (copies synchronisées avec les originaux)
function Window:CreateFavoritesTab(name, icon)
	local win = self
	local tab = self:CreateTab(name or "Favoris", nil, icon)
	win.FavTab = tab

	local function proxy(blk, ent)
		local o = {}
		for k, v in pairs(ent.Opts) do o[k] = v end
		o.Flag = nil
		o.Favorite = false
		local item = ent.Item
		if ent.Kind ~= "Button" then
			local ok, cur = pcall(function() return item.Get() end)
			if ok and cur ~= nil then o.Default = cur end
			o.Callback = function(v) pcall(item.Set, item, v) end
		end
		pcall(function() blk["Create" .. ent.Kind](blk, o) end)
	end

	local function rebuild()
		tab:ClearBlocks()
		local keys = {}
		for k in pairs(Library.Favorites) do
			if Library.FavEntries[k] then keys[#keys + 1] = k end
		end
		table.sort(keys)
		local blk = tab:CreateBlock({ Name = "Favoris", Side = "Left" })
		blk._noFav = true
		if #keys == 0 then
			blk:CreateParagraph({ Title = "Aucun favori",
				Content = "Clique sur l'étoile ★ en haut à gauche d'un élément pour l'ajouter ici." })
			return
		end
		local last
		for _, k in ipairs(keys) do
			local ent = Library.FavEntries[k]
			local group = tostring(ent.Tab) .. " · " .. tostring(ent.Block)
			if group ~= last then blk:CreateSection(group) last = group end
			proxy(blk, ent)
		end
	end
	tab.OnSelect = rebuild
	rebuild()
	return tab
end

-- Onglet « Paramètres » prêt à l'emploi
function Window:CreateSettingsTab(name, icon, docked)
	local win = self
	local tab = self:CreateTab(name or "Paramètres", nil, icon)
	local N = Library.Names
	local function pct(v) return math.floor(v * 100 + 0.5) end
	local function toast(ok, okMsg, errMsg)
		Library:Notify({ Title = "Thème", Content = ok and okMsg or errMsg,
			Type = ok and "Success" or "Error", Duration = 3 })
	end
	local function opt(n) return function(v) Library:SetOption(n, v) end end
	local function optPct(n) return function(v) Library:SetOption(n, v / 100) end end

	-- ───────────── Style ─────────────
	local ST = tab:CreateBlock({ Name = "Style", Side = "Left" })
	ST:CreateSection("Style de l'interface")
	local styleInfo
