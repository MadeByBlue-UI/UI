function Library:_applyFlags(data)
	-- les réglages d'interface d'abord, pour que le reste s'affiche déjà avec le bon thème
	local later = {}
	for flag, value in pairs(data) do
		if string.sub(flag, 1, 3) == "ui." then
			local it = Library.Items[flag]
			if it and it.Set then pcall(it.Set, it, value) end
		else
			later[flag] = value
		end
	end
	for flag, value in pairs(later) do
		local it = Library.Items[flag]
		if it and it.Set then pcall(it.Set, it, value) end
	end
end

function Library:ExportConfig()
	return "UILIB-CONFIG:" .. HttpService:JSONEncode(Library.Flags)
end

function Library:ImportConfig(str)
	str = tostring(str or "")
	str = string.gsub(str, "^%s+", "")
	str = string.gsub(str, "^UILIB%-CONFIG:", "")
	str = string.gsub(str, "%s+$", "")
	local ok, data = pcall(function() return HttpService:JSONDecode(str) end)
	if not ok or type(data) ~= "table" then return false, "code invalide" end
	Library:_applyFlags(data)
	return true
end

function Library:ResetConfig(includeUi)
	local n = 0
	for flag, def in pairs(Library.Defaults) do
		local internal = string.sub(flag, 1, 2) == "__"
		local isUi = string.sub(flag, 1, 3) == "ui."
		if not internal and (includeUi or not isUi) then
			local it = Library.Items[flag]
			if it and it.Set then
				pcall(it.Set, it, copyVal(def))
				n += 1
			end
		end
	end
	return n
end

function Library:DuplicateConfig(a, b)
	a, b = safeName(a), safeName(b)
	if a == "" or b == "" then return false, "nom vide" end
	if not (readfile and writefile and isfile) then return false, "fichiers indisponibles" end
	local pa = Library.ConfigFolder .. "/" .. a .. ".json"
	local pb = Library.ConfigFolder .. "/" .. b .. ".json"
	if not isfile(pa) then return false, "introuvable" end
	local ok, err = pcall(function() writefile(pb, readfile(pa)) end)
	return ok, err
end

function Library:RenameConfig(a, b)
	local ok, err = Library:DuplicateConfig(a, b)
	if ok and safeName(a) ~= safeName(b) then Library:DeleteConfig(a) end
	return ok, err
end

