	local function rootView()
		return {
			root = true,
			build = function()
				local f = P.filter
				local favs, rest, out = {}, {}, {}
				for _, e in ipairs(entryList()) do
					local k = e.Kind
					local pass = (f == 1)
						or (f == 2 and Library.Favorites[e.Key])
						or (f == 3 and k == "Button")
						or (f == 4 and k == "Toggle")
						or (f == 5 and k ~= "Button" and k ~= "Toggle")
					if pass then
						local it = makeItem(e)
						if Library.Favorites[e.Key] then favs[#favs + 1] = it else rest[#rest + 1] = it end
					end
				end
				for _, it in ipairs(favs) do out[#out + 1] = it end
				if f == 1 or f == 3 then
					for _, b in ipairs(builtins()) do out[#out + 1] = b end
				end
				for _, it in ipairs(rest) do out[#out + 1] = it end
				return out
			end,
		}
	end

	local function matchScore(it, q)
		local n = string.lower(it.Name)
		local at = string.find(n, q, 1, true)
		if at == 1 then return 3 end
		if at then return 2 end
		local p = string.lower(tostring(it.Tab or "") .. " " .. tostring(it.Block or ""))
		if string.find(p, q, 1, true) then return 1 end
		return 0
	end

	local function visibleItems(v)
		if v.input or v.capture then return {} end
		local items = v.build()
		local q = string.lower(string.match(P.query, "^%s*(.-)%s*$") or "")
		if q == "" then return items end
		local scored = {}
		for idx, it in ipairs(items) do
			local s = matchScore(it, q)
			if s > 0 then scored[#scored + 1] = { it = it, s = s, i = idx } end
		end
		table.sort(scored, function(a, b)
			if a.s ~= b.s then return a.s > b.s end
			return a.i < b.i
		end)
		local out = {}
		for _, x in ipairs(scored) do out[#out + 1] = x.it end
		return out
	end

