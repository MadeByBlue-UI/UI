Library.TweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
Library.SlowTweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
Library.FastTweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function Library:Tween(obj, props, info)
    local tween = TweenService:Create(obj, info or self.TweenInfo, props)
    tween:Play()
    return tween
end

--- Register a function(dt, time) that runs every frame. Returns a handle with :Stop().
function Library:AddAnimation(fn)
    local handle = { Fn = fn, Active = true }
    function handle:Stop()
        self.Active = false
    end
    table.insert(self.Animations, handle)
    return handle
end

Library.Clock = 0

Library.Maid:Give(RunService.RenderStepped:Connect(function(dt)
    Library.Clock = Library.Clock + dt
    local list = Library.Animations
    for i = #list, 1, -1 do
        local handle = list[i]
        if not handle.Active then
            table.remove(list, i)
        else
            local ok, err = pcall(handle.Fn, dt, Library.Clock)
            if not ok then
                handle.Active = false
                warn("[Singularity] animation error: " .. tostring(err))
            end
        end
    end
end))

