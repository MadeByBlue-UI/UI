-- EMOTES de l'aperçu 3D (avatar R6) : coucou · pause · coucou · EMOTE · coucou · pause · coucou · EMOTE...
--   Option Emotes = true (Home l'active ; Library.HomeEmotes = false pour la couper). pv:PlayEmote(numéro | "Nom") en lance une tout de suite.
--   Library.PreviewEmotes = liste { Name, Dur, Fn(u, T, P) } : P.rs / ls (épaules), rh / lh (hanches), nk (cou), rt (torse) = CFrame
--   (rotations dans le repère du parent) ; Fn retourne : décalage vertical, tour sur soi (rad, axe Y), salto (rad, axe X).
--   Library.PreviewEmoteWave = durée d'un coucou (2 s) · Library.PreviewEmoteRest = pause entre les deux coucous (0,35 s).
-- ============================================================================
Library._initEmotes = function()   -- dans une fonction : ses variables locales n'entrent pas dans celles du chunk principal
	local A, sin, cos, pi, abs, floor, max, min = CFrame.Angles, math.sin, math.cos, math.pi, math.abs, math.floor, math.max, math.min
	local E = {}
	local function add(name, dur, fn) E[#E + 1] = { Name = name, Dur = dur, Fn = fn } end
	local RB_R = { 1.57, 0, 1.57, 0 }
	local RB_L = { 0, 1.57, 1.57, 0 }
	local RB_H = { 0, 0.7, 0, -0.7 }

	add("Joie", 2.6, function(u, T, P)
		local f = sin(T * 14) * 0.15
		P.rs, P.ls = A(0, 0, 2.8 + f), A(0, 0, -(2.8 - f))
		P.rh, P.lh = A(0, 0, 0.25), A(0, 0, -0.25)
		P.nk = A(0.15, 0, 0)
		return abs(sin(T * 5.5)) * 0.9, 0, 0
	end)
	add("Disco", 3.2, function(u, T, P)
		local s = sin(T * 5)
		P.rs, P.ls = A(0, 0, 1.55 + 1.2 * s), A(0, 0, -(1.55 - 1.2 * s))
		P.rt = A(0, s * 0.35, s * 0.12)
		P.nk = A(0, -s * 0.3, 0)
		return abs(sin(T * 5)) * 0.15, 0, 0
	end)
	add("Révérence", 2.4, function(u, T, P)
		local k = min(1, sin(pi * u) * 1.6)
		P.rt = A(-1.1 * k, 0, 0)
		P.rs, P.ls = A(0.6 * k, 0, 0.1), A(-0.4 * k, 0, -0.1)
		P.nk = A(-0.2 * k, 0, 0)
		return 0, 0, 0
	end)
	add("Robot", 3.2, function(u, T, P)
		local k = floor(T * 2.5) % 4 + 1
		P.rs, P.ls = A(RB_R[k], 0, 0.08), A(RB_L[k], 0, -0.08)
		P.nk = A(0, RB_H[k], 0)
		P.rt = A(0, RB_H[k] * 0.4, 0)
		return 0, 0, 0
	end)
	add("Pirouette", 1.6, function(u, T, P)
		P.rs, P.ls = A(0, 0, 1.45), A(0, 0, -1.45)
		return abs(sin(pi * u)) * 0.35, (u * u * (3 - 2 * u)) * 2 * pi, 0
	end)
	add("Applaudir", 2.6, function(u, T, P)
		local s = 0.5 + 0.5 * sin(T * 18)
		P.rs, P.ls = A(1.45, 0, -(0.05 + 0.25 * s)), A(1.45, 0, 0.05 + 0.25 * s)
		P.nk = A(-0.1 * sin(T * 6), 0, 0)
		return abs(sin(T * 4)) * 0.12, 0, 0
	end)
	add("Biceps", 2.6, function(u, T, P)
		local th = 1.5 + 0.35 * sin(T * 9)
		P.rs, P.ls = A(0, 0, th), A(0, 0, -(1.5 + 0.35 * sin(T * 9 + 1.2)))
		P.rt = A(0, sin(T * 4.5) * 0.25, 0)
		P.rh, P.lh = A(0, 0, 0.2), A(0, 0, -0.2)
		return abs(sin(T * 4.5)) * 0.1, 0, 0
	end)
	add("Salto", 1.5, function(u, T, P)
		P.rs, P.ls = A(2.6, 0, 0.1), A(2.6, 0, -0.1)
		P.rh, P.lh = A(0.9, 0, 0), A(0.9, 0, 0)
		return sin(pi * u) * 1.5, 0, -2 * pi * (u * u * (3 - 2 * u))
	end)
	add("Non !", 2.4, function(u, T, P)
		P.rs = A(-0.3, 0, 2.6 + sin(T * 14) * 0.25)
		P.ls = A(0, 0, -0.1)
		P.nk = A(0, sin(T * 10) * 0.5, 0)
		P.rt = A(0, sin(T * 10) * 0.1, 0)
		return 0, 0, 0
	end)
	add("Jumping jacks", 3.0, function(u, T, P)
		local s = 0.5 - 0.5 * cos(T * 9)
		P.rs, P.ls = A(0, 0, 0.08 + 2.75 * s), A(0, 0, -(0.08 + 2.75 * s))
		P.rh, P.lh = A(0, 0, 0.5 * s), A(0, 0, -0.5 * s)
		return abs(sin(T * 4.5)) * 0.55, 0, 0
	end)
	add("Marche", 3.0, function(u, T, P)
		local a = sin(T * 7) * 0.8
		P.rh, P.lh = A(a, 0, 0), A(-a, 0, 0)
		P.rs, P.ls = A(-a * 0.8, 0, 0.08), A(a * 0.8, 0, -0.08)
		P.rt = A(0, a * 0.12, 0)
		return abs(cos(T * 7)) * 0.08, 0, 0
	end)
	add("Zombie", 3.0, function(u, T, P)
		local w = sin(T * 3) * 0.08
		P.rs, P.ls = A(1.5 + w, 0, 0.05), A(1.5 - w, 0, -0.05)
		P.nk = A(-0.35, sin(T * 2) * 0.25, 0)
		P.rt = A(-0.25 + w * 0.6, sin(T * 2) * 0.15, 0)
		local a = sin(T * 3.5) * 0.35
		P.rh, P.lh = A(a, 0, 0), A(-a, 0, 0)
		return abs(sin(T * 3.5)) * 0.06, 0, 0
	end)
	add("Chercher", 3.0, function(u, T, P)
		P.rs = A(2.5, 0, -0.1)
		P.ls = A(0, 0, -0.5)
		P.nk = A(0, sin(T * 2.2) * 0.8, 0)
		P.rt = A(0, sin(T * 2.2) * 0.2, 0)
		return 0, 0, 0
	end)
	add("Super-héros", 2.4, function(u, T, P)
		P.rs = A(2.9, 0, 0.05)
		P.ls = A(0, 0, -0.45)
		P.rh, P.lh = A(0, 0, 0.15), A(0, 0, -0.15)
		P.rt = A(-0.25, 0, 0)
		P.nk = A(0.2, 0, 0)
		return 0.35 + sin(T * 3) * 0.12, 0, 0
	end)
	add("Coup de pied", 2.4, function(u, T, P)
		local s = max(0, sin(T * 6))
		P.rh = A(1.5 * s, 0, 0)
		P.rs, P.ls = A(1.2, 0, 0.3), A(1.0, 0, -0.3)
		P.rt = A(0.35 * s, 0, 0)
		return s * 0.08, 0, 0
	end)
	Library.PreviewEmotes = E
	Library.PreviewEmoteWave = Library.PreviewEmoteWave or 2.0
	Library.PreviewEmoteRest = Library.PreviewEmoteRest or 0.35

	-- séquenceur : étape 1 coucou · 2 pause · 3 coucou · 4 emote (puis on repart avec l'emote suivante)
	local function stageDur(st)
		if st.stage == 4 then
			local em = Library.PreviewEmotes[st.idx]
			return em and em.Dur or 2.5
		end
		return (st.stage == 2) and (Library.PreviewEmoteRest or 0.35) or (Library.PreviewEmoteWave or 2.0)
	end
	function Library._emoStep(st, dt)
		local n = #Library.PreviewEmotes
		if n == 0 then return end
		if st.force then
			st.stage, st.T, st.idx, st.force = 4, 0, st.force, nil
		end
		if st.idx > n then st.idx = 1 end
		st.T += dt
		local d, guard = stageDur(st), 0
		while st.T >= d and guard < 8 do
			guard += 1
			st.T -= d
			if st.stage == 4 then
				st.stage = 1
				st.idx = st.idx % n + 1
			else
				st.stage += 1
			end
			d = stageDur(st)
		end
		if guard >= 8 then st.T = 0 end
	end
	-- remplit P pour l'emote en cours ; retourne décalage vertical, tour (Y), salto (X) et l'enveloppe 0..1 (fondu entrée / sortie)
	function Library._emoPose(st, P)
		local em = Library.PreviewEmotes[st.idx]
		if st.stage ~= 4 or not em then return 0, 0, 0, 0 end
		local d, T = em.Dur, st.T
		local env = max(0, min(1, T / 0.3, (d - T) / 0.3))
		env = env * env * (3 - 2 * env)
		local ok, dy, spin, flip = pcall(em.Fn, T / d, T, P)
		if not ok then return 0, 0, 0, 0 end
		return (dy or 0) * env, spin or 0, flip or 0, env
	end
end
Library._initEmotes()

function Block:CreatePreview3D(o)
	if type(o) ~= "table" then o = { Name = o } end
	local title = o.Name
	if title == nil then title = "Aperçu 3D" end
	local cap = title ~= false and title ~= ""
	local h = math.clamp(tonumber(o.Height) or 240, 120, 520)
	local top = cap and 28 or 6
	local f = makeRow(self, h + top + 6, cap and title or "Aperçu 3D")
	local titleLbl
	if cap then
		titleLbl = label(f, title, 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 0, 28) })
	end

	local vp = new("ViewportFrame", {
		Position = UDim2.new(0, 8, 0, top), Size = UDim2.new(1, -16, 0, h),
		BackgroundColor3 = typeof(o.Background) == "Color3" and o.Background or Color3.fromRGB(10, 10, 13), BackgroundTransparency = 0, BorderSizePixel = 0,
		Ambient = typeof(o.Background) == "Color3" and Color3.fromRGB(200, 200, 205) or Color3.fromRGB(170, 170, 176), LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.6, -1, -0.5), ClipsDescendants = true, Active = true,
	}, f)
	corner(vp, 6)
	-- calque 2D (box, squelette, texte...) posé au-dessus du rendu 3D
	local ov = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 2 }, vp)

	-- ---------------------------------------------------------------- options
	local opt = {}
	for k, v in pairs(PV_DEFAULTS) do opt[k] = v end
	local dirty = true
	local function setOpt(k, v)
		k = PV_KEYS[string.lower(tostring(k))]
		if not k then return false end
		local def = PV_DEFAULTS[k]
		if typeof(def) == "Color3" then
			v = pvColor(v, opt[k])
		elseif type(def) == "boolean" then
			v = v and true or false
		elseif type(def) == "number" then
			v = tonumber(v) or opt[k]
		else
			if type(v) == "table" then return false end   -- ex. dropdown multi : ignoré
			v = tostring(v)
		end
		if opt[k] ~= v then
			opt[k] = v
			dirty = true
		end
		return true
	end
	for k, v in pairs(o.Options or o.Defaults or {}) do setOpt(k, v) end

	-- ---------------------------------------------------------------- modèle (rig R6 factice OU ton personnage)
	local rig, fit
	local J = {}
	local poseFn = function() end
	local bodyParts, decals, hides = {}, {}, {}
	local charSrc
	if o.Character == true then charSrc = LP elseif typeof(o.Character) == "Instance" then charSrc = o.Character end

	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Shape = Enum.PartType.Cylinder
	floor.Color = typeof(o.FloorColor) == "Color3" and o.FloorColor or Color3.fromRGB(26, 26, 31)
	floor.Material = Enum.Material.SmoothPlastic
	floor.Anchored, floor.CanCollide, floor.CanQuery, floor.CanTouch, floor.CastShadow = true, false, false, false, false
	floor.Parent = vp

	-- Highlight (si le moteur l'affiche dans un ViewportFrame ; sinon repli : teinte du corps)
	local hl
	pcall(function()
		hl = Instance.new("Highlight")
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Enabled = false
		hl.Parent = vp
	end)

	local function cornersFor(size, center)
		local out = {}
		for _, x in ipairs({ -0.5, 0.5 }) do
			for _, y in ipairs({ -0.5, 0.5 }) do
				for _, z in ipairs({ -0.5, 0.5 }) do
					out[#out + 1] = center + Vector3.new(x * size.X, y * size.Y, z * size.Z)
				end
			end
		end
		return out
	end

	local jumpPending, jumpT0, jumpApplied = false, nil, 0   -- saut (voir plus bas)
	local welcomePending, welcomeT0 = false, nil              -- animation de bienvenue (2 sauts, bras levés)
	local function finishModel()
		-- état d'origine de chaque pièce (pour les chams) + sol + Highlight
		bodyParts, decals, hides = {}, {}, {}
		for _, d in ipairs(rig:GetDescendants()) do
			if d:IsA("BasePart") then
				local tex = d:IsA("MeshPart") and d.TextureID ~= "" and d.TextureID or nil
				bodyParts[#bodyParts + 1] = { p = d, color = d.Color, mat = d.Material, tr = d.Transparency, tex = tex }
			elseif d:IsA("Decal") or d:IsA("Texture") then
				decals[#decals + 1] = { d = d, tr = d.Transparency }
			elseif d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("SurfaceAppearance") then
				hides[#hides + 1] = { i = d, parent = d.Parent }
			end
		end
		local dia = math.max(fit.size.X, fit.size.Z) * 1.8
		floor.Size = Vector3.new(0.1, dia, dia)
		floor.CFrame = CFrame.new(fit.focus.X, fit.focus.Y - fit.size.Y / 2 - 0.05, fit.focus.Z) * CFrame.Angles(0, 0, math.pi / 2)
		if hl then hl.Adornee = rig end
		dirty = true
		jumpApplied = 0
	end

	local function clearRig()
		if rig then
			for _, e in ipairs(hides) do   -- évite de laisser des textures « sorties » du modèle
				if e.i.Parent == nil then e.i.Parent = e.parent end
			end
			rig:Destroy()
			rig = nil
		end
	end

	local function buildMock()
		clearRig()
		rig = new("Model", { Name = "R6Rig" }, vp)
		local function mk(name, size, color)
			local p = Instance.new("Part")
			p.Name = name
			p.Size = size
			p.Color = color
			p.Material = Enum.Material.SmoothPlastic
			p.Anchored = true
			p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = false, false, false, false
			p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			p.Parent = rig
			return p
		end
		local skin = Color3.fromRGB(245, 205, 48)
		local head = mk("Head", Vector3.new(2, 1, 1), skin)
		local hm = Instance.new("SpecialMesh")
		hm.MeshType = Enum.MeshType.Head
		hm.Scale = Vector3.new(1.25, 1.25, 1.25)
		hm.Parent = head
		pcall(function()
			local face = Instance.new("Decal")
			face.Face = Enum.NormalId.Front
			face.Texture = "rbxasset://textures/face.png"
			face.Parent = head
		end)
		local torso = mk("Torso", Vector3.new(2, 2, 1), Color3.fromRGB(13, 105, 172))
		local armL = mk("Left Arm", Vector3.new(1, 2, 1), skin)
		local armR = mk("Right Arm", Vector3.new(1, 2, 1), skin)
		local legL = mk("Left Leg", Vector3.new(1, 2, 1), Color3.fromRGB(40, 127, 71))
		local legR = mk("Right Leg", Vector3.new(1, 2, 1), Color3.fromRGB(40, 127, 71))
		head.CFrame = CFrame.new(0, 1.5, 0)
		torso.CFrame = CFrame.new(0, 0, 0)

		J = {
			head = Vector3.new(0, 1.5, 0), neck = Vector3.new(0, 1, 0), pelvis = Vector3.new(0, -1, 0),
			shL = Vector3.new(-1, 0.5, 0), shR = Vector3.new(1, 0.5, 0),
			hipL = Vector3.new(-0.5, -1, 0), hipR = Vector3.new(0.5, -1, 0),
		}
		local jj = J
		local function limb(part, pivot, off, ang, tip)
			local cf = CFrame.new(pivot) * CFrame.Angles(ang, 0, 0)
			part.CFrame = cf * CFrame.new(off)
			return cf * tip
		end
		poseFn = function(a, tt)
			tt = tt or 0
			if opt.Wave then a = 0 end
			jj.handL = limb(armL, jj.shL, Vector3.new(-0.5, -0.5, 0), a, Vector3.new(-0.5, -1.5, 0))
			jj.footL = limb(legL, jj.hipL, Vector3.new(0, -1, 0), -a, Vector3.new(0, -2, 0))
			jj.footR = limb(legR, jj.hipR, Vector3.new(0, -1, 0), a, Vector3.new(0, -2, 0))
			if opt.Wave then
				-- coucou : bras droit levé (pivot = haut de l'épaule), le poignet balance de gauche à droite
				local th = 2.55 + math.sin(tt * 7) * 0.3
				local cf = CFrame.new(1.5, 1, 0) * CFrame.Angles(-0.2, 0, th)
				armR.CFrame = cf * CFrame.new(0, -1, 0)
				jj.handR = cf * Vector3.new(0, -2, 0)
				head.CFrame = CFrame.new(0, 1.5, 0) * CFrame.Angles(math.sin(tt * 2) * 0.05, 0, math.sin(tt * 3.5) * 0.04)
			else
				jj.handR = limb(armR, jj.shR, Vector3.new(0.5, -0.5, 0), -a, Vector3.new(0.5, -1.5, 0))
				head.CFrame = CFrame.new(0, 1.5, 0)
			end
		end
		poseFn(0)
		fit = { focus = PV_FOCUS, size = Vector3.new(4, 5, 1), corners = PV_CORNERS, dist = opt.Wave and 10.8 or 9.6, animated = true }
		finishModel()
	end

	local function buildCharacter(src)
		local ok, clone = pcall(function()
			local was = src.Archivable
			src.Archivable = true
			local c = src:Clone()
			src.Archivable = was
			return c
		end)
		if not ok or not clone then return false end
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("Humanoid") or d:IsA("Animator") or d:IsA("Sound")
				or d:IsA("BillboardGui") or d:IsA("ForceField") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = false, false, false, false
			end
		end
		-- (FIX) on ne garde que le corps : outils et modèles accrochés au personnage retirés, ainsi que toute pièce trop éloignée du torse
		-- (jouets, objets ancrés...). Sinon la boîte englobante devient énorme : personnage minuscule, décentré, sol géant.
		for _, d in ipairs(clone:GetChildren()) do
			if d:IsA("Tool") or d:IsA("Model") or d:IsA("Folder") or d:IsA("Backpack") then d:Destroy() end
		end
		local anchorPart = clone:FindFirstChild("HumanoidRootPart") or clone:FindFirstChild("UpperTorso")
			or clone:FindFirstChild("Torso") or clone:FindFirstChild("Head")
		if anchorPart and anchorPart:IsA("BasePart") then
			local origin = anchorPart.Position
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BasePart") and d ~= anchorPart and (d.Position - origin).Magnitude > 14 then d:Destroy() end
			end
		end
		local hasPart = false
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then hasPart = true break end
		end
		if not hasPart then
			clone:Destroy()
			return false
		end
		clearRig()
		rig = clone
		rig.Name = "Character"
		rig.Parent = vp
		rig:PivotTo(CFrame.new(0, 0, 0))
		local bcf, bsize = rig:GetBoundingBox()
		rig:PivotTo(rig:GetPivot() - bcf.Position)
		-- garde-fou : un personnage normal fait environ 4 x 5 x 2 ; au-delà (grosses pièces / accessoires démesurés) on borne le cadrage
		bsize = Vector3.new(math.clamp(bsize.X, 1, 9), math.clamp(bsize.Y, 1, 9), math.clamp(bsize.Z, 1, 6))

		local function part(n)
			local p = rig:FindFirstChild(n)
			return (p and p:IsA("BasePart")) and p or nil
		end
		local function top(p) return p and p.CFrame:PointToWorldSpace(Vector3.new(0, p.Size.Y / 2, 0)) end
		local function bot(p) return p and p.CFrame:PointToWorldSpace(Vector3.new(0, -p.Size.Y / 2, 0)) end
		local function ctr(p) return p and p.Position end
		local jj = {}
		jj.head = ctr(part("Head"))
		if part("UpperTorso") then   -- R15
			local ut, lt = part("UpperTorso"), part("LowerTorso")
			jj.neck, jj.pelvis = top(ut), ctr(lt) or bot(ut)
			jj.shL, jj.handL = top(part("LeftUpperArm")), bot(part("LeftHand"))
			jj.shR, jj.handR = top(part("RightUpperArm")), bot(part("RightHand"))
			jj.hipL, jj.footL = top(part("LeftUpperLeg")), bot(part("LeftFoot"))
			jj.hipR, jj.footR = top(part("RightUpperLeg")), bot(part("RightFoot"))
		elseif part("Torso") then   -- R6
			local tr = part("Torso")
			jj.neck, jj.pelvis = top(tr), bot(tr)
			jj.shL, jj.handL = top(part("Left Arm")), bot(part("Left Arm"))
			jj.shR, jj.handR = top(part("Right Arm")), bot(part("Right Arm"))
			jj.hipL, jj.footL = top(part("Left Leg")), bot(part("Left Leg"))
			jj.hipR, jj.footR = top(part("Right Leg")), bot(part("Right Leg"))
		end
		J = jj
		poseFn = function() end
		local center = Vector3.new(0, 0, 0)
		fit = { focus = center, size = bsize, corners = cornersFor(bsize, center),
			dist = 1.92 * math.max(bsize.Y, bsize.X * 0.9), animated = false }
		finishModel()
		return true
	end

	local function resolveSource()
		if typeof(charSrc) ~= "Instance" then return nil end
		if charSrc:IsA("Player") then return charSrc.Character end
		return charSrc
	end
	-- Avatar Roblox du joueur : celui de son COMPTE (pas un « noob »), récupéré par UserId (avec reprises) puis mis en cache.
	-- Même méthode que l'aperçu du Catalog Panel : modèle dans un WorldModel, articulations (Motor6D) animées à la main
	-- (les animations Roblox ne tournent pas dans un ViewportFrame). Pendant le chargement on affiche « Chargement de ton avatar… » ;
	-- le faux rig R6 n'est plus qu'un dernier recours si Roblox ne répond pas.
	local avatarTpl, avatarBusy
	local world
	local avJoints, avBase, avY, avSpin, avFlip = {}, nil, 0, 0, 0

	local loadLum = typeof(o.Background) == "Color3" and (o.Background.R * 0.3 + o.Background.G * 0.59 + o.Background.B * 0.11) or 0
	local loadLbl = new("TextLabel", { BackgroundTransparency = 1, Font = F_MED, TextSize = 12, Text = "Chargement de ton avatar…",
		TextColor3 = loadLum > 0.5 and Color3.fromRGB(35, 55, 75) or Color3.fromRGB(220, 220, 226),
		Size = UDim2.new(1, 0, 1, 0), Visible = false, ZIndex = 5 }, ov)

	-- séquenceur d'emotes (voir Library._emoStep) : un seul local, tout le reste dans cette table
	local EMO = { stage = 1, T = 0, idx = 1, wv = 1, y = 0, spin = 0, flip = 0, lbl = "", base = {}, em = {} }
	EMO.label = new("TextLabel", { BackgroundTransparency = 1, Font = F_MED, TextSize = 11, Text = "", TextColor3 = loadLbl.TextColor3,
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.new(1, -12, 0, 14),
		Visible = false, ZIndex = 5 }, ov)

	local function fetchAvatar()
		if avatarTpl then return avatarTpl end
		-- R6 automatiquement (même si ton compte est en R15 : la tenue est convertie) ; RigType = "R15" pour garder le R15
		local want = string.upper(tostring(o.RigType or Library.PreviewRigType or "R6"))
		local rigType = (want == "R15") and Enum.HumanoidRigType.R15 or Enum.HumanoidRigType.R6
		local function viaDescription()
			local desc = Players:GetHumanoidDescriptionFromUserId(LP.UserId)
			return Players:CreateHumanoidModelFromDescription(desc, rigType)
		end
		local function viaApplied()   -- tenue réellement portée en jeu (si l'avatar du compte ne répond pas)
			local ch = LP.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local desc = hum and hum:GetAppliedDescription()
			return Players:CreateHumanoidModelFromDescription(desc, rigType)
		end
		local function viaUserId()
			return Players:CreateHumanoidModelFromUserId(LP.UserId)
		end
		local m
		for attempt = 1, 3 do   -- les endpoints Roblox échouent souvent au 1er essai
			for _, fn in ipairs({ viaDescription, viaApplied, viaUserId }) do
				local ok, res = pcall(fn)
				if ok and typeof(res) == "Instance" and res:IsA("Model") then
					m = res
					break
				end
			end
			if m then break end
			task.wait(0.4 * attempt)
		end
		if not m then return nil end
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("LuaSourceContainer") then d:Destroy() end
		end
		m.Name = "PreviewAvatar"
		avatarTpl = m
		return m
	end

	-- Construit l'aperçu à partir du modèle de l'avatar (copie) : corps seul pour le cadrage, accessoires inclus à l'affichage.
	local function buildAvatar(tpl)
		local okc, clone = pcall(function() return tpl:Clone() end)
		if not okc or typeof(clone) ~= "Instance" then return false end
		local root = clone:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			clone:Destroy()
			return false
		end
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("BillboardGui") or d:IsA("ForceField") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.CanCollide, d.CanQuery, d.CanTouch = false, false, false
			end
		end
		local hum = clone:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
			pcall(function() hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff end)
			pcall(function() hum.EvaluateStateMachine = false end)
		end
		root.Anchored = true   -- seule la racine est ancrée : les membres suivent les articulations (Motor6D)
		if not clone.PrimaryPart then clone.PrimaryPart = root end

		clearRig()
		if not world or world.Parent ~= vp then
			world = Instance.new("WorldModel")   -- nécessaire pour que les articulations s'actualisent dans un ViewportFrame
			world.Name = "PreviewWorld"
			world.Parent = vp
		end
		rig = clone
		rig.Name = "Character"
		rig.Parent = world
		rig:PivotTo(CFrame.new(0, 0, 0))   -- orientation neutre : le personnage regarde vers -Z (de face pour la caméra)

		-- cadrage : on centre sur le CORPS seul (un accessoire démesuré ne doit pas dézoomer tout l'aperçu)
		local mn, mx
		for _, p in ipairs(rig:GetChildren()) do
			if p:IsA("BasePart") and p ~= root and p.Transparency < 0.99 then
				local cf, sz = p.CFrame, p.Size
				for _, x in ipairs({ -0.5, 0.5 }) do
					for _, y in ipairs({ -0.5, 0.5 }) do
						for _, z in ipairs({ -0.5, 0.5 }) do
							local c = cf:PointToWorldSpace(Vector3.new(x * sz.X, y * sz.Y, z * sz.Z))
							mn = mn and mn:Min(c) or c
							mx = mx and mx:Max(c) or c
						end
					end
				end
			end
		end
		if not mn then
			local bcf, bsz = rig:GetBoundingBox()
			mn, mx = bcf.Position - bsz / 2, bcf.Position + bsz / 2
		end
		local center = (mn + mx) / 2
		rig:PivotTo(rig:GetPivot() - center)
		avBase, avY = rig:GetPivot(), 0
		local size = mx - mn
		local bsize = Vector3.new(math.clamp(size.X, 1, 9), math.clamp(size.Y, 2, 9), math.clamp(size.Z, 1, 6))

		avJoints = {}
		for _, d in ipairs(rig:GetDescendants()) do
			if d:IsA("Motor6D") then avJoints[d.Name] = d end
		end
		local function pos(n)
			local p = rig:FindFirstChild(n)
			return (p and p:IsA("BasePart")) and p.Position or nil
		end
		local isR6 = rig:FindFirstChild("Torso") ~= nil and rig:FindFirstChild("UpperTorso") == nil
		if isR6 then
			local function ends(n)   -- haut / bas d'une pièce (R6 : un seul bloc par membre)
				local p = rig:FindFirstChild(n)
				if p and p:IsA("BasePart") then
					return p.CFrame:PointToWorldSpace(Vector3.new(0, p.Size.Y / 2, 0)), p.CFrame:PointToWorldSpace(Vector3.new(0, -p.Size.Y / 2, 0))
				end
			end
			local nk, pl = ends("Torso")
			local sL, hL = ends("Left Arm")
			local sR, hR = ends("Right Arm")
			local hpL, fL = ends("Left Leg")
			local hpR, fR = ends("Right Leg")
			J = { head = pos("Head"), neck = nk, pelvis = pl, shL = sL, handL = hL, shR = sR, handR = hR,
				hipL = hpL, footL = fL, hipR = hpR, footR = fR }
		else
			J = { head = pos("Head"), neck = pos("UpperTorso"), pelvis = pos("LowerTorso"),
				shL = pos("LeftUpperArm"), shR = pos("RightUpperArm"), handL = pos("LeftHand"), handR = pos("RightHand"),
				hipL = pos("LeftUpperLeg"), hipR = pos("RightUpperLeg"), footL = pos("LeftFoot"), footR = pos("RightFoot") }
		end
		poseFn = function() end
		local zero = Vector3.new(0, 0, 0)
		local kd = isR6 and (opt.Wave and 2.5 or 2.05) or (opt.Wave and 2.35 or 1.95)   -- R6 : un peu plus de recul pour les sauts
		fit = { focus = zero, size = bsize, corners = cornersFor(bsize, zero),
			dist = kd * math.max(bsize.Y, bsize.X * 0.9), animated = false, avatar = true }
		finishModel()
		return true
	end

	-- Poses faites à la main : coucou en boucle si Wave, sinon petit balancement si Animate ; wCrouch / wAir viennent de l'animation de
	-- bienvenue (accroupi avant le saut, bras levés en l'air). R6 : une rotation est exprimée dans le repère du PARENT puis convertie
	-- avec le C0 de l'articulation, donc la convention (très différente) des Motor6D R6 / R15 n'a plus d'importance.
	local wCrouch, wAir = 0, 0
	local function avatarPose(t)
		local A = CFrame.Angles
		for _, j in pairs(avJoints) do j.Transform = CFrame.identity end
		if avJoints["Right Shoulder"] then   -- ---- R6
			local function rot(n, R)
				local j = avJoints[n]
				if j then
					local c0 = j.C0 - j.C0.Position
					j.Transform = c0:Inverse() * R * c0
				end
			end
			local c, air = wCrouch, wAir
			local B, Pm, ID = EMO.base, EMO.em, CFrame.identity
			-- pose de base : coucou en continu (pondéré par EMO.wv : 0 pendant la pause et l'emote) + bras levés / accroupi de la bienvenue
			local wv = opt.Emotes and EMO.wv or 1
			if opt.Wave then
				local thR = 0.08 + ((2.55 + math.sin(t * 8) * 0.3) - 0.08) * wv
				B.rs = A(-0.2 * wv * (1 - air), 0, thR + (2.85 - thR) * air)
			else
				B.rs = A(0, 0, 0.08 + 2.77 * air)
			end
			B.ls = A(0, 0, -(0.08 + 2.77 * air))
			B.rt = A(-0.2 * c + math.sin(t * 2) * 0.01, 0, 0)
			B.nk = A(math.sin(t * 2) * 0.04, 0, math.sin(t * 3.5) * 0.04)
			if opt.Animate and not opt.Wave and air < 0.01 then
				local a = math.sin(t * 3) * 0.5
				B.rh, B.lh = A(a, 0, 0), A(-a, 0, 0)
			else
				B.rh, B.lh = A(0, 0, 0.25 * air), A(0, 0, -0.25 * air)
			end
			-- emote en cours : on fond la pose de base vers celle de l'emote
			if opt.Emotes and EMO.stage == 4 then
				Pm.rs, Pm.ls, Pm.rh, Pm.lh, Pm.nk, Pm.rt = A(0, 0, 0.08), A(0, 0, -0.08), ID, ID, ID, ID
				local dy, spin, flip, env = Library._emoPose(EMO, Pm)
				EMO.y, EMO.spin, EMO.flip = dy, spin, flip
				for k, cf in pairs(Pm) do B[k] = B[k]:Lerp(cf, env) end
			else
				EMO.y, EMO.spin, EMO.flip = 0, 0, 0
			end
			local inv = B.rt:Inverse()   -- les jambes compensent l'inclinaison / la torsion du torse : elles restent d'aplomb
			rot("RootJoint", B.rt)
			rot("Neck", B.nk)
			rot("Right Shoulder", B.rs)
			rot("Left Shoulder", B.ls)
			rot("Right Hip", inv * B.rh)
			rot("Left Hip", inv * B.lh)
			return
		end
		local function set(n, cf)   -- ---- R15
			local j = avJoints[n]
			if j then j.Transform = cf end
		end
		set("Waist", A(math.sin(t * 2) * 0.015, 0, 0))
		if opt.Wave then
			set("RightShoulder", A(0, 0, 2.7))
			set("RightElbow", A(0.3, 0, math.sin(t * 8) * 0.55))
			set("LeftShoulder", A(0, 0, -0.1 - math.sin(t * 2) * 0.02))
			set("Neck", A(math.sin(t * 2) * 0.04, 0, math.sin(t * 3.5) * 0.04))
		elseif opt.Animate then
			local a = math.sin(t * 3) * 0.55
			set("RightShoulder", A(-a, 0, 0.1))
			set("LeftShoulder", A(a, 0, -0.1))
			set("RightHip", A(a, 0, 0))
			set("LeftHip", A(-a, 0, 0))
			set("RightKnee", A(math.max(0, -a) * 0.5, 0, 0))
			set("LeftKnee", A(math.max(0, a) * 0.5, 0, 0))
		else
			set("RightShoulder", A(0, 0, 0.12))
			set("LeftShoulder", A(0, 0, -0.12))
		end
		if wAir > 0.01 then   -- bienvenue : bras levés en l'air
			set("RightShoulder", A(0, 0, 0.1 + 2.7 * wAir))
			set("LeftShoulder", A(0, 0, -(0.1 + 2.7 * wAir)))
		end
	end

	local function refresh(force)
		local wantAvatar = (charSrc == LP) and o.Avatar ~= false
		if wantAvatar then
			if force and avatarTpl then
				avatarTpl:Destroy()
				avatarTpl = nil
			end
			if avatarTpl and buildAvatar(avatarTpl) then
				loadLbl.Visible = false
				return true
			end
			if not avatarBusy then
				avatarBusy = true
				loadLbl.Visible = rig == nil
				task.spawn(function()
					local m = fetchAvatar()
					avatarBusy = false
					if not vp.Parent then return end
					if m and buildAvatar(m) then
						loadLbl.Visible = false
						return
					end
					-- Roblox ne répond pas : repli sur ton personnage en jeu, puis (dernier recours) le rig factice
					local src = resolveSource()
					local built = src and src:IsA("Model") and buildCharacter(src)
					if not built and not rig then buildMock() end
					loadLbl.Visible = false
				end)
			end
			return false
		end
		local src = resolveSource()
		local built = src and src:IsA("Model") and buildCharacter(src)
		if not built then buildMock() end
		return built and true or false
	end

	local function applyAppearance()
		for _, e in ipairs(bodyParts) do
			local p = e.p
			if p.Parent then
				if opt.Chams and e.tr < 0.99 then
					p.Color = opt.ChamsColor
					p.Material = Enum.Material.Neon
					p.Transparency = math.max(e.tr, opt.ChamsTransparency)
					if e.tex then p.TextureID = "" end
				else
					local c = e.color
					if not hl and opt.Highlight and e.tr < 0.99 then
						c = c:Lerp(opt.HighlightFill, 1 - opt.HighlightFillTransparency)
					end
					p.Color = c
					p.Material = e.mat
					p.Transparency = e.tr
					if e.tex then p.TextureID = e.tex end
				end
			end
		end
		for _, e in ipairs(decals) do e.d.Transparency = opt.Chams and 1 or e.tr end
		for _, e in ipairs(hides) do e.i.Parent = opt.Chams and nil or e.parent end
		floor.Transparency = (opt.Floor and fit) and 0.15 or 1
		if hl then
			hl.Enabled = opt.Highlight
			hl.FillColor = opt.HighlightFill
			hl.OutlineColor = opt.HighlightOutline
			hl.FillTransparency = opt.HighlightFillTransparency
			hl.OutlineTransparency = opt.HighlightOutlineTransparency
		end
	end

	refresh()
	if charSrc == LP then
		track(LP.CharacterAdded:Connect(function()
			task.delay(2.5, function()
				if vp.Parent then refresh() end
			end)
		end))
	end

	-- ---------------------------------------------------------------- caméra
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	local YAW0 = tonumber(o.Yaw) and math.rad(o.Yaw) or (math.pi + 0.5)
	local PITCH0 = tonumber(o.Pitch) or -0.12
	local yaw, pitch = YAW0, PITCH0
	local dragging = false

	-- ---------------------------------------------------------------- calque 2D
	local lines, nLines = {}, 0
	local function drawLine(a, b, color, th, tr)
		nLines += 1
		local l = lines[nLines]
		if not l then
			l = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false, ZIndex = 3 }, ov)
			lines[nLines] = l
		end
		local d = b - a
		l.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
		l.Size = UDim2.fromOffset(d.Magnitude + 0.5, th)
		l.Rotation = math.deg(math.atan2(d.Y, d.X))
		l.BackgroundColor3 = color
		l.BackgroundTransparency = tr or 0
		l.Visible = true
	end

	local bx = new("Frame", { BorderSizePixel = 0, BackgroundTransparency = 1, Visible = false, ZIndex = 3 }, ov)
	local bxStroke = new("UIStroke", { Thickness = 1, ApplyStrokeMode = BORDER }, bx)
	local hbBg = new("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.3, Visible = false, ZIndex = 3 }, ov)
	local hbFill = new("Frame", { BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 1, 1, 0), Size = UDim2.new(1, -2, 1, 0), ZIndex = 4 }, hbBg)
	local nameL = new("TextLabel", { BackgroundTransparency = 1, Font = F_BOLD, TextSize = 12, Text = "",
		AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(160, 14), TextStrokeTransparency = 0.4,
		Visible = false, ZIndex = 4 }, ov)
	local distL = new("TextLabel", { BackgroundTransparency = 1, Font = F_MED, TextSize = 11, Text = "",
		AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(160, 13), TextStrokeTransparency = 0.5,
		Visible = false, ZIndex = 4 }, ov)
	local dot = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0,
		Visible = false, ZIndex = 3 }, ov)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	local dotStroke = new("UIStroke", { Thickness = 1.5, ApplyStrokeMode = BORDER }, dot)
	local hint = new("TextLabel", { BackgroundTransparency = 1, Font = F_REG, TextSize = 10, Text = "glisser pour tourner",
		TextColor3 = T.ElementAccent, TextTransparency = 0.55, TextXAlignment = LEFT, AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -4), Size = UDim2.new(1, -16, 0, 12), ZIndex = 4 }, ov)

	-- ---------------------------------------------------------------- liens (Flag / élément -> option)
	local binds = {}
	local function readSrc(src)
		if type(src) == "string" then
			local v = Library.Flags[src]
			if v == nil then
				local it = Library.Items[src]
				if it and it.Get then
					local ok, r = pcall(it.Get, it)
					if ok then v = r end
				end
			end
			return v
		elseif type(src) == "table" and src.Get then
			local ok, r = pcall(src.Get, src)
			if ok then return r end
		end
		return nil
	end
	local function pollBinds()
		for _, b in ipairs(binds) do
			local v = readSrc(b.src)
			if v ~= nil then
				if b.fn then
					local ok, r = pcall(b.fn, v)
					v = ok and r or nil
				end
				if v ~= nil then setOpt(b.opt, v) end
			end
		end
	end

	-- ---------------------------------------------------------------- boucle de rendu
	local t, pollT, shownT, shown, idleAcc = 0, 0, -1, true, 0
	-- petit saut « à la Mario » (item.Jump) : le personnage monte vite puis redescend, une fois la lib chargée et l'aperçu visible
	local JUMP_H, JUMP_DUR = 2.1, 0.62
	local function jumpOffset()
		if not jumpT0 then return 0 end
		local u = (os.clock() - jumpT0) * math.max(Library.AnimSpeed or 1, 0.05) / JUMP_DUR
		if u >= 1 then return 0, true end
		if u < 0.4 then
			local a = u / 0.4
			return JUMP_H * (1 - (1 - a) * (1 - a))      -- montée rapide
		end
		local a = (u - 0.4) / 0.6
		return JUMP_H * (1 - a * a)                       -- descente plus flottante
	end
	-- animation de bienvenue (item.Welcome) : s'accroupit, saut, réception, s'accroupit, 2e saut plus haut, réception.
	-- Retourne : décalage vertical, accroupi (0..1), en l'air (0..1), terminée ?
	local WEL = { { 0.22, "crouch" }, { 0.62, "jump", 1.5 }, { 0.30, "land" }, { 0.20, "crouch" }, { 0.70, "jump", 1.9 }, { 0.38, "land" } }
	local WEL_TOTAL = 0
	for _, seg in ipairs(WEL) do WEL_TOTAL += seg[1] end
	local function welcomeState()
		if not welcomeT0 then return 0, 0, 0, false end
		local el = (os.clock() - welcomeT0) * math.max(Library.AnimSpeed or 1, 0.05)
		if el >= WEL_TOTAL then return 0, 0, 0, true end
		for _, seg in ipairs(WEL) do
			if el < seg[1] then
				local u = el / seg[1]
				if seg[2] == "crouch" then
					return -0.18 * u, u, 0, false
				elseif seg[2] == "land" then
					return -0.18 * (1 - u), 1 - u, 0, false
				end
				local H, y = seg[3], 0
				if u < 0.4 then
					local a = u / 0.4
					y = H * (1 - (1 - a) * (1 - a))      -- montée rapide
				else
					local a = (u - 0.4) / 0.6
					y = H * (1 - a * a)                  -- descente plus flottante
				end
				return y, 0, 1, false
			end
			el -= seg[1]
		end
		return 0, 0, 0, true
	end
	local function isShown()
		local p = vp
		while p and p:IsA("GuiObject") do
			if not p.Visible then return false end
			p = p.Parent
		end
		if p and p:IsA("ScreenGui") and not p.Enabled then return false end
		return true
	end

	local function render(dt)
		if not fit then return end   -- avatar pas encore chargé
		local sc = vp.AbsoluteSize.Y / h
		if sc <= 0.01 then return end
		local W, H = vp.AbsoluteSize.X / sc, h
		t += dt
		if opt.AutoRotate and not dragging then yaw += math.rad(opt.RotateSpeed) * dt end
		local dist = fit.dist / math.clamp(opt.Zoom, 0.4, 3)
		cam.CFrame = CFrame.new(fit.focus) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.new(0, 0, dist)
		if opt.Wave and not dragging then   -- face à la caméra : revient doucement de face après un glissement
			local k = math.min(dt * 4, 1)
			yaw += (((YAW0 - yaw + math.pi) % (2 * math.pi)) - math.pi) * k
			pitch += (PITCH0 - pitch) * k
		end
		if fit.animated then
			poseFn(opt.Animate and math.sin(t * 3) * 0.55 or 0, t)
			jumpApplied = 0   -- le rig factice est reposé en absolu à chaque image
		end
		local wy, wc, wa, wdone = welcomeState()
		if wdone then welcomeT0 = nil end
		wCrouch = wc
		wAir = wAir + (wa - wAir) * math.min(dt * 14, 1)   -- les bras montent / descendent en douceur
		if wa == 0 and wAir < 0.005 then wAir = 0 end
		if fit.avatar then
			-- emotes : on n'avance la séquence qu'une fois la bienvenue terminée
			if opt.Emotes and not welcomeT0 and not welcomePending then Library._emoStep(EMO, dt) end
			local waving = (not opt.Emotes) or EMO.stage == 1 or EMO.stage == 3
			EMO.wv = EMO.wv + ((waving and 1 or 0) - EMO.wv) * math.min(dt * 9, 1)
			avatarPose(t)   -- avatar réel : poses des articulations + saut en bougeant tout le modèle
			local y, finished = jumpOffset()
			if finished then jumpT0, y = nil, 0 end
			y = y + wy + EMO.y
			if rig and avBase and (y ~= avY or EMO.spin ~= avSpin or EMO.flip ~= avFlip) then
				avY, avSpin, avFlip = y, EMO.spin, EMO.flip
				rig:PivotTo(avBase * CFrame.new(0, y, 0) * CFrame.Angles(EMO.flip, EMO.spin, 0))
			end
			local em = (opt.Emotes and EMO.stage == 4) and Library.PreviewEmotes[EMO.idx] or nil
			local lblTxt = em and ("Emote " .. EMO.idx .. "/" .. #Library.PreviewEmotes .. "  ·  " .. em.Name) or ""
			if lblTxt ~= EMO.lbl then
				EMO.lbl = lblTxt
				EMO.label.Text = lblTxt
				EMO.label.Visible = lblTxt ~= ""
			end
		else
		do   -- saut : on décale toutes les pièces de la différence avec l'image précédente
			local y, finished = jumpOffset()
			if finished then jumpT0, y = nil, 0 end
			y = y + wy
			local dy = y - jumpApplied
			if dy ~= 0 then
				jumpApplied = y
				for _, e in ipairs(bodyParts) do
					if e.p.Parent then e.p.CFrame = e.p.CFrame + Vector3.new(0, dy, 0) end
				end
			end
		end
		end

		local tanH = math.tan(math.rad(cam.FieldOfView) / 2)
		local asp = W / H
		local cf = cam.CFrame
		local function proj(p)
			local v = cf:PointToObjectSpace(p)
			local d = -v.Z
			if d < 0.2 then return nil end
			return Vector2.new((v.X / d / (tanH * asp) * 0.5 + 0.5) * W, (0.5 - v.Y / d / tanH * 0.5) * H), d
		end

		nLines = 0
		local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
		for _, c in ipairs(fit.corners) do
			local p = proj(c)
			if p then
				minX, minY = math.min(minX, p.X), math.min(minY, p.Y)
				maxX, maxY = math.max(maxX, p.X), math.max(maxY, p.Y)
			end
		end
		local okBox = minX < maxX and minY < maxY
		local bw, bh, cx = maxX - minX, maxY - minY, (minX + maxX) / 2

		-- box
		local st = string.lower(opt.BoxStyle)
		local isCorner = st == "corner" or st == "coins" or st == "angles"
		local showBox = opt.Box and okBox
		bx.Visible = showBox and ((not isCorner) or opt.BoxFill)
		if bx.Visible then
			bx.Position = UDim2.fromOffset(minX, minY)
			bx.Size = UDim2.fromOffset(bw, bh)
			bx.BackgroundColor3 = opt.BoxColor
			bx.BackgroundTransparency = opt.BoxFill and opt.BoxFillTransparency or 1
			bxStroke.Enabled = not isCorner
			bxStroke.Color = opt.BoxColor
			bxStroke.Thickness = opt.BoxThickness
		end
		if showBox and isCorner then
			local lx, ly = bw * 0.28, bh * 0.2
			local c, th = opt.BoxColor, opt.BoxThickness
			local function V(x, y) return Vector2.new(x, y) end
			drawLine(V(minX, minY), V(minX + lx, minY), c, th)
			drawLine(V(minX, minY), V(minX, minY + ly), c, th)
			drawLine(V(maxX, minY), V(maxX - lx, minY), c, th)
			drawLine(V(maxX, minY), V(maxX, minY + ly), c, th)
			drawLine(V(minX, maxY), V(minX + lx, maxY), c, th)
			drawLine(V(minX, maxY), V(minX, maxY - ly), c, th)
			drawLine(V(maxX, maxY), V(maxX - lx, maxY), c, th)
			drawLine(V(maxX, maxY), V(maxX, maxY - ly), c, th)
		end

		-- squelette
		if opt.Skeleton then
			for _, seg in ipairs(PV_SEGS) do
				local ja, jb = J[seg[1]], J[seg[2]]
				local a, b = ja and proj(ja), jb and proj(jb)
				if a and b then drawLine(a, b, opt.SkeletonColor, opt.SkeletonThickness) end
			end
		end

		-- point sur la tête
		local hp, hd = nil, nil
		if J.head then hp, hd = proj(J.head) end
		dot.Visible = opt.HeadDot and hp ~= nil
		if dot.Visible then
			local r = 0.55 * H / (2 * tanH * hd)
			dot.Position = UDim2.fromOffset(hp.X, hp.Y)
			dot.Size = UDim2.fromOffset(r * 2, r * 2)
			dotStroke.Color = opt.HeadDotColor
		end

		-- traceur
		if opt.Tracer and okBox then
			local o2 = string.lower(opt.TracerOrigin)
			local from = Vector2.new(W / 2, (o2 == "top" and 0) or ((o2 == "center" or o2 == "centre") and H / 2) or H)
			drawLine(from, Vector2.new(cx, maxY), opt.TracerColor, 1, 0.1)
		end

		-- barre de vie
		hbBg.Visible = opt.Health and okBox
		if hbBg.Visible then
			local hv = math.clamp(opt.HealthValue, 0, 1)
			hbBg.Position = UDim2.fromOffset(minX - 7, minY)
			hbBg.Size = UDim2.fromOffset(4, bh)
			hbFill.Size = UDim2.new(1, -2, hv, 0)
			hbFill.BackgroundColor3 = Color3.fromRGB(235, 65, 65):Lerp(Color3.fromRGB(75, 220, 105), hv)
		end

		-- nom / distance
		nameL.Visible = opt.Name and okBox
		if nameL.Visible then
			nameL.Position = UDim2.fromOffset(cx, minY - 3)
			nameL.Text = opt.NameText
			nameL.TextColor3 = opt.NameColor
		end
		distL.Visible = opt.Distance and okBox
		if distL.Visible then
			distL.Position = UDim2.fromOffset(cx, maxY + 2)
			distL.Text = opt.DistanceText
			distL.TextColor3 = opt.DistanceColor
		end

		for i = nLines + 1, #lines do lines[i].Visible = false end
	end

	local hbConn
	hbConn = Ticker.connect(function(dt)
		local now = os.clock()
		if now - shownT > 0.25 then
			shownT = now
			shown = isShown()
		end
		if not shown or Library._resizing then return end
		if welcomePending and Library._fullyLoaded and fit then   -- l'avatar doit être affiché (sinon l'animation se jouerait dans le vide)
			welcomePending, jumpPending, welcomeT0 = false, false, os.clock()
			if Library.HiSoundOnHome ~= false then Library:PlayHiSound() end
		end
		if welcomeT0 then jumpPending = false end             -- pas de petit saut par-dessus la bienvenue
		if jumpPending and Library._fullyLoaded and fit then
			jumpPending, jumpT0 = false, os.clock()
			if Library.HiSoundOnHome ~= false then Library:PlayHiSound() end
		end
		-- fenêtre Roblox en arrière-plan : on ne rend qu'à ~4 images/s (le temps écoulé est cumulé, l'animation reste juste)
		if not pvFocused and not jumpT0 and not welcomeT0 then
			idleAcc += dt
			if idleAcc < 1 / math.max(tonumber(o.IdleFPS) or tonumber(Library.PreviewIdleFPS) or 4, 1) then return end
			dt, idleAcc = idleAcc, 0
		else
			idleAcc = 0
		end
		pollT += dt
		if pollT >= 0.05 then
			pollT = 0
			if #binds > 0 then pollBinds() end
		end
		if dirty then
			dirty = false
			applyAppearance()
		end
		render(dt)
	end)
	track(hbConn)
	f.Destroying:Connect(function() pcall(function() hbConn:Disconnect() end) end)

	-- ---------------------------------------------------------------- rotation à la souris / au doigt
	vp.InputBegan:Connect(function(i)
		if isPress(i) then
			dragging = true
			tween(hint, { TextTransparency = 1 }, 0.2)
		end
	end)
	track(UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			yaw -= i.Delta.X * 0.012
			pitch = math.clamp(pitch - i.Delta.Y * 0.006, -1, 0.6)
		end
	end))
	track(UIS.InputEnded:Connect(function(i)
		if dragging and isPress(i) then dragging = false end
	end))

	-- ---------------------------------------------------------------- API
	local item = {}
	item.Set = function(...)
		local a, b = unself(item, ...)
		if type(a) == "table" then
			for k, v in pairs(a) do setOpt(k, v) end
		elseif a ~= nil then
			setOpt(a, b)
		end
	end
	item.SetOptions = item.Set
	item.Get = function(...)
		local a = unself(item, ...)
		if a == nil then return table.clone(opt) end
		local k = PV_KEYS[string.lower(tostring(a))]
		return k and opt[k] or nil
	end
	item.Bind = function(...)
		local k, src, fn = unself(item, ...)
		local key = PV_KEYS[string.lower(tostring(k))]
		if not key then
			warn("[Ui-Lib] Preview3D : option inconnue « " .. tostring(k) .. " »")
			return item
		end
		for _, b in ipairs(binds) do
			if b.opt == key then
				b.src, b.fn = src, fn
				return item
			end
		end
		binds[#binds + 1] = { opt = key, src = src, fn = fn }
		return item
	end
	item.BindAll = function(...)
		local map = unself(item, ...)
		if type(map) == "table" then
			for k, src in pairs(map) do item.Bind(k, src) end
		end
		return item
	end
	item.Unbind = function(...)
		local k = unself(item, ...)
		local key = PV_KEYS[string.lower(tostring(k))]
		for i = #binds, 1, -1 do
			if binds[i].opt == key then table.remove(binds, i) end
		end
	end
	item.ResetView = function() yaw, pitch = YAW0, PITCH0 end
	item.SetRotation = function(...)
		local d = tonumber((unself(item, ...)))
		if d then yaw = math.rad(d) end
	end
	item.SetHeight = function(...)
		local nh = math.clamp(tonumber((unself(item, ...))) or h, 120, 520)
		h = nh
		f.Size = UDim2.new(1, 0, 0, nh + top + 6)
		vp.Size = UDim2.new(1, -16, 0, nh)
	end
	item.SetName = function(...)
		local s = tostring((unself(item, ...)))
		if titleLbl then titleLbl.Text = s end
	end
	item.Refresh = function() return refresh(true) end
	item.PlayEmote = function(...)   -- pv:PlayEmote(numéro | "Nom") : lance une emote tout de suite (puis la séquence continue)
		local which = unself(item, ...)
		local list, n = Library.PreviewEmotes, tonumber(which)
		if not n then
			for i, e in ipairs(list) do
				if string.lower(e.Name) == string.lower(tostring(which)) then n = i break end
			end
		end
		if n and list[n] then EMO.force = n end
	end
	item.Welcome = function() welcomePending = true end   -- animation de bienvenue (2 sauts, bras levés), puis le coucou continue
	item.Jump = function() jumpPending = true end   -- saut à la Mario (attend que la lib soit chargée et l'aperçu visible)
	item.SetTarget = function(...)
		local v = unself(item, ...)
		if v == true then v = LP end
		charSrc = typeof(v) == "Instance" and v or nil
		return refresh()
	end
	item.Instance = f
	item.Viewport = vp
	item.Camera = cam
	item.GetModel = function() return rig end
	return item
end
