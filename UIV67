--  Signal
-- ════════════════════════════════════════════════════════════════════════

local Signal = {}
Signal.__index = Signal

function Signal.new()
    return setmetatable({ Handlers = {} }, Signal)
end

function Signal:Connect(fn)
    local connection = { Fn = fn, Connected = true, Signal = self }

    function connection:Disconnect()
        if not self.Connected then
            return
        end
        self.Connected = false
        local list = self.Signal.Handlers
        for i = #list, 1, -1 do
            if list[i] == self then
                table.remove(list, i)
                break
            end
        end
    end

    connection.Destroy = connection.Disconnect
    table.insert(self.Handlers, connection)
    return connection
end

function Signal:Once(fn)
    local connection
    connection = self:Connect(function(...)
        connection:Disconnect()
        fn(...)
    end)
    return connection
end

function Signal:Fire(...)
    local snapshot = {}
    for i, handler in ipairs(self.Handlers) do
        snapshot[i] = handler
    end
    for _, handler in ipairs(snapshot) do
        if handler.Connected then
            local ok, err = pcall(handler.Fn, ...)
            if not ok then
                warn("[Singularity] signal handler error: " .. tostring(err))
            end
        end
    end
end

function Signal:Wait()
    local thread = coroutine.running()
    self:Once(function(...)
        task.spawn(thread, ...)
    end)
    return coroutine.yield()
end

function Signal:DisconnectAll()
    for i = #self.Handlers, 1, -1 do
        self.Handlers[i].Connected = false
        self.Handlers[i] = nil
    end
end

