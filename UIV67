-- V5 : MINI-FENÊTRES FLOTTANTES  (détacher un bloc, 1 à 5 max)
-- ============================================================================
Library.Floats = {}
Library.MaxFloats = 3
local floatZ = 20

function Library:SetMaxFloats(n)
	n = math.clamp(math.floor(tonumber(n) or 3), 1, 5)
	Library.MaxFloats = n
	while #Library.Floats > n do
		Library:AttachBlock(Library.Floats[#Library.Floats].Block)
	end
end

function Library:AttachBlock(blk)
	if not (blk and blk._float) then return end
	local fl = blk._float
	blk._float = nil
	for i, e in ipairs(Library.Floats) do
		if e.Block == blk then table.remove(Library.Floats, i) break end
	end
	if blk.Frame and blk.Frame.Parent then
		blk.Frame.Parent = nil
		if blk.Tab and blk.Tab._reapplyLayout then pcall(blk.Tab._reapplyLayout, blk.Tab) end
	end
	if fl then fl:Destroy() end
end

function Library:AttachAllBlocks()
	for i = #Library.Floats, 1, -1 do
		if Library.Floats[i] then Library:AttachBlock(Library.Floats[i].Block) end
	end
end

function Library:DetachBlock(blk)
	local win = Library.Window
	if not win or not blk or blk._float then return false end
	if #Library.Floats >= Library.MaxFloats then
		Library:Notify({ Title = "Mini-fenêtres", Type = "Warning", Duration = 3,
			Content = "Maximum atteint (" .. Library.MaxFloats .. "). Ferme-en une ou augmente la limite dans Paramètres." })
		return false
	end
	local w = math.clamp(math.floor(blk.Frame.AbsoluteSize.X / math.max(pxScale(), 0.1)), 250, 420)
	local nth = #Library.Floats
	local ap = win.Main.AbsolutePosition
	local v = viewport()
	floatZ += 1
	local fl = new("Frame", { Name = "FloatBlock", Size = UDim2.fromOffset(w, 0), AutomaticSize = AY,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(math.clamp(ap.X + 40 + nth * 28, 0, math.max(0, v.X - w - 10)),
			math.clamp(ap.Y + 60 + nth * 28, 0, math.max(0, v.Y - 120))),
		BackgroundColor3 = T.Main, BackgroundTransparency = 0.03, BorderSizePixel = 0, Active = true, ZIndex = floatZ,
		Visible = win.Open }, win.Gui)
	corner(fl, 12)
	stroke(fl, 0.55)
	new("UIScale", { Scale = Library.Scale or 1 }, fl)
	new("UIListLayout", { SortOrder = BYORDER }, fl)
	local bar = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = 1 }, fl)
	label(bar, blk.Name, 12, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -48, 1, 0), Font = F_BOLD })
	local close = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0, 24, 0, 20), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.93, Text = "x",
		TextColor3 = T.Text, TextSize = 12, Font = F_BOLD, AutoButtonColor = false }, bar)
	corner(close, 6)
	close.MouseEnter:Connect(function() tween(close, { BackgroundTransparency = 0.8 }, 0.15) end)
	close.MouseLeave:Connect(function() tween(close, { BackgroundTransparency = 0.93 }, 0.2) end)
	close.MouseButton1Click:Connect(function() uiSnd("click") Library:AttachBlock(blk) end)
	fadeLine(bar, { Position = UDim2.new(0, 10, 1, -1), Size = UDim2.new(1, -20, 0, 1) })
	local sf = new("ScrollingFrame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, AutomaticCanvasSize = AY,
		CanvasSize = UDim2.new(), ScrollBarThickness = 3, BackgroundTransparency = 1, BorderSizePixel = 0,
		LayoutOrder = 2, ScrollBarImageColor3 = T.Accent }, fl)
	new("UISizeConstraint", { MaxSize = Vector2.new(math.huge, 420) }, sf)
	new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), PaddingBottom = UDim.new(0, 6) }, sf)

	-- le bloc vit dans la mini-fenêtre tant qu'elle existe
	blk._float = fl
	blk.Frame.Parent = sf
	blk.Frame.LayoutOrder = 1
	Library.Floats[#Library.Floats + 1] = { Block = blk, Gui = fl }

	-- au premier plan au clic ; glisser la barre de titre pour déplacer
	fl.InputBegan:Connect(function(i)
		if isPress(i) then
			floatZ += 1
			fl.ZIndex = floatZ
		end
	end)
	bar.InputBegan:Connect(function(i)
		if not isPress(i) then return end
		local start = Vector2.new(i.Position.X, i.Position.Y)
		local o0 = fl.Position
		startDrag(function(p)
			local d = Vector2.new(p.X, p.Y) - start
			local vv = viewport()
			fl.Position = UDim2.fromOffset(math.clamp(o0.X.Offset + d.X, -w + 80, vv.X - 80),
				math.clamp(o0.Y.Offset + d.Y, 0, vv.Y - 40))
		end, nil, i.Position)
	end)
	return true
end

-- les mini-fenêtres se masquent / réapparaissent avec l'interface
Library._floatsVisible = function(v)
	for _, e in ipairs(Library.Floats) do
		if e.Gui then e.Gui.Visible = v and true or false end
	end
end

