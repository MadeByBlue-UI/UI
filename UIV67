	corner(horizon, 25)
	local horizonEntry = Library.CornerObjects[#Library.CornerObjects]
	local hst = new("UIStroke", { Color = T.Accent, Thickness = 1.5, Transparency = 0.3, ApplyStrokeMode = BORDER }, horizon)
	spin(new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(110, 110, 118)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.12, 0.55),
			NumberSequenceKeypoint.new(0.28, 0.93), NumberSequenceKeypoint.new(0.72, 0.93),
			NumberSequenceKeypoint.new(0.88, 0.55), NumberSequenceKeypoint.new(1, 0),
		}),
	}, hst), 55)

	local handles = {}
	local function attachResize(h, dx, dy)
		handles[#handles + 1] = h
		h.InputBegan:Connect(function(i)
			if not isPress(i) or collapsed then return end
			local start = Vector2.new(i.Position.X, i.Position.Y)
			local sw, sh = main.Size.X.Offset, main.Size.Y.Offset
			local sc = scaleBase
			tgtPos = nil
			curSize = Vector2.new(sw, sh)
			lastSize = curSize
			tgtSize = nil
			rsDir = Vector2.new(dx, dy)
			rsSmooth = false
			startDrag(function(p)
				local d = (Vector2.new(p.X, p.Y) - start) / sc
				local v = viewport()
				tgtSize = Vector2.new(
					dx == 0 and sw or math.clamp(sw + d.X * dx, minW, math.max(minW, v.X / sc - 10)),
					dy == 0 and sh or math.clamp(sh + d.Y * dy, minH, math.max(minH, v.Y / sc - 10))
				)
			end, nil, i.Position, saveWinLater)
		end)
	end

	local function handle(dx, dy, pos, sz)
		local h = new("TextButton", { Position = pos, Size = sz, BackgroundTransparency = 1, Text = "",
			AutoButtonColor = false, ZIndex = 70 }, main)
		attachResize(h, dx, dy)
		return h
	end
	handle(1, 0,  UDim2.new(1, -6, 0, 46),  UDim2.new(0, 6, 1, -76))   -- droite
	handle(-1, 0, UDim2.new(0, 0, 0, 46),   UDim2.new(0, 6, 1, -76))   -- gauche
	handle(0, 1,  UDim2.new(0, 30, 1, -6),  UDim2.new(1, -60, 0, 6))   -- bas
	handle(0, -1, UDim2.new(0, 30, 0, 0),   UDim2.new(1, -72, 0, 4))   -- haut
	handle(-1, -1, UDim2.new(0, 0, 0, 0),   UDim2.fromOffset(14, 14))  -- haut gauche
	handle(1, -1, UDim2.new(1, -14, 0, 0),  UDim2.fromOffset(14, 14))  -- haut droite
	handle(-1, 1, UDim2.new(0, 0, 1, -14),  UDim2.fromOffset(14, 14))  -- bas gauche

	-- poignée visible (coin bas-droite)
	local grip = new("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -4),
		Size = UDim2.new(0, 20, 0, 20), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 60 }, main)
	local dots = { { 15, 15 }, { 9, 15 }, { 15, 9 } }
	for _, d in ipairs(dots) do
		new("Frame", { Position = UDim2.new(0, d[1], 0, d[2]), Size = UDim2.new(0, 2, 0, 2),
			BackgroundColor3 = T.Accent, BackgroundTransparency = 0.6, BorderSizePixel = 0 }, grip)
	end
	grip.MouseEnter:Connect(function() tween(grip, { BackgroundTransparency = 0.9 }, 0.2) end)
	grip.MouseLeave:Connect(function() tween(grip, { BackgroundTransparency = 1 }, 0.25) end)
	attachResize(grip, 1, 1)

	-- ------------------------------------------------------------------
	-- Réduire (barre de titre seule) / recentrer / mise en page sauvegardée
	-- ------------------------------------------------------------------
	local parts = { search, sidebar, vline, content, footer }
	setMinimized = function(v)
		v = v and true or false
		if v == collapsed then return end
		collapsed = v
		local sz = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
		curSize, lastSize, rsDir, rsSmooth = sz, sz, Vector2.new(0, 1), true
		if v then
			preSize = sz
			tgtSize = Vector2.new(sz.X, 44)
			task.delay(0.35, function()
				if collapsed then for _, p in ipairs(parts) do p.Visible = false end end
			end)
		else
			for _, p in ipairs(parts) do p.Visible = true end
			tgtSize = preSize or Vector2.new(W0, H0)
		end
		for _, h in ipairs(handles) do h.Visible = not v end
		Library._busyUntil = os.clock() + 0.6
		task.delay(0.7, saveWin)
	end

	local function evenSize(n) return math.floor(n / 2 + 0.5) * 2 end

	function win:ApplyLayout(d)
		if collapsed then
			collapsed = false
			for _, p in ipairs(parts) do p.Visible = true end
			for _, h in ipairs(handles) do h.Visible = true end
		end
		local v = viewport()
		local nw = evenSize(math.clamp(tonumber(d.w) or W0, minW, math.max(minW, v.X / scaleBase - 10)))
		local nh = evenSize(math.clamp(tonumber(d.h) or H0, minH, math.max(minH, v.Y / scaleBase - 10)))
		tgtSize, tgtPos = nil, nil
		main.Size = UDim2.fromOffset(nw, nh)
		lastSize, curSize = Vector2.new(nw, nh), Vector2.new(nw, nh)
		curPos = clampCenter(Vector2.new((tonumber(d.cx) or 0.5) * v.X, (tonumber(d.cy) or 0.5) * v.Y))
		setMainPos()
		saveWin()
	end

	function win:Reset()
		if collapsed then setMinimized(false) end
		local v = viewport()
		curSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
		lastSize = curSize
		rsDir, rsSmooth = Vector2.new(0, 0), true
		tgtSize = Vector2.new(math.min(W0, v.X / scaleBase - 16), math.min(H0, v.Y / scaleBase - 16))
		tgtPos = clampCenter(v / 2)
		Library._busyUntil = os.clock() + 0.8
		task.delay(0.9, saveWin)
	end

	function win:SetOpacity(o)
		o = math.clamp(tonumber(o) or 1, 0.1, 1)
		win.Opacity = o
		main.BackgroundTransparency = 1 - o
		auraFillTr = math.min(1 - o, 0.3)
		for _, e in ipairs(auraEdges) do
			for _, f in ipairs(e.fill) do f.BackgroundTransparency = auraFillTr end
		end
	end
	function win:SetStats(v)
		statsOn = v and true or false
		win.StatsVisible = statsOn
		fpsLabel.Visible = statsOn
	end
	function win:SetMinimized(v) setMinimized(v) end

	foldBtn.MouseButton1Click:Connect(function()
		local tab = win.Current
		if not tab then return end
		local anyOpen = false
		for _, b in ipairs(tab.Blocks) do
			if b._isCollapsed and not b._isCollapsed() then anyOpen = true break end
		end
		tab:CollapseAll(anyOpen)
	end)

	-- ------------------------------------------------------------------
	-- Ouverture / fermeture animées, échelle
	-- ------------------------------------------------------------------
	-- ------------------------------------------------------------------
	-- Forme de la fenêtre (rayon, contour ondulant, vagues), trou noir, étoiles
	-- ------------------------------------------------------------------
	local SHAPE_RADIUS = { Vague = 26, Douce = 34, Classique = 12 }
	local lastHolePos = Library.HolePos
	function win:RefreshShape()
		local base = (SHAPE_RADIUS[Library.Shape] or 26) * (Library.WinRound or 1)
		mainEntry.BaseRadius = base
		horizonEntry.BaseRadius = math.max(base - 1, 0)
		for _, e in ipairs({ mainEntry, horizonEntry }) do
			e.Corner.CornerRadius = UDim.new(0, math.floor(e.BaseRadius * Library.GlobalCornerValue / 10))
		end
		local alive = main.Visible and win.Open and bgMode ~= "off"
		aura.Visible = alive and Library.Shape == "Vague" and Library.OutlineWaves ~= false
		wavesHolder.Visible = Library.Shape ~= "Classique" and Library.InnerWaves ~= false and bgMode == "full"
	end
	function win:RefreshHole()
		holeScaleObj.Scale = Library.HoleScale or 1
		hole.Visible = Library.HoleVisible ~= false
		if lastHolePos ~= Library.HolePos then
			lastHolePos = Library.HolePos
			tween(hole, { Position = holePos() }, 0.6)
		end
		applyBg()
	end
	function win:SetStars(n)
		n = math.clamp(math.floor(tonumber(n) or 0), 0, 80)
		while #stars < n do addStar() end
		while #stars > n do
			local s = table.remove(stars)
			s.f:Destroy()
		end
		applyBg()
	end
	function win:GetStars() return #stars end
	main:GetPropertyChangedSignal("Visible"):Connect(function() win:RefreshShape() end)

	local function stepWaves(w, h)
		local e = math.min(waveIntro, 1)
		local amp = (Library.WaveAmp or 1) * (1 - (1 - e) ^ 3)
		if aura.Visible then
			local r = math.min(mainCorner.CornerRadius.Offset, h / 2, w / 2)
			updateAura(w, h, r, amp)
		end
		if wavesHolder.Visible and not collapsed then updateInner(w, h, amp) end
	end

	local toggleToken = 0
	local hintShown = false
	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	function win:Toggle(v)
		if v == nil then v = not self.Open end
		v = v and true or false
		if v == self.Open then return end
		self.Open = v
		toggleToken = toggleToken + 1
		local my = toggleToken
		if v then
			waveIntro = 0
			main.Visible = true
			tween(uiScale, { Scale = scaleBase }, 0.55, BACK)
			if useCanvas then tween(main, { GroupTransparency = 0 }, 0.35) end
		else
			if Library._openDD then Library._openDD(false) end
			self:RefreshShape()
			tween(uiScale, { Scale = scaleBase * 0.94 }, 0.3)
			if useCanvas then tween(main, { GroupTransparency = 1 }, 0.28) end
			task.delay(0.32 / math.max(Library.AnimSpeed or 1, 0.05) + 0.02, function()
				if toggleToken == my and not self.Open then main.Visible = false end
			end)
		end
	end
	function win:Destroy() Library:Destroy() end
	function win:SetScale(s)
		s = math.clamp(tonumber(s) or 1, 0.6, 1.6)
		scaleBase = s
		Library.Scale = s
		tween(uiScale, { Scale = s }, 0.3)
		tgtPos = clampCenter(tgtPos or curPos)
		task.delay(0.5, saveWin)
	end
	function win:SetTitle(t) title.Text = tostring(t) end
	function win:SetBackground(m)
		if m == "full" or m == "light" or m == "off" then
			bgMode = m
			applyBg()
			win:RefreshShape()
		end
	end
	function win:GetBackground() return bgMode end

	hideBtn.MouseButton1Click:Connect(function()
		win:Toggle(false)
		if not hintShown and not (UIS.TouchEnabled and not UIS.KeyboardEnabled) then
			hintShown = true
			Library:Notify({ Title = "Interface masquée",
				Content = "Appuie sur " .. tostring(toggleKey.Name or toggleKey) .. " pour la rouvrir.",
				Duration = 3.5, Type = "Info" })
		end
	end)

	track(UIS.InputBegan:Connect(function(i, processed)
		if processed or Library._listening then return end
		if i.KeyCode == toggleKey then
			win:Toggle()
		elseif i.KeyCode == Enum.KeyCode.R
			and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then
			win:Reset()
		end
	end))

	-- Orbe flottant pour mobile (pas de clavier) : déplaçable
	if UIS.TouchEnabled and not UIS.KeyboardEnabled then
		local fb = new("TextButton", { Position = UDim2.new(0, 14, 0.5, -21), Size = UDim2.fromOffset(42, 42),
			BackgroundColor3 = T.Main, BackgroundTransparency = 0.05, Text = "", AutoButtonColor = false,
			BorderSizePixel = 0 }, gui)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, fb)
		local fst = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0.1, ApplyStrokeMode = BORDER }, fb)
		spin(new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(70, 70, 75)),
			Transparency = ringSeq() }, fst), 140)
		local pt = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.2,
			BorderSizePixel = 0 }, fb)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, pt)
		fb.InputBegan:Connect(function(i)
			if isPress(i) then
				local start = Vector2.new(i.Position.X, i.Position.Y)
				local p0 = fb.Position
				local moved = false
				startDrag(function(p)
					local d = Vector2.new(p.X, p.Y) - start
					if d.Magnitude > 8 then moved = true end
					if moved then
						fb.Position = UDim2.new(p0.X.Scale, p0.X.Offset + d.X, p0.Y.Scale, p0.Y.Offset + d.Y)
					end
				end, nil, i.Position, function()
					if not moved then win:Toggle() end
				end)
			end
		end)
	end

	-- ------------------------------------------------------------------
	-- Boucles d'animation
	--   RenderStepped : uniquement le déplacement / redimensionnement lissé + tooltip (léger, à chaque frame)
	--   Heartbeat     : le fond (anneaux + étoiles), limité à ~30 Hz (~15 Hz pendant un geste) au lieu d'être
	--                   recalculé à chaque frame ; il ne se met plus en pause brutalement, il ralentit seulement.
	-- ------------------------------------------------------------------
	track(RunService.RenderStepped:Connect(function(dt)
		if not main.Visible then return end
		dt = math.min(dt, 0.1)
		local dirty = false
		if tgtSize then
			if rsSmooth then
				local d = tgtSize - curSize
				if d.Magnitude < 0.5 then
					curSize = tgtSize
					tgtSize = nil
				else
					curSize = curSize + d * (1 - math.exp(-dt * 16))
				end
			else
				curSize = tgtSize
				tgtSize = nil
			end
			if applySize(curSize) then dirty = true end
		end
		if tgtPos then
			local d = tgtPos - curPos
			if d.Magnitude < 0.3 then
				curPos = tgtPos
				tgtPos = nil
			else
				curPos = curPos + d * (1 - math.exp(-dt * 24))
			end
			dirty = true
		end
		if dirty then setMainPos() end
		if tipShown and tipLabel then
			local m = UIS:GetMouseLocation()
			local v = viewport()
			local sz = tipLabel.AbsoluteSize
			local x, y = m.X + 14, m.Y + 18
			if x + sz.X > v.X - 4 then x = m.X - sz.X - 10 end
			if y + sz.Y > v.Y - 4 then y = m.Y - sz.Y - 10 end
			tipLabel.Position = UDim2.fromOffset(x, y)
		end
	end))

	local bgAcc = 0
	local fpsFrames, fpsT = 0, os.clock()
	local pingItem
	pcall(function() pingItem = Stats.Network.ServerStatsItem["Data Ping"] end)
	track(RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		fpsFrames += 1
		if now - fpsT >= 0.5 then
			if statsOn then
				local fps = math.floor(fpsFrames / (now - fpsT) + 0.5)
				local ping = 0
				if pingItem then
					local ok, v = pcall(function() return pingItem:GetValue() end)
					if ok and v then ping = math.floor(v + 0.5) end
				end
				fpsLabel.Text = fps .. " fps | " .. ping .. " ms"
			end
			fpsFrames, fpsT = 0, now
		end

		if not main.Visible or bgMode == "off" then return end
		bgAcc += dt
		local busy = activeDrag ~= nil or now < (Library._busyUntil or 0)
		if bgAcc < (busy and (1 / 15) or (1 / 30)) then return end
		local step = math.min(bgAcc, 0.1)
		bgAcc = 0

		for _, sp in ipairs(spinners) do
			sp.a = ((sp.a or 0) + step * sp.speed * (Library.SpinSpeed or 1)) % 360
			sp.g.Rotation = sp.a
		end
		hst.Transparency = Library.Breathing and (0.34 + 0.16 * math.sin(now * 1.7)) or 0.3
		waveT = waveT + step * (Library.WaveSpeed or 1)
		waveIntro = waveIntro + step * 1.1
		local w, h = main.Size.X.Offset, main.Size.Y.Offset
		stepWaves(w, h)
		if collapsed then return end
		local cx, cy = holeCenter(w, h)
		for n = 1, starLim do
			local s = stars[n]
			local dx, dy = cx - s.x, cy - s.y
			local d = math.sqrt(dx * dx + dy * dy)
			if d < 24 or s.x < -10 or s.x > w + 10 or s.y < -10 or s.y > h + 10 then
				respawn(s, w, h, cx, cy)
				s.f.BackgroundTransparency = 1
			else
				local pull  = (s.v + 5200 / (d + 40)) * step
				local swirl = (2600 / (d + 80)) * step
				s.x = s.x + dx / d * pull - dy / d * swirl
				s.y = s.y + dy / d * pull + dx / d * swirl
				local fade = math.clamp((d - 24) / 70, 0, 1) * math.clamp((now - s.born) / 0.8, 0, 1)
				s.f.Position = UDim2.fromOffset(s.x, s.y)
				s.f.BackgroundTransparency = 1 - s.a * fade
			end
		end
	end))

	-- Animation d'apparition
	if useCanvas then main.GroupTransparency = 1 end
	uiScale.Scale = 0.9
	tween(uiScale, { Scale = 1 }, 0.7, BACK)
	if useCanvas then tween(main, { GroupTransparency = 0 }, 0.5) end

	-- Mémorisation de la fenêtre dans la config + favoris
	saveWin()
	Library.Items["__window"] = {
		Get = function() return Library.Flags["__window"] end,
		Set = function(_, d)
			if type(d) == "table" and d.w then win:ApplyLayout(d) end
		end,
	}
	registerFavItem()

	if cfg.Settings ~= false then
		win._noSelect = true
		local ok, err = pcall(function() win:CreateSettingsTab(cfg.SettingsName or "Réglages", cfg.SettingsIcon, true) end)
		win._noSelect = nil
		if not ok then warn("[Ui-Lib] Onglet Réglages : " .. tostring(err)) end
	end
	persistReady = true

	Library.Window = win
	win:RefreshShape()
	win:RefreshHole()
	Library.DefaultTheme = Library:GetTheme()
	Library._autoDone = false
	if cfg.AutoLoad ~= false then
		task.delay(tonumber(cfg.AutoLoadDelay) or 1.2, function()
			if Library.Window == win then Library:AutoLoad() end
		end)
	end
	return win
end

function Library:Destroy()
	for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
	table.clear(Conns)
	table.clear(spinners)
	table.clear(activeNotifs)
	Library._openDD = nil
	Library._listening = false
	if Library.Window and Library.Window.Gui then Library.Window.Gui:Destroy() end
	Library.Window = nil
	if notifGui then notifGui:Destroy() notifGui = nil end
	table.clear(Library.Flags)
	table.clear(Library.Items)
	table.clear(Library.CornerObjects)
	table.clear(Library.FavEntries)
	table.clear(Library.FavStars)
	table.clear(Library.Defaults)
	Library._titleGrad = nil
	tipLabel, tipShown = nil, false
	Library._autoDone = false
end

return Library
