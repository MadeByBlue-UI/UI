	end
	BUILD.Action = BUILD.Button

	BUILD.Slider = function(f, e)
		local o, it = e.Opts, e.Item
		local min, max = o.Min or 0, o.Max or 100
		local suffix = o.Suffix and tostring(o.Suffix) or ""
		local hdr = newHeader(f, e, 104)
		local box = new("TextBox", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(88, 26), BackgroundColor3 = T.Off, BackgroundTransparency = 0.55, Text = "",
			TextColor3 = T.Text, TextSize = 12, Font = F_MED, ClearTextOnFocus = false, BorderSizePixel = 0 }, hdr)
		round(box, 8)
		local body = new("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, LayoutOrder = 2 }, f)
		local bar = new("Frame", { Position = UDim2.new(0, 16, 0, 8), Size = UDim2.new(1, -32, 0, 6),
			BackgroundColor3 = T.Off, BorderSizePixel = 0 }, body)
		round(bar, 1)
		local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, bar)
		round(fill, 1)
		local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(14, 14), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, bar)
		round(knob, 1)
		local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, body)
		local function show(v)
			v = tonumber(v) or min
			local span = max - min
			local ratio = span == 0 and 0 or math.clamp((v - min) / span, 0, 1)
			fill.Size = UDim2.new(ratio, 0, 1, 0)
			knob.Position = UDim2.new(ratio, 0, 0.5, 0)
			if not box:IsFocused() then box.Text = tostring(v) .. suffix end
		end
		hit.InputBegan:Connect(function(i)
			if not isPress(i) then return end
			tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.2, BACK)
			startDrag(function(p)
				local t = math.clamp((p.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
				pcall(it.Set, it, min + t * (max - min))
				show(safeGet(it))
			end, S.list, i.Position, function()
				tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.25)
				remember(e)
			end)
		end)
		box.FocusLost:Connect(function()
			local n = tonumber(string.match(box.Text, "-?%d+%.?%d*"))
			if n then pcall(it.Set, it, n) remember(e) end
			show(safeGet(it))
		end)
		show(safeGet(it))
	end

	BUILD.Dropdown = function(f, e)
		local o, it = e.Opts, e.Item
		local multi = (o.Multi == true) or (o.MultiSelect == true) or (o.MultipleOptions == true)
		local src = o.Items or o.Options or {}
		if type(o.UpdateList) == "function" then
			local ok, r = pcall(o.UpdateList)
			if ok and type(r) == "table" then src = r end
		end
		local names = {}
		for _, v in ipairs(src) do names[#names + 1] = tostring(v) end
		local hdr = newHeader(f, e, 150)
		local valL = label(hdr, "", 12, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0),
			Size = UDim2.fromOffset(136, 18), TextXAlignment = RIGHT, TextColor3 = T.ElementAccent })
		local body = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
			LayoutOrder = 2, Visible = #names > 0 }, f)
		new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14) }, body)
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 6),
			SortOrder = BYORDER }, body)
		local chips = {}
		local function current()
			local cur = safeGet(it)
			local set = {}
			if type(cur) == "table" then
				for _, x in ipairs(cur) do set[tostring(x)] = true end
			elseif cur ~= nil then
				set[tostring(cur)] = true
			end
			return set, cur
		end
		local function paint()
			local set, cur = current()
			for n, c in pairs(chips) do
				local on = set[n] == true
				tween(c, { BackgroundTransparency = on and 0.72 or 0.93, TextColor3 = on and T.Accent or T.ElementAccent }, 0.18)
			end
			if multi then
				if type(cur) ~= "table" or #cur == 0 then valL.Text = "Choisir..."
				elseif #cur <= 2 then valL.Text = table.concat(cur, ", ")
				else valL.Text = #cur .. " choisis" end
			else
				valL.Text = tostring(cur or "Choisir...")
			end
		end
		for idx, n in ipairs(names) do
			if idx > 30 then break end
			local c = new("TextButton", { Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = T.Accent, BackgroundTransparency = 0.93, Text = n, TextColor3 = T.ElementAccent,
				TextSize = 12, Font = F_MED, AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = idx }, body)
			round(c, 1)
			new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, c)
			chips[n] = c
			c.MouseButton1Click:Connect(function()
				if multi then
					local set = current()
					local list = {}
					for _, m in ipairs(names) do
						if (m == n and not set[m]) or (m ~= n and set[m]) then list[#list + 1] = m end
					end
					pcall(it.Set, it, list)
				else
					pcall(it.Set, it, n)
				end
				paint()
				remember(e)
			end)
		end
		paint()
	end

