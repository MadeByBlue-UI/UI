local SOUND_BY_NAME, SOUND_NAMES = {}, {}
for _, p in ipairs(SOUND_PRESETS) do
	SOUND_BY_NAME[p.Name] = p
	SOUND_NAMES[#SOUND_NAMES + 1] = p.Name
end
Library.SoundPresetNames = SOUND_NAMES
Library.NotifSound  = true
Library.NotifSoundLimit = true     -- « Limiter les sons » : plusieurs notifications d'affilée = un seul son
Library.NotifSoundGap   = 0.6      -- secondes pendant lesquelles les autres sons sont ignorés
Library.NotifVolume = 0.6
Library.NotifSounds = {
	Info    = { Preset = "Ping",         Custom = "" },
	Success = { Preset = "Ping aigu",    Custom = "" },
	Warning = { Preset = "Interrupteur", Custom = "" },
	Error   = { Preset = "Basse",        Custom = "" },
	Loading = { Preset = "Aucun",        Custom = "" },
}
Library.NotifBlackHole = true      -- effet « aspiré par le trou noir » à la fermeture
Library.NotifOverflow  = "Pill"    -- "Pill" = pastille +N au-delà du max | "Close" = ferme les plus anciennes
Library._silentSound   = 0         -- >0 : pas d'aperçu sonore (chargement d'une config)

local notifSoundObjs, lastSndAt = {}, 0

local function resolveSound(spec)
	if type(spec) ~= "table" then return nil end
	if spec.Preset == "Personnalisé" then
		local c = tostring(spec.Custom or ""):match("^%s*(.-)%s*$")
		if c == "" then return nil end
		if tonumber(c) then return "rbxassetid://" .. c, 1 end
		if c:find("^rbx") then return c, 1 end
		local ok, r = pcall(function()
			if isfile and getcustomasset and isfile(c) then return getcustomasset(c) end
		end)
		if ok and r then return r, 1 end
		return nil
	end
	local p = SOUND_BY_NAME[spec.Preset]
	if p and p.Id then return p.Id, p.Speed or 1, p end
	return nil
end

local NS = { Prio = { Loading = 0, Info = 1, Success = 2, Warning = 3, Error = 4 }, LastPrio = 0 }

local function playNotifSound(kind, preview)
	local prio = NS.Prio[kind] or 1
	if not preview then
		if not Library.NotifSound then return end
		local now = os.clock()
		local limit = Library.NotifSoundLimit ~= false
		local gap = limit and math.max(tonumber(Library.NotifSoundGap) or 0.6, 0.12) or 0.12
		if now - lastSndAt < gap then
			-- limité : seul le premier son passe ; un son plus important (erreur > alerte > succès > info) le remplace
			if not limit or prio <= NS.LastPrio then return end
			for k, o in pairs(notifSoundObjs) do
				if k ~= kind and o.Parent then pcall(function() o:Stop() end) end
			end
		end
		lastSndAt, NS.LastPrio = now, prio
	end
	local id, speed, pr = resolveSound(Library.NotifSounds[kind])
	if not id then return end
	ensureNotif()
	local s = notifSoundObjs[kind]
	if not (s and s.Parent) then
		s = Instance.new("Sound")
		s.Name = "Snd" .. tostring(kind)
		for _, def in ipairs({ { "EqualizerSoundEffect", "Eq" }, { "ReverbSoundEffect", "Rv" }, { "EchoSoundEffect", "Echo" } }) do
			local fxObj = Instance.new(def[1])
			fxObj.Name, fxObj.Enabled = def[2], false
			fxObj.Parent = s
		end
		s.Parent = notifGui
		notifSoundObjs[kind] = s
	end
	-- effets du son choisi (filtre doux / réverbération / écho) ; coupés pour les sons sans effet
	local fx = pr or {}
	local eq, rv, ec = s:FindFirstChild("Eq"), s:FindFirstChild("Rv"), s:FindFirstChild("Echo")
	if eq then
		eq.Enabled = fx.Lp == true
		if fx.Lp then eq.LowGain, eq.MidGain, eq.HighGain = 3, -3, -28 end
	end
	if rv then
		rv.Enabled = fx.Rv ~= nil
		if fx.Rv then rv.DecayTime, rv.Density, rv.Diffusion, rv.DryLevel, rv.WetLevel = fx.Rv[1], 1, 1, -2, fx.Rv[2] end
	end
	if ec then
		ec.Enabled = fx.Echo ~= nil
		if fx.Echo then ec.Delay, ec.Feedback, ec.DryLevel, ec.WetLevel = fx.Echo[1], fx.Echo[2], 0, fx.Echo[3] end
	end
	if s.SoundId ~= id then s.SoundId = id end
	s.PlaybackSpeed = speed or 1
	s.Volume = math.clamp((tonumber(Library.NotifVolume) or 0.6) * (fx.Vol or 1), 0, 1)
	s.TimePosition = 0
	local tok = (s:GetAttribute("tok") or 0) + 1
	s:SetAttribute("tok", tok)
	s:Play()
	if fx.Len then   -- coupe en douceur les sons trop longs
		task.delay(fx.Len, function()
			if s.Parent and s:GetAttribute("tok") == tok then
				TweenService:Create(s, TweenInfo.new(0.2), { Volume = 0 }):Play()
				task.delay(0.22, function()
					if s.Parent and s:GetAttribute("tok") == tok then s:Stop() end
				end)
			end
		end)
	end
end

function Library:PlayNotifSound(kind) playNotifSound(NOTIF_ICON[kind] and kind or "Info", true) end
function Library:GetSoundPresets() return table.clone(SOUND_NAMES) end

-- Library:SetNotifSound("Error", "Basse")  |  Library:SetNotifSound("Success", "123456789")  (ID perso)
function Library:SetNotifSound(kind, preset, custom)
	local spec = Library.NotifSounds[kind]
	if not spec then return false end
	if SOUND_BY_NAME[preset] then
		spec.Preset = preset
		if custom ~= nil then spec.Custom = tostring(custom) end
	elseif preset ~= nil then
		spec.Preset, spec.Custom = "Personnalisé", tostring(preset)
	end
	return true
end
function Library:SetNotifSoundEnabled(v) Library.NotifSound = v and true or false end
function Library:SetNotifVolume(v) Library.NotifVolume = math.clamp(tonumber(v) or 0.6, 0, 1) end
function Library:SetNotifSoundLimit(v) Library.NotifSoundLimit = v and true or false end
function Library:SetNotifSoundGap(sec) Library.NotifSoundGap = math.clamp(tonumber(sec) or 0.6, 0.1, 3) end

-- ───────────── Pastille « +N » (notifications masquées au-delà du maximum) ─────────────
local pillHost, pillBtn, pillScale, pillGrad
local pillCount = 0

local function pillAlign()
	local _, left, center = notifSide()
	return center and 0.5 or (left and 0 or 1)
end

local function ensurePill()
	if pillHost and pillHost.Parent then return end
	ensureNotif()
	pillHost = new("Frame", { Name = "OverflowPill", Size = UDim2.fromOffset(112, 30), BackgroundTransparency = 1,
		BorderSizePixel = 0, Visible = false }, notifHolder)
	pillBtn = new("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(64, 26), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.04,
		Text = "+1", TextColor3 = T.Text, TextSize = 12, Font = F_BOLD, AutoButtonColor = false,
		BorderSizePixel = 0 }, pillHost)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, pillBtn)
	local st = new("UIStroke", { Color = T.Accent, Thickness = 1.5, Transparency = 0.25, ApplyStrokeMode = BORDER }, pillBtn)
	pillGrad = new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(70, 70, 78)),
		Transparency = ringSeq() }, st)
	TweenService:Create(pillGrad, TweenInfo.new(3.5, LINEAR, OUT, -1), { Rotation = 360 }):Play()
	pillScale = new("UIScale", { Scale = 1 }, pillBtn)
	local function txt(hover) pillBtn.Text = "+" .. pillCount .. (hover and "  ·  vider" or "") end
	pillBtn.MouseEnter:Connect(function()
		txt(true)
		tween(pillBtn, { Size = UDim2.fromOffset(108, 26) }, 0.25)
	end)
	pillBtn.MouseLeave:Connect(function()
		txt(false)
		tween(pillBtn, { Size = UDim2.fromOffset(64, 26) }, 0.25)
	end)
	pillBtn.MouseButton1Click:Connect(function()
		for _, e in ipairs(table.clone(notifEntries)) do
			if e.hidden and not e.dead then pcall(e.handle.Dismiss) end
		end
	end)
end

local function updatePill(n)
	if n <= 0 then
		if pillHost and pillHost.Visible and pillCount > 0 then
			pillCount = 0
			-- la pastille est « aspirée » à son tour
			tween(pillScale, { Scale = 0 }, 0.3, BACK, Enum.EasingDirection.In)
			local host = pillHost
			task.delay(0.32 / math.max(Library.AnimSpeed or 1, 0.05), function()
				if pillCount == 0 and host.Parent then host.Visible = false end
			end)
		end
		return
	end
	ensurePill()
	local top = notifSide()
	local ax = pillAlign()
	pillHost.LayoutOrder = top and 1000000000 or -1000000000
	pillBtn.AnchorPoint = Vector2.new(ax, 0.5)
	pillBtn.Position = UDim2.new(ax, 0, 0.5, 0)
	local grew = n ~= pillCount
	local first = not pillHost.Visible
	pillCount = n
	pillBtn.Text = "+" .. n
	pillHost.Visible = true
	if first then
		pillScale.Scale = 0
		tween(pillScale, { Scale = 1 }, 0.45, BACK)
	elseif grew then
		pillScale.Scale = 1.3
		tween(pillScale, { Scale = 1 }, 0.45, BACK)
	end
end

-- Cache les plus anciennes au-delà du max (leur minuteur est mis en pause) et met la pastille à jour
local function refreshStack()
	if not notifHolder then return end
	local max = math.max(math.floor(tonumber(Library.NotifMax) or 5), 1)
	local live = {}
	for _, e in ipairs(notifEntries) do
		if not e.dead then live[#live + 1] = e end
	end
	local nHidden = (Library.NotifOverflow == "Pill") and math.max(#live - max, 0) or 0
	for idx, e in ipairs(live) do
		if e.setHidden then e.setHidden(idx <= nHidden) end
	end
	updatePill(nHidden)
end

function Library:SetNotifMax(n)
	Library.NotifMax = math.clamp(math.floor(tonumber(n) or 5), 1, 12)
	if Library.NotifOverflow == "Pill" then
		refreshStack()
	else
		while #activeNotifs > Library.NotifMax do activeNotifs[1]() end
	end
end

function Library:SetNotifOverflow(m)
	Library.NotifOverflow = (m == "Close" or m == false) and "Close" or "Pill"
	refreshStack()
	if Library.NotifOverflow == "Close" then
		while #activeNotifs > math.max(tonumber(Library.NotifMax) or 5, 1) do activeNotifs[1]() end
	end
end

function Library:SetNotifBlackHole(v) Library.NotifBlackHole = v and true or false end

-- ───────────── Effet « papier froissé aspiré par un trou noir » ─────────────
-- La carte se brouille (images fantômes qui tremblent), se plisse (arêtes et facettes claires), se tasse en boule de
-- papier pendant qu'un trou noir s'ouvre derrière elle, puis la boule spirale vers le centre du trou et disparaît.
-- De petits morceaux de papier s'en détachent et sont aspirés eux aussi. Une onde de choc referme tout. Noir & blanc.
local function blackHoleOut(slot, card, cardScale, h, accent)
	local k = 1 / math.max(Library.AnimSpeed or 1, 0.05)
	local cw = card.AbsoluteSize.X / math.max(cardScale.Scale, 0.01)
	if cw < 10 then cw = Library.NotifWidth or 300 end
	local cy = h / 2
	local dirSpin = (math.random() < 0.5) and -1 or 1
	local WHITE, BLACK = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
	local KP = NumberSequenceKeypoint.new
	local rnd, sin, cos, clamp = math.random, math.sin, math.cos, math.clamp
	local IN = Enum.EasingDirection.In
	local TOT = 1.0            -- durée du mouvement (en « secondes animation »)
	local BALL_W, BALL_H = 70, 46
	local R0 = math.min(cw * 0.2, 52)

	-- on fige la carte (taille en pixels) et on la recentre pour qu'elle se froisse autour de son milieu
	card.AutomaticSize = AN
	card.Size = UDim2.fromOffset(cw, h)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.new(0.5, 0, 0, cy)
	card.ZIndex = 10
	local cardCornerObj = card:FindFirstChildOfClass("UICorner")

	-- images fantômes (effet de flou de mouvement), prises avant que la carte ne change
	local ghosts = {}
	if canvasSupported then
		for i = 1, 2 do
			local g = card:Clone()
			g.Name = "Ghost"
			g.ZIndex = 8
			g.GroupTransparency = 0.62
			for _, d in ipairs(g:GetDescendants()) do
				if d:IsA("GuiButton") then d.Active = false end
			end
			g.Parent = slot
			ghosts[i] = g
		end
	end

	-- le contenu s'efface vite : il ne reste qu'une feuille noire qui se plisse (le contour blanc reste)
	local keep = card:FindFirstChild("Outline")
	for _, d in ipairs(card:GetDescendants()) do
		if d ~= keep and not (keep and d:IsDescendantOf(keep)) then
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				tween(d, { TextTransparency = 1, BackgroundTransparency = 1 }, 0.2)
			elseif d:IsA("GuiObject") then
				tween(d, { BackgroundTransparency = 1 }, 0.2)
			elseif d:IsA("UIStroke") then
				tween(d, { Transparency = 1 }, 0.2)
			end
		end
	end

	-- plis : arêtes claires + facettes douces, qui apparaissent l'une après l'autre
	local folds = {}
	for i = 1, 6 do
		local f = new("Frame", { Name = "Fold", AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.1 + rnd() * 0.8, 0, 0.1 + rnd() * 0.8, 0), Size = UDim2.new(0.4 + rnd() * 0.5, 0, 0, 1),
			Rotation = rnd(-70, 70), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0,
			ZIndex = 40 }, card)
		folds[#folds + 1] = { f = f, d = 0.02 + i * 0.035, to = 0.4 + rnd() * 0.25 }
	end
	for i = 1, 4 do
		local f = new("Frame", { Name = "Facet", AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.15 + rnd() * 0.7, 0, 0.2 + rnd() * 0.6, 0),
			Size = UDim2.new(0.5 + rnd() * 0.4, 0, 0.9, 0), Rotation = rnd(-60, 60), BackgroundColor3 = WHITE,
			BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 39 }, card)
		new("UIGradient", { Rotation = rnd(0, 180), Transparency = NumberSequence.new({ KP(0, 0), KP(1, 1) }) }, f)
		folds[#folds + 1] = { f = f, d = 0.05 + i * 0.04, to = 0.8 + rnd() * 0.08 }
	end

	-- le trou noir (derrière la carte) : disque noir, anneau photonique, deux bras qui tournent, halo
	local hole = new("Frame", { Name = "BlackHole", AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, cy), Size = UDim2.fromOffset(160, 160), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 3 }, slot)
	local holeScale = new("UIScale", { Scale = 0 }, hole)
	local function disc(d, z, fill, ftr)
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(d, d), BackgroundColor3 = fill or BLACK, BackgroundTransparency = ftr or 1,
			BorderSizePixel = 0, ZIndex = z }, hole)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		return f
	end
	local function ring(d, z, thick, tr, seq)
		local f = disc(d, z)
		local st = new("UIStroke", { Color = WHITE, Thickness = thick, Transparency = tr, ApplyStrokeMode = BORDER }, f)
		local g = new("UIGradient", { Transparency = seq }, st)
		return g
	end
	disc(150, 1, WHITE, 0.965)
	ring(150, 1, 1, 0.8, NumberSequence.new(0))
	local arm1 = ring(128, 2, 2, 0.1, NumberSequence.new({ KP(0, 0), KP(0.38, 0.1), KP(0.5, 1), KP(1, 1) }))
	local arm2 = ring(100, 3, 3, 0.05, NumberSequence.new({ KP(0, 1), KP(0.5, 1), KP(0.58, 0.1), KP(1, 0) }))
	ring(78, 4, 2.5, 0, NumberSequence.new(0))
	disc(72, 5, BLACK, 0)
	TweenService:Create(arm1, TweenInfo.new(1.1 * k, LINEAR, OUT, -1), { Rotation = 360 * dirSpin }):Play()
	TweenService:Create(arm2, TweenInfo.new(0.75 * k, LINEAR, OUT, -1), { Rotation = -360 * dirSpin }):Play()

	local wave = new("Frame", { Name = "Shock", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, cy),
		Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 11 }, slot)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, wave)
	local wst = new("UIStroke", { Color = WHITE, Thickness = 2, Transparency = 1, ApplyStrokeMode = BORDER }, wave)

	-- morceaux de papier arrachés, aspirés en spirale
	local scraps = {}
	for i = 1, 12 do
		local sx, sy = (rnd() - 0.5) * cw * 0.85, (rnd() - 0.5) * h * 0.8
		local f = new("Frame", { Name = "Scrap", AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(rnd(3, 6), rnd(2, 4)), BackgroundColor3 = (i % 3 == 0) and Color3.fromRGB(190, 190, 195) or WHITE,
			BackgroundTransparency = 1, BorderSizePixel = 0, Rotation = rnd(0, 180), ZIndex = 12 }, slot)
		scraps[i] = { f = f, r0 = math.sqrt(sx * sx + sy * sy), a0 = math.atan2(sy, sx), d = 0.06 + rnd() * 0.3,
			s = 4 + rnd() * 3, rot = (rnd() - 0.5) * 900 }
	end

	-- ouverture du trou noir, puis fermeture dans une onde de choc
	task.delay(0.05 * k, function()
		if hole.Parent then tween(holeScale, { Scale = 1 }, 0.35, BACK) end
	end)
	task.delay(0.9 * k, function()
		if not hole.Parent then return end
		tween(holeScale, { Scale = 0 }, 0.2, QUINT, IN)
		wave.Size = UDim2.fromOffset(40, 40)
		wst.Transparency = 0.1
		tween(wave, { Size = UDim2.fromOffset(190, 190) }, 0.35)
		tween(wst, { Transparency = 1 }, 0.35)
	end)
	task.delay(0.7 * k, function()
		if slot.Parent then tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, 0.3) end
	end)

	-- mouvement de la carte (une seule boucle : froissage, puis spirale vers le centre)
	local ang0 = rnd() * math.pi * 2
	local t0 = os.clock()
	task.spawn(function()
		while slot.Parent and card.Parent do
			local t = (os.clock() - t0) / k
			if t > TOT then break end
			local A = clamp(t / 0.34, 0, 1)                 -- froissage
			local eA = 1 - (1 - A) ^ 3
			local B = clamp((t - 0.2) / 0.75, 0, 1)         -- aspiration
			local shrink = 1 - B ^ 2.2
			local jit = 1 - B
			local w = (cw + (BALL_W - cw) * eA) * shrink * (1 + 0.05 * sin(t * 47) * jit)
			local hh = (h + (BALL_H - h) * eA) * shrink * (1 + 0.08 * sin(t * 53 + 1) * jit)
			card.Size = UDim2.fromOffset(math.max(w, 0), math.max(hh, 0))
			local r = R0 * (1 - B) * math.min(B * 4, 1)
			local ang = ang0 + dirSpin * (B * 7 + B * B * 6)
			local px, py = cos(ang) * r, sin(ang) * r * 0.8
			card.Position = UDim2.new(0.5, px, 0, cy + py)
			card.Rotation = 7 * sin(t * 36) * (1 - A) + dirSpin * 640 * B ^ 1.7
			if cardCornerObj then cardCornerObj.CornerRadius = UDim.new(0, 22 + 24 * eA) end
			local fade = clamp((B - 0.7) / 0.3, 0, 1)
			if canvasSupported then card.GroupTransparency = fade else card.BackgroundTransparency = fade end

			for _, p in ipairs(folds) do
				local u = clamp((t - p.d) / 0.1, 0, 1)
				p.f.BackgroundTransparency = 1 - u * (1 - p.to) * (1 - fade)
			end

			local gt = clamp(t / 0.42, 0, 1)
			for i, g in ipairs(ghosts) do
				if gt >= 1 then
					g.Visible = false
				else
					local amp = 7 * (1 - gt)
					g.Size = card.Size
					g.Position = UDim2.new(0.5, px + sin(t * 70 + i * 2.1) * amp, 0, cy + py + cos(t * 83 + i * 1.3) * amp)
					g.Rotation = card.Rotation + ((i == 1) and 3 or -3) * (1 - gt)
					g.GroupTransparency = 0.6 + 0.4 * gt
				end
			end

			for _, p in ipairs(scraps) do
				local u = clamp((t - p.d) / 0.55, 0, 1)
				if u > 0 then
					local e = u * u
					local rr = p.r0 * (1 - e)
					local aa = p.a0 + dirSpin * p.s * e
					p.f.Position = UDim2.new(0.5, cos(aa) * rr, 0, cy + sin(aa) * rr)
					p.f.Rotation = p.rot * u
					local tr = (u < 0.12) and (1 - u / 0.12 * 0.9) or 0.1
					if u > 0.8 then tr = math.min(1, 0.1 + (u - 0.8) * 4.5) end
					p.f.BackgroundTransparency = tr
				end
			end
			RunService.Heartbeat:Wait()
		end
		for _, g in ipairs(ghosts) do g:Destroy() end
		for _, p in ipairs(scraps) do p.f:Destroy() end
	end)
end

-- ───────────── V9 : STYLES DE FERMETURE DES NOTIFICATIONS ─────────────
-- Library:SetNotifExit("Briser")   ·   Library.NotifExit   ·   Library.NotifExitStyles (liste des noms)
-- Library.NotifExitByType = { Error = "Briser", Success = "Tourbillon" }   (style différent selon le type)
-- Une notification peut aussi choisir le sien : Library:Notify({ ..., Exit = "Effacer vers le haut" })
-- Pour ajouter un style : ajoute son nom dans NotifExitStyles puis une fonction EXITS["Nom"] plus bas ;
-- elle reçoit (slot, card, cardScale, h) et renvoie la durée de l'animation en secondes.
Library.NotifExit = "Trou noir"
Library.NotifExitStyles = { "Trou noir", "Fondu", "Rétrécir", "Tourbillon", "Briser", "Casser", "Dissoudre",
	"Effacer vers le haut", "Effacer vers le bas", "Effacer vers la gauche", "Effacer vers la droite",
	"Glisser", "Aléatoire" }
Library.NotifExitByType = {}

local EXIT_SET = {}
for _, n in ipairs(Library.NotifExitStyles) do EXIT_SET[n] = true end

local function resolveExit(s)
	if type(s) ~= "string" or not EXIT_SET[s] then s = Library.NotifExit end
	if not EXIT_SET[s] then s = "Trou noir" end
	if s == "Aléatoire" then
		local pool = {}
		for _, n in ipairs(Library.NotifExitStyles) do
			if n ~= "Aléatoire" and n ~= "Glisser" then pool[#pool + 1] = n end
		end
		s = pool[math.random(#pool)]
	end
	if s == "Trou noir" and Library.NotifBlackHole == false then s = "Glisser" end
	return s
end

function Library:SetNotifExit(s)
	if EXIT_SET[s] then
		Library.NotifExit = s
		return true
	end
	return false
end

-- ───────────── V10 : STYLES D'ENTRÉE DES NOTIFICATIONS ─────────────
-- Désactivés par défaut (Library.NotifEntryCustom = false) : l'entrée classique (glissement + rebond) est gardée.
-- Library:SetNotifEntryEnabled(true) · Library:SetNotifEntry("Éclats") · Library.NotifEntryStyles (liste des noms)
-- Library.NotifEntryByType = { Error = "Éclats", Success = "Trou noir" } · Library:Notify({ ..., Entry = "Balayage depuis la gauche" })
Library.NotifEntryCustom = false
Library.NotifEntry = "Trou noir"
Library.NotifEntryStyles = { "Trou noir", "Éclats", "Balayage depuis la gauche", "Balayage depuis la droite",
	"Balayage depuis le haut", "Balayage depuis le bas", "Aléatoire" }
Library.NotifEntryByType = {}

local ENTRY_SET = {}
for _, n in ipairs(Library.NotifEntryStyles) do ENTRY_SET[n] = true end

local function resolveEntry(explicit, kind)
	if explicit == false or explicit == "Glisser" then return nil end
	local s
	if type(explicit) == "string" and ENTRY_SET[explicit] then
		s = explicit
	else
		if not Library.NotifEntryCustom then return nil end
		s = Library.NotifEntryByType and Library.NotifEntryByType[kind]
		if type(s) ~= "string" or not ENTRY_SET[s] then s = Library.NotifEntry end
		if not ENTRY_SET[s] then s = "Trou noir" end
	end
	if s == "Aléatoire" then
		local pool = {}
		for _, n in ipairs(Library.NotifEntryStyles) do
			if n ~= "Aléatoire" then pool[#pool + 1] = n end
		end
		s = pool[math.random(#pool)]
	end
	return s
end

function Library:SetNotifEntry(s)
	if ENTRY_SET[s] then
		Library.NotifEntry = s
		return true
	end
	return false
end

function Library:SetNotifEntryEnabled(v)
	Library.NotifEntryCustom = v and true or false
end

do
	local EXITS = {}
	local KP = NumberSequenceKeypoint.new
	local IN, INOUT = Enum.EasingDirection.In, Enum.EasingDirection.InOut
	local WHITE = Color3.new(1, 1, 1)
	local function K() return 1 / math.max(Library.AnimSpeed or 1, 0.05) end

	-- fige la carte en pixels (sa hauteur automatique ne doit plus bouger) et renvoie sa largeur
	local function freezeCard(card, cardScale, h)
		local cw = card.AbsoluteSize.X / math.max(cardScale.Scale, 0.01)
		if cw < 10 then cw = Library.NotifWidth or 300 end
		card.AutomaticSize = AN
		card.Size = UDim2.fromOffset(cw, h)
		cardScale.Scale = 1
		return cw
	end
	local function fadeCard(card, to, t, style, dir)
		if canvasSupported then
			tween(card, { GroupTransparency = to }, t, style, dir)
		else
			tween(card, { BackgroundTransparency = (to >= 1) and 1 or 0.03 }, t, style, dir)
		end
	end
	-- la place de la notification se referme (les autres remontent / descendent en douceur)
	local function collapse(slot, delay, t)
		task.delay(delay * K(), function()
			if slot.Parent then tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, t) end
		end)
	end

	-- FONDU : la carte s'efface sur place
	EXITS["Fondu"] = function(slot, card, cardScale, h)
		collapse(slot, 0.3, 0.3)
		fadeCard(card, 1, 0.4)
		tween(cardScale, { Scale = 0.96 }, 0.4)
		return 0.7
	end

	-- RÉTRÉCIR : la carte se rétracte vers son centre
	EXITS["Rétrécir"] = function(slot, card, cardScale, h)
		freezeCard(card, cardScale, h)
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.new(0.5, 0, 0, h / 2)
		tween(cardScale, { Scale = 0 }, 0.45, BACK, IN)
		fadeCard(card, 1, 0.45, QUINT, IN)
		collapse(slot, 0.3, 0.3)
		return 0.75
	end

	-- TOURBILLON : la carte tourne de plus en plus vite dans un anneau de vortex et se fait aspirer
	EXITS["Tourbillon"] = function(slot, card, cardScale, h)
		freezeCard(card, cardScale, h)
		local k = K()
		local dirSpin = (math.random() < 0.5) and -1 or 1
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.new(0.5, 0, 0, h / 2)
		card.ZIndex = 10
		local function vortex(d, thick, tr, dur)
			local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, h / 2),
				Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3 }, slot)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
			local st = new("UIStroke", { Color = T.Accent, Thickness = thick, Transparency = tr, ApplyStrokeMode = BORDER }, f)
			local g = new("UIGradient", { Color = ColorSequence.new(WHITE, Color3.fromRGB(60, 60, 68)),
				Transparency = ringSeq() }, st)
			tween(f, { Size = UDim2.fromOffset(d, d) }, 0.35, BACK)
			TweenService:Create(g, TweenInfo.new(dur * k, LINEAR, OUT, -1), { Rotation = 360 * dirSpin }):Play()
			task.delay(0.72 * k, function()
				if f.Parent then tween(f, { Size = UDim2.fromOffset(0, 0) }, 0.25, QUINT, IN) end
			end)
		end
		vortex(150, 2, 0.1, 0.6)
		vortex(104, 1.5, 0.4, -0.45)
		tween(card, { Rotation = dirSpin * 620 }, 0.85, QUINT, IN)
		tween(cardScale, { Scale = 0 }, 0.85, QUINT, IN)
		task.delay(0.5 * k, function()
			if card.Parent then fadeCard(card, 1, 0.3) end
		end)
		collapse(slot, 0.6, 0.3)
		return 1.0
	end

	-- EFFACER vers le haut / bas / gauche / droite : un masque rogne la carte, un trait lumineux suit le bord
	local function wipe(slot, card, cardScale, h, side)
		local cw = freezeCard(card, cardScale, h)
		card.AnchorPoint = Vector2.new(0, 0)
		local mask = new("Frame", { Name = "Wipe", BackgroundTransparency = 1, BorderSizePixel = 0,
			ClipsDescendants = true, ZIndex = 10 }, slot)
		local line = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0,
			BackgroundTransparency = 0.15, ZIndex = 30 }, slot)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, line)
		local vertical = (side == "up" or side == "down")
		new("UIGradient", { Rotation = vertical and 0 or 90,
			Transparency = NumberSequence.new({ KP(0, 1), KP(0.5, 0), KP(1, 1) }) }, line)
		local goalSize, lineFrom, lineTo
		if side == "up" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 0), UDim2.fromOffset(0, 0), UDim2.fromOffset(cw, h)
			card.Position = UDim2.fromOffset(0, 0)
			goalSize = UDim2.fromOffset(cw, 0)
			line.Size = UDim2.fromOffset(cw - 30, 2)
			lineFrom, lineTo = UDim2.fromOffset(cw / 2, h), UDim2.fromOffset(cw / 2, 0)
		elseif side == "down" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 1), UDim2.new(0, 0, 1, 0), UDim2.fromOffset(cw, h)
			card.Position = UDim2.new(0, 0, 1, -h)
			goalSize = UDim2.fromOffset(cw, 0)
			line.Size = UDim2.fromOffset(cw - 30, 2)
			lineFrom, lineTo = UDim2.fromOffset(cw / 2, 0), UDim2.fromOffset(cw / 2, h)
		elseif side == "left" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 0), UDim2.fromOffset(0, 0), UDim2.fromOffset(cw, h)
			card.Position = UDim2.fromOffset(0, 0)
			goalSize = UDim2.fromOffset(0, h)
			line.Size = UDim2.fromOffset(2, h - 20)
			lineFrom, lineTo = UDim2.fromOffset(cw, h / 2), UDim2.fromOffset(0, h / 2)
		else
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(1, 0), UDim2.new(1, 0, 0, 0), UDim2.fromOffset(cw, h)
			card.Position = UDim2.new(1, -cw, 0, 0)
			goalSize = UDim2.fromOffset(0, h)
			line.Size = UDim2.fromOffset(2, h - 20)
			lineFrom, lineTo = UDim2.fromOffset(0, h / 2), UDim2.fromOffset(cw, h / 2)
		end
		line.Position = lineFrom
		card.Parent = mask
		tween(mask, { Size = goalSize }, 0.55, QUINT, INOUT)
		tween(line, { Position = lineTo }, 0.55, QUINT, INOUT)
		task.delay(0.45 * K(), function()
			if line.Parent then tween(line, { BackgroundTransparency = 1 }, 0.15) end
		end)
		collapse(slot, 0.4, 0.3)
		return 0.8
	end
	EXITS["Effacer vers le haut"]    = function(s, c, cs, h) return wipe(s, c, cs, h, "up") end
	EXITS["Effacer vers le bas"]     = function(s, c, cs, h) return wipe(s, c, cs, h, "down") end
	EXITS["Effacer vers la gauche"]  = function(s, c, cs, h) return wipe(s, c, cs, h, "left") end
	EXITS["Effacer vers la droite"]  = function(s, c, cs, h) return wipe(s, c, cs, h, "right") end

	-- BRISER / CASSER / DISSOUDRE : la carte est découpée en morceaux (copies rognées) qui s'envolent
	--   shatter : grille de 6x3 éclats projetés + gravité · crack : cassée en deux (trait de fissure) ·
	--   dissolve : fine grille de 9x3 qui s'efface de gauche à droite en s'élevant
	local function shards(slot, card, cardScale, h, mode)
		local cw = freezeCard(card, cardScale, h)
		local k = K()
		local cols, rows
		if mode == "crack" then cols, rows = 2, 1
		elseif mode == "dissolve" then cols, rows = 9, 3
		else cols, rows = 6, 3 end
		local sw, sh = cw / cols, h / rows
		local rng = Random.new()
		local pieces, total = {}, 0

		for r = 0, rows - 1 do
			for c = 0, cols - 1 do
				local x, y = c * sw, r * sh
				local box = new(canvasSupported and "CanvasGroup" or "Frame", { AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(x + sw / 2, y + sh / 2),
					Size = UDim2.fromOffset(math.ceil(sw) + 1, math.ceil(sh) + 1), BackgroundTransparency = 1,
					BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 10 }, slot)
				local bs = new("UIScale", { Scale = 1 }, box)
				local cl = card:Clone()
				cl.Name = "Shard"
				cl.AutomaticSize = AN
				cl.Size = UDim2.fromOffset(cw, h)
				cl.AnchorPoint = Vector2.new(0, 0)
				cl.Position = UDim2.fromOffset(-math.floor(x), -math.floor(y))
				cl.Rotation = 0
				cl.Visible = true
				if canvasSupported then cl.GroupTransparency = 0 end
				local us = cl:FindFirstChildOfClass("UIScale")
				if us then us.Scale = 1 end
				for _, d in ipairs(cl:GetDescendants()) do
					if d:IsA("GuiButton") then d.Active = false end
				end
				cl.Parent = box

				local cx = ((c + 0.5) / cols) * 2 - 1
				local cy = ((r + 0.5) / rows) * 2 - 1
				local p = { box = box, bs = bs, x = x + sw / 2, y = y + sh / 2, rot = 0 }
				if mode == "crack" then
					p.d, p.life, p.g = 0.3, 0.95, 900
					p.vx, p.vy = cx * 55, 0
					p.rv = cx * 150
				elseif mode == "dissolve" then
					p.d = (c / cols) * 0.32 + rng:NextNumber(0, 0.18)
					p.life, p.g = 0.32, 0
					p.vx, p.vy = rng:NextNumber(-16, 16), rng:NextNumber(-70, -20)
					p.rv = rng:NextNumber(-40, 40)
				else
					p.d = rng:NextNumber(0, 0.1) + math.abs(cx) * 0.04
					p.life, p.g = 0.95, 1000
					p.vx = cx * rng:NextNumber(70, 200) + rng:NextNumber(-40, 40)
					p.vy = cy * rng:NextNumber(40, 100) - rng:NextNumber(60, 180)
					p.rv = rng:NextNumber(-280, 280)
				end
				total = math.max(total, p.d + p.life)
				pieces[#pieces + 1] = p
			end
		end
		card.Visible = false

		if mode == "crack" then
			local segs = 4
			local segH = h / segs
			for i = 1, segs do
				local odd = (i % 2 == 1)
				local sg = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(cw / 2 + (odd and -4 or 4), (i - 0.5) * segH),
					Size = UDim2.fromOffset(2, segH * 1.3), Rotation = odd and -14 or 14, BackgroundColor3 = WHITE,
					BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 40 }, slot)
				task.delay(0.28 * k, function()
					if sg.Parent then tween(sg, { BackgroundTransparency = 1 }, 0.3) end
				end)
			end
		end

		collapse(slot, mode == "dissolve" and 0.45 or 0.55, 0.3)
		task.spawn(function()
			local t0 = os.clock()
			local last = t0
			while slot.Parent do
				RunService.Heartbeat:Wait()
				local now = os.clock()
				local dt = math.min(now - last, 0.05) / k
				last = now
				local t = (now - t0) / k
				if t > total then break end
				for _, p in ipairs(pieces) do
					local u = t - p.d
					if u > 0 and p.box.Parent then
						p.vy = p.vy + p.g * dt
						p.x = p.x + p.vx * dt
						p.y = p.y + p.vy * dt
						p.rot = p.rot + p.rv * dt
						local f = math.clamp(u / p.life, 0, 1)
						p.box.Position = UDim2.fromOffset(p.x, p.y)
						p.box.Rotation = p.rot
						if canvasSupported then
							p.box.GroupTransparency = f ^ 1.4
							p.bs.Scale = (mode == "dissolve") and (1 - 0.4 * f) or 1
						else
							p.bs.Scale = math.max(1 - f, 0)
						end
					end
				end
			end
		end)
		return total + 0.1
	end
	EXITS["Briser"]    = function(s, c, cs, h) return shards(s, c, cs, h, "shatter") end
	EXITS["Casser"]    = function(s, c, cs, h) return shards(s, c, cs, h, "crack") end
	EXITS["Dissoudre"] = function(s, c, cs, h) return shards(s, c, cs, h, "dissolve") end

	-- ─────────── STYLES D'ENTRÉE ───────────
	-- Chaque style reçoit (slot, card, cardScale, h, cw) et renvoie (durée en secondes d'animation, fonction de nettoyage).
	-- La carte est remise en état normal par Notify (settleCard) une fois l'animation finie.
	local ENTER = {}

	-- TROU NOIR : un trou noir s'ouvre, la carte en sort en tournant et s'agrandit, puis le trou se referme
	ENTER["Trou noir"] = function(slot, card, cardScale, h, cw)
		local k = K()
		local dirSpin = (math.random() < 0.5) and -1 or 1
		freezeCard(card, cardScale, h)
		if canvasSupported then card.GroupTransparency = 0 end
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.new(0.5, 0, 0, h / 2)
		card.ZIndex = 10
		cardScale.Scale = 0
		card.Rotation = dirSpin * -240
		local made = {}
		local function ring(d, thick, tr, dur, black)
			local fr = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, h / 2),
				Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = black and 0 or 1, BorderSizePixel = 0, ZIndex = 3 }, slot)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, fr)
			local sk = new("UIStroke", { Color = T.Accent, Thickness = thick, Transparency = tr, ApplyStrokeMode = BORDER }, fr)
			local g = new("UIGradient", { Color = ColorSequence.new(WHITE, Color3.fromRGB(60, 60, 68)),
				Transparency = ringSeq() }, sk)
			tween(fr, { Size = UDim2.fromOffset(d, d) }, 0.3, BACK)
			TweenService:Create(g, TweenInfo.new(math.abs(dur) * k, LINEAR, OUT, -1),
				{ Rotation = 360 * ((dur < 0) and -dirSpin or dirSpin) }):Play()
			task.delay(0.55 * k, function()
				if fr.Parent then tween(fr, { Size = UDim2.fromOffset(0, 0) }, 0.3, QUINT, IN) end
			end)
			made[#made + 1] = fr
		end
		local D = math.clamp(cw * 0.45, 110, 160)
		ring(D, 2, 0.1, 0.6, true)
		ring(D * 0.7, 1.5, 0.4, -0.45, false)
		task.delay(0.1 * k, function()
			if not card.Parent then return end
			tween(cardScale, { Scale = 1 }, 0.6, BACK)
			tween(card, { Rotation = 0 }, 0.6)
		end)
		return 0.9, function()
			for _, fr in ipairs(made) do fr:Destroy() end
		end
	end

	-- ÉCLATS : la carte est découpée en 6x3 morceaux, dispersés, qui volent vers leur place et se recomposent
	ENTER["Éclats"] = function(slot, card, cardScale, h, cw)
		local k = K()
		freezeCard(card, cardScale, h)
		card.AnchorPoint = Vector2.new(0, 0)
		card.Position = UDim2.new(0, 0, 0, 0)
		if canvasSupported then card.GroupTransparency = 0 end
		local cols, rows = 6, 3
		local sw, sh = cw / cols, h / rows
		local rng = Random.new()
		local pieces, total = {}, 0
		local alive = true
		local function clear()
			for _, p in ipairs(pieces) do
				if p.box.Parent then p.box:Destroy() end
			end
		end
		for r = 0, rows - 1 do
			for c = 0, cols - 1 do
				local x, y = c * sw, r * sh
				local hx, hy = x + sw / 2, y + sh / 2
				local cx = ((c + 0.5) / cols) * 2 - 1
				local cy = ((r + 0.5) / rows) * 2 - 1
				local p = { hx = hx, hy = hy, d = rng:NextNumber(0, 0.18), life = 0.55,
					sx = hx + cx * rng:NextNumber(70, 190) + rng:NextNumber(-40, 40),
					sy = hy + cy * rng:NextNumber(30, 90) - rng:NextNumber(50, 150),
					sr = rng:NextNumber(-260, 260) }
				local box = new(canvasSupported and "CanvasGroup" or "Frame", { Name = "ShardIn",
					AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(p.sx, p.sy), Rotation = p.sr,
					Size = UDim2.fromOffset(math.ceil(sw) + 1, math.ceil(sh) + 1), BackgroundTransparency = 1,
					BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 10 }, slot)
				if canvasSupported then box.GroupTransparency = 1 end
				local bs = new("UIScale", { Scale = canvasSupported and 1 or 0 }, box)
				local cl = card:Clone()
				cl.Name = "Shard"
				cl.AutomaticSize = AN
				cl.Size = UDim2.fromOffset(cw, h)
				cl.AnchorPoint = Vector2.new(0, 0)
				cl.Position = UDim2.fromOffset(-math.floor(x), -math.floor(y))
				cl.Rotation = 0
				cl.Visible = true
				if canvasSupported then cl.GroupTransparency = 0 end
				for _, d in ipairs(cl:GetDescendants()) do
					if d:IsA("GuiButton") then d.Active = false end
				end
				cl.Parent = box
				p.box, p.bs = box, bs
				total = math.max(total, p.d + p.life)
				pieces[#pieces + 1] = p
			end
		end
		card.Visible = false
		task.spawn(function()
			local t0 = os.clock()
			while alive and slot.Parent do
				RunService.Heartbeat:Wait()
				local t = (os.clock() - t0) / k
				if t > total then break end
				for _, p in ipairs(pieces) do
					local u = t - p.d
					if u > 0 and p.box.Parent then
						local f = math.clamp(u / p.life, 0, 1)
						local e = 1 - (1 - f) ^ 3
						p.box.Position = UDim2.fromOffset(p.sx + (p.hx - p.sx) * e, p.sy + (p.hy - p.sy) * e)
						p.box.Rotation = p.sr * (1 - e)
						if canvasSupported then
							p.box.GroupTransparency = math.clamp(1 - f * 2.2, 0, 1)
						else
							p.bs.Scale = e
						end
					end
				end
			end
			if alive then
				alive = false
				clear()
				if card.Parent then card.Visible = true end
			end
		end)
		return total + 0.05, function()
			alive = false
			clear()
			card.Visible = true
		end
	end

	-- BALAYAGE : un masque révèle la carte depuis un côté, un trait lumineux suit le bord
	local function wipeIn(slot, card, cardScale, h, cw, side)
		local k = K()
		freezeCard(card, cardScale, h)
		if canvasSupported then card.GroupTransparency = 0 end
		card.AnchorPoint = Vector2.new(0, 0)
		local mask = new("Frame", { Name = "WipeIn", BackgroundTransparency = 1, BorderSizePixel = 0,
			ClipsDescendants = true, ZIndex = 10 }, slot)
		local line = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0,
			BackgroundTransparency = 0.15, ZIndex = 30 }, slot)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, line)
		local vertical = (side == "top" or side == "bottom")
		new("UIGradient", { Rotation = vertical and 0 or 90,
			Transparency = NumberSequence.new({ KP(0, 1), KP(0.5, 0), KP(1, 1) }) }, line)
		local goal, lineFrom, lineTo
		if side == "left" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 0), UDim2.fromOffset(0, 0), UDim2.fromOffset(0, h)
			card.Position = UDim2.fromOffset(0, 0)
			line.Size = UDim2.fromOffset(2, h - 20)
			lineFrom, lineTo = UDim2.fromOffset(0, h / 2), UDim2.fromOffset(cw, h / 2)
		elseif side == "right" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(1, 0), UDim2.fromOffset(cw, 0), UDim2.fromOffset(0, h)
			card.Position = UDim2.new(1, -cw, 0, 0)
			line.Size = UDim2.fromOffset(2, h - 20)
			lineFrom, lineTo = UDim2.fromOffset(cw, h / 2), UDim2.fromOffset(0, h / 2)
		elseif side == "top" then
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 0), UDim2.fromOffset(0, 0), UDim2.fromOffset(cw, 0)
			card.Position = UDim2.fromOffset(0, 0)
			line.Size = UDim2.fromOffset(cw - 30, 2)
			lineFrom, lineTo = UDim2.fromOffset(cw / 2, 0), UDim2.fromOffset(cw / 2, h)
		else
			mask.AnchorPoint, mask.Position, mask.Size = Vector2.new(0, 1), UDim2.fromOffset(0, h), UDim2.fromOffset(cw, 0)
			card.Position = UDim2.new(0, 0, 1, -h)
			line.Size = UDim2.fromOffset(cw - 30, 2)
			lineFrom, lineTo = UDim2.fromOffset(cw / 2, h), UDim2.fromOffset(cw / 2, 0)
		end
		goal = UDim2.fromOffset(cw, h)
		line.Position = lineFrom
		card.Parent = mask
		tween(mask, { Size = goal }, 0.55, QUINT, INOUT)
		tween(line, { Position = lineTo }, 0.55, QUINT, INOUT)
		task.delay(0.45 * k, function()
			if line.Parent then tween(line, { BackgroundTransparency = 1 }, 0.15) end
		end)
		return 0.7, function()
			if card.Parent == mask then card.Parent = slot end
			mask:Destroy()
			line:Destroy()
		end
	end
	ENTER["Balayage depuis la gauche"] = function(s, c, cs, h, cw) return wipeIn(s, c, cs, h, cw, "left") end
	ENTER["Balayage depuis la droite"] = function(s, c, cs, h, cw) return wipeIn(s, c, cs, h, cw, "right") end
	ENTER["Balayage depuis le haut"]   = function(s, c, cs, h, cw) return wipeIn(s, c, cs, h, cw, "top") end
	ENTER["Balayage depuis le bas"]    = function(s, c, cs, h, cw) return wipeIn(s, c, cs, h, cw, "bottom") end

	-- appelé par l'entrée : renvoie (durée en secondes d'animation, fonction de nettoyage)
	V6.enter = function(style, slot, card, cardScale, h, cw)
		local f = ENTER[style]
		if f then
			local ok, d, c = pcall(f, slot, card, cardScale, h, cw)
			if ok and tonumber(d) then
				return d, (type(c) == "function") and c or function() end
			end
			warn("[Ui-Lib] Style d'entrée « " .. tostring(style) .. " » : " .. tostring(d))
		end
		return 0.01, function() end
	end
	V6.resolveEntry = resolveEntry

	-- appelé par la fermeture : renvoie la durée (en secondes d'animation)
	V6.exit = function(style, slot, card, cardScale, h)
		local f = EXITS[style]
		if f then
			local ok, d = pcall(f, slot, card, cardScale, h)
			if ok and tonumber(d) then return d end
			warn("[Ui-Lib] Style de fermeture « " .. tostring(style) .. " » : " .. tostring(d))
		end
		fadeCard(card, 1, 0.35)
		collapse(slot, 0.2, 0.3)
		return 0.6
	end
	V6.resolveExit = resolveExit
end

	V6.play, V6.refresh, V6.hole = playNotifSound, refreshStack, blackHoleOut
end

function Library:Notify(o)
	if type(o) ~= "table" then o = { Content = tostring(o) } end
	local kind = NOTIF_ICON[o.Type] and o.Type or "Info"
	if (o.Progress ~= nil or o.Loading) and not NOTIF_ICON[o.Type] then kind = "Loading" end

	-- historique (même si « Ne pas déranger »)
	local hist = Library.NotifHistory
	hist[#hist + 1] = { Time = os.time(), Title = tostring(o.Title or "Notification"),
		Content = tostring(o.Content or ""), Type = kind }
	while #hist > 50 do table.remove(hist, 1) end
	if Library.NotifMuted and not o.Force and kind ~= "Error" then return noopHandle() end

	-- doublon : on empile (x2, x3...) au lieu d'ajouter une carte
	local stackable = (o.Stack ~= false) and o.Progress == nil and not o.Loading
		and kind ~= "Loading" and not o.Actions
	local key = kind .. "|" .. tostring(o.Title or "") .. "|" .. tostring(o.Content or "")
	-- « ne plus afficher » : cette notification a été masquée par l'utilisateur
	if Library.NotifSilenced[key] and not o.Force then return noopHandle() end
	if stackable and Library.NotifStack then
		for _, e in ipairs(notifEntries) do
			if not e.dead and e.stackable and e.key == key then
				e.bump()
				V6.play(kind)
				return e.handle
			end
		end
	end

	ensureNotif()
	V6.play(kind)
	notifCount = notifCount + 1
	local top, left, center = notifSide()
	local width = Library.NotifWidth or 300

	-- mode : timer | progress | loading | sticky
	local dur = o.Duration
	if dur == nil then dur = Library.NotifDuration or 4 end
	dur = tonumber(dur) or 4
	local finiteDur = dur > 0 and dur < math.huge
	local mode
	if o.Progress ~= nil then mode = "progress"
	elseif o.Loading or kind == "Loading" then mode = "loading"
	elseif not finiteDur then mode = "sticky"
	else mode = "timer" end
	if not finiteDur then dur = Library.NotifDuration or 4 end
	local progress = math.clamp(tonumber(o.Progress) or 0, 0, 1)

	local function farOffset(sign)
		if center then return UDim2.new(0, 0, 0, top and -90 or 90) end
		local s = sign or (left and -1 or 1)
		return UDim2.new(0, s * (width + 40), 0, 0)
	end
	local inward = center and 0 or (left and 1 or -1)
	local nudge = UDim2.new(0, inward * 6, 0, center and (top and 3 or -3) or 0)
	local ZERO = UDim2.new(0, 0, 0, 0)

	-- ---------------------------------------------------------------- carte
	local slot = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AN, BackgroundTransparency = 1, BorderSizePixel = 0,
		LayoutOrder = top and -notifCount or notifCount,
	}, notifHolder)
	local card = new(canvasSupported and "CanvasGroup" or "Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Position = farOffset(),
		BackgroundColor3 = T.Main, BackgroundTransparency = 0.03, BorderSizePixel = 0,
		ClipsDescendants = not canvasSupported,
	}, slot)
	if canvasSupported then card.GroupTransparency = 1 end
	-- style moderne : noir profond, coins très arrondis (pilule), fin contour blanc, léger reflet en haut
	local cardCorner = new("UICorner", { CornerRadius = UDim.new(0, 22) }, card)
	local cardScale = new("UIScale", { Scale = 0.9 }, card)
	local sheen = new("Frame", { Name = "Sheen", Size = UDim2.new(1, 0, 0.6, 0), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 2 }, card)
	new("UICorner", { CornerRadius = UDim.new(0, 22) }, sheen)
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.93), NumberSequenceKeypoint.new(1, 1) }) }, sheen)

	local inner = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
		ZIndex = 6 }, card)
	new("UIPadding", { PaddingTop = UDim.new(0, 13), PaddingBottom = UDim.new(0, 17),
		PaddingLeft = UDim.new(0, 56), PaddingRight = UDim.new(0, 16) }, inner)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = BYORDER }, inner)
	local CT = 0.2   -- transparence finale du texte secondaire (blanc légèrement adouci, pas de gris terne)
	local titleL = label(inner, o.Title or "Notification", 14, { Font = F_BOLD, Size = UDim2.new(1, -34, 0, 18),
		LayoutOrder = 1, TextTransparency = 1, ZIndex = 6 })
	local contentL = label(inner, o.Content or "", 12, { TextColor3 = T.Text, TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None, AutomaticSize = AY, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2,
		TextTransparency = 1, ZIndex = 6 })
	contentL.Visible = contentL.Text ~= ""

	local actRow = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
		LayoutOrder = 3, Visible = false, ZIndex = 6 }, inner)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
		SortOrder = BYORDER }, actRow)
	new("UIPadding", { PaddingTop = UDim.new(0, 7) }, actRow)

	-- liseré de couleur à gauche
	local strip = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 3, 0, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0, Visible = false,
		ZIndex = 6 }, card)

	-- pastille d'icône (+ onde, + spinner)
	local icoHold = new("Frame", { Position = UDim2.new(0, 14, 0, 13), Size = UDim2.new(0, 28, 0, 28),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6 }, card)
	local pulse = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(28, 28), BackgroundTransparency = 1, BorderSizePixel = 0 }, icoHold)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, pulse)
	local pulseSt = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 1 }, pulse)
	local ico = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9,
		BorderSizePixel = 0 }, icoHold)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, ico)
	local icoScale = new("UIScale", { Scale = 0 }, ico)
	local icoText = label(ico, "i", 14, { Font = F_BOLD, TextXAlignment = CENTER })
	local icoImg = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(Library.NotifLogoSize or NOTIF_LOGO_SIZE, Library.NotifLogoSize or NOTIF_LOGO_SIZE),
		BackgroundTransparency = 1, BorderSizePixel = 0, Image = Library.NotifLogo or NOTIF_LOGO,
		ScaleType = Enum.ScaleType.Fit, Visible = false }, ico)
	local icoImgCorner = new("UICorner", { CornerRadius = UDim.new(0, 0) }, icoImg)   -- rond quand on affiche un avatar (o.Icon)
	local spinRing = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false }, ico)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, spinRing)
	local spinSt = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0 }, spinRing)
	local spinGrad = new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0.2),
		NumberSequenceKeypoint.new(0.62, 1), NumberSequenceKeypoint.new(1, 1) }) }, spinSt)
	local spinTw

	-- badge « x2 » (doublons)
	local badge = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.new(0, 26, 0, 16), BackgroundColor3 = T.Accent, BackgroundTransparency = 0,
		BorderSizePixel = 0, Visible = false, ZIndex = 6 }, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, badge)
	local badgeScale = new("UIScale", { Scale = 1 }, badge)
	local badgeL = label(badge, "x2", 10, { Font = F_BOLD, TextXAlignment = CENTER, ZIndex = 6,
		TextColor3 = Color3.fromRGB(10, 10, 12) })

	-- contour intérieur + piste de durée / progression
	local outline = new("Frame", { Name = "Outline", Position = UDim2.new(0, 1, 0, 1), Size = UDim2.new(1, -2, 1, -2),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 7 }, card)
	new("UICorner", { CornerRadius = UDim.new(0, 21) }, outline)
	local outSt = stroke(outline, 0.82)
	local track = new("Frame", { Position = UDim2.new(0, 24, 1, -9), Size = UDim2.new(1, -48, 0, 2),
		BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, BorderSizePixel = 0, ClipsDescendants = true,
		ZIndex = 6 }, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
	local fill = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = T.Accent,
		BackgroundTransparency = 0.05, BorderSizePixel = 0, ZIndex = 6 }, track)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	-- reflet qui balaie la carte
	local shine = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, Visible = false, ZIndex = 8 }, card)
	new("UICorner", { CornerRadius = UDim.new(0, 22) }, shine)
	local shineGrad = new("UIGradient", { Rotation = 20, Offset = Vector2.new(-1.3, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 1), NumberSequenceKeypoint.new(0.5, 0.82),
			NumberSequenceKeypoint.new(0.6, 1), NumberSequenceKeypoint.new(1, 1) }) }, shine)

	local clickArea = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, ZIndex = 5 }, card)

	-- ---------------------------------------------------------------- état
	local dead = false
	local entry, handle
	local entryCleanup   -- style d'entrée en cours (V10) : nettoie les éléments d'animation
	local function settleCard()
		card.AnchorPoint = Vector2.new(0, 0)
		card.Rotation = 0
		card.ZIndex = 1
		card.Visible = true
		if card.Parent ~= slot then card.Parent = slot end
		cardScale.Scale = 1
		card.Position = ZERO
		card.AutomaticSize = AY
		card.Size = UDim2.new(1, 0, 0, 0)
		if canvasSupported then card.GroupTransparency = 0 end
		slot.AutomaticSize = AY
		slot.Size = UDim2.new(1, 0, 0, 0)
	end
	local token, remaining, startedAt, paused, barTw, loadTw = 0, dur, 0, false, nil, nil
	local count = 1
	local baseTr = 0.82
	local hov = 0
	local dismiss, runTimer

	local function stopBar()
		if barTw then barTw:Cancel() barTw = nil end
	end

	local function shinePlay()
		if not Library.Animations then return end
		local t = 0.8 / math.max(Library.AnimSpeed or 1, 0.05)
		shine.Visible = true
		shineGrad.Offset = Vector2.new(-1.3, 0)
		tween(shineGrad, { Offset = Vector2.new(1.3, 0) }, 0.8)
		local my = (shine:GetAttribute("S") or 0) + 1
		shine:SetAttribute("S", my)
		task.delay(t + 0.1, function()
			if shine:GetAttribute("S") == my then shine.Visible = false end
		end)
	end

	local function applyKind(k)
		kind = k
		local c = notifKindColor(k)
		local ac = c or T.Accent
		ico.BackgroundColor3 = ac            -- pastille pleine : blanche (ou couleur du type si NotifColored)
		icoText.Text = NOTIF_ICON[k] or ""
		icoText.Visible = false              -- plus de lettre : le logo prend la place
		if o.Icon and o.Icon ~= "" then   -- image perso (ex. avatar d'un joueur) : petit rond à la place du logo
			icoImg.Image = tostring(o.Icon)
			icoImg.Size = UDim2.fromOffset(32, 32)
			icoImg.ScaleType = Enum.ScaleType.Crop
			icoImgCorner.CornerRadius = UDim.new(1, 0)
		else
			icoImg.Image = Library.NotifLogo or NOTIF_LOGO
			icoImg.Size = UDim2.fromOffset(Library.NotifLogoSize or NOTIF_LOGO_SIZE, Library.NotifLogoSize or NOTIF_LOGO_SIZE)
			icoImg.ScaleType = Enum.ScaleType.Fit
			icoImgCorner.CornerRadius = UDim.new(0, 0)
		end
		icoImg.Visible = k ~= "Loading"       -- chargement : on garde la pastille + l'anneau qui tourne
		ico.BackgroundTransparency = (k == "Loading") and 0 or 1
		icoText.TextColor3 = Color3.fromRGB(10, 10, 12)
		strip.BackgroundColor3 = ac
		strip.Visible = false                -- plus de liseré : la carte est une pilule
		outSt.Color = ac
		baseTr = c and 0.55 or 0.8
		outSt.Transparency = baseTr
		fill.BackgroundColor3 = ac
		pulseSt.Color = ac
		spinSt.Color = Color3.fromRGB(10, 10, 12)
		spinRing.Visible = k == "Loading"
		if spinTw then spinTw:Cancel() spinTw = nil end
		if k == "Loading" then
			spinTw = TweenService:Create(spinGrad, TweenInfo.new(0.9, LINEAR, OUT, -1), { Rotation = 360 })
			spinTw:Play()
		end
	end

	local function playIcon()
		icoScale.Scale = 0
		ico.Rotation = (kind == "Success") and -90 or 0
		tween(icoScale, { Scale = 1 }, 0.5, BACK)
		if kind == "Success" then tween(ico, { Rotation = 0 }, 0.5) end
		pulse.Size = UDim2.fromOffset(28, 28)
		pulseSt.Transparency = 0.15
		tween(pulse, { Size = UDim2.fromOffset(62, 62) }, 0.75)
		tween(pulseSt, { Transparency = 1 }, 0.75)
		if not Library.Animations then return end
		if kind == "Error" then
			task.spawn(function()
				task.wait(0.2)
				for _, dx in ipairs({ -4, 4, -3, 3, -2, 2, 0 }) do
					if dead then return end
					tween(icoHold, { Position = UDim2.new(0, 14 + dx, 0, 13) }, 0.05, LINEAR)
					task.wait(0.05)
				end
			end)
		elseif kind == "Warning" then
			task.spawn(function()
				task.wait(0.2)
				for _, r in ipairs({ -16, 14, -9, 6, 0 }) do
					if dead then return end
					tween(ico, { Rotation = r }, 0.07, LINEAR)
					task.wait(0.07)
				end
			end)
		end
	end

	-- ---------------------------------------------------------------- minuteur
	runTimer = function()
		if mode ~= "timer" or dead then return end
		if entry and entry.hidden then
			-- masquée derrière la pastille +N : le minuteur démarre quand elle redevient visible
			paused = true
			startedAt = os.clock()
			fill.Size = UDim2.new(math.clamp(remaining / dur, 0, 1), 0, 1, 0)
			return
		end
		token += 1
		local my = token
		stopBar()
		paused = false
		startedAt = os.clock()
		fill.Size = UDim2.new(math.clamp(remaining / dur, 0, 1), 0, 1, 0)
		barTw = TweenService:Create(fill, TweenInfo.new(math.max(remaining, 0.01), LINEAR, OUT),
			{ Size = UDim2.new(0, 0, 1, 0) })
		barTw:Play()
		task.delay(remaining, function()
			if token == my and not dead then dismiss(nil, "timeout") end
		end)
	end

	local function pauseTimer()
		if mode ~= "timer" or paused or dead then return end
		paused = true
		token += 1
		stopBar()
		remaining = math.max(remaining - (os.clock() - startedAt), 0.25)
		fill.Size = UDim2.new(math.clamp(remaining / dur, 0, 1), 0, 1, 0)
	end

	local function resumeTimer()
		if paused and not dead then runTimer() end
	end

	local function applyMode()
		if dead then return end
		stopBar()
		if loadTw then loadTw:Cancel() loadTw = nil end
		token += 1
		paused = false
		fill.Position = UDim2.new(0, 0, 0, 0)
		if mode == "timer" then
			track.Visible = true
			remaining = dur
			runTimer()
		elseif mode == "progress" then
			track.Visible = true
			tween(fill, { Size = UDim2.new(progress, 0, 1, 0) }, 0.25)
		elseif mode == "loading" then
			track.Visible = true
			fill.Size = UDim2.new(0.35, 0, 1, 0)
			fill.Position = UDim2.new(-0.35, 0, 0, 0)
			loadTw = TweenService:Create(fill, TweenInfo.new(1.1, Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut, -1), { Position = UDim2.new(1, 0, 0, 0) })
			loadTw:Play()
		else
			track.Visible = false
		end
	end

	-- ---------------------------------------------------------------- fermeture
	dismiss = function(dir, reason)
		if dead then return end
		dead = true
		entry.dead = true
		if entryCleanup then entryCleanup() end   -- fermée pendant son entrée : on termine proprement
		token += 1
		stopBar()
		if loadTw then loadTw:Cancel() loadTw = nil end
		if spinTw then spinTw:Cancel() spinTw = nil end
		for idx, fn in ipairs(activeNotifs) do
			if fn == entry.overflow then table.remove(activeNotifs, idx) break end
		end
		for idx, e in ipairs(notifEntries) do
			if e == entry then table.remove(notifEntries, idx) break end
		end
		if o.OnDismiss then fire(o.OnDismiss, reason or "api") end

		local function dropCorner()
			for idx, c in ipairs(Library.CornerObjects) do
				if c.Corner == cardCorner then table.remove(Library.CornerObjects, idx) break end
			end
		end
		task.defer(V6.refresh)   -- une notification masquée peut reprendre sa place, la pastille se met à jour
		if entry.hidden then
			dropCorner()
			slot:Destroy()
			return
		end
		local h = slot.AbsoluteSize.Y
		slot.AutomaticSize = AN
		slot.Size = UDim2.new(1, 0, 0, h)
		local sign = (type(dir) == "number" and dir ~= 0) and dir or nil

		-- style de fermeture (sauf swipe : là, la carte suit le doigt / la souris)
		local style = V6.resolveExit(o.Exit or (Library.NotifExitByType and Library.NotifExitByType[kind]) or Library.NotifExit)
		if style ~= "Glisser" and Library.Animations and not sign and h > 4 then
			local dur
			if style == "Trou noir" then
				V6.hole(slot, card, cardScale, h, notifKindColor(kind) or T.Accent)
				dur = 1.15
			else
				dur = V6.exit(style, slot, card, cardScale, h)
			end
			task.delay(dur / math.max(Library.AnimSpeed or 1, 0.05) + 0.05, function()
				dropCorner()
				slot:Destroy()
			end)
			return
		end

		if canvasSupported then tween(card, { GroupTransparency = 1 }, 0.35) end
		tween(card, { Position = farOffset(sign) }, 0.42)
		tween(cardScale, { Scale = 0.94 }, 0.3)
		task.delay(0.22, function()
			if slot.Parent then tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, 0.3) end
		end)
		task.delay(0.6, function()
			dropCorner()
			slot:Destroy()
		end)
	end

	-- ---------------------------------------------------------------- survol (pause + petit décalage)
	local function hoverChange(delta)
		if dead then return end
		hov = math.max(hov + delta, 0)
		if hov > 0 then
			if Library.NotifPauseOnHover ~= false then pauseTimer() end
			tween(card, { Position = nudge }, 0.25)
			tween(outSt, { Transparency = math.max(baseTr - 0.3, 0.05) }, 0.25)
		else
			task.delay(0.06, function()
				if hov == 0 and not dead then
					resumeTimer()
					tween(card, { Position = ZERO }, 0.3)
					tween(outSt, { Transparency = baseTr }, 0.3)
				end
			end)
		end
	end
	clickArea.MouseEnter:Connect(function() hoverChange(1) end)
	clickArea.MouseLeave:Connect(function() hoverChange(-1) end)

	-- ---------------------------------------------------------------- boutons d'action
	local function buildActions(list)
		for _, c in ipairs(actRow:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		actRow.Visible = type(list) == "table" and #list > 0
		if type(list) ~= "table" then return end
		for idx, a in ipairs(list) do
			local btn = new("TextButton", { Size = UDim2.new(0, 0, 0, 26), AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, Text = tostring(a.Text or a.Name or "OK"),
				TextColor3 = T.Text, TextSize = 12, Font = F_MED, AutoButtonColor = false, BorderSizePixel = 0,
				LayoutOrder = idx, ZIndex = 6 }, actRow)
			new("UICorner", { CornerRadius = UDim.new(0, 13) }, btn)
			new("UIPadding", { PaddingLeft = UDim.new(0, 13), PaddingRight = UDim.new(0, 13) }, btn)
			btn.MouseEnter:Connect(function()
				tween(btn, { BackgroundTransparency = 0.76 }, 0.15)
				hoverChange(1)
			end)
			btn.MouseLeave:Connect(function()
				tween(btn, { BackgroundTransparency = 0.9 }, 0.2)
				hoverChange(-1)
			end)
			btn.MouseButton1Click:Connect(function()
				btn.BackgroundTransparency = 0.3
				tween(btn, { BackgroundTransparency = 0.76 }, 0.4)
				fire(a.Callback, handle)
				if a.Keep ~= true then dismiss(nil, "action") end
			end)
		end
	end

	-- ---------------------------------------------------------------- clic / swipe pour fermer
	clickArea.InputBegan:Connect(function(i)
		if not isPress(i) or dead then return end
		local start = Vector2.new(i.Position.X, i.Position.Y)
		local moved, dx = false, 0
		pauseTimer()
		startDrag(function(p)
			dx = p.X - start.X
			if math.abs(dx) > 6 and o.Dismissable ~= false and not center then moved = true end
			if moved and not dead then
				card.Position = UDim2.new(0, dx, 0, 0)
				if canvasSupported then card.GroupTransparency = math.clamp(math.abs(dx) / 260, 0, 0.8) end
			end
		end, nil, i.Position, function()
			if dead then return end
			if not moved then
				if o.OnClick then fire(o.OnClick, handle) end
				if o.Dismissable ~= false then dismiss(nil, "click") else resumeTimer() end
			elseif math.abs(dx) > 90 then
				dismiss(dx > 0 and 1 or -1, "swipe")
			else
				tween(card, { Position = (hov > 0) and nudge or ZERO }, 0.4, BACK)
				if canvasSupported then tween(card, { GroupTransparency = 0 }, 0.3) end
				if hov == 0 then resumeTimer() end
			end
		end)
	end)

	-- ---------------------------------------------------------------- mise à jour
	local function setProgress(p)
		progress = math.clamp(tonumber(p) or 0, 0, 1)
		if mode ~= "progress" then
			mode = "progress"
			applyMode()
		end
		tween(fill, { Size = UDim2.new(progress, 0, 1, 0) }, 0.25)
		if progress >= 1 and o.AutoComplete ~= false then
			task.delay(0.35, function()
				if dead or progress < 1 then return end
				if kind == "Loading" then
					applyKind("Success")
					playIcon()
					V6.play("Success")
				end
				shinePlay()
				mode = "timer"
				applyMode()
			end)
		end
	end

	local function update(d)
		if type(d) ~= "table" or dead then return end
		entry.stackable = false
		if d.Title ~= nil then
			titleL.Text = tostring(d.Title)
			titleL.TextTransparency = 0.7
			tween(titleL, { TextTransparency = 0 }, 0.3)
		end
		if d.Content ~= nil then
			contentL.Text = tostring(d.Content)
			contentL.Visible = contentL.Text ~= ""
			contentL.TextTransparency = 0.7
			tween(contentL, { TextTransparency = CT }, 0.3)
		end
		local typeChanged = false
		if d.Type and NOTIF_ICON[d.Type] and d.Type ~= kind then
			applyKind(d.Type)
			playIcon()
			V6.play(d.Type)
			typeChanged = true
		end
		if d.Duration ~= nil then
			local nd = tonumber(d.Duration) or dur
			if nd > 0 and nd < math.huge then
				dur = nd
				mode = "timer"
			else
				mode = "sticky"
			end
			applyMode()
		elseif typeChanged and (mode == "loading" or mode == "progress") and kind ~= "Loading" and d.Progress == nil then
			mode = "timer"
			applyMode()
		end
		if d.Progress ~= nil then setProgress(d.Progress) end
		if typeChanged or d.Title ~= nil or d.Content ~= nil then shinePlay() end
	end

	handle = {}
	handle.Update = function(...) update((unself(handle, ...))) end
	handle.SetProgress = function(...)
		local v = unself(handle, ...)
		update({ Progress = v })
	end
	handle.SetTitle = function(...) update({ Title = (unself(handle, ...)) }) end
	handle.SetContent = function(...) update({ Content = (unself(handle, ...)) }) end
	handle.SetType = function(...) update({ Type = (unself(handle, ...)) }) end
	handle.Dismiss = function() dismiss(nil, "api") end
	handle.Pause = function() pauseTimer() end
	handle.Resume = function() resumeTimer() end
	handle.IsAlive = function() return not dead end

	entry = { key = key, handle = handle, stackable = stackable, dead = false }
	entry.overflow = function() dismiss(nil, "overflow") end
	entry.hidden = false
	-- masquée (au-delà du max, derrière la pastille +N) / de nouveau visible
	entry.setHidden = function(hide)
		if dead or entry.hidden == hide then return end
		entry.hidden = hide
		if hide then
			slot.Visible = false
			if startedAt > 0 and not paused then pauseTimer() end
		else
			slot.Visible = true
			cardScale.Scale = 0.88
			if canvasSupported then card.GroupTransparency = 0.6 end
			tween(cardScale, { Scale = 1 }, 0.45, BACK)
			if canvasSupported then tween(card, { GroupTransparency = 0 }, 0.3) end
			if hov == 0 then resumeTimer() end
		end
	end
	-- bouton « Ne plus afficher » : apparaît quand la même notification se répète (stackable seulement)
	local silenceBtn
	local function addSilenceBtn()
		if silenceBtn or not stackable or Library.NotifSilenceButton == false then return end
		actRow.Visible = true
		silenceBtn = new("TextButton", { Size = UDim2.new(0, 0, 0, 26), AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, Text = "Ne plus afficher",
			TextColor3 = T.Text, TextSize = 12, Font = F_MED, AutoButtonColor = false, BorderSizePixel = 0,
			LayoutOrder = 99, ZIndex = 6 }, actRow)
		new("UICorner", { CornerRadius = UDim.new(0, 13) }, silenceBtn)
		new("UIPadding", { PaddingLeft = UDim.new(0, 13), PaddingRight = UDim.new(0, 13) }, silenceBtn)
		silenceBtn.MouseEnter:Connect(function()
			tween(silenceBtn, { BackgroundTransparency = 0.76 }, 0.15)
			hoverChange(1)
		end)
		silenceBtn.MouseLeave:Connect(function()
			tween(silenceBtn, { BackgroundTransparency = 0.9 }, 0.2)
			hoverChange(-1)
		end)
		silenceBtn.MouseButton1Click:Connect(function()
			Library:SilenceNotif(key, { Type = kind, Title = tostring(o.Title or "Notification"),
				Content = tostring(o.Content or "") })
			dismiss(nil, "silenced")
		end)
	end
	entry.bump = function()
		if dead then return end
		count += 1
		if count >= (Library.NotifSilenceAfter or 2) then addSilenceBtn() end
		badgeL.Text = "x" .. count
		badge.Visible = true
		badgeScale.Scale = 1.6
		tween(badgeScale, { Scale = 1 }, 0.45, BACK)
		card.Position = UDim2.new(0, inward * 10, 0, 0)
		tween(card, { Position = (hov > 0) and nudge or ZERO }, 0.45, BACK)
		shinePlay()
		if mode == "timer" then
			remaining = dur
			if paused then fill.Size = UDim2.new(1, 0, 1, 0) else runTimer() end
		end
	end

	applyKind(kind)
	buildActions(o.Actions)
	notifEntries[#notifEntries + 1] = entry
	activeNotifs[#activeNotifs + 1] = entry.overflow
	if Library.NotifOverflow == "Pill" then
		V6.refresh()
	else
		while #activeNotifs > math.max(tonumber(Library.NotifMax) or 5, 1) do activeNotifs[1]() end
	end

	-- ---------------------------------------------------------------- animation d'entrée
	task.spawn(function()
		RunService.Heartbeat:Wait()
		if dead then return end
		local h = card.AbsoluteSize.Y / math.max(cardScale.Scale, 0.01)
		if h < 4 then
			RunService.Heartbeat:Wait()
			h = card.AbsoluteSize.Y / math.max(cardScale.Scale, 0.01)
		end
		local estyle = Library.Animations and V6.resolveEntry(o.Entry, kind) or nil
		local grow = tween(slot, { Size = UDim2.new(1, 0, 0, h) }, 0.38)
		grow.Completed:Connect(function()
			if not dead and not estyle then
				slot.AutomaticSize = AY
				slot.Size = UDim2.new(1, 0, 0, 0)
			end
		end)
		if estyle then
			-- style d'entrée (V10) : la carte est dessinée par l'animation, le texte est donc visible tout de suite
			local cw = card.AbsoluteSize.X / math.max(cardScale.Scale, 0.01)
			if cw < 10 then cw = width end
			titleL.TextTransparency = 0
			contentL.TextTransparency = CT
			icoScale.Scale = 1
			local dur, cleanup = V6.enter(estyle, slot, card, cardScale, h, cw)
			entryCleanup = function()
				entryCleanup = nil
				pcall(cleanup)
				settleCard()
			end
			task.delay(dur / math.max(Library.AnimSpeed or 1, 0.05), function()
				if dead or not entryCleanup then return end
				entryCleanup()
				pulse.Size = UDim2.fromOffset(28, 28)
				pulseSt.Transparency = 0.15
				tween(pulse, { Size = UDim2.fromOffset(62, 62) }, 0.75)
				tween(pulseSt, { Transparency = 1 }, 0.75)
				shinePlay()
				applyMode()
			end)
			return
		end
		tween(card, { Position = ZERO }, 0.6)
		tween(cardScale, { Scale = 1 }, 0.55, BACK)
		if canvasSupported then tween(card, { GroupTransparency = 0 }, 0.35) end
		if strip.Visible then tween(strip, { Size = UDim2.new(0, 3, 1, 0) }, 0.55) end
		task.delay(0.12, function() if not dead then playIcon() end end)
		task.delay(0.15, function() if not dead then tween(titleL, { TextTransparency = 0 }, 0.3) end end)
		task.delay(0.25, function() if not dead then tween(contentL, { TextTransparency = CT }, 0.3) end end)
		task.delay(0.2, function() if not dead then shinePlay() end end)
		task.delay(0.3, function() if not dead then applyMode() end end)
	end)

	return handle
end

-- « Ne plus afficher » : Library:SilenceNotif(clé, { Type, Title, Content }) / UnsilenceNotif(clé) / UnsilenceAllNotifs()
-- Library.NotifSilenceButton = false : pas de bouton · Library.NotifSilenceAfter = nombre de répétitions avant le bouton (2)
-- La liste est enregistrée avec les réglages (flag « ui.silenced ») et gérée dans Paramètres > Notifications masquées.
Library.NotifSilenceButton = true
Library.NotifSilenceAfter  = 2
local function silencedFlag()
	local out = {}
	for k, v in pairs(Library.NotifSilenced) do
		out[#out + 1] = { Key = k, Type = v.Type, Title = v.Title, Content = v.Content }
	end
	table.sort(out, function(a, b) return a.Key < b.Key end)
	Library.Flags["ui.silenced"] = out
	if Library._onSilencedChanged then pcall(Library._onSilencedChanged) end
end
function Library:SilenceNotif(key, info)
	if type(key) ~= "string" then return end
	Library.NotifSilenced[key] = info or {}
	silencedFlag()
end
function Library:UnsilenceNotif(key)
	Library.NotifSilenced[key] = nil
	silencedFlag()
end
function Library:UnsilenceAllNotifs()
	table.clear(Library.NotifSilenced)
	silencedFlag()
end
Library._registerSilenced = function()
	Library.Flags["ui.silenced"] = {}
	Library.Items["ui.silenced"] = {
		Get = function() return Library.Flags["ui.silenced"] end,
		Set = function(_, list)
			table.clear(Library.NotifSilenced)
			if type(list) == "table" then
				for _, e in ipairs(list) do
					if type(e) == "table" and type(e.Key) == "string" then
						Library.NotifSilenced[e.Key] = { Type = e.Type, Title = e.Title, Content = e.Content }
					end
				end
			end
			silencedFlag()
		end,
	}
	Library.Defaults["ui.silenced"] = {}
	silencedFlag()
end

-- Raccourcis : Library:NotifySuccess("Titre", "Contenu", 5)
for _, k in ipairs({ "Info", "Success", "Warning", "Error" }) do
	Library["Notify" .. k] = function(_, title, content, duration, extra)
		local o = {}
		if type(extra) == "table" then
			for a, b in pairs(extra) do o[a] = b end
		end
		o.Title, o.Content, o.Duration, o.Type = title, content, duration, k
		return Library:Notify(o)
	end
end

-- Library:NotifyProgress({ Title = "Téléchargement", Content = "..." })  ->  handle:SetProgress(0.4)
function Library:NotifyProgress(o)
	o = o or {}
	o.Progress = tonumber(o.Progress) or 0
	return Library:Notify(o)
end

-- ============================================================================
-- CONSOLE INTÉGRÉE : affiche les print / warn (et erreurs) dans un onglet
--   Window:CreateConsoleTab("Console")  ->  onglet avec filtre (Tout / Print / Warn / Erreurs), pause, défilement
--   auto, vider, copier. Tout ce que le client Roblox écrit dans la sortie est capté via LogService (donc aussi les
--   print / warn de ton script), dès le chargement de la lib.
--   Library:ConsoleLog("texte", "Print" | "Warn" | "Error" | "Info")   écrire à la main dans la console
--   Library.Console.Lines (historique, 500 max) · Library:ClearConsole() · Library:GetConsoleText()
-- ============================================================================
do
	local LogService = game:GetService("LogService")
	local C = { Lines = {}, Max = 500, Paused = false, Filter = "Tout", AutoScroll = true, Listeners = {} }
	Library.Console = C
	local MT = Enum.MessageType

	local function push(text, kind, when)
		local e = { Time = when or os.time(), Text = tostring(text), Kind = kind }
		C.Lines[#C.Lines + 1] = e
		while #C.Lines > C.Max do table.remove(C.Lines, 1) end
		for k, fn in pairs(C.Listeners) do
			local ok = pcall(fn, e)
			if not ok then C.Listeners[k] = nil end
		end
	end
	local function kindOf(mt)
		if mt == MT.MessageWarning then return "Warn" end
		if mt == MT.MessageError then return "Error" end
		if mt == MT.MessageInfo then return "Info" end
		return "Print"
	end

	-- historique déjà écrit avant le chargement (100 dernières lignes)
	pcall(function()
		local h = LogService:GetLogHistory()
		for i = math.max(1, #h - 99), #h do
			local m = h[i]
			push(m.message, kindOf(m.messageType), m.timestamp)
		end
	end)
	pcall(function()
		track(LogService.MessageOut:Connect(function(msg, mt)
			if not C.Capture and C.Capture ~= nil then return end
			push(msg, kindOf(mt))
		end))
	end)

	function Library:ConsoleLog(text, kind)
		if kind ~= "Warn" and kind ~= "Error" and kind ~= "Info" then kind = "Print" end
		push(text, kind)
	end
	function Library:ClearConsole()
		table.clear(C.Lines)
		for _, fn in pairs(C.Listeners) do pcall(fn, nil) end
	end
	function Library:GetConsoleText()
		local out = {}
		for _, e in ipairs(C.Lines) do
			out[#out + 1] = os.date("%H:%M:%S", e.Time) .. " [" .. e.Kind .. "] " .. e.Text
		end
		return table.concat(out, "\n")
	end

	local function matches(e)
		local f = C.Filter
		if f == "Print" then return e.Kind == "Print" or e.Kind == "Info" end
		if f == "Warn" then return e.Kind == "Warn" end
		if f == "Erreurs" then return e.Kind == "Error" end
		return true
	end
	local function colorOf(kind)
		if kind == "Warn" then return Library.NotifColors.Warning end
		if kind == "Error" then return Library.NotifColors.Error end
		if kind == "Info" then return T.ElementAccent end
		return T.Text
	end

	function Window:CreateConsoleTab(name, icon)
		local tab = self:CreateTab(name or "Console", nil, icon)
		local blk = tab:CreateBlock({ Name = "Console", Side = "Left" })
		blk._noFav = true
		local FILTERS = { "Tout", "Print", "Warn", "Erreurs" }
		local VIEW_MAX = 300

		blk:CreateDropdown({ Name = "Filtre", Items = FILTERS, Default = C.Filter, Search = false, Favorite = false,
			Palette = false, Callback = function(v)
				C.Filter = v
				if tab._consoleRebuild then tab._consoleRebuild() end
			end })
		blk:CreateToggle({ Name = "Pause", Default = C.Paused, Favorite = false, Palette = false, HUD = false,
			Tooltip = "Fige l'affichage (les lignes continuent d'être enregistrées).",
			Callback = function(v)
				C.Paused = v
				if not v and tab._consoleRebuild then tab._consoleRebuild() end
			end })
		blk:CreateToggle({ Name = "Défilement automatique", Default = C.AutoScroll, Favorite = false, Palette = false,
			HUD = false, Callback = function(v) C.AutoScroll = v end })

		-- zone de texte
		local host = new("Frame", { Size = UDim2.new(1, 0, 0, 300), BackgroundColor3 = T.Panel,
			BackgroundTransparency = 0.1, BorderSizePixel = 0, ClipsDescendants = true }, blk.Body)
		corner(host, 8)
		trackStyled(host, stroke(host, 0.9), "panel")
		blk:_reg(host, "console journal print warn")
		local view = new("ScrollingFrame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.Accent, ScrollBarImageTransparency = 0.5,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = AY }, host)
		new("UIListLayout", { Padding = UDim.new(0, 1), SortOrder = BYORDER }, view)
		new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8) }, view)
		local rows, seq = {}, 0

		local function addRow(e)
			seq += 1
			local l = new("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
				Text = os.date("%H:%M:%S", e.Time) .. "  " .. e.Text, TextColor3 = colorOf(e.Kind), TextSize = 11,
				Font = Enum.Font.Code, TextWrapped = true, TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top,
				TextTruncate = Enum.TextTruncate.None, LayoutOrder = seq }, view)
			l:SetAttribute("FontRole", nil)   -- police à chasse fixe : on ne la touche pas
			l:SetAttribute("NoAccent", true)
			rows[#rows + 1] = l
			while #rows > VIEW_MAX do table.remove(rows, 1):Destroy() end
		end
		local function toBottom()
			task.defer(function()
				if view.Parent and C.AutoScroll then
					view.CanvasPosition = Vector2.new(0, math.max(view.AbsoluteCanvasSize.Y, 0))
				end
			end)
		end
		local function rebuild()
			for _, r in ipairs(rows) do r:Destroy() end
			table.clear(rows)
			local shown = {}
			for _, e in ipairs(C.Lines) do
				if matches(e) then shown[#shown + 1] = e end
			end
			for i = math.max(1, #shown - VIEW_MAX + 1), #shown do addRow(shown[i]) end
			toBottom()
		end
		tab._consoleRebuild = rebuild

		C.Listeners[tab] = function(e)
			if not view.Parent then error("gone") end   -- onglet détruit : le listener se retire tout seul
			if e == nil then
				rebuild()
			elseif not C.Paused and matches(e) then
				addRow(e)
				toBottom()
			end
		end

		blk:CreateButton({ Name = "Vider la console", Favorite = false, Palette = false,
			Callback = function() Library:ClearConsole() end })
		blk:CreateButton({ Name = "Copier tout", Favorite = false, Palette = false, Callback = function()
			local ok = Library:CopyText(Library:GetConsoleText())
			Library:Notify({ Title = "Console", Type = ok and "Success" or "Warning", Duration = 3,
				Content = ok and "Contenu copié dans le presse-papiers." or "Presse-papiers indisponible." })
		end })
		blk:CreateButton({ Name = "Tester (print + warn)", Favorite = false, Palette = false, Callback = function()
			print("[Console] Ceci est un print de test.")
			warn("[Console] Ceci est un warn de test.")
		end })

		tab.OnSelect = rebuild
		rebuild()
		return tab
	end
end

-- Onglet « Historique » : les 50 dernières notifications
function Window:CreateNotifLogTab(name, icon)
	local tab = self:CreateTab(name or "Historique", nil, icon)
	local function rebuild()
		tab:ClearBlocks()
		local blk = tab:CreateBlock({ Name = "Notifications récentes", Side = "Left" })
		blk._noFav = true
		blk:CreateButton({ Name = "Vider l'historique", Favorite = false, Callback = function()
			Library:ClearNotifHistory()
			rebuild()
		end })
		local h = Library.NotifHistory
		if #h == 0 then
			blk:CreateParagraph({ Title = "Aucune notification", Content = "Elles apparaîtront ici au fur et à mesure." })
			return
		end
		for i = #h, 1, -1 do
			local e = h[i]
			blk:CreateParagraph({
				Title = os.date("%H:%M:%S", e.Time) .. "  ·  " .. e.Title,
				Content = (e.Content ~= "") and e.Content or "(sans texte)",
			})
		end
	end
	tab.OnSelect = rebuild
	rebuild()
	return tab
end



