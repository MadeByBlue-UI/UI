    -- ── Search ───────────────────────────────────────────────────────────
    function window:ApplySearch(text)
        text = string.lower(Library:Trim(text or ""))
        self.Search = text
        Library.Searching = text ~= ""

        for _, tab in ipairs(self.Tabs) do
            if tab.Groupboxes then
                local active = tab == self.ActiveTab
                local matched = {}
                for _, entry in ipairs(tab.SearchEntries or {}) do
                    local element = entry.Element
                    local isMatch = text == "" or string.find(entry.Text, text, 1, true) ~= nil
                    if not active and text ~= "" then
                        isMatch = true
                    end
                    if element.SetSearchVisible then
                        element:SetSearchVisible(isMatch)
                    end
                    if isMatch and entry.Owner and entry.Owner.Groupbox then
                        matched[entry.Owner.Groupbox] = true
                    end
                end
                for _, groupbox in ipairs(tab.Groupboxes) do
                    local visible = text == "" or not active or matched[groupbox] == true
                    groupbox:SetSearchVisible(visible)
                end
            end
        end
    end

    -- ── Tabs ─────────────────────────────────────────────────────────────
    function window:CreateTabBase(name, icon, description)
        local tab = {
            Type = "Tab",
            Name = name,
            Window = self,
            Groupboxes = {},
            SearchEntries = {},
            Hidden = false,
        }

        local button = Library:Create("TextButton", {
            Name = "Tab_" .. name,
            Size = UDim2.new(1, 0, 0, description and 44 or 34),
            Text = "",
            LayoutOrder = #self.Tabs + 1,
            BackgroundTransparency = 1,
            ZIndex = 10,
            ["@BackgroundColor3"] = "AccentColor",
            Parent = tabList,
        })
        Library:AddThemedCorner(button, 1)

        local bar = Library:Create("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(3, 18),
            BackgroundTransparency = 1,
            ZIndex = 12,
            ["@BackgroundColor3"] = "AccentColor",
            Parent = button,
        })
        Library:AddCorner(bar, 9999)

        local textOffset = 12
        local iconInstance
        if icon then
            iconInstance = Library:CreateIcon(button, icon, 16, 12)
            if iconInstance then
                iconInstance.AnchorPoint = Vector2.new(0, 0.5)
                iconInstance.Position = UDim2.new(0, 12, 0.5, 0)
                textOffset = 36
            end
        end

        local label = Library:Create("TextLabel", {
            Position = UDim2.fromOffset(textOffset, description and 5 or 0),
            Size = UDim2.new(1, -textOffset - 6, 0, description and 18 or 34),
            Text = name,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 12,
            ["@TextColor3"] = "MutedColor",
            Parent = button,
        })

        if description then
            Library:Create("TextLabel", {
                Position = UDim2.fromOffset(textOffset, 22),
                Size = UDim2.new(1, -textOffset - 6, 0, 16),
                Text = description,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextSize = Library.TextSize - 3,
                ZIndex = 12,
                ["@TextColor3"] = "OutlineColor",
                Parent = button,
            })
        end

        local page = Library:Create("Frame", {
            Name = "Page_" .. name,
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Visible = false,
            ZIndex = 5,
            Parent = content,
        })

        tab.Button = button
        tab.Bar = bar
        tab.Label = label
        tab.Icon = iconInstance
        tab.Page = page

        function tab:Show()
            self.Window:SelectTab(self)
        end

        function tab:SetVisible(visible)
            self.Hidden = not visible
            button.Visible = visible
        end

        function tab:Refresh(instant)
            local active = self.Window.ActiveTab == self
            local info = instant and TweenInfo.new(0) or Library.FastTweenInfo
            Library:Tween(button, { BackgroundTransparency = active and 0.88 or 1 }, info)
            Library:Tween(bar, { BackgroundTransparency = active and 0 or 1 }, info)
            Library:Tween(label, {
                TextColor3 = active and Library.Theme.FontColor or Library.Theme.MutedColor,
            }, info)
        end

        button.MouseEnter:Connect(function()
            if window.ActiveTab ~= tab then
                Library:Tween(button, { BackgroundTransparency = 0.94 }, Library.FastTweenInfo)
            end
        end)
        button.MouseLeave:Connect(function()
            if window.ActiveTab ~= tab then
                Library:Tween(button, { BackgroundTransparency = 1 }, Library.FastTweenInfo)
            end
        end)
        button.MouseButton1Click:Connect(function()
            window:SelectTab(tab)
        end)

        table.insert(self.Tabs, tab)
        table.insert(Library.Tabs, tab)
        if #self.Tabs == 1 then
            self:SelectTab(tab)
        end
        return tab
    end

    function window:SelectTab(tab)
        if self.ActiveTab == tab then
            return
        end
        Library:CloseAllPopups()
        local previous = self.ActiveTab
        self.ActiveTab = tab
        Library.ActiveTab = tab
        for _, other in ipairs(self.Tabs) do
            other.Page.Visible = other == tab
            other:Refresh()
        end
        if previous and previous.Page then
            previous.Page.Visible = false
        end
        if self.Search ~= "" then
            self:ApplySearch(self.Search)
        end
    end

    function window:AddTab(name, icon, description)
        local tab = self:CreateTabBase(name, icon, description)

        local function column(side)
            local scroller = Library:Create("ScrollingFrame", {
                Name = side .. "Column",
                Position = side == "Left" and UDim2.fromOffset(0, 0) or UDim2.new(0.5, 0, 0, 0),
                Size = UDim2.new(0.5, 0, 1, 0),
                ScrollBarThickness = 2,
                ScrollBarImageColor3 = Library.Theme.AccentColor,
                ZIndex = 6,
                Parent = tab.Page,
            })
            Library:AddPadding(scroller, 10, side == "Left" and 5 or 10, 10, side == "Left" and 10 or 5)
            Library:AddList(scroller, 8)
            return scroller
        end

        tab.LeftColumn = column("Left")
        tab.RightColumn = column("Right")

        function tab:AddLeftGroupbox(groupName, groupIcon)
            return CreateGroupbox(self, self.LeftColumn, groupName, groupIcon)
        end

        function tab:AddRightGroupbox(groupName, groupIcon)
            return CreateGroupbox(self, self.RightColumn, groupName, groupIcon)
        end

        function tab:AddLeftTabbox(tabboxName)
            return CreateTabbox(self, self.LeftColumn, tabboxName)
        end

        function tab:AddRightTabbox(tabboxName)
            return CreateTabbox(self, self.RightColumn, tabboxName)
        end

        -- Obsidian-style aliases
        tab.AddGroupbox = function(self, groupInfo)
            local side = groupInfo.Side
            if side == 2 or side == "Right" then
                return self:AddRightGroupbox(groupInfo.Name, groupInfo.IconName)
            end
            return self:AddLeftGroupbox(groupInfo.Name, groupInfo.IconName)
        end

        return tab
    end

    -- ── Key system tab ───────────────────────────────────────────────────
    --- info:
    ---   Title, Description, Placeholder, KeyLink, Keys (array) | Validate (fn)
    ---   Callback(key), LockTabs (bool, hide other tabs until the key is valid),
    ---   Note (extra line under the input)
    function window:AddKeyTab(name, keyInfo)
        keyInfo = keyInfo or {}
        local tab = self:CreateTabBase(name or "Key System", "key")
        tab.Type = "KeyTab"
        tab.Valid = false
        tab.Success = Signal.new()

        local card = Library:Create("Frame", {
            Name = "KeyCard",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(0.8, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 0.1,
            ZIndex = 6,
            ["@BackgroundColor3"] = "MainColor",
            Parent = tab.Page,
        })
        Library:AddThemedCorner(card, 1.4)
        Library:AddStroke(card, "AccentColor", 1, 0.5)
        Library:AddPadding(card, 16, 18, 16, 18)
        Library:AddList(card, 10, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Center)
        Library:Create("UISizeConstraint", { MaxSize = Vector2.new(420, 600), Parent = card })

        local icon = Library:CreateSingularityIcon(card, 54, { ZIndex = 7 })
        icon.LayoutOrder = 1

        Library:Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 22),
            Text = keyInfo.Title or "Key System",
            TextSize = Library.TextSize + 4,
            ZIndex = 7,
            LayoutOrder = 2,
            ["@TextColor3"] = "FontColor",
            Parent = card,
        })

        Library:Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Text = keyInfo.Description or "Enter your key to unlock the interface.",
            TextWrapped = true,
            ZIndex = 7,
            LayoutOrder = 3,
            ["@TextColor3"] = "MutedColor",
            Parent = card,
        })

        local _, keyBox = Library:CreateTextBox(card, {
            Size = UDim2.new(1, 0, 0, 30),
            Placeholder = keyInfo.Placeholder or "Paste key here",
            LayoutOrder = 4,
            ZIndex = 7,
            Alignment = Enum.TextXAlignment.Center,
        })
        tab.KeyBox = keyBox

        local status = Library:Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16),
            Text = keyInfo.Note or "",
            TextSize = Library.TextSize - 1,
            ZIndex = 7,
            LayoutOrder = 5,
            ["@TextColor3"] = "MutedColor",
            Parent = card,
        })
        tab.Status = status

        local buttons = Library:Create("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 30),
            ZIndex = 7,
            LayoutOrder = 6,
            Parent = card,
        })
        Library:AddList(buttons, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center)

        local function makeButton(text, primary, callback)
            local button = Library:Create("TextButton", {
                Size = UDim2.new(0.5, -4, 1, 0),
                Text = text,
                ZIndex = 8,
                ["@BackgroundColor3"] = primary and "AccentColor" or "BackgroundColor",
                ["@TextColor3"] = primary and function(theme)
                    local _, _, v = theme.AccentColor:ToHSV()
                    return v > 0.7 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
                end or "FontColor",
                Parent = buttons,
            })
            Library:AddThemedCorner(button, 0.8)
            if not primary then
                Library:AddStroke(button, "OutlineColor", 1)
            end
            button.MouseButton1Click:Connect(callback)
            return button
        end

        local function lockTabs(locked)
            if not keyInfo.LockTabs then
                return
            end
            for _, other in ipairs(window.Tabs) do
                if other ~= tab then
                    other.Button.Visible = not locked and not other.Hidden
                end
            end
        end

        local function check()
            local key = Library:Trim(keyBox.Text)
            local valid = false
            if keyInfo.Validate then
                local ok, result = pcall(keyInfo.Validate, key)
                valid = ok and result == true
            elseif keyInfo.Keys then
                for _, candidate in ipairs(keyInfo.Keys) do
                    if candidate == key then
                        valid = true
                        break
                    end
                end
            else
                valid = key ~= ""
            end

            if valid then
                tab.Valid = true
                window.KeyValid = true
                status.Text = "Key accepted"
                status.TextColor3 = Library.Theme.GreenColor
                Library:Notify({ Title = "Key system", Description = "Key accepted.", Type = "Success", Time = 3 })
                lockTabs(false)
                Library:SafeCallback(keyInfo.Callback, key)
                tab.Success:Fire(key)
            else
                tab.Valid = false
                status.Text = "Invalid key"
                status.TextColor3 = Library.Theme.RedColor
                Library:Notify({ Title = "Key system", Description = "That key is not valid.", Type = "Error", Time = 3 })
            end
            return valid
        end

        makeButton("Check key", true, check)
        makeButton("Get key", false, function()
            if keyInfo.KeyLink and Library:CopyToClipboard(keyInfo.KeyLink) then
                status.Text = "Link copied to clipboard"
                status.TextColor3 = Library.Theme.AccentColor
            else
                status.Text = keyInfo.KeyLink or "No key link configured"
                status.TextColor3 = Library.Theme.MutedColor
            end
        end)

        keyBox.FocusLost:Connect(function(enter)
            if enter then
                check()
            end
        end)

        function tab:Check()
            return check()
        end

        function tab:OnSuccess(fn)
            return self.Success:Connect(fn)
        end

        if keyInfo.LockTabs then
            window.KeyValid = false
            task.defer(function()
                lockTabs(true)
                window:SelectTab(tab)
            end)
        end

        return tab
    end

    table.insert(self.Windows, window)
    self.CurrentWindow = window
    if info.Footer then
        footerLabel.Text = info.Footer
    end
    return window
end

--- Show the toggle button on desktop as well.
function Library:ForceToggleButton(state)
    self.ShowToggleButton = state
    if self.ToggleButton then
        self.ToggleButton.Visible = state
    end
end

