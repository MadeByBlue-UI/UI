		local txt = string.gsub(hex.Text, "#", "")
		local ok, c = pcall(Color3.fromHex, txt)
		if ok and typeof(c) == "Color3" then item.Set(c) end
		hex.Text = "#" .. string.upper(col:ToHex())
	end)

	commit(true)
	register(o.Flag, item, { R = col.R, G = col.G, B = col.B })
	if Library.FireDefaults then fire(o.Callback, col) end
	return item
end

