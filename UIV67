-- ============================================================================
-- CONSOLE INTÉGRÉE : affiche les print / warn (et erreurs) dans un onglet
--   Window:CreateConsoleTab("Console")  ->  onglet avec filtre (Tout / Print / Warn / Erreurs), pause, défilement
--   auto, vider, copier. Tout ce que le client Roblox écrit dans la sortie est capté via LogService (donc aussi les
--   print / warn de ton script), dès le chargement de la lib.
--   Library:ConsoleLog("texte", "Print" | "Warn" | "Error" | "Info")   écrire à la main dans la console
--   Library.Console.Lines (historique, 500 max) · Library:ClearConsole() · Library:GetConsoleText()
-- ============================================================================
do
	local LogService = game:GetService("LogService")
	local C = { Lines = {}, Max = 500, Paused = false, Filter = "Tout", AutoScroll = true, Listeners = {} }
	Library.Console = C
	local MT = Enum.MessageType

	local function push(text, kind, when)
		local e = { Time = when or os.time(), Text = tostring(text), Kind = kind }
		C.Lines[#C.Lines + 1] = e
		while #C.Lines > C.Max do table.remove(C.Lines, 1) end
		for k, fn in pairs(C.Listeners) do
			local ok = pcall(fn, e)
			if not ok then C.Listeners[k] = nil end
		end
	end
	local function kindOf(mt)
		if mt == MT.MessageWarning then return "Warn" end
		if mt == MT.MessageError then return "Error" end
		if mt == MT.MessageInfo then return "Info" end
		return "Print"
	end

	-- historique déjà écrit avant le chargement (100 dernières lignes)
	pcall(function()
		local h = LogService:GetLogHistory()
		for i = math.max(1, #h - 99), #h do
			local m = h[i]
			push(m.message, kindOf(m.messageType), m.timestamp)
		end
	end)
	pcall(function()
		track(LogService.MessageOut:Connect(function(msg, mt)
			if not C.Capture and C.Capture ~= nil then return end
			push(msg, kindOf(mt))
		end))
	end)

	function Library:ConsoleLog(text, kind)
		if kind ~= "Warn" and kind ~= "Error" and kind ~= "Info" then kind = "Print" end
		push(text, kind)
	end
	function Library:ClearConsole()
		table.clear(C.Lines)
		for _, fn in pairs(C.Listeners) do pcall(fn, nil) end
	end
	function Library:GetConsoleText()
		local out = {}
		for _, e in ipairs(C.Lines) do
			out[#out + 1] = os.date("%H:%M:%S", e.Time) .. " [" .. e.Kind .. "] " .. e.Text
		end
		return table.concat(out, "\n")
	end

	local function matches(e)
		local f = C.Filter
		if f == "Print" then return e.Kind == "Print" or e.Kind == "Info" end
		if f == "Warn" then return e.Kind == "Warn" end
		if f == "Erreurs" then return e.Kind == "Error" end
		return true
	end
	local function colorOf(kind)
		if kind == "Warn" then return Library.NotifColors.Warning end
		if kind == "Error" then return Library.NotifColors.Error end
		if kind == "Info" then return T.ElementAccent end
		return T.Text
	end

	function Window:CreateConsoleTab(name, icon)
		local tab = self:CreateTab(name or "Console", nil, icon)
		local blk = tab:CreateBlock({ Name = "Console", Side = "Left" })
		blk._noFav = true
		local FILTERS = { "Tout", "Print", "Warn", "Erreurs" }
		local VIEW_MAX = 300

		blk:CreateDropdown({ Name = "Filtre", Items = FILTERS, Default = C.Filter, Search = false, Favorite = false,
			Palette = false, Callback = function(v)
				C.Filter = v
				if tab._consoleRebuild then tab._consoleRebuild() end
			end })
		blk:CreateToggle({ Name = "Pause", Default = C.Paused, Favorite = false, Palette = false, HUD = false,
			Tooltip = "Fige l'affichage (les lignes continuent d'être enregistrées).",
			Callback = function(v)
				C.Paused = v
				if not v and tab._consoleRebuild then tab._consoleRebuild() end
			end })
		blk:CreateToggle({ Name = "Défilement automatique", Default = C.AutoScroll, Favorite = false, Palette = false,
			HUD = false, Callback = function(v) C.AutoScroll = v end })

		-- zone de texte
		local host = new("Frame", { Size = UDim2.new(1, 0, 0, 300), BackgroundColor3 = T.Panel,
			BackgroundTransparency = 0.1, BorderSizePixel = 0, ClipsDescendants = true }, blk.Body)
		corner(host, 8)
		trackStyled(host, stroke(host, 0.9), "panel")
		blk:_reg(host, "console journal print warn")
		local view = new("ScrollingFrame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.Accent, ScrollBarImageTransparency = 0.5,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = AY }, host)
		new("UIListLayout", { Padding = UDim.new(0, 1), SortOrder = BYORDER }, view)
		new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8) }, view)
		local rows, seq = {}, 0

		local function addRow(e)
			seq += 1
			local l = new("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
				Text = os.date("%H:%M:%S", e.Time) .. "  " .. e.Text, TextColor3 = colorOf(e.Kind), TextSize = 11,
				Font = Enum.Font.Code, TextWrapped = true, TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top,
				TextTruncate = Enum.TextTruncate.None, LayoutOrder = seq }, view)
			l:SetAttribute("FontRole", nil)   -- police à chasse fixe : on ne la touche pas
			l:SetAttribute("NoAccent", true)
			rows[#rows + 1] = l
			while #rows > VIEW_MAX do table.remove(rows, 1):Destroy() end
		end
		local function toBottom()
			task.defer(function()
				if view.Parent and C.AutoScroll then
					view.CanvasPosition = Vector2.new(0, math.max(view.AbsoluteCanvasSize.Y, 0))
				end
			end)
		end
		local function rebuild()
			for _, r in ipairs(rows) do r:Destroy() end
			table.clear(rows)
			local shown = {}
			for _, e in ipairs(C.Lines) do
				if matches(e) then shown[#shown + 1] = e end
			end
			for i = math.max(1, #shown - VIEW_MAX + 1), #shown do addRow(shown[i]) end
			toBottom()
		end
		tab._consoleRebuild = rebuild

		C.Listeners[tab] = function(e)
			if not view.Parent then error("gone") end   -- onglet détruit : le listener se retire tout seul
			if e == nil then
				rebuild()
			elseif not C.Paused and matches(e) then
				addRow(e)
				toBottom()
			end
		end

		blk:CreateButton({ Name = "Vider la console", Favorite = false, Palette = false,
			Callback = function() Library:ClearConsole() end })
		blk:CreateButton({ Name = "Copier tout", Favorite = false, Palette = false, Callback = function()
			local ok = Library:CopyText(Library:GetConsoleText())
			Library:Notify({ Title = "Console", Type = ok and "Success" or "Warning", Duration = 3,
				Content = ok and "Contenu copié dans le presse-papiers." or "Presse-papiers indisponible." })
		end })
		blk:CreateButton({ Name = "Tester (print + warn)", Favorite = false, Palette = false, Callback = function()
			print("[Console] Ceci est un print de test.")
			warn("[Console] Ceci est un warn de test.")
		end })

		tab.OnSelect = rebuild
		rebuild()
		return tab
	end
end

-- Onglet « Historique » : les 50 dernières notifications
function Window:CreateNotifLogTab(name, icon)
	local tab = self:CreateTab(name or "Historique", nil, icon)
	local function rebuild()
		tab:ClearBlocks()
		local blk = tab:CreateBlock({ Name = "Notifications récentes", Side = "Left" })
		blk._noFav = true
		blk:CreateButton({ Name = "Vider l'historique", Favorite = false, Callback = function()
			Library:ClearNotifHistory()
			rebuild()
		end })
		local h = Library.NotifHistory
		if #h == 0 then
			blk:CreateParagraph({ Title = "Aucune notification", Content = "Elles apparaîtront ici au fur et à mesure." })
			return
		end
		for i = #h, 1, -1 do
			local e = h[i]
			blk:CreateParagraph({
				Title = os.date("%H:%M:%S", e.Time) .. "  ·  " .. e.Title,
				Content = (e.Content ~= "") and e.Content or "(sans texte)",
			})
		end
	end
	tab.OnSelect = rebuild
	rebuild()
	return tab
end



