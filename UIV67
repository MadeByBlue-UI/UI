local SaveManager = {
    Folder = "SingularitySettings",
    SubFolder = "",
    Library = Library,
    Ignore = {},
}

SaveManager.Parser = {
    Toggle = {
        Save = function(idx, object)
            return { type = "Toggle", idx = idx, value = object.Value }
        end,
        Load = function(idx, data)
            local object = Library.Toggles[idx]
            if object then
                object:SetValue(data.value)
            end
        end,
    },
    Slider = {
        Save = function(idx, object)
            return { type = "Slider", idx = idx, value = object.Value }
        end,
        Load = function(idx, data)
            local object = Library.Options[idx]
            if object then
                object:SetValue(data.value)
            end
        end,
    },
    Input = {
        Save = function(idx, object)
            return { type = "Input", idx = idx, value = object.Value }
        end,
        Load = function(idx, data)
            local object = Library.Options[idx]
            if object and type(data.value) == "string" then
                object:SetValue(data.value)
            end
        end,
    },
    Dropdown = {
        Save = function(idx, object)
            return { type = "Dropdown", idx = idx, value = object.Value, multi = object.Multi }
        end,
        Load = function(idx, data)
            local object = Library.Options[idx]
            if object then
                object:SetValue(data.value)
            end
        end,
    },
    ColorPicker = {
        Save = function(idx, object)
            return {
                type = "ColorPicker",
                idx = idx,
                value = Library:ColorToHex(object.Value),
                transparency = object.Transparency,
                rainbow = object.Rainbow,
            }
        end,
        Load = function(idx, data)
            local object = Library.Options[idx]
            local color = Library:HexToColor(data.value)
            if object and color then
                object:SetValueRGB(color, data.transparency)
                object:SetRainbow(data.rainbow == true)
            end
        end,
    },
    KeyPicker = {
        Save = function(idx, object)
            return { type = "KeyPicker", idx = idx, key = object.Value, mode = object.Mode }
        end,
        Load = function(idx, data)
            local object = Library.Options[idx]
            if object then
                object:SetValue({ data.key, data.mode })
            end
        end,
    },
}

function SaveManager:SetLibrary(library)
    self.Library = library
end

function SaveManager:SetIgnoreIndexes(list)
    for _, key in ipairs(list) do
        self.Ignore[key] = true
    end
end

function SaveManager:IgnoreThemeSettings()
    self:SetIgnoreIndexes({ "MenuKeybind" })
    self.IgnoreTheme = true
end

function SaveManager:IsIgnored(idx)
    if self.Ignore[idx] then
        return true
    end
    if self.IgnoreTheme and type(idx) == "string" and idx:sub(1, 13) == "ThemeManager_" then
        return true
    end
    if type(idx) == "string" and idx:sub(1, 12) == "SaveManager_" then
        return true
    end
    return false
end

function SaveManager:SetFolder(folder)
    self.Folder = folder
    self:BuildFolderTree()
end

function SaveManager:SetSubFolder(folder)
    self.SubFolder = folder
    self:BuildFolderTree()
end

function SaveManager:ConfigPath()
    local path = self.Folder .. "/settings"
    if self.SubFolder ~= "" then
        path = path .. "/" .. self.SubFolder
    end
    return path
end

function SaveManager:BuildFolderTree()
    if not FileSystemAvailable() then
        return
    end
    local paths = { self.Folder, self.Folder .. "/settings" }
    if self.SubFolder ~= "" then
        table.insert(paths, self.Folder .. "/settings/" .. self.SubFolder)
    end
    for _, path in ipairs(paths) do
        pcall(function()
            if not FS.isfolder(path) then
                FS.makefolder(path)
            end
        end)
    end
end

function SaveManager:Save(name)
    if not FileSystemAvailable() then
        return false, "file system is not available"
    end
    name = Library:Trim(name or "")
    if name == "" then
        return false, "config name is empty"
    end

    local data = { objects = {} }
    for idx, toggle in pairs(Library.Toggles) do
        if not self:IsIgnored(idx) and self.Parser.Toggle then
            table.insert(data.objects, self.Parser.Toggle.Save(idx, toggle))
        end
    end
    for idx, option in pairs(Library.Options) do
        local parser = self.Parser[option.Type]
        if parser and not self:IsIgnored(idx) then
            table.insert(data.objects, parser.Save(idx, option))
        end
    end

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if not ok then
        return false, "failed to encode config"
    end

    self:BuildFolderTree()
    local written, err = pcall(FS.writefile, self:ConfigPath() .. "/" .. name .. ".json", encoded)
    if not written then
        return false, tostring(err)
    end
    return true
end

function SaveManager:Load(name)
    if not FileSystemAvailable() then
        return false, "file system is not available"
    end
    name = Library:Trim(name or "")
    if name == "" then
        return false, "config name is empty"
    end

    local path = self:ConfigPath() .. "/" .. name .. ".json"
    local exists = false
    pcall(function()
        exists = FS.isfile(path)
    end)
    if not exists then
        return false, "config does not exist"
    end

    local okRead, contents = pcall(FS.readfile, path)
    if not okRead then
        return false, "failed to read config"
    end
    local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, contents)
    if not okDecode or type(decoded) ~= "table" then
        return false, "failed to decode config"
    end

    -- Theme preset first, then everything else, so saved custom colors win.
    local first, rest = {}, {}
    for _, entry in ipairs(decoded.objects or {}) do
        local parser = self.Parser[entry.type]
        if parser and not self:IsIgnored(entry.idx) then
            if entry.idx == "ThemeManager_ThemeList" then
                table.insert(first, entry)
            else
                table.insert(rest, entry)
            end
        end
    end
    for _, entry in ipairs(rest) do
        table.insert(first, entry)
    end

    self.Loading = true
    task.spawn(function()
        for _, entry in ipairs(first) do
            local parser = self.Parser[entry.type]
            local ok, err = pcall(parser.Load, entry.idx, entry)
            if not ok then
                warn("[Singularity] failed to load " .. tostring(entry.idx) .. ": " .. tostring(err))
            end
        end
        task.wait(0.6)
        self.Loading = false
    end)
    return true
end

function SaveManager:Delete(name)
    if not FileSystemAvailable() or not FS.delfile then
        return false, "delete is not supported"
    end
    local path = self:ConfigPath() .. "/" .. name .. ".json"
    local ok = pcall(FS.delfile, path)
    return ok
end

function SaveManager:RefreshConfigList()
    local names = {}
    if not FileSystemAvailable() then
        return names
    end
    local ok, files = pcall(FS.listfiles, self:ConfigPath())
    if not ok then
        return names
    end
    for _, file in ipairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then
            table.insert(names, name)
        end
    end
    table.sort(names)
    return names
end

function SaveManager:GetAutoloadConfig()
    if not FileSystemAvailable() then
