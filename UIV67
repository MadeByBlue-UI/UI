local function CreateTabbox(tab, column, name)
    local tabbox = {
        Type = "Tabbox",
        Name = name,
        Tab = tab,
        Tabs = {},
        ActiveTab = nil,
        UserVisible = true,
    }
    tabbox.Groupbox = tabbox

    local frame = Library:Create("Frame", {
        Name = "Tabbox_" .. (name or "Tabbox"),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = #column:GetChildren(),
        BackgroundTransparency = 0.1,
        ZIndex = 3,
        ["@BackgroundColor3"] = "MainColor",
        Parent = column,
    })
    Library:AddThemedCorner(frame, 1)
    Library:AddStroke(frame, "OutlineColor", 1)
    Library:AddList(frame, 0)

    local header = Library:Create("Frame", {
        Name = "TabHeader",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 30),
        LayoutOrder = 1,
        ZIndex = 4,
        Parent = frame,
    })
    Library:AddList(header, 0, Enum.FillDirection.Horizontal)

    Library:Create("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        LayoutOrder = 2,
        ZIndex = 4,
        ["@BackgroundColor3"] = "OutlineColor",
        Parent = frame,
    })

    local pages = Library:Create("Frame", {
        Name = "Pages",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 3,
        ZIndex = 3,
        Parent = frame,
    })

    tabbox.Frame = frame
    tabbox.Header = header
    tabbox.Pages = pages

    function tabbox:Relayout()
        local count = #self.Tabs
        for _, entry in ipairs(self.Tabs) do
            entry.Button.Size = UDim2.new(1 / count, 0, 1, 0)
        end
    end

    function tabbox:Select(entry)
        for _, other in ipairs(self.Tabs) do
            local active = other == entry
            other.Page.Visible = active
            other.Button.Label.TextColor3 = active and Library.Theme.FontColor or Library.Theme.MutedColor
            Library:Tween(other.Button.Line, {
                BackgroundTransparency = active and 0 or 1,
            }, Library.FastTweenInfo)
        end
        self.ActiveTab = entry
    end

    function tabbox:AddTab(tabName)
        local entry = {
            Type = "TabboxTab",
            Name = tabName,
            Tab = tab,
            Groupbox = tabbox,
            Elements = {},
            Order = 0,
        }

        local button = Library:Create("TextButton", {
            Name = "TabButton_" .. tabName,
            Size = UDim2.new(1, 0, 1, 0),
            Text = "",
            LayoutOrder = #tabbox.Tabs + 1,
            ZIndex = 5,
            Parent = header,
        })
        button.Label = Library:Create("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            Text = tabName,
            ZIndex = 6,
            ["@TextColor3"] = "MutedColor",
            Parent = button,
        })
        button.Line = Library:Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.fromScale(0.5, 1),
            Size = UDim2.new(0.8, 0, 0, 2),
            BackgroundTransparency = 1,
            ZIndex = 6,
            ["@BackgroundColor3"] = "AccentColor",
            Parent = button,
        })
        Library:AddCorner(button.Line, 9999)

        local page = Library:Create("Frame", {
            Name = "Page_" .. tabName,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 3,
            Parent = pages,
        })
        Library:AddPadding(page, 8, 10, 10, 10)
        Library:AddList(page, 6)

        entry.Button = button
        entry.Page = page
        entry.Container = page

        Library:ApplyBaseFuncs(entry)

        button.MouseButton1Click:Connect(function()
            tabbox:Select(entry)
        end)

        table.insert(tabbox.Tabs, entry)
        tabbox:Relayout()
        if #tabbox.Tabs == 1 then
            tabbox:Select(entry)
        end
        return entry
    end

    function tabbox:SetVisible(visible)
        self.UserVisible = visible
        frame.Visible = visible and self.SearchVisible ~= false
    end

    function tabbox:SetSearchVisible(visible)
        self.SearchVisible = visible
        frame.Visible = visible and self.UserVisible
    end

    table.insert(tab.Groupboxes, tabbox)
    return tabbox
end

Library.CreateGroupbox = CreateGroupbox
Library.CreateTabbox = CreateTabbox

