function Tab:CreateBlock(o)
	o = o or {}
	local right = self.TwoCols and tostring(o.Side):lower() == "right"
	local col = right and self.ColR or self.ColL
	self.Order = (self.Order or 0) + 1

	local frame = new("Frame", {
		Name = "BlockBackground", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Second, BackgroundTransparency = 0.2, BorderSizePixel = 0, LayoutOrder = self.Order,
	}, col)
	corner(frame, 8)
	stroke(frame, 0.9)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, frame)

	local head = new("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, LayoutOrder = 1 }, frame)
	local x = 10
	if o.ImageID and o.ImageID ~= "" then
		new("ImageLabel", { BackgroundTransparency = 1, Image = o.ImageID, ImageColor3 = T.Text,
			Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 10, 0.5, -8) }, head)
		x = 32
	end
	label(head, o.Name or "Block", 13, { Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -x - 30, 1, 0),
		Font = Enum.Font.GothamBold })
	local arrow = label(head, "-", 14, { Position = UDim2.new(1, -24, 0, 0), Size = UDim2.new(0, 16, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold })

	local body = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, LayoutOrder = 2 }, frame)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, body)
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, body)

	head.MouseButton1Click:Connect(function()
		body.Visible = not body.Visible
		arrow.Text = body.Visible and "-" or "+"
	end)

	return setmetatable({ Frame = frame, Body = body, Scroll = col, Tab = self }, Block)
end

function Window:CreateTab(name, _, icon)
	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = #self.Tabs + 1,
	}, self.Sidebar)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)
	local bar = new("Frame", { Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 0, 0.5, -8),
		BackgroundColor3 = T.Accent, BorderSizePixel = 0, Visible = false }, btn)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local x = 10
	if icon and icon ~= "" then
		new("ImageLabel", { BackgroundTransparency = 1, Image = icon, ImageColor3 = T.Text,
			Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 10, 0.5, -8) }, btn)
		x = 32
	end
	local txt = label(btn, name or "Tab", 13, { Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -x - 4, 1, 0),
		TextColor3 = T.ElementAccent })

	local page = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false }, self.Content)

	local function column(xScale, wScale)
		local sf = new("ScrollingFrame", {
			Position = UDim2.new(xScale, 0, 0, 0), Size = UDim2.new(wScale, xScale == 0 and 0 or -4, 1, 0),
			BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.Accent,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, page)
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
		new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }, sf)
		return sf
	end

	local tab = setmetatable({ Name = name, Page = page, Button = btn, TwoCols = self.TwoCols }, Tab)
	if self.TwoCols then
		tab.ColL = column(0, 0.5)
		tab.ColR = column(0.5, 0.5)
		tab.ColL.Size = UDim2.new(0.5, -4, 1, 0)
	else
		tab.ColL = column(0, 1)
		tab.ColR = tab.ColL
	end

	local window = self
	function tab:Select()
		for _, t in ipairs(window.Tabs) do
			t.Page.Visible = false
			t.Bar.Visible = false
			tween(t.Button, { BackgroundTransparency = 1 })
			t.Label.TextColor3 = T.ElementAccent
		end
		page.Visible = true
		bar.Visible = true
		tween(btn, { BackgroundTransparency = 0.9 })
		txt.TextColor3 = T.Text
	end
	tab.Bar, tab.Label = bar, txt
	btn.MouseButton1Click:Connect(function() tab:Select() end)

	table.insert(self.Tabs, tab)
	if #self.Tabs == 1 then tab:Select() end
	return tab
end

