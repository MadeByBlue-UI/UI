		Size = UDim2.fromOffset(14, 14), BackgroundColor3 = T.Text })
	circ(knob)
	return function(v, instant)
		if not instant and Library.Animations then
			knob.Size = UDim2.fromOffset(19, 14)
			tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.45, BACK)
		end
		tgl(tr, { BackgroundColor3 = v and T.Accent or T.Off }, instant, 0.25)
		tgl(knob, { Position = v and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
