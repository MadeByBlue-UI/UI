-- ============================================================================
-- ALERTES JOUEURS : notifications quand un ami (ou un joueur surveillé) rejoint / quitte le serveur, quand tu meurs...
--   Réglages : Paramètres > « Alertes joueurs » (sauvegardés automatiquement, flags « ui.alert.* »).
--   Limite Roblox : seuls les joueurs du MÊME serveur sont détectables (pas les amis qui rejoignent un autre jeu).
--   Library:_startPlayerAlerts() est lancé tout seul par l'onglet Paramètres.
-- ============================================================================
local function aflag(k, d)
	local v = Library.Flags["ui.alert." .. k]
	if v == nil then return d end
	return v
end

function Library:_startPlayerAlerts()
	if Library._alertsOn then return end
	Library._alertsOn = true
	local friendCache = {}
	local function dur() return tonumber(aflag("dur", 5)) or 5 end
	local function nameOf(p)
		if p.DisplayName ~= p.Name then return p.DisplayName .. " (@" .. p.Name .. ")" end
		return p.Name
	end
	local function watched(p)
		local list = tostring(aflag("watch", ""))
		if list == "" then return false end
		local n, d = string.lower(p.Name), string.lower(p.DisplayName)
		for w in string.gmatch(list, "[^,;]+") do
			w = string.lower(string.match(w, "^%s*(.-)%s*$"))
			if w ~= "" and (w == n or w == d) then return true end
		end
		return false
	end
	local function alert(p, joined)
		if not aflag("master", true) then return end
		local key = joined and "join" or "leave"
		local title, kind
		if watched(p) then
			title = joined and "Joueur surveillé : arrivée" or "Joueur surveillé : départ"
			kind = joined and "Warning" or "Info"
		elseif friendCache[p.UserId] and aflag("friend" .. key, true) then
			title = joined and "Ami connecté" or "Ami parti"
			kind = joined and "Success" or "Warning"
		elseif aflag("any" .. key, false) then
			title = joined and "Joueur arrivé" or "Joueur parti"
			kind = "Info"
		else
			return
		end
		Library:Notify({ Title = title, Content = nameOf(p), Type = kind, Duration = dur(),
			Icon = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=150&h=150" })
	end
	local function onAdded(p, quiet)
		if p == LP then return end
		task.spawn(function()
			local ok, f = pcall(function() return LP:IsFriendsWith(p.UserId) end)
			friendCache[p.UserId] = (ok and f) and true or false
			if not quiet then alert(p, true) end
		end)
	end
	for _, p in ipairs(Players:GetPlayers()) do onAdded(p, true) end   -- déjà présents : pas d'alerte
	track(Players.PlayerAdded:Connect(function(p) onAdded(p, false) end))
	track(Players.PlayerRemoving:Connect(function(p)
		if p == LP then return end
		alert(p, false)
		task.defer(function() friendCache[p.UserId] = nil end)
	end))

	local function hook(char)
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			hum.Died:Connect(function()
				if aflag("master", true) and aflag("death", false) then
					Library:Notify({ Title = "Tu es mort", Content = "Ton personnage a été éliminé.", Type = "Error",
						Duration = dur() })
				end
			end)
		end
	end
	if LP.Character then task.spawn(hook, LP.Character) end
	track(LP.CharacterAdded:Connect(function(c) task.spawn(hook, c) end))
end

-- ============================================================================
-- AMIS SURVEILLÉS : liste de tes amis Roblox, tu choisis ceux dont tu veux être prévenu quand ils passent en ligne.
--   Utilise Players:GetFriendsAsync (champ IsOnline) relevé toutes les N secondes + la présence dans ton serveur.
--   Réglages : Paramètres > « Amis surveillés » (flags « ui.alert.* », sauvegardés automatiquement).
--   Library:RefreshFriends() recharge la liste à la main.
-- ============================================================================
local function fetchFriends()
	local out = {}
	local ok = pcall(function()
		local pages = Players:GetFriendsAsync(LP.UserId)
		while true do
			for _, f in ipairs(pages:GetCurrentPage()) do out[#out + 1] = f end
			if pages.IsFinished then break end
			pages:AdvanceToNextPageAsync()
		end
	end)
	return out, ok
end

function Library:_startFriendWatch(listBlock, setStatus)
	if Library._friendWatchOn then return end
	Library._friendWatchOn = true
	local tok = (Library._fwTok or 0) + 1
	Library._fwTok = tok
	local ONLINE, OFFLINE = Color3.fromRGB(61, 220, 151), Color3.fromRGB(110, 110, 118)
	local state, seeded, busy, sig = {}, false, false, nil
	local selected = {}          -- [userId] = true : amis dont tu veux être prévenu
	local rows, dots, lastList = {}, {}, {}

	local function flagList()
		local out = {}
		for id in pairs(selected) do out[#out + 1] = id end
		table.sort(out)
		return out
	end
	local function saveSel() Library.Flags["ui.alert.friends"] = flagList() end
	local function headshot(id) return "rbxthumb://type=AvatarHeadShot&id=" .. id .. "&w=150&h=150" end
	local function labelOf(f)
		local dn = f.DisplayName
		if dn and dn ~= "" and dn ~= f.Username then return f.Username .. " (" .. dn .. ")" end
		return f.Username
	end

	-- la sélection est enregistrée avec les réglages (liste d'IDs) et restaurée même avant que les amis soient chargés
	saveSel()
	Library.Defaults["ui.alert.friends"] = {}
	Library.Items["ui.alert.friends"] = {
		Get = flagList,
		Set = function(_, list)
			selected = {}
			if type(list) == "table" then
				for _, id in ipairs(list) do
					local n = tonumber(id)
					if n then selected[n] = true end
				end
			end
			saveSel()
			for id, it in pairs(rows) do pcall(it.Set, it, selected[id] == true) end
		end,
	}

	local function buildRows(list)
		for _, c in ipairs(listBlock.Body:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		table.clear(listBlock.Entries)
		table.clear(rows)
		table.clear(dots)
		if #list == 0 then
			listBlock:CreateParagraph({ Title = "Aucun ami", Content = "Ta liste d'amis Roblox est vide ou n'a pas pu être chargée." })
			return
		end
		for _, f in ipairs(list) do
			local id = f.Id
			local it = listBlock:CreateToggle({ Name = labelOf(f), Default = selected[id] == true, Favorite = false,
				Palette = false, HUD = false,
				Callback = function(v)
					if v then selected[id] = true else selected[id] = nil end
					saveSel()
				end })
			rows[id] = it
			local e = listBlock.Entries[#listBlock.Entries]
			local fr = e and e.Frame
			if fr then
				-- petit avatar rond à gauche + pastille de statut (vert = en ligne)
				local av = new("ImageLabel", { Position = UDim2.fromOffset(10, 5), Size = UDim2.fromOffset(24, 24),
					BackgroundColor3 = T.Off, BorderSizePixel = 0, Image = headshot(id), ScaleType = Enum.ScaleType.Crop,
					ZIndex = 2 }, fr)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, av)
				local dot = new("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 3, 1, 3),
					Size = UDim2.fromOffset(10, 10), BackgroundColor3 = (state[id] and ONLINE or OFFLINE),
					BorderSizePixel = 0, ZIndex = 3 }, av)
				dot:SetAttribute("NoAccent", true)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
				new("UIStroke", { Color = T.Second, Thickness = 1.5, ApplyStrokeMode = BORDER }, dot)
				dots[id] = dot
				-- le nom se décale pour laisser la place à l'avatar
				for _, c in ipairs(fr:GetChildren()) do
					if c:IsA("TextLabel") then
						c.Position = UDim2.new(0, 46, 0, 0)
						c.Size = UDim2.new(1, -46 - 60, 1, 0)
						break
					end
				end
			end
		end
	end

	local function refresh()
		if busy then return end
		busy = true
		task.spawn(function()
			local list, ok = fetchFriends()
			busy = false
			if Library._fwTok ~= tok then return end
			if not ok and #list == 0 then
				setStatus("Liste indisponible", "Impossible de récupérer tes amis pour l'instant. Réessaie dans un moment.")
				return
			end
			table.sort(list, function(a, b) return string.lower(a.Username) < string.lower(b.Username) end)
			lastList = list
			-- état en ligne (avant de construire les lignes, pour que les pastilles soient justes tout de suite)
			local prevState = state
			state = {}
			for _, f in ipairs(list) do
				state[f.Id] = (f.IsOnline == true) or (Players:GetPlayerByUserId(f.Id) ~= nil)
			end
			local names = {}
			for _, f in ipairs(list) do names[#names + 1] = f.Id .. ":" .. f.Username end
			local newSig = table.concat(names, "|")
			if newSig ~= sig then
				sig = newSig
				buildRows(list)
			end
			local nOnline = 0
			for _, f in ipairs(list) do
				local id = f.Id
				local on = state[id]
				if on then nOnline += 1 end
				local dot = dots[id]
				if dot and dot.Parent then tween(dot, { BackgroundColor3 = on and ONLINE or OFFLINE }, 0.3) end
				local prev = prevState[id]
				if seeded and prev ~= nil and prev ~= on and selected[id]
					and aflag("master", true) and aflag("watchfriends", true) then
					local d = tonumber(aflag("dur", 5)) or 5
					if on then
						Library:Notify({ Title = "Ami en ligne", Content = labelOf(f), Type = "Success", Duration = d, Icon = headshot(id) })
					elseif aflag("watchoff", false) then
						Library:Notify({ Title = "Ami hors ligne", Content = labelOf(f), Type = "Info", Duration = d, Icon = headshot(id) })
					end
				end
			end
			seeded = true
			local nSel = 0
			for _ in pairs(selected) do nSel += 1 end
			setStatus(#list .. (#list > 1 and " amis chargés" or " ami chargé"),
				nSel .. " surveillé(s) · " .. nOnline .. " en ligne actuellement. Dernière vérification : " .. os.date("%H:%M:%S") .. ".")
		end)
	end
	Library.RefreshFriends = refresh
	Library.WatchAllFriends = function(on)
		selected = {}
		if on then
			for _, f in ipairs(lastList) do selected[f.Id] = true end
		end
		saveSel()
		for id, it in pairs(rows) do pcall(it.Set, it, selected[id] == true) end
	end

	task.spawn(function()
		task.wait(3)
		refresh()
		while Library._friendWatchOn and Library._fwTok == tok do
			task.wait(math.clamp(tonumber(aflag("poll", 60)) or 60, 30, 600))
			if Library._friendWatchOn and Library._fwTok == tok and aflag("master", true) and aflag("watchfriends", true) then
				refresh()
			end
		end
	end)
end

