function BaseFuncs:AddLabel(a, b)
    local idx, info
    if type(a) == "string" and type(b) == "table" then
        idx, info = a, b
    elseif type(a) == "table" then
        info = a
    else
        info = { Text = a, DoesWrap = b }
    end
    info.Text = info.Text or ""

    local label = { Type = "Label", Text = info.Text, DoesWrap = info.DoesWrap == true }
    local holder = self:CreateHolder(18, "Label")
    holder.AutomaticSize = label.DoesWrap and Enum.AutomaticSize.Y or Enum.AutomaticSize.None

    local textLabel = Library:Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        AutomaticSize = label.DoesWrap and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
        Text = info.Text,
        TextWrapped = label.DoesWrap,
        RichText = true,
        TextXAlignment = info.Alignment or Enum.TextXAlignment.Left,
        TextYAlignment = label.DoesWrap and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        ZIndex = 4,
        ["@TextColor3"] = info.Muted and "MutedColor" or "FontColor",
        Parent = holder,
    })
    label.TextLabel = textLabel
    label.Addons = self:CreateAddonContainer(holder, 0)

    Library:MakeVisibilityController(label, holder)
    Library:RegisterSearch(label, info.Text, self)
    if info.Tooltip then
        Library:AddTooltip(info.Tooltip, holder)
    end

    function label:SetText(text)
        self.Text = text
        textLabel.Text = text
        if self.SearchEntry then
            self.SearchEntry.Text = string.lower(text)
            self.SearchEntry.Display = text
        end
    end

    function label:GetText()
        return self.Text
    end

    function label:SetColor(color)
        Library:Unbind(textLabel)
        textLabel.TextColor3 = color
    end

    label.AddColorPicker = Addons.AddColorPicker
    label.AddKeyPicker = Addons.AddKeyPicker

    table.insert(self.Elements or {}, label)
    Register(label, idx, Library.Labels)
    return label
end

