function BaseFuncs:AddProgress(idx, info)
    info = info or {}
    local progress = {
        Type = "Progress",
        Index = idx,
        Text = info.Text,
        Min = info.Min or 0,
        Max = info.Max or 100,
        Suffix = info.Suffix or "",
        Percent = info.Percent ~= false,
        Value = info.Default or 0,
        Changed = Signal.new(),
    }

    local hasText = info.Text ~= nil and info.Text ~= ""
    local holder = self:CreateHolder(hasText and 32 or 14, "Progress")

    local textLabel, valueLabel
    if hasText then
        textLabel = Library:Create("TextLabel", {
            Size = UDim2.new(1, -90, 0, 16),
            Text = info.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4,
            ["@TextColor3"] = "FontColor",
            Parent = holder,
        })
        valueLabel = Library:Create("TextLabel", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.fromOffset(90, 16),
            Text = "",
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 4,
            ["@TextColor3"] = "MutedColor",
            Parent = holder,
        })
    end

    local track = Library:Create("Frame", {
        Position = UDim2.fromOffset(0, hasText and 22 or 2),
        Size = UDim2.new(1, 0, 0, 8),
        ZIndex = 4,
        ["@BackgroundColor3"] = "OutlineColor",
        Parent = holder,
    })
    Library:AddCorner(track, 9999)

    local fill = Library:Create("Frame", {
        Size = UDim2.fromScale(0, 1),
        ZIndex = 5,
        BackgroundColor3 = Color3.new(1, 1, 1),
        ClipsDescendants = true,
        Parent = track,
    })
    Library:AddCorner(fill, 9999)
    local gradient = Library:Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Library.Theme.DiskColor3),
            ColorSequenceKeypoint.new(0.6, Library.Theme.AccentColor),
            ColorSequenceKeypoint.new(1, Library.Theme.DiskColor1),
        }),
        Parent = fill,
    })

    local shimmer = Library:AddAnimation(function(_, clock)
        if not holder.Parent then
            return
        end
        gradient.Offset = Vector2.new(math.sin(clock * 1.2) * 0.12, 0)
    end)

    function progress:Display()
        local range = self.Max - self.Min
        local ratio = range == 0 and 0 or math.clamp((self.Value - self.Min) / range, 0, 1)
        Library:Tween(fill, { Size = UDim2.fromScale(ratio, 1) }, Library.TweenInfo)
        if valueLabel then
            if self.Percent then
                valueLabel.Text = string.format("%d%%", math.floor(ratio * 100 + 0.5))
            else
                valueLabel.Text = string.format("%s / %s%s", tostring(Library:Round(self.Value, 2)),
                    tostring(self.Max), self.Suffix)
            end
        end
    end

    function progress:SetValue(value)
        self.Value = math.clamp(tonumber(value) or self.Min, self.Min, self.Max)
        self:Display()
        self.Changed:Fire(self.Value)
    end

    function progress:SetMax(value)
        self.Max = value
        self:Display()
    end

    function progress:SetText(text)
        self.Text = text
        if textLabel then
            textLabel.Text = text
        end
    end

    function progress:OnChanged(fn)
        return self.Changed:Connect(fn)
    end

    function progress:GetValue()
        return self.Value
    end

    holder.Destroying:Connect(function()
        shimmer:Stop()
    end)

    Library:OnThemeChanged(holder, function()
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Library.Theme.DiskColor3),
            ColorSequenceKeypoint.new(0.6, Library.Theme.AccentColor),
            ColorSequenceKeypoint.new(1, Library.Theme.DiskColor1),
        })
    end)

    Library:MakeVisibilityController(progress, holder)
    if hasText then
        Library:RegisterSearch(progress, info.Text, self)
    end
    progress:Display()

    if idx then
        Library.Options[idx] = progress
    end
    return progress
end

