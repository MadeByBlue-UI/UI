function Library:ApplyBaseFuncs(object)
    for name, fn in pairs(BaseFuncs) do
        object[name] = fn
    end
end

function BaseFuncs:AddDependencyBox()
    local box = {
        Type = "DependencyBox",
        Dependencies = {},
        Tab = self.Tab,
        Groupbox = self.Groupbox,
        Elements = {},
        Order = 0,
    }

    local holder = Library:Create("Frame", {
        Name = "DependencyBox",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = self:NextOrder(),
        Visible = false,
        ZIndex = 3,
        Parent = self.Container,
    })
    local container = Library:Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 3,
        Parent = holder,
    })
    Library:AddList(container, 6)

    box.Holder = holder
    box.Container = container
    Library:ApplyBaseFuncs(box)

    function box:SetupDependencies(dependencies)
        self.Dependencies = dependencies or {}
        self:Update()
    end

    function box:Update()
        local satisfied = true
        for _, dependency in ipairs(self.Dependencies) do
            local element, expected = dependency[1], dependency[2]
            if element == nil then
                satisfied = false
                break
            end
            local value = element.Value
            if element.Type == "Dropdown" and element.Multi then
                if type(expected) == "table" then
                    for _, name in ipairs(expected) do
                        if not value[name] then
                            satisfied = false
                        end
                    end
                elseif not value[expected] then
                    satisfied = false
                end
            elseif value ~= expected then
                satisfied = false
            end
            if not satisfied then
                break
            end
        end
        self.Satisfied = satisfied
        holder.Visible = satisfied
    end

    table.insert(Library.DependencyBoxes, box)
    return box
end

