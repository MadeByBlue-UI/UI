		tab.Label.Position = UDim2.new(0, 34, 0, 0)
		tab.Label.Size = UDim2.new(1, -48, 1, 0)
		local ico = new("Frame", { Position = UDim2.new(0, 12, 0.5, -7), Size = UDim2.fromOffset(14, 14),
			BackgroundTransparency = 1, BorderSizePixel = 0 }, tab.Button)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, ico)
		new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0.2 }, ico)
		local dot = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(4, 4), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, ico)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	end
	return tab
end

-- ============================================================================
-- V6 : PALETTE DE COMMANDES  (Ctrl+K)
--   Roue circulaire au milieu de l'écran, curseur libéré. Lance n'importe quel bouton, bascule n'importe quel
--   interrupteur ou règle n'importe quel curseur / liste / champ / couleur / touche sans ouvrir les onglets.
--     1 à 0 : choisir   ·  clic : choisir   ·  Tab : changer de filtre (Tout / Favoris / Boutons / Toggles / Réglages)
--     molette ou ← → : page suivante / précédente   ·  / ou clic au centre : rechercher   ·  Échap / Retour : retour
--     Maj + choix d'un bouton : la palette reste ouverte
--   API : Library:OpenPalette() / ClosePalette() / TogglePalette() / SetPaletteEnabled(v) / SetPaletteKey(KeyCode, needCtrl)
--         Option { Palette = false } sur un élément pour l'exclure de la palette.
-- ============================================================================
do
	local CAS = game:GetService("ContextActionService")

	Library.PaletteEnabled  = true
	Library.PaletteNeedCtrl = true
	Library.PaletteKey      = Enum.KeyCode.K

	local RING_R, PER = 215, 10
	local FILTERS = { "Tout", "Favoris", "Boutons", "Toggles", "Réglages" }
	local KC = Enum.KeyCode
	local DIGIT = {
		[KC.One] = 1, [KC.Two] = 2, [KC.Three] = 3, [KC.Four] = 4, [KC.Five] = 5,
		[KC.Six] = 6, [KC.Seven] = 7, [KC.Eight] = 8, [KC.Nine] = 9, [KC.Zero] = 10,
		[KC.KeypadOne] = 1, [KC.KeypadTwo] = 2, [KC.KeypadThree] = 3, [KC.KeypadFour] = 4, [KC.KeypadFive] = 5,
		[KC.KeypadSix] = 6, [KC.KeypadSeven] = 7, [KC.KeypadEight] = 8, [KC.KeypadNine] = 9, [KC.KeypadZero] = 10,
	}
	local CAS_KEYS = { Enum.UserInputType.MouseWheel, KC.Tab, KC.Left, KC.Right, KC.Backspace, KC.Slash, KC.Escape }
	for k in pairs(DIGIT) do CAS_KEYS[#CAS_KEYS + 1] = k end
	local SINK, PASS = Enum.ContextActionResult.Sink, Enum.ContextActionResult.Pass
	local IN = Enum.EasingDirection.In

	local P = { open = false, filter = 1, page = 1, pages = 1, query = "", stack = {}, shown = {}, slots = {} }
	local seqSpin = {}

	-- fonctions déclarées à l'avance (elles s'appellent entre elles)
	local render, pushView, popView, pick, flash, setHint, changePage, cycleFilter, focusSearch, escape

	local function shiftDown() return UIS:IsKeyDown(KC.LeftShift) or UIS:IsKeyDown(KC.RightShift) end
	local function ctrlDown() return UIS:IsKeyDown(KC.LeftControl) or UIS:IsKeyDown(KC.RightControl) end
	local function safeGet(it)
		if type(it) ~= "table" or type(it.Get) ~= "function" then return nil end
		local ok, v = pcall(it.Get)
		if ok then return v end
		return nil
	end

	-- ───────────── Contenu ─────────────
	local function entryList()
		local list = {}
		for _, e in pairs(Library.CmdEntries) do
			if e.Frame and e.Frame.Parent then list[#list + 1] = e end
		end
		table.sort(list, function(a, b) return a.Seq < b.Seq end)
		return list
	end

	local function stateOf(e)
		local k, v = e.Kind, safeGet(e.Item)
		if k == "Toggle" then
			return v and "ON" or "OFF", (v and true or false), nil
		elseif k == "Slider" then
			return tostring(v == nil and "" or v) .. (e.Opts.Suffix or ""), nil, nil
		elseif k == "Dropdown" then
			if type(v) == "table" then return #v .. " choisi(s)", nil, nil end
			return tostring(v or "—"), nil, nil
		elseif k == "Input" then
			local s = tostring(v or "")
			return (s == "") and "(vide)" or s, nil, nil
		elseif k == "Keybind" then
			return (typeof(v) == "EnumItem") and v.Name or "—", nil, nil
		elseif k == "ColorPicker" then
			return "couleur", nil, (typeof(v) == "Color3") and v or nil
		end
		return tostring(e.Tab or ""), nil, nil
	end

	local function textInputView(e, initial, placeholder, submit)
		return {
			title = e.Name, hint = "Entrée valide · Échap annule", build = function() return {} end,
			input = { text = initial or "", placeholder = placeholder or "Valeur...", submit = submit },
		}
	end

	local function sliderView(e)
		local o, it = e.Opts, e.Item
		local min, max = o.Min or 0, o.Max or 100
		local step = o.Step or o.Increment
		local suffix = o.Suffix or ""
		return {
			title = e.Name,
			build = function()
				local cur = tonumber(safeGet(it)) or min
				local out, seen = {}, {}
				for i = 0, 8 do
					local v = min + (max - min) * i / 8
					if step and step > 0 then v = min + math.floor((v - min) / step + 0.5) * step end
					v = math.clamp(math.floor(v * 100 + 0.5) / 100, min, max)
					if not seen[v] then
						seen[v] = true
						out[#out + 1] = {
							Name = tostring(v) .. suffix, Sub = (i == 0 and "min") or (i == 8 and "max") or "",
							Value = v, Tab = e.Tab, Block = e.Block,
							Run = function()
								pcall(function() it.Set(v) end)
								flash(e.Name .. " : " .. tostring(v) .. suffix)
								render(false)
							end,
						}
					end
				end
				local best, bd
				for _, x in ipairs(out) do
					local d = math.abs(x.Value - cur)
					if not bd or d < bd then best, bd = x, d end
				end
				if best then best.On = true end
				if #out < PER then
					out[#out + 1] = {
						Name = "Saisir...", Sub = "valeur exacte", Tab = e.Tab, Block = e.Block,
						Run = function()
							pushView(textInputView(e, tostring(safeGet(it) or ""), "Nombre", function(txt)
								local n = tonumber(string.match(txt, "-?%d+%.?%d*"))
								if n then
									pcall(function() it.Set(n) end)
									flash(e.Name .. " : " .. tostring(safeGet(it)) .. suffix)
								end
							end))
						end,
					}
				end
				return out
			end,
		}
	end

	local function dropView(e)
		local o, it = e.Opts, e.Item
		local multi = (o.Multi == true) or (o.MultiSelect == true) or (o.MultipleOptions == true)
		local names = {}
		for _, v in ipairs(o.Items or o.Options or {}) do names[#names + 1] = tostring(v) end
		return {
			title = e.Name,
			build = function()
				local cur = safeGet(it)
				local set = {}
				if type(cur) == "table" then
					for _, x in ipairs(cur) do set[tostring(x)] = true end
				elseif cur ~= nil then
					set[tostring(cur)] = true
				end
				local out = {}
				for _, n in ipairs(names) do
					out[#out + 1] = {
						Name = n, Sub = set[n] and "choisi" or "", On = set[n] and true or nil,
						Tab = e.Tab, Block = e.Block,
						Run = function()
							if multi then
								local list = {}
								for _, m in ipairs(names) do
									if (m == n and not set[m]) or (m ~= n and set[m]) then list[#list + 1] = m end
								end
								pcall(function() it.Set(list) end)
								render(false)
							else
								pcall(function() it.Set(n) end)
								flash(e.Name .. " : " .. n)
								popView()
							end
						end,
					}
				end
				if #out == 0 then
					out[1] = { Name = "(liste vide)", Sub = "", Run = function() end }
				end
				return out
			end,
		}
	end

	local COLOR_PRESETS = {
		{ "Blanc", Color3.fromRGB(255, 255, 255) }, { "Rouge", Color3.fromRGB(255, 77, 94) },
		{ "Orange", Color3.fromRGB(255, 150, 60) }, { "Jaune", Color3.fromRGB(255, 214, 80) },
		{ "Vert", Color3.fromRGB(61, 220, 151) }, { "Cyan", Color3.fromRGB(80, 220, 235) },
		{ "Bleu", Color3.fromRGB(80, 130, 255) }, { "Violet", Color3.fromRGB(160, 100, 255) },
		{ "Rose", Color3.fromRGB(255, 110, 200) },
	}
	local function colorView(e)
		local it = e.Item
		return {
			title = e.Name,
			build = function()
				local cur = safeGet(it)
				local out = {}
				for _, p in ipairs(COLOR_PRESETS) do
					local c = p[2]
					local same = typeof(cur) == "Color3"
						and math.abs(cur.R - c.R) + math.abs(cur.G - c.G) + math.abs(cur.B - c.B) < 0.02
					out[#out + 1] = {
						Name = p[1], Sub = "", Color = c, On = same and true or nil, Tab = e.Tab, Block = e.Block,
						Run = function()
							pcall(function() it.Set(c) end)
							flash(e.Name .. " : " .. p[1])
							popView()
						end,
					}
				end
				out[#out + 1] = {
					Name = "Hex...", Sub = "#RRGGBB", Tab = e.Tab, Block = e.Block,
					Run = function()
						local hex = typeof(cur) == "Color3" and cur:ToHex() or ""
						pushView(textInputView(e, hex, "RRGGBB", function(txt)
							local ok, c = pcall(Color3.fromHex, (string.gsub(txt, "#", "")))
							if ok and typeof(c) == "Color3" then
								pcall(function() it.Set(c) end)
								flash(e.Name .. " : #" .. c:ToHex())
							end
						end))
					end,
				}
				return out
			end,
		}
	end

	local function keyView(e)
		return {
			title = e.Name, hint = "Appuie sur une touche...\nÉchap : annuler", build = function() return {} end,
			capture = function(kc)
				pcall(function() e.Item.Set(kc) end)
				flash(e.Name .. " : " .. kc.Name)
			end,
		}
	end

	local function makeItem(e)
		local sub, on, col = stateOf(e)
		local armed = (P.armedKey == e.Key)
		local it = {
			Name = e.Name, Sub = armed and "Confirmer ?" or sub, On = on, Color = col, Armed = armed,
			Tab = e.Tab, Block = e.Block, Key = e.Key,
		}
		local k = e.Kind
		it.Run = function(keep)
			if k == "Button" then
				if e.Opts.Confirm and P.armedKey ~= e.Key then
					P.armedKey = e.Key
					flash("Rappuie pour confirmer")
					render(false)
					task.delay(3, function()
						if P.armedKey == e.Key then
							P.armedKey = nil
							if P.open then render(false) end
						end
					end)
					return
				end
				P.armedKey = nil
				fire(e.Opts.Callback)
				flash(e.Name .. " : lancé")
				if keep then render(false) else Library:ClosePalette() end
			elseif k == "Toggle" then
				local cur = safeGet(e.Item) and true or false
				pcall(function() e.Item.Set(not cur) end)
				flash(e.Name .. " : " .. ((not cur) and "ON" or "OFF"))
				render(false)
			elseif k == "Slider" then
				pushView(sliderView(e))
			elseif k == "Dropdown" then
				pushView(dropView(e))
			elseif k == "ColorPicker" then
				pushView(colorView(e))
			elseif k == "Keybind" then
				pushView(keyView(e))
			elseif k == "Input" then
				pushView(textInputView(e, tostring(safeGet(e.Item) or ""), e.Opts.Placeholder or "Texte", function(txt)
					pcall(function() e.Item.Set(txt) end)
					flash(e.Name .. " : " .. txt)
				end))
			end
		end
		return it
	end

	local function builtins()
		local function win() return Library.Window end
		return {
			{ Name = "Fenêtre : afficher / masquer", Sub = "Interface", Tab = "Palette", Block = "Interface",
				Run = function()
					local w = win()
					Library:ClosePalette()
					if w and w.Toggle then w:Toggle() end
				end },
			{ Name = "Fenêtre : recentrer", Sub = "Interface", Tab = "Palette", Block = "Interface",
				Run = function()
					local w = win()
					if w and w.Reset then w:Reset() end
					Library:ClosePalette()
				end },
			{ Name = "Notifications : tout fermer", Sub = "Notifications", Tab = "Palette", Block = "Notifications",
				Run = function() Library:ClosePalette() Library:ClearNotifications() end },
			{ Name = "Ne pas déranger", Sub = Library.NotifMuted and "ON" or "OFF", On = Library.NotifMuted and true or false,
				Tab = "Palette", Block = "Notifications",
				Run = function()
					local v = not Library.NotifMuted
					local it = Library.Items["ui.notifmute"]
					if it and it.Set then pcall(it.Set, v) else Library:SetNotifMuted(v) end
					flash("Ne pas déranger : " .. (v and "ON" or "OFF"))
					render(false)
				end },
		}
	end

	local function rootView()
		return {
			root = true,
			build = function()
				local f = P.filter
				local favs, rest, out = {}, {}, {}
				for _, e in ipairs(entryList()) do
					local k = e.Kind
					local pass = (f == 1)
						or (f == 2 and Library.Favorites[e.Key])
						or (f == 3 and k == "Button")
						or (f == 4 and k == "Toggle")
						or (f == 5 and k ~= "Button" and k ~= "Toggle")
					if pass then
						local it = makeItem(e)
						if Library.Favorites[e.Key] then favs[#favs + 1] = it else rest[#rest + 1] = it end
					end
				end
				for _, it in ipairs(favs) do out[#out + 1] = it end
				if f == 1 or f == 3 then
					for _, b in ipairs(builtins()) do out[#out + 1] = b end
				end
				for _, it in ipairs(rest) do out[#out + 1] = it end
				return out
			end,
		}
	end

	local function matchScore(it, q)
		local n = string.lower(it.Name)
		local at = string.find(n, q, 1, true)
		if at == 1 then return 3 end
		if at then return 2 end
		local p = string.lower(tostring(it.Tab or "") .. " " .. tostring(it.Block or ""))
		if string.find(p, q, 1, true) then return 1 end
		return 0
	end

	local function visibleItems(v)
		if v.input or v.capture then return {} end
		local items = v.build()
		local q = string.lower(string.match(P.query, "^%s*(.-)%s*$") or "")
		if q == "" then return items end
		local scored = {}
		for idx, it in ipairs(items) do
			local s = matchScore(it, q)
			if s > 0 then scored[#scored + 1] = { it = it, s = s, i = idx } end
		end
		table.sort(scored, function(a, b)
			if a.s ~= b.s then return a.s > b.s end
			return a.i < b.i
		end)
		local out = {}
		for _, x in ipairs(scored) do out[#out + 1] = x.it end
		return out
	end

	-- ───────────── Interface ─────────────
	local function buildGui()
		if P.gui and P.gui.Parent then return end
		local gui = new("ScreenGui", { Name = "SolarisPalette", ResetOnSpawn = false, DisplayOrder = 1001,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, Enabled = false })
		mount(gui)
		P.gui = gui

		-- voile (bouton « Modal » : libère aussi le curseur en vue à la première personne)
		P.dim = new("TextButton", { Name = "Dim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Modal = true, BorderSizePixel = 0 }, gui)
		P.dim.MouseButton1Click:Connect(function() Library:ClosePalette() end)

		P.root = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, BorderSizePixel = 0 }, gui)
		P.rootScale = new("UIScale", { Scale = 1 }, P.root)

		-- cœur : disque sombre, anneaux d'accrétion et moyeu (le tout s'ouvre / s'effondre d'un bloc)
		P.core = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0),
			Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, BorderSizePixel = 0 }, P.root)
		P.coreScale = new("UIScale", { Scale = 1 }, P.core)

		local function circle(size, parent, props)
			local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0),
				Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, BorderSizePixel = 0 }, parent)
			for k, v in pairs(props or {}) do f[k] = v end
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
			return f
		end
		local function ringStroke(f, th, tr)
			local st = new("UIStroke", { Color = T.Accent, Thickness = th, Transparency = tr, ApplyStrokeMode = BORDER }, f)
			local g = new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(60, 60, 68)),
				Transparency = ringSeq() }, st)
			return st, g
		end

		P.disc = circle(RING_R * 2 - 56, P.core, { BackgroundColor3 = T.Main, BackgroundTransparency = 0.3, ZIndex = 1 })
		P.ring1 = circle(RING_R * 2 - 58, P.core, { ZIndex = 2 })
		P.ring1St, P.g1 = ringStroke(P.ring1, 2, 0.1)
		P.ring2 = circle(RING_R * 2 - 96, P.core, { ZIndex = 2 })
		P.ring2St, P.g2 = ringStroke(P.ring2, 1, 0.45)
		P.hub = circle(148, P.core, { BackgroundColor3 = T.Main, BackgroundTransparency = 0.02, ZIndex = 3 })
		P.hubSt, P.g3 = ringStroke(P.hub, 2, 0.05)

		P.title = new("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 30),
			Size = UDim2.fromOffset(112, 18), BackgroundTransparency = 1, Text = "Palette", TextColor3 = T.Text,
			TextSize = 11, Font = F_BOLD, AutoButtonColor = false, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 }, P.hub)
		P.title.MouseButton1Click:Connect(function() cycleFilter(1) end)

		P.search = new("TextBox", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 70),
			Size = UDim2.fromOffset(112, 26), BackgroundColor3 = T.Off, BackgroundTransparency = 0.35, BorderSizePixel = 0,
			Text = "", PlaceholderText = "Rechercher...", PlaceholderColor3 = Color3.fromRGB(125, 125, 132),
			TextColor3 = T.Text, TextSize = 12, Font = F_REG, ClearTextOnFocus = false, TextXAlignment = CENTER,
			TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 }, P.hub)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, P.search)
		P.searchSt = new("UIStroke", { Color = T.Accent, Thickness = 1, Transparency = 0.85, ApplyStrokeMode = BORDER }, P.search)

		P.hint = new("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 108),
			Size = UDim2.fromOffset(118, 30), BackgroundTransparency = 1, Text = "", TextColor3 = T.ElementAccent,
			TextSize = 10, Font = F_MED, TextWrapped = true, TextXAlignment = CENTER,
			TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 }, P.hub)

		-- boutons page précédente / suivante (utiles sans molette, sur mobile)
		local function navBtn(txt, x, delta)
			local b = new("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, 112),
				Size = UDim2.fromOffset(26, 26), BackgroundColor3 = T.Main, BackgroundTransparency = 0.05, Text = txt,
				TextColor3 = T.Text, TextSize = 14, Font = F_BOLD, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 4 }, P.core)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, b)
			new("UIStroke", { Color = T.Accent, Thickness = 1, Transparency = 0.6, ApplyStrokeMode = BORDER }, b)
			b.MouseButton1Click:Connect(function() changePage(delta) end)
			return b
		end
		P.prev = navBtn("<", -44, -1)
		P.next = navBtn(">", 44, 1)

		P.search:GetPropertyChangedSignal("Text"):Connect(function()
			if P.settingText then return end
			local txt = P.search.Text
			if os.clock() - (P.focusAt or 0) < 0.12 and string.find(txt, "/", 1, true) then
				P.settingText = true
				P.search.Text = (string.gsub(txt, "/", ""))
				P.settingText = false
				txt = P.search.Text
			end
			if not P.view or P.view.input then return end
			P.query = txt
			P.page = 1
			render(false)
		end)
		P.search.Focused:Connect(function()
			P.typing = true
			P.focusAt = os.clock()
			tween(P.searchSt, { Transparency = 0.35 }, 0.2)
		end)
		P.search.FocusLost:Connect(function(enter)
			P.typing = false
			tween(P.searchSt, { Transparency = 0.85 }, 0.25)
			local v = P.view
			if not P.open or not v then return end
			if v.input then
				if enter then
					local txt = P.search.Text
					pcall(v.input.submit, txt)
					popView()
				end
				return
			end
			if enter then pick(1) end
		end)

		-- les 10 cases, réparties en cercle (1 en haut, sens horaire)
		for i = 1, PER do
			local ang = math.rad(-90 + (i - 1) * 36)
			local pos = UDim2.fromOffset(math.cos(ang) * RING_R, math.sin(ang) * RING_R)
			local btn = new("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = pos,
				Size = UDim2.fromOffset(120, 38), BackgroundColor3 = T.Second, BackgroundTransparency = 0.06, Text = "",
				AutoButtonColor = false, BorderSizePixel = 0, Visible = false, ZIndex = 5 }, P.root)
			corner(btn, 10)
			local st = new("UIStroke", { Color = T.Accent, Thickness = 1, Transparency = 0.7, ApplyStrokeMode = BORDER }, btn)
			local sc = new("UIScale", { Scale = 1 }, btn)
			local badge = new("Frame", { Position = UDim2.fromOffset(7, 9), Size = UDim2.fromOffset(20, 20),
				BackgroundColor3 = T.Accent, BackgroundTransparency = 0.88, BorderSizePixel = 0, ZIndex = 6 }, btn)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, badge)
			local num = new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = tostring(i % 10),
				TextColor3 = T.Text, TextSize = 11, Font = F_BOLD, TextXAlignment = CENTER, ZIndex = 7 }, badge)
			local name = new("TextLabel", { Position = UDim2.fromOffset(34, 4), Size = UDim2.fromOffset(78, 16),
				BackgroundTransparency = 1, Text = "", TextColor3 = T.Text, TextSize = 12, Font = F_BOLD,
				TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6 }, btn)
			local sub = new("TextLabel", { Position = UDim2.fromOffset(34, 20), Size = UDim2.fromOffset(78, 14),
				BackgroundTransparency = 1, Text = "", TextColor3 = T.ElementAccent, TextSize = 10, Font = F_MED,
				TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6 }, btn)
			local dot = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6),
				Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.Accent, BorderSizePixel = 0, Visible = false,
				ZIndex = 6 }, btn)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)

			local slot = { btn = btn, st = st, sc = sc, badge = badge, num = num, name = name, sub = sub, dot = dot, pos = pos }
			P.slots[i] = slot
			btn.MouseEnter:Connect(function()
				tween(st, { Transparency = 0.08 }, 0.15)
				tween(sc, { Scale = 1.07 }, 0.2, BACK)
				local it = P.shown[i]
				if it then
					setHint(tostring(it.Tab or "") .. " · " .. tostring(it.Block or "") .. " · " .. it.Name)
				end
			end)
			btn.MouseLeave:Connect(function()
				local it = P.shown[i]
				tween(st, { Transparency = (it and it.On) and 0.3 or 0.7 }, 0.2)
				tween(sc, { Scale = 1 }, 0.2)
				setHint(nil)
			end)
			btn.MouseButton1Click:Connect(function() pick(i) end)
		end
	end

	local function applyColors()
		P.disc.BackgroundColor3 = T.Main
		P.hub.BackgroundColor3 = T.Main
		P.ring1St.Color, P.ring2St.Color, P.hubSt.Color, P.searchSt.Color = T.Accent, T.Accent, T.Accent, T.Accent
		P.title.TextColor3, P.search.TextColor3, P.hint.TextColor3 = T.Text, T.Text, T.ElementAccent
		P.search.BackgroundColor3 = T.Off
		P.prev.TextColor3, P.next.TextColor3 = T.Text, T.Text
		P.prev.BackgroundColor3, P.next.BackgroundColor3 = T.Main, T.Main
	end

	local function defaultHint()
		local v = P.view
		if not v then return "" end
		if v.hint then return v.hint end
		if P.emptyNow then return "Aucun résultat" end
		if v.root then return "1-0 choisir · Tab filtre · / chercher" end
		return "1-0 choisir · Échap retour"
	end

	setHint = function(txt)
		if P.hint then P.hint.Text = txt or P.flashText or defaultHint() end
	end

	flash = function(text)
		P.flashText = text
		P.flashToken = (P.flashToken or 0) + 1
		local my = P.flashToken
		setHint(nil)
		task.delay(1.6, function()
			if P.flashToken == my then
				P.flashText = nil
				if P.open then setHint(nil) end
			end
		end)
	end

	local function resetQuery()
		P.query = ""
		P.settingText = true
		P.search.Text = ""
		P.settingText = false
	end

	render = function(anim, fly)
		local v = P.view
		if not (v and P.slots[1]) then return end
		local items = visibleItems(v)
		local pages = math.max(1, math.ceil(#items / PER))
		P.page = math.clamp(P.page, 1, pages)
		P.pages = pages
		P.emptyNow = (#items == 0) and not (v.input or v.capture)
		local base = (P.page - 1) * PER
		local animOn = Library.Animations
		for i = 1, PER do
			local it = items[base + i]
			local s = P.slots[i]
			P.shown[i] = it
			if it then
				local was = s.btn.Visible
				s.btn.Visible = true
				s.name.Text = it.Name
				s.sub.Text = it.Sub or ""
				s.name.TextColor3, s.sub.TextColor3 = T.Text, T.ElementAccent
				s.btn.BackgroundColor3 = it.Armed and Color3.fromRGB(110, 32, 38) or T.Second
				s.st.Color = it.Armed and Color3.fromRGB(255, 77, 94) or T.Accent
				s.st.Transparency = it.On and 0.3 or 0.7
				s.dot.Visible = it.On ~= nil
				s.dot.BackgroundColor3 = it.On and T.Accent or T.Off
				if it.Color then
					local c = it.Color
					s.badge.BackgroundColor3 = c
					s.badge.BackgroundTransparency = 0.05
					s.num.TextColor3 = ((c.R * 0.3 + c.G * 0.59 + c.B * 0.11) > 0.55) and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
				else
					s.badge.BackgroundColor3 = T.Accent
					s.badge.BackgroundTransparency = 0.88
					s.num.TextColor3 = T.Text
				end
				if anim then
					local d = animOn and (i - 1) * 0.018 or 0
					s.btn.Position = fly and UDim2.fromOffset(0, 0) or s.pos
					s.sc.Scale = 0.01
					task.delay(d, function()
						if not P.open then return end
						tween(s.sc, { Scale = 1 }, 0.4, BACK)
						if fly then tween(s.btn, { Position = s.pos }, 0.5, QUINT) end
					end)
				elseif not was then
					s.btn.Position = s.pos
					s.sc.Scale = 1
				end
			else
				s.btn.Visible = false
			end
		end
		local title = v.title or FILTERS[P.filter]
		if pages > 1 then title = title .. "  " .. P.page .. "/" .. pages end
		P.title.Text = title
		P.search.Visible = not v.capture
		P.search.PlaceholderText = v.input and v.input.placeholder or "Rechercher..."
		P.prev.Visible, P.next.Visible = pages > 1, pages > 1
		setHint(nil)
	end

	-- ───────────── Navigation ─────────────
	pushView = function(v)
		P.stack[#P.stack + 1] = P.view
		P.view = v
		P.page = 1
		resetQuery()
		if v.capture then Library._listening = true end
		render(true)
		if v.input then
			P.settingText = true
			P.search.Text = v.input.text or ""
			P.settingText = false
			task.delay(0.06, function()
				if P.open and P.view == v then P.search:CaptureFocus() end
			end)
		end
	end

	popView = function()
		if P.view and P.view.capture then Library._listening = false end
		if #P.stack == 0 then return end
		P.search:ReleaseFocus()
		P.view = table.remove(P.stack)
		P.page = 1
		resetQuery()
		render(true)
	end

	pick = function(i)
		local it = P.shown[i]
		if not (it and it.Run) then return end
		local ok, err = pcall(it.Run, shiftDown())
		if not ok then warn("[Ui-Lib] Palette : " .. tostring(err)) end
	end

	changePage = function(d)
		local v = P.view
		if not v or v.input or v.capture or P.pages <= 1 then return end
		P.page = ((P.page - 1 + d) % P.pages) + 1
		render(true)
	end

	cycleFilter = function(d)
		local v = P.view
		if not v or not v.root then return end
		P.filter = ((P.filter - 1 + d) % #FILTERS) + 1
		P.page = 1
		render(true)
	end

	focusSearch = function()
		local v = P.view
		if not v or v.input or v.capture then return end
		P.focusAt = os.clock()
		task.defer(function()
			if P.open then P.search:CaptureFocus() end
		end)
	end

	escape = function()
		if os.clock() - (P.lastEsc or 0) < 0.15 then return end
		P.lastEsc = os.clock()
		local v = P.view
		if v and (v.input or v.capture or #P.stack > 0) then
			popView()
		elseif P.query ~= "" then
			P.search:ReleaseFocus()
			resetQuery()
			P.page = 1
			render(false)
		else
			Library:ClosePalette()
		end
	end

	local function casHandler(_, state, input)
		if not P.open then return PASS end
		local ut, kc = input.UserInputType, input.KeyCode
		if ut == Enum.UserInputType.MouseWheel then
			changePage(input.Position.Z > 0 and -1 or 1)
			return SINK
		end
		if state ~= Enum.UserInputState.Begin then return SINK end
		if P.view and P.view.capture then
			if kc == KC.Escape then escape() return SINK end
			return PASS
		end
		local n = DIGIT[kc]
		if n then
			pick(n)
		elseif kc == KC.Tab then
			cycleFilter(shiftDown() and -1 or 1)
		elseif kc == KC.Left then
			changePage(-1)
		elseif kc == KC.Right then
			changePage(1)
		elseif kc == KC.Backspace then
			if #P.stack > 0 then popView() end
		elseif kc == KC.Slash then
			focusSearch()
		elseif kc == KC.Escape then
			escape()
		end
		return SINK
	end

	-- ───────────── Ouverture / fermeture ─────────────
	local function stopSpin()
		for _, tw in ipairs(seqSpin) do pcall(function() tw:Cancel() end) end
		table.clear(seqSpin)
	end

	function Library:OpenPalette()
		if P.open or not Library.PaletteEnabled then return end
		buildGui()
		P.open = true
		P.stack = {}
		P.filter = P.filter or 1
		P.view = rootView()
		P.page = 1
		P.armedKey = nil
		P.flashText = nil
		P.gui.Enabled = true
		applyColors()
		resetQuery()

		local vp = viewport()
		P.rootScale.Scale = math.clamp(math.min((vp.Y - 30) / 480, (vp.X - 30) / 560), 0.5, 1.15)

		P.dim.BackgroundTransparency = 1
		tween(P.dim, { BackgroundTransparency = 0.45 }, 0.3)
		if (Library.BlurSize or 0) > 0 then pcall(setBlurTarget, Library.BlurSize * 0.7) end

		P.coreScale.Scale = 0
		tween(P.coreScale, { Scale = 1 }, 0.55, BACK)

		stopSpin()
		P.g1.Rotation, P.g2.Rotation, P.g3.Rotation = 0, 0, 0
		seqSpin[1] = TweenService:Create(P.g1, TweenInfo.new(7, LINEAR, OUT, -1), { Rotation = 360 })
		seqSpin[2] = TweenService:Create(P.g2, TweenInfo.new(11, LINEAR, OUT, -1), { Rotation = -360 })
		seqSpin[3] = TweenService:Create(P.g3, TweenInfo.new(4.5, LINEAR, OUT, -1), { Rotation = 360 })
		for _, tw in ipairs(seqSpin) do tw:Play() end

		-- on bloque les touches du jeu (chiffres, Tab, flèches, molette...) et on garde le curseur libre
		pcall(function() CAS:BindActionAtPriority("UiLibPalette", casHandler, false, 3000, table.unpack(CAS_KEYS)) end)
		pcall(function()
			RunService:BindToRenderStep("UiLibPaletteMouse", Enum.RenderPriority.Camera.Value + 10, function()
				UIS.MouseBehavior = Enum.MouseBehavior.Default
				UIS.MouseIconEnabled = true
			end)
		end)

		render(true, true)
	end

	function Library:ClosePalette()
		if not P.open then return end
		P.open = false
		pcall(function() CAS:UnbindAction("UiLibPalette") end)
		pcall(function() RunService:UnbindFromRenderStep("UiLibPaletteMouse") end)
		if P.view and P.view.capture then Library._listening = false end
		P.typing = false
		if P.search then P.search:ReleaseFocus() end
		stopSpin()

		-- tout est aspiré vers le centre
		for i, s in ipairs(P.slots) do
			if s.btn.Visible then
				local d = Library.Animations and (i - 1) * 0.012 or 0
				task.delay(d, function()
					if P.open then return end
					tween(s.btn, { Position = UDim2.fromOffset(0, 0) }, 0.3, QUINT, IN)
					tween(s.sc, { Scale = 0 }, 0.3, QUINT, IN)
				end)
			end
		end
		task.delay(0.12, function()
			if not P.open then tween(P.coreScale, { Scale = 0 }, 0.3, QUINT, IN) end
		end)
		tween(P.dim, { BackgroundTransparency = 1 }, 0.35)
		local w = Library.Window
		pcall(setBlurTarget, (w and w.Open) and Library.BlurSize or 0)
		task.delay(0.5 / math.max(Library.AnimSpeed or 1, 0.05), function()
			if not P.open and P.gui then P.gui.Enabled = false end
		end)
	end

	function Library:TogglePalette()
		if P.open then Library:ClosePalette() else Library:OpenPalette() end
	end
	function Library:IsPaletteOpen() return P.open end
	function Library:SetPaletteEnabled(v)
		Library.PaletteEnabled = v and true or false
		if not Library.PaletteEnabled then Library:ClosePalette() end
	end
	function Library:SetPaletteKey(key, needCtrl)
		if typeof(key) == "EnumItem" then Library.PaletteKey = key end
		if needCtrl ~= nil then Library.PaletteNeedCtrl = needCtrl and true or false end
	end

	track(UIS.InputBegan:Connect(function(i, processed)
		if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local kc = i.KeyCode
		if P.open then
			local capturing = P.view and P.view.capture
			if kc == Library.PaletteKey and not capturing and (not Library.PaletteNeedCtrl or ctrlDown())
				and not (P.typing and not ctrlDown()) then
				Library:ClosePalette()
				return
			end
			if capturing then
				if kc ~= KC.Escape then
					local cap = P.view.capture
					popView()
					cap(kc)
				end
				return
			end
			if kc == KC.Escape then escape() end
			return
		end
		if processed or Library._listening or not Library.PaletteEnabled then return end
		if kc == Library.PaletteKey and (not Library.PaletteNeedCtrl or ctrlDown()) then
			Library:OpenPalette()
		end
	end))

	-- nettoyage complet (Library:Destroy)
	Library._destroyPalette = function()
		P.open = false
		pcall(function() CAS:UnbindAction("UiLibPalette") end)
		pcall(function() RunService:UnbindFromRenderStep("UiLibPaletteMouse") end)
		stopSpin()
		if P.gui then pcall(function() P.gui:Destroy() end) end
		P.gui, P.slots, P.shown, P.stack, P.view = nil, {}, {}, {}, nil
	end
end

-- ============================================================================
-- V7 : BARRE DE RECHERCHE « TROU NOIR »  (Ctrl+T)
--   Une barre de recherche façon Google / Spotlight au milieu de l'écran, SANS la fenêtre : juste le fond noir,
--   un trou noir et des étoiles qui spiralent vers lui. En tapant, les résultats apparaissent avec leurs vrais
--   contrôles (interrupteur, curseur, bouton, liste, champ, couleur, touche) que tu règles directement.
--     Ctrl+T : ouvrir / fermer   ·   Entrée : lance / bascule le premier résultat   ·   Échap : efface puis ferme
--   API : Library:OpenSpotlight() / CloseSpotlight() / ToggleSpotlight() / SetSpotlightEnabled(v) /
--         SetSpotlightKey(KeyCode, needCtrl)
--   Options : Library.SpotlightStars (0-140) / SpotlightMax (3-14) / SpotlightHideWindow / SpotlightNeedCtrl / SpotlightKey
--   Les éléments { Palette = false } sont exclus (comme dans la palette Ctrl+K).
-- ============================================================================
local spotOk, spotErr = pcall(function()
	local CAS = game:GetService("ContextActionService")
	local KC = Enum.KeyCode
	local SINK, PASS = Enum.ContextActionResult.Sink, Enum.ContextActionResult.Pass
	local IN = Enum.EasingDirection.In

	Library.SpotlightEnabled    = true
	Library.SpotlightNeedCtrl   = true
	Library.SpotlightKey        = KC.T
	Library.SpotlightStars      = 70
	Library.SpotlightHideWindow = true
	Library.SpotlightMax        = 8

	local S = { open = false, rows = {}, recent = {} }
	local BUILD = {}
	local PRESET_COLORS = {
		Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 77, 94), Color3.fromRGB(255, 150, 60),
		Color3.fromRGB(255, 214, 80), Color3.fromRGB(61, 220, 151), Color3.fromRGB(80, 220, 235),
		Color3.fromRGB(80, 130, 255), Color3.fromRGB(160, 100, 255), Color3.fromRGB(255, 110, 200),
	}

	-- ───────────── Outils ─────────────
	local function low(s)
		if s == nil then return "" end
		return string.lower(tostring(s))
	end
	local function ctrlDown() return UIS:IsKeyDown(KC.LeftControl) or UIS:IsKeyDown(KC.RightControl) end
	local function safeGet(it)
		if type(it) ~= "table" or type(it.Get) ~= "function" then return nil end
		local ok, v = pcall(it.Get)
		if ok then return v end
		return nil
	end
	local function pathOf(e)
		local t, b = tostring(e.Tab or ""), tostring(e.Block or "")
		if t ~= "" and b ~= "" and t ~= b then return t .. "  ·  " .. b end
		return (t ~= "") and t or b
	end
	local function remember(e)
		if not (e and e.Key) then return end
		for i = #S.recent, 1, -1 do
			if S.recent[i] == e.Key then table.remove(S.recent, i) end
		end
		table.insert(S.recent, 1, e.Key)
		while #S.recent > 6 do table.remove(S.recent) end
	end

	-- ───────────── Contenu : éléments de l'interface + commandes intégrées ─────────────
	local function builtins()
		return {
			{ Kind = "Action", Name = "Ouvrir l'interface", Tab = "Spotlight", Block = "Interface",
				Extra = "fenêtre menu afficher ui", Opts = { Callback = function()
					S.openAfter = true
					Library:CloseSpotlight()
				end } },
			{ Kind = "Action", Name = "Ouvrir la palette de commandes", Tab = "Spotlight", Block = "Interface",
				Extra = "ctrl k roue", Opts = { Callback = function()
					Library:CloseSpotlight()
					task.delay(0.4, function() Library:OpenPalette() end)
				end } },
			{ Kind = "Action", Name = "Recentrer la fenêtre", Tab = "Spotlight", Block = "Interface",
				Extra = "reset position", Opts = { Callback = function()
					local w = Library.Window
					if w and w.Reset then w:Reset() end
				end } },
			{ Kind = "Action", Name = "Notifications : tout fermer", Tab = "Spotlight", Block = "Notifications",
				Extra = "effacer vider", Opts = { Callback = function() Library:ClearNotifications() end } },
		}
	end

	local function allEntries()
		local list, keep = {}, {}
		for _, e in pairs(Library.CmdEntries) do
			if e.Frame and e.Frame.Parent then list[#list + 1] = e end
		end
		table.sort(list, function(a, b) return (a.Seq or 0) < (b.Seq or 0) end)
		for _, t in ipairs(Library.TxtEntries) do
			if t.Frame and t.Frame.Parent then
				keep[#keep + 1] = t
				local ok, ti, co = pcall(t.Get)
				if ok then
					ti, co = tostring(ti or ""), tostring(co or "")
					t.TitleText, t.BodyText = ti, co
					t.Name = (ti ~= "") and ti or co
					t.Extra = co
					list[#list + 1] = t
				end
			end
		end
		Library.TxtEntries = keep
		return list
	end

	local function scoreOf(e, q, words)
		local n = low(e.Name)
		local hay = n .. " " .. low(e.Tab) .. " " .. low(e.Block) .. " " .. low(e.Extra)
		for _, w in ipairs(words) do
			if not string.find(hay, w, 1, true) then return 0 end
		end
		local s = 1
		local at = string.find(n, q, 1, true)
		if at == 1 then s = 4
		elseif at then s = 3
		elseif string.find(n, words[1], 1, true) then s = 2 end
		if e.Kind == "Text" then s = s - 0.5 end
		if e.Key and Library.Favorites[e.Key] then s = s + 0.25 end
		return s
	end

	local function results(query)
		local max = math.clamp(math.floor(tonumber(Library.SpotlightMax) or 8), 3, 14)
		local q = string.match(low(query), "^%s*(.-)%s*$") or ""
		local list = allEntries()
		local out = {}
		if q == "" then
			local seen = {}
			for _, key in ipairs(S.recent) do
				local e = Library.CmdEntries[key]
				if e and e.Frame and e.Frame.Parent and not seen[key] then
					seen[key] = true
					out[#out + 1] = e
				end
			end
			for _, e in ipairs(list) do
				if #out >= max then break end
				if e.Key and e.Kind ~= "Text" and Library.Favorites[e.Key] and not seen[e.Key] then
					seen[e.Key] = true
					out[#out + 1] = e
				end
			end
			while #out > max do table.remove(out) end
			if #out == 0 then
				for _, b in ipairs(builtins()) do
					if #out < max then out[#out + 1] = b end
				end
				return out, "Suggestions  ·  tape pour chercher un réglage, un bouton, une couleur..."
			end
			return out, "Récents et favoris"
		end
		for _, b in ipairs(builtins()) do list[#list + 1] = b end
		local words = {}
		for w in string.gmatch(q, "%S+") do words[#words + 1] = w end
		local scored = {}
		for idx, e in ipairs(list) do
			local s = scoreOf(e, q, words)
			if s > 0 then scored[#scored + 1] = { e = e, s = s, i = idx } end
		end
		table.sort(scored, function(a, b)
			if a.s ~= b.s then return a.s > b.s end
			return a.i < b.i
		end)
		local total = #scored
		for i = 1, math.min(total, max) do out[i] = scored[i].e end
		local cap
		if total == 0 then
			cap = "Aucun résultat pour « " .. q .. " »"
		elseif total > #out then
			cap = #out .. " sur " .. total .. " résultats  ·  affine ta recherche"
		else
			cap = total .. ((total == 1) and " résultat" or " résultats")
		end
		return out, cap
	end

	-- ───────────── Cartes de résultats ─────────────
	local function newCard(parent, order)
		local f = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundColor3 = T.Second,
			BackgroundTransparency = 0.1, BorderSizePixel = 0, LayoutOrder = order, Active = true }, parent)
		new("UICorner", { CornerRadius = UDim.new(0, 14) }, f)
		local st = new("UIStroke", { Color = T.Accent, Thickness = 1, Transparency = 0.86, ApplyStrokeMode = BORDER }, f)
		new("UIListLayout", { SortOrder = BYORDER }, f)
		local sc = new("UIScale", { Scale = 0 }, f)
		return f, st, sc
