-- Couleurs réellement appliquées sur les instances (permet de les remplacer en direct, une seule passe)
local COLOR_KEYS = { "Main", "Second", "Accent", "Text", "ElementAccent", "Element", "Off", "Panel" }
local appliedC = {}
function snapshotColors()
	for _, k in ipairs(COLOR_KEYS) do appliedC[k] = T[k] end
end
snapshotColors()

local function titleSeq(a)
	local dim = a:Lerp(Color3.new(0, 0, 0), 0.25)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, dim), ColorSequenceKeypoint.new(0.38, dim),
		ColorSequenceKeypoint.new(0.5, a), ColorSequenceKeypoint.new(0.62, dim),
		ColorSequenceKeypoint.new(1, dim),
	})
end
Library._titleSeq = titleSeq
function Library._stretch(s)
	s = tostring(s)
	local out = {}
	for _, c in utf8.codes(s) do out[#out + 1] = utf8.char(c) end
	return table.concat(out, Library.TitleSpacing or " ")
end

-- Transition des couleurs : UNE seule boucle fait glisser toutes les instances concernées vers leur nouvelle couleur
-- (au lieu de milliers de tweens). Si une nouvelle couleur arrive en cours de route (ex. glisser dans le color picker),
-- on repart de la couleur affichée et on vise la nouvelle cible.
local colorAnim, colorAnimMap, colorAnimConn = {}, {}, nil
local COLOR_ANIM_TIME = 0.4
local function colorAnimStep()
	local now = os.clock()
	local dur = COLOR_ANIM_TIME / math.max(Library.AnimSpeed or 1, 0.05)
	local i = 1
	while i <= #colorAnim do
		local e = colorAnim[i]
		local done = false
		if e.fn then
			local a = math.clamp((now - e.t0) / dur, 0, 1)
			pcall(e.fn, TweenService:GetValue(a, Enum.EasingStyle.Quad, OUT), a >= 1)
			done = a >= 1
		elseif not e.d.Parent then
			done = true
		else
			local a = math.clamp((now - e.t0) / dur, 0, 1)
			local k = TweenService:GetValue(a, Enum.EasingStyle.Quad, OUT)
			pcall(function() e.d[e.p] = e.from:Lerp(e.to, k) end)
			done = a >= 1
		end
		if done then
			if not e.fn then
				pcall(function() e.d[e.p] = e.to end)
				local m = colorAnimMap[e.d]
				if m and m[e.p] == e then m[e.p] = nil end
			end
			colorAnim[i] = colorAnim[#colorAnim]
			colorAnim[#colorAnim] = nil
		else
			i += 1
		end
	end
	if #colorAnim == 0 and colorAnimConn then
		colorAnimConn:Disconnect()
		colorAnimConn = nil
	end
end
local function colorAnimStart()
	if not colorAnimConn then colorAnimConn = Ticker.connect(colorAnimStep) end
end
local function colorAnimAdd(d, p, from, to)
	local m = colorAnimMap[d]
	if not m then m = {} colorAnimMap[d] = m end
	local old = m[p]
	if old then old.to = to old.from = from old.t0 = os.clock() return end
	local e = { d = d, p = p, from = from, to = to, t0 = os.clock() }
	m[p] = e
	colorAnim[#colorAnim + 1] = e
end

local gradAcc   -- accent actuellement affiché sur les dégradés (pour repartir de là si ça change en cours de route)
local function applyColorsNow(instant)
	local anim = Library.Animations and not instant
	local list = {}
	for _, k in ipairs(COLOR_KEYS) do
		local o, n = appliedC[k], T[k]
		if o and n and not nearColor(o, n) then list[#list + 1] = { o, n } end
	end
	if #list > 0 then
		for _, root in ipairs(guiRoots()) do
			for _, d in ipairs(root:GetDescendants()) do
				local props = ACC_PROPS[d.ClassName]
				if props then
					local m = colorAnimMap[d]
					for _, p in ipairs(props) do
						local ok, cur = pcall(function() return d[p] end)
						if ok and typeof(cur) == "Color3" then
							local ref = (m and m[p]) and m[p].to or cur   -- si une transition est en cours : on compare à sa cible
							for _, pr in ipairs(list) do
								if nearColor(ref, pr[1]) then
									if not noAccent(d, root) then
										if anim then colorAnimAdd(d, p, cur, pr[2])
										else
											d[p] = pr[2]
											if m and m[p] then m[p].to = pr[2] m[p].from = pr[2] end
										end
									end
									break
								end
							end
						end
					end
				end
			end
		end
	end
	snapshotColors()
	-- dégradés (anneaux du trou noir, bordure, logo, titre) : suivent la couleur d'accent
	local newAcc = T.Accent
	local function paintGrad(a)
		local dim = a:Lerp(Color3.new(0, 0, 0), 0.55)
		for _, sp in ipairs(spinners) do
			if sp.g and sp.g.Parent then sp.g.Color = ColorSequence.new(a, dim) end
		end
		if Library._titleGrad and Library._titleGrad.Parent then
			Library._titleGrad.Color = Library._titleSeq(a)
		end
	end
	if anim and gradAcc and not nearColor(gradAcc, newAcc) then
		local fromAcc = gradAcc
		for j = #colorAnim, 1, -1 do   -- une seule animation de dégradé à la fois
			if colorAnim[j].grad then table.remove(colorAnim, j) end
		end
		colorAnim[#colorAnim + 1] = { grad = true, t0 = os.clock(), fn = function(k, done)
			gradAcc = done and newAcc or fromAcc:Lerp(newAcc, k)
			paintGrad(gradAcc)
		end }
	else
		gradAcc = newAcc
		paintGrad(newAcc)
	end
	if #colorAnim > 0 then colorAnimStart() end
end

local colorToken = 0
local function scheduleColors(immediate)
	colorToken += 1
	local my = colorToken
	if immediate then applyColorsNow(true) return end
	task.delay(0.06, function()
		if my == colorToken then applyColorsNow() end
	end)
end

function toColor3(v)
	if typeof(v) == "Color3" then return v end
	if type(v) == "string" then
		local ok, c = pcall(Color3.fromHex, (string.gsub(v, "#", "")))
		if ok and typeof(c) == "Color3" then return c end
	end
	return nil
end

-- Library:SetColors({ Main=, Second=, Accent=, Text=, ElementAccent= })  (Color3 ou "#RRGGBB"), appliqué en direct
function Library:SetColors(tbl, immediate)
	if type(tbl) ~= "table" then return end
	for k, v in pairs(tbl) do
		local c = toColor3(v)
		if c and (k == "Main" or k == "Second" or k == "Accent" or k == "Text" or k == "ElementAccent") then
			T[k] = c
		end
	end
	refreshTheme()
	scheduleColors(immediate)
	if Library._onColors then pcall(Library._onColors) end
end
end -- fin de la portée réduite
function Library:SetColor(k, c) Library:SetColors({ [k] = c }) end
function Library:SetAccent(c) Library:SetColor("Accent", c) end

