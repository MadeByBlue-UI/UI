		BackgroundTransparency = 1, BorderSizePixel = 0, Image = Library.NotifLogo or NOTIF_LOGO, ScaleType = Enum.ScaleType.Fit }, ico)
	label(card, "Notification test", 14, { Font = F_BOLD, Position = UDim2.fromOffset(56, 13), Size = UDim2.new(1, -72, 0, 18) })
	label(card, "Les notifications apparaîtront ici.", 12, { Position = UDim2.fromOffset(56, 33), Size = UDim2.new(1, -72, 0, 16),
		TextColor3 = T.ElementAccent })

	local function btn(text, x, wd)
		local b = new("TextButton", { Position = UDim2.new(0, x, 1, -38), Size = UDim2.fromOffset(wd, 26),
			BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, Text = text, TextColor3 = T.Text, TextSize = 12,
			Font = F_MED, AutoButtonColor = false, BorderSizePixel = 0 }, card)
		new("UICorner", { CornerRadius = UDim.new(0, 13) }, b)
		b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.76 }, 0.15) end)
		b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = 0.9 }, 0.2) end)
		return b
	end
	local bw = math.floor((w - 28 - 12) / 3)
	local okB = btn("Valider", 14, bw)
	okB.BackgroundColor3, okB.BackgroundTransparency, okB.TextColor3 = T.Accent, 0.1, T.Main
	local resetB = btn("Défaut", 14 + bw + 6, bw)
	local cancelB = btn("Annuler", 14 + (bw + 6) * 2, bw)

	local closing = false
	local function close()
		if closing then return end
		closing = true
		tween(dim, { BackgroundTransparency = 1 }, 0.25)
		tween(hint, { TextTransparency = 1 }, 0.2)
		tween(sc, { Scale = 0.85 }, 0.25)
		tween(card, { BackgroundTransparency = 1 }, 0.25)
		tween(cst, { Transparency = 1 }, 0.25)
		task.delay(0.3, function() gui:Destroy() end)
	end

	card.InputBegan:Connect(function(i)
		if not isPress(i) or closing then return end
		local start = Vector2.new(i.Position.X, i.Position.Y)
		local origin = pos
		tween(cst, { Transparency = 0.05 }, 0.15)
		startDrag(function(p)
			pos = clampPos(origin + (Vector2.new(p.X, p.Y) - start))
			card.Position = UDim2.fromOffset(pos.X, pos.Y)
		end, nil, i.Position, function() tween(cst, { Transparency = 0.35 }, 0.25) end)
	end)

	okB.MouseButton1Click:Connect(function()
		local l, t = pos.X < vp.X / 2, pos.Y < vp.Y / 2
		local x = l and (pos.X - w / 2) or (pos.X + w / 2)
		local y = t and (pos.Y - h / 2) or (pos.Y + h / 2)
