	local glintTw
	local function refreshGlass()
		sheen.Visible = Sty.Glass == true
		if glintTw then
			glintTw:Cancel()
			glintTw = nil
		end
		local show = Sty.Glass == true and Library.Animations
		glint.Visible = show and true or false
		if show then
			glintGrad.Offset = Vector2.new(-1, 0)
			glintTw = TweenService:Create(glintGrad,
				TweenInfo.new(5.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false, 2.5),
				{ Offset = Vector2.new(1, 0) })
			glintTw:Play()
		end
	end
	function win:ApplyStyle()
		win:SetOpacity(win.Opacity)
