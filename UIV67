local function themeDir() return Library.ConfigFolder .. "/Themes" end

function Library:ListThemes()
	local out = {}
	pcall(function()
		if listfiles and isfolder and isfolder(themeDir()) then
			for _, p in ipairs(listfiles(themeDir())) do
				local n = tostring(p):match("([^/\\]+)%.json$")
				if n then out[#out + 1] = n end
			end
		end
	end)
	table.sort(out)
	return out
end

function Library:SaveTheme(name)
	name = safeName(name)
	if name == "" then return false, "nom vide" end
	if not writefile then return false, "writefile indisponible" end
	pcall(function()
		if makefolder and isfolder then
			if not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
			if not isfolder(themeDir()) then makefolder(themeDir()) end
		end
	end)
	local ok, err = pcall(function()
		writefile(themeDir() .. "/" .. name .. ".json", HttpService:JSONEncode(Library:GetTheme()))
	end)
	return ok, err
end

function Library:LoadTheme(name)
	name = safeName(name)
	if name == "" then return false, "nom vide" end
	if not (readfile and isfile) then return false, "readfile indisponible" end
	local path = themeDir() .. "/" .. name .. ".json"
	if not isfile(path) then return false, "introuvable" end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "fichier invalide" end
	return Library:ApplyTheme(data)
end

function Library:DeleteTheme(name)
	name = safeName(name)
	if name == "" or not delfile then return false end
	return (pcall(function() delfile(themeDir() .. "/" .. name .. ".json") end))
end

function Library:ExportTheme()
	return "UILIB-THEME:" .. HttpService:JSONEncode(Library:GetTheme())
end

function Library:ImportTheme(str)
	str = tostring(str or "")
	str = string.gsub(str, "^%s+", "")
	str = string.gsub(str, "^UILIB%-THEME:", "")
	str = string.gsub(str, "%s+$", "")
	local ok, data = pcall(function() return HttpService:JSONDecode(str) end)
	if not ok or type(data) ~= "table" then return false, "code invalide" end
	if type(data.Colors) ~= "table" then return false, "ce n'est pas un thème" end
	return Library:ApplyTheme(data)
end

