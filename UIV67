			tween(knob, { Position = v and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
				BackgroundColor3 = v and T.Main or T.Text }, t, BACK)
		end
		local function flip()
			local cur = safeGet(it) and true or false
			pcall(it.Set, it, not cur)
			paint(not cur)
			remember(e)
		end
		local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
			AutoButtonColor = false }, hdr)
		hit.MouseButton1Click:Connect(function() flip() uiSnd(safeGet(it) and "on" or "off") end)
		paint(safeGet(it) and true or false, true)
		return flip
	end

	BUILD.Button = function(f, e)
		local o = e.Opts or {}
		local hdr = newHeader(f, e, 108)
		local pill = new("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(94, 26), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, Text = "Lancer",
			TextColor3 = T.Text, TextSize = 12, Font = F_BOLD, BorderSizePixel = 0 }, hdr)
		round(pill, 1)
		local armed, tok = false, 0
		local function run()
			if o.Confirm and not armed then
				armed = true
				tok += 1
				local my = tok
				pill.Text = "Confirmer ?"
				tween(pill, { BackgroundColor3 = Color3.fromRGB(150, 45, 45), BackgroundTransparency = 0.2 }, 0.2)
				task.delay(3, function()
					if armed and tok == my and pill.Parent then
						armed = false
						pill.Text = "Lancer"
						tween(pill, { BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9 }, 0.3)
					end
				end)
				return
			end
			armed = false
			tok += 1
			fire(o.Callback)
			remember(e)
			pill.Text = "Lancé"
			pill.BackgroundColor3 = T.Accent
			pill.BackgroundTransparency = 0.55
			tween(pill, { BackgroundTransparency = 0.9 }, 0.7)
			task.delay(1.1, function()
				if pill.Parent and not armed then pill.Text = "Lancer" end
			end)
		end
		local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
			AutoButtonColor = false }, hdr)
		hit.MouseButton1Click:Connect(function() uiSnd("click") run() end)
