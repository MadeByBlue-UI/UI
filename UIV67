function Library:GetGuiParent()
    if gethui_fn then
        local ok, result = pcall(gethui_fn)
        if ok and result then
            return result
        end
    end
    local ok = pcall(function()
        return CoreGui.Name
    end)
    if ok then
        return CoreGui
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

function Library:BuildScreenGui()
    local gui = Instance.new("ScreenGui")
    gui.Name = "Singularity_" .. HttpService:GenerateGUID(false):sub(1, 8)
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(protect_gui, gui)
    gui.Parent = self:GetGuiParent()
    self.ScreenGui = gui

    -- UIScale lives on the ScreenGui. Root compensates with 1/scale so that
    -- everything inside it keeps filling the real screen at any DPI scale.
    self.Scale = Instance.new("UIScale")
    self.Scale.Scale = self.DPIScale
    self.Scale.Parent = gui

    self.Root = self:Create("Frame", {
        Name = "Root",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1 / self.DPIScale, 1 / self.DPIScale),
        ZIndex = 1,
        Parent = gui,
    })

    self.PopupLayer = self:Create("Frame", {
        Name = "Popups",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 500,
        Parent = self.Root,
    })

    self.NotificationLayer = self:Create("Frame", {
        Name = "Notifications",
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 320, 1, -24),
        Position = UDim2.new(1, -332, 0, 12),
        ZIndex = 800,
        Parent = self.Root,
    })
    self.NotificationList = self:AddList(self.NotificationLayer, 8, Enum.FillDirection.Vertical,
        Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Top)

    self.DialogLayer = self:Create("Frame", {
        Name = "Dialogs",
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        Active = true,
        ZIndex = 700,
        Parent = self.Root,
    })

    return gui
end

function Library:SetDPIScale(scale)
    scale = math.clamp(scale, 0.5, 2)
    self.DPIScale = scale
    if self.Scale then
        self.Scale.Scale = scale
    end
    if self.Root then
        self.Root.Size = UDim2.fromScale(1 / scale, 1 / scale)
    end
end

Library.Corners = {}

--- Corner that follows Library.CornerRadius (UI Settings slider).
function Library:AddThemedCorner(parent, factor)
    local corner = self:AddCorner(parent, math.floor(self.CornerRadius * (factor or 1)))
    corner:SetAttribute("Factor", factor or 1)
    table.insert(self.Corners, corner)
    return corner
end

function Library:SetCornerRadius(radius)
    self.CornerRadius = radius
    for i = #self.Corners, 1, -1 do
        local corner = self.Corners[i]
        if corner.Parent then
            corner.CornerRadius = UDim.new(0, math.floor(radius * (corner:GetAttribute("Factor") or 1)))
        else
            table.remove(self.Corners, i)
        end
    end
end

