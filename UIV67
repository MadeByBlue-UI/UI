	local f, st = makeRow(self, h + 34, o.Name)
	label(f, o.Name or "TextArea", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 0, 28) })
	local tb = new("TextBox", {
		Position = UDim2.new(0, 8, 0, 28), Size = UDim2.new(1, -16, 0, h), BackgroundColor3 = T.Off,
		BackgroundTransparency = 0.4, BorderSizePixel = 0, Text = o.Default and tostring(o.Default) or "",
		PlaceholderText = o.Placeholder or o.PlaceholderText or "", PlaceholderColor3 = Color3.fromRGB(125, 125, 132),
		TextColor3 = T.Text, TextSize = 12, Font = F_REG, ClearTextOnFocus = false, MultiLine = true,
		TextWrapped = true, TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top,
		TextEditable = o.ReadOnly ~= true,
	}, f)
	corner(tb, 6)
	local tst = stroke(tb, 0.9)
	trackStyled(tb, tst, "input")
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6) }, tb)
	Library._attachTextFade(tb)
	hover(f, st)
	tb.Focused:Connect(function() uiSnd("focus") tween(tst, { Transparency = 0.35 }, 0.2) end)
	tb.FocusLost:Connect(function()
		tween(tst, { Transparency = Sty.InputStroke }, 0.3)
		fire(o.Callback, tb.Text)
	end)
	tb:GetPropertyChangedSignal("Text"):Connect(function()
		local ml = tonumber(o.MaxLength)
		if ml and #tb.Text > ml then tb.Text = string.sub(tb.Text, 1, ml) return end
		if o.Flag then Library.Flags[o.Flag] = tb.Text end
		if o.LiveUpdate then fire(o.Callback, tb.Text) end
	end)
	local item = {}
	item.Set = function(...)
		tb.Text = tostring((unself(item, ...)) or "")
		fire(o.Callback, tb.Text)
	end
	item.SetText = item.Set
	item.Get = function() return tb.Text end
	item.Instance = tb
	register(o.Flag, item, tb.Text)
	return item
end

-- Contrôle segmenté (une seule option active)
function Block:CreateRadio(o)
	o = o or {}
	local items = o.Items or o.Options or {}
	local n = math.max(#items, 1)
	local f, st = makeRow(self, 62, o.Name)
	label(f, o.Name or "Radio", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 0, 28) })
	local bar = new("Frame", { Position = UDim2.new(0, 8, 0, 29), Size = UDim2.new(1, -16, 0, 26),
		BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0 }, f)
	corner(bar, 7)
	trackStyled(bar, stroke(bar, 0.9), "input")
	local hl = new("Frame", { Size = UDim2.new(1 / n, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2),
		BackgroundColor3 = T.Accent, BackgroundTransparency = 0.8, BorderSizePixel = 0 }, bar)
	corner(hl, 5)
	hover(f, st)
	local btns, cur = {}, nil
	local function indexOf(v)
		if type(v) == "number" and items[v] ~= nil then return v end
		for i, it in ipairs(items) do
			if tostring(it) == tostring(v) then return i end
		end
		return nil
	end
	local function select(i, silent)
		if not i or not items[i] then return end
		cur = i
		tween(hl, { Position = UDim2.new((i - 1) / n, 2, 0, 2) }, 0.28)
		for k, b in ipairs(btns) do
			tween(b, { TextColor3 = (k == i) and T.Text or T.ElementAccent }, 0.2)
		end
		if o.Flag then Library.Flags[o.Flag] = tostring(items[i]) end
		if not silent then fire(o.Callback, items[i], i) end
	end
	for i, it in ipairs(items) do
		local b = new("TextButton", { Position = UDim2.new((i - 1) / n, 0, 0, 0), Size = UDim2.new(1 / n, 0, 1, 0),
			BackgroundTransparency = 1, Text = tostring(it), TextColor3 = T.ElementAccent, TextSize = 12, Font = F_MED,
			AutoButtonColor = false, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2 }, bar)
		b.MouseButton1Click:Connect(function()
			if cur ~= i then uiSnd("click") select(i) end
		end)
		btns[i] = b
	end
	local start = indexOf(o.Default) or 1
	hl.Position = UDim2.new((start - 1) / n, 2, 0, 2)
	select(start, true)
	local item = {}
	item.Set = function(...)
		local i = indexOf((unself(item, ...)))
		if i then select(i) end
	end
	item.Get = function() return items[cur] end
	item.GetIndex = function() return cur end
	item.Instance = f
	register(o.Flag, item, tostring(items[start]))
	return item
end

-- Tableau / liste triable (clic sur un en-tête = tri, clic sur une ligne = sélection)
function Block:CreateTable(o)
	o = o or {}
	local cols = (type(o.Columns) == "table" and #o.Columns > 0) and o.Columns or { "Nom" }
	local nc = #cols
	local rows = {}
	for i, r in ipairs(o.Rows or {}) do rows[i] = (type(r) == "table") and r or { r } end
	local maxRows = math.clamp(tonumber(o.MaxRows) or 6, 2, 14)
	local ROW_H, HEAD_H = 22, 24
	local f, st = makeRow(self, 30 + HEAD_H + maxRows * ROW_H + 8, o.Name)
	label(f, o.Name or "Table", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 0, 28) })
	local box = new("Frame", { Position = UDim2.new(0, 8, 0, 28), Size = UDim2.new(1, -16, 1, -36),
		BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0, ClipsDescendants = true }, f)
	corner(box, 6)
	trackStyled(box, stroke(box, 0.9), "input")
	local head = new("Frame", { Size = UDim2.new(1, 0, 0, HEAD_H), BackgroundTransparency = 1 }, box)
	local sf = new("ScrollingFrame", { Position = UDim2.new(0, 0, 0, HEAD_H), Size = UDim2.new(1, 0, 1, -HEAD_H),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = AY, ScrollBarImageColor3 = T.Accent }, box)
	new("UIListLayout", { SortOrder = BYORDER }, sf)
	hover(f, st)

	local sortCol, sortAsc, selected = nil, true, nil
	local headBtns = {}
	local rebuild

	local function cmp(a, b)
		local x, y = a[sortCol], b[sortCol]
		local nx, ny = tonumber(x), tonumber(y)
		local r
		if nx and ny then r = nx < ny
		else r = string.lower(tostring(x or "")) < string.lower(tostring(y or "")) end
		if sortAsc then return r end
		if nx and ny then return nx > ny end
		return string.lower(tostring(x or "")) > string.lower(tostring(y or ""))
	end

	for c = 1, nc do
		local hb = new("TextButton", { Position = UDim2.new((c - 1) / nc, 0, 0, 0), Size = UDim2.new(1 / nc, 0, 1, 0),
			BackgroundTransparency = 1, Text = tostring(cols[c]), TextColor3 = T.ElementAccent, TextSize = 11,
			Font = F_BOLD, AutoButtonColor = false, TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd }, head)
		new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 4) }, hb)
		hb.MouseButton1Click:Connect(function()
			if o.Sortable == false then return end
			uiSnd("click")
			if sortCol == c then sortAsc = not sortAsc else sortCol, sortAsc = c, true end
			rebuild()
		end)
		headBtns[c] = hb
	end
	fadeLine(head, { Position = UDim2.new(0, 6, 1, -1), Size = UDim2.new(1, -12, 0, 1) })

	local function view()
		local v = {}
		for i, r in ipairs(rows) do v[i] = r end
		if sortCol then table.sort(v, cmp) end
		return v
	end

	rebuild = function()
		for _, ch in ipairs(sf:GetChildren()) do
			if ch:IsA("GuiObject") then ch:Destroy() end
		end
		for c = 1, nc do
			headBtns[c].Text = tostring(cols[c]) .. ((sortCol == c) and (sortAsc and "  ^" or "  v") or "")
		end
		for i, r in ipairs(view()) do
			local isSel = (r == selected)
			local rb = new("TextButton", { Size = UDim2.new(1, 0, 0, ROW_H), LayoutOrder = i, BorderSizePixel = 0,
				BackgroundColor3 = T.Accent, BackgroundTransparency = isSel and 0.84 or 1, Text = "", AutoButtonColor = false }, sf)
			for c = 1, nc do
				label(rb, tostring(r[c] == nil and "" or r[c]), 12, { Position = UDim2.new((c - 1) / nc, 8, 0, 0),
					Size = UDim2.new(1 / nc, -10, 1, 0), TextColor3 = isSel and T.Text or T.ElementAccent, Font = F_REG })
			end
			rb.MouseEnter:Connect(function() if r ~= selected then tween(rb, { BackgroundTransparency = 0.93 }, 0.15) end end)
			rb.MouseLeave:Connect(function() if r ~= selected then tween(rb, { BackgroundTransparency = 1 }, 0.2) end end)
			rb.MouseButton1Click:Connect(function()
				uiSnd("click")
				selected = (selected == r) and nil or r
				rebuild()
				fire(o.Callback, selected, selected and table.find(rows, selected) or nil)
			end)
		end
		if o.Flag then Library.Flags[o.Flag] = rows end
	end
	rebuild()

	local item = {}
	item.Set = function(...)
		local d = unself(item, ...)
		if type(d) ~= "table" then return end
		rows = {}
		for i, r in ipairs(d) do rows[i] = (type(r) == "table") and r or { r } end
		selected = nil
		rebuild()
	end
	item.SetRows = item.Set
	item.Get = function() return rows end
	item.GetSelected = function() return selected end
	item.AddRow = function(...)
		local r = unself(item, ...)
		rows[#rows + 1] = (type(r) == "table") and r or { r }
		rebuild()
	end
	item.RemoveRow = function(...)
		local i = unself(item, ...)
		if rows[i] then
			if rows[i] == selected then selected = nil end
			table.remove(rows, i)
			rebuild()
		end
	end
	item.Clear = function() rows, selected = {}, nil rebuild() end
	item.Sort = function(...)
		local c, asc = unself(item, ...)
		if tonumber(c) and c >= 1 and c <= nc then
			sortCol, sortAsc = math.floor(c), asc ~= false
			rebuild()
		end
	end
	item.Instance = f
	register(o.Flag, item, rows)
	return item
end

-- Image (rbxassetid://..., ou simple identifiant numérique)
function Block:CreateImage(o)
	if type(o) ~= "table" then o = { Image = o } end
	local function norm(v)
		v = tostring(v or "")
		if string.match(v, "^%d+$") then v = "rbxassetid://" .. v end
		return v
	end
	local cap = o.Name ~= nil and o.Name ~= ""
	local h = math.clamp(tonumber(o.Height) or 120, 24, 400)
	local top = cap and 28 or 6
	local f, st = makeRow(self, h + top + 6, o.Name)
	if cap then label(f, o.Name, 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 0, 28) }) end
	local st_ = (o.ScaleType == "Crop" and Enum.ScaleType.Crop) or (o.ScaleType == "Stretch" and Enum.ScaleType.Stretch)
		or Enum.ScaleType.Fit
	local im = new("ImageLabel", { Position = UDim2.new(0, 8, 0, top), Size = UDim2.new(1, -16, 0, h),
		BackgroundTransparency = 1, Image = norm(o.Image or o.Source), ScaleType = st_,
		ImageColor3 = o.Color or Color3.new(1, 1, 1) }, f)
	corner(im, 6)
	local item = {}
	item.SetImage = function(...) im.Image = norm((unself(item, ...))) end
	item.Set = item.SetImage
	item.Get = function() return im.Image end
	item.SetHeight = function(...)
		local nh = math.clamp(tonumber((unself(item, ...))) or h, 24, 400)
		h = nh
		f.Size = UDim2.new(1, 0, 0, nh + top + 6)
		im.Size = UDim2.new(1, -16, 0, nh)
	end
	item.SetColor = function(...) im.ImageColor3 = (unself(item, ...)) or Color3.new(1, 1, 1) end
	item.Instance = im
	return item
end

