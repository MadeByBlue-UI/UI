	local function makeItem(e)
		local sub, on, col = stateOf(e)
		local armed = (P.armedKey == e.Key)
		local it = {
			Name = e.Name, Sub = armed and "Confirmer ?" or sub, On = on, Color = col, Armed = armed,
			Tab = e.Tab, Block = e.Block, Key = e.Key,
		}
		local k = e.Kind
		it.Run = function(keep)
			if k == "Button" then
				if e.Opts.Confirm and P.armedKey ~= e.Key then
					P.armedKey = e.Key
					flash("Rappuie pour confirmer")
					render(false)
					task.delay(3, function()
						if P.armedKey == e.Key then
							P.armedKey = nil
							if P.open then render(false) end
						end
					end)
					return
				end
				P.armedKey = nil
				fire(e.Opts.Callback)
				flash(e.Name .. " : lancé")
				if keep then render(false) else Library:ClosePalette() end
			elseif k == "Toggle" then
				local cur = safeGet(e.Item) and true or false
				pcall(function() e.Item.Set(not cur) end)
				flash(e.Name .. " : " .. ((not cur) and "ON" or "OFF"))
				render(false)
			elseif k == "Slider" or k == "Stepper" then
				pushView(sliderView(e))
			elseif k == "Dropdown" then
				pushView(dropView(e))
			elseif k == "ColorPicker" then
				pushView(colorView(e))
			elseif k == "Keybind" then
				pushView(keyView(e))
			elseif k == "RangeSlider" then
				local cur = safeGet(e.Item)
				local init = type(cur) == "table" and (tostring(cur.Low) .. " - " .. tostring(cur.High)) or ""
				pushView(textInputView(e, init, "min - max", function(txt)
					local a, b = string.match(txt, "^%s*(-?[%d%.]+)%s*[,;:–%-]%s*(-?[%d%.]+)%s*$")
					a, b = tonumber(a), tonumber(b)
					if a and b then
						pcall(e.Item.Set, e.Item, { a, b })
						flash(e.Name .. " : " .. tostring(a) .. " - " .. tostring(b))
					else
						flash("Format : min - max")
					end
				end))
			elseif k == "Input" then
				pushView(textInputView(e, tostring(safeGet(e.Item) or ""), e.Opts.Placeholder or "Texte", function(txt)
					pcall(function() e.Item.Set(txt) end)
					flash(e.Name .. " : " .. txt)
				end))
			end
		end
		return it
	end

