local function lighten(c, a) return c:Lerp(Color3.new(1, 1, 1), a) end

local T = {
	Main          = Color3.fromRGB(0, 0, 0),
	Second        = Color3.fromRGB(7, 7, 9),
	Accent        = Color3.fromRGB(255, 255, 255),
	ElementAccent = Color3.fromRGB(165, 165, 172),
	Text          = Color3.fromRGB(245, 245, 247),
	GradientStart = Color3.fromRGB(255, 255, 255),
	GradientEnd   = Color3.fromRGB(125, 125, 135),
}
local function refreshTheme()
	T.Element = lighten(T.Second, 0.07)
	T.Off     = lighten(T.Second, 0.20)
	T.Panel   = lighten(T.Second, 0.03)
end
refreshTheme()

-- Raccourcis
local AY      = Enum.AutomaticSize.Y
local AN      = Enum.AutomaticSize.None
local LEFT    = Enum.TextXAlignment.Left
local RIGHT   = Enum.TextXAlignment.Right
local CENTER  = Enum.TextXAlignment.Center
local QUINT   = Enum.EasingStyle.Quint
local BACK    = Enum.EasingStyle.Back
local LINEAR  = Enum.EasingStyle.Linear
local OUT     = Enum.EasingDirection.Out
local F_REG   = Enum.Font.Gotham
local F_MED   = Enum.Font.GothamMedium
local F_BOLD  = Enum.Font.GothamBold
local BYORDER = Enum.SortOrder.LayoutOrder
local BORDER  = Enum.ApplyStrokeMode.Border

local canvasSupported = pcall(function() Instance.new("CanvasGroup"):Destroy() end)

-- ============================================================================
-- OUTILS
-- ============================================================================
local Conns = {}
local function track(c) Conns[#Conns + 1] = c return c end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end

local function tween(o, props, t, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t or 0.25, style or QUINT, dir or OUT), props)
	tw:Play()
	return tw
end

local function corner(parent, base)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, math.floor(base * Library.GlobalCornerValue / 10))
	c.Parent = parent
	table.insert(Library.CornerObjects, { Corner = c, BaseRadius = base })
	return c
end

local function stroke(parent, transparency, thickness)
	return new("UIStroke", {
		Color = T.Accent, Transparency = transparency or 0.9, Thickness = thickness or 1,
		ApplyStrokeMode = BORDER,
	}, parent)
end

local function label(parent, text, size, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Text = tostring(text), TextColor3 = T.Text, TextSize = size or 13,
		Font = F_MED, TextXAlignment = LEFT,
		TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 1, 0),
	})
	for k, v in pairs(props or {}) do l[k] = v end
	l.Parent = parent
	return l
end

-- Appelle un callback sans jamais casser l'UI
local function fire(cb, ...)
	if type(cb) ~= "function" then return end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(cb, table.unpack(args, 1, args.n))
		if not ok then warn("[Ui-Lib] Callback : " .. tostring(err)) end
	end)
end

-- Permet d'appeler item.Set(v) ET item:Set(v)
local function unself(self, ...)
	if (...) == self then return select(2, ...) end
	return ...
end

local function register(flag, item, value)
	if flag then
		Library.Flags[flag] = value
		Library.Items[flag] = item
	end
end

local function mount(gui)
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(gui)
		elseif protectgui then protectgui(gui) end
	end)
	local ok = pcall(function() gui.Parent = CoreGui end)
	if not ok or not gui.Parent then
		gui.Parent = LP:WaitForChild("PlayerGui")
	end
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function guiInset()
	local ok, v = pcall(function() return GuiService:GetGuiInset() end)
	return ok and v or Vector2.new(0, 0)
end

local function viewport()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if v.X < 100 or v.Y < 100 then v = Vector2.new(1280, 720) end
	return v
end

-- Échelle réelle de la fenêtre (UIScale + animation), pour convertir pixels écran <-> pixels UI
local function pxScale()
	local win = Library.Window
	local m = win and win.Main
	if m and m.Size.X.Offset > 0 and m.AbsoluteSize.X > 0 then
		return m.AbsoluteSize.X / m.Size.X.Offset
	end
	return 1
end

-- Gestion centralisée du glisser (sliders, color picker, déplacement de la fenêtre)
local activeDrag, activeEnd, dragScroll
local function startDrag(fn, scroll, pos, onEnd)
	activeDrag, activeEnd = fn, onEnd
	if scroll then dragScroll = scroll scroll.ScrollingEnabled = false end
	fn(pos)
end
track(UIS.InputChanged:Connect(function(i)
	if activeDrag and (i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch) then
		activeDrag(i.Position)
	end
end))
track(UIS.InputEnded:Connect(function(i)
	if activeDrag and (i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch) then
		local e = activeEnd
		activeDrag, activeEnd = nil, nil
		if dragScroll then dragScroll.ScrollingEnabled = true dragScroll = nil end
		if e then e() end
	end
end))

-- Dégradés qui tournent (anneaux du trou noir, bordure de la fenêtre...)
local spinners = {}
local function spin(g, speed)
	spinners[#spinners + 1] = { g = g, speed = speed }
	return g
end

-- Effet de survol fluide sur une ligne
local function hover(f, st, hit)
	hit = hit or f
	hit.MouseEnter:Connect(function()
		tween(f, { BackgroundTransparency = 0.2 }, 0.2)
		if st then tween(st, { Transparency = 0.72 }, 0.2) end
	end)
	hit.MouseLeave:Connect(function()
		tween(f, { BackgroundTransparency = 0.4 }, 0.3)
		if st then tween(st, { Transparency = 0.93 }, 0.3) end
	end)
end

-- Tiroir animé (utilisé par le dropdown et le color picker)
local function drawer(parent, order)
	local wrap = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true,
		Visible = false, LayoutOrder = order, BorderSizePixel = 0,
	}, parent)
	local d = { Wrap = wrap, Open = false, Height = 0 }
	local token = 0
	d.Set = function(self, open, h)
		if h then self.Height = h end
		self.Open = open and true or false
		token = token + 1
		local my = token
		if self.Open then
			wrap.Visible = true
			tween(wrap, { Size = UDim2.new(1, 0, 0, self.Height) }, 0.34)
		else
			local tw = tween(wrap, { Size = UDim2.new(1, 0, 0, 0) }, 0.26)
			tw.Completed:Connect(function()
				if token == my then wrap.Visible = false end
			end)
		end
	end
	d.Resize = function(self, h)
		self.Height = h
		if self.Open then tween(wrap, { Size = UDim2.new(1, 0, 0, h) }, 0.25) end
	end
	return d
end

local function ringSeq()
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.22, 0.65),
		NumberSequenceKeypoint.new(0.5, 1),
		NumberSequenceKeypoint.new(0.78, 0.65),
		NumberSequenceKeypoint.new(1, 0),
	})
end

local function fadeLine(parent, props)
	local f = new("Frame", {
		BackgroundColor3 = T.Accent, BorderSizePixel = 0,
	}, nil)
	for k, v in pairs(props or {}) do f[k] = v end
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, f)
	f.Parent = parent
	return f
end

-- ============================================================================
-- NOTIFICATIONS
-- ============================================================================
local notifGui, notifHolder
local notifCount = 0
local activeNotifs = {}
local NOTIF_ICON = { Info = "i", Success = "+", Warning = "!", Error = "x" }

local function ensureNotif()
	if notifGui and notifGui.Parent then return end
	notifGui = new("ScreenGui", { Name = "SolarisNotify", ResetOnSpawn = false, DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
	mount(notifGui)
	notifHolder = new("Frame", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 290, 1, -32), BackgroundTransparency = 1,
	}, notifGui)
	new("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 8), SortOrder = BYORDER,
	}, notifHolder)
end

function Library:Notify(o)
	if type(o) ~= "table" then o = { Content = tostring(o) } end
	ensureNotif()
	notifCount = notifCount + 1
	local kind = NOTIF_ICON[o.Type] and o.Type or "Info"
	local dur = tonumber(o.Duration) or 4

	local slot = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1, LayoutOrder = notifCount,
	}, notifHolder)
	local card = new(canvasSupported and "CanvasGroup" or "Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Position = UDim2.new(0, 330, 0, 0),
		BackgroundColor3 = T.Second, BackgroundTransparency = 0.04, BorderSizePixel = 0,
	}, slot)
	if canvasSupported then card.GroupTransparency = 1 end
	corner(card, 10)

	local inner = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1 }, card)
	new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 13),
		PaddingLeft = UDim.new(0, 44), PaddingRight = UDim.new(0, 12) }, inner)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = BYORDER }, inner)
	label(inner, o.Title or "Notification", 13, { Font = F_BOLD, Size = UDim2.new(1, 0, 0, 17), LayoutOrder = 1 })
	label(inner, o.Content or "", 12, { TextColor3 = T.ElementAccent, TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None, AutomaticSize = AY, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2 })

	-- pastille d'icône
	local ico = new("Frame", { Position = UDim2.new(0, 11, 0, 10), Size = UDim2.new(0, 24, 0, 24),
		BackgroundColor3 = T.Accent, BackgroundTransparency = (kind == "Info") and 0.9 or 0.05, BorderSizePixel = 0 }, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, ico)
	label(ico, NOTIF_ICON[kind], 14, { Font = F_BOLD, TextXAlignment = CENTER,
		TextColor3 = (kind == "Info") and T.Text or T.Main })

	-- contour intérieur + barre de durée
	local outline = new("Frame", { Position = UDim2.new(0, 1, 0, 1), Size = UDim2.new(1, -2, 1, -2),
		BackgroundTransparency = 1, BorderSizePixel = 0 }, card)
	corner(outline, 9)
	stroke(outline, 0.82)
	local bar = new("Frame", { Position = UDim2.new(0, 12, 1, -4), Size = UDim2.new(1, -24, 0, 2),
		BackgroundColor3 = T.Accent, BackgroundTransparency = 0.55, BorderSizePixel = 0 }, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)

	local clickArea = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
		ZIndex = 5 }, card)

	local dead = false
	local function dismiss()
		if dead then return end
		dead = true
		for idx, fn in ipairs(activeNotifs) do
			if fn == dismiss then table.remove(activeNotifs, idx) break end
		end
		local h = slot.AbsoluteSize.Y
		slot.AutomaticSize = AN
		slot.Size = UDim2.new(1, 0, 0, h)
		if canvasSupported then tween(card, { GroupTransparency = 1 }, 0.35) end
		tween(card, { Position = UDim2.new(0, 330, 0, 0) }, 0.4)
		task.delay(0.22, function()
			if slot.Parent then tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, 0.3) end
		end)
		task.delay(0.55, function() slot:Destroy() end)
	end
	clickArea.MouseButton1Click:Connect(dismiss)
	activeNotifs[#activeNotifs + 1] = dismiss
	while #activeNotifs > 5 do activeNotifs[1]() end

	tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.5)
	if canvasSupported then tween(card, { GroupTransparency = 0 }, 0.35) end
	tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, dur, LINEAR)
	task.delay(dur, dismiss)
end

-- ============================================================================
-- CONFIGURATIONS  (nécessite writefile / readfile)
-- ============================================================================
local function safeName(n)
	local s = tostring(n or "")
	s = s:gsub("[^%w%-_ ]", "")
	s = s:gsub("^%s+", "")
	s = s:gsub("%s+$", "")
	return s
end

function Library:ListConfigs()
	local out = {}
	pcall(function()
		if listfiles and isfolder and isfolder(Library.ConfigFolder) then
			for _, p in ipairs(listfiles(Library.ConfigFolder)) do
				local n = tostring(p):match("([^/\\]+)%.json$")
				if n then out[#out + 1] = n end
			end
		end
	end)
	table.sort(out)
	return out
end

function Library:SaveConfig(name)
	name = safeName(name)
	if name == "" then return false, "nom vide" end
	if not writefile then return false, "writefile indisponible" end
	local folder = Library.ConfigFolder
	pcall(function()
		if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end
	end)
	local ok, err = pcall(function()
		writefile(folder .. "/" .. name .. ".json", HttpService:JSONEncode(Library.Flags))
	end)
	return ok, err
end

function Library:LoadConfig(name)
	name = safeName(name)
	if name == "" then return false, "nom vide" end
	if not (readfile and isfile) then return false, "readfile indisponible" end
	local path = Library.ConfigFolder .. "/" .. name .. ".json"
	if not isfile(path) then return false, "introuvable" end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "fichier invalide" end
	for flag, value in pairs(data) do
		local it = Library.Items[flag]
		if it and it.Set then pcall(it.Set, it, value) end
	end
	return true
end

function Library:DeleteConfig(name)
	name = safeName(name)
	if name == "" or not delfile then return false end
	local ok = pcall(function() delfile(Library.ConfigFolder .. "/" .. name .. ".json") end)
	return ok
end

function Library:SetCornerRadius(v)
	Library.GlobalCornerValue = v
	for _, c in ipairs(Library.CornerObjects) do
		if c.Corner and c.Corner.Parent then
			c.Corner.CornerRadius = UDim.new(0, math.floor(c.BaseRadius * v / 10))
		end
	end
end

-- ============================================================================
-- ÉLÉMENTS (Block)
-- ============================================================================
function Block:_reg(frame, name)
	local e = { Frame = frame, Name = tostring(name or "") }
	self.Entries[#self.Entries + 1] = e
	return e
end

local function makeRow(self, h, name)
	local f = new("Frame", {
		Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = T.Element,
		BackgroundTransparency = 0.4, BorderSizePixel = 0,
	}, self.Body)
	corner(f, 8)
	local st = stroke(f, 0.93)
	self:_reg(f, name)
	return f, st
end

function Block:SetCollapsed(c)
	if self._collapse then self._collapse(c and true or false) end
end

function Block:CreateSection(text)
	if type(text) == "table" then text = text.Name or text.Text end
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1 }, self.Body)
	local l = label(f, string.upper(tostring(text or "")), 11, {
		Size = UDim2.new(1, 0, 1, -4), Font = F_BOLD, TextColor3 = T.ElementAccent,
		TextYAlignment = Enum.TextYAlignment.Bottom, Position = UDim2.new(0, 4, 0, 0),
	})
	fadeLine(f, { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1) })
	local e = self:_reg(f, text)
	local item = {}
	item.SetText = function(...)
		local t = tostring((unself(item, ...)))
		l.Text = string.upper(t)
		e.Name = t
	end
	return item
end

function Block:CreateLabel(o)
	if type(o) ~= "table" then o = { Text = tostring(o) } end
	local l = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
		Text = o.Text or "", TextColor3 = o.TextColor or T.Text, TextSize = o.TextSize or 13,
		Font = F_REG, TextWrapped = true, TextXAlignment = LEFT,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, self.Body)
	new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }, l)
	local e = self:_reg(l, o.Text)
	local item = {}
	item.SetText = function(...)
		local t = tostring((unself(item, ...)))
		l.Text = t
		e.Name = t
	end
	item.Set = item.SetText
	item.Instance = l
	return item
end

-- Paragraphe : titre + texte (accepte Title/Name et Content/Text)
function Block:CreateParagraph(o)
	if type(o) ~= "table" then o = { Content = tostring(o) } end
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundColor3 = T.Element,
		BackgroundTransparency = 0.4, BorderSizePixel = 0,
	}, self.Body)
	corner(holder, 8)
	stroke(holder, 0.93)
	new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, holder)
	new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = BYORDER }, holder)
	local titleL = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
		Text = tostring(o.Title or o.Name or ""), TextColor3 = T.Text, TextSize = 13, Font = F_BOLD,
		TextWrapped = true, TextXAlignment = LEFT, LayoutOrder = 1,
	}, holder)
	local bodyL = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
		Text = tostring(o.Content or o.Text or ""), TextColor3 = T.ElementAccent, TextSize = 12,
		Font = F_REG, TextWrapped = true, TextXAlignment = LEFT,
		TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2,
	}, holder)
	titleL.Visible = titleL.Text ~= ""
	local e = self:_reg(holder, (o.Title or o.Name or "") .. " " .. (o.Content or o.Text or ""))
	local item = {}
	item.Set = function(...)
		local d = unself(item, ...)
		if type(d) == "table" then
			if d.Title or d.Name then titleL.Text = tostring(d.Title or d.Name) titleL.Visible = titleL.Text ~= "" end
			if d.Content or d.Text then bodyL.Text = tostring(d.Content or d.Text) end
		elseif d ~= nil then
			bodyL.Text = tostring(d)
		end
		e.Name = titleL.Text .. " " .. bodyL.Text
	end
	item.SetText = function(...) bodyL.Text = tostring((unself(item, ...))) e.Name = titleL.Text .. " " .. bodyL.Text end
	item.SetTitle = function(...)
		titleL.Text = tostring((unself(item, ...)))
		titleL.Visible = titleL.Text ~= ""
		e.Name = titleL.Text .. " " .. bodyL.Text
	end
	item.Instance = holder
	return item
end

