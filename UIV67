    })

    local ring = self:Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(0.66, 0.66),
        BackgroundTransparency = 1,
        ZIndex = (props.ZIndex or 5) + 1,
        Parent = holder,
    })
    self:AddCorner(ring, 9999)
    local ringStroke = self:Create("UIStroke", {
        Thickness = 2,
        Color = Color3.new(1, 1, 1),
        Parent = ring,
    })
    local ringGradient = self:Create("UIGradient", {
        Color = DiskColorSequence(theme),
        Transparency = DISK_TRANSPARENCY,
        Parent = ringStroke,
    })

    local core = self:Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
