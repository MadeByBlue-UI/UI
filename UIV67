function Library:RefreshKeybindList()
    if not self.KeybindContainer then
        return
    end
    for _, toggle in pairs(self.KeybindToggles) do
        if toggle.ListLabel then
            local state = toggle:GetState()
            local display = toggle.DisplayText or toggle.Text or "Keybind"
            toggle.ListLabel.Text = string.format("[%s] %s (%s)",
                self:ShortKeyName(toggle.Value), display, toggle.Mode)
            toggle.ListLabel.Visible = state and not toggle.NoUI
            toggle.ListLabel.TextColor3 = self.Theme.AccentColor
        end
    end
end

