function Block:CreateButton(o)
	o = o or {}
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.Element, BackgroundTransparency = 0.4,
		Text = o.Name or "Button", TextColor3 = T.Text, TextSize = 13, Font = F_MED, ClipsDescendants = true,
		AutoButtonColor = false, BorderSizePixel = 0, TextTruncate = Enum.TextTruncate.AtEnd,
	}, self.Body)
	corner(b, 8)
	local st = stroke(b, 0.93)
	trackStyled(b, st, "row")
	hover(b, st)
	self:_reg(b, o.Name)
	local armed, armToken = false, 0
	local baseText = o.Name or "Button"
	b.MouseButton1Click:Connect(function()
		if o.Confirm then
			if not armed then
				armed = true
				uiSnd("focus")
				armToken += 1
				local my = armToken
				b.Text = o.ConfirmText or "Êtes-vous sûr ?"
				tween(b, { BackgroundColor3 = Color3.fromRGB(150, 45, 45), BackgroundTransparency = 0.1 }, 0.2)
				task.delay(3, function()
					if armed and armToken == my then
						armed = false
						b.Text = baseText
						tween(b, { BackgroundColor3 = T.Element, BackgroundTransparency = Sty.RowTr }, 0.3)
					end
				end)
				return
			end
			armed = false
			b.Text = baseText
		end
		ripple(b)
		uiSnd("click")
		-- flash blanc qui s'estompe
		b.BackgroundColor3 = T.Accent
		b.BackgroundTransparency = 0
		b.TextColor3 = T.Main
		tween(b, { BackgroundColor3 = T.Element, BackgroundTransparency = Sty.RowTr, TextColor3 = T.Text }, 0.5)
		fire(o.Callback)
	end)
	local item = {}
	item.SetText = function(...) b.Text = tostring((unself(item, ...))) end
	item.Instance = b
	return item
end

-- Noms de touches raccourcis (puces des toggles et HUD)
local KEY_SHORT = { LeftShift = "LShift", RightShift = "RShift", LeftControl = "LCtrl", RightControl = "RCtrl",
	LeftAlt = "LAlt", RightAlt = "RAlt", Return = "Enter", Backspace = "Back", Escape = "Esc",
	MouseButton1 = "Clic G", MouseButton2 = "Clic D", MouseButton3 = "Clic M" }
local function shortKey(k)
	if typeof(k) ~= "EnumItem" or k == Enum.KeyCode.Unknown then return nil end
	return KEY_SHORT[k.Name] or k.Name
end

-- Touches ET boutons de souris : une « touche » est soit un Enum.KeyCode, soit Enum.UserInputType.MouseButton1/2/3
-- (clic gauche / droit / milieu). (rangé dans Library._kb : la librairie est proche de la limite de 200 variables locales)
do
local MOUSE_KEYS = { MouseButton1 = true, MouseButton2 = true, MouseButton3 = true }
Library._kb = {
	-- cet évènement d'entrée correspond-il à la touche / au bouton assigné ?
	hit = function(i, key)
		if typeof(key) ~= "EnumItem" or key == Enum.KeyCode.Unknown then return false end
		if key.EnumType == Enum.KeyCode then
			return i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode == key
		end
		return i.UserInputType == key
	end,
	-- "F" / "MouseButton2" / EnumItem -> EnumItem (ou nil)
	parse = function(v)
		if typeof(v) == "EnumItem" then return v end
		if type(v) ~= "string" then return nil end
		local ok, k = pcall(function() return Enum.KeyCode[v] end)
		if ok and typeof(k) == "EnumItem" then return k end
		if MOUSE_KEYS[v] then return Enum.UserInputType[v] end
		return nil
	end,
	text = function(k)
		return shortKey(k) or "Aucune"
	end,
	-- Écoute la prochaine touche OU le prochain clic (gauche / droit / milieu). Un calque invisible plein écran
	-- absorbe le clic pendant l'écoute : il n'active donc rien dans l'interface ni dans le jeu.
	-- Retourne un objet avec :Disconnect() (idempotent), comme une connexion.
	listen = function(onPick)
		local sinkGui, conn
		local handle = {}
		function handle:Disconnect()
			if conn then conn:Disconnect() conn = nil end
			if sinkGui then sinkGui:Destroy() sinkGui = nil end
		end
		pcall(function()
			sinkGui = new("ScreenGui", { Name = "SolarisKeySink", ResetOnSpawn = false, DisplayOrder = 1100,
				ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
			mount(sinkGui)
			new("TextButton", { Name = "Sink", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
				AutoButtonColor = false, BorderSizePixel = 0 }, sinkGui)
		end)
		conn = track(UIS.InputBegan:Connect(function(i)
			local ut, k = i.UserInputType, nil
			if ut == Enum.UserInputType.Keyboard then
				if i.KeyCode == Enum.KeyCode.Unknown then return end
				k = i.KeyCode
			elseif MOUSE_KEYS[ut.Name] then
				k = ut
			else
				return
			end
			handle:Disconnect()
			onPick(k)
		end))
		return handle
	end,
}
end

-- ---------------------------------------------------------------------------
-- STYLES DES TOGGLES  (Paramètres > Style des toggles) : 15 présentations, changeables en direct
--   Chaque style dessine son interrupteur dans un conteneur de 38 x 20 et renvoie paint(v, instant).
--   Library:SetToggleStyle("Carré") / Library:NextToggleStyle() / Library.ToggleStyles (liste des noms).
-- ---------------------------------------------------------------------------
Library.ToggleStyle = "Pilule"
local TOGGLE_ORDER = { "Pilule", "Pilule fine", "Carré", "Case à cocher", "Case pleine", "Rond", "Pastille",
	"Texte ON/OFF", "Barre", "Segmenté", "Ligne", "Vertical", "Crans", "Remplissage", "Étoile" }
Library.ToggleStyles = TOGGLE_ORDER
local TOGGLE_STYLES = {}
local toggleSkins = {}   -- toggles existants : { f = ligne, skin = fonction qui redessine }

local function tgl(o, props, instant, t, style)
	-- Position ET Size (poignées, billes, cases, barres) passent en ressort : si on rebascule en plein mouvement, la
	-- vitesse est conservée au lieu de repartir de zéro ; les couleurs / transparences restent en tween.
	if props.Position ~= nil or props.Size ~= nil then
		if not instant and Library.Springs ~= false and Library.Animations ~= false then
			local sp, rest = {}, nil
			local preset = style == BACK and "bouncy" or "snappy"
			for k, v in pairs(props) do
				if k == "Position" or k == "Size" then
					sp[k] = v
					-- une taille qui tombe à 0 : ressort sans rebond (jamais de taille négative)
					if k == "Size" and (v.X.Offset == 0 and v.X.Scale == 0 or v.Y.Offset == 0 and v.Y.Scale == 0) then preset = "smooth" end
				else
					rest = rest or {} rest[k] = v
				end
			end
			Library._spring(o, sp, preset)
			if rest then tween(o, rest, t or 0.25, style) end
			return
		end
		Library._springStop(o, "Position")
		Library._springStop(o, "Size")
	end
	tween(o, props, instant and 0 or (t or 0.25), style)
end
local function circ(o) new("UICorner", { CornerRadius = UDim.new(1, 0) }, o) end
local function rnd(o, r) new("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function box(parent, props)
	props.BorderSizePixel = 0
	return new("Frame", props, parent)
end
local V_HALF = Vector2.new(0.5, 0.5)

