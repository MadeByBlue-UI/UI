-- ============================================================================
Library.Gradient = { Enabled = false, C1 = Color3.fromRGB(70, 30, 140), C2 = Color3.fromRGB(10, 50, 120), C3 = nil,
	Rotation = 45, Strength = 0.6 }
Library.GradientPresets = {
	["Aurore"]     = { Color3.fromRGB(20, 200, 160), Color3.fromRGB(110, 60, 220) },
	["Crépuscule"] = { Color3.fromRGB(255, 110, 80), Color3.fromRGB(90, 40, 160) },
	["Océan"]      = { Color3.fromRGB(0, 130, 210), Color3.fromRGB(0, 20, 70) },
	["Braise"]     = { Color3.fromRGB(255, 70, 30), Color3.fromRGB(60, 0, 0) },
	["Menthe"]     = { Color3.fromRGB(120, 255, 200), Color3.fromRGB(0, 90, 110) },
	["Mono"]       = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(20, 20, 20) },
}

function Library:_gradientData()
	local g = Library.Gradient
	return { Enabled = g.Enabled, C1 = "#" .. g.C1:ToHex(), C2 = "#" .. g.C2:ToHex(),
		C3 = g.C3 and ("#" .. g.C3:ToHex()) or nil, Rotation = g.Rotation, Strength = g.Strength }
end

function Library:SetGradient(d)
	local g = Library.Gradient
	if type(d) == "table" then
		if d.Enabled ~= nil then g.Enabled = d.Enabled and true or false end
		local c = toColor3(d.C1)
		if c then g.C1 = c end
		c = toColor3(d.C2)
		if c then g.C2 = c end
		if d.C3 == false then
			g.C3 = nil
		else
			c = toColor3(d.C3)
			if c then g.C3 = c end
		end
		if tonumber(d.Rotation) then g.Rotation = tonumber(d.Rotation) % 360 end
		if tonumber(d.Strength) then g.Strength = math.clamp(tonumber(d.Strength), 0.05, 1) end
	end
	Library.Flags["ui.gradient"] = Library:_gradientData()
	local win = Library.Window
	if win and win.Main then
		local fr = Library._gradFrame
		if not (fr and fr.Parent) then
			fr = new("Frame", { Name = "ThemeGradient", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0, ZIndex = 0, Visible = false }, win.Main)
			Library._gradObj = new("UIGradient", {}, fr)
			Library._gradFrame = fr
		end
		fr.Visible = g.Enabled
		fr.BackgroundTransparency = 1 - g.Strength
		Library._gradObj.Rotation = g.Rotation
		if g.C3 then
			Library._gradObj.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, g.C1),
				ColorSequenceKeypoint.new(0.5, g.C3), ColorSequenceKeypoint.new(1, g.C2) })
		else
			Library._gradObj.Color = ColorSequence.new(g.C1, g.C2)
		end
	end
	if Library._onColors then pcall(Library._onColors) end
end

