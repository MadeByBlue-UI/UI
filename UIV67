--- Library:Dialog({
---     Title = "Are you sure?",
---     Description = "This cannot be undone.",
---     Buttons = {
---         { Title = "Yes", Variant = "Primary", Callback = function() end },
---         { Title = "No" },
---     },
---     OutsideClickDismiss = true,
--- })
function Library:Dialog(info)
    info = info or {}
    local dialog = { Destroyed = false }

    local layer = self.DialogLayer
    layer.Visible = true
    self:Tween(layer, { BackgroundTransparency = 0.45 })

    local frame = self:Create("Frame", {
        Name = "Dialog",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(340, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 710,
        ["@BackgroundColor3"] = "BackgroundColor",
        Parent = layer,
    })
    self:AddCorner(frame, 8)
    self:AddStroke(frame, "AccentColor", 1, 0.2)
    self:AddPadding(frame, 14, 16, 14, 16)
    self:AddList(frame, 10)
    self:Create("UISizeConstraint", { MaxSize = Vector2.new(420, 600), Parent = frame })

    self:Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        Text = info.Title or "Dialog",
        TextXAlignment = Enum.TextXAlignment.Left,
        TextSize = self.TextSize + 3,
        ZIndex = 711,
        LayoutOrder = 1,
        ["@TextColor3"] = "FontColor",
        Parent = frame,
    })

    self:Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = info.Description or "",
        TextWrapped = true,
        RichText = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 711,
        LayoutOrder = 2,
        ["@TextColor3"] = "MutedColor",
        Parent = frame,
    })

    local buttonRow = self:Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 30),
        ZIndex = 711,
        LayoutOrder = 3,
        Parent = frame,
    })
    self:AddList(buttonRow, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right,
        Enum.VerticalAlignment.Center)

    function dialog:Dismiss()
        if self.Destroyed then
            return
        end
        self.Destroyed = true
        Library:Tween(layer, { BackgroundTransparency = 1 })
        frame:Destroy()
        task.delay(0.2, function()
            if #layer:GetChildren() == 0 then
                layer.Visible = false
            end
        end)
    end

    local buttons = info.Buttons or { { Title = "OK" } }
    for index, button in ipairs(buttons) do
        local primary = button.Variant == "Primary" or (button.Variant == nil and index == 1)
        local textWidth = self:GetTextBounds(button.Title or "OK", self.Font, self.TextSize)
        local control = self:Create("TextButton", {
            Size = UDim2.fromOffset(math.max(70, textWidth + 28), 28),
            Text = button.Title or "OK",
            ZIndex = 712,
            LayoutOrder = index,
            AutoButtonColor = false,
            BackgroundTransparency = primary and 0 or 0,
            ["@BackgroundColor3"] = primary and "AccentColor" or "MainColor",
            ["@TextColor3"] = primary and function(theme)
                local _, _, v = theme.AccentColor:ToHSV()
                return v > 0.7 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
            end or "FontColor",
            Parent = buttonRow,
        })
        self:AddCorner(control, 5)
        if not primary then
            self:AddStroke(control, "OutlineColor", 1)
        end
        control.MouseButton1Click:Connect(function()
            dialog:Dismiss()
            self:SafeCallback(button.Callback)
        end)
    end

    if info.OutsideClickDismiss ~= false then
        local connection
        connection = layer.InputBegan:Connect(function(input)
            if self:IsClick(input) and not self:IsMouseOver(frame) then
                connection:Disconnect()
                dialog:Dismiss()
            end
        end)
    end

    return dialog
end

