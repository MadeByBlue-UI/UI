local uiSndGui
local uiSndObjs, uiSndLast = {}, {}

local function uiSndHost()
	if uiSndGui and uiSndGui.Parent then return uiSndGui end
	uiSndGui = new("ScreenGui", { Name = "SolarisSound", ResetOnSpawn = false, DisplayOrder = 0 })
	mount(uiSndGui)
	return uiSndGui
