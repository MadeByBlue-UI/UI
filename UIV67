			-- Une animation (dépliage, reset, colonnes) est encore en cours : on la termine d'abord, avec sa
			-- propre direction, pour partir de la vraie taille et non d'une taille intermédiaire.
			if tgtSize and rsSmooth then
				applySize(tgtSize)
				curSize, tgtSize = lastSize, nil
			end
			if tgtPos then curPos, tgtPos = tgtPos, nil end
