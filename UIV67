--- Auto-updating watermark: "Singularity | 144 fps | 32 ms"
function Library:EnableStatsWatermark(prefix)
    prefix = prefix or self.Name
    local frames, elapsed, fps = 0, 0, 60
    self:AddAnimation(function(dt)
        frames = frames + 1
        elapsed = elapsed + dt
        if elapsed >= 0.5 then
            fps = math.floor(frames / elapsed + 0.5)
            frames, elapsed = 0, 0
            local ping = 0
            pcall(function()
                ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
            end)
            self:SetWatermark(string.format("%s  |  %d fps  |  %d ms", prefix, fps, ping))
        end
    end)
end

