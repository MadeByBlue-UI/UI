local function InputName(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return input.KeyCode.Name
    end
    local type = input.UserInputType
    if type == Enum.UserInputType.MouseButton1 or type == Enum.UserInputType.MouseButton2
        or type == Enum.UserInputType.MouseButton3 then
        return type.Name
    end
    return nil
end

Library.InputName = InputName
Library.ActiveBinder = nil

function Addons:AddKeyPicker(idx, info)
    info = info or {}
    local picker = {
        Type = "KeyPicker",
        Index = idx,
        Value = info.Default or "None",
        Mode = info.Mode or "Toggle",
        Modes = info.Modes or { "Always", "Toggle", "Hold" },
        Text = info.Text or "Keybind",
        DisplayText = info.Text,
        NoUI = info.NoUI == true,
        SyncToggleState = info.SyncToggleState == true,
        Callback = info.Callback,
        ChangedCallback = info.ChangedCallback,
        Clicked = Signal.new(),
        Changed = Signal.new(),
        Toggled = false,
        Holding = false,
        Binding = false,
        ParentElement = self,
    }

    if picker.SyncToggleState and self.Type == "Toggle" then
        picker.Toggled = self.Value
        picker.ParentToggle = self
        picker.DisplayText = self.Text
        self.Pickers = self.Pickers or {}
        table.insert(self.Pickers, picker)
    end

    local button = Library:Create("TextButton", {
        Name = "KeyPicker",
        Size = UDim2.fromOffset(34, 16),
        Text = "",
        ZIndex = 5,
        LayoutOrder = #self.Addons:GetChildren(),
        ["@BackgroundColor3"] = "MainColor",
        ["@TextColor3"] = "MutedColor",
        Parent = self.Addons,
    })
    Library:AddCorner(button, 4)
    Library:AddStroke(button, "OutlineColor", 1)
    picker.Button = button

    local label = Library:Create("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        Text = "",
        TextSize = Library.TextSize - 2,
        ZIndex = 6,
        ["@TextColor3"] = "MutedColor",
        Parent = button,
    })
    picker.Label = label

    if info.Tooltip then
        Library:AddTooltip(info.Tooltip, button)
    end

    -- Key list entry
    if not picker.NoUI then
        Library:AddKeybindListEntry(picker)
    end

    function picker:Display()
        local text
        if self.Binding then
            text = "..."
        else
            text = Library:ShortKeyName(self.Value)
            if self.Value == "None" then
                text = "None"
            end
        end
        label.Text = text
        local width = Library:GetTextBounds(text, Library.Font, Library.TextSize - 2)
        button.Size = UDim2.fromOffset(math.max(34, width + 14), 16)
        label.TextColor3 = self.Binding and Library.Theme.AccentColor or Library.Theme.MutedColor
    end

    function picker:GetState()
        if self.Mode == "Always" then
            return true
        elseif self.Mode == "Hold" then
            return self.Holding
        end
        return self.Toggled
    end

    function picker:DoClick()
        if self.ParentToggle and self.SyncToggleState then
            self.ParentToggle:SetValue(not self.ParentToggle.Value)
            self.Toggled = self.ParentToggle.Value
        else
            self.Toggled = not self.Toggled
        end
        Library:SafeCallback(self.Callback, self:GetState())
        self.Clicked:Fire(self:GetState())
        Library:RefreshKeybindList()
    end

    function picker:SetValue(data)
        local key, mode = data[1], data[2]
        if typeof(key) == "EnumItem" then
            key = key.Name
        end
        self.Value = key or self.Value
        self.Mode = mode or self.Mode
        self:Display()
        Library:SafeCallback(self.ChangedCallback, self.Value, self.Mode)
        self.Changed:Fire(self.Value, self.Mode)
        Library:RefreshKeybindList()
    end

    function picker:GetValue()
        return { self.Value, self.Mode }
    end

    function picker:OnClick(fn)
        return self.Clicked:Connect(fn)
    end

    function picker:OnChanged(fn)
        return self.Changed:Connect(fn)
    end

    function picker:SetMode(mode)
        self.Mode = mode
        if mode == "Always" then
            self.Toggled = true
        end
        self:Display()
        Library:RefreshKeybindList()
        self.Changed:Fire(self.Value, self.Mode)
    end

    function picker:SetVisible(visible)
        button.Visible = visible
    end

    -- Mode menu (right click)
    local menu
    local function closeMenu()
        if menu then
            menu.Visible = false
            Library:ClosePopup(menu)
        end
    end

    local function openMenu()
        if not menu then
            menu = Library:Create("Frame", {
                Name = "KeyModeMenu",
                Size = UDim2.fromOffset(92, #picker.Modes * 22 + 8),
                Visible = false,
                ZIndex = 530,
                ["@BackgroundColor3"] = "BackgroundColor",
                Parent = Library.PopupLayer,
            })
            Library:AddCorner(menu, 5)
            Library:AddStroke(menu, "AccentColor", 1, 0.4)
            Library:AddPadding(menu, 4)
            Library:AddList(menu, 0)

            for order, mode in ipairs(picker.Modes) do
                local item = Library:Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22),
                    Text = mode,
                    ZIndex = 531,
                    LayoutOrder = order,
                    ["@TextColor3"] = "MutedColor",
                    Parent = menu,
                })
                item.MouseButton1Click:Connect(function()
                    picker:SetMode(mode)
                    for _, other in ipairs(menu:GetChildren()) do
                        if other:IsA("TextButton") then
                            other.TextColor3 = other.Text == picker.Mode and Library.Theme.AccentColor
                                or Library.Theme.MutedColor
                        end
                    end
                    closeMenu()
                end)
            end
        end

        for _, other in ipairs(menu:GetChildren()) do
            if other:IsA("TextButton") then
                other.TextColor3 = other.Text == picker.Mode and Library.Theme.AccentColor or Library.Theme.MutedColor
            end
        end

        Library:CloseAllPopups(menu)
        menu.Visible = true
        Library:PositionPopup(menu, button, 92, 4)
        Library:OpenPopup(menu, closeMenu, button)
    end

    button.MouseButton1Click:Connect(function()
        if picker.Binding then
            return
        end
        picker.Binding = true
        Library.ActiveBinder = picker
        picker:Display()
    end)

    button.MouseButton2Click:Connect(function()
        if picker.Binding then
            return
        end
        openMenu()
    end)

    picker:Display()
    Library.Options[idx] = picker
    Library.KeybindToggles[idx] = picker
    Library:RefreshKeybindList()
    return self
end

-- ── Global keyboard handling (binding, toggles, holds, menu key) ──────────

Library.Maid:Give(UserInputService.InputBegan:Connect(function(input, processed)
    if Library.Unloaded then
        return
    end

    -- Binding mode: the next key press becomes the keybind
    local binder = Library.ActiveBinder
    if binder and binder.Binding then
        local name = InputName(input)
        if name then
            if name == "Escape" or name == "Backspace" then
                name = "None"
            end
            binder.Binding = false
            Library.ActiveBinder = nil
            binder:SetValue({ name, binder.Mode })
        end
        return
    end

    if UserInputService:GetFocusedTextBox() then
        return
    end

    local name = InputName(input)
    if not name then
        return
    end

    -- Menu toggle key
    local menuKey = Library.ToggleKeybind
    if menuKey then
        local menuName
        if typeof(menuKey) == "EnumItem" then
            menuName = menuKey.Name
        elseif type(menuKey) == "table" and menuKey.Value then
            menuName = menuKey.Value
        elseif type(menuKey) == "string" then
            menuName = menuKey
        end
        if menuName == name and menuName ~= "None" then
            Library:Toggle()
            return
        end
    end

    -- Keybinds
    for _, picker in pairs(Library.KeybindToggles) do
        if picker.Value == name and picker.Value ~= "None" and picker.Binding ~= true then
            if picker.Mode == "Toggle" then
                picker:DoClick()
            elseif picker.Mode == "Hold" then
                picker.Holding = true
                Library:SafeCallback(picker.Callback, true)
                picker.Clicked:Fire(true)
                Library:RefreshKeybindList()
            end
        end
    end
end))

Library.Maid:Give(UserInputService.InputEnded:Connect(function(input)
    if Library.Unloaded then
        return
    end
    local name = InputName(input)
    if not name then
        return
    end
    for _, picker in pairs(Library.KeybindToggles) do
        if picker.Value == name and picker.Mode == "Hold" and picker.Holding then
            picker.Holding = false
            Library:SafeCallback(picker.Callback, false)
            picker.Clicked:Fire(false)
            Library:RefreshKeybindList()
        end
    end
end))

