local tipLabel, tipShown = nil, false   -- créés par CreateWindow

local function attachTip(frame, text)
	text = tostring(text)
	local token = 0
	frame.MouseEnter:Connect(function()
		token += 1
		local my = token
		task.delay(0.4, function()
			if token ~= my or not tipLabel then return end
			tipLabel.Text = text
			tipShown = true
			tipLabel.Visible = true
		end)
	end)
	frame.MouseLeave:Connect(function()
		token += 1
		tipShown = false
		if tipLabel then tipLabel.Visible = false end
	end)
end

local function favList()
	local out = {}
	for k, v in pairs(Library.Favorites) do
		if v then out[#out + 1] = k end
	end
	table.sort(out)
	return out
end

function Library:SetFavorite(key, on)
	on = on and true or false
	Library.Favorites[key] = on or nil
	local star = Library.FavStars[key]
	if star and star.Parent then tween(star, { TextTransparency = on and 0.05 or 0.8 }, 0.2) end
	Library.Flags["__favorites"] = favList()
	local w = Library.Window
	if w and w.FavTab and w.Current == w.FavTab and w.FavTab.OnSelect then w.FavTab.OnSelect() end
end

local function registerFavItem()
	Library.Flags["__favorites"] = favList()
	Library.Items["__favorites"] = {
		Get = function() return favList() end,
		Set = function(_, list)
			if type(list) ~= "table" then return end
			local newSet = {}
			for _, k in ipairs(list) do newSet[tostring(k)] = true end
			for k in pairs(Library.Favorites) do
				if not newSet[k] then Library:SetFavorite(k, false) end
			end
			for k in pairs(newSet) do Library:SetFavorite(k, true) end
		end,
	}
end

-- Barre de progression / jauge : mise à jour par le script (cooldowns, chargement...).
--   local p = block:CreateProgress({ Name = "Cooldown", Min = 0, Max = 100, Default = 0,
--       Suffix = " %" (ou Format = function(v, ratio, max) return "..." end), Color = Color3, Text = "texte fixe", Tooltip = "..." })
--   p:Set(v) · p:Get() · p:GetRatio() · p:SetMax(m) · p:SetText("...") / p:SetText(nil) · p:SetColor(c) · p:SetName("...")
--   p:Countdown(secondes, { Fill = false, ShowTime = true, OnDone = function() end })   -- cooldown : se vide en N secondes
--   p:SetIndeterminate(true)   -- chargement sans valeur connue · p:Cancel() arrête le décompte / le chargement
function Block:CreateProgress(o)
	o = o or {}
	local min, max = tonumber(o.Min) or 0, tonumber(o.Max) or 100
	if max <= min then max = min + 1 end
	local suffix = (o.Suffix ~= nil) and tostring(o.Suffix) or nil
	local customText = (o.Text ~= nil) and tostring(o.Text) or nil

	local f, st = makeRow(self, 46, o.Name)
	hover(f, st)
	local nameL = label(f, o.Name or "Progression", 13, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -118, 0, 18) })
	local valL = label(f, "", 12, { Position = UDim2.new(1, -106, 0, 6), Size = UDim2.new(0, 94, 0, 18),
		TextXAlignment = RIGHT, TextColor3 = T.ElementAccent })
	local bar = new("Frame", { Position = UDim2.new(0, 12, 0, 31), Size = UDim2.new(1, -24, 0, 8),
		BackgroundColor3 = T.Off, BorderSizePixel = 0, ClipsDescendants = true }, f)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = o.Color or T.Accent,
		BorderSizePixel = 0 }, bar)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	local value = math.clamp(tonumber(o.Default or o.Value) or min, min, max)
	local runTw, runTok, indet = nil, 0, nil

	local function ratioOf(v) return math.clamp((v - min) / (max - min), 0, 1) end
	local function fmt(v)
		if type(o.Format) == "function" then
			local ok, s = pcall(o.Format, v, ratioOf(v), max)
			if ok and s ~= nil then return tostring(s) end
		end
		if suffix then return tostring(math.floor(v * 100 + 0.5) / 100) .. suffix end
		return tostring(math.floor(ratioOf(v) * 100 + 0.5)) .. " %"
	end
	local function stopRun()
		runTok += 1
		if runTw then runTw:Cancel() runTw = nil end
		if indet then indet:Cancel() indet = nil end
		fill.Position = UDim2.new(0, 0, 0, 0)
	end
	local function setValue(v, instant)
		value = math.clamp(tonumber(v) or value, min, max)
		valL.Text = customText or fmt(value)
		local goal = UDim2.new(ratioOf(value), 0, 1, 0)
		if instant then fill.Size = goal else tween(fill, { Size = goal }, 0.18) end
	end

	local item = {}
	item.Set = function(...)
		local v, instant = unself(item, ...)
		stopRun()
		setValue(v, instant)
	end
	item.Get = function() return value end
	item.GetRatio = function() return ratioOf(value) end
	item.SetMax = function(...)
		local m = tonumber((unself(item, ...)))
		if m and m > min then
			max = m
			stopRun()
			setValue(value, true)
		end
	end
	item.SetText = function(...)
		local s = unself(item, ...)
		customText = (s ~= nil) and tostring(s) or nil
		valL.Text = customText or fmt(value)
	end
	item.SetColor = function(...)
		local c = unself(item, ...)
		if typeof(c) == "Color3" then tween(fill, { BackgroundColor3 = c }, 0.25) end
	end
	item.SetName = function(...) nameL.Text = tostring((unself(item, ...))) end
	item.Cancel = function()
		stopRun()
		setValue(value, true)
	end
	item.SetIndeterminate = function(...)
		local on = unself(item, ...)
		stopRun()
		if on == false then
			setValue(value, true)
			return
		end
		valL.Text = customText or "..."
		fill.Size = UDim2.new(0.35, 0, 1, 0)
		fill.Position = UDim2.new(-0.35, 0, 0, 0)
		indet = TweenService:Create(fill, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1),
			{ Position = UDim2.new(1, 0, 0, 0) })
		indet:Play()
	end
	-- cooldown : la jauge se vide (ou se remplit avec Fill = true) en N secondes, texte = temps restant
	item.Countdown = function(...)
		local sec, opt = unself(item, ...)
		sec = math.max(tonumber(sec) or 1, 0.05)
		opt = (type(opt) == "table") and opt or {}
		stopRun()
		local from, to = max, min
		if opt.Fill then from, to = min, max end
		value = from
		fill.Size = UDim2.new(ratioOf(from), 0, 1, 0)
		runTw = TweenService:Create(fill, TweenInfo.new(sec, LINEAR, OUT), { Size = UDim2.new(ratioOf(to), 0, 1, 0) })
		runTw:Play()
		local my = runTok
		local t0 = os.clock()
		task.spawn(function()
			while runTok == my and f.Parent do
				local el = os.clock() - t0
				if el >= sec then break end
				value = from + (to - from) * (el / sec)
				if customText then
					valL.Text = customText
				elseif opt.ShowTime == false then
					valL.Text = fmt(value)
				else
					valL.Text = string.format("%.1f s", sec - el)
				end
				task.wait(0.05)
			end
			if runTok ~= my then return end
			runTw = nil
			value = to
			valL.Text = customText or fmt(value)
			if opt.OnDone then fire(opt.OnDone) end
		end)
	end
	item.Instance = f

	setValue(value, true)
	return item
end

-- Compteur  -  valeur  +  pour les valeurs entières (plus précis qu'un curseur).
--   block:CreateStepper({ Name = "Niveau", Min = 0, Max = 10, Step = 1, Default = 3, Suffix = "", Wrap = false, Flag = "...",
--       Callback = function(v) end })
--   Maintenir un bouton = répétition qui accélère · Maj = pas x10 · clic sur la valeur = saisie au clavier.
--   item:Set(n) · item:Get() · item:Increment() · item:Decrement() · item:SetRange(min, max)
function Block:CreateStepper(o)
	o = o or {}
	local min, max = math.floor(tonumber(o.Min) or 0), math.floor(tonumber(o.Max) or 100)
	if max < min then min, max = max, min end
	local step = math.max(math.floor(tonumber(o.Step or o.Increment) or 1), 1)
	local suffix = (o.Suffix ~= nil) and tostring(o.Suffix) or ""
	local value = math.clamp(math.floor(tonumber(o.Default) or min), min, max)

	local f, st = makeRow(self, 36, o.Name)
	hover(f, st)
	label(f, o.Name or "Compteur", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -150, 1, 0) })

	local function mk(txt, x)
		local b = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0),
			Size = UDim2.fromOffset(26, 24), BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0,
			Text = txt, TextColor3 = T.Text, TextSize = 16, Font = F_BOLD, AutoButtonColor = false }, f)
		corner(b, 6)
		local bst = stroke(b, 0.9)
		trackStyled(b, bst, "input")
		return b
	end
	local plus = mk("+", -8)
	local valBox = new("TextBox", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -38, 0.5, 0),
		Size = UDim2.fromOffset(60, 24), BackgroundColor3 = T.Off, BackgroundTransparency = 0.55, BorderSizePixel = 0,
		Text = "", TextColor3 = T.Text, TextSize = 12, Font = F_MED, ClearTextOnFocus = false,
		TextTruncate = Enum.TextTruncate.AtEnd }, f)
	corner(valBox, 6)
	local vst = stroke(valBox, 0.9)
	trackStyled(valBox, vst, "input")
	local minus = mk("-", -102)

	local function fmt(v) return tostring(v) .. suffix end
	local function apply(v, silent)
		v = math.clamp(math.floor((tonumber(v) or value) + 0.5), min, max)
		local changed = v ~= value
		value = v
		if not valBox:IsFocused() then valBox.Text = fmt(v) end
		tween(minus, { TextTransparency = (o.Wrap or v > min) and 0 or 0.65 }, 0.15)
		tween(plus, { TextTransparency = (o.Wrap or v < max) and 0 or 0.65 }, 0.15)
		if o.Flag then Library.Flags[o.Flag] = v end
		if changed and not silent then fire(o.Callback, v) end
	end
	local function bump(dir)
		local mult = (UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)) and 10 or 1
		local nv = value + dir * step * mult
		if o.Wrap then
			if nv > max then nv = min elseif nv < min then nv = max end
		end
		apply(nv)
	end
	local function holdable(btn, dir)
		local tok = 0
		btn.MouseButton1Down:Connect(function()
			uiSnd("click")
			tween(btn, { BackgroundTransparency = 0.05 }, 0.1)
			bump(dir)
			tok += 1
			local my = tok
			task.spawn(function()
				task.wait(0.45)
				local gap = 0.12
				while tok == my and btn.Parent do
					bump(dir)
					task.wait(gap)
					gap = math.max(gap * 0.88, 0.03)
				end
			end)
		end)
		local function stop()
			tok += 1
			tween(btn, { BackgroundTransparency = Sty.InputTr }, 0.2)
		end
		btn.MouseButton1Up:Connect(stop)
		btn.MouseLeave:Connect(stop)
	end
	holdable(minus, -1)
	holdable(plus, 1)

	valBox.Focused:Connect(function()
		uiSnd("focus")
		valBox.Text = tostring(value)
		tween(valBox, { BackgroundTransparency = 0.25 }, 0.2)
	end)
	valBox.FocusLost:Connect(function()
		tween(valBox, { BackgroundTransparency = 0.55 }, 0.25)
		local n = tonumber(string.match(valBox.Text, "-?%d+"))
		if n then apply(n) end
		valBox.Text = fmt(value)
	end)

	local item = {}
	item.Set = function(...)
		local v = tonumber((unself(item, ...)))
		if v then apply(v) end
	end
	item.Get = function() return value end
	item.Increment = function() bump(1) end
	item.Decrement = function() bump(-1) end
	item.SetRange = function(...)
		local a, b = unself(item, ...)
		a, b = tonumber(a), tonumber(b)
		if a and b then
			min, max = math.floor(math.min(a, b)), math.floor(math.max(a, b))
			apply(value, true)
		end
	end
	apply(value, true)
	register(o.Flag, item, value)
	if Library.FireDefaults then fire(o.Callback, value) end
	return item
end

-- On enrobe chaque élément interactif : tooltip (o.Tooltip) + étoile de favori (o.Favorite = false pour la retirer)
local paletteSeq = 0
local WRAP_KINDS = { "Button", "Toggle", "Slider", "RangeSlider", "Dropdown", "Input", "Keybind", "ColorPicker",
	"Stepper", "Progress" }
for _, kind in ipairs(WRAP_KINDS) do
	local base = Block["Create" .. kind]
	Block["Create" .. kind] = function(self, o)
		local item = base(self, o)
		local opts = type(o) == "table" and o or {}
		local e = self.Entries[#self.Entries]
		if e and e.Frame then
			if opts.Tooltip then attachTip(e.Frame, opts.Tooltip) end
			-- filtre « Modifiés » : { Modified = false } pour exclure un élément
			if kind ~= "Button" and kind ~= "Progress" and not self._noFav and opts.Modified ~= false then
				Library:_trackModified(kind, item, e.Frame, opts)
			end
			-- remise à zéro globale (Paramètres > Fenêtre) : { Reset = false } pour exclure un élément
			if (kind == "Toggle" or kind == "Slider" or kind == "RangeSlider" or kind == "Keybind")
				and not self._noFav and opts.Reset ~= false
				and not (self.Tab and self.Tab._isSettings)
				and not (opts.Favorite == false and opts.Palette == false) then
				local okd, defv = pcall(function() return item.Get() end)
				Library.ResetEntries[#Library.ResetEntries + 1] = { Kind = kind, Item = item, Frame = e.Frame,
					Default = okd and copyVal(defv) or nil }
			end
			-- liste des keybinds (bloc « Raccourcis clavier » des Paramètres)
			if kind == "Keybind" and not self._noFav then
				Library.KeybindEntries[#Library.KeybindEntries + 1] = { Name = tostring(opts.Name or "Keybind"),
					Tab = self.Tab, Block = self, Frame = e.Frame, Item = item }
				if Library._onKeybindAdded then pcall(Library._onKeybindAdded) end
				Library:RefreshKeybindConflicts()
				if Library._hudRefresh then Library._hudRefresh() end   -- la touche peut compléter une ligne du HUD
			end
			-- HUD des actifs : { HUD = false } pour cacher un toggle du panneau
			if kind == "Toggle" and not self._noFav and opts.HUD ~= false and not (self.Tab and self.Tab._isSettings) then
				Library.ToggleEntries[#Library.ToggleEntries + 1] = { Name = tostring(opts.Name or "Toggle"), Item = item,
					Frame = e.Frame, Tab = self.Tab, Block = self, HudKey = opts.HudKey }
				if Library._hudRefresh then Library._hudRefresh() end
			end
			-- palette de commandes (Ctrl+K) : { Palette = false } pour exclure un élément
			if not self._noFav and opts.Palette ~= false and kind ~= "Progress" then
				local ptab = self.Tab and self.Tab.Name or ""
				local pkey = tostring(ptab) .. "/" .. tostring(self.Name) .. "/" .. kind .. "/" .. tostring(opts.Name or "")
				paletteSeq = paletteSeq + 1
				Library.CmdEntries[pkey] = { Kind = kind, Opts = opts, Item = item, Key = pkey, Tab = ptab,
					Block = self.Name, Frame = e.Frame, Seq = paletteSeq, Name = tostring(opts.Name or kind) }
			end
			if not self._noFav and opts.Favorite ~= false and kind ~= "Progress" then
				local tabName = self.Tab and self.Tab.Name or ""
				local key = tostring(tabName) .. "/" .. tostring(self.Name) .. "/" .. kind .. "/" .. tostring(opts.Name or "")
				local host = e.Frame
				-- dropdown / color picker : le cadre a un UIListLayout, l'étoile va dans la ligne d'en-tête
				if host:FindFirstChildOfClass("UIListLayout") then
					host = host:FindFirstChildWhichIsA("TextButton") or host
				end
				local star = new("TextButton", {
					Name = "FavStar", Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(1, 1),
					BackgroundTransparency = 1, Text = "★", TextSize = 10, Font = F_BOLD, TextColor3 = T.Accent,
					TextTransparency = Library.Favorites[key] and 0.05 or 0.8, AutoButtonColor = false, ZIndex = 6,
				}, host)
				Library.FavStars[key] = star
				Library.FavEntries[key] = { Kind = kind, Opts = opts, Item = item, Key = key,
					Tab = tabName, Block = self.Name }
				star.MouseButton1Click:Connect(function()
					Library:SetFavorite(key, not Library.Favorites[key])
				end)
			end
		end
		return item
	end
end

-- ============================================================================
-- FILTRE « MODIFIÉS »  (puce à côté de la recherche + Paramètres > Éléments modifiés)
--   Une pastille s'allume sur chaque toggle / slider / liste / champ / couleur / touche / stepper qui n'est plus à sa
--   valeur de départ ; le filtre n'affiche que ceux-là (et ouvre leurs blocs).
--   Library:SetModFilter(bool) · Library:GetModified() -> { noms } · Library:SetModBaseline() (valeur actuelle = référence)
--   { Modified = false } sur un élément l'exclut.
-- ============================================================================
local function modSig(v)
	local t = typeof(v)
	if t == "number" then
		return string.format("%.4f", v)
	elseif t == "Color3" then
		return string.format("c%d,%d,%d", math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5))
	elseif t == "table" then
		local parts = {}
		if #v > 0 then
			for _, x in ipairs(v) do parts[#parts + 1] = modSig(x) end
			table.sort(parts)
			return "[" .. table.concat(parts, ",") .. "]"
		end
		for k, x in pairs(v) do parts[#parts + 1] = tostring(k) .. "=" .. modSig(x) end
		table.sort(parts)
		return "{" .. table.concat(parts, ",") .. "}"
	end
	return tostring(v)
end

function Library:_trackModified(kind, item, frame, opts)
	if not frame then return end
	local host = frame
	if host:FindFirstChildOfClass("UIListLayout") then host = host:FindFirstChildWhichIsA("TextButton") or host end
	local dot = new("Frame", { Name = "ModDot", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0,
		ZIndex = 7, Active = false }, host)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	local en = { Kind = kind, Item = item, Frame = frame, Dot = dot, Name = tostring(opts.Name or kind), Mod = false, Shown = 1 }
	en.Get = function()
		local ok, v = pcall(function() return item.Get() end)
		local sg = ok and modSig(v) or "?"
		if type(item.GetKey) == "function" then   -- toggle avec touche liée
			local ok2, k = pcall(item.GetKey)
			sg = sg .. "|" .. tostring(ok2 and k or "")
		end
		return sg
	end
	en.Base = en.Get()
	Library.ModEntries[#Library.ModEntries + 1] = en
	Library.ModByFrame[frame] = en
	Library:_startModWatcher()
end

function Library:_isModifiedFrame(frame)
	local en = Library.ModByFrame[frame]
	return en ~= nil and en.Get() ~= en.Base
end

function Library:_paintModChip()
	local w = Library.Window
	local chip = w and w.ModChip
	if not chip or not chip.Parent then return end
	local on = Library.ModFilter
	chip.Text = Library.ModCount > 99 and "99+" or tostring(Library.ModCount)
	tween(chip, { BackgroundColor3 = on and T.Accent or T.Element, BackgroundTransparency = on and 0.1 or 0.4 }, 0.15)
	chip.TextColor3 = on and T.Main or T.Text
end

function Library:_refreshModified()
	local list, count, changed = Library.ModEntries, 0, false
	for i = #list, 1, -1 do
		local en = list[i]
		if not (en.Frame and en.Frame.Parent) then
			table.remove(list, i)
			Library.ModByFrame[en.Frame] = nil
		else
			local m = en.Get() ~= en.Base
			if m ~= en.Mod then en.Mod = m changed = true end
			if m then count += 1 end
			local want = (m and Library.ModDots ~= false) and 0.05 or 1
			if en.Shown ~= want then
				en.Shown = want
				if en.Dot.Parent then tween(en.Dot, { BackgroundTransparency = want }, 0.2) end
			end
		end
	end
	local oldCount = Library.ModCount
	Library.ModCount = count
	if count ~= oldCount then Library:_paintModChip() end
	if changed and Library.ModFilter then
		local w = Library.Window
		if w and Library._applySearch then pcall(Library._applySearch, w, w.Search and w.Search.Text or "") end
	end
	return count
end

function Library:_startModWatcher()
	if Library._modWatching then return end
	Library._modWatching = true
	local token = (Library._modToken or 0) + 1
	Library._modToken = token
	task.spawn(function()
		while Library._modToken == token do
			task.wait(0.3)
			local w = Library.Window
			if w and w.Open ~= false and #Library.ModEntries > 0 and not Library._listening then
				pcall(Library._refreshModified, Library)
			end
		end
	end)
end

function Library:SetModFilter(v)
	v = v and true or false
	if Library.ModFilter == v then return end
	Library.ModFilter = v
	Library._modExpandOnce = v
	Library:_refreshModified()
	Library:_paintModChip()
	local w = Library.Window
	if w and Library._applySearch then pcall(Library._applySearch, w, w.Search and w.Search.Text or "") end
	local it = Library._modFilterItem
	if it then
		local ok, cur = pcall(it.Get)
		if ok and cur ~= v then pcall(it.Set, it, v) end
	end
end

function Library:GetModified()
	local out = {}
	for _, en in ipairs(Library.ModEntries) do
		if en.Frame and en.Frame.Parent and en.Get() ~= en.Base then out[#out + 1] = en.Name end
	end
	return out
end

function Library:SetModBaseline()
	for _, en in ipairs(Library.ModEntries) do en.Base = en.Get() end
	Library:_refreshModified()
end

-- ============================================================================
-- RÉINITIALISER LES CONTRÔLES DU SCRIPT  (Paramètres > Fenêtre > « Réinitialiser les contrôles »)
--   • Keybinds   : touche retirée (« Aucune »), y compris la touche liée à un toggle
--   • Toggles    : tous désactivés
--   • Sliders    : remis à leur valeur par défaut (curseurs simples et à deux poignées)
--   Library:ResetControls() -> nombre d'éléments modifiés. Les réglages de l'apparence (onglet Paramètres) ne sont pas touchés.
--   { Reset = false } sur un élément l'exclut.
-- ============================================================================
function Library:ResetControls()
	local n = 0
	Library._silentSound = (Library._silentSound or 0) + 1
	for i = #Library.ResetEntries, 1, -1 do
		local r = Library.ResetEntries[i]
		if not (r.Frame and r.Frame.Parent) then
			table.remove(Library.ResetEntries, i)   -- élément détruit
		else
			local it = r.Item
			if r.Kind == "Keybind" then
				local _, cur = pcall(function() return it.Get() end)
				if cur ~= Enum.KeyCode.Unknown then pcall(it.Set, it, Enum.KeyCode.Unknown) n += 1 end
			elseif r.Kind == "Toggle" then
				local _, cur = pcall(function() return it.Get() end)
				if cur then pcall(it.Set, it, false) n += 1 end
				if it.SetKey then   -- touche liée au toggle (option Keybind)
					local _, ck = pcall(function() return it.GetKey() end)
					if ck ~= Enum.KeyCode.Unknown then pcall(it.SetKey, it, Enum.KeyCode.Unknown) n += 1 end
				end
			elseif r.Kind == "DDKeys" then
				local _, cur = pcall(function() return it.Get() end)
				if type(cur) == "table" and next(cur) ~= nil then pcall(it.Set, it, {}) n += 1 end
			elseif r.Kind == "Slider" then
				local _, cur = pcall(function() return it.Get() end)
				if r.Default ~= nil and cur ~= r.Default then pcall(it.Set, it, r.Default) n += 1 end
			elseif r.Kind == "RangeSlider" then
				local _, cur = pcall(function() return it.Get() end)
				local d = r.Default
				if type(d) == "table" and (type(cur) ~= "table" or cur.Low ~= d.Low or cur.High ~= d.High) then
					pcall(it.Set, it, copyVal(d)) n += 1
				end
			end
		end
	end
	Library._silentSound = math.max((Library._silentSound or 1) - 1, 0)
	if Library.RefreshKeybindConflicts then pcall(function() Library:RefreshKeybindConflicts() end) end
	if Library._hudRefresh then pcall(Library._hudRefresh) end
	return n
end

-- ============================================================================
-- CONFLITS DE KEYBINDS : deux éléments qui utilisent la même touche
--   Pastille « ! » orange sur les lignes concernées (survol = avec qui), notification quand on change une touche,
--   résumé dans Paramètres > Raccourcis clavier. Library.KeybindConflictWarn = false pour couper.
--   Library:GetKeybindConflicts() -> { ["F"] = { entrée, entrée }, ... }
-- ============================================================================
function Library:GetKeybindConflicts()
	local byKey, out = {}, {}
	for _, e in ipairs(Library.KeybindEntries) do
		if e.Frame and e.Frame.Parent and e.Item and e.Item.Get then
			local ok, k = pcall(e.Item.Get)
			if ok and typeof(k) == "EnumItem" and k ~= Enum.KeyCode.Unknown and k.Name ~= "None" then
				local l = byKey[k.Name]
				if not l then
					l = {}
					byKey[k.Name] = l
				end
				l[#l + 1] = e
			end
		end
	end
	for name, l in pairs(byKey) do
		if #l > 1 then out[name] = l end
	end
	return out
end

function Library:RefreshKeybindConflicts()
	local conf = Library:GetKeybindConflicts()
	local info = {}
	if Library.KeybindConflictWarn ~= false then
		for keyName, list in pairs(conf) do
			for _, e in ipairs(list) do
				local others = {}
				for _, x in ipairs(list) do
					if x ~= e then others[#others + 1] = tostring(x.Name) end
				end
				info[e] = "Même touche (" .. keyName .. ") que : " .. table.concat(others, ", ")
			end
		end
	end
	for _, e in ipairs(Library.KeybindEntries) do
		local fr = e.Frame
		if fr and fr.Parent then
			local text = info[e]
			local badge = fr:FindFirstChild("KbConflict")
			if badge and badge:GetAttribute("Tip") ~= text then
				badge:Destroy()
				badge = nil
			end
			if text and not badge then
				badge = new("TextLabel", { Name = "KbConflict", AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, e.BadgeX or -104, 0.5, 0), Size = UDim2.fromOffset(18, 18),
					BackgroundColor3 = Library.NotifColors.Warning, Text = "!", TextColor3 = Color3.fromRGB(10, 10, 12),
					TextSize = 12, Font = F_BOLD, BorderSizePixel = 0, ZIndex = 8 }, fr)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, badge)
				badge:SetAttribute("Tip", text)
				attachTip(badge, text)
			end
		end
	end
	return conf
end

-- notification quand la touche qu'on vient de choisir est déjà prise (pas au chargement d'une config)
function Library:_notifyKeyConflict(frame, k)
	if Library.KeybindConflictWarn == false then return end
	if (Library._silentSound or 0) > 0 or (Library._restoring or 0) > 0 then return end
	if typeof(k) ~= "EnumItem" or k == Enum.KeyCode.Unknown then return end
	local list = Library:GetKeybindConflicts()[k.Name]
	if not list then return end
	local mine, others = nil, {}
	for _, e in ipairs(list) do
		if e.Frame == frame then mine = e else others[#others + 1] = "« " .. tostring(e.Name) .. " »" end
	end
	if not mine or #others == 0 then return end
	Library:Notify({ Title = "Conflit de touche", Type = "Warning", Duration = 6, _noMute = true,
		Content = "« " .. tostring(mine.Name) .. " » et " .. table.concat(others, ", ") .. " utilisent la même touche ("
			.. k.Name .. ")." })
end

-- ============================================================================
-- HUD DES ACTIFS : petit panneau déplaçable (glisser à la souris / au doigt) qui liste les toggles activés,
-- avec leur touche si le toggle en a une (CreateToggle({ Keybind = Enum.KeyCode.X })).
--   Toggle { HUD = false } : caché du panneau.  Réglages : Paramètres > HUD des actifs.
--   Library:SetHud(v) / SetHudKeys(v) / SetHudScale(0.6..1.6) / SetHudOnlyClosed(v) / ResetHudPosition()
-- ============================================================================
local hud = { rows = {} }

local function hudShown()
	if not Library.HudEnabled then return false end
	local w = Library.Window
	if Library.HudOnlyClosed and w and w.Open then return false end
	return true
end

-- Position enregistrée = POINT D'ANCRAGE en pixels écran + coin d'ancrage (Ax / Ay = 0 ou 1).
-- Le HUD est ancré par le coin le plus proche d'un bord de l'écran : quand une ligne apparaît ou disparaît, il
-- s'agrandit vers l'intérieur de l'écran, son coin ancré ne bouge jamais (plus de décalage ni de « saut »).
-- Anciennes sauvegardes { X, Y } : lues comme un ancrage en haut à gauche.
local function hudSaved()
	local p = Library.HudPos
	if type(p) == "table" and tonumber(p.X) and tonumber(p.Y) then
		return tonumber(p.X), tonumber(p.Y), ((tonumber(p.Ax) or 0) >= 1) and 1 or 0, ((tonumber(p.Ay) or 0) >= 1) and 1 or 0
	end
	return 16, 120, 0, 0
end

-- applique la position enregistrée (sans jamais la modifier : le garde-fou « dans l'écran » ne touche que l'affichage)
local function hudPlace()
	local card = hud.card
	if not card then return end
	local px, py, ax, ay = hudSaved()
	local vp, sz = viewport(), card.AbsoluteSize
	local left = math.clamp(px - ax * sz.X, 0, math.max(vp.X - sz.X, 0))
	local top = math.clamp(py - ay * sz.Y, 0, math.max(vp.Y - sz.Y, 0))
	card.AnchorPoint = Vector2.new(ax, ay)
	card.Position = UDim2.fromOffset(left + ax * sz.X, top + ay * sz.Y)
end

-- place le HUD à partir de son coin haut-gauche (glisser) ; save = enregistre le nouvel ancrage
local function hudPlaceTL(left, top, save)
	local card = hud.card
	if not card then return end
	local vp, sz = viewport(), card.AbsoluteSize
	left = math.clamp(left, 0, math.max(vp.X - sz.X, 0))
	top = math.clamp(top, 0, math.max(vp.Y - sz.Y, 0))
	local ax = (left + sz.X / 2 > vp.X / 2) and 1 or 0
	local ay = (top + sz.Y / 2 > vp.Y / 2) and 1 or 0
	local px, py = left + ax * sz.X, top + ay * sz.Y
	card.AnchorPoint = Vector2.new(ax, ay)
	card.Position = UDim2.fromOffset(px, py)
	if save then
		Library.HudPos = { X = math.floor(px + 0.5), Y = math.floor(py + 0.5), Ax = ax, Ay = ay }
		Library.Flags["ui.hudpos"] = Library.HudPos
	end
end

-- coin haut-gauche actuel, calculé à partir de Position / AnchorPoint (notre propre repère)
local function hudTopLeft()
	local card = hud.card
	local sz = card.AbsoluteSize
	return card.Position.X.Offset - card.AnchorPoint.X * sz.X, card.Position.Y.Offset - card.AnchorPoint.Y * sz.Y
end

function Library:_hudPlace()
	hudPlace()
end

local HUD_PAD = 13   -- marge gauche / droite de la carte

local function hudMeasure(text, size, font)
	local ok, v = pcall(function()
		return game:GetService("TextService"):GetTextSize(tostring(text), size, font, Vector2.new(1000, 100))
	end)
	if ok and v then return v.X end
	return #tostring(text) * size * 0.6
end

local function ensureHud()
	if hud.gui and hud.gui.Parent then return end
	hud.gui = new("ScreenGui", { Name = "SolarisHud", ResetOnSpawn = false, DisplayOrder = 900,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, Enabled = false })
	mount(hud.gui)
	-- largeur calculée (tween), hauteur automatique : les lignes ont une taille fixe, rien ne « danse »
	local card = new("Frame", { Name = "Card", Size = UDim2.new(0, 120, 0, 0), AutomaticSize = AY,
		BackgroundColor3 = T.Main, BackgroundTransparency = 0.08, BorderSizePixel = 0, Active = true }, hud.gui)
	new("UICorner", { CornerRadius = UDim.new(0, 16) }, card)
	new("UIStroke", { Color = T.Accent, Thickness = 1, Transparency = 0.84, ApplyStrokeMode = BORDER }, card)
	hud.scale = new("UIScale", { Scale = Library.HudScale or 1 }, card)
	new("UIPadding", { PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, HUD_PAD),
		PaddingRight = UDim.new(0, HUD_PAD) }, card)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = BYORDER }, card)
	hud.title = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14),
		Text = "ACTIFS", TextColor3 = T.Text, TextTransparency = 0.45,
		TextSize = 10, Font = F_BOLD, TextXAlignment = LEFT, LayoutOrder = 0 }, card)
	hud.empty = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18),
		Text = "Aucun actif", TextColor3 = T.Text, TextTransparency = 0.55,
		TextSize = 12, Font = F_REG, TextXAlignment = LEFT, LayoutOrder = 1 }, card)
	hud.card = card
	-- glisser pour déplacer
	card.InputBegan:Connect(function(i)
		if not isPress(i) then return end
		local start = Vector2.new(i.Position.X, i.Position.Y)
		local ox, oy = hudTopLeft()   -- lu depuis Position / AnchorPoint (jamais depuis AbsolutePosition : pas de dérive)
		startDrag(function(p)
			local d = Vector2.new(p.X, p.Y) - start
			hudPlaceTL(ox + d.X, oy + d.Y, false)
		end, nil, i.Position, function()
			local lx, ly = hudTopLeft()
			hudPlaceTL(lx, ly, true)
		end)
	end)
	local cam = workspace.CurrentCamera
	if cam then
		track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() hudPlace() end))
	end
	hudPlace()
end

-- touche affichée pour une ligne : 1) celle du toggle (Keybind = ...) · 2) HudKey donné à la main (item / Enum.KeyCode /
-- fonction) · 3) un Block:CreateKeybind portant le même nom (de préférence dans le même bloc)
local HUD_STRIP = { "%(touche%)", "touche", "keybind", "raccourci", "bind", "key" }
local function hudNorm(s)
	s = string.lower(tostring(s or ""))
	for _, w in ipairs(HUD_STRIP) do
		s = string.gsub(s, w, " ")
	end
	s = string.gsub(s, "[%s%p]+", " ")
	return string.match(s, "^%s*(.-)%s*$") or ""
end

local function hudKeyOf(e)
	local function valid(k)
		if typeof(k) == "EnumItem" and k ~= Enum.KeyCode.Unknown then return k end
		return nil
	end
	local it = e.Item
	if it and type(it.GetKey) == "function" then
		local ok, k = pcall(it.GetKey)
		if ok and valid(k) then return k end
	end
	local hk = e.HudKey
	if hk ~= nil then
		local k = hk
		if type(hk) == "function" then
			local ok, r = pcall(hk)
			k = ok and r or nil
		elseif type(hk) == "table" then
			local g = hk.GetKey or hk.Get
			if type(g) == "function" then
				local ok, r = pcall(g, hk)
				k = ok and r or nil
			else
				k = nil
			end
		end
		if valid(k) then return k end
	end
	local nt = hudNorm(e.Name)
	if #nt < 2 then return nil end
	local best, bestScore
	for _, ke in ipairs(Library.KeybindEntries) do
		local kit = ke.Item
		if kit and type(kit.Get) == "function" and ke.Frame and ke.Frame.Parent then
			local ok, k = pcall(kit.Get)
			if ok and valid(k) then
				local nk = hudNorm(ke.Name)
				local score = 0
				if nk ~= "" then
					if nk == nt then
						score = 2
					elseif #nt >= 3 and #nk >= 3 and (string.find(nk, nt, 1, true) or string.find(nt, nk, 1, true)) then
						score = 1
					end
				end
				if score > 0 then
					if ke.Block == e.Block then score += 2 end
					if not bestScore or score > bestScore then best, bestScore = k, score end
				end
			end
		end
	end
	return best
end

local function hudRow(entry)
	local row = new("Frame", { Name = "Row", Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
		ClipsDescendants = true }, hud.card)
	local dot = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(7, 7), BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0 }, row)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	local name = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 15, 0, 0),
		Size = UDim2.new(1, -15, 1, 0), Text = entry.Name, TextColor3 = T.Text, TextTransparency = 1,
		TextSize = 13, Font = F_MED, TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd }, row)
	-- la touche : puce alignée à droite (une colonne propre, quelle que soit la longueur des noms)
	local chip = new("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 18), BackgroundColor3 = T.Text, BackgroundTransparency = 1, Text = "",
		TextColor3 = T.Text, TextTransparency = 1, TextSize = 10, Font = F_BOLD, Visible = false,
		BorderSizePixel = 0 }, row)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, chip)
	tween(row, { Size = UDim2.new(1, 0, 0, 22) }, 0.22)
	tween(dot, { BackgroundTransparency = 0 }, 0.25)
	tween(name, { TextTransparency = 0 }, 0.25)
	tween(chip, { BackgroundTransparency = 0.88, TextTransparency = 0 }, 0.25)
	return { f = row, dot = dot, name = name, chip = chip }
end

local function hudRefresh()
	local shown = hudShown()
	if shown then ensureHud() end
	if not hud.gui then return end
	hud.gui.Enabled = shown
	if not shown then return end
	hud.scale.Scale = Library.HudScale or 1

	local want, count, maxW = {}, 0, 0
	for order, e in ipairs(Library.ToggleEntries) do
		if e.Frame and e.Frame.Parent then
			local ok, on = pcall(e.Item.Get)
			if ok and on then
				count += 1
				want[e] = true
				local r = hud.rows[e]
				if not r then
					r = hudRow(e)
					hud.rows[e] = r
				end
				r.f.LayoutOrder = 10 + order
				r.name.Text = e.Name
				local key = (Library.HudShowKeys ~= false) and hudKeyOf(e) or nil
				local chipW = 0
				if key then
					r.chip.Text = shortKey(key) or key.Name
					chipW = math.ceil(hudMeasure(r.chip.Text, r.chip.TextSize, r.chip.Font)) + 14
					r.chip.Size = UDim2.fromOffset(chipW, 18)
					r.chip.Visible = true
				else
					r.chip.Text = ""
					r.chip.Visible = false
				end
				local reserve = key and (chipW + 10) or 0
				r.name.Size = UDim2.new(1, -(15 + reserve), 1, 0)
				local nameW = math.ceil(hudMeasure(e.Name, r.name.TextSize, r.name.Font))
				maxW = math.max(maxW, 15 + nameW + reserve)
			end
		end
	end
	for e, r in pairs(table.clone(hud.rows)) do
		if not want[e] then
			hud.rows[e] = nil
			tween(r.f, { Size = UDim2.new(1, 0, 0, 0) }, 0.2)
			tween(r.dot, { BackgroundTransparency = 1 }, 0.2)
			tween(r.name, { TextTransparency = 1 }, 0.2)
			tween(r.chip, { BackgroundTransparency = 1, TextTransparency = 1 }, 0.2)
			task.delay(0.24, function() r.f:Destroy() end)
		end
	end
	hud.empty.Visible = count == 0
	hud.title.Text = count > 0 and ("ACTIFS · " .. count) or "ACTIFS"
	local inner = math.max(maxW, hudMeasure(hud.title.Text, hud.title.TextSize, hud.title.Font),
		count == 0 and hudMeasure(hud.empty.Text, hud.empty.TextSize, hud.empty.Font) or 0, 90)
	local w = math.min(math.ceil(inner) + HUD_PAD * 2 + 2, 380)
	tween(hud.card, { Size = UDim2.new(0, w, 0, 0) }, 0.2)
	-- garde-fou : si le HUD dépasse de l'écran, on le ramène (affichage seulement, la position enregistrée ne change pas)
	task.spawn(function()
		RunService.Heartbeat:Wait()
		hudPlace()
		task.wait(0.3)
		hudPlace()
	end)
end

local hudPending = false
Library._hudRefresh = function()
	if hudPending then return end
	hudPending = true
	task.defer(function()
		hudPending = false
		pcall(hudRefresh)
	end)
end

function Library:SetHud(v) Library.HudEnabled = v and true or false Library._hudRefresh() end
function Library:SetHudKeys(v) Library.HudShowKeys = v and true or false Library._hudRefresh() end
function Library:SetHudOnlyClosed(v) Library.HudOnlyClosed = v and true or false Library._hudRefresh() end
function Library:SetHudScale(s)
	Library.HudScale = math.clamp(tonumber(s) or 1, 0.6, 1.6)
	Library._hudRefresh()
end
function Library:ResetHudPosition()
	Library.HudPos = nil
	Library.Flags["ui.hudpos"] = nil
	hudPlace()
end
Library._destroyHud = function()
	if hud.gui then pcall(function() hud.gui:Destroy() end) end
	hud = { rows = {} }
end

-- Bouton à double confirmation : CreateButton({ Confirm = true }) ou CreateConfirmButton(...)
function Block:CreateConfirmButton(o)
	o = o or {}
	o.Confirm = true
	return self:CreateButton(o)
end
Block.CreateSeparator = Block.CreateDivider

-- Va jusqu'à un élément : sélectionne son onglet, déplie son bloc, fait défiler jusqu'à sa ligne et la fait clignoter
function Library:RevealElement(e)
	local w = Library.Window
	if not (w and e and e.Tab and e.Block and e.Frame and e.Frame.Parent) then return false end
	if w.Search and w.Search.Text ~= "" then w.Search.Text = "" end   -- un filtre actif pourrait cacher la ligne
	if w.Current ~= e.Tab then e.Tab:Select() end
	local blk, frame = e.Block, e.Frame
	local wasCollapsed = blk._isCollapsed and blk._isCollapsed()
	if wasCollapsed then blk:SetCollapsed(false) end
	task.spawn(function()
		task.wait(wasCollapsed and 0.45 or 0.12)
		-- plusieurs passes : corrige l'écart éventuel dû à l'échelle / aux animations
		for _ = 1, 3 do
			local sf = blk.Scroll
			if not (frame.Parent and sf and sf.Parent) then return end
			local sc = pxScale()
			local off = (frame.AbsolutePosition.Y - sf.AbsolutePosition.Y) / sc - 36
			if math.abs(off) <= 3 then break end
			local maxY = math.max(0, (sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y) / sc)
			local target = math.clamp(sf.CanvasPosition.Y + off, 0, maxY)
			if math.abs(target - sf.CanvasPosition.Y) < 1 then break end
			tween(sf, { CanvasPosition = Vector2.new(0, target) }, 0.3)
			task.wait(0.34)
		end
		if not frame.Parent then return end
		local ov = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
			BorderSizePixel = 0, ZIndex = 50 }, frame)
		new("UICorner", { CornerRadius = UDim.new(0, 8) }, ov)
		for _ = 1, 2 do
			if not ov.Parent then return end
			ov.BackgroundTransparency = 0.5
			tween(ov, { BackgroundTransparency = 1 }, 0.5)
			task.wait(0.6)
		end
		ov:Destroy()
	end)
	return true
end

-- Aides sur les onglets
function Tab:ClearBlocks()
	for _, b in ipairs(self.Blocks) do
		if b.Frame then b.Frame:Destroy() end
	end
	self.Blocks = {}
	self.DefaultBlock = nil
	self.Order = 0
end
-- tous les blocs de l'onglet, sous-onglets compris (recherche, tout replier...)
function Tab:_allBlocks()
	local out = {}
	for _, b in ipairs(self.Blocks) do out[#out + 1] = b end
	for _, s in ipairs(self.SubTabs or {}) do
		for _, b in ipairs(s.Blocks) do out[#out + 1] = b end
	end
	return out
end
function Tab:CollapseAll(c)
	for _, b in ipairs(self:_allBlocks()) do b:SetCollapsed(c ~= false) end
end
function Tab:ExpandAll() self:CollapseAll(false) end

-- ============================================================================
-- ONGLETS & BLOCS
-- ============================================================================
-- Colonne (1..n) d'un bloc : 2 colonnes = Side Left/Right comme avant, 3-4 colonnes = répartition à tour de rôle
function Tab:_columnFor(idx, side, n)
	n = n or self.NumCols or 1
	if n <= 1 then return 1 end
	if n == 2 then return side == "right" and 2 or 1 end
	return ((idx - 1) % n) + 1
end


-- ---------------------------------------------------------------------------
-- DISPOSITION DES BLOCS : où va chaque bloc, selon la disposition sauvegardée
-- ---------------------------------------------------------------------------
function Tab:_savedFor(n)
	local t = Library.BlockLayout[tostring(self.Name)]
	local s = type(t) == "table" and t[tostring(n)]
	if type(s) == "table" and next(s) then return s end
	return nil
end

-- renvoie (colonne, LayoutOrder) d'un bloc pour n colonnes
function Tab:_placeOf(b, n)
	n = n or self.NumCols
	local s = self:_savedFor(n)
	if s then
		local e = s[b.Key]
		if type(e) == "table" and tonumber(e.c) and tonumber(e.o) then
			return math.clamp(math.floor(e.c), 1, n), math.floor(e.o)
		end
		return self:_columnFor(b.Index, b.Side, n), 100000 + b.DefOrder   -- bloc jamais déplacé : en bas
	end
	return self:_columnFor(b.Index, b.Side, n), b.DefOrder
end

function Tab:_reapplyLayout()
	local n = self.NumCols
	if n < 1 then return end
	for _, b in ipairs(self.Blocks) do
		local ci, o = self:_placeOf(b, n)
		local col = self.Cols[ci]
		if col then
			if b.Frame.Parent ~= col then b.Frame.Parent = col end
			b.Frame.LayoutOrder = o
			b.Scroll = col
		end
	end
end

-- écrit la disposition actuelle de l'onglet (pour le nombre de colonnes affiché)
function Tab:_commitLayout()
	local n = self.NumCols
	local L = Library.BlockLayout
	local tk, ns = tostring(self.Name), tostring(n)
	if type(L[tk]) ~= "table" then L[tk] = {} end
	if type(L[tk][ns]) ~= "table" then L[tk][ns] = {} end
	local store = L[tk][ns]
	for ci, col in ipairs(self.Cols) do
		local list = {}
		for _, b in ipairs(self.Blocks) do
			if b.Frame.Parent == col then list[#list + 1] = b end
		end
		table.sort(list, function(a, c)
			if a.Frame.LayoutOrder ~= c.Frame.LayoutOrder then return a.Frame.LayoutOrder < c.Frame.LayoutOrder end
			return a.Index < c.Index
		end)
		for j, b in ipairs(list) do
			b.Frame.LayoutOrder = j
			b.Scroll = col
			store[b.Key] = { c = ci, o = j }
		end
	end
end

function Library:_reapplyLayouts()
	local w = Library.Window
	if not (w and w.Tabs) then return end
	for _, t in ipairs(w.Tabs) do
		t:_reapplyLayout()
		for _, s in ipairs(t.SubTabs or {}) do s:_reapplyLayout() end
	end
end

-- appelé par la restauration des réglages (clé « ui.blocklayout »)
function Library:_setBlockLayout(d)
	local L = Library.BlockLayout
	for k in pairs(L) do L[k] = nil end
	if type(d) == "table" then
		for tk, tv in pairs(d) do
			if type(tk) == "string" and type(tv) == "table" then L[tk] = copyVal(tv) end
		end
	end
	Library:_reapplyLayouts()
end

function Library:ResetBlockLayout(tabName)
	local L = Library.BlockLayout
	if tabName == nil then
		for k in pairs(L) do L[k] = nil end
	else
		L[tostring(tabName)] = nil
	end
	Library:_reapplyLayouts()
end

function Library:SetLayoutEdit(v)
	v = v and true or false
	Library.LayoutEdit = v
	local w = Library.Window
	if not (w and w.Tabs) then return end
	for _, t in ipairs(w.Tabs) do
		for _, b in ipairs(t:_allBlocks()) do
			if b._setEdit then b._setEdit(v) end
		end
	end
end

-- Glisser un bloc par son en-tête : un emplacement suit le curseur, le bloc « fantôme » est le curseur
function Library:_dragBlock(blk, startPos)
	local win, tab = Library.Window, blk.Tab
	if not (win and win.Gui) or Library._blockDragging then return end
	Library._blockDragging = true

	local inset = guiInset()
	local sc = pxScale()
	local frame = blk.Frame
	local fAbs, fSize = frame.AbsolutePosition, frame.AbsoluteSize
	local gx = math.clamp(startPos.X - fAbs.X, 12, math.max(12, fSize.X - 12))
	local headH = 34 * sc

	local last = startPos
	local moved = false
	local ghost, placeholder, hb
	local curCol, curAt

	local function create()
		moved = true
		placeholder = new("Frame", { Name = "BlockPlaceholder", Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, BorderSizePixel = 0 })
		new("UICorner", { CornerRadius = UDim.new(0, 10) }, placeholder)
		new("UIStroke", { Color = T.Accent, Transparency = 0.45, Thickness = 1.5, ApplyStrokeMode = BORDER }, placeholder)
		ghost = new("Frame", { Name = "BlockGhost", Size = UDim2.fromOffset(fSize.X, headH), ZIndex = 500,
			BackgroundColor3 = T.Second, BackgroundTransparency = 0.12, BorderSizePixel = 0 }, win.Gui)
		new("UICorner", { CornerRadius = UDim.new(0, math.floor(10 * sc)) }, ghost)
		new("UIStroke", { Color = T.Accent, Transparency = 0.2, Thickness = 1.5, ApplyStrokeMode = BORDER }, ghost)
		local lb = label(ghost, blk.Name, 13, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0),
			Font = F_BOLD, ZIndex = 501 })
		lb.TextSize = math.max(9, math.floor(13 * sc * (Library.FontScale or 1) + 0.5))
		frame.Visible = false
		uiSnd("fold")
	end

	local function step()
		Library._busyUntil = os.clock() + 0.3
		if not moved then
			if (last - startPos).Magnitude > 5 then create() else return end
		end
		local cur = Vector2.new(last.X, last.Y + inset.Y)
		ghost.Position = UDim2.fromOffset(cur.X - gx, cur.Y - headH / 2)

		-- colonne visée : la plus proche horizontalement
		local best, bd = 1, nil
		for i, col in ipairs(tab.Cols) do
			local ap, as = col.AbsolutePosition, col.AbsoluteSize
			local d = 0
			if cur.X < ap.X then d = ap.X - cur.X elseif cur.X > ap.X + as.X then d = cur.X - ap.X - as.X end
			if not bd or d < bd then best, bd = i, d end
		end
		local col = tab.Cols[best]

		-- défilement automatique près des bords
		local ap, as = col.AbsolutePosition, col.AbsoluteSize
		local edge = 46
		if cur.Y < ap.Y + edge then
			col.CanvasPosition = Vector2.new(0, math.max(0, col.CanvasPosition.Y - 14))
		elseif cur.Y > ap.Y + as.Y - edge then
			col.CanvasPosition = Vector2.new(0, col.CanvasPosition.Y + 14)
		end

		-- position d'insertion parmi les blocs visibles de la colonne
		local sibs = {}
		for _, b in ipairs(tab.Blocks) do
			if b ~= blk and b.Frame.Parent == col and b.Frame.Visible then sibs[#sibs + 1] = b end
		end
		table.sort(sibs, function(a, c)
			if a.Frame.LayoutOrder ~= c.Frame.LayoutOrder then return a.Frame.LayoutOrder < c.Frame.LayoutOrder end
			return a.Index < c.Index
		end)
		local at = #sibs + 1
		for k, b in ipairs(sibs) do
			local f = b.Frame
			if cur.Y < f.AbsolutePosition.Y + f.AbsoluteSize.Y / 2 then at = k break end
		end
		if col ~= curCol or at ~= curAt then
			curCol, curAt = col, at
			placeholder.Parent = col
			for k, b in ipairs(sibs) do b.Frame.LayoutOrder = (k < at) and k or (k + 1) end
			placeholder.LayoutOrder = at
		end
	end

	hb = RunService.Heartbeat:Connect(step)

	startDrag(function(p) last = p end, blk.Scroll, startPos, function()
		if hb then hb:Disconnect() hb = nil end
		Library._blockDragging = false
		if not moved then return end
		local pp, ps = placeholder.AbsolutePosition, placeholder.AbsoluteSize
		if curCol then
			frame.Parent = curCol
			frame.LayoutOrder = curAt
			blk.Scroll = curCol
		end
		frame.Visible = true
		placeholder:Destroy()
		tab:_commitLayout()
		-- le fantôme glisse vers l'emplacement puis disparaît
		tween(ghost, { Position = UDim2.fromOffset(pp.X, pp.Y), Size = UDim2.fromOffset(ps.X, ps.Y),
			BackgroundTransparency = 1 }, 0.2)
		for _, d in ipairs(ghost:GetDescendants()) do
			if d:IsA("TextLabel") then tween(d, { TextTransparency = 1 }, 0.18) end
			if d:IsA("UIStroke") then tween(d, { Transparency = 1 }, 0.18) end
		end
		local g = ghost
		task.delay(0.25, function() g:Destroy() end)
	end)
end

function Tab:_layoutColumns()
	local n, gap = self.NumCols, 10
	for i, c in ipairs(self.Cols) do
		c.Position = UDim2.new((i - 1) / n, (i - 1) * gap / n, 0, 0)
		c.Size = UDim2.new(1 / n, -gap * (n - 1) / n, 1, 0)
	end
end

-- Change le nombre de colonnes (1 à 4) et replace tous les blocs déjà créés
function Tab:SetColumns(n)
	n = math.clamp(math.floor(tonumber(n) or 1), 1, 4)
	for _, s in ipairs(self.SubTabs or {}) do s:SetColumns(n) end   -- les sous-onglets suivent
	if n == self.NumCols then return end
	self.NumCols = n
	self.TwoCols = n >= 2
	while #self.Cols < n do self.Cols[#self.Cols + 1] = self._newColumn() end
	for _, b in ipairs(self.Blocks) do
		local ci, o = self:_placeOf(b, n)
		local col = self.Cols[ci]
		if b.Frame.Parent ~= col then b.Frame.Parent = col end
		b.Frame.LayoutOrder = o
		b.Scroll = col
	end
	while #self.Cols > n do table.remove(self.Cols):Destroy() end
	self:_layoutColumns()
	self.ColL, self.ColR = self.Cols[1], self.Cols[math.min(2, n)]
end

function Tab:CreateBlock(o)
	o = o or {}
	local side = tostring(o.Side):lower() == "right" and "right" or "left"
	local idx = #self.Blocks + 1
	self.Order = (self.Order or 0) + 1
	-- clé stable du bloc (nom ; « #2 » si deux blocs portent le même nom dans l'onglet)
	local bkey = tostring(o.Name or "Block")
	do
		local used = {}
		for _, b in ipairs(self.Blocks) do used[b.Key] = true end
		local base, k = bkey, 1
		while used[bkey] do k += 1 bkey = base .. "#" .. k end
	end
	local defOrder = self.Order
	local colIdx, layoutOrder = self:_placeOf({ Key = bkey, Index = idx, Side = side, DefOrder = defOrder })
	local col = self.Cols[colIdx]

	local frame = new("Frame", {
		Name = "BlockBackground", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY,
		BackgroundColor3 = T.Second, BackgroundTransparency = 0.35, BorderSizePixel = 0, LayoutOrder = layoutOrder,
	}, col)
	corner(frame, 10)
	trackStyled(frame, stroke(frame, 0.9), "block")
	new("UIListLayout", { SortOrder = BYORDER }, frame)

	local head = new("TextButton", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, LayoutOrder = 1 }, frame)
	local x = 12
	if o.ImageID and o.ImageID ~= "" then
		new("ImageLabel", { BackgroundTransparency = 1, Image = o.ImageID, ImageColor3 = T.Text,
			Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 12, 0.5, -8) }, head)
		x = 34
	end
	label(head, o.Name or "Block", 13, { Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -x - 32, 1, 0),
		Font = F_BOLD })
	local arrow = label(head, ">", 13, { Position = UDim2.new(1, -28, 0, 0), Size = UDim2.new(0, 16, 1, 0),
		TextXAlignment = CENTER, Font = F_BOLD, TextColor3 = T.ElementAccent, Rotation = 90 })
	fadeLine(head, { Position = UDim2.new(0, 10, 1, -1), Size = UDim2.new(1, -20, 0, 1) })

	-- Corps repliable (animé)
	local clip = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
		ClipsDescendants = true, LayoutOrder = 2, BorderSizePixel = 0 }, frame)
	local body = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1 }, clip)
	local lay = new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = BYORDER }, body)
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }, body)

	local flagKey = "__block:" .. tostring(self.Name or "Tab") .. "/" .. tostring(o.Name or "Block")
	local collapsed = false
	local function setCollapsed(c)
		if c == collapsed then return end
		collapsed = c
		Library.Flags[flagKey] = c
		tween(arrow, { Rotation = c and 0 or 90 }, 0.3)
		Library._busyUntil = os.clock() + 0.45
		local sc = pxScale()
		local h = body.AbsoluteSize.Y / sc
		if h < 1 then
			-- bloc replié : AbsoluteSize peut valoir 0, on mesure via le layout (14 = padding haut 6 + bas 8)
			h = lay.AbsoluteContentSize.Y / sc + 14
		end
		local fullyOpen = clip.AutomaticSize ~= AN
		clip.AutomaticSize = AN
		if c then
			if fullyOpen then clip.Size = UDim2.new(1, 0, 0, h) end
			tween(clip, { Size = UDim2.new(1, 0, 0, 0) }, 0.36)
		else
			local tw = tween(clip, { Size = UDim2.new(1, 0, 0, h) }, 0.36)
			tw.Completed:Connect(function(state)
				if state == Enum.PlaybackState.Completed and not collapsed then
					clip.AutomaticSize = AY
					clip.Size = UDim2.new(1, 0, 0, 0)
				end
			end)
		end
	end
	head.MouseButton1Click:Connect(function()
		if Library.LayoutEdit then return end   -- en mode édition l'en-tête sert à déplacer le bloc
		uiSnd("fold") setCollapsed(not collapsed)
	end)
	if o.Collapsed then
		collapsed = true
		clip.AutomaticSize = AN
		clip.Size = UDim2.new(1, 0, 0, 0)
		arrow.Rotation = 0
	end

	local blk = setmetatable({
		Frame = frame, Body = body, Scroll = col, Tab = self, Name = o.Name or "Block", Side = side, Index = idx,
		Key = bkey, DefOrder = defOrder,
		Entries = {}, _collapse = setCollapsed, _isCollapsed = function() return collapsed end,
	}, Block)
	self.Blocks[#self.Blocks + 1] = blk
	Library.Flags[flagKey] = collapsed
	Library.Items[flagKey] = {
		Get = function() return collapsed end,
		Set = function(_, v) setCollapsed(v and true or false) end,
	}

	-- Mode édition de la disposition : poignée ⠿ à la place de la flèche + en-tête surligné, glisser pour déplacer
	do
		local overlay = new("Frame", { Name = "EditOverlay", Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6),
			BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 0 }, head)
		new("UICorner", { CornerRadius = UDim.new(0, 8) }, overlay)
		local grip = new("Frame", { Name = "Grip", BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16),
			Position = UDim2.new(1, -28, 0.5, -8), Visible = false }, head)
		for cx = 0, 1 do
			for ry = 0, 2 do
				local dot = new("Frame", { Size = UDim2.fromOffset(3, 3), Position = UDim2.fromOffset(3 + cx * 7, 2 + ry * 5),
					BackgroundColor3 = T.Text, BorderSizePixel = 0 }, grip)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
			end
		end
		blk._setEdit = function(on)
			overlay.BackgroundColor3 = T.Accent
			overlay.Visible = true
			tween(overlay, { BackgroundTransparency = on and 0.9 or 1 }, 0.25)
			task.delay(on and 0 or 0.26, function() if Library.LayoutEdit == on then overlay.Visible = on end end)
			grip.Visible = on
			arrow.Visible = not on
		end
		head.InputBegan:Connect(function(i)
			if Library.LayoutEdit and isPress(i) then Library:_dragBlock(blk, i.Position) end
		end)
		if Library.LayoutEdit then blk._setEdit(true) end
	end
	return blk
end

-- Recherche globale : filtre les éléments de tous les onglets
local function applySearch(win, q)
	q = string.lower(q or "")
	local mf = Library.ModFilter == true
	local active = q ~= "" or mf
	local expand = mf and Library._modExpandOnce
	Library._modExpandOnce = nil
	local firstHit, curHit
	for _, tab in ipairs(win.Tabs) do
		local total = 0
		for _, blk in ipairs(tab:_allBlocks()) do
			local blockHit = q ~= "" and string.find(string.lower(blk.Name), q, 1, true) ~= nil
			local n = 0
			for _, e in ipairs(blk.Entries) do
				local vis = true
				if active then
					if q ~= "" then
						vis = blockHit or (e.Name ~= "" and string.find(string.lower(e.Name), q, 1, true) ~= nil)
					end
					if vis and mf then vis = Library:_isModifiedFrame(e.Frame) end
				end
				e.Frame.Visible = vis
				if active and vis then n = n + 1 end
			end
			local show = (not active) or n > 0 or (blockHit and not mf)
			blk.Frame.Visible = show
			if active and show then total = total + math.max(n, 1) end
			if expand and n > 0 and blk._isCollapsed and blk._isCollapsed() then blk:SetCollapsed(false) end
		end
		tab._hits = active and total or 0
		tween(tab.Dot, { BackgroundTransparency = (active and total > 0) and 0.1 or 1 }, 0.25)
		tween(tab.Label, { TextTransparency = (active and total == 0) and 0.6 or 0 }, 0.25)
		if active and total > 0 and not firstHit then firstHit = tab end
		if tab == win.Current then curHit = total > 0 end
	end
	-- onglets parents : pastille allumée (et dépliés pendant une recherche) si un de leurs enfants a un résultat
	for i = #win.Tabs, 1, -1 do   -- les enfants sont créés après leur parent : on remonte du dernier au premier
		local t = win.Tabs[i]
		local p = t.ParentTab
		if p and active and (t._hits or 0) > 0 then
			if (p._hits or 0) == 0 then
				tween(p.Dot, { BackgroundTransparency = 0.1 }, 0.25)
				tween(p.Label, { TextTransparency = 0 }, 0.25)
			end
			p._hits = (p._hits or 0) + t._hits
			if q ~= "" then p:SetExpanded(true) end
		end
	end
	if active and firstHit and not curHit then firstHit:Select() end
end
Library._applySearch = applySearch

-- Transition d'onglet (Paramètres > Animations & performances > « Transition des onglets »)
--   Glisser (défaut) : la page glisse de 16 px · Fondu : la page sort doucement du voile · Zoom : la page grossit depuis son centre
Library.TabTransitions = { "Glisser", "Fondu", "Zoom" }
Library.TabTransition = "Glisser"
function Library:SetTabTransition(n)
	for _, v in ipairs(Library.TabTransitions) do
		if v == n then
			Library.TabTransition = n
			return true
		end
	end
	return false
end

function Window:CreateTab(name, _, icon, parentTab)
	local win = self
	-- parentTab (optionnel, interne) : fait de cet onglet un ENFANT déplié sous parentTab (voir Tab:CreateChildTab)
	local depth = parentTab and ((parentTab.Depth or 0) + 1) or 0
	local fullName = parentTab and (tostring(parentTab.Name) .. " / " .. tostring(name or "Tab")) or name
	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, parentTab and 30 or 34), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, ClipsDescendants = true,
		-- ordre pair = onglet, ordre impair juste après = son conteneur d'enfants
		LayoutOrder = parentTab and ((#parentTab.Children + 1) * 2) or ((#self.Tabs + 1) * 2),
	}, parentTab and parentTab:_childHolder() or self.Sidebar)
	new("UICorner", { CornerRadius = UDim.new(0, 8) }, btn)
	local bar = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 3, 0, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, btn)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local dot = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0, 5, 0, 5), BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0 }, btn)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	local x0 = 12 + depth * 10        -- retrait des onglets enfants
	local x = x0
	if icon and icon ~= "" then
		new("ImageLabel", { BackgroundTransparency = 1, Image = icon, ImageColor3 = T.Text,
			Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, x0, 0.5, -8) }, btn)
		x = x0 + 22
	end
	local txt = label(btn, name or "Tab", parentTab and 12 or 13, { Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -x - 14, 1, 0),
		TextColor3 = T.ElementAccent })

	local page = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false }, self.Content)

	local function newColumn()
		local sf = new("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0), Visible = not page:GetAttribute("HasSubs"),
			BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent,
			ScrollBarImageTransparency = 0.5, CanvasSize = UDim2.new(), AutomaticCanvasSize = AY,
		}, page)
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = BYORDER }, sf)
		new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingTop = UDim.new(0, 2) }, sf)
		return sf
	end

	local tab = setmetatable({ Name = fullName, Page = page, Button = btn, Blocks = {}, Cols = {}, NumCols = 0,
		_newColumn = newColumn, Win = win, ParentTab = parentTab, Depth = depth, Children = {}, Expanded = false }, Tab)
	tab:SetColumns(self.EffCols or (self.TwoCols and 2 or 1))

	function tab:Select()
		for _, t in ipairs(win.Tabs) do
			if t ~= tab then
				t.Page.Visible = false
				tween(t.Bar, { Size = UDim2.new(0, 3, 0, 0) }, 0.25)
				tween(t.Button, { BackgroundTransparency = 1 }, 0.25)
				tween(t.Label, { TextColor3 = T.ElementAccent }, 0.25)
			end
		end
		-- les parents d'un onglet enfant se déplient et restent « allumés » tant qu'il est actif
		do
			local p = tab.ParentTab
			while p do
				p:SetExpanded(true)
				tween(p.Label, { TextColor3 = T.Text }, 0.25)
				tween(p.Bar, { Size = UDim2.new(0, 3, 0, 8) }, 0.35)
				p = p.ParentTab
			end
		end
		page.Visible = true
		Library._busyUntil = os.clock() + 0.55
		tween(bar, { Size = UDim2.new(0, 3, 0, 16) }, 0.45, BACK)
		tween(btn, { BackgroundTransparency = 0.92 }, 0.25)
		tween(txt, { TextColor3 = T.Text }, 0.25)
		if Library._openDD then Library._openDD(false) end

		-- transition : la page sort de l'ombre (glisser / fondu / zoom, au choix dans les Paramètres)
		if win.Current ~= tab and win.Veil then
			local mode = Library.TabTransition
			local zoom = page:FindFirstChild("TabZoom")
			page.AnchorPoint = Vector2.new(0, 0)
			page.Position = UDim2.new(0, 0, 0, 0)
			if zoom then zoom.Scale = 1 end
			local fadeT = 0.42
			if mode == "Zoom" then
				if not zoom then zoom = new("UIScale", { Name = "TabZoom", Scale = 1 }, page) end
				page.AnchorPoint = Vector2.new(0.5, 0.5)
				page.Position = UDim2.new(0.5, 0, 0.5, 0)   -- page pleine taille : identique à (0, 0) quand l'échelle vaut 1
				zoom.Scale = 0.9
				tween(zoom, { Scale = 1 }, 0.5, BACK)
			elseif mode == "Fondu" then
				fadeT = 0.6
			else
				page.Position = UDim2.new(0, 16, 0, 0)
				tween(page, { Position = UDim2.new(0, 0, 0, 0) }, 0.5)
			end
			win.VeilToken = (win.VeilToken or 0) + 1
			local my = win.VeilToken
			win.Veil.Visible = true
			win.Veil.BackgroundTransparency = Sty.VeilTr
			local tw = tween(win.Veil, { BackgroundTransparency = 1 }, fadeT)
			tw.Completed:Connect(function()
				if win.VeilToken == my then win.Veil.Visible = false end
			end)
		end
		win.Current = tab
		if Library._settingsReady then Library.Flags["ui.lasttab"] = tostring(tab.Name) end   -- mémorisé (sauvegarde auto)
		if tab.OnSelect then tab.OnSelect() end
	end
	tab.Bar, tab.Label, tab.Dot = bar, txt, dot
	btn.MouseEnter:Connect(function()
		if win.Current ~= tab then uiSnd("tabhover") tween(btn, { BackgroundTransparency = 0.95 }, 0.2) end
		if not txt:GetAttribute("BaseX") then txt:SetAttribute("BaseX", txt.Position.X.Offset) end
		tween(txt, { Position = UDim2.new(0, txt:GetAttribute("BaseX") + 4, 0, 0) }, 0.25)
	end)
	btn.MouseLeave:Connect(function()
		if win.Current ~= tab then tween(btn, { BackgroundTransparency = 1 }, 0.25) end
		local bx = txt:GetAttribute("BaseX")
		if bx then tween(txt, { Position = UDim2.new(0, bx, 0, 0) }, 0.3) end
	end)
	btn.MouseButton1Click:Connect(function()
		ripple(btn)
		local was = win.Current == tab
		if not was then uiSnd("tab") end
		tab:Select()
		if tab._holder then
			if was then tab:SetExpanded(not tab.Expanded)   -- déjà actif : plier / déplier
			else tab:SetExpanded(true) end                  -- sinon : l'afficher et déplier
		end
	end)

	table.insert(self.Tabs, tab)
	if parentTab then table.insert(parentTab.Children, tab) end
	if not self.Current and not self._noSelect then tab:Select() end
	-- on rouvre l'onglet qui était affiché la dernière fois (sans animation de transition)
	if Library._lastTab and not self._noSelect and self.Current ~= tab and tostring(tab.Name) == Library._lastTab then
		local veil = self.Veil
		self.Veil = nil
		pcall(tab.Select, tab)
		self.Veil = veil
	end
	return tab
end

-- ============================================================================
-- SOUS-ONGLETS : une barre de pastilles en haut d'un onglet, chaque pastille ouvre sa propre page de blocs
--   local subs = tab:CreateSubTabs({ "Combat", "Visuel", { Name = "Divers", Icon = "rbxassetid://..." } })
--   subs[1]:CreateBlock({ Name = "...", Side = "Left" })   -- ou subs.Combat / tab:GetSubTab("Combat")
--   Chaque sous-onglet se comporte comme un onglet (CreateBlock, CreateToggle direct, ClearBlocks...).
--   subs[2]:Select() / tab:SelectSub("Visuel").  Les blocs des sous-onglets sont inclus dans la recherche,
--   « tout replier » et les favoris. Les blocs créés directement sur l'onglet parent ne sont plus affichés.
-- ============================================================================
function Tab:CreateSubTabs(list)
	local parent = self
	if parent.SubTabs and #parent.SubTabs > 0 then return parent.SubTabs end
	parent.SubTabs = {}
	parent.Page:SetAttribute("HasSubs", true)
	for _, c in ipairs(parent.Cols) do c.Visible = false end

	local strip = new("ScrollingFrame", { Name = "SubTabs", Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X }, parent.Page)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
		SortOrder = BYORDER, VerticalAlignment = Enum.VerticalAlignment.Center }, strip)
	new("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 1) }, strip)

	local function select(sub)
		for _, s in ipairs(parent.SubTabs) do
			local on = s == sub
			if on then
				if not s.Page.Visible then
					s.Page.Position = UDim2.new(0, 12, 0, 36)
					tween(s.Page, { Position = UDim2.new(0, 0, 0, 36) }, 0.4)
				end
				s.Page.Visible = true
			else
				s.Page.Visible = false
			end
			tween(s.Pill, { BackgroundTransparency = on and 0.8 or 0.94 }, 0.2)
			tween(s.PillStroke, { Transparency = on and 0.35 or 0.9 }, 0.2)
			tween(s.PillLabel, { TextColor3 = on and T.Text or T.ElementAccent }, 0.2)
		end
		parent.CurrentSub = sub
		Library._busyUntil = os.clock() + 0.5
		if Library._openDD then Library._openDD(false) end
	end

	for idx, d in ipairs(list or {}) do
		local name = type(d) == "table" and tostring(d.Name or d[1] or ("Page " .. idx)) or tostring(d)
		local icon = type(d) == "table" and d.Icon or nil
		local pill = new("TextButton", { Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = T.Accent, BackgroundTransparency = 0.94, Text = "", AutoButtonColor = false,
			BorderSizePixel = 0, LayoutOrder = idx, ClipsDescendants = true }, strip)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, pill)
		local pst = new("UIStroke", { Color = T.Accent, Thickness = 1, Transparency = 0.9, ApplyStrokeMode = BORDER }, pill)
		new("UIPadding", { PaddingLeft = UDim.new(0, icon and 28 or 13), PaddingRight = UDim.new(0, 13) }, pill)
		if icon and icon ~= "" then
			new("ImageLabel", { BackgroundTransparency = 1, Image = icon, ImageColor3 = T.Text,
				Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, -17, 0.5, -7) }, pill)
		end
		local pl = new("TextLabel", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1, Text = name, TextColor3 = T.ElementAccent, TextSize = 12, Font = F_MED }, pill)

		local page = new("Frame", { Name = "Sub_" .. name, Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 1, -36),
			BackgroundTransparency = 1, Visible = false }, parent.Page)
		local function newColumn()
			local sf = new("ScrollingFrame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
				ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent, ScrollBarImageTransparency = 0.5,
				CanvasSize = UDim2.new(), AutomaticCanvasSize = AY }, page)
			new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = BYORDER }, sf)
			new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), PaddingTop = UDim.new(0, 2) }, sf)
			return sf
		end
		local sub = setmetatable({ Name = tostring(parent.Name) .. " / " .. name, SubName = name, Page = page,
			Button = parent.Button, Blocks = {}, Cols = {}, NumCols = 0, _newColumn = newColumn, Parent = parent,
			Pill = pill, PillStroke = pst, PillLabel = pl }, Tab)
		sub:SetColumns(parent.NumCols)
		function sub:Select()
			local win = Library.Window
			if win and win.Current ~= parent then parent:Select() end
			select(sub)
		end
		pill.MouseEnter:Connect(function()
			if parent.CurrentSub ~= sub then uiSnd("tabhover") tween(pill, { BackgroundTransparency = 0.88 }, 0.15) end
		end)
		pill.MouseLeave:Connect(function()
			if parent.CurrentSub ~= sub then tween(pill, { BackgroundTransparency = 0.94 }, 0.2) end
		end)
		pill.MouseButton1Click:Connect(function()
			ripple(pill)
			if parent.CurrentSub ~= sub then uiSnd("tab") end
			select(sub)
		end)
		parent.SubTabs[#parent.SubTabs + 1] = sub
		parent.SubTabs[name] = sub
	end
	if parent.SubTabs[1] then select(parent.SubTabs[1]) end
	return parent.SubTabs
end

function Tab:GetSubTab(name) return self.SubTabs and self.SubTabs[name] end
function Tab:SelectSub(name)
	local s = self:GetSubTab(name)
	if s then s:Select() end
	return s
end


-- ============================================================================
-- ONGLETS DANS UN ONGLET : une flèche › sur l'onglet de la barre latérale déplie ses onglets enfants
--   (hauteur + fondu + glissement, fermeture identique à l'envers). Imbrication illimitée.
--
--   local combat = Window:CreateTab("Combat", nil, icon)
--   local aim    = combat:CreateChildTab("Aimbot", nil, icon)     -- alias : combat:CreateTab("Aimbot")
--   local kids   = combat:CreateChildTabs({ "ESP", { Name = "Divers", Icon = "rbxassetid://..." } })  -- kids[1], kids.ESP
--   combat:SetExpanded(true)  /  combat:ToggleExpanded()  /  combat.Expanded  /  combat:GetChildTab("Aimbot")
--   Un enfant est un onglet à part entière : CreateBlock, CreateSubTabs, Select, recherche, favoris, disposition...
-- ============================================================================
local function fadeChildren(tab, to, t)
	if canvasSupported then
		tween(tab._holder, { GroupTransparency = to }, t)
	else   -- pas de CanvasGroup : on fait fondre les textes des enfants
		for _, c in ipairs(tab.Children) do tween(c.Label, { TextTransparency = to }, t) end
	end
end

-- crée (une seule fois) la flèche et le conteneur des enfants ; renvoie le Frame « Inner » où se placent les boutons enfants
function Tab:_childHolder()
	if self._holder then return self._holder.Inner end
	local tab, btn = self, self.Button

	local holder = new(canvasSupported and "CanvasGroup" or "Frame", {
		Name = "Children", Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
		ClipsDescendants = true, Visible = false, LayoutOrder = btn.LayoutOrder + 1,
	}, btn.Parent)
	if canvasSupported then holder.GroupTransparency = 1 end
	local inner = new("Frame", { Name = "Inner", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY,
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, -10, 0, 0) }, holder)
	local list = new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = BYORDER }, inner)
	self._holder, self._list = holder, list

	-- si du contenu est ajouté / retiré pendant que c'est ouvert (ou pendant l'animation d'un sous-menu), la hauteur suit
	list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		if tab.Expanded and not tab._animating then
			holder.Size = UDim2.new(1, 0, 0, list.AbsoluteContentSize.Y)
		end
	end)

	-- flèche à droite de l'onglet (sous la pastille de recherche)
	local arrow = new("TextButton", { Name = "Arrow", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -21, 0.5, 0),
		Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Text = "›", TextColor3 = T.ElementAccent,
		TextSize = 20, Font = F_BOLD, AutoButtonColor = false, ZIndex = 2 }, btn)
	self._arrow = arrow
	-- le texte raccourcit pour laisser la place à la flèche
	self.Label.Size = UDim2.new(self.Label.Size.X.Scale, self.Label.Size.X.Offset - 20, self.Label.Size.Y.Scale, self.Label.Size.Y.Offset)
	arrow.MouseEnter:Connect(function() tween(arrow, { TextColor3 = T.Text }, 0.15) end)
	arrow.MouseLeave:Connect(function()
		tween(arrow, { TextColor3 = tab.Expanded and T.Text or T.ElementAccent }, 0.25)
	end)
	arrow.MouseButton1Click:Connect(function()
		uiSnd(tab.Expanded and "off" or "on")
		tab:SetExpanded(not tab.Expanded)
	end)
	return inner
end

function Tab:SetExpanded(on, instant)
	local holder = self._holder
	if not holder then return end
	on = on and true or false
	if self.Expanded == on then return end
	self.Expanded = on
	self._expTok = (self._expTok or 0) + 1
	local my = self._expTok
	local list, inner, arrow = self._list, holder.Inner, self._arrow
	local function d(t) return instant and 0 or t end
	self._animating = true

	if on then
		local H = list.AbsoluteContentSize.Y
		if H <= 0 then H = #self.Children * 33 end   -- le layout n'a pas encore calculé : estimation, corrigée à la fin
		holder.Visible = true
		local tw = tween(holder, { Size = UDim2.new(1, 0, 0, H) }, d(0.45))
		fadeChildren(self, 0, d(0.45))
		tween(inner, { Position = UDim2.new(0, 0, 0, 0) }, d(0.5))
		tween(arrow, { Rotation = 90, TextColor3 = T.Text }, d(0.4), BACK)
		tw.Completed:Connect(function()
			if self._expTok ~= my then return end
			self._animating = false
			local ch = list.AbsoluteContentSize.Y
			holder.Size = UDim2.new(1, 0, 0, ch > 0 and ch or H)
		end)
	else
		local tw = tween(holder, { Size = UDim2.new(1, 0, 0, 0) }, d(0.38))
		fadeChildren(self, 1, d(0.24))
		tween(inner, { Position = UDim2.new(0, -10, 0, 0) }, d(0.38))
		tween(arrow, { Rotation = 0, TextColor3 = T.ElementAccent }, d(0.32))
		tw.Completed:Connect(function()
			if self._expTok ~= my then return end
			self._animating = false
			holder.Visible = false
		end)
	end
end

function Tab:ToggleExpanded() self:SetExpanded(not self.Expanded) end

function Tab:CreateChildTab(name, _, icon)
	local win = self.Win
	if not win then
		warn("[Ui-Lib] CreateChildTab : à appeler sur un onglet (Window:CreateTab), pas sur un sous-onglet.")
		return nil
	end
	return win:CreateTab(name, nil, icon, self)
end
Tab.CreateTab = Tab.CreateChildTab   -- alias : combat:CreateTab("Aimbot")

function Tab:CreateChildTabs(list)
	local out = {}
	for idx, d in ipairs(list or {}) do
		local name = type(d) == "table" and tostring(d.Name or d[1] or ("Page " .. idx)) or tostring(d)
		local child = self:CreateChildTab(name, nil, type(d) == "table" and d.Icon or nil)
		if child then
			out[#out + 1] = child
			out[name] = child
		end
	end
	return out
end

function Tab:GetChildTab(name)
	for _, c in ipairs(self.Children or {}) do
		if c.Name == tostring(self.Name) .. " / " .. tostring(name) then return c end
	end
	return nil
end
function Tab:SelectChild(name)
	local c = self:GetChildTab(name)
	if c then c:Select() end
	return c
end

-- Interface de gestion des configs (utilisée par l'onglet Config et par l'onglet Paramètres)
local function buildConfigUI(blk)
	local function toast(ok, okMsg, errMsg)
		Library:Notify({ Title = "Config", Content = ok and okMsg or errMsg,
			Type = ok and "Success" or "Error", Duration = 3 })
	end
	blk:CreateSection("Fichier")
	local nameBox = blk:CreateInput({ Name = "Nom", Placeholder = "ma-config", Favorite = false })
	local dd = blk:CreateDropdown({ Name = "Existantes", Items = Library:ListConfigs(), Favorite = false,
		UpdateList = function() return Library:ListConfigs() end })
	local function currentName()
		local n = nameBox.Get()
		if n == nil or n == "" then n = dd.Get() end
		return n
	end
	blk:CreateButton({ Name = "Sauvegarder", Favorite = false, Callback = function()
		local n = currentName()
		local ok, err = Library:SaveConfig(n)
		toast(ok, "Sauvegardée : " .. tostring(n), "Échec : " .. tostring(err))
		dd.Refresh(Library:ListConfigs())
	end })
	blk:CreateButton({ Name = "Charger", Favorite = false, Callback = function()
		local n = currentName()
		local ok, err = Library:LoadConfig(n)
		toast(ok, "Chargée : " .. tostring(n), "Échec : " .. tostring(err))
	end })
	local target = blk:CreateInput({ Name = "Vers (nouveau nom)", Placeholder = "autre-nom", Favorite = false })
	blk:CreateButton({ Name = "Dupliquer vers ce nom", Favorite = false, Callback = function()
		local ok, err = Library:DuplicateConfig(currentName(), target.Get())
		toast(ok, "Dupliquée", "Échec : " .. tostring(err))
		dd.Refresh(Library:ListConfigs())
	end })
	blk:CreateButton({ Name = "Renommer vers ce nom", Favorite = false, Callback = function()
		local ok, err = Library:RenameConfig(currentName(), target.Get())
		toast(ok, "Renommée", "Échec : " .. tostring(err))
		dd.Refresh(Library:ListConfigs(), true)
	end })
	blk:CreateButton({ Name = "Supprimer", Confirm = true, Favorite = false, Callback = function()
		local n = currentName()
		local ok = Library:DeleteConfig(n)
		Library:Notify({ Title = "Config", Content = ok and ("Supprimée : " .. tostring(n)) or "Suppression impossible",
			Type = ok and "Warning" or "Error", Duration = 3 })
		dd.Refresh(Library:ListConfigs(), true)
	end })

	blk:CreateSection("Démarrage")
	local autoInfo = blk:CreateParagraph({ Title = "Config auto-chargée", Content = "" })
	local function refreshAuto()
		local a = Library:GetAutoLoad()
		autoInfo.Set({ Title = a and ("Auto-chargement : " .. a) or "Auto-chargement : aucun",
			Content = a and "Cette config s'applique toute seule à chaque lancement du script."
				or "Choisis une config puis clique sur « Charger automatiquement cette config »." })
	end
	refreshAuto()
	blk:CreateButton({ Name = "Charger automatiquement cette config", Favorite = false, Callback = function()
		local n = currentName()
		if n == nil or safeName(n) == "" then toast(false, "", "Choisis d'abord une config.") return end
		if not table.find(Library:ListConfigs(), safeName(n)) then
			toast(false, "", "Cette config n'existe pas encore : sauvegarde-la d'abord.")
			return
		end
		Library:SetAutoLoad(n)
		refreshAuto()
		toast(true, "Auto-chargement : " .. tostring(n), "")
	end })
	blk:CreateButton({ Name = "Désactiver l'auto-chargement", Favorite = false, Callback = function()
		Library:SetAutoLoad("")
		refreshAuto()
		toast(true, "Auto-chargement désactivé", "")
	end })

	blk:CreateSection("Valeurs")
	blk:CreateButton({ Name = "Réinitialiser les options du script", Confirm = true, Favorite = false,
		Tooltip = "Remet chaque option du script à sa valeur de départ (l'apparence n'est pas touchée).",
		Callback = function()
			local n = Library:ResetConfig(false)
			toast(true, n .. " options réinitialisées", "")
		end })

	blk:CreateSection("Partage")
