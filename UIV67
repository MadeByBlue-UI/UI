-- Onglet « Favoris » : regroupe les éléments marqués d'une étoile (copies synchronisées avec les originaux)
function Window:CreateFavoritesTab(name, icon)
	local win = self
	local tab = self:CreateTab(name or "Favoris", nil, icon)
	win.FavTab = tab

	local function proxy(blk, ent)
		local o = {}
		for k, v in pairs(ent.Opts) do o[k] = v end
		o.Flag = nil
		o.Favorite = false
		o.Keybind = nil   -- la touche reste sur l'élément d'origine (sinon le toggle serait basculé deux fois)
		local item = ent.Item
		if ent.Kind ~= "Button" then
			local ok, cur = pcall(function() return item.Get() end)
			if ok and cur ~= nil then o.Default = cur end
			o.Callback = function(...)
				local a, b = ...
				pcall(item.Set, item, (b ~= nil and typeof(a) ~= "Color3") and { a, b } or a, typeof(a) == "Color3" and b or nil)   -- plage : (min, max)
			end
		end
		pcall(function() blk["Create" .. ent.Kind](blk, o) end)
	end

	local function rebuild()
		tab._favRows = {}
		local animIn = tab._animIn
		tab._animIn = nil
		tab:ClearBlocks()
		local rb = tab:CreateBlock({ Name = "Récemment utilisés", Side = "Right" })
		rb._noFav = true
		Library:_buildRecent(rb)
		local keys = {}
		for k in pairs(Library.Favorites) do
			if Library.FavEntries[k] then keys[#keys + 1] = k end
		end
		table.sort(keys)
		local blk = tab:CreateBlock({ Name = "Favoris", Side = "Left" })
		blk._noFav = true
		if #keys == 0 then
			blk:CreateParagraph({ Title = "Aucun favori",
				Content = "Clique sur l'étoile ★ en haut à gauche d'un élément pour l'ajouter ici." })
			return
		end
		local last
		for _, k in ipairs(keys) do
			local ent = Library.FavEntries[k]
			local group = tostring(ent.Tab) .. " · " .. tostring(ent.Block)
			if group ~= last then blk:CreateSection(group) last = group end
			local before = {}
			for _, c in ipairs(blk.Body:GetChildren()) do before[c] = true end
			proxy(blk, ent)
			local rows = {}
			for _, c in ipairs(blk.Body:GetChildren()) do
				if c:IsA("GuiObject") and not before[c] then rows[#rows + 1] = c end
			end
			tab._favRows[k] = rows
			if animIn and animIn[k] and Library.Animations then
				for _, fr in ipairs(rows) do
					if fr.AutomaticSize == Enum.AutomaticSize.None then
						local full, oldClip = fr.Size, fr.ClipsDescendants
						fr.ClipsDescendants = true
						fr.Size = UDim2.new(full.X.Scale, full.X.Offset, 0, 0)
						tween(fr, { Size = full }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
						task.delay(0.34 / math.max(Library.AnimSpeed or 1, 0.05), function()
							if fr.Parent then fr.ClipsDescendants = oldClip end
						end)
					end
				end
			end
		end
	end
	tab.OnSelect = rebuild
	rebuild()
	return tab
end

