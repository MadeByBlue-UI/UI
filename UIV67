-- passe par les contrôles de l'onglet Paramètres s'ils existent (ils se mettent à jour), sinon applique directement
local function setSetting(flag, uiValue, direct, raw)
	local it = Library.Items[flag]
	if it and it.Set then
		local ok = pcall(it.Set, it, uiValue)
		if ok then return end
	end
	pcall(direct, raw)
end

function Library:ApplyTheme(t)
	if type(t) ~= "table" then return false end
	local N = Library.Names
	local function pct(v) return math.floor(v * 100 + 0.5) end
	local w = Library.Window
	local colorFlags = { Main = "ui.c.main", Second = "ui.c.second", Accent = "ui.accent",
		Text = "ui.c.text", ElementAccent = "ui.c.text2" }
	if type(t.Colors) == "table" then
		local cs = {}
		for k, flag in pairs(colorFlags) do
			local c = toColor3(t.Colors[k])
			if c then
				cs[k] = c
				setSetting(flag, c, function(x) Library:SetColor(k, x) end, c)
			end
		end
		Library:SetColors(cs)
	end
	local function opt(name) return function(v) Library:SetOption(name, v) end end
	local S = {
		{ "Style", "ui.style", nil, function(v) Library:SetStyle(v) end },
		{ "Opacity", "ui.opacity", pct, function(v) if w then w:SetOpacity(v) end end },
		{ "Radius", "ui.radius", nil, function(v) Library:SetCornerRadius(v) end },
		{ "WinRound", "ui.winround", pct, opt("WinRound") },
		{ "Scale", "ui.scale", nil, function(v) if w then w:SetScale(v) end end },
		{ "FontScale", "ui.fontscale", pct, function(v) Library:SetFontScale(v) end },
		{ "Font", "ui.fontfamily", nil, function(v) Library:SetFont(v) end },
		{ "Shape", "ui.shape", function(v) return v == "Vague" and "Arrondie" or v end, function(v) Library:SetShape(v) end },
		{ "Breathing", "ui.breath", nil, opt("Breathing") },
		{ "TitleFont", "ui.titlefont", nil, opt("TitleFont") },
		{ "TitleShine", "ui.titleshine", nil, opt("TitleShine") },
		{ "TitleStretch", "ui.titlestretch", nil, opt("TitleStretch") },
		{ "TitleBold", "ui.titlebold", nil, opt("TitleBold") },
		{ "Ripple", "ui.ripple", nil, opt("Ripple") },
		{ "SpinSpeed", "ui.spin", pct, opt("SpinSpeed") },
		{ "HoleVisible", "ui.hole", nil, opt("HoleVisible") },
		{ "HolePos", "ui.holepos", function(v) return N.HolePos[v] or v end, opt("HolePos") },
		{ "HoleScale", "ui.holescale", pct, opt("HoleScale") },
		{ "Stars", "ui.stars", nil, function(v) Library:SetStars(v) end },
		{ "BlurSize", "ui.blur", nil, function(v) Library:SetBlur(v) end },
		{ "StarSpeed", "ui.starspeed", pct, opt("StarSpeed") },
		{ "StarsThroughWindow", "ui.starsthrough", nil, opt("StarsThroughWindow") },
		{ "HoleStars", "ui.holestars", nil, opt("HoleStars") },
		{ "Background", "ui.bg", function(v) return N.Background[v] or v end, function(v) Library:SetBackground(v) end },
		{ "Animations", "ui.anim", nil, function(v) Library:SetAnimations(v) end },
		{ "AnimSpeed", "ui.animspeed", function(v) return tostring(v) .. "x" end, function(v) Library:SetAnimSpeed(v) end },
		{ "WindowAnim", "ui.winanim", nil, function(v) Library:SetWindowAnim(v) end },
		{ "LockPosition", "ui.lockpos", nil, function(v) Library:SetLockPosition(v) end },
		{ "MiniBarVisible", "ui.minibar", nil, function(v) Library:SetMiniBarVisible(v) end },
		{ "ToggleStyle", "ui.togglestyle", nil, function(v) Library:SetToggleStyle(v) end },
		{ "NotifPos", "ui.notifpos", function(v) return N.NotifPos[v] or v end, function(v) Library:SetNotifPosition(v) end },
		{ "NotifDuration", "ui.notifdur", nil, function(v) Library:SetNotifDuration(v) end },
		{ "NotifExit", "ui.notifexit", nil, function(v) Library:SetNotifExit(v) end },
		{ "NotifEntryCustom", "ui.notifentryon", nil, function(v) Library:SetNotifEntryEnabled(v) end },
		{ "NotifEntry", "ui.notifentry", nil, function(v) Library:SetNotifEntry(v) end },
		{ "TabTransition", "ui.tabtrans", nil, function(v) Library:SetTabTransition(v) end },
	}
	for _, e in ipairs(S) do
		local v = t[e[1]]
		if v ~= nil then
			local uv = v
			if e[3] then
				local ok, r = pcall(e[3], v)
				if ok then uv = r end
			end
			setSetting(e[2], uv, e[4], v)
		end
	end
	return true
end

function Library:ApplyPreset(name)
	local p = Library.Presets[name]
	if not p then return false end
	return Library:ApplyTheme({ Colors = p })
end

function Library:CopyText(s)
	local f = (type(setclipboard) == "function" and setclipboard) or (type(toclipboard) == "function" and toclipboard)
	if f then return (pcall(f, s)) end
	return false
end

local function themeDir() return Library.ConfigFolder .. "/Themes" end

function Library:ListThemes()
	local out = {}
	pcall(function()
		if listfiles and isfolder and isfolder(themeDir()) then
			for _, p in ipairs(listfiles(themeDir())) do
				local n = tostring(p):match("([^/\\]+)%.json$")
				if n then out[#out + 1] = n end
			end
		end
	end)
	table.sort(out)
	return out
end

function Library:SaveTheme(name)
	name = safeName(name)
	if name == "" then return false, "nom vide" end
	if not writefile then return false, "writefile indisponible" end
	pcall(function()
		if makefolder and isfolder then
			if not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
			if not isfolder(themeDir()) then makefolder(themeDir()) end
		end
	end)
	local ok, err = pcall(function()
		writefile(themeDir() .. "/" .. name .. ".json", HttpService:JSONEncode(Library:GetTheme()))
	end)
	return ok, err
end

function Library:LoadTheme(name)
	name = safeName(name)
	if name == "" then return false, "nom vide" end
	if not (readfile and isfile) then return false, "readfile indisponible" end
	local path = themeDir() .. "/" .. name .. ".json"
	if not isfile(path) then return false, "introuvable" end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "fichier invalide" end
	return Library:ApplyTheme(data)
end

function Library:DeleteTheme(name)
	name = safeName(name)
	if name == "" or not delfile then return false end
	return (pcall(function() delfile(themeDir() .. "/" .. name .. ".json") end))
end

function Library:ExportTheme()
	return "UILIB-THEME:" .. HttpService:JSONEncode(Library:GetTheme())
end

function Library:ImportTheme(str)
	str = tostring(str or "")
	str = string.gsub(str, "^%s+", "")
	str = string.gsub(str, "^UILIB%-THEME:", "")
	str = string.gsub(str, "%s+$", "")
	local ok, data = pcall(function() return HttpService:JSONDecode(str) end)
	if not ok or type(data) ~= "table" then return false, "code invalide" end
	if type(data.Colors) ~= "table" then return false, "ce n'est pas un thème" end
	return Library:ApplyTheme(data)
end

-- ---------------------------------------------------------------------------
-- Configs : export / import / reset / dupliquer / renommer
-- ---------------------------------------------------------------------------
function Library:_applyFlags(data)
	Library._silentSound = (Library._silentSound or 0) + 1
	-- les réglages d'interface d'abord, pour que le reste s'affiche déjà avec le bon thème
	local later = {}
	do
		local sty = data["ui.style"]
		local sit = Library.Items["ui.style"]
		if sty ~= nil and sit and sit.Set then pcall(sit.Set, sit, sty) end
	end
	for flag, value in pairs(data) do
		if flag == "ui.shape" and value == "Vague" then value = "Arrondie" end
		if flag == "ui.style" then
			-- déjà appliqué plus haut
		elseif string.sub(flag, 1, 3) == "ui." then
			local it = Library.Items[flag]
			if it and it.Set then pcall(it.Set, it, value) end
		else
			later[flag] = value
		end
	end
	for flag, value in pairs(later) do
		local it = Library.Items[flag]
		if it and it.Set then pcall(it.Set, it, value) end
	end
	Library._silentSound = math.max((Library._silentSound or 1) - 1, 0)
end

function Library:ExportConfig()
	return "UILIB-CONFIG:" .. HttpService:JSONEncode(Library.Flags)
end

function Library:ImportConfig(str)
	str = tostring(str or "")
	str = string.gsub(str, "^%s+", "")
	str = string.gsub(str, "^UILIB%-CONFIG:", "")
	str = string.gsub(str, "%s+$", "")
	local ok, data = pcall(function() return HttpService:JSONDecode(str) end)
	if not ok or type(data) ~= "table" then return false, "code invalide" end
	Library:_applyFlags(data)
	return true
end

function Library:ResetConfig(includeUi)
	local n = 0
	for flag, def in pairs(Library.Defaults) do
		local internal = string.sub(flag, 1, 2) == "__"
		local isUi = string.sub(flag, 1, 3) == "ui."
		if not internal and (includeUi or not isUi) then
			local it = Library.Items[flag]
			if it and it.Set then
				pcall(it.Set, it, copyVal(def))
				n += 1
			end
		end
	end
	return n
end

function Library:DuplicateConfig(a, b)
	a, b = safeName(a), safeName(b)
	if a == "" or b == "" then return false, "nom vide" end
	if not (readfile and writefile and isfile) then return false, "fichiers indisponibles" end
	local pa = Library.ConfigFolder .. "/" .. a .. ".json"
	local pb = Library.ConfigFolder .. "/" .. b .. ".json"
	if not isfile(pa) then return false, "introuvable" end
	local ok, err = pcall(function() writefile(pb, readfile(pa)) end)
	return ok, err
end

function Library:RenameConfig(a, b)
	local ok, err = Library:DuplicateConfig(a, b)
	if ok and safeName(a) ~= safeName(b) then Library:DeleteConfig(a) end
	return ok, err
end

function Library:SetBackground(m)
	if Library.Window then Library.Window:SetBackground(m) end
end

function Library:SetCornerRadius(v)
	Library.GlobalCornerValue = v
	for _, c in ipairs(Library.CornerObjects) do
		if c.Corner and c.Corner.Parent then
			c.Corner.CornerRadius = UDim.new(0, math.floor(c.BaseRadius * v / 10))
		end
	end
end

