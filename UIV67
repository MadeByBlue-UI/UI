		Oswald = "Oswald", Bangers = "Bangers", Jura = "Jura", ["Sci-Fi"] = "SciFi", Arcade = "Arcade" }
	local shineTw
	function win:ApplyTitle()
		local en = TITLE_FONTS[Library.TitleFont]
		local f
		if en then
			local ok, r = pcall(function() return Enum.Font[en] end)
			if ok then f = r end
		end
		title.Font = f or (Library.Fonts and Library.Fonts[3]) or F_BOLD
		title.Text = (Library.TitleStretch ~= false) and Library._stretch(titleRaw) or titleRaw
		titleStroke.Enabled = Library.TitleBold ~= false
		if shineTw then
			shineTw:Cancel()
			shineTw = nil
		end
		if Library.TitleShine ~= false and Library.Animations and main.Visible then
			titleGrad.Offset = Vector2.new(-1, 0)
			shineTw = TweenService:Create(titleGrad,
				TweenInfo.new(1.8, QUINT, Enum.EasingDirection.InOut, -1, false, 1.6), { Offset = Vector2.new(1, 0) })
