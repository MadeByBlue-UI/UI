function Block:CreateColorPicker(o)
	o = o or {}
	local col = o.Default or Color3.new(1, 1, 1)
	local h, s, v = col:ToHSV()

	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1 }, self.Body)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = BYORDER }, holder)
	self:_reg(holder, o.Name)

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 0.4,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = 1,
	}, holder)
	corner(head, 8)
	local hst = stroke(head, 0.93)
	hover(head, hst)
	label(head, o.Name or "Color", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -66, 1, 0) })
	local swatch = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 34, 0, 18),
		BackgroundColor3 = col, BorderSizePixel = 0,
	}, head)
	corner(swatch, 5)
	stroke(swatch, 0.55)

	local dr = drawer(holder, 2)
	dr:Resize(146)
	local panel = new("Frame", {
		Size = UDim2.new(1, 0, 0, 146), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, BorderSizePixel = 0,
	}, dr.Wrap)
	corner(panel, 8)
	stroke(panel, 0.9)

	-- Carré saturation / valeur
	local sv = new("Frame", { Position = UDim2.new(0, 8, 0, 8), Size = UDim2.new(1, -40, 0, 100),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0 }, panel)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, sv)
	local white = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, sv)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, white)
	new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
	local black = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, sv)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, black)
	new("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90 }, black)
	local cursor = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 12, 0, 12),
		BackgroundTransparency = 1, BorderSizePixel = 0 }, sv)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, cursor)
	new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }, cursor)
	local svHit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, sv)

	-- Barre de teinte
	local hue = new("Frame", { Position = UDim2.new(1, -26, 0, 8), Size = UDim2.new(0, 18, 0, 100),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, panel)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, hue)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
		ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
		ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
		ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
		ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
		ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
	}) }, hue)
	local hueMark = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 4, 0, 4),
		Position = UDim2.new(0.5, 0, 0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, hue)
	new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, hueMark)
	local hueHit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, hue)

	-- Champ hexadécimal
	local hex = new("TextBox", {
		Position = UDim2.new(0, 8, 0, 114), Size = UDim2.new(1, -16, 0, 24), BackgroundColor3 = T.Off,
		BackgroundTransparency = 0.4, Text = "", PlaceholderText = "#FFFFFF", TextColor3 = T.Text, TextSize = 12,
		Font = F_MED, ClearTextOnFocus = false, BorderSizePixel = 0,
	}, panel)
	corner(hex, 6)

	local item = {}
	local function refreshHex()
		if not hex:IsFocused() then hex.Text = "#" .. string.upper(col:ToHex()) end
	end
	local function visuals()
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		cursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueMark.Position = UDim2.new(0.5, 0, h, 0)
		swatch.BackgroundColor3 = col
		refreshHex()
	end
	local function commit(silent)
		col = Color3.fromHSV(h, s, v)
		if o.Flag then Library.Flags[o.Flag] = { R = col.R, G = col.G, B = col.B } end
		visuals()
		if not silent then fire(o.Callback, col) end
	end

	svHit.InputBegan:Connect(function(i)
		if isPress(i) then
			startDrag(function(p)
				local y = p.Y + guiInset().Y
				s = math.clamp((p.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
				v = 1 - math.clamp((y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
				commit()
			end, self.Scroll, i.Position)
		end
	end)
	hueHit.InputBegan:Connect(function(i)
		if isPress(i) then
			startDrag(function(p)
				local y = p.Y + guiInset().Y
				h = math.min(math.clamp((y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 1), 0.999)
				commit()
			end, self.Scroll, i.Position)
		end
	end)
	head.MouseButton1Click:Connect(function() dr:Set(not dr.Open) end)

	item.Set = function(...)
		local c = unself(item, ...)
		if type(c) == "table" then
			c = Color3.new(c.R or c.r or 1, c.G or c.g or 1, c.B or c.b or 1)
		end
		if typeof(c) ~= "Color3" then return end
		local nh, ns, nv = c:ToHSV()
		if ns > 0.001 and nv > 0.001 then h = nh end
		s, v = ns, nv
		commit()
		-- on garde exactement la couleur demandée
		col = c
		swatch.BackgroundColor3 = c
		refreshHex()
	end
	item.Get = function() return col end

	hex.FocusLost:Connect(function()
		local txt = string.gsub(hex.Text, "#", "")
		local ok, c = pcall(Color3.fromHex, txt)
		if ok and typeof(c) == "Color3" then item.Set(c) end
		hex.Text = "#" .. string.upper(col:ToHex())
	end)

	commit(true)
	register(o.Flag, item, { R = col.R, G = col.G, B = col.B })
	if Library.FireDefaults then fire(o.Callback, col) end
	return item
end

