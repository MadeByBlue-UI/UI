--  Input helpers: positions, hit testing, dragging, resizing
-- ════════════════════════════════════════════════════════════════════════

function Library:GetInputPosition(input)
    if input and input.UserInputType == Enum.UserInputType.Touch then
        return Vector2.new(input.Position.X, input.Position.Y)
    end
    return UserInputService:GetMouseLocation()
end

--- ScreenGui is created with IgnoreGuiInset = true, so AbsolutePosition values
--- live in the same coordinate space as UserInputService:GetMouseLocation().
function Library:IsPointInside(gui, point)
    if not gui or not gui.Parent then
        return false
    end
    local pos = gui.AbsolutePosition
    local size = gui.AbsoluteSize
    return point.X >= pos.X and point.X <= pos.X + size.X
        and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end

function Library:IsMouseOver(gui)
    return self:IsPointInside(gui, UserInputService:GetMouseLocation())
end

--- Make `handle` drag `target` around. Works with mouse and touch.
function Library:MakeDraggable(handle, target, options)
    options = options or {}
    local dragging = false
    local activeInput = nil
    local startPoint = Vector2.zero
    local startPosition = target.Position

    handle.InputBegan:Connect(function(input)
        if not self:IsClick(input) then
            return
        end
        if options.CanDrag and not options.CanDrag() then
            return
        end
        dragging = true
        activeInput = input
        startPoint = Vector2.new(input.Position.X, input.Position.Y)
        startPosition = target.Position
        if options.OnStart then
            options.OnStart()
        end

        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                activeInput = nil
                connection:Disconnect()
                if options.OnEnd then
                    options.OnEnd()
                end
            end
        end)
    end)

    self.Maid:Give(UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        local valid = (input == activeInput) or (input.UserInputType == Enum.UserInputType.MouseMovement
            and activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1)
        if not valid then
            return
        end

        local scale = self.DPIScale
        local delta = (Vector2.new(input.Position.X, input.Position.Y) - startPoint) / scale
        local newX = startPosition.X.Offset + delta.X
        local newY = startPosition.Y.Offset + delta.Y

        if options.Clamp ~= false then
            local viewport = self:GetViewportSize() / scale
            local size = target.AbsoluteSize / scale
            local anchor = target.AnchorPoint
            local minX = size.X * anchor.X - size.X + 40
            local maxX = viewport.X - size.X * anchor.X - 40
            local minY = size.Y * anchor.Y
            local maxY = viewport.Y - size.Y * anchor.Y - 30
            newX = math.clamp(newX, minX, maxX)
            newY = math.clamp(newY, minY, maxY)
        end

        target.Position = UDim2.new(startPosition.X.Scale, newX, startPosition.Y.Scale, newY)
        if options.OnMove then
            options.OnMove(target.Position)
        end
    end))
end

--- Make `grip` resize `target` (UDim2 offset sizes). Works with mouse and touch.
function Library:MakeResizable(grip, target, minSize, maxSize, onResize)
    local resizing = false
    local activeInput = nil
    local startPoint = Vector2.zero
    local startSize = Vector2.zero
    minSize = minSize or Vector2.new(480, 360)
    maxSize = maxSize or Vector2.new(1400, 1000)

    grip.InputBegan:Connect(function(input)
        if not self:IsClick(input) then
            return
        end
        resizing = true
        activeInput = input
        startPoint = Vector2.new(input.Position.X, input.Position.Y)
        startSize = Vector2.new(target.Size.X.Offset, target.Size.Y.Offset)

        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                resizing = false
                activeInput = nil
                connection:Disconnect()
            end
        end)
    end)

    self.Maid:Give(UserInputService.InputChanged:Connect(function(input)
        if not resizing then
            return
        end
        local valid = (input == activeInput) or (input.UserInputType == Enum.UserInputType.MouseMovement
            and activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1)
        if not valid then
            return
        end
        local delta = (Vector2.new(input.Position.X, input.Position.Y) - startPoint) / self.DPIScale
        local newW = math.clamp(startSize.X + delta.X, minSize.X, maxSize.X)
        local newH = math.clamp(startSize.Y + delta.Y, minSize.Y, maxSize.Y)
        target.Size = UDim2.fromOffset(newW, newH)
        if onResize then
            onResize(Vector2.new(newW, newH))
        end
    end))
end

