function Block:CreateButton(o)
	o = o or {}
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.Element, BackgroundTransparency = 0.4,
		Text = o.Name or "Button", TextColor3 = T.Text, TextSize = 13, Font = F_MED, ClipsDescendants = true,
		AutoButtonColor = false, BorderSizePixel = 0, TextTruncate = Enum.TextTruncate.AtEnd,
	}, self.Body)
	corner(b, 8)
	local st = stroke(b, 0.93)
	trackStyled(b, st, "row")
	hover(b, st)
	self:_reg(b, o.Name)
	local armed, armToken = false, 0
	local baseText = o.Name or "Button"
	b.MouseButton1Click:Connect(function()
		if o.Confirm then
			if not armed then
				armed = true
				armToken += 1
				local my = armToken
				b.Text = o.ConfirmText or "Êtes-vous sûr ?"
				tween(b, { BackgroundColor3 = Color3.fromRGB(150, 45, 45), BackgroundTransparency = 0.1 }, 0.2)
				task.delay(3, function()
					if armed and armToken == my then
						armed = false
						b.Text = baseText
						tween(b, { BackgroundColor3 = T.Element, BackgroundTransparency = Sty.RowTr }, 0.3)
					end
				end)
				return
			end
			armed = false
			b.Text = baseText
		end
		ripple(b)
		-- flash blanc qui s'estompe
		b.BackgroundColor3 = T.Accent
		b.BackgroundTransparency = 0
		b.TextColor3 = T.Main
		tween(b, { BackgroundColor3 = T.Element, BackgroundTransparency = Sty.RowTr, TextColor3 = T.Text }, 0.5)
		fire(o.Callback)
	end)
	local item = {}
	item.SetText = function(...) b.Text = tostring((unself(item, ...))) end
	item.Instance = b
	return item
end

function Block:CreateToggle(o)
	o = o or {}
	local f, st = makeRow(self, 34, o.Name)
	label(f, o.Name or "Toggle", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -70, 1, 0) })
	local sw = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 38, 0, 20), BackgroundColor3 = T.Off, BorderSizePixel = 0,
	}, f)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, sw)
	stroke(sw, 0.8)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.new(0, 14, 0, 14), BackgroundColor3 = T.Text, BorderSizePixel = 0,
	}, sw)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	local btn = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, f)
	hover(f, st, btn)

	local state = o.Default and true or false
	local function paint(v, instant)
		local t = instant and 0 or 0.35
		if not instant and Library.Animations then
			knob.Size = UDim2.new(0, 19, 0, 14)
			tween(knob, { Size = UDim2.new(0, 14, 0, 14) }, 0.45, BACK)
		end
		tween(sw, { BackgroundColor3 = v and T.Accent or T.Off }, instant and 0 or 0.25)
		tween(knob, {
			Position = v and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = v and T.Main or T.Text,
		}, t, BACK)
	end
	local function apply(v, silent)
		state = v
		if o.Flag then Library.Flags[o.Flag] = v end
		paint(v)
		if not silent then fire(o.Callback, v) end
	end
	local item = {}
	item.Set = function(...) apply((unself(item, ...)) and true or false) end
	item.Get = function() return state end
	f.ClipsDescendants = true
	btn.MouseButton1Click:Connect(function() ripple(f) apply(not state) end)

	paint(state, true)
	register(o.Flag, item, state)
	if Library.FireDefaults then fire(o.Callback, state) end
	return item
end

function Block:CreateSlider(o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local step = o.Step or o.Increment
	local def = math.clamp(o.Default or min, min, max)
	local dec = o.Rounding
	if dec == nil then
		local frac = (min % 1 ~= 0) or (max % 1 ~= 0) or (def % 1 ~= 0) or (step and step % 1 ~= 0)
		dec = frac and 2 or 0
	end
	local mult = 10 ^ dec
	local suffix = o.Suffix and tostring(o.Suffix) or ""

	local function snap(v)
		v = math.clamp(v, min, max)
		if step and step > 0 then v = min + math.floor((v - min) / step + 0.5) * step end
		v = math.floor(v * mult + 0.5) / mult
		return math.clamp(v, min, max)
	end
	local function fmt(v) return tostring(v) .. suffix end

	local f, st = makeRow(self, 50, o.Name)
	label(f, o.Name or "Slider", 13, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -110, 0, 18) })
	local valBox = new("TextBox", {
		Position = UDim2.new(1, -92, 0, 6), Size = UDim2.new(0, 80, 0, 18), BackgroundColor3 = T.Off,
		BackgroundTransparency = 1, Text = "", TextColor3 = T.ElementAccent, TextSize = 12, Font = F_MED,
		TextXAlignment = RIGHT, ClearTextOnFocus = false, BorderSizePixel = 0,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, f)
	corner(valBox, 5)
	new("UIPadding", { PaddingRight = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5) }, valBox)

	local bar = new("Frame", {
		Position = UDim2.new(0, 12, 0, 34), Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = T.Off, BorderSizePixel = 0,
	}, f)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, bar)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 12, 0, 12),
		BackgroundColor3 = T.Accent, BorderSizePixel = 0,
	}, bar)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	stroke(knob, 0.6, 2)
	local hit = new("TextButton", { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1, Text = "" }, f)
	hover(f, st)

	local value
	local function apply(v, silent, instant)
		v = snap(v)
		if v == value and not silent then return end
		value = v
		local span = max - min
		local ratio = span == 0 and 0 or (v - min) / span
		if instant then
			fill.Size = UDim2.new(ratio, 0, 1, 0)
			knob.Position = UDim2.new(ratio, 0, 0.5, 0)
		else
			tween(fill, { Size = UDim2.new(ratio, 0, 1, 0) }, 0.14)
			tween(knob, { Position = UDim2.new(ratio, 0, 0.5, 0) }, 0.14)
		end
		if not valBox:IsFocused() then valBox.Text = fmt(v) end
		if o.Flag then Library.Flags[o.Flag] = v end
		if not silent then fire(o.Callback, v) end
	end
	local item = {}
	item.Set = function(...)
		local v = tonumber((unself(item, ...)))
		if v then apply(v) end
	end
	item.Get = function() return value end

	hit.InputBegan:Connect(function(i)
		if isPress(i) then
			tween(knob, { Size = UDim2.new(0, 17, 0, 17) }, 0.2, BACK)
			startDrag(function(p)
				local t = math.clamp((p.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
				apply(min + t * (max - min), false, true)
			end, self.Scroll, i.Position, function()
				tween(knob, { Size = UDim2.new(0, 12, 0, 12) }, 0.25)
			end)
		end
	end)

	valBox.Focused:Connect(function()
		tween(valBox, { BackgroundTransparency = 0.5, TextColor3 = T.Text }, 0.2)
	end)
	valBox.FocusLost:Connect(function()
		tween(valBox, { BackgroundTransparency = 1, TextColor3 = T.ElementAccent }, 0.25)
		local n = tonumber(string.match(valBox.Text, "-?%d+%.?%d*"))
		if n then apply(n) end
		valBox.Text = fmt(value)
	end)

	apply(def, true, true)
	register(o.Flag, item, value)
	if Library.FireDefaults then fire(o.Callback, value) end
	return item
end

function Block:CreateDropdown(o)
	o = o or {}
	local multi = (o.Multi == true) or (o.MultiSelect == true) or (o.MultipleOptions == true)
	local items = {}
	for _, v in ipairs(o.Items or o.Options or {}) do items[#items + 1] = tostring(v) end

	local selected, selSet = nil, {}
	do
		local d = o.Default
		if (d == nil or d == "") and o.CurrentOption and o.CurrentOption ~= "" then d = o.CurrentOption end
		if multi then
			if type(d) == "table" then
				for _, v in ipairs(d) do selSet[tostring(v)] = true end
			elseif d ~= nil and d ~= "" then
				selSet[tostring(d)] = true
			end
		else
			if type(d) == "table" then d = d[1] end
			if d ~= nil and d ~= "" then selected = tostring(d) end
		end
	end

	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1 }, self.Body)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = BYORDER }, holder)
	self:_reg(holder, o.Name)

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 0.4,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = 1,
	}, holder)
	corner(head, 8)
	local hst = stroke(head, 0.93)
	trackStyled(head, hst, "row")
	hover(head, hst)
	label(head, o.Name or "Dropdown", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.5, -12, 1, 0) })
	local valL = label(head, "", 12, { Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -34, 1, 0),
		TextXAlignment = RIGHT, TextColor3 = T.ElementAccent })
	local arrow = label(head, ">", 13, { Position = UDim2.new(1, -26, 0, 0), Size = UDim2.new(0, 16, 1, 0),
		TextXAlignment = CENTER, Font = F_BOLD, TextColor3 = T.ElementAccent })

	local dr = drawer(holder, 2)
	local panel = new("Frame", {
		Size = UDim2.new(1, 0, 0, 100), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, BorderSizePixel = 0,
	}, dr.Wrap)
	corner(panel, 8)
	trackStyled(panel, stroke(panel, 0.9), "panel")
	local search = new("TextBox", {
		Position = UDim2.new(0, 6, 0, 6), Size = UDim2.new(1, -12, 0, 24), BackgroundColor3 = T.Off,
		BackgroundTransparency = 0.45, Text = "", PlaceholderText = "Rechercher...",
		PlaceholderColor3 = Color3.fromRGB(120, 120, 126), TextColor3 = T.Text, TextSize = 12, Font = F_REG,
		ClearTextOnFocus = false, TextXAlignment = LEFT, Visible = false, BorderSizePixel = 0,
	}, panel)
	corner(search, 6)
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, search)
	local list = new("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0, 100), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent, ScrollBarImageTransparency = 0.5,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = AY,
	}, panel)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = BYORDER }, list)
	new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, list)

	local btns = {}
	local restyle, layout, setOpen, setItems

	local function getMulti()
		local out = {}
		for _, v in ipairs(items) do
			if selSet[v] then out[#out + 1] = v end
		end
		return out
	end
	local function valueText()
		if multi then
			local m = getMulti()
			if #m == 0 then return "Choisir..." end
			if #m <= 2 then return table.concat(m, ", ") end
			return #m .. " sélectionnés"
		end
		return selected or "Choisir..."
	end
	local function show() valL.Text = valueText() end
	local function isOn(text)
		if multi then return selSet[text] == true end
		return selected == text
	end
	local function commit(silent)
		local val
		if multi then val = getMulti() else val = selected end
		if o.Flag then Library.Flags[o.Flag] = val end
		show()
		restyle()
		if not silent then fire(o.Callback, val) end
	end
	local function pick(text)
		if multi then
			if selSet[text] then selSet[text] = nil else selSet[text] = true end
			commit()
		else
			selected = text
			commit()
			setOpen(false)
		end
	end

	restyle = function()
		for text, b in pairs(btns) do
			local on = isOn(text)
			if b.On ~= on then
				b.On = on
				tween(b.Btn, { BackgroundTransparency = on and 0.86 or 1, TextColor3 = on and T.Accent or T.ElementAccent }, 0.18)
				tween(b.Ind, { BackgroundTransparency = on and 0 or 1 }, 0.18)
			end
		end
	end

	layout = function()
		local q = string.lower(search.Text)
		local count = 0
		for _, text in ipairs(items) do
			local b = btns[text]
			if b then
				local vis = q == "" or string.find(string.lower(text), q, 1, true) ~= nil
				b.Btn.Visible = vis
				if vis then count = count + 1 end
			end
		end
		local showSearch = (o.Search == true) or (o.Search ~= false and #items >= 7)
		search.Visible = showSearch
		local sh = showSearch and 36 or 0
		local lh = math.clamp(math.max(count, 1) * 26 + 8, 34, 150)
		list.Position = UDim2.new(0, 0, 0, sh)
		list.Size = UDim2.new(1, 0, 0, lh)
		panel.Size = UDim2.new(1, 0, 0, sh + lh)
		dr:Resize(sh + lh)
	end

	local function rebuild()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
		end
		table.clear(btns)
		if #items == 0 then
			label(list, "(vide)", 12, { Size = UDim2.new(1, 0, 0, 24), TextColor3 = T.ElementAccent, TextXAlignment = CENTER })
		end
		for idx, text in ipairs(items) do
			local b = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
				Text = text, TextColor3 = T.ElementAccent, TextSize = 12, Font = F_REG,
				TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = idx,
			}, list)
			new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 26) }, b)
			new("UICorner", { CornerRadius = UDim.new(0, 5) }, b)
			local ind
			if multi then
				ind = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 18, 0.5, 0),
					Size = UDim2.new(0, 12, 0, 12), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
					BorderSizePixel = 0 }, b)
				new("UICorner", { CornerRadius = UDim.new(0, 3) }, ind)
				stroke(ind, 0.45)
			else
				ind = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 20, 0.5, 0),
					Size = UDim2.new(0, 6, 0, 6), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
					BorderSizePixel = 0 }, b)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, ind)
			end
			btns[text] = { Btn = b, Ind = ind }
			b.MouseEnter:Connect(function()
				if not isOn(text) then tween(b, { BackgroundTransparency = 0.93 }, 0.15) end
			end)
			b.MouseLeave:Connect(function()
				if not isOn(text) then tween(b, { BackgroundTransparency = 1 }, 0.2) end
			end)
			b.MouseButton1Click:Connect(function() pick(text) end)
		end
		restyle()
		layout()
	end

	setItems = function(newItems, clear)
		items = {}
		for _, v in ipairs(newItems or {}) do items[#items + 1] = tostring(v) end
		if clear == true then
			selSet = {}
			selected = nil
		else
			if selected and not table.find(items, selected) then selected = nil end
			for k in pairs(selSet) do
				if not table.find(items, k) then selSet[k] = nil end
			end
		end
		if o.Flag then
			if multi then Library.Flags[o.Flag] = getMulti() else Library.Flags[o.Flag] = selected end
		end
		show()
		rebuild()
	end

	local isOpen = false
	setOpen = function(v)
		v = v and true or false
		if v == isOpen then return end
		if v then
			local prev = Library._openDD
			if prev and prev ~= setOpen then prev(false) end
			Library._openDD = setOpen
			if type(o.UpdateList) == "function" then
				local ok, res = pcall(o.UpdateList)
				if ok and type(res) == "table" then setItems(res, false) end
			end
			search.Text = ""
			layout()
		else
			if Library._openDD == setOpen then Library._openDD = nil end
		end
		isOpen = v
		dr:Set(v)
		tween(arrow, { Rotation = v and 90 or 0 }, 0.3)
	end

	search:GetPropertyChangedSignal("Text"):Connect(layout)
	head.MouseButton1Click:Connect(function() setOpen(not isOpen) end)

	local item = {}
	item.Set = function(...)
		local v = unself(item, ...)
		if multi then
			selSet = {}
			if type(v) == "table" then
				for _, x in ipairs(v) do selSet[tostring(x)] = true end
			elseif v ~= nil and v ~= "" then
				selSet[tostring(v)] = true
			end
		else
			if type(v) == "table" then v = v[1] end
			if v ~= nil then selected = tostring(v) else selected = nil end
		end
		commit()
	end
	item.Get = function()
		if multi then return getMulti() end
		return selected
	end
	item.Refresh = function(...)
		local newItems, clear = unself(item, ...)
		setItems(newItems, clear)
	end
	item.SetItems = function(...)
		local newItems = unself(item, ...)
		setItems(newItems, false)
	end
	item.Open = function() setOpen(true) end
	item.Close = function() setOpen(false) end

	show()
	rebuild()
	local initial
	if multi then initial = getMulti() else initial = selected end
	register(o.Flag, item, initial)
	if Library.FireDefaults and ((multi and #getMulti() > 0) or ((not multi) and selected)) then
		fire(o.Callback, initial)
	end
	return item
end

function Block:CreateInput(o)
	o = o or {}
	local f, st = makeRow(self, 34, o.Name)
	label(f, o.Name or "Input", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.4, -12, 1, 0) })
	local tb = new("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0.6, -14, 0, 24),
		BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0,
		Text = o.Default and tostring(o.Default) or "", PlaceholderText = o.Placeholder or o.PlaceholderText or "",
		PlaceholderColor3 = Color3.fromRGB(125, 125, 132), TextColor3 = T.Text, TextSize = 12,
		Font = F_REG, ClearTextOnFocus = o.ClearOnFocus == true, TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = LEFT,
	}, f)
	corner(tb, 6)
	local tst = stroke(tb, 0.9)
	trackStyled(tb, tst, "input")
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, tb)
	hover(f, st)

	tb.Focused:Connect(function() tween(tst, { Transparency = 0.35 }, 0.2) end)
	tb.FocusLost:Connect(function()
		tween(tst, { Transparency = Sty.InputStroke }, 0.3)
		fire(o.Callback, tb.Text)
	end)
	tb:GetPropertyChangedSignal("Text"):Connect(function()
		if o.Numeric then
			local clean = string.gsub(tb.Text, "[^%d%.%-]", "")
			if clean ~= tb.Text then tb.Text = clean return end
		end
		if o.Flag then Library.Flags[o.Flag] = tb.Text end
		if o.LiveUpdate then fire(o.Callback, tb.Text) end
	end)

	local item = {}
	item.Set = function(...)
		tb.Text = tostring((unself(item, ...)) or "")
		fire(o.Callback, tb.Text)
	end
	item.Get = function() return tb.Text end
	item.Instance = tb
	register(o.Flag, item, tb.Text)
	return item
end

function Block:CreateKeybind(o)
	o = o or {}
	local key = o.Default or Enum.KeyCode.Unknown
	local f, st = makeRow(self, 34, o.Name)
	label(f, o.Name or "Keybind", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -112, 1, 0) })
	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 88, 0, 24),
		BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0, Text = key.Name,
		TextColor3 = T.Text, TextSize = 12, Font = F_MED, AutoButtonColor = false,
	}, f)
	corner(btn, 6)
	local bst = stroke(btn, 0.9)
	trackStyled(btn, bst, "input")
	hover(f, st)

	local function apply(k, silent)
		key = k
		btn.Text = k.Name
		if o.Flag then Library.Flags[o.Flag] = k.Name end
		if not silent then fire(o.Callback, k) end
	end
	local listening = false
	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		Library._listening = true
		btn.Text = "..."
		tween(bst, { Transparency = 0.25 }, 0.2)
		local c
		c = UIS.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Keyboard then
				c:Disconnect()
				listening = false
				Library._listening = false
				tween(bst, { Transparency = Sty.InputStroke }, 0.3)
				if i.KeyCode == Enum.KeyCode.Escape then btn.Text = key.Name else apply(i.KeyCode) end
			end
		end)
	end)

	local item = {}
	item.Set = function(...)
		local k = unself(item, ...)
		if type(k) == "string" then
			local ok, res = pcall(function() return Enum.KeyCode[k] end)
			k = ok and res or nil
		end
		if typeof(k) == "EnumItem" then apply(k) end
	end
	item.Get = function() return key end
	register(o.Flag, item, key.Name)
	return item
end

function Block:CreateColorPicker(o)
	o = o or {}
	local col = o.Default or Color3.new(1, 1, 1)
	local h, s, v = col:ToHSV()

	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1 }, self.Body)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = BYORDER }, holder)
	self:_reg(holder, o.Name)

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 0.4,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = 1,
	}, holder)
	corner(head, 8)
	local hst = stroke(head, 0.93)
	trackStyled(head, hst, "row")
	hover(head, hst)
	label(head, o.Name or "Color", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -66, 1, 0) })
	local swatch = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 34, 0, 18),
		BackgroundColor3 = col, BorderSizePixel = 0,
	}, head)
	corner(swatch, 5)
	stroke(swatch, 0.55)
	swatch:SetAttribute("NoAccent", true)

	local dr = drawer(holder, 2)
	dr:Resize(146)
	local panel = new("Frame", {
		Size = UDim2.new(1, 0, 0, 146), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, BorderSizePixel = 0,
	}, dr.Wrap)
	corner(panel, 8)
	trackStyled(panel, stroke(panel, 0.9), "panel")
	panel:SetAttribute("NoAccent", true)

	-- Carré saturation / valeur
	local sv = new("Frame", { Position = UDim2.new(0, 8, 0, 8), Size = UDim2.new(1, -40, 0, 100),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0 }, panel)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, sv)
	local white = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, sv)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, white)
	new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
	local black = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, sv)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, black)
	new("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90 }, black)
	local cursor = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 12, 0, 12),
		BackgroundTransparency = 1, BorderSizePixel = 0 }, sv)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, cursor)
	new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }, cursor)
	local svHit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, sv)

	-- Barre de teinte
	local hue = new("Frame", { Position = UDim2.new(1, -26, 0, 8), Size = UDim2.new(0, 18, 0, 100),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, panel)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, hue)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
		ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
		ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
		ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
		ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
		ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
	}) }, hue)
	local hueMark = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 4, 0, 4),
		Position = UDim2.new(0.5, 0, 0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, hue)
	new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, hueMark)
	local hueHit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, hue)

	-- Champ hexadécimal
	local hex = new("TextBox", {
		Position = UDim2.new(0, 8, 0, 114), Size = UDim2.new(1, -16, 0, 24), BackgroundColor3 = T.Off,
		BackgroundTransparency = 0.4, Text = "", PlaceholderText = "#FFFFFF", TextColor3 = T.Text, TextSize = 12,
		Font = F_MED, ClearTextOnFocus = false, BorderSizePixel = 0,
	}, panel)
	corner(hex, 6)
	trackStyled(hex, nil, "input")

	local item = {}
	local function refreshHex()
		if not hex:IsFocused() then hex.Text = "#" .. string.upper(col:ToHex()) end
	end
	local function visuals()
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		cursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueMark.Position = UDim2.new(0.5, 0, h, 0)
		swatch.BackgroundColor3 = col
		refreshHex()
	end
	local function commit(silent)
		col = Color3.fromHSV(h, s, v)
		if o.Flag then Library.Flags[o.Flag] = { R = col.R, G = col.G, B = col.B } end
		visuals()
		if not silent then fire(o.Callback, col) end
	end

	svHit.InputBegan:Connect(function(i)
		if isPress(i) then
			startDrag(function(p)
				local y = p.Y + guiInset().Y
				s = math.clamp((p.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
				v = 1 - math.clamp((y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
				commit()
			end, self.Scroll, i.Position)
		end
	end)
	hueHit.InputBegan:Connect(function(i)
		if isPress(i) then
			startDrag(function(p)
				local y = p.Y + guiInset().Y
				h = math.min(math.clamp((y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 1), 0.999)
				commit()
			end, self.Scroll, i.Position)
		end
	end)
	head.MouseButton1Click:Connect(function() dr:Set(not dr.Open) end)

	item.Set = function(...)
		local c = unself(item, ...)
		if type(c) == "table" then
			c = Color3.new(c.R or c.r or 1, c.G or c.g or 1, c.B or c.b or 1)
		end
		if typeof(c) ~= "Color3" then return end
		local nh, ns, nv = c:ToHSV()
		if ns > 0.001 and nv > 0.001 then h = nh end
		s, v = ns, nv
		commit()
		-- on garde exactement la couleur demandée
		col = c
		swatch.BackgroundColor3 = c
		refreshHex()
	end
	item.Get = function() return col end

	hex.FocusLost:Connect(function()
		local txt = string.gsub(hex.Text, "#", "")
		local ok, c = pcall(Color3.fromHex, txt)
		if ok and typeof(c) == "Color3" then item.Set(c) end
		hex.Text = "#" .. string.upper(col:ToHex())
	end)

	commit(true)
	register(o.Flag, item, { R = col.R, G = col.G, B = col.B })
	if Library.FireDefaults then fire(o.Callback, col) end
	return item
end

