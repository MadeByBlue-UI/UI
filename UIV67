-- ============================================================================
-- DÉFILEMENT FLUIDE V2 (molette) : la lib prend elle-même la molette. Le défilement natif est coupé sur ces cadres
-- (ScrollingEnabled = false), donc plus de « saut natif puis retour » : un ressort amorti fait glisser le contenu, et la fin est
-- nette (au moins ~1 px par image puis arrêt, plus de micro-décalages d'un pixel). La barre de défilement reste affichée.
-- Library.SmoothScroll = false / Library:SetSmoothScroll(false) : défilement natif · Library.SmoothScrollStep (px par cran, 64)
-- Library.SmoothScrollSpeed (raideur, 20) · Library.SmoothScrollLegacy = true : ancien mode · tactile pur : ancien mode.
-- Les cadres horizontaux (ScrollingDirection = X) ne sont pas touchés.
-- ============================================================================
Library.SmoothScrollStep  = 64
Library.SmoothScrollSpeed = 20
do -- (portée réduite : limite de 200 locals)
local CAS = game:GetService("ContextActionService")
local frames = setmetatable({}, { __mode = "k" })   -- cadre -> état { pos, vel, target, last }
local active, cand = {}, {}                         -- cadres qui glissent / cadres sous la souris au dernier cran
local loopConn, queued, wz = nil, false, 0
local touchOnly = UIS.TouchEnabled and not UIS.MouseEnabled
local SINK, PASS = Enum.ContextActionResult.Sink, Enum.ContextActionResult.Pass

local function owns(sf) return frames[sf] ~= nil and Library.SmoothScroll ~= false end
Library._ownsScroll = owns

local function maxOf(sf)
	return math.max(0, (sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y) / pxScale())
end
local function canScroll(sf)
	return owns(sf) and sf.Visible and sf.AbsoluteWindowSize.Y > 0 and sf.AbsoluteCanvasSize.Y > sf.AbsoluteWindowSize.Y + 1
end

local function loop(dt)
	dt = math.min(dt, 1 / 20)
	local w, px = Library.SmoothScrollSpeed or 20, pxScale()
	for sf, st in pairs(active) do
		if not sf.Parent then
			active[sf] = nil
		else
			local ox = st.pos
			local p, v = Library._springStep(ox, st.vel, st.target, w, 1, dt)
			local dir = (st.target >= ox) and 1 or -1
			if math.abs(st.target - p) * px < 1 then
				p, v = st.target, 0                       -- à moins d'1 px : terminé, net
			else
				local minStep = 80 * dt / px              -- queue : au moins ~1 px écran par image
				if (p - ox) * dir < minStep then
					p = ox + dir * minStep
					if (st.target - p) * dir <= 0 then p = st.target end
					v = dir * 80 / px
				end
			end
			st.pos, st.vel = p, v
			local fin = (p == st.target)
			local wp = fin and p or math.floor(p * px + 0.5) / px   -- position alignée sur un pixel écran
			sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, wp)
			local act = sf.CanvasPosition.Y
			st.last = act
			if math.abs(act - wp) > 1.5 then              -- haut / bas du contenu atteint
				st.pos, st.target, st.vel = act, act, 0
				active[sf] = nil
			elseif fin then
				active[sf] = nil
			end
		end
	end
	if next(active) == nil and loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
end

local function overWindow()
	local win = Library.Window
	local m = win and win.Main
	if not (m and m.Visible and m.AbsoluteSize.X > 0) then return false end
	local g = win.Gui
	if g and g.Enabled == false then return false end
	local p = Library._pointerPos({ X = 0, Y = 0 })
	local ap, as = m.AbsolutePosition, m.AbsoluteSize
	return p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y
end

-- la molette ne doit pas zoomer la caméra du jeu quand elle sert à défiler dans la fenêtre
local function bindSink()
	if Library._wheelSink then return end
	Library._wheelSink = true
	pcall(function()
		CAS:BindActionAtPriority("UiLibWheelSink", function()
			if overWindow() then return SINK end
			return PASS
		end, false, 2000, Enum.UserInputType.MouseWheel)
	end)
end

local function resolve()
	queued = false
	local z = wz
	wz = 0
	local best
	-- cadres qui ont reçu la molette (Roblox gère déjà ce qui est caché par un autre élément) : le plus profond gagne
	for sf in pairs(cand) do
		cand[sf] = nil
		if canScroll(sf) and (not best or sf:IsDescendantOf(best)) then best = sf end
	end
	if not best and overWindow() then
		-- aucun cadre n'a signalé la molette : repli par position du pointeur (le plus petit cadre qui le contient)
		local m = Library._pointerPos({ X = 0, Y = 0 })
		local bestA
		for sf in pairs(frames) do
			if canScroll(sf) and Ticker.shown(sf) then
				local ap, as = sf.AbsolutePosition, sf.AbsoluteSize
				if m.X >= ap.X and m.X <= ap.X + as.X and m.Y >= ap.Y and m.Y <= ap.Y + as.Y then
					local a = as.X * as.Y
					if not bestA or a < bestA then best, bestA = sf, a end
				end
			end
		end
	end
	if not best or z == 0 then return end
	local st = frames[best]
	if not active[best] then
		local y = best.CanvasPosition.Y
		st.pos, st.vel, st.target = y, 0, y
	end
	st.target = math.clamp(st.target - z * (Library.SmoothScrollStep or 64), 0, maxOf(best))
	if Library.Animations == false then
		best.CanvasPosition = Vector2.new(best.CanvasPosition.X, st.target)
		st.last = best.CanvasPosition.Y
		st.pos, st.target, st.vel = st.last, st.last, 0
		active[best] = nil
		return
	end
	if math.abs(st.target - st.pos) < 0.01 then return end
	active[best] = st
	if not loopConn then loopConn = Ticker.connect(loop) end
end

track(UIS.InputChanged:Connect(function(i)
	if touchOnly or i.UserInputType ~= Enum.UserInputType.MouseWheel then return end
	wz += i.Position.Z
	if not queued then
		queued = true
		task.defer(resolve)
	end
end))

function Library:SetSmoothScroll(on)
	Library.SmoothScroll = on ~= false
	table.clear(active)
	for sf in pairs(frames) do
		pcall(function() sf.ScrollingEnabled = not Library.SmoothScroll end)
	end
end

function Library._regScroll(sf)
	if touchOnly or Library.SmoothScrollLegacy then return Library._regScrollLegacy(sf) end
	if sf.ScrollingDirection == Enum.ScrollingDirection.X then return end
	local st = { pos = 0, vel = 0, target = 0, last = sf.CanvasPosition.Y }
	frames[sf] = st
	if Library.SmoothScroll ~= false then sf.ScrollingEnabled = false end
	sf.InputChanged:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseWheel then cand[sf] = true end
	end)
	sf:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		local y = sf.CanvasPosition.Y
		if math.abs(y - st.last) < 0.75 then return end   -- notre propre écriture
		-- changement venu d'ailleurs (code, défilement vers un élément...) : on repart de la vraie position
		st.last, st.pos, st.target, st.vel = y, y, y, 0
		active[sf] = nil
	end)
	bindSink()
end
end -- fin de la portée réduite

-- Dégradés qui tournent (anneaux du trou noir, bordure de la fenêtre...)
local spinners = {}
local function spin(g, speed)
	spinners[#spinners + 1] = { g = g, speed = speed }
	return g
