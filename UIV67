-- requête HTTP : fonction de l'exécuteur si présente, sinon game:HttpGet
local function homeHttpGet(url)
	local req = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
	if req then
		local ok, res = pcall(req, { Url = url, Method = "GET", Headers = { ["User-Agent"] = "Ui-Lib", ["Accept"] = "application/vnd.github+json" } })
		if ok and type(res) == "table" then
			local body = res.Body or res.body
			if body and body ~= "" then return body end
		end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and body and body ~= "" then return body end
	return nil
end
local function homeJson(url)
	local body = homeHttpGet(url)
	if not body then return nil end
	local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
	return (ok and type(d) == "table") and d or nil
end

-- ---------------------------------------------------------------------------
-- MISES À JOUR AUTOMATIQUES (depuis l'historique des commits GitHub du fichier)
--   • Rien à écrire à la main : Library.UpdateURL (lien RAW du fichier, déjà renseigné plus bas) suffit. Le dépôt, la branche et le
--     nom du fichier en sont déduits tout seuls.
--   • Toutes les UpdateInterval secondes, l'UI lit les derniers commits de CE fichier (API publique de GitHub) et les affiche dans
--     Home > Nouveautés : titre du commit = titre de la mise à jour, lignes suivantes du message = détails, + date et auteur.
--   • Un commit plus récent que le code actuellement chargé est marqué « NOUVEAU (à recharger) » + notification.
--   • Pour publier une mise à jour : fais juste un commit sur GitHub avec un message clair (1re ligne = titre, lignes suivantes = détails).
--     Étiquettes au début d'une ligne de détail : « + » Ajout · « ~ » Amélioration · « ! » Correction · « -- » Supprimé (ou les mots Ajout / Fix / Suppression...).
--   • Library.OnUpdate = function(idCommit, nouveauxCommits) ... end  (optionnel)  ·  Library.OnReload = function(source) ... end
--     (optionnel : appelé par le bouton « Recharger maintenant » de Home avec le code RAW à jour).
--   • Library:CheckUpdate() vérifie tout de suite · Library.AutoUpdateCheck = false coupe la vérification automatique.
--   • Limite GitHub sans compte : 60 requêtes / heure / IP -> intervalle par défaut 300 s (minimum 60 s).
-- ---------------------------------------------------------------------------
Library.UpdateURL = Library.UpdateURL or "https://raw.githubusercontent.com/MadeByBlue-UI/UI/refs/heads/main/UIV67"
Library.UpdateInterval = 300
Library.UpdateCommits = 15   -- nombre de commits affichés dans Home
Library.Commits = {}
Library.AutoUpdateCheck = true
Library.UpdateStatus = { Last = nil, Remote = nil, Available = false, Error = nil, Source = nil }

local function verParts(v)
	local t = {}
	for n in tostring(v):gmatch("%d+") do t[#t + 1] = tonumber(n) end
	return t
end
local function verCmp(a, b)   -- > 0 si a est plus récente que b
	local x, y = verParts(a), verParts(b)
	for i = 1, math.max(#x, #y) do
		local d = (x[i] or 0) - (y[i] or 0)
		if d ~= 0 then return d end
	end
	return 0
end

do
	-- déduit propriétaire / dépôt / branche / chemin d'un lien RAW (ou github.com/.../blob|commits/...)
	local function ghParse(url)
		url = tostring(url or "")
		local o, r, br, pa = url:match("raw%.githubusercontent%.com/([^/]+)/([^/]+)/refs/heads/([^/]+)/([^?#]+)")
		if not o then o, r, br, pa = url:match("raw%.githubusercontent%.com/([^/]+)/([^/]+)/([^/]+)/([^?#]+)") end
		if not o then o, r, br, pa = url:match("github%.com/([^/]+)/([^/]+)/blob/([^/]+)/([^?#]+)") end
		if not o then o, r, br, pa = url:match("github%.com/([^/]+)/([^/]+)/commits/([^/]+)/([^?#]+)") end
		return o, r, br, pa
	end

	function Library:_commitsURL()
		local o, r, br, pa = ghParse(Library.UpdateURL)
		if not o then return nil end
		return string.format("https://api.github.com/repos/%s/%s/commits?sha=%s&path=%s&per_page=%d",
			o, r, HttpService:UrlEncode(br), HttpService:UrlEncode(pa), math.clamp(math.floor(tonumber(Library.UpdateCommits) or 15), 1, 50))
	end

	local function ghDate(iso)
		local y, m, d = tostring(iso or ""):match("(%d+)%-(%d+)%-(%d+)")
		if not y then return nil end
		return string.format("%d %s %s", tonumber(d), MONTHS[tonumber(m)] or m, y)
	end

	-- étiquette une ligne du message de commit : [Ajout] / [Amélioration] / [Correction] / [Supprimé]
	--   symboles : « + texte » ajout · « ~ texte » amélioration · « ! texte » correction · « -- texte » suppression
	--   ou mots au début : Ajout / Ajouté / Add · Amélioration / Update / Change · Fix / Correction · Suppression / Retiré / Remove
	local GH_WORDS = {
		{ "Ajout", { "ajout", "add", "new", "nouveau" } },
		{ "Amélioration", { "amélior", "amelior", "improve", "update", "change", "modif" } },
		{ "Correction", { "correct", "fix", "bug" } },
		{ "Supprimé", { "suppr", "retir", "remove", "delete", "enlev" } },
	}
	local function ghTag(l)
		local kind, rest
		if l:sub(1, 2) == "--" then kind, rest = "Supprimé", l:sub(3)
		elseif l:sub(1, 1) == "+" then kind, rest = "Ajout", l:sub(2)
		elseif l:sub(1, 1) == "~" then kind, rest = "Amélioration", l:sub(2)
		elseif l:sub(1, 1) == "!" then kind, rest = "Correction", l:sub(2)
		else
			local low = l:lower()
			for _, g in ipairs(GH_WORDS) do
				for _, w in ipairs(g[2]) do
					if low:sub(1, #w) == w then
						kind = g[1]
						rest = l:gsub("^[^%s:]+%s*[:%-]?%s*", "")
						break
					end
				end
				if kind then break end
			end
		end
		if kind then
			rest = rest:match("^%s*(.-)%s*$")
			if rest ~= "" then return "[" .. kind .. "] " .. rest end
		end
		return (l:gsub("^[%-%*]%s*", ""):gsub("^•%s*", ""))
	end

	-- un commit -> une entrée « Nouveautés »
	local function ghEntry(c)
		local cm = type(c.commit) == "table" and c.commit or {}
		local msg = tostring(cm.message or ""):gsub("\r", "")
		local title, details = nil, {}
		for line in (msg .. "\n"):gmatch("(.-)\n") do
			local l = line:match("^%s*(.-)%s*$")
			if l ~= "" then
				if not title then
					title = l
				else
					details[#details + 1] = ghTag(l)
				end
			end
		end
		local author = type(cm.author) == "table" and cm.author.name or nil
		local when = type(cm.author) == "table" and cm.author.date or (type(cm.committer) == "table" and cm.committer.date) or nil
		local sha = tostring(c.sha):sub(1, 7)
		local body
		if #details > 0 then
			body = "• " .. table.concat(details, "\n• ")
		else
			body = "Commit #" .. sha .. (author and (" par " .. tostring(author)) or "")
		end
		return { Sha = sha, Title = title or ("Commit #" .. sha), Body = body, Date = ghDate(when), Author = author }
	end

	function Library:CheckUpdate(silent)
		local st = Library.UpdateStatus
		local function fail(msg)
			st.Error = msg
			if Library._updRefresh then Library._updRefresh() end
			return false
		end
		local api = Library:_commitsURL()
		st.Last = os.time()
		if not api then return fail("UpdateURL invalide (lien RAW GitHub attendu)") end
		local list = homeJson(api)
		if not list then return fail("GitHub injoignable (ou limite de requêtes atteinte)") end
		if type(list[1]) ~= "table" then
			return fail(tostring(list.message or "Aucun commit trouvé pour ce fichier"):sub(1, 60))
		end
		local entries = {}
		for _, c in ipairs(list) do
			if type(c) == "table" and c.sha then entries[#entries + 1] = ghEntry(c) end
		end
		if #entries == 0 then return fail("Aucun commit trouvé pour ce fichier") end
		st.Error = nil

		-- le code chargé = le dernier commit vu à la 1re vérification ; tout ce qui est plus récent est « à recharger »
		if not Library.LoadedSha then Library.LoadedSha = entries[1].Sha end
		local idx = #entries + 1
		for i, e in ipairs(entries) do
			if e.Sha == Library.LoadedSha then idx = i break end
		end
		for i, e in ipairs(entries) do e.Pending = i < idx end
		local top = entries[1]
		local prevTop = Library._ghTop
		Library._ghTop = top.Sha
		st.Loaded, st.Remote, st.Available = Library.LoadedSha, top.Sha, idx > 1

		local sigParts = {}
		for _, e in ipairs(entries) do sigParts[#sigParts + 1] = e.Sha .. (e.Pending and "!" or "") end
		local sig = table.concat(sigParts, ",")
		Library.Commits = entries
		if sig ~= Library._ghSig then
			Library._ghSig = sig
			local win = Library.Window
			if win and win._homeTab then pcall(Library._buildChangelog, Library, win._homeTab) end
		end

		if prevTop and prevTop ~= top.Sha then
			local fresh = {}
			for _, e in ipairs(entries) do
				if e.Sha == prevTop then break end
				fresh[#fresh + 1] = e
			end
			if not silent then
				Library:Notify({ Title = "Mise à jour disponible", Type = "Info", Duration = 6,
					Content = top.Title .. " : les détails sont dans Home. Recharge le script pour l'appliquer." })
			end
			if Library.OnUpdate then pcall(Library.OnUpdate, top.Sha, fresh) end
		end
		if Library._updRefresh then Library._updRefresh() end
		return true
	end
end

function Library:StartUpdateWatcher()
	Library._updToken = (Library._updToken or 0) + 1
	local token = Library._updToken
	if not Library.UpdateURL or Library.UpdateURL == "" then return end
	task.spawn(function()
		task.wait(2)
		while Library._updToken == token do
			if Library.AutoUpdateCheck ~= false then pcall(Library.CheckUpdate, Library) end
			task.wait(math.max(60, tonumber(Library.UpdateInterval) or 300))
		end
	end)
end

