function Library:Round(value, decimals)
    decimals = decimals or 0
    if decimals <= 0 then
        return math.floor(value + 0.5)
    end
    local mult = 10 ^ decimals
    return math.floor(value * mult + 0.5) / mult
end

function Library:Lerp(a, b, t)
    return a + (b - a) * t
end

function Library:Clamp(value, minimum, maximum)
    return math.max(minimum, math.min(maximum, value))
end

function Library:MapValue(value, inMin, inMax, outMin, outMax)
    if inMax == inMin then
        return outMin
    end
    return (value - inMin) * (outMax - outMin) / (inMax - inMin) + outMin
end

function Library:SafeCallback(fn, ...)
    if type(fn) ~= "function" then
        return
    end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[Singularity] callback error: " .. tostring(err))
    end
end

function Library:ColorToHex(color)
    return string.format("%02X%02X%02X",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5))
end

function Library:HexToColor(hex)
    if type(hex) ~= "string" then
        return nil
    end
    hex = hex:gsub("#", ""):gsub("%s", "")
    if #hex == 3 then
        hex = hex:sub(1, 1):rep(2) .. hex:sub(2, 2):rep(2) .. hex:sub(3, 3):rep(2)
    end
    if #hex ~= 6 or hex:find("[^0-9a-fA-F]") then
        return nil
    end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    return Color3.fromRGB(r, g, b)
end

--- Black or white, whichever reads better on top of `color`.
function Library:ContrastColor(color)
    local luminance = color.R * 0.299 + color.G * 0.587 + color.B * 0.114
    return luminance > 0.6 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
end

function Library:Darken(color, amount)
    local h, s, v = color:ToHSV()
    return Color3.fromHSV(h, s, math.clamp(v * (1 - amount), 0, 1))
end

function Library:Lighten(color, amount)
    local h, s, v = color:ToHSV()
    return Color3.fromHSV(h, math.clamp(s * (1 - amount * 0.5), 0, 1), math.clamp(v + (1 - v) * amount, 0, 1))
end

function Library:MixColors(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

function Library:GetTextBounds(text, font, size, width)
    local ok, bounds = pcall(function()
        return TextService:GetTextSize(text, size or self.TextSize, font or self.Font, Vector2.new(width or 10000, 10000))
    end)
    if ok and bounds then
        return bounds.X, bounds.Y
    end
    return #text * (size or self.TextSize) * 0.55, size or self.TextSize
end

function Library:IsClick(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

function Library:IsRightClick(input)
    return input.UserInputType == Enum.UserInputType.MouseButton2
end

function Library:IsMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

function Library:GetViewportSize()
    local camera = workspace.CurrentCamera
    if camera then
        return camera.ViewportSize
    end
    return Vector2.new(1280, 720)
end

function Library:GetMouseLocation()
    return UserInputService:GetMouseLocation()
end

function Library:CopyToClipboard(text)
    if clipboard_fn then
        local ok = pcall(clipboard_fn, text)
        return ok
    end
    return false
end

function Library:Connect(signal, fn)
    local connection = signal:Connect(fn)
    self.Maid:Give(connection)
    return connection
end

function Library:OnUnload(fn)
    table.insert(self.UnloadSignals, fn)
end

function Library:GetPlayerNames(excludeLocal)
    local names = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if not (excludeLocal and player == LocalPlayer) then
            table.insert(names, player.Name)
        end
    end
    table.sort(names)
    return names
end

function Library:GetTeamNames()
    local names = {}
    if TeamsService then
        for _, team in ipairs(TeamsService:GetTeams()) do
            table.insert(names, team.Name)
        end
    end
    table.sort(names)
    return names
end

function Library:SplitString(str, delimiter)
    local out = {}
    for piece in string.gmatch(str, "([^" .. delimiter .. "]+)") do
        table.insert(out, piece)
    end
    return out
end

function Library:Trim(str)
    return (str:gsub("^%s+", ""):gsub("%s+$", ""))
end

function Library:KeyName(key)
    if typeof(key) == "EnumItem" then
        return key.Name
    end
    return tostring(key)
end

