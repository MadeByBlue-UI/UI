local tipLabel, tipShown = nil, false   -- créés par CreateWindow

-- Tooltip : apparaît en fondu, posé sous l'élément (collé à son bord droit, en bas à droite), ne suit plus la souris.
-- Il reprend à chaque affichage le style courant (Standard / Verre / Givré / Mat / Néon), les couleurs du thème
-- (Or, Violet...), la police et les coins du type d'interface (Classique / Éclipse / Carré).
do
	local tok = 0
	local FADE_IN, FADE_OUT = 0.2, 0.14

	local function skin()
		local st = Library._tipStroke
		local sq = Library.SquareMode == true
		local neon = Library.StyleName == "Néon"
		-- V5.8 : tooltip lisible -> fond éclairci (teinte du thème) presque opaque, texte blanc, un peu plus gros
		tipLabel.BackgroundColor3 = lighten(T.Second, 0.16)
		tipLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		tipLabel.Font = Enum.Font.GothamMedium
		tipLabel.TextSize = math.max(10, math.floor(14 * (Library.FontScale or 1) + 0.5))
		local cr = Library._tipCorner
		if cr then cr.CornerRadius = UDim.new(0, sq and 0 or math.floor(7 * (Library.GlobalCornerValue or 10) / 10)) end
		-- reflet de verre sur le fond
		local fill = tipLabel:FindFirstChild("TipGlassFill")
		if Sty.Glass then
			if not fill then
				fill = Instance.new("UIGradient")
				fill.Name = "TipGlassFill"
				fill.Rotation = 40
				fill.Parent = tipLabel
			end
			fill.Color = ColorSequence.new(lighten(T.Second, 0.30), lighten(T.Second, 0.12))
			fill.Enabled = true
		elseif fill then
			fill.Enabled = false
		end
		if st then
			st.Color = T.Accent
			st.Thickness = neon and 2 or 1.5
			local g = st:FindFirstChild("GlassGrad")
			if Sty.Glass then
				if not g then
					g = Instance.new("UIGradient")
					g.Name = "GlassGrad"
					g.Rotation = 40
					g.Transparency = GLASS_EDGE
					g.Parent = st
				end
				g.Enabled = true
			elseif g then
				g.Enabled = false
			end
		end
	end

	local function targets()
		-- quasi opaque pour rester lisible sur n'importe quel fond (même en style Verre / Givré), contour bien visible
		return 0.04, 0.15
	end

	function Library._tipShow(text, anchor)
		if not tipLabel then return end
		tok += 1
		local my = tok
		local st = Library._tipStroke
		skin()
		tipLabel.Text = tostring(text)
		tipShown = true
		if not tipLabel.Visible then   -- départ du fondu
			tipLabel.BackgroundTransparency = 1
			tipLabel.TextTransparency = 1
			if st then st.Transparency = 1 end
		end
		tipLabel.Visible = true
		task.spawn(function()
			task.wait()   -- laisse la taille automatique se calculer, puis on pose le tooltip une bonne fois pour toutes
			if tok ~= my or not tipLabel then return end
			local v = viewport()
			local sz = tipLabel.AbsoluteSize
			local x, y
			if anchor and anchor.Parent then
				local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
				x = ap.X + as.X                 -- bord droit de l'élément
				y = ap.Y + as.Y + 6             -- juste sous l'élément
				if y + sz.Y > v.Y - 4 then y = ap.Y - sz.Y - 6 end   -- pas de place en bas : au-dessus
			else
				local m = UIS:GetMouseLocation()
				x, y = m.X + sz.X * 0.5, m.Y + 18
				if y + sz.Y > v.Y - 4 then y = m.Y - sz.Y - 10 end
			end
			x = math.clamp(x, sz.X + 4, math.max(v.X - 4, sz.X + 4))
			y = math.max(4, y)
			tipLabel.AnchorPoint = Vector2.new(1, 0)
			tipLabel.Position = UDim2.fromOffset(x, y)
			local bg, sTr = targets()
			tween(tipLabel, { BackgroundTransparency = bg, TextTransparency = 0 }, FADE_IN, LINEAR)
			if st then tween(st, { Transparency = sTr }, FADE_IN, LINEAR) end
		end)
	end

	function Library._tipHide()
		tok += 1
		tipShown = false
		if not (tipLabel and tipLabel.Visible) then return end
		local my = tok
		local st = Library._tipStroke
		tween(tipLabel, { BackgroundTransparency = 1, TextTransparency = 1 }, FADE_OUT, LINEAR)
		if st then tween(st, { Transparency = 1 }, FADE_OUT, LINEAR) end
		task.delay(FADE_OUT + 0.04, function()
			if tok == my and tipLabel then tipLabel.Visible = false end
		end)
	end
end

local function attachTip(frame, text)
	text = tostring(text)
	local token = 0
	frame.MouseEnter:Connect(function()
		token += 1
		local my = token
		task.delay(0.4, function()
			if token ~= my or not tipLabel then return end
			Library._tipShow(text, frame)
		end)
	end)
	frame.MouseLeave:Connect(function()
		token += 1
		Library._tipHide()
	end)
end

local function favList()
	local out = {}
	for k, v in pairs(Library.Favorites) do
		if v then out[#out + 1] = k end
	end
	table.sort(out)
	return out
end

function Library:SetFavorite(key, on)
	on = on and true or false
	Library.Favorites[key] = on or nil
	local star = Library.FavStars[key]
	if star and star.Parent then tween(star, { TextTransparency = on and 0.05 or 0.8 }, 0.2) end
	Library.Flags["__favorites"] = favList()
	local w = Library.Window
	local ft = w and w.FavTab
	if ft and w.Current == ft and ft.OnSelect then
		local rows = ft._favRows and ft._favRows[key]
		if not on and rows and Library.Animations then
			-- la ligne se réduit puis disparaît, ensuite seulement on reconstruit l'onglet
			ft._favGen = (ft._favGen or 0) + 1
			local g = ft._favGen
			local any = false
			for _, fr in ipairs(rows) do
				if fr.Parent and fr.AutomaticSize == Enum.AutomaticSize.None then
					any = true
					fr.ClipsDescendants = true
					tween(fr, { Size = UDim2.new(fr.Size.X.Scale, fr.Size.X.Offset, 0, 0) }, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				end
			end
			if any then
				task.delay(0.24 / math.max(Library.AnimSpeed or 1, 0.05), function()
					if ft._favGen == g and w.Current == ft and ft.OnSelect then ft.OnSelect() end
				end)
				return
			end
		end
		ft._favGen = (ft._favGen or 0) + 1
		if on then ft._animIn = ft._animIn or {} ft._animIn[key] = true end
		ft.OnSelect()
	end
end

local function registerFavItem()
	Library.Flags["__favorites"] = favList()
	Library.Items["__favorites"] = {
		Get = function() return favList() end,
		Set = function(_, list)
			if type(list) ~= "table" then return end
			local newSet = {}
			for _, k in ipairs(list) do newSet[tostring(k)] = true end
			for k in pairs(Library.Favorites) do
				if not newSet[k] then Library:SetFavorite(k, false) end
			end
			for k in pairs(newSet) do Library:SetFavorite(k, true) end
		end,
	}
end

-- Barre de progression / jauge : mise à jour par le script (cooldowns, chargement...).
--   local p = block:CreateProgress({ Name = "Cooldown", Min = 0, Max = 100, Default = 0,
--       Suffix = " %" (ou Format = function(v, ratio, max) return "..." end), Color = Color3, Text = "texte fixe", Tooltip = "..." })
--   p:Set(v) · p:Get() · p:GetRatio() · p:SetMax(m) · p:SetText("...") / p:SetText(nil) · p:SetColor(c) · p:SetName("...")
--   p:Countdown(secondes, { Fill = false, ShowTime = true, OnDone = function() end })   -- cooldown : se vide en N secondes
--   p:SetIndeterminate(true)   -- chargement sans valeur connue · p:Cancel() arrête le décompte / le chargement
function Block:CreateProgress(o)
	o = o or {}
	local min, max = tonumber(o.Min) or 0, tonumber(o.Max) or 100
	if max <= min then max = min + 1 end
	local suffix = (o.Suffix ~= nil) and tostring(o.Suffix) or nil
	local customText = (o.Text ~= nil) and tostring(o.Text) or nil

	local f, st = makeRow(self, 46, o.Name)
	hover(f, st)
	local nameL = label(f, o.Name or "Progression", 13, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -118, 0, 18) })
	local valL = label(f, "", 12, { Position = UDim2.new(1, -106, 0, 6), Size = UDim2.new(0, 94, 0, 18),
		TextXAlignment = RIGHT, TextColor3 = T.ElementAccent })
	Library._rollText(valL)
	local bar = new("Frame", { Position = UDim2.new(0, 12, 0, 31), Size = UDim2.new(1, -24, 0, 8),
		BackgroundColor3 = T.Off, BorderSizePixel = 0, ClipsDescendants = true }, f)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = o.Color or T.Accent,
		BorderSizePixel = 0 }, bar)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	-- texte de la valeur : à droite du nom s'il est court (la largeur s'adapte) ; à partir de 27 caractères il devient
	-- une boîte de texte sous le nom (retour à la ligne) et la barre descend en dessous.
	local boxPad = new("UIPadding", {}, valL)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, valL)
	local lastKey, firstLay = nil, true
	valL.AnchorPoint = Vector2.new(0, 0)
	-- transition fluide entre « valeur à droite » et « boîte sous le nom » (direct au tout premier calcul)
	local function go(obj, props)
		if firstLay then
			for k, v in pairs(props) do obj[k] = v end
		else
			tween(obj, props, 0.32)
		end
	end
	local function layoutRow()
		local W = f.AbsoluteSize.X / math.max(pxScale(), 0.05)
		if W <= 0 then return end
		local txt = valL.Text
		local key = txt .. "|" .. math.floor(W)
		if key == lastKey then return end
		lastKey = key
		if isLongText(txt) then
			local bh = math.ceil(measureText(txt, valL.TextSize, valL.Font, math.max(W - 24 - 16, 40)).Y) + 12
			nameL.TextXAlignment = CENTER   -- nom centré au-dessus de la boîte de texte
			valL.TextWrapped = true
			valL.TextTruncate = Enum.TextTruncate.None
			valL.TextXAlignment = LEFT
			valL.TextYAlignment = Enum.TextYAlignment.Top
			valL.BackgroundColor3 = T.Off
			go(nameL, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 0, 18) })
			go(valL, { Position = UDim2.new(0, 12, 0, 28), Size = UDim2.new(1, -24, 0, bh), BackgroundTransparency = 0.5 })
			go(boxPad, { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) })
			go(bar, { Position = UDim2.new(0, 12, 0, 28 + bh + 6) })
			go(f, { Size = UDim2.new(1, 0, 0, 28 + bh + 6 + 8 + 8) })
		else
			nameL.TextXAlignment = LEFT
			valL.TextWrapped = false
			valL.TextTruncate = Enum.TextTruncate.AtEnd
			valL.TextXAlignment = RIGHT
			valL.TextYAlignment = Enum.TextYAlignment.Center
			local avail = W - 24 - 8
			local valW = math.clamp(measureText(txt, valL.TextSize, valL.Font).X + 2, 94, math.max(avail * 0.6, 94))
			go(nameL, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(0, math.max(avail - valW, 20), 0, 18) })
			go(valL, { Position = UDim2.new(1, -12 - valW, 0, 6), Size = UDim2.new(0, valW, 0, 18), BackgroundTransparency = 1 })
			go(boxPad, { PaddingLeft = UDim.new(0, 0), PaddingRight = UDim.new(0, 0), PaddingTop = UDim.new(0, 0), PaddingBottom = UDim.new(0, 0) })
			go(bar, { Position = UDim2.new(0, 12, 0, 31) })
			go(f, { Size = UDim2.new(1, 0, 0, 46) })
		end
		firstLay = false
	end
	f:GetPropertyChangedSignal("AbsoluteSize"):Connect(Library._lazy(layoutRow))
	valL:GetPropertyChangedSignal("Text"):Connect(layoutRow)

	local value = math.clamp(tonumber(o.Default or o.Value) or min, min, max)
	local runTw, runTok, indet = nil, 0, nil

	local function ratioOf(v) return math.clamp((v - min) / (max - min), 0, 1) end
	local function fmt(v)
		if type(o.Format) == "function" then
			local ok, s = pcall(o.Format, v, ratioOf(v), max)
			if ok and s ~= nil then return tostring(s) end
		end
		if suffix then return tostring(math.floor(v * 100 + 0.5) / 100) .. suffix end
		return tostring(math.floor(ratioOf(v) * 100 + 0.5)) .. " %"
	end
	local function stopRun()
		runTok += 1
		if runTw then runTw:Cancel() runTw = nil end
		if indet then indet:Cancel() indet = nil end
		fill.Position = UDim2.new(0, 0, 0, 0)
	end
	local function setValue(v, instant)
		value = math.clamp(tonumber(v) or value, min, max)
		valL.Text = customText or fmt(value)
		local goal = UDim2.new(ratioOf(value), 0, 1, 0)
		if instant then fill.Size = goal else tween(fill, { Size = goal }, 0.18) end
	end

	local item = {}
	item.Set = function(...)
		local v, instant = unself(item, ...)
		stopRun()
		setValue(v, instant)
	end
	item.Get = function() return value end
	item.GetRatio = function() return ratioOf(value) end
	item.SetMax = function(...)
		local m = tonumber((unself(item, ...)))
		if m and m > min then
			max = m
			stopRun()
			setValue(value, true)
		end
	end
	item.SetText = function(...)
		local s = unself(item, ...)
		customText = (s ~= nil) and tostring(s) or nil
		valL.Text = customText or fmt(value)
	end
	item.SetColor = function(...)
		local c = unself(item, ...)
		if typeof(c) == "Color3" then tween(fill, { BackgroundColor3 = c }, 0.25) end
	end
	item.SetName = function(...) nameL.Text = tostring((unself(item, ...))) end
	item.Cancel = function()
		stopRun()
		setValue(value, true)
	end
	item.SetIndeterminate = function(...)
		local on = unself(item, ...)
		stopRun()
		if on == false then
			setValue(value, true)
			return
		end
		valL.Text = customText or "..."
		fill.Size = UDim2.new(0.35, 0, 1, 0)
		fill.Position = UDim2.new(-0.35, 0, 0, 0)
		indet = TweenService:Create(fill, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1),
			{ Position = UDim2.new(1, 0, 0, 0) })
		indet:Play()
	end
	-- cooldown : la jauge se vide (ou se remplit avec Fill = true) en N secondes, texte = temps restant
	item.Countdown = function(...)
		local sec, opt = unself(item, ...)
		sec = math.max(tonumber(sec) or 1, 0.05)
		opt = (type(opt) == "table") and opt or {}
		stopRun()
		local from, to = max, min
		if opt.Fill then from, to = min, max end
		value = from
		fill.Size = UDim2.new(ratioOf(from), 0, 1, 0)
		runTw = TweenService:Create(fill, TweenInfo.new(sec, LINEAR, OUT), { Size = UDim2.new(ratioOf(to), 0, 1, 0) })
		runTw:Play()
		local my = runTok
		local t0 = os.clock()
		task.spawn(function()
			while runTok == my and f.Parent do
				local el = os.clock() - t0
				if el >= sec then break end
				value = from + (to - from) * (el / sec)
				if customText then
					valL.Text = customText
				elseif opt.ShowTime == false then
					valL.Text = fmt(value)
				else
					valL.Text = string.format("%.1f s", sec - el)
				end
				task.wait(0.05)
			end
			if runTok ~= my then return end
			runTw = nil
			value = to
			valL.Text = customText or fmt(value)
			if opt.OnDone then fire(opt.OnDone) end
		end)
	end
	item.Instance = f

	setValue(value, true)
	task.defer(layoutRow)
	return item
end

-- Compteur  -  valeur  +  pour les valeurs entières (plus précis qu'un curseur).
--   block:CreateStepper({ Name = "Niveau", Min = 0, Max = 10, Step = 1, Default = 3, Suffix = "", Wrap = false, Flag = "...",
--       Callback = function(v) end })
--   Maintenir un bouton = répétition qui accélère · Maj = pas x10 · clic sur la valeur = saisie au clavier.
--   item:Set(n) · item:Get() · item:Increment() · item:Decrement() · item:SetRange(min, max)
function Block:CreateStepper(o)
	o = o or {}
	local min, max = math.floor(tonumber(o.Min) or 0), math.floor(tonumber(o.Max) or 100)
	if max < min then min, max = max, min end
	local step = math.max(math.floor(tonumber(o.Step or o.Increment) or 1), 1)
	local suffix = (o.Suffix ~= nil) and tostring(o.Suffix) or ""
	local value = math.clamp(math.floor(tonumber(o.Default) or min), min, max)

	local f, st = makeRow(self, 36, o.Name)
	hover(f, st)
	label(f, o.Name or "Compteur", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -150, 1, 0) })

	local function mk(txt, x)
		local b = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0),
			Size = UDim2.fromOffset(26, 24), BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0,
			Text = txt, TextColor3 = T.Text, TextSize = 16, Font = F_BOLD, AutoButtonColor = false }, f)
		corner(b, 6)
		local bst = stroke(b, 0.9)
		trackStyled(b, bst, "input")
		return b
	end
	local plus = mk("+", -8)
	local valBox = new("TextBox", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -38, 0.5, 0),
		Size = UDim2.fromOffset(60, 24), BackgroundColor3 = T.Off, BackgroundTransparency = 0.55, BorderSizePixel = 0,
		Text = "", TextColor3 = T.Text, TextSize = 12, Font = F_MED, ClearTextOnFocus = false,
		TextTruncate = Enum.TextTruncate.AtEnd }, f)
	corner(valBox, 6)
	local vst = stroke(valBox, 0.9)
	trackStyled(valBox, vst, "input")
	local minus = mk("-", -102)

	local function fmt(v) return tostring(v) .. suffix end
	local function apply(v, silent)
		v = math.clamp(math.floor((tonumber(v) or value) + 0.5), min, max)
		local changed = v ~= value
		value = v
		if not valBox:IsFocused() then valBox.Text = fmt(v) end
		tween(minus, { TextTransparency = (o.Wrap or v > min) and 0 or 0.65 }, 0.15)
		tween(plus, { TextTransparency = (o.Wrap or v < max) and 0 or 0.65 }, 0.15)
		if o.Flag then Library.Flags[o.Flag] = v end
		if changed and not silent then fire(o.Callback, v) end
	end
	local function bump(dir)
		local mult = (UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)) and 10 or 1
		local nv = value + dir * step * mult
		if o.Wrap then
			if nv > max then nv = min elseif nv < min then nv = max end
		end
		apply(nv)
	end
	local function holdable(btn, dir)
		local tok = 0
		btn.MouseButton1Down:Connect(function()
			uiSnd("click")
			tween(btn, { BackgroundTransparency = 0.05 }, 0.1)
			bump(dir)
			tok += 1
			local my = tok
			task.spawn(function()
				task.wait(0.45)
				local gap = 0.12
				while tok == my and btn.Parent do
					bump(dir)
					task.wait(gap)
					gap = math.max(gap * 0.88, 0.03)
				end
			end)
		end)
		local function stop()
			tok += 1
			tween(btn, { BackgroundTransparency = Sty.InputTr }, 0.2)
		end
		btn.MouseButton1Up:Connect(stop)
		btn.MouseLeave:Connect(stop)
	end
	holdable(minus, -1)
	holdable(plus, 1)

	valBox.Focused:Connect(function()
		uiSnd("focus")
		valBox.Text = tostring(value)
		tween(valBox, { BackgroundTransparency = 0.25 }, 0.2)
	end)
	valBox.FocusLost:Connect(function()
		tween(valBox, { BackgroundTransparency = 0.55 }, 0.25)
		local n = tonumber(string.match(valBox.Text, "-?%d+"))
		if n then apply(n) end
		valBox.Text = fmt(value)
	end)

	local item = {}
	item.Set = function(...)
		local v = tonumber((unself(item, ...)))
		if v then apply(v) end
	end
	item.Get = function() return value end
	item.Increment = function() bump(1) end
	item.Decrement = function() bump(-1) end
	item.SetRange = function(...)
		local a, b = unself(item, ...)
		a, b = tonumber(a), tonumber(b)
		if a and b then
			min, max = math.floor(math.min(a, b)), math.floor(math.max(a, b))
			apply(value, true)
		end
	end
	apply(value, true)
	register(o.Flag, item, value)
	if Library.FireDefaults then fire(o.Callback, value) end
	return item
end

-- On enrobe chaque élément interactif : tooltip (o.Tooltip) + étoile de favori (o.Favorite = false pour la retirer)
local paletteSeq = 0
local WRAP_KINDS = { "Button", "Toggle", "Slider", "RangeSlider", "Dropdown", "Input", "Keybind", "ColorPicker",
	"Stepper", "Progress" }
for _, kind in ipairs(WRAP_KINDS) do
	local base = Block["Create" .. kind]
	Block["Create" .. kind] = function(self, o)
		local item = base(self, o)
		local opts = type(o) == "table" and o or {}
		local e = self.Entries[#self.Entries]
		if e and e.Frame then
			if opts.Tooltip then attachTip(e.Frame, opts.Tooltip) end
			-- filtre « Modifiés » : { Modified = false } pour exclure un élément
			if kind ~= "Button" and kind ~= "Progress" and not self._noFav and opts.Modified ~= false then
				Library:_trackModified(kind, item, e.Frame, opts, self)
			end
			-- remise à zéro globale (Paramètres > Fenêtre) : { Reset = false } pour exclure un élément
			if (kind == "Toggle" or kind == "Slider" or kind == "RangeSlider" or kind == "Keybind")
				and not self._noFav and opts.Reset ~= false
				and not (self.Tab and self.Tab._isSettings)
				and not (opts.Favorite == false and opts.Palette == false) then
				local okd, defv = pcall(function() return item.Get() end)
				Library.ResetEntries[#Library.ResetEntries + 1] = { Kind = kind, Item = item, Frame = e.Frame,
					Default = okd and copyVal(defv) or nil }
			end
			-- liste des keybinds (bloc « Raccourcis clavier » des Paramètres)
			if kind == "Keybind" and not self._noFav then
				Library.KeybindEntries[#Library.KeybindEntries + 1] = { Name = tostring(opts.Name or "Keybind"),
					Tab = self.Tab, Block = self, Frame = e.Frame, Item = item }
				if Library._onKeybindAdded then pcall(Library._onKeybindAdded) end
				Library:RefreshKeybindConflicts()
				if Library._hudRefresh then Library._hudRefresh() end   -- la touche peut compléter une ligne du HUD
			end
			-- HUD des actifs : { HUD = false } pour cacher un toggle du panneau
			if kind == "Toggle" and not self._noFav and opts.HUD ~= false and not (self.Tab and self.Tab._isSettings) then
				Library.ToggleEntries[#Library.ToggleEntries + 1] = { Name = tostring(opts.Name or "Toggle"), Item = item,
					Frame = e.Frame, Tab = self.Tab, Block = self, HudKey = opts.HudKey }
				if Library._hudRefresh then Library._hudRefresh() end
			end
			-- palette de commandes (Ctrl+K) : { Palette = false } pour exclure un élément
			if not self._noFav and opts.Palette ~= false and kind ~= "Progress" then
				local ptab = self.Tab and self.Tab.Name or ""
				local pkey = tostring(ptab) .. "/" .. tostring(self.Name) .. "/" .. kind .. "/" .. tostring(opts.Name or "")
				paletteSeq = paletteSeq + 1
				Library.CmdEntries[pkey] = { Kind = kind, Opts = opts, Item = item, Key = pkey, Tab = ptab,
					Block = self.Name, Frame = e.Frame, Seq = paletteSeq, Name = tostring(opts.Name or kind) }
			end
			if not self._noFav and opts.Favorite ~= false and kind ~= "Progress" then
				local tabName = self.Tab and self.Tab.Name or ""
				local key = tostring(tabName) .. "/" .. tostring(self.Name) .. "/" .. kind .. "/" .. tostring(opts.Name or "")
				local host = e.Frame
				-- dropdown / color picker : le cadre a un UIListLayout, l'étoile va dans la ligne d'en-tête
				if host:FindFirstChildOfClass("UIListLayout") then
					host = host:FindFirstChildWhichIsA("TextButton") or host
				end
				local star = new("TextButton", {
					Name = "FavStar", Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(1, 1),
					BackgroundTransparency = 1, Text = "★", TextSize = 10, Font = F_BOLD, TextColor3 = T.Accent,
					TextTransparency = Library.Favorites[key] and 0.05 or 0.8, AutoButtonColor = false, ZIndex = 6,
				}, host)
				Library.FavStars[key] = star
				Library.FavEntries[key] = { Kind = kind, Opts = opts, Item = item, Key = key,
					Tab = tabName, Block = self.Name }
				star.MouseButton1Click:Connect(function()
					Library:SetFavorite(key, not Library.Favorites[key])
				end)
			end
		end
		return item
	end
end

-- ============================================================================
-- FILTRE « MODIFIÉS »  (puce à côté de la recherche + Paramètres > Éléments modifiés)
--   Une pastille s'allume sur chaque toggle / slider / liste / champ / couleur / touche / stepper qui n'est plus à sa
--   valeur de départ ; le filtre n'affiche que ceux-là (et ouvre leurs blocs).
--   Library:SetModFilter(bool) · Library:GetModified() -> { noms } · Library:SetModBaseline() (valeur actuelle = référence)
--   { Modified = false } sur un élément l'exclut.
-- ============================================================================
local function modSig(v)
	local t = typeof(v)
	if t == "number" then
		return string.format("%.4f", v)
	elseif t == "Color3" then
		return string.format("c%d,%d,%d", math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5))
	elseif t == "table" then
		local parts = {}
		if #v > 0 then
			for _, x in ipairs(v) do parts[#parts + 1] = modSig(x) end
			table.sort(parts)
			return "[" .. table.concat(parts, ",") .. "]"
		end
		for k, x in pairs(v) do parts[#parts + 1] = tostring(k) .. "=" .. modSig(x) end
		table.sort(parts)
		return "{" .. table.concat(parts, ",") .. "}"
	end
	return tostring(v)
end

function Library:_trackModified(kind, item, frame, opts, blk)
	if not frame then return end
	local host = frame
	if host:FindFirstChildOfClass("UIListLayout") then host = host:FindFirstChildWhichIsA("TextButton") or host end
	local dot = new("Frame", { Name = "ModDot", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0,
		ZIndex = 7, Active = false }, host)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	local en = { Kind = kind, Item = item, Frame = frame, Dot = dot, Name = tostring(opts.Name or kind), Mod = false, Shown = 1,
		Opts = opts, TabName = blk and blk.Tab and blk.Tab.Name or "", BlockName = blk and blk.Name or "",
		IsSettings = (blk and blk.Tab and blk.Tab._isSettings == true) or false, NoUndo = opts.Undo == false }
	en.Get = function()
		local ok, v = pcall(function() return item.Get() end)
		local sg = ok and modSig(v) or "?"
		if type(item.GetKey) == "function" then   -- toggle avec touche liée
			local ok2, k = pcall(item.GetKey)
			sg = sg .. "|" .. tostring(ok2 and k or "")
		end
		if type(item.GetAlpha) == "function" then
			local okA, al = pcall(item.GetAlpha)
			sg = sg .. "|a" .. string.format("%.3f", okA and tonumber(al) or 1)
		end
		return sg
	end
	en.Base = en.Get()
	en.USig = en.Base                                   -- référence pour « Annuler » / « Récemment utilisés »
	if Library._undoSnap then en.UVal, en.UKey = Library._undoSnap(en) end
	Library.ModEntries[#Library.ModEntries + 1] = en
	Library.ModByFrame[frame] = en
	Library:_startModWatcher()
end

function Library:_isModifiedFrame(frame)
	local en = Library.ModByFrame[frame]
	return en ~= nil and en.Get() ~= en.Base
end

function Library:_paintModChip()
	local w = Library.Window
	local chip = w and w.ModChip
	if not chip or not chip.Parent then return end
	local on = Library.ModFilter
	chip.Text = Library.ModCount > 99 and "99+" or tostring(Library.ModCount)
	tween(chip, { BackgroundColor3 = on and T.Accent or T.Text, BackgroundTransparency = on and 0.1 or 0.88 }, 0.15)
	chip.TextColor3 = on and T.Main or T.Text
end

function Library:_refreshModified()
	local list, count, changed = Library.ModEntries, 0, false
	for i = #list, 1, -1 do
		local en = list[i]
		if not (en.Frame and en.Frame.Parent) then
			table.remove(list, i)
			Library.ModByFrame[en.Frame] = nil
		else
			local m = en.Get() ~= en.Base
			if m ~= en.Mod then en.Mod = m changed = true end
			if m then count += 1 end
			local want = (m and Library.ModDots ~= false) and 0.05 or 1
			if en.Shown ~= want then
				en.Shown = want
				if en.Dot.Parent then tween(en.Dot, { BackgroundTransparency = want }, 0.2) end
			end
		end
	end
	local oldCount = Library.ModCount
	Library.ModCount = count
	if count ~= oldCount then Library:_paintModChip() end
	if changed and Library.ModFilter then
		local w = Library.Window
		if w and Library._applySearch then pcall(Library._applySearch, w, w.Search and w.Search.Text or "") end
	end
	return count
end

function Library:_startModWatcher()
	if Library._modWatching then return end
	Library._modWatching = true
	local token = (Library._modToken or 0) + 1
	Library._modToken = token
	task.spawn(function()
		while Library._modToken == token do
			task.wait(0.3)
			local w = Library.Window
			if w and w.Open ~= false and #Library.ModEntries > 0 and not Library._listening then
				pcall(Library._refreshModified, Library)
			end
		end
	end)
end

function Library:SetModFilter(v)
	v = v and true or false
	if Library.ModFilter == v then return end
	Library.ModFilter = v
	Library._modExpandOnce = v
	Library:_refreshModified()
	Library:_paintModChip()
	local w = Library.Window
	if w and Library._applySearch then pcall(Library._applySearch, w, w.Search and w.Search.Text or "") end
	local it = Library._modFilterItem
	if it then
		local ok, cur = pcall(it.Get)
		if ok and cur ~= v then pcall(it.Set, it, v) end
	end
end

function Library:GetModified()
	local out = {}
	for _, en in ipairs(Library.ModEntries) do
		if en.Frame and en.Frame.Parent and en.Get() ~= en.Base then out[#out + 1] = en.Name end
	end
	return out
end

function Library:SetModBaseline()
	for _, en in ipairs(Library.ModEntries) do en.Base = en.Get() end
	Library:_refreshModified()
end

-- ============================================================================
-- ANNULER  +  RÉCEMMENT UTILISÉS
--   Chaque changement fait dans l'interface (toggle, slider, liste, champ, couleur, touche, stepper) est retenu :
--   • bouton « Annuler » dans la barre de titre (à gauche de l'indicateur FPS / ping, visible avec lui) ou Ctrl+Z :
--     revient en arrière d'un pas. Un « Réinitialiser les contrôles » ou un chargement de config = UN seul pas.
--     Un curseur / une couleur déplacé en continu = un seul pas.
--   • section « Récemment utilisés » (onglet Favoris, ou Window:CreateRecentTab) : les derniers éléments modifiés.
--   { Undo = false } sur un élément l'exclut de « Annuler ».  Library:Undo() · Library:ClearUndo() · Library.UndoMax / RecentMax
--   Seuls les changements faits pendant que tu utilises l'interface (fenêtre ou palette ouverte, avec une action de ta part)
--   sont retenus : pas ceux d'un script qui change une valeur tout seul.
-- ============================================================================
Library.UndoStack = {}
Library.RecentList = {}
Library.UndoMax = 50
Library.RecentMax = 12
Library._lastInputAt = 0

do
	local function snap(en)
		local it = en.Item
		local ok, v = pcall(function() return it.Get() end)
		local k
		if type(it.GetKey) == "function" then
			local ok2, kk = pcall(it.GetKey)
			if ok2 then k = kk end
		end
		if k == nil and type(it.GetAlpha) == "function" then
			local okA, al = pcall(it.GetAlpha)
			if okA then k = al end
		end
		return ok and copyVal(v) or nil, k
	end
	Library._undoSnap = snap

	local function markInput(i)
		local ut = i.UserInputType
		if ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.MouseButton2
			or ut == Enum.UserInputType.Touch or ut == Enum.UserInputType.Keyboard then
			Library._lastInputAt = os.clock()
		end
	end
	track(UIS.InputBegan:Connect(function(i, gp)
		markInput(i)
		if gp or i.KeyCode ~= Enum.KeyCode.Z then return end
		if not (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then return end
		local w = Library.Window
		if w and w.Open ~= false and not UIS:GetFocusedTextBox() and #Library.UndoStack > 0 then Library:Undo() end
	end))
	track(UIS.InputEnded:Connect(markInput))

	local function context()
		local w = Library.Window
		local winOpen = w ~= nil and w.Open ~= false
		local pal = Library.IsPaletteOpen and Library:IsPaletteOpen() or false
		local now = os.clock()
		if winOpen or pal then Library._ctxAt = now return true end
		return now - (Library._ctxAt or 0) < 1.0
	end

	local function step()
		local changes = {}
		for _, en in ipairs(Library.ModEntries) do
			if en.Frame and en.Frame.Parent and en.Item and not en.NoUndo then
				local sig = en.Get()
				if en.USig == nil then
					en.USig = sig
					en.UVal, en.UKey = snap(en)
				elseif sig ~= en.USig then
					changes[#changes + 1] = { En = en, Old = en.UVal, OldKey = en.UKey }
					en.USig = sig
					en.UVal, en.UKey = snap(en)
				end
			end
		end
		if #changes == 0 or Library._undoing or os.clock() < (Library._undoGrace or 0) then return end
		local now = os.clock()
		if not context() then return end
		if not (activeDrag ~= nil or now - (Library._lastInputAt or 0) < 1.3) then return end   -- pas un geste de ta part

		local stack = Library.UndoStack
		local top = stack[#stack]
		if #changes == 1 and top and #top.Changes == 1 and top.Changes[1].En == changes[1].En and now - top.At < 1.6 then
			top.At = now   -- même réglage modifié en continu : un seul pas
		else
			stack[#stack + 1] = { Changes = changes, At = now,
				Label = (#changes == 1) and tostring(changes[1].En.Name) or (#changes .. " éléments") }
			if #stack > (Library.UndoMax or 50) then table.remove(stack, 1) end
		end
		local rl = Library.RecentList
		for _, c in ipairs(changes) do
			local en = c.En
			if not en.IsSettings then
				local at = table.find(rl, en)
				if at then table.remove(rl, at) end
				table.insert(rl, 1, en)
			end
		end
		while #rl > (Library.RecentMax or 12) do table.remove(rl) end
		if Library._undoRefresh then pcall(Library._undoRefresh) end
	end

	local token = (Library._undoToken or 0) + 1
	Library._undoToken = token
	task.spawn(function()
		while Library._undoToken == token do
			task.wait(0.3)
			if not Library._listening then pcall(step) end
		end
	end)

	function Library:Undo()
		local stack = Library.UndoStack
		local st = table.remove(stack)
		if not st then return false end
		Library._undoing = true
		Library._silentSound = (Library._silentSound or 0) + 1
		for i = #st.Changes, 1, -1 do
			local c = st.Changes[i]
			local en = c.En
			if en.Frame and en.Frame.Parent then
				pcall(en.Item.Set, en.Item, copyVal(c.Old))
				if c.OldKey ~= nil and en.Item.SetKey then pcall(en.Item.SetKey, en.Item, c.OldKey)
				elseif c.OldKey ~= nil and en.Item.SetAlpha then pcall(en.Item.SetAlpha, en.Item, c.OldKey) end
				en.USig = en.Get()
				en.UVal, en.UKey = snap(en)
			end
		end
		Library._silentSound = math.max((Library._silentSound or 1) - 1, 0)
		Library._undoing = false
		Library._undoGrace = os.clock() + 0.8   -- les mises à jour tardives dues à l'annulation ne comptent pas comme de nouveaux changements
		if Library.RefreshKeybindConflicts then pcall(function() Library:RefreshKeybindConflicts() end) end
		if Library._hudRefresh then pcall(Library._hudRefresh) end
		pcall(Library._refreshModified, Library)
		if Library._undoRefresh then pcall(Library._undoRefresh) end
		pcall(function() Library:Notify({ Title = "Annulé", Content = tostring(st.Label), Type = "Info", Duration = 2 }) end)
		return true
	end

	function Library:ClearUndo()
		table.clear(Library.UndoStack)
		if Library._undoRefresh then pcall(Library._undoRefresh) end
	end

	-- contenu de la section « Récemment utilisés » : copies des derniers éléments modifiés (le plus récent en haut)
	function Library:_buildRecent(blk)
		local alive = {}
		for _, en in ipairs(Library.RecentList) do
			if en.Frame and en.Frame.Parent and en.Opts and en.Item then alive[#alive + 1] = en end
		end
		if #alive == 0 then
			blk:CreateParagraph({ Title = "Rien pour l'instant",
				Content = "Les derniers éléments que tu modifies (toggles, sliders, listes...) apparaissent ici, le plus récent en haut." })
			return
		end
		local last
		for _, en in ipairs(alive) do
			local group = tostring(en.TabName) .. " · " .. tostring(en.BlockName)
			if group ~= last then blk:CreateSection(group) last = group end
			local o = {}
			for k, v in pairs(en.Opts) do o[k] = v end
			o.Flag, o.Keybind = nil, nil   -- la touche reste sur l'élément d'origine
			o.Favorite, o.Palette, o.Modified, o.Reset, o.Undo = false, false, false, false, false
			local item = en.Item
			local ok, cur = pcall(function() return item.Get() end)
			if ok and cur ~= nil then o.Default = cur end
			o.Callback = function(...)
				local a, b = ...
				pcall(item.Set, item, (b ~= nil and typeof(a) ~= "Color3") and { a, b } or a, typeof(a) == "Color3" and b or nil)
			end
			pcall(function() blk["Create" .. en.Kind](blk, o) end)
		end
	end
end

-- ============================================================================
-- RÉINITIALISER LES CONTRÔLES DU SCRIPT  (Paramètres > Fenêtre > « Réinitialiser les contrôles »)
--   • Keybinds   : touche retirée (« Aucune »), y compris la touche liée à un toggle
--   • Toggles    : tous désactivés
--   • Sliders    : remis à leur valeur par défaut (curseurs simples et à deux poignées)
--   Library:ResetControls() -> nombre d'éléments modifiés. Les réglages de l'apparence (onglet Paramètres) ne sont pas touchés.
--   { Reset = false } sur un élément l'exclut.
-- ============================================================================
function Library:ResetControls()
	local n = 0
	Library._silentSound = (Library._silentSound or 0) + 1
	for i = #Library.ResetEntries, 1, -1 do
		local r = Library.ResetEntries[i]
		if not (r.Frame and r.Frame.Parent) then
			table.remove(Library.ResetEntries, i)   -- élément détruit
		else
			local it = r.Item
			if r.Kind == "Keybind" then
				local _, cur = pcall(function() return it.Get() end)
				if cur ~= Enum.KeyCode.Unknown then pcall(it.Set, it, Enum.KeyCode.Unknown) n += 1 end
			elseif r.Kind == "Toggle" then
				local _, cur = pcall(function() return it.Get() end)
				if cur then pcall(it.Set, it, false) n += 1 end
				if it.SetKey then   -- touche liée au toggle (option Keybind)
					local _, ck = pcall(function() return it.GetKey() end)
					if ck ~= Enum.KeyCode.Unknown then pcall(it.SetKey, it, Enum.KeyCode.Unknown) n += 1 end
				end
			elseif r.Kind == "DDKeys" then
				local _, cur = pcall(function() return it.Get() end)
				if type(cur) == "table" and next(cur) ~= nil then pcall(it.Set, it, {}) n += 1 end
			elseif r.Kind == "Slider" then
				local _, cur = pcall(function() return it.Get() end)
				if r.Default ~= nil and cur ~= r.Default then pcall(it.Set, it, r.Default) n += 1 end
			elseif r.Kind == "RangeSlider" then
				local _, cur = pcall(function() return it.Get() end)
				local d = r.Default
				if type(d) == "table" and (type(cur) ~= "table" or cur.Low ~= d.Low or cur.High ~= d.High) then
					pcall(it.Set, it, copyVal(d)) n += 1
				end
			end
		end
	end
	Library._silentSound = math.max((Library._silentSound or 1) - 1, 0)
	if Library.RefreshKeybindConflicts then pcall(function() Library:RefreshKeybindConflicts() end) end
	if Library._hudRefresh then pcall(Library._hudRefresh) end
	return n
end

-- ============================================================================
-- CONFLITS DE KEYBINDS : deux éléments qui utilisent la même touche
--   Pastille « ! » orange sur les lignes concernées (survol = avec qui), notification quand on change une touche,
--   résumé dans Paramètres > Raccourcis clavier. Library.KeybindConflictWarn = false pour couper.
--   Library:GetKeybindConflicts() -> { ["F"] = { entrée, entrée }, ... }
-- ============================================================================
function Library:GetKeybindConflicts()
	local byKey, out = {}, {}
	for _, e in ipairs(Library.KeybindEntries) do
		if e.Frame and e.Frame.Parent and e.Item and e.Item.Get then
			local ok, k = pcall(e.Item.Get)
			if ok and typeof(k) == "EnumItem" and k ~= Enum.KeyCode.Unknown and k.Name ~= "None" then
				local l = byKey[k.Name]
				if not l then
					l = {}
					byKey[k.Name] = l
				end
				l[#l + 1] = e
			end
		end
	end
	for name, l in pairs(byKey) do
		if #l > 1 then out[name] = l end
	end
	return out
end

function Library:RefreshKeybindConflicts()
	local conf = Library:GetKeybindConflicts()
	local info = {}
	if Library.KeybindConflictWarn ~= false then
		for keyName, list in pairs(conf) do
			for _, e in ipairs(list) do
				local others = {}
				for _, x in ipairs(list) do
					if x ~= e then others[#others + 1] = tostring(x.Name) end
				end
				info[e] = "Même touche (" .. keyName .. ") que : " .. table.concat(others, ", ")
			end
		end
	end
	for _, e in ipairs(Library.KeybindEntries) do
		local fr = e.Frame
		if fr and fr.Parent then
			local text = info[e]
			local badge = fr:FindFirstChild("KbConflict")
			if badge and badge:GetAttribute("Tip") ~= text then
				badge:Destroy()
				badge = nil
			end
			if text and not badge then
				badge = new("TextLabel", { Name = "KbConflict", AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, e.BadgeX or -104, 0.5, 0), Size = UDim2.fromOffset(18, 18),
					BackgroundColor3 = Library.NotifColors.Warning, Text = "!", TextColor3 = Color3.fromRGB(10, 10, 12),
					TextSize = 12, Font = F_BOLD, BorderSizePixel = 0, ZIndex = 8 }, fr)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, badge)
				badge:SetAttribute("Tip", text)
				attachTip(badge, text)
			end
		end
	end
	return conf
end

-- notification quand la touche qu'on vient de choisir est déjà prise (pas au chargement d'une config)
function Library:_notifyKeyConflict(frame, k)
	if Library.KeybindConflictWarn == false then return end
	if (Library._silentSound or 0) > 0 or (Library._restoring or 0) > 0 then return end
	if typeof(k) ~= "EnumItem" or k == Enum.KeyCode.Unknown then return end
	local list = Library:GetKeybindConflicts()[k.Name]
	if not list then return end
	local mine, others = nil, {}
	for _, e in ipairs(list) do
		if e.Frame == frame then mine = e else others[#others + 1] = "« " .. tostring(e.Name) .. " »" end
	end
	if not mine or #others == 0 then return end
	Library:Notify({ Title = "Conflit de touche", Type = "Warning", Duration = 6, _noMute = true,
		Content = "« " .. tostring(mine.Name) .. " » et " .. table.concat(others, ", ") .. " utilisent la même touche ("
			.. k.Name .. ")." })
end

-- ============================================================================
-- HUD DES ACTIFS : petit panneau déplaçable (glisser à la souris / au doigt) qui liste les toggles activés,
-- avec leur touche si le toggle en a une (CreateToggle({ Keybind = Enum.KeyCode.X })).
--   Toggle { HUD = false } : caché du panneau.  Réglages : Paramètres > HUD des actifs.
--   Library:SetHud(v) / SetHudKeys(v) / SetHudScale(0.6..1.6) / SetHudOnlyClosed(v) / ResetHudPosition()
-- ============================================================================
do -- (portée réduite : limite de 200 locals)
local hud = { rows = {} }

local function hudShown()
	if not Library.HudEnabled then return false end
	local w = Library.Window
	if Library.HudOnlyClosed and w and w.Open then return false end
	return true
end

-- Position enregistrée = POINT D'ANCRAGE en pixels écran + coin d'ancrage (Ax / Ay = 0 ou 1).
-- Le HUD est ancré par le coin le plus proche d'un bord de l'écran : quand une ligne apparaît ou disparaît, il
-- s'agrandit vers l'intérieur de l'écran, son coin ancré ne bouge jamais (plus de décalage ni de « saut »).
-- Anciennes sauvegardes { X, Y } : lues comme un ancrage en haut à gauche.
local function hudSaved()
	local p = Library.HudPos
	if type(p) == "table" and tonumber(p.X) and tonumber(p.Y) then
		return tonumber(p.X), tonumber(p.Y), ((tonumber(p.Ax) or 0) >= 1) and 1 or 0, ((tonumber(p.Ay) or 0) >= 1) and 1 or 0
	end
	return 16, 120, 0, 0
end

-- applique la position enregistrée (sans jamais la modifier : le garde-fou « dans l'écran » ne touche que l'affichage)
local function hudPlace()
	local card = hud.card
	if not card then return end
	local px, py, ax, ay = hudSaved()
	local vp, sz = viewport(), card.AbsoluteSize
	local left = math.clamp(px - ax * sz.X, 0, math.max(vp.X - sz.X, 0))
	local top = math.clamp(py - ay * sz.Y, 0, math.max(vp.Y - sz.Y, 0))
	card.AnchorPoint = Vector2.new(ax, ay)
	card.Position = UDim2.fromOffset(left + ax * sz.X, top + ay * sz.Y)
end

-- place le HUD à partir de son coin haut-gauche (glisser) ; save = enregistre le nouvel ancrage
local function hudPlaceTL(left, top, save)
	local card = hud.card
	if not card then return end
	local vp, sz = viewport(), card.AbsoluteSize
	left = math.clamp(left, 0, math.max(vp.X - sz.X, 0))
	top = math.clamp(top, 0, math.max(vp.Y - sz.Y, 0))
	local ax = (left + sz.X / 2 > vp.X / 2) and 1 or 0
	local ay = (top + sz.Y / 2 > vp.Y / 2) and 1 or 0
	local px, py = left + ax * sz.X, top + ay * sz.Y
	card.AnchorPoint = Vector2.new(ax, ay)
	card.Position = UDim2.fromOffset(px, py)
	if save then
		Library.HudPos = { X = math.floor(px + 0.5), Y = math.floor(py + 0.5), Ax = ax, Ay = ay }
		Library.Flags["ui.hudpos"] = Library.HudPos
	end
end

-- coin haut-gauche actuel, calculé à partir de Position / AnchorPoint (notre propre repère)
local function hudTopLeft()
	local card = hud.card
	local sz = card.AbsoluteSize
	return card.Position.X.Offset - card.AnchorPoint.X * sz.X, card.Position.Y.Offset - card.AnchorPoint.Y * sz.Y
end

function Library:_hudPlace()
	hudPlace()
end

local HUD_PAD = 13   -- marge gauche / droite de la carte

local function hudMeasure(text, size, font)
	local ok, v = pcall(function()
		return game:GetService("TextService"):GetTextSize(tostring(text), size, font, Vector2.new(1000, 100))
	end)
	if ok and v then return v.X end
	return #tostring(text) * size * 0.6
end

local function ensureHud()
	if hud.gui and hud.gui.Parent then return end
	hud.gui = new("ScreenGui", { Name = "SolarisHud", ResetOnSpawn = false, DisplayOrder = 900,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, Enabled = false })
	mount(hud.gui)
	-- largeur calculée (tween), hauteur automatique : les lignes ont une taille fixe, rien ne « danse »
	local card = new("Frame", { Name = "Card", Size = UDim2.new(0, 120, 0, 0), AutomaticSize = AY,
		BackgroundColor3 = T.Main, BackgroundTransparency = 0.08, BorderSizePixel = 0, Active = true }, hud.gui)
	new("UICorner", { CornerRadius = UDim.new(0, 16) }, card)
	new("UIStroke", { Color = T.Accent, Thickness = 1, Transparency = 0.84, ApplyStrokeMode = BORDER }, card)
	hud.scale = new("UIScale", { Scale = Library.HudScale or 1 }, card)
	new("UIPadding", { PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, HUD_PAD),
		PaddingRight = UDim.new(0, HUD_PAD) }, card)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = BYORDER }, card)
	hud.title = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14),
		Text = "ACTIFS", TextColor3 = T.Text, TextTransparency = 0.45,
		TextSize = 10, Font = F_BOLD, TextXAlignment = LEFT, LayoutOrder = 0 }, card)
	hud.empty = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18),
		Text = "Aucun actif", TextColor3 = T.Text, TextTransparency = 0.55,
		TextSize = 12, Font = F_REG, TextXAlignment = LEFT, LayoutOrder = 1 }, card)
	hud.card = card
	-- glisser pour déplacer
	card.InputBegan:Connect(function(i)
		if not isPress(i) then return end
		local start = Vector2.new(i.Position.X, i.Position.Y)
		local ox, oy = hudTopLeft()   -- lu depuis Position / AnchorPoint (jamais depuis AbsolutePosition : pas de dérive)
		startDrag(function(p)
			local d = Vector2.new(p.X, p.Y) - start
			hudPlaceTL(ox + d.X, oy + d.Y, false)
		end, nil, i.Position, function()
			local lx, ly = hudTopLeft()
			hudPlaceTL(lx, ly, true)
		end)
	end)
	local cam = workspace.CurrentCamera
	if cam then
		track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() hudPlace() end))
	end
	hudPlace()
end

-- touche affichée pour une ligne : 1) celle du toggle (Keybind = ...) · 2) HudKey donné à la main (item / Enum.KeyCode /
-- fonction) · 3) un Block:CreateKeybind portant le même nom (de préférence dans le même bloc)
local HUD_STRIP = { "%(touche%)", "touche", "keybind", "raccourci", "bind", "key" }
local function hudNorm(s)
	s = string.lower(tostring(s or ""))
	for _, w in ipairs(HUD_STRIP) do
		s = string.gsub(s, w, " ")
	end
	s = string.gsub(s, "[%s%p]+", " ")
	return string.match(s, "^%s*(.-)%s*$") or ""
end

local function hudKeyOf(e)
	local function valid(k)
		if typeof(k) == "EnumItem" and k ~= Enum.KeyCode.Unknown then return k end
		return nil
	end
	local it = e.Item
	if it and type(it.GetKey) == "function" then
		local ok, k = pcall(it.GetKey)
		if ok and valid(k) then return k end
	end
	local hk = e.HudKey
	if hk ~= nil then
		local k = hk
		if type(hk) == "function" then
			local ok, r = pcall(hk)
			k = ok and r or nil
		elseif type(hk) == "table" then
			local g = hk.GetKey or hk.Get
			if type(g) == "function" then
				local ok, r = pcall(g, hk)
				k = ok and r or nil
			else
				k = nil
			end
		end
		if valid(k) then return k end
	end
	local nt = hudNorm(e.Name)
	if #nt < 2 then return nil end
	local best, bestScore
	for _, ke in ipairs(Library.KeybindEntries) do
		local kit = ke.Item
		if kit and type(kit.Get) == "function" and ke.Frame and ke.Frame.Parent then
			local ok, k = pcall(kit.Get)
			if ok and valid(k) then
				local nk = hudNorm(ke.Name)
				local score = 0
				if nk ~= "" then
					if nk == nt then
						score = 2
					elseif #nt >= 3 and #nk >= 3 and (string.find(nk, nt, 1, true) or string.find(nt, nk, 1, true)) then
						score = 1
					end
				end
				if score > 0 then
					if ke.Block == e.Block then score += 2 end
					if not bestScore or score > bestScore then best, bestScore = k, score end
				end
			end
		end
	end
	return best
end

local function hudRow(entry)
	local row = new("Frame", { Name = "Row", Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
		ClipsDescendants = true }, hud.card)
	local dot = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(7, 7), BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0 }, row)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	local name = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 15, 0, 0),
		Size = UDim2.new(1, -15, 1, 0), Text = entry.Name, TextColor3 = T.Text, TextTransparency = 1,
		TextSize = 13, Font = F_MED, TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd }, row)
	-- la touche : puce alignée à droite (une colonne propre, quelle que soit la longueur des noms)
	local chip = new("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 18), BackgroundColor3 = T.Text, BackgroundTransparency = 1, Text = "",
		TextColor3 = T.Text, TextTransparency = 1, TextSize = 10, Font = F_BOLD, Visible = false,
		BorderSizePixel = 0 }, row)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, chip)
	tween(row, { Size = UDim2.new(1, 0, 0, 22) }, 0.22)
	tween(dot, { BackgroundTransparency = 0 }, 0.25)
	tween(name, { TextTransparency = 0 }, 0.25)
	tween(chip, { BackgroundTransparency = 0.88, TextTransparency = 0 }, 0.25)
	return { f = row, dot = dot, name = name, chip = chip }
end

local function hudRefresh()
	local shown = hudShown()
	if shown then ensureHud() end
	if not hud.gui then return end
	hud.gui.Enabled = shown
	if not shown then return end
	hud.scale.Scale = Library.HudScale or 1

	local want, count, maxW = {}, 0, 0
	for order, e in ipairs(Library.ToggleEntries) do
		if e.Frame and e.Frame.Parent then
			local ok, on = pcall(e.Item.Get)
			if ok and on then
				count += 1
				want[e] = true
				local r = hud.rows[e]
				if not r then
					r = hudRow(e)
					hud.rows[e] = r
				end
				r.f.LayoutOrder = 10 + order
				r.name.Text = e.Name
				local key = (Library.HudShowKeys ~= false) and hudKeyOf(e) or nil
				local chipW = 0
				if key then
					r.chip.Text = shortKey(key) or key.Name
					chipW = math.ceil(hudMeasure(r.chip.Text, r.chip.TextSize, r.chip.Font)) + 14
					r.chip.Size = UDim2.fromOffset(chipW, 18)
					r.chip.Visible = true
				else
					r.chip.Text = ""
					r.chip.Visible = false
				end
				local reserve = key and (chipW + 10) or 0
				r.name.Size = UDim2.new(1, -(15 + reserve), 1, 0)
				local nameW = math.ceil(hudMeasure(e.Name, r.name.TextSize, r.name.Font))
				maxW = math.max(maxW, 15 + nameW + reserve)
			end
		end
	end
	for e, r in pairs(table.clone(hud.rows)) do
		if not want[e] then
			hud.rows[e] = nil
			tween(r.f, { Size = UDim2.new(1, 0, 0, 0) }, 0.2)
			tween(r.dot, { BackgroundTransparency = 1 }, 0.2)
			tween(r.name, { TextTransparency = 1 }, 0.2)
			tween(r.chip, { BackgroundTransparency = 1, TextTransparency = 1 }, 0.2)
			task.delay(0.24, function() r.f:Destroy() end)
		end
	end
	hud.empty.Visible = count == 0
	hud.title.Text = count > 0 and ("ACTIFS · " .. count) or "ACTIFS"
	local inner = math.max(maxW, hudMeasure(hud.title.Text, hud.title.TextSize, hud.title.Font),
		count == 0 and hudMeasure(hud.empty.Text, hud.empty.TextSize, hud.empty.Font) or 0, 90)
	local w = math.min(math.ceil(inner) + HUD_PAD * 2 + 2, 380)
	tween(hud.card, { Size = UDim2.new(0, w, 0, 0) }, 0.2)
	-- garde-fou : si le HUD dépasse de l'écran, on le ramène (affichage seulement, la position enregistrée ne change pas)
	task.spawn(function()
		Ticker.wait()
		hudPlace()
		task.wait(0.3)
		hudPlace()
	end)
end

local hudPending = false
Library._hudRefresh = function()
	if hudPending then return end
	hudPending = true
	task.defer(function()
		hudPending = false
		pcall(hudRefresh)
	end)
end

function Library:SetHud(v) Library.HudEnabled = v and true or false Library._hudRefresh() end
function Library:SetHudKeys(v) Library.HudShowKeys = v and true or false Library._hudRefresh() end
