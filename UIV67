--- Library:Notify("text", 4)
--- Library:Notify({ Title = "...", Description = "...", Time = 5, Type = "Success" })
--- Type: "Info" (default) | "Success" | "Warning" | "Error"
--- Time = math.huge or Persist = true keeps it until :Destroy() is called.
--- Steps = number enables a step counter, notification:ChangeStep(n)
function Library:Notify(info, time)
    if type(info) == "string" then
        info = { Description = info, Time = time }
    end
    info = info or {}

    local kind = info.Type or "Info"
    local accentKey = "AccentColor"
    if kind == "Success" then
        accentKey = "GreenColor"
    elseif kind == "Error" then
        accentKey = "RedColor"
    elseif kind == "Warning" then
        accentKey = nil
    end

    local duration = info.Time or 4
    local persist = info.Persist == true or duration == math.huge

    local notification = {
        Title = info.Title,
        Description = info.Description or "",
        Destroyed = false,
        Steps = info.Steps,
        Step = 0,
    }

    local side = self.NotifySide
    local hAlign = side == "Left" and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right
    self.NotificationList.HorizontalAlignment = hAlign
    if side == "Left" then
        self.NotificationLayer.Position = UDim2.new(0, 12, 0, 12)
    else
        self.NotificationLayer.Position = UDim2.new(1, -332, 0, 12)
    end

    local wrapper = self:Create("Frame", {
        Name = "Notification",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ClipsDescendants = false,
        ZIndex = 801,
        Parent = self.NotificationLayer,
    })

    local card = self:Create("Frame", {
        Name = "Card",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(side == "Left" and -1.2 or 1.2, 0, 0, 0),
        ClipsDescendants = true,
        ZIndex = 802,
        ["@BackgroundColor3"] = "BackgroundColor",
        Parent = wrapper,
    })
    self:AddCorner(card, 6)
    self:AddStroke(card, "OutlineColor", 1)

    local accentBar = self:Create("Frame", {
        Name = "Accent",
        Size = UDim2.new(0, 3, 1, 0),
        ZIndex = 804,
        BackgroundColor3 = Color3.new(1, 1, 1),
        Parent = card,
    })
    if accentKey then
        self:Bind(accentBar, { BackgroundColor3 = accentKey })
    else
        accentBar.BackgroundColor3 = Color3.fromRGB(255, 190, 60)
    end

    local barGradient = self:Create("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 0.5),
        }),
        Parent = accentBar,
    })
    barGradient.Enabled = true

    local content = self:Create("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 803,
        Parent = card,
    })
    self:AddPadding(content, 10, 12, 14, 14)
    self:AddList(content, 3)

    local titleLabel
    if info.Title and info.Title ~= "" then
        titleLabel = self:Create("TextLabel", {
            Name = "Title",
            Size = UDim2.new(1, 0, 0, 16),
            Text = info.Title,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.Code,
            TextSize = self.TextSize + 1,
            ZIndex = 804,
            LayoutOrder = 1,
            ["@TextColor3"] = "FontColor",
            Parent = content,
        })
    end

    local descLabel = self:Create("TextLabel", {
        Name = "Description",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = notification.Description,
        TextWrapped = true,
        RichText = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextSize = self.TextSize - 1,
        ZIndex = 804,
        LayoutOrder = 2,
        ["@TextColor3"] = titleLabel and "MutedColor" or "FontColor",
        Parent = content,
    })

    local timerBar = self:Create("Frame", {
        Name = "Timer",
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2),
        ZIndex = 805,
        BackgroundColor3 = Color3.new(1, 1, 1),
        Visible = not persist,
        Parent = card,
    })
    if accentKey then
        self:Bind(timerBar, { BackgroundColor3 = accentKey })
    else
        timerBar.BackgroundColor3 = Color3.fromRGB(255, 190, 60)
    end

    local stepLabel
    if info.Steps then
        stepLabel = self:Create("TextLabel", {
            Name = "Steps",
            Size = UDim2.new(1, 0, 0, 14),
            Text = string.format("0 / %d", info.Steps),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextSize = self.TextSize - 2,
            ZIndex = 804,
            LayoutOrder = 3,
            ["@TextColor3"] = "MutedColor",
            Parent = content,
        })
    end

    -- Slide in
    self:Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, self.SlowTweenInfo)
    self:PlaySound(info.SoundId, 0.5)

    function notification:Destroy()
        if self.Destroyed then
            return
        end
        self.Destroyed = true
        local index = table.find(Library.Notifications, self)
        if index then
            table.remove(Library.Notifications, index)
        end
        local out = Library:Tween(card, {
            Position = UDim2.new(side == "Left" and -1.2 or 1.2, 0, 0, 0),
        }, Library.SlowTweenInfo)
        out.Completed:Once(function()
            wrapper:Destroy()
        end)
        task.delay(1, function()
            if wrapper.Parent then
                wrapper:Destroy()
            end
        end)
    end

    function notification:ChangeTitle(text)
        if titleLabel then
            titleLabel.Text = text
        end
    end

    function notification:ChangeDescription(text)
        self.Description = text
        descLabel.Text = text
    end

    function notification:ChangeStep(step)
        if not stepLabel then
            return
        end
        self.Step = math.clamp(step, 0, self.Steps)
        stepLabel.Text = string.format("%d / %d", self.Step, self.Steps)
        if self.Step >= self.Steps and not persist then
            self:Destroy()
        end
    end

    if not persist then
        Library:Tween(timerBar, { Size = UDim2.new(0, 0, 0, 2) },
            TweenInfo.new(duration, Enum.EasingStyle.Linear))
        task.delay(duration, function()
            notification:Destroy()
        end)
    end

    table.insert(self.Notifications, notification)
    return notification
end

