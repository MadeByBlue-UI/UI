		local btn = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(98, 26), BackgroundColor3 = T.Off, BackgroundTransparency = 0.5, Text = nameOf(),
			TextColor3 = T.Text, TextSize = 12, Font = F_MED, AutoButtonColor = false, BorderSizePixel = 0 }, hdr)
		round(btn, 8)
		btn.MouseButton1Click:Connect(function()
			if S.capture then return end
			Library._listening = true
			btn.Text = "..."
			local conn
			local function finish()
				if conn then conn:Disconnect() conn = nil end
				Library._listening = false
				S.capture = nil
			end
			S.capture = function()
				finish()
				if btn.Parent then btn.Text = nameOf() end
			end
			conn = UIS.InputBegan:Connect(function(i)
				if i.UserInputType ~= Enum.UserInputType.Keyboard or i.KeyCode == KC.Escape then return end
				finish()
