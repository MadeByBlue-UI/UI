-- ============================================================================
-- FLOU D'ARRIÈRE-PLAN  (BlurEffect dans Lighting : floute le jeu derrière l'interface)
-- ============================================================================
local blurFx
local blurToken = 0
local function setBlurTarget(size, instant)
	blurToken += 1
	local my = blurToken
	size = math.clamp(tonumber(size) or 0, 0, 56)
	if size <= 0 and not (blurFx and blurFx.Parent) then return end
	if not (blurFx and blurFx.Parent) then
		local ok, fx = pcall(function()
			local b = Instance.new("BlurEffect")
			b.Name = "UILibBlur"
			b.Size = 0
			b.Parent = Lighting
			return b
		end)
		if not ok or not fx then return end
		blurFx = fx
	end
	if instant or not Library.Animations then
		blurFx.Size = size
		blurFx.Enabled = size > 0
		return
	end
	blurFx.Enabled = true
	local tw = tween(blurFx, { Size = size }, 0.45)
	if size <= 0 then
		tw.Completed:Connect(function()
			if blurToken == my and blurFx then blurFx.Enabled = false end
		end)
	end
end

function Library:SetBlur(n)
	Library.BlurSize = math.clamp(tonumber(n) or 0, 0, 56)
	local w = Library.Window
	setBlurTarget((w and w.Open) and Library.BlurSize or 0)
end

