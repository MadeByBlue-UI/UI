-- FENÊTRE
-- ============================================================================
function Library:CreateWindow(cfg)
	cfg = cfg or {}
	if cfg.Theme then
		for k, v in pairs(cfg.Theme) do T[k] = v end
	end
	refreshTheme()
	local transp = tonumber(cfg.Transparency) or 0.04
	Library.ConfigFolder = cfg.ConfigFolder or Library.ConfigFolder or "Ui-Lib"

	-- Nettoie une ancienne instance (relance du script)
	for _, p in ipairs({ CoreGui, LP:FindFirstChild("PlayerGui") }) do
		local old = p and p:FindFirstChild("SolarisUI")
		if old then old:Destroy() end
	end
	if cfg.ConfigFolder then
		pcall(function()
			if makefolder and isfolder and not isfolder(cfg.ConfigFolder) then makefolder(cfg.ConfigFolder) end
		end)
	end

	-- Taille / position (la fenêtre ne dépasse jamais de l'écran)
	local vp   = viewport()
	local size = cfg.Size or UDim2.new(0, 480, 0, 560)
	local W = math.min(size.X.Offset + size.X.Scale * vp.X, vp.X - 16)
	local H = math.min(size.Y.Offset + size.Y.Scale * vp.Y, vp.Y - 16)
	local center
	if cfg.Position then
		local pos = cfg.Position
		center = Vector2.new(pos.X.Offset + pos.X.Scale * vp.X + W / 2, pos.Y.Offset + pos.Y.Scale * vp.Y + H / 2)
	else
		center = vp / 2
	end
	local minW = (cfg.MinSize and cfg.MinSize.X) or 380
	local minH = (cfg.MinSize and cfg.MinSize.Y) or 320

	local gui = new("ScreenGui", { Name = "SolarisUI", ResetOnSpawn = false, DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
	mount(gui)

	local main = new(canvasSupported and "CanvasGroup" or "Frame", {
		Name = "MainBackground", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(W, H),
		Position = UDim2.fromOffset(center.X, center.Y), BackgroundColor3 = T.Main,
		BackgroundTransparency = transp, BorderSizePixel = 0, ClipsDescendants = true,
	}, gui)
	corner(main, 14)
	local uiScale = new("UIScale", { Scale = 1 }, main)
	local scaleBase = 1

	-- Position lissée (déplacement fluide)
	local curPos, tgtPos = center, nil
	local function clampCenter(c)
		local v = viewport()
		local w, h = main.Size.X.Offset * scaleBase, main.Size.Y.Offset * scaleBase
		return Vector2.new(
			math.clamp(c.X, 90 - w / 2, v.X - 90 + w / 2),
			math.clamp(c.Y, h / 2, v.Y - 40 + h / 2)
		)
	end

	-- ------------------------------------------------------------------
	-- Fond : trou noir + étoiles (derrière tout le reste)
	-- ------------------------------------------------------------------
	local space = new("Frame", { Name = "Space", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		ClipsDescendants = true, BorderSizePixel = 0 }, main)
	local hole = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -66, 0, 54),
		Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }, space)

	local function ring(parent, w, h, thick, tr, speed, rot)
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0, 0),
			Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, Rotation = rot or 0 }, parent)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		local st = new("UIStroke", { Color = T.Accent, Thickness = thick, Transparency = tr, ApplyStrokeMode = BORDER }, f)
		spin(new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(95, 95, 100)),
			Transparency = ringSeq(),
		}, st), speed)
		return f
	end
	ring(hole, 230, 230, 1, 0.82, 14)
	ring(hole, 160, 160, 1.5, 0.62, -22)
	ring(hole, 96, 96, 6, 0.9, 30)
	ring(hole, 250, 36, 1.5, 0.5, 70, -16)   -- disque d'accrétion
	local core = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.fromOffset(60, 60), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, hole)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, core)
	local coreSt = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0.1, ApplyStrokeMode = BORDER }, core)
	spin(new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(70, 70, 75)),
		Transparency = ringSeq() }, coreSt), 110)
	ring(hole, 210, 26, 1, 0.72, -90, -16)

	-- Étoiles aspirées par le trou noir
	local rng = Random.new()
	local stars = {}
	local starCount = tonumber(cfg.Stars)
	if starCount == nil then starCount = Library.StarCount end
	local function respawn(s, w, h, cx, cy)
		for _ = 1, 6 do
			s.x, s.y = rng:NextNumber(0, w), rng:NextNumber(0, h)
			local dx, dy = cx - s.x, cy - s.y
			if dx * dx + dy * dy > 130 * 130 then break end
		end
		s.born = os.clock()
		s.a = rng:NextNumber(0.3, 0.95)
		s.v = rng:NextNumber(4, 12)
	end
	for n = 1, starCount do
		local sz = rng:NextInteger(1, 2)
		local f = new("Frame", { Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = T.Accent, BorderSizePixel = 0,
			BackgroundTransparency = 1 }, space)
		local s = { f = f }
		respawn(s, W, H, W - 66, 54)
		s.born = os.clock() - rng:NextNumber(0, 1)
		stars[n] = s
	end

	-- ------------------------------------------------------------------
	-- Barre de titre
	-- ------------------------------------------------------------------
	local titleBar = new("Frame", { Name = "TitleBar", Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1 }, main)
	local dragZone = new("Frame", { Size = UDim2.new(1, -56, 1, 0), BackgroundTransparency = 1 }, titleBar)
	local tx = 16
	if cfg.CustomIcon and cfg.CustomIcon ~= "" then
		new("ImageLabel", { BackgroundTransparency = 1, Image = cfg.CustomIcon, Size = UDim2.new(0, 20, 0, 20),
			Position = UDim2.new(0, 14, 0.5, -10) }, titleBar)
		tx = 42
	else
		-- petit trou noir en guise de logo
		local logo = new("Frame", { Position = UDim2.new(0, 14, 0.5, -9), Size = UDim2.new(0, 18, 0, 18),
			BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, titleBar)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, logo)
		local lst = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0.05, ApplyStrokeMode = BORDER }, logo)
		spin(new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(70, 70, 75)),
			Transparency = ringSeq() }, lst), 160)
		tx = 42
	end
	local title = label(titleBar, cfg.Title or "UI", 15, { Position = UDim2.new(0, tx, 0, 0),
		Size = UDim2.new(1, -tx - 60, 1, 0), Font = F_BOLD })
	new("UIGradient", { Color = ColorSequence.new(T.GradientStart, T.GradientEnd) }, title)
	local hideBtn = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 28, 0, 24), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.93,
		Text = "-", TextColor3 = T.Text, TextSize = 16, Font = F_BOLD, AutoButtonColor = false }, titleBar)
	corner(hideBtn, 7)
	hideBtn.MouseEnter:Connect(function() tween(hideBtn, { BackgroundTransparency = 0.8 }, 0.2) end)
	hideBtn.MouseLeave:Connect(function() tween(hideBtn, { BackgroundTransparency = 0.93 }, 0.25) end)
	fadeLine(main, { Position = UDim2.new(0, 14, 0, 42), Size = UDim2.new(1, -28, 0, 1) })

	-- Déplacement de la fenêtre (lissé)
	dragZone.InputBegan:Connect(function(i)
		if isPress(i) then
			local start = Vector2.new(i.Position.X, i.Position.Y)
			local origin = curPos
			tgtPos = nil
			startDrag(function(p)
				tgtPos = clampCenter(origin + (Vector2.new(p.X, p.Y) - start))
			end)
		end
	end)

	-- ------------------------------------------------------------------
	-- Recherche + barre latérale + contenu
	-- ------------------------------------------------------------------
	local search = new("TextBox", {
		Position = UDim2.new(0, 10, 0, 52), Size = UDim2.new(0, 116, 0, 28), BackgroundColor3 = T.Element,
		BackgroundTransparency = 0.4, Text = "", PlaceholderText = "Rechercher",
		PlaceholderColor3 = Color3.fromRGB(120, 120, 126), TextColor3 = T.Text, TextSize = 12, Font = F_REG,
		ClearTextOnFocus = false, TextXAlignment = LEFT, BorderSizePixel = 0,
	}, main)
	corner(search, 8)
	local sst = stroke(search, 0.92)
	new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 8) }, search)
	search.Focused:Connect(function() tween(sst, { Transparency = 0.4 }, 0.2) end)
	search.FocusLost:Connect(function() tween(sst, { Transparency = 0.92 }, 0.3) end)

	local sidebar = new("ScrollingFrame", {
		Position = UDim2.new(0, 10, 0, 88), Size = UDim2.new(0, 116, 1, -100), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = AY,
	}, main)
	new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = BYORDER }, sidebar)

	-- séparateur vertical dégradé
	local vline = new("Frame", { Position = UDim2.new(0, 134, 0, 54), Size = UDim2.new(0, 1, 1, -70),
		BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, main)
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.82), NumberSequenceKeypoint.new(1, 1) }) }, vline)

	local content = new("Frame", { Position = UDim2.new(0, 146, 0, 52), Size = UDim2.new(1, -156, 1, -64),
		BackgroundTransparency = 1 }, main)
	local veil = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = T.Main, BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 100, Visible = false }, content)

	local contentW = W - 156
	local win = setmetatable({
		Gui = gui, Main = main, Sidebar = sidebar, Content = content, Tabs = {}, Veil = veil, Search = search,
		TwoCols = contentW >= 520, Open = true,
	}, Window)

	search:GetPropertyChangedSignal("Text"):Connect(function() applySearch(win, search.Text) end)

	-- ------------------------------------------------------------------
	-- Bordure « horizon des événements » + poignée de redimensionnement
	-- ------------------------------------------------------------------
	local horizon = new("Frame", { Name = "Horizon", Position = UDim2.new(0, 1, 0, 1), Size = UDim2.new(1, -2, 1, -2),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 50 }, main)
	corner(horizon, 13)
	local hst = new("UIStroke", { Color = T.Accent, Thickness = 1.5, Transparency = 0.3, ApplyStrokeMode = BORDER }, horizon)
	spin(new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(110, 110, 118)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.12, 0.55),
			NumberSequenceKeypoint.new(0.28, 0.93), NumberSequenceKeypoint.new(0.72, 0.93),
			NumberSequenceKeypoint.new(0.88, 0.55), NumberSequenceKeypoint.new(1, 0),
		}),
	}, hst), 55)

	local grip = new("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -4),
		Size = UDim2.new(0, 20, 0, 20), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 60 }, main)
	local dots = { { 15, 15 }, { 9, 15 }, { 15, 9 } }
	for _, d in ipairs(dots) do
		new("Frame", { Position = UDim2.new(0, d[1], 0, d[2]), Size = UDim2.new(0, 2, 0, 2),
			BackgroundColor3 = T.Accent, BackgroundTransparency = 0.6, BorderSizePixel = 0 }, grip)
	end
	grip.MouseEnter:Connect(function() tween(grip, { BackgroundTransparency = 0.9 }, 0.2) end)
	grip.MouseLeave:Connect(function() tween(grip, { BackgroundTransparency = 1 }, 0.25) end)
	grip.InputBegan:Connect(function(i)
		if isPress(i) then
			local start = Vector2.new(i.Position.X, i.Position.Y)
			local sw, sh = main.Size.X.Offset, main.Size.Y.Offset
			local c0 = curPos
			local sc = scaleBase
			tgtPos = nil
			startDrag(function(p)
				local d = (Vector2.new(p.X, p.Y) - start) / sc
				local v = viewport()
				local nw = math.clamp(sw + d.X, minW, math.max(minW, v.X / sc - 10))
				local nh = math.clamp(sh + d.Y, minH, math.max(minH, v.Y / sc - 10))
				main.Size = UDim2.fromOffset(nw, nh)
				curPos = c0 + Vector2.new(nw - sw, nh - sh) * sc / 2
				main.Position = UDim2.fromOffset(curPos.X, curPos.Y)
			end)
		end
	end)

	-- ------------------------------------------------------------------
	-- Ouverture / fermeture animées, échelle
	-- ------------------------------------------------------------------
	local toggleToken = 0
	local hintShown = false
	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	function win:Toggle(v)
		if v == nil then v = not self.Open end
		v = v and true or false
		if v == self.Open then return end
		self.Open = v
		toggleToken = toggleToken + 1
		local my = toggleToken
		if v then
			main.Visible = true
			tween(uiScale, { Scale = scaleBase }, 0.55, BACK)
			if canvasSupported then tween(main, { GroupTransparency = 0 }, 0.35) end
		else
			if Library._openDD then Library._openDD(false) end
			tween(uiScale, { Scale = scaleBase * 0.94 }, 0.3)
			if canvasSupported then tween(main, { GroupTransparency = 1 }, 0.28) end
			task.delay(0.32, function()
				if toggleToken == my and not self.Open then main.Visible = false end
			end)
		end
	end
	function win:Destroy() Library:Destroy() end
	function win:SetScale(s)
		s = math.clamp(tonumber(s) or 1, 0.6, 1.6)
		scaleBase = s
		Library.Scale = s
		tween(uiScale, { Scale = s }, 0.3)
		tgtPos = clampCenter(curPos)
	end
	function win:SetTitle(t) title.Text = tostring(t) end

	hideBtn.MouseButton1Click:Connect(function()
		win:Toggle(false)
		if not hintShown and not (UIS.TouchEnabled and not UIS.KeyboardEnabled) then
			hintShown = true
			Library:Notify({ Title = "Interface masquée",
				Content = "Appuie sur " .. tostring(toggleKey.Name or toggleKey) .. " pour la rouvrir.",
				Duration = 3.5, Type = "Info" })
		end
	end)

	track(UIS.InputBegan:Connect(function(i, processed)
		if processed or Library._listening then return end
		if i.KeyCode == toggleKey then win:Toggle() end
	end))

	-- Orbe flottant pour mobile (pas de clavier) : déplaçable
	if UIS.TouchEnabled and not UIS.KeyboardEnabled then
		local fb = new("TextButton", { Position = UDim2.new(0, 14, 0.5, -21), Size = UDim2.fromOffset(42, 42),
			BackgroundColor3 = T.Main, BackgroundTransparency = 0.05, Text = "", AutoButtonColor = false,
			BorderSizePixel = 0 }, gui)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, fb)
		local fst = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0.1, ApplyStrokeMode = BORDER }, fb)
		spin(new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(70, 70, 75)),
			Transparency = ringSeq() }, fst), 140)
		local pt = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.2,
			BorderSizePixel = 0 }, fb)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, pt)
		fb.InputBegan:Connect(function(i)
			if isPress(i) then
				local start = Vector2.new(i.Position.X, i.Position.Y)
				local p0 = fb.Position
				local moved = false
				startDrag(function(p)
					local d = Vector2.new(p.X, p.Y) - start
					if d.Magnitude > 8 then moved = true end
					if moved then
						fb.Position = UDim2.new(p0.X.Scale, p0.X.Offset + d.X, p0.Y.Scale, p0.Y.Offset + d.Y)
					end
				end, nil, i.Position, function()
					if not moved then win:Toggle() end
				end)
			end
		end)
	end

	-- ------------------------------------------------------------------
	-- Boucle d'animation (anneaux, étoiles, déplacement lissé)
	-- ------------------------------------------------------------------
	track(RunService.Heartbeat:Connect(function(dt)
		if not main.Visible then return end
		local t = os.clock()
		for _, sp in ipairs(spinners) do
			sp.g.Rotation = (t * sp.speed) % 360
		end
		if tgtPos then
			local d = tgtPos - curPos
			if d.Magnitude < 0.25 then
				curPos = tgtPos
				tgtPos = nil
			else
				curPos = curPos + d * (1 - math.exp(-dt * 22))
			end
			main.Position = UDim2.fromOffset(math.floor(curPos.X + 0.5), math.floor(curPos.Y + 0.5))
		end
		local w, h = main.Size.X.Offset, main.Size.Y.Offset
		local cx, cy = w - 66, 54
		for _, s in ipairs(stars) do
			local dx, dy = cx - s.x, cy - s.y
			local d = math.sqrt(dx * dx + dy * dy)
			if d < 24 or s.x < -10 or s.x > w + 10 or s.y < -10 or s.y > h + 10 then
				respawn(s, w, h, cx, cy)
				s.f.BackgroundTransparency = 1
			else
				local pull  = (s.v + 5200 / (d + 40)) * dt
				local swirl = (2600 / (d + 80)) * dt
				s.x = s.x + dx / d * pull - dy / d * swirl
				s.y = s.y + dy / d * pull + dx / d * swirl
				local fade = math.clamp((d - 24) / 70, 0, 1) * math.clamp((t - s.born) / 0.8, 0, 1)
				s.f.Position = UDim2.fromOffset(s.x, s.y)
				s.f.BackgroundTransparency = 1 - s.a * fade
			end
		end
	end))

	-- Animation d'apparition
	if canvasSupported then main.GroupTransparency = 1 end
	uiScale.Scale = 0.9
	tween(uiScale, { Scale = 1 }, 0.7, BACK)
	if canvasSupported then tween(main, { GroupTransparency = 0 }, 0.5) end

	Library.Window = win
	return win
end

function Library:Destroy()
	for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
	table.clear(Conns)
	table.clear(spinners)
	table.clear(activeNotifs)
	Library._openDD = nil
	Library._listening = false
	if Library.Window and Library.Window.Gui then Library.Window.Gui:Destroy() end
	Library.Window = nil
	if notifGui then notifGui:Destroy() notifGui = nil end
	table.clear(Library.Flags)
	table.clear(Library.Items)
	table.clear(Library.CornerObjects)
end

return Library
