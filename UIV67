-- Effet au clic : un reflet qui balaie l'élément depuis le côté du clic. Il épouse les coins arrondis de l'hôte
-- (l'ancienne onde circulaire était rognée en rectangle car ClipsDescendants ignore UICorner).
local function ripple(host, tint)
	if not (Library.Ripple and Library.Animations) then return end
	if not (host and host.Parent) then return end
	local m = UIS:GetMouseLocation()
	local fromRight = m.X > host.AbsolutePosition.X + host.AbsoluteSize.X / 2
	local r = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = tint or T.Accent, BackgroundTransparency = 0,
		BorderSizePixel = 0, ZIndex = 4, Active = false }, host)
	local uc = host:FindFirstChildOfClass("UICorner")
	if uc then new("UICorner", { CornerRadius = uc.CornerRadius }, r) end
	local g = new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.92), NumberSequenceKeypoint.new(0.5, 0.8),
		NumberSequenceKeypoint.new(0.7, 0.92), NumberSequenceKeypoint.new(1, 1) }),
		Offset = Vector2.new(fromRight and 1 or -1, 0) }, r)
	tween(g, { Offset = Vector2.new(fromRight and -1 or 1, 0) }, 0.55)
	task.delay(0.6 / math.max(Library.AnimSpeed or 1, 0.05) + 0.05, function() r:Destroy() end)
end

local function ringSeq()
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.22, 0.65),
		NumberSequenceKeypoint.new(0.5, 1),
		NumberSequenceKeypoint.new(0.78, 0.65),
		NumberSequenceKeypoint.new(1, 0),
	})
end

local function fadeLine(parent, props)
	local f = new("Frame", {
		BackgroundColor3 = T.Accent, BorderSizePixel = 0,
	}, nil)
	for k, v in pairs(props or {}) do f[k] = v end
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, f)
	f.Parent = parent
	return f
end

-- ============================================================================
-- FLOU D'ARRIÈRE-PLAN  (BlurEffect dans Lighting : floute le jeu derrière l'interface)
-- ============================================================================
local blurFx
local blurToken = 0
local function setBlurTarget(size, instant)
	blurToken += 1
	local my = blurToken
	size = math.clamp(tonumber(size) or 0, 0, 56)
	if size <= 0 and not (blurFx and blurFx.Parent) then return end
	if not (blurFx and blurFx.Parent) then
		local ok, fx = pcall(function()
			local b = Instance.new("BlurEffect")
			b.Name = "UILibBlur"
			b.Size = 0
			b.Parent = Lighting
			return b
		end)
		if not ok or not fx then return end
		blurFx = fx
	end
	if instant or not Library.Animations then
		blurFx.Size = size
		blurFx.Enabled = size > 0
		return
	end
	blurFx.Enabled = true
	local tw = tween(blurFx, { Size = size }, 0.45)
	if size <= 0 then
		tw.Completed:Connect(function()
			if blurToken == my and blurFx then blurFx.Enabled = false end
		end)
	end
end

function Library:SetBlur(n)
	Library.BlurSize = math.clamp(tonumber(n) or 0, 0, 56)
	local w = Library.Window
	setBlurTarget((w and w.Open) and Library.BlurSize or 0)
end

-- ============================================================================
-- CURSEUR LIBRE + BLOCAGE DES TOUCHES DU JEU  (mécanisme PARTAGÉ)
--   Utilisé par la fenêtre, la Palette (Ctrl+K), la barre de recherche (Ctrl+T) et la pipette du color picker.
--   Library:AcquireCursor("nom", forcer)  : demande le curseur libre. forcer = true -> libre même si « Libérer le curseur »
--                                           est désactivé (palette, recherche, pipette ont besoin du curseur).
--   Library:ReleaseCursor("nom")          : rend le curseur au jeu quand plus personne ne le demande.
--   Library:SetFreeCursor(bool)           : réglage « Libérer le curseur » (concerne la fenêtre).
--   Library:SetBlockGameKeys(bool)        : réglage « Bloquer les touches du jeu » (Library.BlockedKeys = liste de KeyCode).
--   Library:IsCursorFree()
--   Un bouton « Modal » invisible (méthode native Roblox) + un rappel à chaque frame pour les jeux qui reverrouillent la souris.
--   (bloc isolé dans un do ... end : la librairie est proche de la limite de 200 variables locales)
-- ============================================================================
do
	local CAS = game:GetService("ContextActionService")
	local PASS, SINK = Enum.ContextActionResult.Pass, Enum.ContextActionResult.Sink
	local KEY_ACTION, STEP_NAME = "UiLibGameKeys", "UiLibCursor"
	local owners, gui, btn, savedIcon = {}, nil, nil, nil
	local freed, keysBound = false, false
	local dotGui, dot, dotScale, dotCol = nil, nil, nil, nil

	-- Réglages du curseur dessiné (sous-onglet Réglages > Curseur). Library:SetCursorOption(nom, valeur)
	Library.CursorDefaults = { Shape = "Point", Size = 12, Color = Color3.new(1, 1, 1), Outline = Color3.new(0, 0, 0),
		OutlineSize = 1.5, Opacity = 1, UseAccent = false, ClickShrink = true }
	if type(Library.CursorCfg) ~= "table" then
		Library.CursorCfg = {}
		for k, v in pairs(Library.CursorDefaults) do Library.CursorCfg[k] = v end
	end

	-- Curseur dessiné par l'UI : en 1re personne, Roblox / le jeu cache souvent le curseur natif
	-- (même déverrouillé). Library.CursorStyle = "auto" (seulement en 1re personne) | "dot" (toujours) | "native".
	local function useDot()
		if (Library._cursorPreviewUntil or 0) > os.clock() then return true end
		local style = Library.CursorStyle or "auto"
		if style == "native" then return false end
		if style == "dot" then return true end
		if LP and LP.CameraMode == Enum.CameraMode.LockFirstPerson then return true end
		local cam = workspace.CurrentCamera
		return cam ~= nil and (cam.CFrame.Position - cam.Focus.Position).Magnitude < 1.5
	end

	local function destroyDot()
		if dotGui then pcall(function() dotGui:Destroy() end) end
		dotGui, dot, dotScale, dotCol = nil, nil, nil, nil
	end

	local function curColor()
		local c = Library.CursorCfg
		return c.UseAccent and T.Accent or c.Color
	end

	local function ensureDot()
		local col = curColor()
		if dot and dot.Parent and dotCol == col then return end
		destroyDot()
		dotCol = col
		local c = Library.CursorCfg
		local S = math.clamp(tonumber(c.Size) or 12, 4, 64)
		local tr = 1 - math.clamp(tonumber(c.Opacity) or 1, 0, 1)
		local ot = math.max(tonumber(c.OutlineSize) or 0, 0)
		local ocol = c.Outline or Color3.new(0, 0, 0)
		dotGui = Instance.new("ScreenGui")
		dotGui.Name = "SolarisCursorDot"
		dotGui.ResetOnSpawn = false
		dotGui.DisplayOrder = 2147483647
		dotGui.IgnoreGuiInset = true
		dotGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		mount(dotGui)
		dot = Instance.new("Frame")
		dot.Name = "Cursor"
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Size = UDim2.fromOffset(S, S)
		dot.BackgroundTransparency = 1
		dot.BorderSizePixel = 0
		dot.Active = false
		dot.Parent = dotGui
		dotScale = Instance.new("UIScale")
		dotScale.Parent = dot

		local function strokeOn(f, thick, color)
			if thick <= 0 then return end
			local st = Instance.new("UIStroke")
			st.Color = color
			st.Thickness = thick
			st.Transparency = tr
			st.Parent = f
		end
		-- forme pleine (avec contour extérieur)
		local function solid(size, pos, anchor, round, z)
			local f = Instance.new("Frame")
			f.AnchorPoint = anchor or Vector2.new(0.5, 0.5)
			f.Position = pos or UDim2.fromScale(0.5, 0.5)
			f.Size = size
			f.BackgroundColor3 = col
			f.BackgroundTransparency = tr
			f.BorderSizePixel = 0
			f.Active = false
			f.ZIndex = z or 2
			if round then
				local uc = Instance.new("UICorner")
				uc.CornerRadius = UDim.new(1, 0)
				uc.Parent = f
			end
			strokeOn(f, ot, ocol)
			f.Parent = dot
			return f
		end

		local shape = c.Shape
		if shape == "Cercle" then
			-- anneau : trait coloré + liseré du contour de chaque côté
			local t = math.max(2, math.floor(S / 6 + 0.5))
			if ot > 0 then
				local back = Instance.new("Frame")
				back.AnchorPoint = Vector2.new(0.5, 0.5)
				back.Position = UDim2.fromScale(0.5, 0.5)
				back.Size = UDim2.fromOffset(math.max(S - ot * 2, 2), math.max(S - ot * 2, 2))
				back.BackgroundTransparency = 1
				back.BorderSizePixel = 0
				back.Active = false
				back.ZIndex = 1
				local uc = Instance.new("UICorner")
				uc.CornerRadius = UDim.new(1, 0)
				uc.Parent = back
				strokeOn(back, t + ot * 2, ocol)
				back.Parent = dot
			end
			local ring = Instance.new("Frame")
			ring.AnchorPoint = Vector2.new(0.5, 0.5)
			ring.Position = UDim2.fromScale(0.5, 0.5)
			ring.Size = UDim2.fromOffset(S, S)
			ring.BackgroundTransparency = 1
			ring.BorderSizePixel = 0
			ring.Active = false
			ring.ZIndex = 2
			local uc = Instance.new("UICorner")
			uc.CornerRadius = UDim.new(1, 0)
			uc.Parent = ring
			strokeOn(ring, t, col)
			ring.Parent = dot
		elseif shape == "Croix" then
			local gap = math.max(2, math.floor(S * 0.12 + 0.5))
			local L = math.max(S / 2 - gap, 2)
			local th = math.max(2, math.floor(S / 6 + 0.5))
			solid(UDim2.fromOffset(th, L), UDim2.new(0.5, 0, 0.5, -gap), Vector2.new(0.5, 1))
			solid(UDim2.fromOffset(th, L), UDim2.new(0.5, 0, 0.5, gap), Vector2.new(0.5, 0))
			solid(UDim2.fromOffset(L, th), UDim2.new(0.5, -gap, 0.5, 0), Vector2.new(1, 0.5))
			solid(UDim2.fromOffset(L, th), UDim2.new(0.5, gap, 0.5, 0), Vector2.new(0, 0.5))
		elseif shape == "Flèche Roblox" then
			-- vraie flèche du curseur Roblox (image native). Le point chaud est placé sous la souris ;
			-- ajuste Library.RobloxCursorHotspot (0-1) si la pointe n'est pas pile sur le clic.
			local hs = Library.RobloxCursorHotspot or Vector2.new(0.3, 0.3)
			local img = Instance.new("ImageLabel")
			img.Name = "RobloxArrow"
			img.AnchorPoint = hs
			img.Position = UDim2.fromScale(0.5, 0.5)
			img.Size = UDim2.fromOffset(S * 3, S * 3)
			img.BackgroundTransparency = 1
			img.BorderSizePixel = 0
			img.Active = false
			img.Image = "rbxasset://textures/Cursors/KeyboardMouse/ArrowFarCursor.png"
			img.ImageTransparency = tr
			img.ZIndex = 2
			img.Parent = dot
		elseif shape == "Carré" then
			solid(UDim2.fromOffset(S, S), nil, nil, false)
		else   -- "Point"
			solid(UDim2.fromOffset(S, S), nil, nil, true)
		end
	end

	local function wantCursor()
		for _, mode in pairs(owners) do
			if mode == "force" or Library.FreeCursor ~= false then return true end
		end
		return false
	end

	-- touche du jeu bloquée : seulement l'appui (le relâchement passe, sinon une touche tenue avant l'ouverture resterait coincée)
	local function onKey(_, state)
		if state ~= Enum.UserInputState.Begin then return PASS end
		if Library._listening or UIS:GetFocusedTextBox() then return PASS end
		return SINK
	end

	local function apply()
		local want = wantCursor()
		if want and not (gui and gui.Parent) then
			gui = new("ScreenGui", { Name = "SolarisCursor", ResetOnSpawn = false, DisplayOrder = 0, IgnoreGuiInset = true })
			mount(gui)
			btn = new("TextButton", { Name = "CursorFree", Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1,
				Text = "", AutoButtonColor = false, Modal = true, BorderSizePixel = 0, Visible = false }, gui)
		end
		if btn then btn.Visible = want end
		if want ~= freed then
			freed = want
			pcall(function() RunService:UnbindFromRenderStep(STEP_NAME) end)
			if want then
				if savedIcon == nil then savedIcon = UIS.MouseIconEnabled end
				pcall(function()
					RunService:BindToRenderStep(STEP_NAME, Enum.RenderPriority.Camera.Value + 10, function()
						if UIS.MouseBehavior ~= Enum.MouseBehavior.Default then UIS.MouseBehavior = Enum.MouseBehavior.Default end
						if useDot() then
							-- curseur natif masqué + point dessiné à la position de la souris
							if UIS.MouseIconEnabled then UIS.MouseIconEnabled = false end
							ensureDot()
							local m = UIS:GetMouseLocation()
							dot.Position = UDim2.fromOffset(m.X, m.Y)
							dot.Visible = true
							if dotScale then
								local down = Library.CursorCfg.ClickShrink and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
								dotScale.Scale = dotScale.Scale + ((down and 0.7 or 1) - dotScale.Scale) * 0.35
							end
						else
							if not UIS.MouseIconEnabled then UIS.MouseIconEnabled = true end
							if dot then dot.Visible = false end
						end
					end)
				end)
			else
				destroyDot()
				if savedIcon ~= nil then
					pcall(function() UIS.MouseIconEnabled = savedIcon end)
					savedIcon = nil
				end
			end
		end
		local keys = Library.BlockGameKeys == true and next(owners) ~= nil
		if keys ~= keysBound then
			keysBound = keys
			pcall(function() CAS:UnbindAction(KEY_ACTION) end)
			if keys then
				local list = {}
				for _, k in ipairs(Library.BlockedKeys or {}) do
					if typeof(k) == "EnumItem" then list[#list + 1] = k end
				end
				if #list > 0 then
					pcall(function() CAS:BindActionAtPriority(KEY_ACTION, onKey, false, 2900, table.unpack(list)) end)
				end
			end
		end
	end

	function Library:AcquireCursor(owner, force)
		owners[owner or "default"] = force and "force" or "normal"
		apply()
	end
	function Library:ReleaseCursor(owner)
		owners[owner or "default"] = nil
		apply()
	end
	function Library:IsCursorFree() return freed end
	function Library:SetCursorStyle(v)   -- "auto" | "dot" | "native"
		Library.CursorStyle = (v == "dot" or v == "native") and v or "auto"
	end
	-- Shape ("Point" | "Flèche Roblox" | "Cercle" | "Carré" | "Croix"), Size (4-64), Color, Outline (Color3), OutlineSize, Opacity (0-1),
	-- UseAccent (bool), ClickShrink (bool)
	function Library:SetCursorOption(name, value)
		if Library.CursorDefaults[name] == nil then return false end
		Library.CursorCfg[name] = value
		destroyDot()   -- reconstruit à la frame suivante
		return true
	end
	function Library:PreviewCursor(seconds)   -- force le curseur dessiné quelques secondes pour voir les réglages
		seconds = tonumber(seconds) or 6
		Library._cursorPreviewUntil = os.clock() + seconds
		Library:AcquireCursor("preview", true)
		task.delay(seconds + 0.1, function()
			if (Library._cursorPreviewUntil or 0) <= os.clock() then Library:ReleaseCursor("preview") end
		end)
	end
	function Library:SetFreeCursor(v)
		Library.FreeCursor = v and true or false
		apply()
	end
	function Library:SetBlockGameKeys(v)
		Library.BlockGameKeys = v and true or false
		apply()
	end
	function Library:SetBlockedKeys(list)
		if type(list) ~= "table" then return end
		Library.BlockedKeys = list
		if keysBound then
			keysBound = false   -- on relie avec la nouvelle liste
			apply()
		end
	end

	Library._destroyCursor = function()
		table.clear(owners)
		apply()
		pcall(function() CAS:UnbindAction(KEY_ACTION) end)
		keysBound = false
		destroyDot()
		if gui then pcall(function() gui:Destroy() end) end
		gui, btn = nil, nil
	end
end

