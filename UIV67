--[[
	Ui-Lib Simple  —  édition « Trou noir »  (noir & blanc, tout en fluidité)
	Compatible avec Help_1_fixed.txt  (même API qu'avant)

	Utilisation :
		local Library = loadstring(readfile("Ui-Lib-Simple.lua"))()
	ou, si tu l'héberges :
		local Library = loadstring(game:HttpGet("TON_LIEN_RAW"))()

	API (inchangée) :
		Library:CreateWindow({...})            -> Window
		Window:CreateTab(nom, _, icone)        -> Tab
		Tab:CreateBlock({Name, Side, ImageID}) -> Block
		Block:CreateSection / CreateLabel / CreateParagraph / CreateDivider /
		      CreateButton / CreateToggle / CreateSlider / CreateDropdown /
		      CreateInput / CreateColorPicker / CreateKeybind / CreateProgress / CreateStepper
		Library:Notify({Title, Content, Duration})
		Library.Flags / Library.Items / Library.CornerObjects / Library.GlobalCornerValue

	COLONNES DE BLOCS  (1 à 4)
		• Paramètres > Apparence > « Colonnes de blocs » (ou Window:SetColumns(n) / Library:SetColumns(n) /
		  CreateWindow({ Columns = n })). La fenêtre s'agrandit toute seule si elle est trop étroite
		  (≈ 676 px pour 2 colonnes, 941 px pour 3, 1206 px pour 4) et ne peut plus être réduite en dessous.
		• 2 colonnes : Side = \"Left\" / \"Right\" comme avant. 3 et 4 colonnes : les blocs sont répartis à tour de rôle.
		• Écran trop petit : le nombre de colonnes affichées est réduit automatiquement.
		• Library.ColumnMinWidth = largeur minimale d'une colonne (255 par défaut).

	SAUVEGARDE AUTO DES PARAMÈTRES
		• Tout ce que tu changes dans l'onglet Paramètres (position / durée des notifications, thème, couleurs, colonnes,
		  sons, trou noir...) est enregistré tout seul dans <ConfigFolder>/_settings.json et restauré au lancement suivant,
		  même si une config est auto-chargée. Library.AutoSaveSettings = false (ou Paramètres > Fenêtre) pour couper ;
		  Library:SaveSettings() / Library:LoadSettings() pour le faire à la main.

	DISPOSITION DES BLOCS  (déplacer les blocs, sauvegardée automatiquement)
		• Paramètres > « Disposition des blocs » > « Mode édition » : l'en-tête de chaque bloc (onglets ET Paramètres)
		  devient une poignée. Glisse-le vers le haut / le bas, ou vers une autre colonne ; un emplacement s'affiche
		  à l'endroit où le bloc va tomber. Le défilement se fait tout seul près des bords de la colonne.
		• La disposition est mémorisée PAR nombre de colonnes (2 colonnes, 3 colonnes...) et par onglet / sous-onglet,
		  dans <ConfigFolder>/_settings.json (clé « ui.blocklayout »), donc restaurée au lancement suivant, même pour
		  les blocs que ton script crée après CreateWindow. Un bloc nouveau (jamais déplacé) va en bas de sa colonne.
		• API : Library:SetLayoutEdit(bool) / Library.LayoutEdit  ·  Library:ResetBlockLayout([nomOnglet])
		  Library.BlockLayout = les données  ·  Nécessite la sauvegarde auto des paramètres pour persister.

	RACCOURCIS CLAVIER (Paramètres > « Raccourcis clavier »)
		• Liste tous les keybinds de l'interface (Block:CreateKeybind). Bouton « Aller » à droite : 1er clic = confirmer,
		  2e clic = ouvre l'onglet, déplie le bloc, défile jusqu'au keybind et le fait clignoter.
		• Library:RevealElement(entrée) fait la même chose depuis le code ; Library.KeybindEntries = la liste.

	NOUVEAUTÉS
		• Design « trou noir » : anneau d'horizon qui tourne autour de la fenêtre, trou noir
		  décoratif avec disque d'accrétion, étoiles aspirées en spirale.
		• Ouverture / fermeture animées, déplacement lissé, fenêtre limitée à l'écran,
		  poignée de redimensionnement (coin bas-droite), Window:SetScale(n).
		• Transition fluide entre onglets, blocs repliables animés, hover partout.
		• Recherche globale (barre dans la sidebar) : filtre les éléments de tous les onglets.
		• Slider : clic sur la valeur pour taper un nombre exact (ex. -2.89765, sans accroche sur le pas ; la poignée, elle, suit Step/Increment), options Step/Increment et Suffix.
		• Dropdown : recherche intégrée (listes longues) et mode Multi = true (retourne une table).
		  Option Search = true/false pour forcer la barre de recherche.
		• Input : option Numeric = true, LiveUpdate = true, ClearOnFocus = true.
		• Notifications : Type = "Info" | "Success" | "Warning" | "Error", barre de durée,
		  clic pour fermer, 5 max empilées.
		• Config : Library:SaveConfig(nom) / LoadConfig(nom) / DeleteConfig(nom) / ListConfigs()
		  et Window:CreateConfigTab("Config") qui crée un onglet tout prêt.
		• Library:SetCornerRadius(v) met à jour tous les arrondis déjà créés.
		• Options de CreateWindow en plus : Stars (nombre d'étoiles, 0 = aucune), MinSize (Vector2).
		• Performances : NoCanvasGroup = true (CreateWindow ou Library.NoCanvasGroup) pour un rendu bien plus
		  fluide (pas de fondu d'ouverture) ; Background = "full" | "light" | "off" dans CreateWindow, ou
		  Window:SetBackground(mode) / Library:SetBackground(mode) à tout moment.
		  Le fond se met en pause tout seul pendant les déplacements, redimensionnements et animations lourdes.

	─────────────  V3 : THÈMES, ANIMATIONS  (les vagues ont été retirées en V4)  ─────────────
	THÈMES (onglet Paramètres > Thèmes / Couleurs)
		Library:GetTheme() / ApplyTheme(t) / ApplyPreset(nom) / SaveTheme / LoadTheme / DeleteTheme / ListThemes
		Library:ExportTheme() -> "UILIB-THEME:{json}" (copié dans le presse-papiers) / ImportTheme(texte)
		Library:SetColors({ Main, Second, Accent, Text, ElementAccent })  (Color3 ou "#RRGGBB"), en direct
		Library:SetFont(nom)  Gotham / Builder Sans / Source Sans / Ubuntu / Nunito / Arimo / Code
	CONFIGS : ExportConfig / ImportConfig / ResetConfig(includeUi) / DuplicateConfig / RenameConfig
	FORME : Library:SetShape("Vague" | "Douce" | "Classique"), contour ondulant autour de la fenêtre,
		vagues intérieures, Library:SetOption("WaveAmp" | "WaveSpeed" | "SpinSpeed" | "Breathing" | "Ripple" |
		"OutlineWaves" | "InnerWaves" | "WinRound" | "HoleVisible" | "HolePos" | "HoleScale", valeur), Library:SetStars(n)
	ANIMATIONS : onde au clic, bouton qui s'étire, onglets qui glissent, bordure qui respire, titre qui brille.

	─────────────  NOUVEAUTÉS DE CETTE VERSION  ─────────────
	FLUIDITÉ
		• Le fond animé (anneaux + étoiles) n'est plus recalculé à chaque frame : boucle Heartbeat à ~30 Hz
		  (~15 Hz pendant un geste), au lieu de RenderStepped + pause/reprise brutale (c'était la cause de l'effet « 15 fps »).
		• RenderStepped ne gère plus que le déplacement / redimensionnement (très léger). Le redimensionnement suit
		  directement le curseur (moins de recalculs de layout), le déplacement reste lissé.
		• tween() met les TweenInfo en cache ; le slider se met à jour sans tween empilés pendant le glisser ;
		  le dropdown ne ré-anime que les lignes qui changent. Bug corrigé : l'appel de glisser sans position.
	PARAMÈTRES  (Window:CreateSettingsTab("Paramètres"))
		opacité, couleur d'accent en direct, arrondi, échelle, taille de police, animations on/off + vitesse
		(0.5x / 1x / 2x), fond animé complet/léger/off, indicateur FPS/ping, position et durée des notifications,
		réinitialiser la fenêtre, config auto-chargée (Library:SetAutoLoad / Library:AutoLoad).
		Position + taille de la fenêtre et état replié des blocs sont enregistrés dans les configs.
	INTERFACE
		• Double-clic sur la barre de titre : réduit à la barre seule / restaure (Paramètres > Fenêtre > « Barre réduite visible » :
		  activé = la barre réduite reste toujours à l'écran, masquée ou non ; masquer une fenêtre dépliée la réduit en barre).   • Ctrl+R : recentre.
		• Bouton « = » dans la barre de titre : tout replier / déplier (Tab:CollapseAll / Tab:ExpandAll).
		• Poignées de redimensionnement sur tous les bords et coins.
		• Tooltips : { Tooltip = "texte" } sur Button/Toggle/Slider/Dropdown/Input/Keybind/ColorPicker.
		• Favoris : étoile ★ sur chaque élément + Window:CreateFavoritesTab("Favoris"). { Favorite = false } pour l'enlever.
		• Block:CreateConfirmButton({...}) ou CreateButton({ Confirm = true, ConfirmText = "..." }) : double confirmation.
		• Block:CreateSeparator() (alias de CreateDivider). CreateLabel / CreateParagraph / Dropdown Multi existaient déjà.
		• Indicateur FPS/ping dans la barre de titre (CreateWindow({ ShowStats = false }) pour le cacher).
		• Library:SetAccent / SetFontScale / SetAnimSpeed / SetAnimations / SetWindowAnim / SetLockPosition / SetToggleStyle / SetNotifPosition / SetNotifDuration

	─────────────  V4 : FLOU, ÉTOILES QUI REBONDISSENT, STYLES  ─────────────
		• Les vagues (contour ondulant + vagues intérieures) ont été retirées.
		• Étoiles qui rebondissent sur les bords de l'écran, DERRIÈRE la fenêtre (elles disparaissent sous la fenêtre) :
		  Library.StarCount / Library:SetStars(n), Library.StarSpeed, Library.StarsThroughWindow.
		  Les étoiles aspirées par le trou noir (dans la fenêtre) sont optionnelles : Library.HoleStars = true.
		• Flou d'arrière-plan (BlurEffect dans Lighting, seulement quand l'interface est ouverte) :
		  Library:SetBlur(0 à 56)  /  CreateWindow({ Blur = 14 }).  Il floute le jeu, pas les fenêtres.
		• STYLES : Library:SetStyle("Standard" | "Verre" | "Givré" | "Mat" | "Néon")  /  CreateWindow({ Style = "Verre" })
		  et dans Réglages > Style. Pour en ajouter un : copie une entrée de la table STYLES plus bas.
		• Formes : "Arrondie" | "Douce" | "Classique" (l'ancienne "Vague" est convertie en "Arrondie").

	─────────────  V5 : NOTIFICATIONS  (détail de l'API juste avant Library:Notify)  ─────────────
		• Library:Notify renvoie maintenant un handle : n:Update / SetProgress / SetTitle / SetContent / SetType /
		  Dismiss / Pause / Resume / IsAlive.  Type = "Loading" ou Progress = 0..1 pour une notif qui évolue.
		• Animations : entrée en glissant avec rebond, reflet qui balaie la carte, icône qui pop + onde,
		  Erreur = secousse, Alerte = oscillation, Succès = rotation ; la pile se décale en douceur.
		• Pause du minuteur au survol, swipe latéral pour fermer, doublons regroupés (badge x2, x3...),
		  boutons d'action (Actions = {...}), OnClick / OnDismiss, mode « Ne pas déranger », historique
		  (Window:CreateNotifLogTab), 6 positions (haut / bas x gauche / centre / droite), couleurs par type.

	─────────────  V6 : TROU NOIR À LA FERMETURE, PASTILLE +N, SONS, PALETTE (Ctrl+K)  ─────────────
		• Look des notifications : pilule noire très arrondie, contour blanc fin, texte blanc net, pastille d'icône blanche
		  (Library.NotifColored = true pour recolorer la pastille selon le type).
		• Fermeture d'une notification : la carte se brouille (images fantômes), se froisse en boule de papier (plis
		  clairs) pendant qu'un trou noir noir & blanc s'ouvre derrière elle, puis elle spirale vers son centre avec des
		  morceaux de papier arrachés, et une onde de choc referme tout. Library.NotifBlackHole = false pour le couper
		  (le swipe latéral garde son glissement). Réglages > Notifications.
		• Au-delà du maximum affiché (NotifMax) les plus anciennes ne sont plus fermées : elles sont masquées (minuteur en
		  pause) et une pastille « +3 » apparaît. Clic sur la pastille = tout vider. Library.NotifOverflow = "Close" pour
		  retrouver l'ancien comportement. Library:SetNotifMax(n) / SetNotifOverflow("Pill" | "Close").
		• Un son par type (Info / Succès / Alerte / Erreur) : Réglages > Sons des notifications (liste de sons, ID perso,
		  fichier du workspace, volume). Library:SetNotifSound("Error", "Basse") / PlayNotifSound(type).
		• Palette de commandes : Ctrl+K ouvre une roue de 10 cases au milieu de l'écran (curseur libre).
		  1-0 ou clic pour choisir, Tab = filtre (Tout / Favoris / Boutons / Toggles / Réglages), molette ou flèches = page,
		  / = recherche, Échap = retour. Boutons lancés, toggles basculés, curseurs / listes / champs / couleurs / touches
		  réglés sans ouvrir la fenêtre. Library:OpenPalette() / ClosePalette() / TogglePalette(). { Palette = false } exclut un élément.

	─────────────  V8 : CONFLITS DE TOUCHES, HUD, SOUS-ONGLETS, CONSOLE, « NE PLUS AFFICHER »  ─────────────
		• Conflits de keybinds : Paramètres > Raccourcis clavier affiche un avertissement ⚠ (liste des touches partagées),
		  les lignes concernées passent en orange ; pastille « ! » sur les éléments, notification quand tu en crées un.
		• HUD des actifs : Paramètres > HUD des actifs (afficher, touches, seulement fenêtre fermée, taille, replacer).
		  Il se déplace à la souris / au doigt et sa position est sauvegardée avec les réglages.
		• Slider à deux poignées : Block:CreateRangeSlider({ Name, Min, Max, Step, MinGap, Default = { Low, High }, Callback = function(lo, hi) })
		• Sous-onglets : local subs = Tab:CreateSubTabs({ "A", "B" }) puis subs[1]:CreateBlock({...}) (voir plus bas).
		• Onglets DANS un onglet (menu déroulant fluide dans la barre latérale, avec une flèche ›) :
		    local combat = Window:CreateTab("Combat", nil, icon)
		    local aim    = combat:CreateChildTab("Aimbot", nil, icon)   -- (ou combat:CreateTab(...))
		    local esp    = combat:CreateChildTab("ESP")
		    aim:CreateBlock({ Name = "Réglages" }) ...                  -- un enfant est un onglet normal
		    combat:SetExpanded(true) / combat:ToggleExpanded() / combat.Expanded
		    local kids = combat:CreateChildTabs({ "Aimbot", { Name = "ESP", Icon = "rbxassetid://..." } })
		    Les enfants peuvent aussi avoir des enfants (imbrication illimitée). Clic sur la flèche = ouvrir / fermer ;
		    clic sur l'onglet = l'afficher et déplier ; clic sur l'onglet déjà actif = plier / déplier.
		• Console : Window:CreateConsoleTab("Console") affiche les print / warn / erreurs ; Library:ConsoleLog(texte, type).
		• « Ne plus afficher » : une notification répétée (x2) reçoit un bouton qui la masque ; liste + réactivation dans
		  Paramètres > Notifications masquées (Library:SilenceNotif / UnsilenceNotif / UnsilenceAllNotifs).

	─────────────  V7 : TITRE ÉTIRÉ, BARRE DE RECHERCHE (Ctrl+T)  ─────────────
		• Titre étiré + en gras (Library.TitleStretch / TitleBold, Réglages > Apparence). Le texte se réduit tout seul
		  pour tenir dans la barre de titre. Si tu vois des carrés entre les lettres : Library.TitleSpacing = " ".
		• Ctrl+T : barre de recherche seule au milieu de l'écran (sans la fenêtre), trou noir + étoiles qui spiralent.
		  Les résultats affichent les vrais contrôles (interrupteur, curseur, bouton, liste, champ, couleur, touche).
		  Library:OpenSpotlight() / CloseSpotlight() / ToggleSpotlight() / SetSpotlightKey(KeyCode, needCtrl).

	─────────────  V8 : SONS DE L'INTERFACE  ─────────────
		• Petits bruits calmes (avec un léger écho « trou noir ») : survol des onglets et des éléments, changement d'onglet,
		  clic sur un bouton, toggle activé / désactivé, liste déroulante, bloc replié, champ de saisie, ouverture et
		  fermeture de la fenêtre, de la palette (Ctrl+K) et de la barre de recherche (Ctrl+T).
		• Paramètres > « Sons de l'interface » : on/off, volume, ambiance (Trou noir / Cristal / Doux), bruits au survol,
		  écho spatial. Sauvegardé automatiquement avec les autres réglages.
		• API : Library:SetUISoundEnabled(bool) / SetUISoundVolume(0-1) / SetUISoundPack(nom) / SetUISoundHover(bool) /
		  SetUISoundReverb(bool) / PlayUISound(evenement). Library.UISoundPacks = les ambiances (modifiables).

	─────────────  V9 : STYLES DE FERMETURE DES NOTIFICATIONS  ─────────────
		• Paramètres > Notifications > « Style de fermeture » (sauvegardé automatiquement) : Trou noir · Fondu · Rétrécir ·
		  Tourbillon · Briser (éclats projetés) · Casser (cassée en deux) · Dissoudre · Effacer vers le haut / le bas /
		  la gauche / la droite (masque + trait lumineux) · Glisser · Aléatoire.
		• API : Library:SetNotifExit("Briser") · Library.NotifExit · Library.NotifExitStyles
		  Library.NotifExitByType = { Error = "Briser", Success = "Tourbillon" } (un style par type de notification)
		  Library:Notify({ ..., Exit = "Effacer vers la droite" }) (style pour une seule notification)
		• Le swipe latéral garde son glissement. Library.NotifBlackHole = false convertit « Trou noir » en « Glisser ».

	─────────────  V10 : JAUGES, COMPTEURS, STYLES D'ENTRÉE, TRANSITIONS D'ONGLETS, HUD  ─────────────
		• Block:CreateProgress({ Name, Min = 0, Max = 100, Default, Suffix | Format = function(v, ratio, max), Color, Text })
		  Barre de progression / jauge mise à jour par le script (cooldowns, chargement) :
		  p:Set(v) · p:Get() · p:GetRatio() · p:SetMax(m) · p:SetText("...") · p:SetColor(c) · p:SetName("...")
		  p:Countdown(secondes, { Fill = false, ShowTime = true, OnDone = fn }) : se vide (ou se remplit avec Fill = true)
		  p:SetIndeterminate(true) : chargement sans valeur connue · p:Cancel() : arrête le décompte / le chargement.
		• Block:CreateStepper({ Name, Min, Max, Step = 1, Default, Suffix, Wrap = false, Flag, Callback })
		  Compteur  - / valeur / +  pour les entiers (plus précis qu'un curseur). Maintenir le bouton = répétition qui accélère,
		  Maj = pas x10, clic sur la valeur = saisie au clavier. item:Set(n) · item:Get() · item:Increment() · item:Decrement().
		• Styles d'entrée des notifications : Paramètres > Notifications > « Styles d'entrée personnalisés » (DÉSACTIVÉ par défaut)
		  puis « Style d'entrée » : Trou noir (sort d'un trou noir) · Éclats (se reconstitue à partir d'éclats) ·
		  Balayage depuis la gauche / la droite / le haut / le bas · Aléatoire.
		  API : Library:SetNotifEntry("Éclats") · Library:SetNotifEntryEnabled(true) · Library.NotifEntryByType = { Error = "Éclats" }
		  Library:Notify({ ..., Entry = "Trou noir" }) pour une seule notification (marche même réglage coupé ; Entry = false = entrée classique).
		• Transitions d'onglets : Paramètres > Animations & performances > « Transition des onglets » : Glisser · Fondu · Zoom.
		  API : Library:SetTabTransition("Zoom") · Library.TabTransitions.
		• HUD des actifs refait : il est ancré par le coin le plus proche d'un bord de l'écran, donc quand une ligne apparaît ou
		  disparaît il s'agrandit vers l'intérieur de l'écran au lieu de se décaler. Largeur calculée, colonne des touches alignée
		  à droite. Chaque ligne affiche sa touche : celle du toggle (Keybind = ...), sinon celle d'un Block:CreateKeybind du même
		  nom, sinon celle donnée à la main : CreateToggle({ Name = "Vol", HudKey = monKeybind }) (item, Enum.KeyCode ou fonction).
]]

local Players      = game:GetService("Players")
local UIS          = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService   = game:GetService("RunService")
local HttpService  = game:GetService("HttpService")
local GuiService   = game:GetService("GuiService")
local CoreGui      = game:GetService("CoreGui")
local LP           = Players.LocalPlayer
local Stats        = game:GetService("Stats")
local Lighting     = game:GetService("Lighting")

local Library = {
	Flags             = {},
	Items             = {},
	CornerObjects     = {},
	GlobalCornerValue = 10,    -- 10 = rayon normal (le script le change via son slider)
	FireDefaults      = false, -- true = appelle les Callback avec la valeur Default à la création
	NoCanvasGroup     = true,  -- true = fenêtre en simple Frame (beaucoup plus fluide) ; false = fondu d'ouverture mais plus lourd
	StarCount         = 20,    -- étoiles qui rebondissent sur l'écran, derrière la fenêtre (0 pour désactiver)
	ConfigFolder      = "Ui-Lib",
	Scale             = 1,
	Animations        = true,  -- false = aucune animation (PC faibles)
	AnimSpeed         = 1,     -- multiplicateur de vitesse des animations
	WindowAnim        = true,  -- false = la fenêtre s'ouvre / se ferme instantanément (sans effet smooth)
	LockPosition      = false, -- true = la fenêtre ne peut plus être déplacée ni redimensionnée à la souris
	MiniBarVisible    = false, -- true = la barre réduite reste toujours affichée (masquer la fenêtre dépliée la réduit en barre, la rouvrir la redéplie)
	FontScale         = 1,
	NotifPos          = "BottomRight",
	NotifDuration     = 4,
	Favorites         = {},
	FavEntries        = {},
	CmdEntries        = {},    -- éléments disponibles dans la palette de commandes (Ctrl+K)
	KeybindEntries    = {},    -- tous les keybinds placés dans l'interface (bloc « Raccourcis clavier » des Paramètres)
	DropdownEscape    = true,  -- Échap ferme la liste déroulante ouverte (Paramètres > Fenêtre)
	DropdownKeyNav    = true,  -- flèches / Entrée / frappe dans une liste ouverte (Paramètres > Fenêtre)
	DropdownKeys      = false, -- true = clic droit sur une entrée de liste : lui assigner une touche (Paramètres > Fenêtre)
	DDKeyEntries      = {},    -- listes déroulantes qui acceptent des touches : { Frame, Keys, Trigger, Refresh, SetKey, Clear }
	ToggleEntries     = {},    -- toggles listés par le HUD des actifs
	ResetEntries      = {},    -- toggles / sliders / keybinds du script, remis à zéro par « Réinitialiser les contrôles »
	ModEntries        = {},    -- éléments à valeur (filtre « Modifiés » + pastille) : { Item, Frame, Base, Mod, Dot }
	ModByFrame        = {},
	ModDots           = true,  -- pastille sur les éléments modifiés
	ModFilter         = false, -- n'affiche que les éléments modifiés (puce à côté de la recherche)
	ModCount          = 0,
	HudStyle          = "Carte",
	HudOpacity        = 100,
	NotifSilenced     = {},    -- notifications « ne plus afficher » : [clé] = { Type, Title, Content }
	KeybindConflictWarn = true, -- signale deux keybinds sur la même touche
	HudEnabled        = false, -- HUD des actifs (Paramètres > HUD des actifs)
	HudShowKeys       = true,
	HudOnlyClosed     = false,
	HudScale          = 1,
	TxtEntries        = {},    -- textes (labels / paragraphes) cherchables dans la barre de recherche (Ctrl+T)
	TitleStretch      = true,  -- titre étiré (lettres espacées)
	TitleBold         = true,  -- titre en gras
	TitleSpacing      = utf8.char(0x2009), -- espace fine entre les lettres (mets " " si tu vois des carrés)
	FavStars          = {},
	Shape              = "Arrondie", -- "Arrondie" | "Douce" | "Classique"
	StyleName          = "Standard", -- "Standard" | "Verre" | "Givré" | "Mat" | "Néon"
	BlurSize           = 14,         -- flou de l'arrière-plan (0 = aucun)
	StarSpeed          = 1,          -- vitesse des étoiles qui rebondissent
	StarsThroughWindow = false,      -- true = on voit aussi les étoiles à travers la fenêtre
	HoleStars          = false,      -- true = étoiles aspirées par le trou noir (dans la fenêtre)
	WinRound          = 1,         -- multiplicateur de rondeur de la fenêtre
	Breathing         = true,      -- le contour « respire »
	Ripple            = true,      -- onde au clic
	SpinSpeed         = 1,
	HoleVisible       = true,
	HolePos           = "TopRight",
	HoleScale         = 1,
	FontFamily        = "Gotham",
	Defaults          = {},
	TitleFont         = "Michroma",
	TitleFonts        = { "Michroma", "Gotham Black", "Fredoka", "Oswald", "Bangers", "Jura", "Sci-Fi", "Arcade", "Normale" },
	TitleShine        = true,
	LayoutEdit        = false, -- mode édition : les en-têtes de blocs se déplacent à la souris
	BlockLayout       = {},    -- [onglet][nbColonnes][bloc] = { c = colonne, o = ordre }  (sauvegardé : « ui.blocklayout »)
}

-- Relance du script : on détruit proprement l'ancienne instance (UI + connexions)
do
	local env = (getgenv and getgenv()) or _G
	local prev = env.__UiLibSimple
	if prev and prev ~= Library and type(prev.Destroy) == "function" then
