-- V5.3 : ONGLET « Home » (toujours en premier) + NOUVEAUTÉS AUTOMATIQUES
--   • Home est créé tout seul par CreateWindow : aperçu 3D de ton personnage, bloc-notes, amis, FPS / ping (chiffres + graphiques),
--     session (jauge + temps total), heure et météo réelles, infos serveur, et les nouveautés de l'UI. Plus d'onglet « Change-Log ».
--   • Les nouveautés viennent de Library.Changelog : Library:AddChangelog(version, { notes }, date, titre) met Home à jour tout seul
--     (et la version de l'UI affichée est toujours celle de la dernière entrée).
--   • CreateWindow({ Home = false }) masque Home · { ChangeLog = false } masque seulement les nouveautés · HomeName / HomeIcon.
--   • Réglages de Home sauvegardés automatiquement (flags « ui.home.* ») : notes, limite de session, météo, ville, temps de jeu total.
--   • Block:CreateStats({ Columns = 2, CellHeight = 48, Items = { { Id = "fps", Name = "FPS", Value = "--", Size = 16 }, ... } })
--       -> stats:Set("fps", "60", Color3 | nil) : grille de tuiles chiffrées, mise à jour par ton script.
--   • Block:CreateGraph({ Name, Height = 64, Samples = 90, Unit = " ms", MinMax = 100, Max = nil, Colored = false, ColorFn = function(v) return Color3 end })
--       (courbe lissée + aire en fondu, noir et blanc ; Colored = true + ColorFn redonne une couleur selon la valeur)
--       -> g:Push(valeur) (enregistre) · g:Flush() (redessine si besoin) · g:Clear()
-- ============================================================================
Library.Version = Library.Changelog[1] and Library.Changelog[1].Version or Library.Version

function Library:AddChangelog(version, notes, date, title)
	table.insert(Library.Changelog, 1, { Version = tostring(version), Date = date, Title = title or "Nouveautés",
		Notes = type(notes) == "table" and notes or { tostring(notes) } })
	Library.Version = tostring(version)
	local win = Library.Window
	if win and win._homeTab then pcall(Library._buildChangelog, Library, win._homeTab) end
end

-- (re)construit les blocs « Nouveautés » de Home à partir de Library.Changelog
function Library:_buildChangelog(tab)
	tab = tab or (Library.Window and Library.Window._homeTab)
	if not tab then return end
	tab = tab._changelogSub or tab   -- Home a des sous-onglets : les nouveautés vivent dans « Mises à jour »
	for _, b in ipairs(tab._logBlocks or {}) do
		if b.Frame then b.Frame:Destroy() end
		for i, x in ipairs(tab.Blocks) do
			if x == b then table.remove(tab.Blocks, i) break end
		end
	end
	tab._logBlocks = {}
	if Library.ShowChangelog == false then return end
	local list = Library.Changelog
	if Library.UpdateURL and Library.UpdateURL ~= "" and Library:_commitsURL() then
		if Library.Commits and #Library.Commits > 0 then
			list = Library.Commits
		elseif not Library.UpdateStatus.Error then   -- 1re vérification pas encore faite
			local b = tab:CreateBlock({ Name = "Nouveautés", Side = "Left" })
			b:CreateParagraph({ Title = "Chargement…", Content = "Récupération des mises à jour depuis GitHub." })
			tab._logBlocks[#tab._logBlocks + 1] = b
			return
		end
	end
	for i, e in ipairs(list) do
		local nm
		if e.Sha then
			nm = "Mise à jour  ·  " .. (e.Date or "") .. (e.Date and "  ·  " or "") .. "#" .. e.Sha .. (e.Pending and "  ·  NOUVEAU (à recharger)" or "")
		else
			nm = "Nouveautés v" .. tostring(e.Version) .. (e.Date and ("  ·  " .. e.Date) or "") .. (e.Pending and "  ·  NOUVEAU (à recharger)" or "")
		end
		local b = tab:CreateBlock({ Name = nm, Side = (i % 2 == 1) and "Left" or "Right", Collapsed = (i > 1 and not e.Pending) })
		if e.Sha then
			b:CreateParagraph({ Title = e.Title, Content = e.Body })
		else
			b:CreateParagraph({ Title = e.Title or "Nouveautés", Content = "• " .. table.concat(e.Notes or {}, "\n• ") })
		end
		tab._logBlocks[#tab._logBlocks + 1] = b
	end
end

-- ---------------------------------------------------------------------------
-- Nombre animé : s = Library._smoothNum(function(v) ... end, vitesse) ; s.Set(cible) ; s.Get()
-- La valeur affichée GLISSE vers la cible au lieu de sauter. La boucle ne tourne que pendant le glissement.
-- ---------------------------------------------------------------------------
function Library._smoothNum(apply, rate)
	rate = rate or 9
	local cur, target, conn
	local s = {}
	local function stop()
		if conn then
			conn:Disconnect()
			conn = nil
		end
	end
	local function step(dt)
		cur += (target - cur) * (1 - math.exp(-dt * rate))
		if math.abs(target - cur) < 0.004 then
			cur = target
			stop()
		end
		apply(cur)
	end
	function s.Set(v, instant)
		v = tonumber(v)
		if not v then return end
		target = v
		if cur == nil or instant or Library.Animations == false then
			cur = v
			stop()
			apply(cur)
			return
		end
		if not conn then conn = Ticker.connect(step) end
	end
	function s.Get() return cur end
	function s.Destroy() stop() end
	return s
end

-- ---------------------------------------------------------------------------
-- CHIFFRES EN ROULEAU : quand le texte d'un label change, seuls les caractères qui changent glissent et se fondent
-- (l'ancien part vers le haut / le bas selon que le chiffre monte ou descend, le nouveau arrive de l'autre côté).
-- Les autres caractères restent en place (ou glissent si la largeur change). Le vrai label devient transparent : son .Text
-- reste lisible par le reste du code. Texte trop long / sur plusieurs lignes : affichage normal. Changements très rapides
-- (compteurs, décomptes) : mise à jour directe pour rester net. Library.NumberRoll = false pour désactiver.
-- ---------------------------------------------------------------------------
Library.NumberRoll = true
function Library._uiScale(inst)
	local k, p = 1, inst
	while p do
		if p:IsA("GuiObject") or p:IsA("LayerCollector") then
			for _, ch in ipairs(p:GetChildren()) do
				if ch:IsA("UIScale") then k = k * ch.Scale end
			end
		end
		p = p.Parent
	end
	return math.max(k, 0.05)
end
function Library._rollText(lbl)
	if not lbl or Library.NumberRoll == false then return end
	local baseT = lbl.TextTransparency
	local host = Instance.new("Frame")
	host.Name = "RollHost"
	host.BackgroundTransparency = 1
	host.BorderSizePixel = 0
	host.Active = false
	host.Size = UDim2.fromScale(1, 1)
	host.ZIndex = lbl.ZIndex + 1
	host.Parent = lbl

	local cur, plain, last, lastT, ivl = {}, nil, nil, 0, nil   -- ivl = rythme moyen des changements (lissé)

	local function split(str)
		local t = {}
		local ok = pcall(function()
			for _, cp in utf8.codes(str) do t[#t + 1] = utf8.char(cp) end
		end)
		if not ok then
			t = {}
			for i = 1, #str do t[i] = string.sub(str, i, i) end
		end
		return t
	end

	local function mk(ch)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.BorderSizePixel = 0
		t.Active = false
		t.AnchorPoint = Vector2.new(0, 0.5)
		t.Size = UDim2.new(0, 0, 0, lbl.TextSize + 6)
		t.AutomaticSize = Enum.AutomaticSize.X
		t.Text = ch
		t.Font = lbl.Font
		t.TextSize = lbl.TextSize
		t.TextColor3 = lbl.TextColor3
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.TextYAlignment = Enum.TextYAlignment.Center
		t.ZIndex = host.ZIndex
		t.Parent = host
		return t
	end

	local function positions(chars)
		local text = table.concat(chars)
		local cw = host.AbsoluteSize.X / Library._uiScale(lbl)
		local total = measureText(text, lbl.TextSize, lbl.Font).X
		local x0 = 0
		local al = lbl.TextXAlignment
		if al == CENTER then x0 = (cw - total) / 2 elseif al == RIGHT then x0 = cw - total end
		local xs, acc = {}, ""
		for i, c in ipairs(chars) do
			xs[i] = x0 + (i > 1 and measureText(acc, lbl.TextSize, lbl.Font).X or 0)
			acc = acc .. c
		end
		return xs, total, cw
	end

	local function clearCur()
		for _, e in ipairs(cur) do e.l:Destroy() end
		cur = {}
	end
	local function setPlain(on)
		if plain == on then return end
		plain = on
		lbl.TextTransparency = on and baseT or 1
		host.Visible = not on
	end

	local function exitLabel(l, dy, anim, dur)
		if not anim then l:Destroy() return end
		local tw = tween(l, { TextTransparency = 1, Position = UDim2.new(0, l.Position.X.Offset, 0.5, dy) }, dur)
		tw.Completed:Connect(function() l:Destroy() end)
	end

	local function onText(force)
		local text = lbl.Text
		if text == last and not force then return end
		last = text
		local chars = split(text)
		local now = os.clock()
		-- vitesse adaptée au rythme des changements : lent = rouleau doux (jusqu'à 0,45 s), rapide = rouleau vif,
		-- très rapide (plusieurs changements par image) = mise à jour directe
		local gap = math.min(now - lastT, 2)
		lastT = now
		ivl = ivl and (ivl + (gap - ivl) * 0.5) or 0.5
		local fast = ivl < 0.04
		local dur = math.clamp(ivl * 0.85, 0.12, 0.45)
		local canAnim = Library.Animations ~= false and host.AbsoluteSize.X > 0 and #cur > 0 and not plain and not fast
		local xs, total, cw = positions(chars)
		if lbl.TextWrapped or string.find(text, "\n", 1, true) or (cw > 0 and total > cw + 1) then
			clearCur()
			setPlain(true)
			return
		end
		setPlain(false)
		local old = cur
		local out = {}
		local d = math.max(3, math.floor(lbl.TextSize * 0.55))
		local nOld, nNew = #old, #chars
		-- comparaison alignée sur la DROITE : les unités restent face aux unités quand le nombre de chiffres change
		for k = 0, math.max(nOld, nNew) - 1 do
			local oe = (nOld - k >= 1) and old[nOld - k] or nil
			local ni = nNew - k
			local nc = (ni >= 1) and chars[ni] or nil
			if oe and nc and oe.c == nc then
				out[ni] = oe
				local goal = UDim2.new(0, xs[ni], 0.5, 0)
				if canAnim then tween(oe.l, { Position = goal }, dur * 0.7) else oe.l.Position = goal end
			else
				local dir = 1
				if oe and nc then
					local a, b = tonumber(oe.c), tonumber(nc)
					if a and b and b < a then dir = -1 end
				end
				if oe then exitLabel(oe.l, -dir * d, canAnim, dur * 0.8) end
				if nc then
					local t = mk(nc)
					local goal = UDim2.new(0, xs[ni], 0.5, 0)
					if canAnim then
						t.TextTransparency = 1
						t.Position = UDim2.new(0, xs[ni], 0.5, dir * d)
						tween(t, { TextTransparency = 0, Position = goal }, dur)
					else
						t.Position = goal
					end
					out[ni] = { c = nc, l = t }
				end
			end
		end
		cur = out
	end

	local function relayout()
		if plain or #cur == 0 then return end
		local chars = {}
		for i, e in ipairs(cur) do chars[i] = e.c end
		local xs = positions(chars)
		for i, e in ipairs(cur) do e.l.Position = UDim2.new(0, xs[i], 0.5, 0) end
	end

	lbl:GetPropertyChangedSignal("Text"):Connect(function() onText(false) end)
	lbl:GetPropertyChangedSignal("TextColor3"):Connect(function()
		for _, e in ipairs(cur) do e.l.TextColor3 = lbl.TextColor3 end
	end)
	for _, pn in ipairs({ "Font", "TextSize" }) do
		lbl:GetPropertyChangedSignal(pn):Connect(function()
			clearCur()
			onText(true)
		end)
	end
	lbl:GetPropertyChangedSignal("TextXAlignment"):Connect(relayout)
	lbl:GetPropertyChangedSignal("TextWrapped"):Connect(function() onText(true) end)
	host:GetPropertyChangedSignal("AbsoluteSize"):Connect(Library._lazy(function()
		if plain then onText(true) else relayout() end
	end))
	lbl.TextTransparency = 1
	onText(true)
	task.defer(function() if lbl.Parent then onText(true) end end)
end

-- ---------------------------------------------------------------------------
-- Block:CreateStats : grille de tuiles « NOM / valeur »
-- ---------------------------------------------------------------------------
function Block:CreateStats(o)
	o = o or {}
	local list = o.Items or {}
	local cols = math.clamp(math.floor(tonumber(o.Columns) or 2), 1, 4)
	local cellH = math.clamp(tonumber(o.CellHeight) or 48, 32, 90)
	local rows = math.max(1, math.ceil(#list / cols))
	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, rows * cellH + (rows - 1) * 6), BackgroundTransparency = 1 }, self.Body)
	new("UIGridLayout", { CellSize = UDim2.new(1 / cols, -6 * (cols - 1) / cols, 0, cellH), CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = BYORDER, FillDirection = Enum.FillDirection.Horizontal }, holder)
	local cells, names = {}, {}
	for i, it in ipairs(list) do
		local c = new("Frame", { BackgroundColor3 = T.Element, BackgroundTransparency = 0.4, BorderSizePixel = 0, LayoutOrder = i }, holder)
		corner(c, 8)
		trackStyled(c, stroke(c, 0.93), "row")
		local nm = label(c, string.upper(tostring(it.Name or it.Id or "")), 10, { Position = UDim2.new(0, 10, 0, 6),
			Size = UDim2.new(1, -20, 0, 14), Font = F_BOLD, TextColor3 = T.ElementAccent })
		local val = label(c, tostring(it.Value or "—"), it.Size or o.ValueSize or 16, { Position = UDim2.new(0, 10, 0, 22),
			Size = UDim2.new(1, -20, 0, cellH - 26), Font = F_BOLD })
		Library._rollText(val)
		cells[it.Id or i] = { val = val, name = nm }
		names[#names + 1] = tostring(it.Name or it.Id or "")
	end
	self:_reg(holder, table.concat(names, " "))
	local item = {}
	item.Set = function(...)
		local id, v, col = unself(item, ...)
		local c = cells[id]
		if not c then return end
		if v ~= nil then c.val.Text = tostring(v) end
		c.val.TextColor3 = col or T.Text
	end
	item.SetName = function(...)
		local id, n = unself(item, ...)
		local c = cells[id]
		if c then c.name.Text = string.upper(tostring(n)) end
	end
	-- SetNumber(id, nombre, format, couleur) : la valeur affichée glisse vers le nombre (transition fluide, couleur comprise)
	item.SetNumber = function(...)
		local id, v, fmt, col = unself(item, ...)
		local c = cells[id]
		v = tonumber(v)
		if not c or not v then return end
		c.fmt = fmt
		-- plus de « compte à rebours » : le nouveau texte est posé tel quel, les chiffres qui changent roulent
		local txt = fmt and fmt(v) or tostring(math.floor(v + 0.5))
		if txt ~= c.val.Text then c.val.Text = txt end
		local target = col or T.Text
		if c.col ~= target then
			c.col = target
			tween(c.val, { TextColor3 = target }, 0.4)
		end
	end
	item.Instance = holder
	return item
end

-- ---------------------------------------------------------------------------
-- Block:CreateGraph : histogramme glissant (valeurs ajoutées avec :Push, redessiné avec :Flush)
-- ---------------------------------------------------------------------------
function Block:CreateGraph(o)
	o = o or {}
	local samples = math.clamp(math.floor(tonumber(o.Samples) or 90), 20, 240)
	local h = math.clamp(tonumber(o.Height) or 64, 36, 200)
	local unit = o.Unit and tostring(o.Unit) or ""
	local COLS = 120          -- points de la courbe (la courbe est lissée entre les mesures)
	local PADX, PADY = 7, 4   -- marges intérieures (la pointe de la courbe reste entièrement visible)
	local f = makeRow(self, h + 34, o.Name)
	label(f, o.Name or "Graphique", 12, { Position = UDim2.new(0, 12, 0, 4), Size = UDim2.new(0, 64, 0, 18), Font = F_BOLD })
	local infoL = label(f, "—", 11, { Position = UDim2.new(0, 78, 0, 4), Size = UDim2.new(1, -90, 0, 18),
		TextXAlignment = RIGHT, TextColor3 = T.ElementAccent, Font = F_REG })
	Library._rollText(infoL)
	local plot = new("Frame", { Position = UDim2.new(0, 10, 0, 26), Size = UDim2.new(1, -20, 0, h), BackgroundColor3 = T.Main,
		BackgroundTransparency = 0.55, BorderSizePixel = 0, ClipsDescendants = true }, f)
	corner(plot, 8)
	for _, y in ipairs({ 0.25, 0.5, 0.75 }) do
		new("Frame", { Position = UDim2.new(0, 0, y, 0), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.Accent,
			BackgroundTransparency = 0.94, BorderSizePixel = 0 }, plot)
	end
	local scaleL = label(plot, "", 10, { Position = UDim2.new(0, 8, 0, 3), Size = UDim2.new(0, 70, 0, 12),
		TextColor3 = T.ElementAccent, TextXAlignment = LEFT, ZIndex = 6 })
	scaleL.TextTransparency = 0.45

	-- aire sous la courbe (fondu vertical) + courbe tracée par de petits segments inclinés : noir et blanc, bords qui s'estompent
	local fills, segs = {}, {}
	for i = 1, COLS do
		local fadeFill = math.clamp((i - 1) / (COLS * 0.3), 0, 1)
		local c = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromOffset(0, h), Size = UDim2.fromOffset(2, 0),
			BorderSizePixel = 0, BackgroundColor3 = T.Accent, BackgroundTransparency = 1 - 0.3 * fadeFill, Visible = false, ZIndex = 2 }, plot)
		new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, c)
		fills[i] = c
		local fadeLine = math.clamp((i - 1) / (COLS * 0.18), 0, 1)
		segs[i] = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 2), BorderSizePixel = 0,
			BackgroundColor3 = T.Accent, BackgroundTransparency = math.max(0.02, 1 - fadeLine), Visible = false, ZIndex = 4 }, plot)
	end
	-- point lumineux en bout de courbe, avec une onde qui pulse
	local dot = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.Accent,
		BorderSizePixel = 0, ZIndex = 6, Visible = false }, plot)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
	local ring = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(8, 8), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 5, Visible = false }, plot)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, ring)
	local ringSt = new("UIStroke", { Color = T.Accent, Thickness = 1.5, Transparency = 0.5 }, ring)

	-- ------------------------------------------------------------ données
	local data = {}
	local lastPush, interval = nil, 0.5   -- intervalle moyen entre deux échantillons (mesuré)
	local topCur                          -- échelle verticale affichée (glisse vers sa cible)
	local tgt = { cur = 0, mn = 0, av = 0, mx = 0 }
	local vis = nil                       -- valeurs de la ligne d'info, animées vers tgt
	local colorCache, nCache = {}, 0
	local lastAcc, lastScaleTxt
	local px, py, okp = {}, {}, {}
	local item = {}

	item.Push = function(...)
		local v = tonumber((unself(item, ...)))
		if not v then return end
		local now = os.clock()
		if lastPush then
			local d = now - lastPush
			if d > 0.05 and d < 5 then interval += (d - interval) * 0.3 end
		end
		lastPush = now
		data[#data + 1] = v
		if #data > samples + 2 then table.remove(data, 1) end
		local n = #data
		local mx, mn, sum, cnt = -math.huge, math.huge, 0, 0
		for i = math.max(1, n - samples + 1), n do
			local x = data[i]
			mx, mn, sum, cnt = math.max(mx, x), math.min(mn, x), sum + x, cnt + 1
		end
		tgt.cur, tgt.mn, tgt.av, tgt.mx = v, mn, sum / cnt, mx
		if not vis then vis = { cur = v, mn = mn, av = sum / cnt, mx = mx } end
	end
	local function hideAll()
		for i = 1, COLS do fills[i].Visible = false segs[i].Visible = false end
		dot.Visible = false
		ring.Visible = false
	end
	item.Clear = function()
		data, lastPush, vis, topCur = {}, nil, nil, nil
		infoL.Text = "—"
		hideAll()
	end
	item.Flush = function() end   -- conservé pour compatibilité : le rendu est continu et automatique

	-- courbe lissée (Catmull-Rom) entre les échantillons ; idx flottant dans [1, n]
	local function sampleAt(idx)
		local n = #data
		local i1 = math.floor(idx)
		if i1 >= n then return data[n] end
		local t = idx - i1
		local p1, p2 = data[i1], data[i1 + 1]
		local p0 = data[math.max(i1 - 1, 1)]
		local p3 = data[math.min(i1 + 2, n)]
		local t2, t3 = t * t, t * t * t
		return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
	end

	-- noir et blanc par défaut ; { Colored = true, ColorFn = ... } redonne une couleur selon la valeur
	local function colorFor(v)
		if not (o.Colored and o.ColorFn) then return T.Accent end
		local key = math.floor(v + 0.5)
		local c = colorCache[key]
		if c == nil then
			local ok, col = pcall(o.ColorFn, key)
			c = (ok and typeof(col) == "Color3") and col or T.Accent
			if nCache > 400 then colorCache, nCache = {}, 0 end
			colorCache[key] = c
			nCache += 1
		end
		return c
	end

	-- ------------------------------------------------------------ rendu continu
	local function render(dt)
		local n = #data
		local anim = Library.Animations ~= false
		if vis then   -- les chiffres glissent vers leur valeur au lieu de sauter
			local k = anim and (1 - math.exp(-dt * 8)) or 1
			vis.cur += (tgt.cur - vis.cur) * k
			vis.mn += (tgt.mn - vis.mn) * k
			vis.av += (tgt.av - vis.av) * k
			vis.mx += (tgt.mx - vis.mx) * k
			local function r(x) return math.floor(x + 0.5) end
			local txt = string.format("%d%s  ·  min %d  ·  moy %d  ·  max %d", r(tgt.cur), unit, r(tgt.mn), r(tgt.av), r(tgt.mx))
			if txt ~= infoL.Text then infoL.Text = txt end
		end
		if n < 2 then return end
		local topT = tonumber(o.Max) or math.max(tgt.mx * 1.15, tonumber(o.MinMax) or 1)
		if not topCur then topCur = topT end
		topCur += (topT - topCur) * (anim and (1 - math.exp(-dt * 5)) or 1)

		local sc = plot.AbsoluteSize.Y / h
		if sc <= 0 then return end
		local W = plot.AbsoluteSize.X / sc
		local usableW = math.max(W - PADX * 2, 10)

		-- couleur (suit le thème en direct)
		local acc = colorFor(tgt.cur)
		if acc ~= lastAcc then
			lastAcc = acc
			for i = 1, COLS do fills[i].BackgroundColor3 = acc segs[i].BackgroundColor3 = acc end
			dot.BackgroundColor3 = acc
			ringSt.Color = acc
		end
		local st = string.format("%d%s", math.floor(topCur + 0.5), unit)
		if st ~= lastScaleTxt then lastScaleTxt = st scaleL.Text = st end

		-- défilement continu : la tête de courbe avance d'un échantillon pendant l'intervalle entre deux mesures
		local offset = anim and math.clamp(1 - (os.clock() - lastPush) / interval, 0, 1) or 0
		local head = n - offset
		local span = samples - 1
		for i = 0, COLS do
			local idx = head - (1 - i / COLS) * span
			if idx < 1 then
				okp[i] = false
			else
				local v = sampleAt(idx)
				okp[i] = true
				px[i] = PADX + (i / COLS) * usableW
				py[i] = h - PADY - math.clamp(v / topCur, 0.02, 1) * (h - PADY * 2)
			end
		end
		for i = 1, COLS do
			local sg, fl = segs[i], fills[i]
			if okp[i - 1] and okp[i] then
				local x0, y0, x1, y1 = px[i - 1], py[i - 1], px[i], py[i]
				local dx, dy = x1 - x0, y1 - y0
				sg.Visible = true
				sg.Position = UDim2.fromOffset((x0 + x1) / 2, (y0 + y1) / 2)
				sg.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 1.2, 2)
				sg.Rotation = math.deg(math.atan2(dy, dx))
				fl.Visible = true
				fl.Position = UDim2.fromOffset(x0, h)
				fl.Size = UDim2.fromOffset(dx + 1, math.max(h - (y0 + y1) / 2, 1))
			else
				if sg.Visible then sg.Visible = false end
				if fl.Visible then fl.Visible = false end
			end
		end
		if okp[COLS] then
			dot.Visible, ring.Visible = true, true
			dot.Position = UDim2.fromOffset(px[COLS], py[COLS])
			ring.Position = dot.Position
			local ph = (os.clock() * 0.9) % 1
			local d = 8 + 16 * ph
			ring.Size = UDim2.fromOffset(d, d)
			ringSt.Transparency = 0.35 + 0.65 * ph
		end
	end

	local conn = Ticker.connect(function(dt)
		render(math.min(dt, 0.25))
	end, { rate = 60, gate = plot })   -- dort tant que le graphique n'est pas affiché
	track(conn)
	plot.Destroying:Connect(function() pcall(function() conn:Disconnect() end) end)

	item.Instance = f
	return item
end

