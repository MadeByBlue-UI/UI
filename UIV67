local function lighten(c, a) return c:Lerp(Color3.new(1, 1, 1), a) end

local T = {
	Main          = Color3.fromRGB(0, 0, 0),
	Second        = Color3.fromRGB(7, 7, 9),
	Accent        = Color3.fromRGB(255, 255, 255),
	ElementAccent = Color3.fromRGB(165, 165, 172),
	Text          = Color3.fromRGB(245, 245, 247),
	GradientStart = Color3.fromRGB(255, 255, 255),
	GradientEnd   = Color3.fromRGB(125, 125, 135),
}
local function refreshTheme()
	T.Element = lighten(T.Second, 0.07)
	T.Off     = lighten(T.Second, 0.20)
	T.Panel   = lighten(T.Second, 0.03)
end
refreshTheme()

-- Raccourcis
