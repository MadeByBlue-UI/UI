local Conns = {}
local function track(c) Conns[#Conns + 1] = c return c end

local TEXTCLASS = { TextLabel = true, TextButton = true, TextBox = true }

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if TEXTCLASS[class] then
		-- taille de base mémorisée : permet la « taille de police globale »
		o:SetAttribute("BaseSize", o.TextSize)
		local role = (o.Font == F_BOLD and 3) or (o.Font == F_MED and 2) or 1
		o:SetAttribute("FontRole", role)
		if Library.Fonts then o.Font = Library.Fonts[role] end
		if Library.FontScale ~= 1 then
			o.TextSize = math.max(8, math.floor(o.TextSize * Library.FontScale + 0.5))
		end
	end
	if parent then o.Parent = parent end
	return o
end

-- TweenInfo mis en cache (évite d'en recréer des centaines) + multiplicateur de vitesse / mode sans animation
local tweenInfoCache = {}
local function tween(o, props, t, style, dir)
	t = t or 0.25
	style = style or QUINT
	dir = dir or OUT
	if not Library.Animations then
		t = 0
	else
		t = t / math.max(Library.AnimSpeed or 1, 0.05)
	end
	local key = tostring(t) .. "|" .. tostring(style) .. "|" .. tostring(dir)
	local info = tweenInfoCache[key]
	if not info then
		info = TweenInfo.new(t, style, dir)
		tweenInfoCache[key] = info
	end
	local tw = TweenService:Create(o, info, props)
	tw:Play()
	return tw
end

local function corner(parent, base)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, math.floor(base * Library.GlobalCornerValue / 10))
	c.Parent = parent
	table.insert(Library.CornerObjects, { Corner = c, BaseRadius = base })
	return c
end

local function stroke(parent, transparency, thickness)
	return new("UIStroke", {
		Color = T.Accent, Transparency = transparency or 0.9, Thickness = thickness or 1,
		ApplyStrokeMode = BORDER,
	}, parent)
end

-- Registre des éléments qui changent d'apparence avec le style (lignes, blocs, tiroirs, champs)
local STYLE_KIND = {
	row   = { "RowTr", "StrokeTr" },
	block = { "BlockTr", "BlockStroke" },
	panel = { "PanelTr", "PanelStroke" },
	input = { "InputTr", "InputStroke" },
}
-- reflet de verre sur les bordures : lumineuse en haut à gauche, qui s'éteint vers le bas à droite
local GLASS_EDGE = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.45, 0.5),
	NumberSequenceKeypoint.new(1, 0.82),
})
local styled, stylePrune = {}, 300

local function styleOne(e)
	local inst, st = e.inst, e.st
	if not (inst and inst.Parent) then return false end
	local k = STYLE_KIND[e.kind]
	inst.BackgroundTransparency = Sty[k[1]]
	if st then
		st.Transparency = Sty[k[2]]
		local g = st:FindFirstChild("GlassGrad")
		if Sty.Glass then
			if not g then
				g = Instance.new("UIGradient")
				g.Name = "GlassGrad"
				g.Rotation = 40
				g.Transparency = GLASS_EDGE
				g.Parent = st
			end
			g.Enabled = true
		elseif g then
			g.Enabled = false
		end
	end
	return true
end

local function trackStyled(inst, st, kind)
	local e = { inst = inst, st = st, kind = kind }
	styled[#styled + 1] = e
	styleOne(e)
	if #styled >= stylePrune then
		local keep = {}
		for _, x in ipairs(styled) do
			if x.inst and x.inst.Parent then keep[#keep + 1] = x end
		end
		styled = keep
		stylePrune = #styled + 300
	end
end

local function label(parent, text, size, props)
	local p = {
		BackgroundTransparency = 1, Text = tostring(text), TextColor3 = T.Text, TextSize = size or 13,
		Font = F_MED, TextXAlignment = LEFT,
		TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 1, 0),
	}
	for k, v in pairs(props or {}) do p[k] = v end
	return new("TextLabel", p, parent)
end

-- Appelle un callback sans jamais casser l'UI
local function fire(cb, ...)
	if type(cb) ~= "function" then return end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(cb, table.unpack(args, 1, args.n))
		if not ok then warn("[Ui-Lib] Callback : " .. tostring(err)) end
	end)
end

-- Permet d'appeler item.Set(v) ET item:Set(v)
local function unself(self, ...)
	if (...) == self then return select(2, ...) end
	return ...
end

local function copyVal(v)
	if type(v) ~= "table" then return v end
	local c = {}
	for k, x in pairs(v) do c[k] = copyVal(x) end
	return c
end

local function register(flag, item, value)
	if flag then
		Library.Flags[flag] = value
		Library.Items[flag] = item
		Library.Defaults[flag] = copyVal(value)
	end
end

local function mount(gui)
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(gui)
		elseif protectgui then protectgui(gui) end
	end)
	local ok = pcall(function() gui.Parent = CoreGui end)
	if not ok or not gui.Parent then
		gui.Parent = LP:WaitForChild("PlayerGui")
	end
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function guiInset()
	local ok, v = pcall(function() return GuiService:GetGuiInset() end)
	return ok and v or Vector2.new(0, 0)
end

local function viewport()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if v.X < 100 or v.Y < 100 then v = Vector2.new(1280, 720) end
	return v
end

-- Échelle réelle de la fenêtre (UIScale + animation), pour convertir pixels écran <-> pixels UI
local function pxScale()
	local win = Library.Window
	local m = win and win.Main
	if m and m.Size.X.Offset > 0 and m.AbsoluteSize.X > 0 then
		return m.AbsoluteSize.X / m.Size.X.Offset
	end
	return 1
end

-- Gestion centralisée du glisser (sliders, color picker, déplacement de la fenêtre)
local activeDrag, activeEnd, dragScroll
local function startDrag(fn, scroll, pos, onEnd)
	activeDrag, activeEnd = fn, onEnd
	if scroll then dragScroll = scroll scroll.ScrollingEnabled = false end
	fn(pos)
end
track(UIS.InputChanged:Connect(function(i)
	if activeDrag and (i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch) then
		activeDrag(i.Position)
	end
end))
track(UIS.InputEnded:Connect(function(i)
