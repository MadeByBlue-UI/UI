--  Theme manager
-- ════════════════════════════════════════════════════════════════════════

local ThemeManager = {
    Folder = "SingularitySettings",
    Library = Library,
    Applying = false,
    CustomThemes = {},
}

function ThemeManager:SetLibrary(library)
    self.Library = library
end

function ThemeManager:SetFolder(folder)
    self.Folder = folder
    self:BuildFolderTree()
end

function ThemeManager:BuildFolderTree()
    if not FileSystemAvailable() then
        return
    end
    local paths = {
        self.Folder,
        self.Folder .. "/themes",
    }
    for _, path in ipairs(paths) do
        pcall(function()
            if not FS.isfolder(path) then
                FS.makefolder(path)
            end
        end)
    end
end

function ThemeManager:ThemeToTable(theme)
    local out = {}
    for _, key in ipairs(Library.ThemeKeys) do
        local color = theme[key]
        if color then
            out[key] = Library:ColorToHex(color)
        end
    end
    return out
end

function ThemeManager:TableToTheme(data)
    local theme = {}
    for key, hex in pairs(data) do
        local color = Library:HexToColor(hex)
        if color then
            theme[key] = color
        end
    end
    return theme
end

function ThemeManager:UpdatePickers()
    self.Applying = true
    for _, key in ipairs(Library.ThemeKeys) do
        local picker = Library.Options["ThemeManager_" .. key]
        if picker then
            picker:SetValueRGB(Library.Theme[key])
        end
    end
    self.Applying = false
end

function ThemeManager:ApplyTheme(name)
    local preset = Library.ThemePresets[name] or self.CustomThemes[name]
    if not preset then
        return false
    end
    Library:SetTheme(preset)
    self:UpdatePickers()
    return true
end

function ThemeManager:GetCustomThemeNames()
    local names = {}
    if not FileSystemAvailable() then
        return names
    end
    local ok, files = pcall(FS.listfiles, self.Folder .. "/themes")
    if not ok then
        return names
    end
    for _, file in ipairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then
            table.insert(names, name)
        end
    end
    table.sort(names)
    return names
end

function ThemeManager:LoadCustomTheme(name)
    if not FileSystemAvailable() then
        return false
    end
    local path = self.Folder .. "/themes/" .. name .. ".json"
    local ok, contents = pcall(function()
        if FS.isfile(path) then
            return FS.readfile(path)
        end
    end)
    if not ok or not contents then
        return false
    end
    local decoded
    ok, decoded = pcall(HttpService.JSONDecode, HttpService, contents)
    if not ok or type(decoded) ~= "table" then
        return false
    end
    self.CustomThemes[name] = self:TableToTheme(decoded)
    return self:ApplyTheme(name)
end

function ThemeManager:SaveCustomTheme(name)
    if not FileSystemAvailable() then
        Library:Notify({ Title = "Themes", Description = "File system is not available.", Type = "Error" })
        return false
    end
    name = Library:Trim(name or "")
    if name == "" then
        Library:Notify({ Title = "Themes", Description = "Enter a theme name first.", Type = "Warning" })
        return false
    end
    self:BuildFolderTree()
    local encoded = HttpService:JSONEncode(self:ThemeToTable(Library.Theme))
    local ok = pcall(FS.writefile, self.Folder .. "/themes/" .. name .. ".json", encoded)
    if ok then
        Library:Notify({ Title = "Themes", Description = "Saved theme <b>" .. name .. "</b>.", Type = "Success" })
    end
    return ok
end

function ThemeManager:SaveDefault(name)
    if not FileSystemAvailable() then
        return
    end
    self:BuildFolderTree()
    pcall(FS.writefile, self.Folder .. "/themes/default.txt", name)
end

function ThemeManager:LoadDefault()
    if not FileSystemAvailable() then
        return
    end
    local path = self.Folder .. "/themes/default.txt"
    local ok, name = pcall(function()
        if FS.isfile(path) then
            return FS.readfile(path)
        end
    end)
    if ok and name and name ~= "" then
        if not self:ApplyTheme(name) then
            self:LoadCustomTheme(name)
        end
    end
end

