function Library:AddCorner(parent, radius)
    return self:Create("UICorner", {
        CornerRadius = UDim.new(0, radius or self.CornerRadius),
        Parent = parent,
    })
end

function Library:AddStroke(parent, colorKey, thickness, transparency)
    local props = {
