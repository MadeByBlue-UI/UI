	local parts = { search, sidebar, vline, content, footer }
	setMinimized = function(v)
		v = v and true or false
		if v == collapsed then return end
		collapsed = v
		local sz = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
		curSize, lastSize, rsDir, rsSmooth = sz, sz, Vector2.new(0, 1), true
		if v then
			preSize = sz
			tgtSize = Vector2.new(sz.X, 44)
			task.delay(0.35, function()
				if collapsed then for _, p in ipairs(parts) do p.Visible = false end end
			end)
		else
			for _, p in ipairs(parts) do p.Visible = true end
			tgtSize = preSize or Vector2.new(W0, H0)
		end
		for _, h in ipairs(handles) do h.Visible = not v end
		Library._busyUntil = os.clock() + 0.6
		task.delay(0.7, saveWin)
	end

	local function evenSize(n) return math.floor(n / 2 + 0.5) * 2 end

	function win:ApplyLayout(d)
		if collapsed then
			collapsed = false
			for _, p in ipairs(parts) do p.Visible = true end
			for _, h in ipairs(handles) do h.Visible = true end
		end
		local v = viewport()
		local nw = evenSize(math.clamp(tonumber(d.w) or W0, minW, math.max(minW, v.X / scaleBase - 10)))
		local nh = evenSize(math.clamp(tonumber(d.h) or H0, minH, math.max(minH, v.Y / scaleBase - 10)))
		tgtSize, tgtPos = nil, nil
		main.Size = UDim2.fromOffset(nw, nh)
		lastSize, curSize = Vector2.new(nw, nh), Vector2.new(nw, nh)
		curPos = clampCenter(Vector2.new((tonumber(d.cx) or 0.5) * v.X, (tonumber(d.cy) or 0.5) * v.Y))
		setMainPos()
		saveWin()
	end

	function win:Reset()
		if collapsed then setMinimized(false) end
		local v = viewport()
		curSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
		lastSize = curSize
		rsDir, rsSmooth = Vector2.new(0, 0), true
		tgtSize = Vector2.new(math.max(minW, math.min(W0, v.X / scaleBase - 16)), math.min(H0, v.Y / scaleBase - 16))
		tgtPos = clampCenter(v / 2)
		Library._busyUntil = os.clock() + 0.8
		task.delay(0.9, saveWin)
	end

	-- ------------------------------------------------------------------
	-- Colonnes de blocs (1 à 4) : la fenêtre s'agrandit toute seule si elle est trop étroite
	-- ------------------------------------------------------------------
	local COL_GAP, SIDE_PAD = 10, 156
	local baseMinW = minW
	local function reqWidth(n) return n * (Library.ColumnMinWidth or 255) + (n - 1) * COL_GAP + SIDE_PAD end
	local function fitCols(n)   -- réduit si l'écran est trop petit pour n colonnes
		local avail = viewport().X / scaleBase - 10
		while n > 1 and reqWidth(n) > avail do n = n - 1 end
		return n
	end

	function win:SetColumns(n)
		n = math.clamp(math.floor(tonumber(n) or 1), 1, 4)
		local oldEff = win.EffCols
		win.Columns, Library.Columns = n, n
		local eff = fitCols(n)
		win.EffCols, win.TwoCols = eff, eff >= 2
		minW = math.max(baseMinW, reqWidth(eff))

		local curW = (collapsed and preSize) and preSize.X or main.Size.X.Offset
		if curW < minW then
			local nw = evenSize(minW)
			if collapsed and preSize then
				preSize = Vector2.new(nw, preSize.Y)
			else
				local h = main.Size.Y.Offset
				curSize = Vector2.new(main.Size.X.Offset, h)
				lastSize = curSize
				rsDir, rsSmooth = Vector2.new(0, 0), true
				tgtSize = Vector2.new(nw, h)
				local v = viewport()
				local half = nw * scaleBase / 2
				local lo = half + 8
				tgtPos = Vector2.new(math.clamp(curPos.X, lo, math.max(lo, v.X - half - 8)), curPos.Y)
				Library._busyUntil = os.clock() + 0.8
				task.delay(0.9, saveWin)
			end
		end

		for _, t in ipairs(win.Tabs) do t:SetColumns(eff) end

		if oldEff and oldEff ~= eff and win.Veil and not collapsed then
			win.VeilToken = (win.VeilToken or 0) + 1
			local my = win.VeilToken
			win.Veil.Visible = true
			win.Veil.BackgroundTransparency = Sty.VeilTr
			local tw = tween(win.Veil, { BackgroundTransparency = 1 }, 0.42)
			tw.Completed:Connect(function()
				if win.VeilToken == my then win.Veil.Visible = false end
			end)
		end
		return eff
	end
	function win:GetColumns() return win.Columns, win.EffCols end

	-- état initial (même comportement qu'avant par défaut : 2 colonnes si la fenêtre est assez large)
	win.Columns = math.clamp(math.floor(tonumber(cfg.Columns or Library.Columns) or (contentW >= 520 and 2 or 1)), 1, 4)
	Library.Columns = win.Columns
	win.EffCols = fitCols(win.Columns)
	win.TwoCols = win.EffCols >= 2
	minW = math.max(baseMinW, reqWidth(win.EffCols))
	if main.Size.X.Offset < minW then
		local nw, h = evenSize(minW), main.Size.Y.Offset
		main.Size = UDim2.fromOffset(nw, h)
		curSize, lastSize = Vector2.new(nw, h), Vector2.new(nw, h)
		W0 = math.max(W0, nw)
		local c2 = clampCenter(curPos)
		if c2 ~= curPos then curPos = c2; setMainPos() end
	end

