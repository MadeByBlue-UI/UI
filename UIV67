--- Call `callback(point)` while the user presses / drags on `frame`.
--- Works with mouse and touch, keeps tracking outside the frame.
function Library:BindDrag(frame, callback, onBegin, onEnd)
    frame.InputBegan:Connect(function(input)
        if not self:IsClick(input) then
            return
        end
        local active = true
        if onBegin then
            onBegin()
        end
        callback(self:GetInputPosition(input))

        local endConnection, moveConnection
        local function finish()
            if not active then
                return
            end
            active = false
            if endConnection then
                endConnection:Disconnect()
            end
            if moveConnection then
                moveConnection:Disconnect()
            end
            if onEnd then
                onEnd()
            end
        end

        endConnection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                finish()
            end
        end)

        moveConnection = UserInputService.InputChanged:Connect(function(changed)
            if not active then
                return
            end
            local isMouse = changed.UserInputType == Enum.UserInputType.MouseMovement
                and input.UserInputType == Enum.UserInputType.MouseButton1
            if changed == input or isMouse then
                callback(self:GetInputPosition(changed))
            end
        end)

        self.Maid:Give(moveConnection)
    end)
end

--- Position of `point` inside `frame` as 0-1 ratios.
function Library:GetRatio(frame, point)
    local position = frame.AbsolutePosition
    local size = frame.AbsoluteSize
    local x = size.X > 0 and (point.X - position.X) / size.X or 0
    local y = size.Y > 0 and (point.Y - position.Y) / size.Y or 0
    return math.clamp(x, 0, 1), math.clamp(y, 0, 1)
end

--- Visibility controller. Combines user visibility, dependency visibility
--- and search visibility into holder.Visible.
function Library:MakeVisibilityController(element, holder)
    element.Holder = holder
    element.UserVisible = true
    element.DependencyVisible = true
    element.SearchVisible = true

    function element:UpdateVisibility()
        local visible = self.UserVisible and self.DependencyVisible and self.SearchVisible
        if self.Holder.Visible ~= visible then
            self.Holder.Visible = visible
        end
        if self.Container and self.Container.Parent then
            -- groupboxes recompute their own visibility via the search system
        end
    end

    function element:SetVisible(visible)
        self.UserVisible = visible
        self:UpdateVisibility()
    end

    function element:GetVisible()
        return self.UserVisible
    end

    function element:SetDependencyVisible(visible)
        self.DependencyVisible = visible
        self:UpdateVisibility()
    end

    function element:SetSearchVisible(visible)
        self.SearchVisible = visible
        self:UpdateVisibility()
    end
end

--- Register an element for the window search box.
function Library:RegisterSearch(element, text, owner)
    if not text or text == "" then
        return
    end
    local entry = {
        Element = element,
        Text = string.lower(text),
        Display = text,
        Owner = owner,
    }
    table.insert(self.SearchRegistry, entry)
    element.SearchEntry = entry
    if owner and owner.Tab then
        owner.Tab.SearchEntries = owner.Tab.SearchEntries or {}
        table.insert(owner.Tab.SearchEntries, entry)
    end
    return entry
end

--- Hover / press feedback for button-like frames.
function Library:ApplyHover(button, target, normalKey, hoverKey)
    target = target or button
    local property = target:IsA("TextButton") and "BackgroundColor3" or "BackgroundColor3"

    local function normalColor()
        return self.Theme[normalKey or "MainColor"]
    end

    local function hoverColor()
        if hoverKey then
            return self.Theme[hoverKey]
        end
        return self:Lighten(normalColor(), 0.08)
    end

    button.MouseEnter:Connect(function()
        self:Tween(target, { [property] = hoverColor() }, self.FastTweenInfo)
    end)
    button.MouseLeave:Connect(function()
        self:Tween(target, { [property] = normalColor() }, self.FastTweenInfo)
    end)
end

