	local function attachResize(h, dx, dy)
		handles[#handles + 1] = h
		h.InputBegan:Connect(function(i)
			if not isPress(i) or collapsed or Library.LockPosition then return end
			-- Une animation (dépliage, reset, colonnes) est encore en cours : on la termine d'abord, avec sa
			-- propre direction, pour partir de la vraie taille et non d'une taille intermédiaire.
			if tgtSize and rsSmooth then
				applySize(tgtSize)
				curSize, tgtSize = lastSize, nil
			end
			if tgtPos then curPos, tgtPos = tgtPos, nil end
			setMainPos()
			local start = Vector2.new(i.Position.X, i.Position.Y)
			local sw, sh = main.Size.X.Offset, main.Size.Y.Offset
			local sc = scaleBase
			tgtPos = nil
			curSize = Vector2.new(sw, sh)
			lastSize = curSize
			tgtSize = nil
			rsDir = Vector2.new(dx, dy)
			-- la taille suit le curseur avec un lissage court : la fenêtre et son contenu (colonnes, textes, graphiques)
			-- se redimensionnent en continu, image par image, au lieu de sauter d'un cran à l'autre
			Library._resizing = true   -- allège le fond animé et les mises en page de texte pendant le geste
			if Library.ResizeMode ~= "Direct" then
				-- MODE « CONTOUR » (défaut) : pendant le geste, la vraie fenêtre ne bouge pas (aucun recalcul des colonnes,
				-- blocs, textes...). Seul un contour léger suit le curseur ; la taille réelle est appliquée UNE fois au relâchement.
				rsSmooth = false
				local startPos = curPos
				Library._rsTok = (Library._rsTok or 0) + 1   -- invalide la fin différée d'un geste précédent
				local outline = new("Frame", { Name = "ResizeOutline", AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.93, BorderSizePixel = 0,
					ZIndex = 900, Active = false }, gui)
				new("UICorner", { CornerRadius = UDim.new(0, 14) }, outline)
				local outStroke = new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1.5, Transparency = 0.25 }, outline)
				local final
				local function place(p)
					local d = (Vector2.new(p.X, p.Y) - start) / sc
					local v = viewport()
					local ns = Vector2.new(
						dx == 0 and sw or math.clamp(sw + d.X * dx, minW, math.max(minW, v.X / sc - 10)),
						dy == 0 and sh or math.clamp(sh + d.Y * dy, minH, math.max(minH, v.Y / sc - 10))
					)
					ns = Vector2.new(math.floor(ns.X / 2 + 0.5) * 2, math.floor(ns.Y / 2 + 0.5) * 2)
					final = ns
					local c = startPos + (ns - Vector2.new(sw, sh)) * scaleBase * rsDir / 2
					outline.Position = UDim2.fromOffset(math.floor(c.X + 0.5), math.floor(c.Y + 0.5))
					outline.Size = UDim2.fromOffset(ns.X * scaleBase, ns.Y * scaleBase)
				end
				startDrag(place, nil, i.Position, function()
					-- relâchement : la fenêtre GLISSE vers la nouvelle taille (lissage de la boucle) pendant que le contour s'efface
					local tok = Library._rsTok
					if final and final ~= Vector2.new(sw, sh) then
						rsSmooth = Library.Animations and true or false
						curSize, tgtSize = Vector2.new(sw, sh), final
						tween(outline, { BackgroundTransparency = 1 }, 0.3)
						tween(outStroke, { Transparency = 1 }, 0.3)
						task.delay(0.35, function() outline:Destroy() end)
						-- _resizing reste vrai pendant la transition : le fond animé est en pause et la mise en page est limitée à ~30 Hz
						task.delay(0.7, function()
							if Library._rsTok == tok then Library._resizing = false end
						end)
					else
						outline:Destroy()
						Library._resizing = false
					end
					saveWinLater()
				end)
				return
			end
			rsSmooth = Library.Animations and true or false
			startDrag(function(p)
				local d = (Vector2.new(p.X, p.Y) - start) / sc
				local v = viewport()
				tgtSize = Vector2.new(
					dx == 0 and sw or math.clamp(sw + d.X * dx, minW, math.max(minW, v.X / sc - 10)),
					dy == 0 and sh or math.clamp(sh + d.Y * dy, minH, math.max(minH, v.Y / sc - 10))
				)
			end, nil, i.Position, function() Library._resizing = false saveWinLater() end)
		end)
	end

