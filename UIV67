local TEXT_CLASSES = { TextLabel = true, TextButton = true, TextBox = true }

function Library:GetClassDefaults(class)
    if TEXT_CLASSES[class] then
        return {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Font = self.Font,
            TextSize = self.TextSize,
            TextColor3 = self.Theme.FontColor,
        }
    elseif class == "Frame" then
        return { BorderSizePixel = 0 }
    elseif class == "ScrollingFrame" then
        return {
            BorderSizePixel = 0,
            BackgroundTransparency = 1,
            ScrollBarThickness = 0,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
        }
    elseif class == "ImageLabel" or class == "ImageButton" then
        return {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
        }
    elseif class == "UIListLayout" then
        return { SortOrder = Enum.SortOrder.LayoutOrder }
    end
    return nil
end

--- Create an instance. Keys that start with "@" bind a property to a theme key:
---     Library:Create("Frame", { ["@BackgroundColor3"] = "MainColor" })
--- The value can also be a function(theme) -> value for derived colors.
function Library:Create(class, props, children)
    local inst = Instance.new(class)
    local defaults = self:GetClassDefaults(class)
    if defaults then
        for key, value in pairs(defaults) do
            inst[key] = value
        end
    end

    local binds, parent
    if props then
        for key, value in pairs(props) do
            if key == "Parent" then
                parent = value
            elseif type(key) == "string" and key:sub(1, 1) == "@" then
                binds = binds or {}
                binds[key:sub(2)] = value
            else
                inst[key] = value
            end
        end
    end

    if children then
        for _, child in ipairs(children) do
            child.Parent = inst
        end
    end

    if TEXT_CLASSES[class] then
        self.TextObjects[inst] = true
    end
    if class == "TextButton" or class == "ImageButton" then
        inst.AutoButtonColor = false
    end

    if binds then
        self:Bind(inst, binds)
    end

    if parent then
        inst.Parent = parent
    end

    return inst
end

function Library:Bind(inst, map)
    local entry = self.Registry[inst]
    if not entry then
        entry = {}
        self.Registry[inst] = entry
    end
    for prop, key in pairs(map) do
        entry[prop] = key
        local value
        if type(key) == "function" then
            value = key(self.Theme)
        else
            value = self.Theme[key]
        end
        if value ~= nil then
            pcall(function()
                inst[prop] = value
            end)
        end
    end
end

function Library:Unbind(inst)
    self.Registry[inst] = nil
end

function Library:UpdateTheme()
    for inst, map in pairs(self.Registry) do
        if inst.Parent == nil and not inst:IsDescendantOf(game) then
            self.Registry[inst] = nil
        else
            for prop, key in pairs(map) do
                local value
                if type(key) == "function" then
                    value = key(self.Theme)
                else
                    value = self.Theme[key]
                end
                if value ~= nil then
                    pcall(function()
                        inst[prop] = value
                    end)
                end
            end
        end
    end
    if self.ThemeChanged then
        self.ThemeChanged:Fire(self.Theme)
    end
end

function Library:SetTheme(theme)
    if type(theme) == "string" then
        theme = self.ThemePresets[theme]
    end
    if type(theme) ~= "table" then
        return
    end
    for key, value in pairs(theme) do
        if typeof(value) == "Color3" then
            self.Theme[key] = value
        end
    end
    self:UpdateTheme()
end

Library.ThemeChanged = Signal.new()

function Library:SetFont(font)
    self.Font = font
    for inst in pairs(self.TextObjects) do
        if inst.Parent then
            inst.Font = font
        end
    end
end

function Library:SetTextSize(size)
    local delta = size - self.TextSize
    self.TextSize = size
    for inst in pairs(self.TextObjects) do
        if inst.Parent then
            inst.TextSize = math.max(8, inst.TextSize + delta)
        end
    end
end

