	-- ------------------------------------------------------------------
	-- Aura : contour ondulant (des vagues voyagent autour de la fenêtre).
	-- Créée AVANT la fenêtre = dessinée derrière. Chaque côté est un cadre qui coupe ce qui dépasse :
	-- seules les bosses extérieures (calottes de cercles) restent visibles.
	-- ------------------------------------------------------------------
	local waveT, waveIntro = 0, 0
	local auraFillTr = math.min(transp, 0.3)
	local aura = new("Frame", { Name = "Aura", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(W, H),
		Position = UDim2.fromOffset(center.X, center.Y), BackgroundTransparency = 1, BorderSizePixel = 0 }, gui)
	local auraScale = new("UIScale", { Scale = 1 }, aura)
	local STRIP, PILL, SPACING, WAVELEN = 22, 44, 22, 130
	local auraEdges = {}
	for ei = 1, 4 do
		auraEdges[ei] = { fill = {}, line = {},
			strip = new("Frame", { BackgroundTransparency = 1, ClipsDescendants = true, BorderSizePixel = 0 }, aura) }
	end
	local function addAuraPill(e)
		local line = new("Frame", { BackgroundColor3 = T.Accent, BackgroundTransparency = 0.5, BorderSizePixel = 0,
			Size = UDim2.fromOffset(PILL + 3, PILL + 3), ZIndex = 1, Visible = false }, e.strip)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, line)
		local fill = new("Frame", { BackgroundColor3 = T.Main, BackgroundTransparency = auraFillTr, BorderSizePixel = 0,
			Size = UDim2.fromOffset(PILL, PILL), ZIndex = 2, Visible = false }, e.strip)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
		e.line[#e.line + 1] = line
		e.fill[#e.fill + 1] = fill
	end
	local auraGeom = ""
	local function updateAura(w, h, r, amp)
		local lenH, lenV = math.max(w - 2 * r, 0), math.max(h - 2 * r, 0)
		local geom = w .. "x" .. h .. "x" .. r
		if geom ~= auraGeom then
			auraGeom = geom
			auraEdges[1].strip.Position = UDim2.fromOffset(r, -STRIP)
			auraEdges[1].strip.Size = UDim2.fromOffset(lenH, STRIP)
			auraEdges[2].strip.Position = UDim2.fromOffset(w, r)
			auraEdges[2].strip.Size = UDim2.fromOffset(STRIP, lenV)
			auraEdges[3].strip.Position = UDim2.fromOffset(r, h)
			auraEdges[3].strip.Size = UDim2.fromOffset(lenH, STRIP)
			auraEdges[4].strip.Position = UDim2.fromOffset(-STRIP, r)
			auraEdges[4].strip.Size = UDim2.fromOffset(STRIP, lenV)
		end
		local k = 2 * math.pi / WAVELEN
		for ei = 1, 4 do
			local e = auraEdges[ei]
			local len = (ei == 1 or ei == 3) and lenH or lenV
			local n = 0
			if len >= PILL then n = math.min(math.floor((len - PILL) / SPACING) + 1, 80) end
			while #e.fill < n do addAuraPill(e) end
			local step = (n > 1) and (len - PILL) / (n - 1) or 0
			for i = 1, #e.fill do
				local f, l = e.fill[i], e.line[i]
				local vis = i <= n
				if f.Visible ~= vis then
					f.Visible = vis
					l.Visible = vis
				end
				if vis then
					local c = (n == 1) and len / 2 or (PILL / 2 + (i - 1) * step)
					local s
					if ei == 1 then s = r + c
					elseif ei == 2 then s = w + r + c
					elseif ei == 3 then s = w + h + (w - r - c)
					else s = 2 * w + h + (h - r - c) end
					local out = math.min(amp * (2 + 7 * (0.5 + 0.5 * math.sin(k * s - waveT * 2.2))), STRIP - 3)
					local fx, fy
					if ei == 1 then fx, fy = c - PILL / 2, STRIP - out
					elseif ei == 2 then fx, fy = out - PILL, c - PILL / 2
					elseif ei == 3 then fx, fy = c - PILL / 2, out - PILL
					else fx, fy = STRIP - out, c - PILL / 2 end
					f.Position = UDim2.fromOffset(fx, fy)
					l.Position = UDim2.fromOffset(fx - 1.5, fy - 1.5)
				end
			end
		end
	end

