		tab.Label.Size = UDim2.new(1, -52, 1, 0)
		local ICO = 26   -- taille de l'icône des réglages
		local img = (icon and icon ~= "") and icon or "rbxassetid://13300915301"
		if string.match(img, "^%d+$") then img = "rbxassetid://" .. img end
		new("ImageLabel", { Name = "SettingsIcon", BackgroundTransparency = 1, Image = img, ImageColor3 = T.Text,
			ScaleType = Enum.ScaleType.Fit, Position = UDim2.new(0, 8, 0.5, -ICO / 2), Size = UDim2.fromOffset(ICO, ICO) }, tab.Button)
