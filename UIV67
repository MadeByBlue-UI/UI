local function uiSnd(ev)
	if not Library.UISound then return end
	if (Library._silentSound or 0) > 0 or (Library._restoring or 0) > 0 then return end
	local hov = (ev == "hover" or ev == "tabhover")
	if hov then
		if not Library.UISoundHover then return end
		if os.clock() < (Library._busyUntil or 0) then return end   -- pas de bruit pendant les transitions
	end
	local pack = Library.UISoundPacks[Library.UISoundPack]
	local d = pack and pack[ev]
	if not d then return end
	local now = os.clock()
	if now - (uiSndLast[ev] or 0) < (d.cd or (hov and 0.07 or 0.035)) then return end
	uiSndLast[ev] = now
	local vol = math.clamp((d[3] or 0.3) * (tonumber(Library.UISoundVolume) or 0.5) * 2, 0, 1)
	if vol <= 0.003 then return end
	pcall(function()
		local s = uiSndObjs[ev]
		if not (s and s.Parent) then
			s = Instance.new("Sound")
			s.Name = "UI_" .. ev
			local eq = Instance.new("EqualizerSoundEffect")
			eq.Name, eq.LowGain, eq.MidGain, eq.HighGain = "Soft", 2, 0, -8
			eq.Parent = s
			local rv = Instance.new("ReverbSoundEffect")
			rv.Name, rv.DecayTime, rv.Density, rv.Diffusion = "Space", 2.6, 1, 1
			rv.DryLevel, rv.WetLevel = -2, -9
			rv.Parent = s
			s.Parent = uiSndHost()
			uiSndObjs[ev] = s
		end
		local rv = s:FindFirstChild("Space")
		if rv then rv.Enabled = Library.UISoundReverb ~= false end
		local id = UISND_ID[d[1]] or d[1]
		if s.SoundId ~= id then s.SoundId = id end
		s.PlaybackSpeed = (d[2] or 1) * (1 + (math.random() * 2 - 1) * (d.jit or 0))
		s.Volume = vol
		s.TimePosition = 0
		s:Play()
		if d.len then   -- coupe en douceur les sons trop longs
			local tok = (s:GetAttribute("tok") or 0) + 1
			s:SetAttribute("tok", tok)
			task.delay(d.len, function()
				if s.Parent and s:GetAttribute("tok") == tok then
					TweenService:Create(s, TweenInfo.new(0.18), { Volume = 0 }):Play()
					task.delay(0.2, function()
						if s.Parent and s:GetAttribute("tok") == tok then s:Stop() end
					end)
				end
			end)
		end
	end)
end

function Library:PlayUISound(ev) uiSnd(tostring(ev)) end

