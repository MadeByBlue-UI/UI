-- ════════════════════════════════════════════════════════════════════════
--  Button
-- ════════════════════════════════════════════════════════════════════════

function BaseFuncs:AddButton(a, b)
    local idx, info
    if type(a) == "string" and type(b) == "table" then
        idx, info = a, b
    elseif type(a) == "table" then
        info = a
    else
        info = { Text = a, Func = b }
    end
    info.Text = info.Text or "Button"
    info.Func = info.Func or info.Callback

    local row = { Type = "ButtonRow", Buttons = {} }
    local holder = self:CreateHolder(28, "ButtonRow")
    Library:AddList(holder, 6, Enum.FillDirection.Horizontal)
    row.Holder = holder

    function row:Relayout()
        local count = #self.Buttons
        local gap = 6
        for _, button in ipairs(self.Buttons) do
            button.Frame.Size = UDim2.new(1 / count, -(gap * (count - 1)) / count, 1, 0)
        end
    end

    local function createButton(buttonInfo, isSub)
        local button = {
            Type = "Button",
            Text = buttonInfo.Text or "Button",
            Func = buttonInfo.Func or buttonInfo.Callback,
            DoubleClick = buttonInfo.DoubleClick == true,
            Risky = buttonInfo.Risky == true,
            Disabled = buttonInfo.Disabled == true,
            Locked = false,
            Waiting = false,
            Sub = isSub,
        }

        local frame = Library:Create("TextButton", {
            Name = "Button",
            Size = UDim2.fromScale(1, 1),
            Text = "",
            ZIndex = 4,
            LayoutOrder = #row.Buttons + 1,
            ["@BackgroundColor3"] = "MainColor",
            Parent = holder,
        })
        Library:AddThemedCorner(frame, 0.8)
        local stroke = Library:AddStroke(frame, "OutlineColor", 1)

        local label = Library:Create("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            Text = button.Text,
            ZIndex = 5,
            ["@TextColor3"] = "FontColor",
            Parent = frame,
        })

        button.Frame = frame
        button.Label = label
        button.Stroke = stroke

        function button:Refresh()
            local color
            if self.Disabled then
                color = Library.Theme.MutedColor
            elseif self.Risky or self.Waiting then
                color = Library.Theme.RedColor
            else
                color = Library.Theme.FontColor
            end
            label.TextColor3 = color
            label.TextTransparency = self.Disabled and 0.4 or 0
        end

        function button:SetText(text)
            self.Text = text
            label.Text = text
        end

        function button:SetDisabled(state)
            self.Disabled = state and true or false
            self:Refresh()
        end

        function button:SetVisible(visible)
            frame.Visible = visible
        end

        function button:SetRisky(state)
            self.Risky = state and true or false
            self:Refresh()
        end

        function button:SetFunc(fn)
            self.Func = fn
        end

        function button:AddButton(subInfo)
            if type(subInfo) == "string" then
                subInfo = { Text = subInfo }
            end
            local sub = createButton(subInfo, true)
            row:Relayout()
            return sub
        end

        function button:AddTooltip(text)
            Library:AddTooltip(text, frame)
            return self
        end

        function button:Fire()
            if self.Disabled or self.Locked then
                return
            end
            if self.DoubleClick then
                if not self.Waiting then
                    self.Waiting = true
                    label.Text = "Are you sure?"
                    self:Refresh()
                    task.delay(2.2, function()
                        if self.Waiting then
                            self.Waiting = false
                            label.Text = self.Text
                            self:Refresh()
                        end
                    end)
                    return
                end
                self.Waiting = false
                label.Text = self.Text
                self:Refresh()
            end
            self.Locked = true
            Library:SafeCallback(self.Func)
            -- accent flash
            frame.BackgroundColor3 = Library.Theme.AccentColor
            Library:Tween(frame, { BackgroundColor3 = Library.Theme.MainColor }, Library.SlowTweenInfo)
            task.delay(0.1, function()
                self.Locked = false
            end)
        end

        frame.MouseEnter:Connect(function()
            if not button.Disabled then
                Library:Tween(frame, { BackgroundColor3 = Library:Lighten(Library.Theme.MainColor, 0.07) },
                    Library.FastTweenInfo)
                Library:Tween(stroke, { Color = Library.Theme.AccentColor }, Library.FastTweenInfo)
            end
        end)
        frame.MouseLeave:Connect(function()
            Library:Tween(frame, { BackgroundColor3 = Library.Theme.MainColor }, Library.FastTweenInfo)
            Library:Tween(stroke, { Color = Library.Theme.OutlineColor }, Library.FastTweenInfo)
        end)
        frame.MouseButton1Click:Connect(function()
            button:Fire()
        end)

        if buttonInfo.Tooltip then
            Library:AddTooltip(buttonInfo.Tooltip, frame)
        end

        Library:OnThemeChanged(frame, function()
            button:Refresh()
        end)

        button:Refresh()
        table.insert(row.Buttons, button)
        Library:RegisterSearch(button, button.Text, self)
        return button
    end

    local main = createButton(info, false)
    row:Relayout()
    Library:MakeVisibilityController(main, holder)

    -- A row-level visibility controller so :SetVisible on the main button hides the row
    function main:SetVisible(visible)
        self.UserVisible = visible
        self:UpdateVisibility()
    end

    if idx then
        Library.Buttons[idx] = main
        main.Index = idx
    end

    return main
end

-- ════════════════════════════════════════════════════════════════════════
--  Toggle (switch) and Checkbox
-- ════════════════════════════════════════════════════════════════════════

local function CreateToggleLike(self, idx, info, style)
    info = info or {}
    local toggle = {
        Type = "Toggle",
        Style = style,
        Index = idx,
        Text = info.Text or "Toggle",
        Value = info.Default == true,
        Callback = info.Callback,
        Risky = info.Risky == true,
        Disabled = info.Disabled == true,
        Changed = Signal.new(),
        Pickers = {},
    }

    local holder = self:CreateHolder(22, style == "Checkbox" and "Checkbox" or "Toggle")
    local rightWidth = style == "Checkbox" and 20 or 38

    local region = Library:Create("TextButton", {
        Name = "Region",
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = 3,
        Parent = holder,
    })

    local textLabel = Library:Create("TextLabel", {
        Position = style == "Checkbox" and UDim2.fromOffset(26, 0) or UDim2.new(),
        Size = style == "Checkbox" and UDim2.new(1, -26, 1, 0) or UDim2.new(1, -rightWidth, 1, 0),
        Text = toggle.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        RichText = true,
        ZIndex = 4,
        ["@TextColor3"] = "FontColor",
        Parent = holder,
    })
    toggle.TextLabel = textLabel

    local pill, knob, box, boxStroke, checkShort, checkLong

    if style == "Checkbox" then
        box = Library:Create("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(18, 18),
            ZIndex = 4,
            ["@BackgroundColor3"] = "MainColor",
            Parent = holder,
        })
        Library:AddThemedCorner(box, 0.6)
        boxStroke = Library:AddStroke(box, "OutlineColor", 1)

        checkShort = Library:Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(6.5, 10),
            Size = UDim2.fromOffset(2, 5),
            Rotation = -45,
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1,
            ZIndex = 5,
            Parent = box,
        })
        checkLong = Library:Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(10.5, 9),
            Size = UDim2.fromOffset(2, 10),
            Rotation = 45,
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1,
            ZIndex = 5,
            Parent = box,
        })
    else
        pill = Library:Create("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(34, 18),
            ZIndex = 4,
            ["@BackgroundColor3"] = "OutlineColor",
            Parent = holder,
        })
        Library:AddCorner(pill, 9999)
        boxStroke = Library:AddStroke(pill, "OutlineColor", 1)

        knob = Library:Create("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = Color3.new(1, 1, 1),
            ZIndex = 5,
            Parent = pill,
        })
        Library:AddCorner(knob, 9999)
    end

    toggle.Addons = self:CreateAddonContainer(holder, style == "Checkbox" and 0 or rightWidth)

    function toggle:Display(instant)
        local theme = Library.Theme
        local tweenInfo = instant and TweenInfo.new(0) or Library.FastTweenInfo
        if style == "Checkbox" then
            Library:Tween(box, {
                BackgroundColor3 = self.Value and theme.AccentColor or theme.MainColor,
            }, tweenInfo)
            Library:Tween(boxStroke, {
                Color = self.Value and theme.AccentColor or theme.OutlineColor,
            }, tweenInfo)
            local transparency = self.Value and 0 or 1
            local checkColor = Library:ContrastColor(theme.AccentColor)
            checkShort.BackgroundColor3 = checkColor
            checkLong.BackgroundColor3 = checkColor
            Library:Tween(checkShort, { BackgroundTransparency = transparency }, tweenInfo)
            Library:Tween(checkLong, { BackgroundTransparency = transparency }, tweenInfo)
        else
            Library:Tween(pill, {
                BackgroundColor3 = self.Value and theme.AccentColor or theme.OutlineColor,
            }, tweenInfo)
            Library:Tween(boxStroke, {
                Color = self.Value and theme.AccentColor or theme.OutlineColor,
            }, tweenInfo)
            Library:Tween(knob, {
                Position = self.Value and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                BackgroundColor3 = self.Value and Library:ContrastColor(theme.AccentColor) or theme.MutedColor,
            }, tweenInfo)
        end

        local textColor
        if self.Disabled then
            textColor = theme.MutedColor
        elseif self.Risky then
            textColor = theme.RedColor
        elseif self.Value then
            textColor = theme.FontColor
        else
            textColor = theme.MutedColor
        end
        Library:Tween(textLabel, {
            TextColor3 = textColor,
            TextTransparency = self.Disabled and 0.45 or 0,
        }, tweenInfo)
    end

    function toggle:SetValue(value, silent)
        value = value and true or false
        if self.Value == value then
            return
        end
        self.Value = value
        self:Display()

        for _, picker in ipairs(self.Pickers) do
            if picker.SyncToggleState then
                picker.Toggled = value
            end
        end
        Library:RefreshKeybindList()

        if not silent then
            Library:SafeCallback(self.Callback, value)
            self.Changed:Fire(value)
        end
        Library:UpdateDependencyBoxes()
    end

    function toggle:OnChanged(fn)
        return self.Changed:Connect(fn)
    end

    function toggle:SetText(text)
        self.Text = text
        textLabel.Text = text
        if self.SearchEntry then
            self.SearchEntry.Text = string.lower(text)
            self.SearchEntry.Display = text
        end
    end

    function toggle:SetDisabled(state)
        self.Disabled = state and true or false
        self:Display(true)
    end

    function toggle:SetRisky(state)
        self.Risky = state and true or false
        self:Display(true)
    end

    function toggle:GetValue()
        return self.Value
    end

    toggle.AddColorPicker = Addons.AddColorPicker
    toggle.AddKeyPicker = Addons.AddKeyPicker

    region.MouseButton1Click:Connect(function()
        if toggle.Disabled then
            return
        end
        toggle:SetValue(not toggle.Value)
    end)

    if info.Tooltip then
        Library:AddTooltip(info.Tooltip, region)
    end

    Library:OnThemeChanged(holder, function()
        toggle:Display(true)
    end)

    Library:MakeVisibilityController(toggle, holder)
    Library:RegisterSearch(toggle, toggle.Text, self)
    toggle:Display(true)

    if idx then
        Library.Toggles[idx] = toggle
    end
    return toggle
end

function BaseFuncs:AddToggle(idx, info)
    return CreateToggleLike(self, idx, info, "Switch")
end

function BaseFuncs:AddCheckbox(idx, info)
    return CreateToggleLike(self, idx, info, "Checkbox")
end

