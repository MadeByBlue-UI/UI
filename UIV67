local ACC_PROPS = {
	Frame = { "BackgroundColor3" }, CanvasGroup = { "BackgroundColor3" },
	TextButton = { "BackgroundColor3", "TextColor3" }, TextLabel = { "BackgroundColor3", "TextColor3" },
	TextBox = { "BackgroundColor3", "TextColor3" },
	ImageLabel = { "ImageColor3", "BackgroundColor3" },
	ScrollingFrame = { "ScrollBarImageColor3" }, UIStroke = { "Color" },
}
local function nearColor(a, b) return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.006 end
local function noAccent(d, root)
	local p = d
	while p and p ~= root do
		if p:GetAttribute("NoAccent") then return true end
		p = p.Parent
	end
	return false
end

-- Couleurs réellement appliquées sur les instances (permet de les remplacer en direct, une seule passe)
local COLOR_KEYS = { "Main", "Second", "Accent", "Text", "ElementAccent", "Element", "Off", "Panel" }
local appliedC = {}
local function snapshotColors()
	for _, k in ipairs(COLOR_KEYS) do appliedC[k] = T[k] end
end
snapshotColors()

local function titleSeq(a)
	local dim = a:Lerp(Color3.new(0, 0, 0), 0.25)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, dim), ColorSequenceKeypoint.new(0.38, dim),
		ColorSequenceKeypoint.new(0.5, a), ColorSequenceKeypoint.new(0.62, dim),
		ColorSequenceKeypoint.new(1, dim),
	})
end
Library._titleSeq = titleSeq
function Library._stretch(s)
	s = tostring(s)
	local out = {}
	for _, c in utf8.codes(s) do out[#out + 1] = utf8.char(c) end
	return table.concat(out, Library.TitleSpacing or " ")
end

local function applyColorsNow()
	local list = {}
	for _, k in ipairs(COLOR_KEYS) do
		local o, n = appliedC[k], T[k]
		if o and n and not nearColor(o, n) then list[#list + 1] = { o, n } end
	end
	if #list > 0 then
		for _, root in ipairs(guiRoots()) do
			for _, d in ipairs(root:GetDescendants()) do
				local props = ACC_PROPS[d.ClassName]
				if props then
					for _, p in ipairs(props) do
						local ok, cur = pcall(function() return d[p] end)
						if ok and typeof(cur) == "Color3" then
							for _, pr in ipairs(list) do
								if nearColor(cur, pr[1]) then
									if not noAccent(d, root) then d[p] = pr[2] end
									break
								end
							end
						end
					end
				end
			end
		end
	end
	snapshotColors()
	-- dégradés (anneaux du trou noir, bordure, logo, titre) : suivent la couleur d'accent
	local a = T.Accent
	local dim = a:Lerp(Color3.new(0, 0, 0), 0.55)
	for _, sp in ipairs(spinners) do
		if sp.g and sp.g.Parent then sp.g.Color = ColorSequence.new(a, dim) end
	end
	if Library._titleGrad and Library._titleGrad.Parent then
		Library._titleGrad.Color = Library._titleSeq(a)
	end
end

local colorToken = 0
local function scheduleColors(immediate)
	colorToken += 1
	local my = colorToken
	if immediate then applyColorsNow() return end
	task.delay(0.06, function()
		if my == colorToken then applyColorsNow() end
	end)
end

local function toColor3(v)
	if typeof(v) == "Color3" then return v end
	if type(v) == "string" then
		local ok, c = pcall(Color3.fromHex, (string.gsub(v, "#", "")))
		if ok and typeof(c) == "Color3" then return c end
	end
	return nil
end

-- Library:SetColors({ Main=, Second=, Accent=, Text=, ElementAccent= })  (Color3 ou "#RRGGBB"), appliqué en direct
function Library:SetColors(tbl, immediate)
	if type(tbl) ~= "table" then return end
	for k, v in pairs(tbl) do
		local c = toColor3(v)
		if c and (k == "Main" or k == "Second" or k == "Accent" or k == "Text" or k == "ElementAccent") then
			T[k] = c
		end
	end
	refreshTheme()
	scheduleColors(immediate)
end
function Library:SetColor(k, c) Library:SetColors({ [k] = c }) end
function Library:SetAccent(c) Library:SetColor("Accent", c) end

