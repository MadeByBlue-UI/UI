	-- Vagues intérieures : deux nappes de petites bosses qui ondulent au fond de la fenêtre
	local wavesHolder = new("Frame", { Name = "Waves", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0 }, space)
	local INNER_W = 14
	local innerLayers = {
		{ pills = {}, tr = 0.95, base = 34, A = 9, k = 0.028, spd = 1.0, ph = 0 },
		{ pills = {}, tr = 0.93, base = 22, A = 7, k = 0.043, spd = -1.5, ph = 2 },
	}
	local function updateInner(w, h, amp)
		local n = math.ceil(w / INNER_W) + 1
		for _, ly in ipairs(innerLayers) do
			while #ly.pills < n do
				local p = new("Frame", { BackgroundColor3 = T.Accent, BackgroundTransparency = ly.tr, BorderSizePixel = 0,
					Size = UDim2.fromOffset(INNER_W, 160), Visible = false }, wavesHolder)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, p)
				ly.pills[#ly.pills + 1] = p
			end
			for i = 1, #ly.pills do
				local p = ly.pills[i]
				local vis = i <= n
				if p.Visible ~= vis then p.Visible = vis end
				if vis then
					local x = (i - 1) * INNER_W
					p.Position = UDim2.fromOffset(x, h - ly.base - ly.A * amp * math.sin(ly.k * x + waveT * ly.spd + ly.ph))
				end
			end
		end
	end

	local HOLE_POS = {
