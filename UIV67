local notifSoundObjs, lastSndAt = {}, 0

local function resolveSound(spec)
	if type(spec) ~= "table" then return nil end
	if spec.Preset == "Personnalisé" then
		local c = tostring(spec.Custom or ""):match("^%s*(.-)%s*$")
		if c == "" then return nil end
		if tonumber(c) then return "rbxassetid://" .. c, 1 end
		if c:find("^rbx") then return c, 1 end
		local ok, r = pcall(function()
			if isfile and getcustomasset and isfile(c) then return getcustomasset(c) end
		end)
		if ok and r then return r, 1 end
		return nil
	end
	local p = SOUND_BY_NAME[spec.Preset]
	if p and p.Id then return p.Id, p.Speed or 1, p end
	return nil
end

local NS = { Prio = { Loading = 0, Info = 1, Success = 2, Warning = 3, Error = 4 }, LastPrio = 0 }

local function playNotifSound(kind, preview)
	local prio = NS.Prio[kind] or 1
	if not preview then
		if not Library.NotifSound then return end
		local now = os.clock()
		local limit = Library.NotifSoundLimit ~= false
		local gap = limit and math.max(tonumber(Library.NotifSoundGap) or 0.6, 0.12) or 0.12
		if now - lastSndAt < gap then
			-- limité : seul le premier son passe ; un son plus important (erreur > alerte > succès > info) le remplace
			if not limit or prio <= NS.LastPrio then return end
			for k, o in pairs(notifSoundObjs) do
				if k ~= kind and o.Parent then pcall(function() o:Stop() end) end
			end
		end
		lastSndAt, NS.LastPrio = now, prio
	end
	local id, speed, pr = resolveSound(Library.NotifSounds[kind])
	if not id then return end
	ensureNotif()
	local s = notifSoundObjs[kind]
	if not (s and s.Parent) then
		s = Instance.new("Sound")
		s.Name = "Snd" .. tostring(kind)
		for _, def in ipairs({ { "EqualizerSoundEffect", "Eq" }, { "ReverbSoundEffect", "Rv" }, { "EchoSoundEffect", "Echo" } }) do
			local fxObj = Instance.new(def[1])
			fxObj.Name, fxObj.Enabled = def[2], false
			fxObj.Parent = s
		end
		s.Parent = notifGui
		notifSoundObjs[kind] = s
	end
	-- effets du son choisi (filtre doux / réverbération / écho) ; coupés pour les sons sans effet
	local fx = pr or {}
	local eq, rv, ec = s:FindFirstChild("Eq"), s:FindFirstChild("Rv"), s:FindFirstChild("Echo")
	if eq then
		eq.Enabled = fx.Lp == true
		if fx.Lp then eq.LowGain, eq.MidGain, eq.HighGain = 3, -3, -28 end
	end
	if rv then
		rv.Enabled = fx.Rv ~= nil
		if fx.Rv then rv.DecayTime, rv.Density, rv.Diffusion, rv.DryLevel, rv.WetLevel = fx.Rv[1], 1, 1, -2, fx.Rv[2] end
	end
	if ec then
		ec.Enabled = fx.Echo ~= nil
		if fx.Echo then ec.Delay, ec.Feedback, ec.DryLevel, ec.WetLevel = fx.Echo[1], fx.Echo[2], 0, fx.Echo[3] end
	end
	if s.SoundId ~= id then s.SoundId = id end
	s.PlaybackSpeed = speed or 1
	s.Volume = math.clamp((tonumber(Library.NotifVolume) or 0.6) * (fx.Vol or 1), 0, 1)
	s.TimePosition = 0
	local tok = (s:GetAttribute("tok") or 0) + 1
	s:SetAttribute("tok", tok)
	s:Play()
	if fx.Len then   -- coupe en douceur les sons trop longs
		task.delay(fx.Len, function()
			if s.Parent and s:GetAttribute("tok") == tok then
				TweenService:Create(s, TweenInfo.new(0.2), { Volume = 0 }):Play()
				task.delay(0.22, function()
					if s.Parent and s:GetAttribute("tok") == tok then s:Stop() end
				end)
			end
		end)
	end
end

