        BorderSizePixel = 0,
        BackgroundColor3 = Color3.new(1, 1, 1),
        Size = props.Size or UDim2.new(1, 0, 0, 1),
        Position = props.Position or UDim2.new(),
        AnchorPoint = props.AnchorPoint or Vector2.new(),
        ZIndex = props.ZIndex or 5,
        Parent = parent,
    })

    local gradient = self:Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, self.Theme.DiskColor3),
            ColorSequenceKeypoint.new(0.5, self.Theme.AccentColor),
            ColorSequenceKeypoint.new(1, self.Theme.DiskColor1),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.2, 0.25),
            NumberSequenceKeypoint.new(0.5, 0),
            NumberSequenceKeypoint.new(0.8, 0.25),
