function Library:CreateWindow(cfg)
	cfg = cfg or {}
	if cfg.Theme then
		for k, v in pairs(cfg.Theme) do T[k] = v end
	end
	T.Element = lighten(T.Second, 0.10)
	T.Off     = lighten(T.Second, 0.24)
	local transp = tonumber(cfg.Transparency) or 0.05

	-- Nettoie une ancienne instance (relance du script)
	for _, p in ipairs({ CoreGui, LP:FindFirstChild("PlayerGui") }) do
		local old = p and p:FindFirstChild("SolarisUI")
		if old then old:Destroy() end
	end
	if cfg.ConfigFolder then
		pcall(function()
			if makefolder and isfolder and not isfolder(cfg.ConfigFolder) then makefolder(cfg.ConfigFolder) end
		end)
	end

	local size = cfg.Size or UDim2.new(0, 480, 0, 560)
	local pos  = cfg.Position or UDim2.new(0.5, -240, 0.5, -280)
	local cam  = workspace.CurrentCamera
	local width = size.X.Offset + size.X.Scale * (cam and cam.ViewportSize.X or 1280)

	local gui = new("ScreenGui", { Name = "SolarisUI", ResetOnSpawn = false, DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
	mount(gui)

	local main = new("Frame", {
		Name = "MainBackground", Size = size, Position = pos, BackgroundColor3 = T.Main,
		BackgroundTransparency = transp, BorderSizePixel = 0, ClipsDescendants = true,
	}, gui)
	corner(main, 12)
	stroke(main, 0.85)

	-- Barre de titre
	local titleBar = new("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1 }, main)
	local title = label(titleBar, cfg.Title or "UI", 15, { Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(1, -60, 1, 0), Font = Enum.Font.GothamBold })
	new("UIGradient", { Color = ColorSequence.new(T.GradientStart, T.GradientEnd) }, title)
	if cfg.CustomIcon and cfg.CustomIcon ~= "" then
		new("ImageLabel", { BackgroundTransparency = 1, Image = cfg.CustomIcon, Size = UDim2.new(0, 20, 0, 20),
			Position = UDim2.new(0, 12, 0.5, -10) }, titleBar)
		title.Position = UDim2.new(0, 38, 0, 0)
	end
	local hideBtn = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 26, 0, 22), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.92,
		Text = "-", TextColor3 = T.Text, TextSize = 16, Font = Enum.Font.GothamBold, AutoButtonColor = false }, titleBar)
	corner(hideBtn, 5)
	new("Frame", { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, BorderSizePixel = 0 }, titleBar)

	-- Déplacement de la fenêtre
	titleBar.InputBegan:Connect(function(i)
		if isPress(i) then
			local start, startPos = Vector2.new(i.Position.X, i.Position.Y), main.Position
			startDrag(function(p)
				local d = Vector2.new(p.X, p.Y) - start
				main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
					startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end)
		end
	end)

	-- Barre latérale + contenu
	local sidebar = new("ScrollingFrame", {
		Position = UDim2.new(0, 8, 0, 46), Size = UDim2.new(0, 112, 1, -54), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, main)
	new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, sidebar)
	local content = new("Frame", { Position = UDim2.new(0, 128, 0, 46), Size = UDim2.new(1, -136, 1, -54),
		BackgroundTransparency = 1 }, main)

	local win = setmetatable({
		Gui = gui, Main = main, Sidebar = sidebar, Content = content, Tabs = {},
		TwoCols = (width - 136) >= 520,
	}, Window)

	function win:Toggle(v)
		if v == nil then v = not main.Visible end
		main.Visible = v
	end
	function win:Destroy() Library:Destroy() end

	hideBtn.MouseButton1Click:Connect(function() win:Toggle(false) end)

	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	track(UIS.InputBegan:Connect(function(i, processed)
		if processed or Library._listening then return end
		if i.KeyCode == toggleKey then win:Toggle() end
	end))

	-- Bouton flottant pour mobile (pas de clavier)
	if UIS.TouchEnabled and not UIS.KeyboardEnabled then
		local fb = new("TextButton", { Position = UDim2.new(0, 12, 0.5, -18), Size = UDim2.new(0, 36, 0, 36),
			BackgroundColor3 = T.Main, BackgroundTransparency = 0.15, Text = "=", TextColor3 = T.Text,
			TextSize = 18, Font = Enum.Font.GothamBold, AutoButtonColor = false }, gui)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, fb)
		stroke(fb, 0.6)
		fb.MouseButton1Click:Connect(function() win:Toggle() end)
	end

	Library.Window = win
	return win
end

function Library:Destroy()
	for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
	table.clear(Conns)
	if Library.Window and Library.Window.Gui then Library.Window.Gui:Destroy() end
	if notifGui then notifGui:Destroy() end
	table.clear(Library.Flags)
	table.clear(Library.Items)
	table.clear(Library.CornerObjects)
end

return Library
