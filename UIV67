--- "v" chevron built from two rotated bars (no image assets needed).
function Library:CreateChevron(parent, props)
    props = props or {}
    local holder = self:Create("Frame", {
        Name = "Chevron",
        BackgroundTransparency = 1,
        AnchorPoint = props.AnchorPoint or Vector2.new(1, 0.5),
        Position = props.Position or UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(12, 8),
        ZIndex = props.ZIndex or 6,
        Parent = parent,
    })
    local left = self:Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(3.4, 4),
        Size = UDim2.fromOffset(7, 2),
        Rotation = 45,
        ZIndex = props.ZIndex or 6,
        ["@BackgroundColor3"] = "MutedColor",
        Parent = holder,
    })
    local right = self:Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(8.6, 4),
        Size = UDim2.fromOffset(7, 2),
        Rotation = -45,
        ZIndex = props.ZIndex or 6,
        ["@BackgroundColor3"] = "MutedColor",
        Parent = holder,
    })
    self:Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = left })
    self:Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = right })

    local chevron = { Holder = holder }
    function chevron:SetOpen(open)
        Library:Tween(holder, { Rotation = open and 180 or 0 }, Library.FastTweenInfo)
    end
    function chevron:SetColor(key)
        Library:Bind(left, { BackgroundColor3 = key })
        Library:Bind(right, { BackgroundColor3 = key })
    end
    return chevron
end

--- Styled text input box used by Input, Dropdown search and Key system.
function Library:CreateTextBox(parent, props)
    props = props or {}
    local frame = self:Create("Frame", {
        Name = props.Name or "TextBoxFrame",
        Size = props.Size or UDim2.new(1, 0, 0, 24),
        Position = props.Position or UDim2.new(),
        LayoutOrder = props.LayoutOrder or 0,
        ZIndex = props.ZIndex or 4,
        ["@BackgroundColor3"] = props.BackgroundKey or "MainColor",
        Parent = parent,
    })
    self:AddThemedCorner(frame, 0.8)
    local stroke = self:AddStroke(frame, "OutlineColor", 1)

    local box = self:Create("TextBox", {
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -16, 1, 0),
        Text = props.Text or "",
        PlaceholderText = props.Placeholder or "",
        ClearTextOnFocus = props.ClearTextOnFocus == true,
        TextXAlignment = props.Alignment or Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = (props.ZIndex or 4) + 1,
        ["@TextColor3"] = "FontColor",
        ["@PlaceholderColor3"] = "MutedColor",
        Parent = frame,
    })

    box.Focused:Connect(function()
        self:Tween(stroke, { Color = self.Theme.AccentColor }, self.FastTweenInfo)
    end)
    box.FocusLost:Connect(function()
        self:Tween(stroke, { Color = self.Theme.OutlineColor }, self.FastTweenInfo)
    end)

    return frame, box, stroke
end

-- ════════════════════════════════════════════════════════════════════════
--  Slider
-- ════════════════════════════════════════════════════════════════════════

function BaseFuncs:AddSlider(idx, info)
    info = info or {}
    local compact = info.Compact == true
    local slider = {
        Type = "Slider",
        Index = idx,
        Text = info.Text,
        Min = info.Min or 0,
        Max = info.Max or 100,
        Rounding = info.Rounding or 0,
        Step = info.Step,
        Prefix = info.Prefix or "",
        Suffix = info.Suffix or "",
        HideMax = info.HideMax == true,
        Callback = info.Callback,
        Disabled = info.Disabled == true,
        Changed = Signal.new(),
    }
    slider.Value = math.clamp(info.Default or slider.Min, slider.Min, slider.Max)

    local holder = self:CreateHolder(compact and 24 or 38, "Slider")

    local textLabel, valueBox
    local track, fill, knob, region

    if compact then
        track = Library:Create("Frame", {
            Size = UDim2.fromScale(1, 1),
            ZIndex = 4,
            ["@BackgroundColor3"] = "MainColor",
            Parent = holder,
        })
        Library:AddThemedCorner(track, 0.8)
        Library:AddStroke(track, "OutlineColor", 1)

        fill = Library:Create("Frame", {
            Size = UDim2.fromScale(0, 1),
            ZIndex = 5,
            BackgroundTransparency = 0.35,
            ["@BackgroundColor3"] = "AccentColor",
            Parent = track,
        })
        Library:AddThemedCorner(fill, 0.8)

        textLabel = Library:Create("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            Text = "",
            ZIndex = 7,
            ["@TextColor3"] = "FontColor",
            Parent = track,
        })

        region = Library:Create("TextButton", {
            Size = UDim2.fromScale(1, 1),
            Text = "",
            ZIndex = 8,
            Parent = track,
        })
    else
        if info.Text then
            textLabel = Library:Create("TextLabel", {
                Size = UDim2.new(1, -112, 0, 16),
                Text = info.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 4,
                ["@TextColor3"] = "FontColor",
                Parent = holder,
            })
        end

        local _, box = Library:CreateTextBox(holder, {
            Position = UDim2.new(1, -108, 0, -1),
            Size = UDim2.fromOffset(108, 18),
            BackgroundKey = "BackgroundColor",
            Alignment = Enum.TextXAlignment.Right,
            ClearTextOnFocus = true,
            ZIndex = 4,
        })
        valueBox = box
        valueBox.TextSize = Library.TextSize - 1

        track = Library:Create("Frame", {
            Position = UDim2.fromOffset(0, 25),
            Size = UDim2.new(1, 0, 0, 6),
            ZIndex = 4,
            ["@BackgroundColor3"] = "OutlineColor",
            Parent = holder,
        })
        Library:AddCorner(track, 9999)

        fill = Library:Create("Frame", {
            Size = UDim2.fromScale(0, 1),
            ZIndex = 5,
            BackgroundColor3 = Color3.new(1, 1, 1),
            Parent = track,
        })
        Library:AddCorner(fill, 9999)
        Library:Create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Library.Theme.DiskColor3),
                ColorSequenceKeypoint.new(1, Library.Theme.AccentColor),
            }),
            Parent = fill,
        })
        slider.FillGradient = fill:FindFirstChildOfClass("UIGradient")

        knob = Library:Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = Color3.new(1, 1, 1),
            ZIndex = 6,
            Parent = track,
        })
        Library:AddCorner(knob, 9999)
        Library:AddStroke(knob, "AccentColor", 2)

        region = Library:Create("TextButton", {
            Position = UDim2.fromOffset(0, 18),
            Size = UDim2.new(1, 0, 0, 20),
            Text = "",
            ZIndex = 8,
            Parent = holder,
        })

        Library:OnThemeChanged(holder, function()
            slider.FillGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Library.Theme.DiskColor3),
                ColorSequenceKeypoint.new(1, Library.Theme.AccentColor),
            })
        end)
    end

    function slider:FormatValue()
        local number = string.format("%." .. self.Rounding .. "f", self.Value)
        local text = self.Prefix .. number .. self.Suffix
        if not self.HideMax then
            local max = string.format("%." .. self.Rounding .. "f", self.Max)
            text = text .. " / " .. self.Prefix .. max .. self.Suffix
        end
        return text
    end

    function slider:Display()
        local range = self.Max - self.Min
        local ratio = range == 0 and 0 or (self.Value - self.Min) / range
        ratio = math.clamp(ratio, 0, 1)
        fill.Size = UDim2.fromScale(ratio, 1)
        if knob then
            knob.Position = UDim2.fromScale(ratio, 0.5)
        end
        if compact then
            local prefix = self.Text and (self.Text .. ": ") or ""
            textLabel.Text = prefix .. self:FormatValue()
        else
            valueBox.Text = self:FormatValue()
        end
    end

    function slider:SetValue(value, silent)
        value = tonumber(value)
        if not value then
            self:Display()
            return
        end
        value = math.clamp(value, self.Min, self.Max)
        if self.Step and self.Step > 0 then
            value = self.Min + math.floor((value - self.Min) / self.Step + 0.5) * self.Step
        end
        value = Library:Round(value, self.Rounding)
        local changed = value ~= self.Value
        self.Value = value
        self:Display()
        if changed and not silent then
            Library:SafeCallback(self.Callback, value)
            self.Changed:Fire(value)
            Library:UpdateDependencyBoxes()
        end
    end

    function slider:SetMin(value)
        self.Min = value
        self:SetValue(self.Value, true)
    end

    function slider:SetMax(value)
        self.Max = value
        self:SetValue(self.Value, true)
    end

    function slider:SetPrefix(text)
        self.Prefix = text
        self:Display()
    end

    function slider:SetSuffix(text)
        self.Suffix = text
        self:Display()
    end

    function slider:SetText(text)
        self.Text = text
        if textLabel and not compact then
            textLabel.Text = text
        end
        self:Display()
    end

    function slider:SetDisabled(state)
        self.Disabled = state and true or false
        holder.BackgroundTransparency = 1
        if textLabel then
            textLabel.TextTransparency = self.Disabled and 0.5 or 0
        end
        track.BackgroundTransparency = self.Disabled and 0.5 or 0
    end

    function slider:OnChanged(fn)
        return self.Changed:Connect(fn)
    end

    function slider:GetValue()
        return self.Value
    end

    Library:BindDrag(region, function(point)
        if slider.Disabled then
            return
        end
        local ratio = Library:GetRatio(track, point)
        local value = slider.Min + (slider.Max - slider.Min) * ratio
        slider:SetValue(value)
    end)

    if valueBox then
        valueBox.Focused:Connect(function()
            valueBox.Text = tostring(slider.Value)
        end)
        valueBox.FocusLost:Connect(function()
            if slider.Disabled then
                slider:Display()
                return
            end
            slider:SetValue(valueBox.Text)
        end)
    end

    if info.Tooltip then
        Library:AddTooltip(info.Tooltip, holder)
    end

    Library:MakeVisibilityController(slider, holder)
    if info.Text then
        Library:RegisterSearch(slider, info.Text, self)
    end

    slider:Display()
    slider:SetDisabled(slider.Disabled)

    if idx then
        Library.Options[idx] = slider
    end
    return slider
end

-- ════════════════════════════════════════════════════════════════════════
--  Input (text box)
-- ════════════════════════════════════════════════════════════════════════

function BaseFuncs:AddInput(idx, info)
    info = info or {}
    local input = {
        Type = "Input",
        Index = idx,
        Text = info.Text,
        Value = info.Default or "",
        Numeric = info.Numeric == true,
        Finished = info.Finished == true,
        MaxLength = info.MaxLength,
        Callback = info.Callback,
        Disabled = info.Disabled == true,
        Changed = Signal.new(),
    }

    local hasLabel = info.Text ~= nil and info.Text ~= ""
    local holder = self:CreateHolder(hasLabel and 44 or 26, "Input")

    local textLabel
    if hasLabel then
        textLabel = Library:Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16),
            Text = info.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4,
            ["@TextColor3"] = "FontColor",
            Parent = holder,
        })
    end

    local frame, box = Library:CreateTextBox(holder, {
        Position = UDim2.fromOffset(0, hasLabel and 20 or 0),
        Size = UDim2.new(1, 0, 0, 24),
        Text = input.Value,
        Placeholder = info.Placeholder or "",
        ClearTextOnFocus = info.ClearTextOnFocus == true,
        ZIndex = 4,
    })
    input.Box = box
    input.Frame = frame

    local function sanitize(text)
        if input.Numeric then
            text = text:gsub("[^%d%.%-]", "")
        end
        if input.MaxLength and #text > input.MaxLength then
            text = text:sub(1, input.MaxLength)
        end
        return text
    end

    function input:SetValue(text, silent)
        text = sanitize(tostring(text))
        self.Value = text
        if box.Text ~= text then
            box.Text = text
        end
        if not silent then
            Library:SafeCallback(self.Callback, text)
            self.Changed:Fire(text)
        end
    end

    function input:OnChanged(fn)
        return self.Changed:Connect(fn)
    end

    function input:GetValue()
        return self.Value
    end

    function input:SetPlaceholder(text)
        box.PlaceholderText = text
    end

    function input:SetDisabled(state)
        self.Disabled = state and true or false
        box.TextEditable = not self.Disabled
        box.TextTransparency = self.Disabled and 0.5 or 0
    end

    function input:SetText(text)
        self.Text = text
        if textLabel then
            textLabel.Text = text
        end
    end

    if info.Finished then
        box.FocusLost:Connect(function(enterPressed)
            if enterPressed then
                input:SetValue(box.Text)
            else
                box.Text = input.Value
            end
        end)
    else
        box:GetPropertyChangedSignal("Text"):Connect(function()
            local clean = sanitize(box.Text)
            if clean ~= box.Text then
                box.Text = clean
                return
            end
            if clean ~= input.Value then
                input:SetValue(clean)
            end
        end)
    end

    if info.Tooltip then
        Library:AddTooltip(info.Tooltip, holder)
    end

    Library:MakeVisibilityController(input, holder)
    if hasLabel then
        Library:RegisterSearch(input, info.Text, self)
    end
    input:SetDisabled(input.Disabled)

    if idx then
        Library.Options[idx] = input
    end
    return input
end

-- ════════════════════════════════════════════════════════════════════════
--  Dropdown (single, multi, searchable, special player / team lists)
-- ════════════════════════════════════════════════════════════════════════

function BaseFuncs:AddDropdown(idx, info)
    info = info or {}
    local dropdown = {
        Type = "Dropdown",
        Index = idx,
        Text = info.Text,
        Values = info.Values or {},
        Multi = info.Multi == true,
        AllowNull = info.AllowNull == true,
        Searchable = info.Searchable == true,
        SpecialType = info.SpecialType,
        ExcludeLocalPlayer = info.ExcludeLocalPlayer == true,
        MaxVisible = info.MaxVisibleDropdownItems or 8,
        DisplayFormat = info.FormatDisplayValue or info.DisplayFormat,
        Callback = info.Callback,
        Disabled = info.Disabled == true,
        Open = false,
        Changed = Signal.new(),
        DisabledValues = {},
    }

    if dropdown.SpecialType == "Player" then
        dropdown.Values = Library:GetPlayerNames(dropdown.ExcludeLocalPlayer)
    elseif dropdown.SpecialType == "Team" then
        dropdown.Values = Library:GetTeamNames()
    end

    dropdown.Value = dropdown.Multi and {} or nil

    local hasLabel = info.Text ~= nil and info.Text ~= ""
    local holder = self:CreateHolder(hasLabel and 46 or 26, "Dropdown")

    local textLabel
    if hasLabel then
        textLabel = Library:Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16),
            Text = info.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4,
            ["@TextColor3"] = "FontColor",
            Parent = holder,
        })
    end

    local button = Library:Create("TextButton", {
        Name = "DropdownButton",
        Position = UDim2.fromOffset(0, hasLabel and 20 or 0),
        Size = UDim2.new(1, 0, 0, 26),
        Text = "",
        ZIndex = 4,
        ["@BackgroundColor3"] = "MainColor",
        Parent = holder,
    })
    Library:AddThemedCorner(button, 0.8)
    local buttonStroke = Library:AddStroke(button, "OutlineColor", 1)

    local display = Library:Create("TextLabel", {
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -30, 1, 0),
        Text = "--",
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 5,
        ["@TextColor3"] = "FontColor",
        Parent = button,
    })
    local chevron = Library:CreateChevron(button, { ZIndex = 6 })

    dropdown.Button = button
    dropdown.DisplayLabel = display

    -- ── Value helpers ────────────────────────────────────────────────────
    local function indexOf(list, value)
        for i, v in ipairs(list) do
            if v == value then
                return i
            end
        end
        return nil
    end

    function dropdown:IsSelected(value)
        if self.Multi then
            return self.Value[value] == true
        end
        return self.Value == value
    end

    function dropdown:GetActiveValues()
        if self.Multi then
            local out = {}
            for _, value in ipairs(self.Values) do
                if self.Value[value] then
                    table.insert(out, value)
                end
            end
            return out
        end
        return self.Value ~= nil and { self.Value } or {}
    end

    function dropdown:FormatDisplay()
        local function format(value)
            if self.DisplayFormat then
                local ok, result = pcall(self.DisplayFormat, value)
                if ok and result then
                    return tostring(result)
                end
            end
            return tostring(value)
        end

        if self.Multi then
            local active = self:GetActiveValues()
            if #active == 0 then
                return "--"
            end
            local parts = {}
            for _, value in ipairs(active) do
                table.insert(parts, format(value))
            end
            return table.concat(parts, ", ")
        end
        if self.Value == nil then
            return "--"
        end
        return format(self.Value)
    end

    function dropdown:Display()
        display.Text = self:FormatDisplay()
        display.TextColor3 = (self.Value == nil or (self.Multi and next(self.Value) == nil))
            and Library.Theme.MutedColor or Library.Theme.FontColor
    end

    -- ── Popup menu ───────────────────────────────────────────────────────
    local menu, scroll, searchBox
    local itemButtons = {}
    local filterText = ""

    local function itemCount()
        local count = 0
        for _, value in ipairs(dropdown.Values) do
            if filterText == "" or string.find(string.lower(tostring(value)), filterText, 1, true) then
                count = count + 1
            end
        end
        return count
    end

    local function resizeMenu()
        if not menu then
            return
        end
        local count = math.max(1, math.min(itemCount(), dropdown.MaxVisible))
        local searchHeight = dropdown.Searchable and 30 or 0
        local width = button.AbsoluteSize.X / Library.DPIScale
        menu.Size = UDim2.fromOffset(width, count * 24 + 8 + searchHeight)
        scroll.Position = UDim2.fromOffset(0, searchHeight)
        scroll.Size = UDim2.new(1, 0, 1, -searchHeight)
    end

    local function refreshItems()
        for _, entry in ipairs(itemButtons) do
            local selected = dropdown:IsSelected(entry.Value)
            local disabled = dropdown.DisabledValues[entry.Value]
            entry.Label.TextColor3 = selected and Library.Theme.AccentColor
                or (disabled and Library.Theme.OutlineColor or Library.Theme.FontColor)
            entry.Marker.BackgroundTransparency = selected and 0 or 1
            entry.Button.BackgroundTransparency = selected and 0.88 or 1
        end
    end

    local function select(value)
        if dropdown.DisabledValues[value] then
            return
        end
        if dropdown.Multi then
            dropdown.Value[value] = not dropdown.Value[value] or nil
        else
            if dropdown.Value == value then
                if dropdown.AllowNull then
                    dropdown.Value = nil
                end
            else
                dropdown.Value = value
            end
        end
        dropdown:Display()
        refreshItems()
        Library:SafeCallback(dropdown.Callback, dropdown.Value)
        dropdown.Changed:Fire(dropdown.Value)
        Library:UpdateDependencyBoxes()
        if not dropdown.Multi then
            dropdown:Close()
        end
    end

    local function buildItems()
        for _, entry in ipairs(itemButtons) do
            entry.Button:Destroy()
        end
        itemButtons = {}

        local order = 0
        for _, value in ipairs(dropdown.Values) do
            if filterText == "" or string.find(string.lower(tostring(value)), filterText, 1, true) then
                order = order + 1
                local itemButton = Library:Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    Text = "",
                    LayoutOrder = order,
                    ZIndex = 512,
                    BackgroundTransparency = 1,
                    ["@BackgroundColor3"] = "AccentColor",
                    Parent = scroll,
                })
                Library:AddCorner(itemButton, 4)

                local marker = Library:Create("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 4, 0.5, 0),
                    Size = UDim2.fromOffset(3, 12),
                    ZIndex = 514,
                    BackgroundTransparency = 1,
                    ["@BackgroundColor3"] = "AccentColor",
                    Parent = itemButton,
                })
                Library:AddCorner(marker, 9999)

                local itemLabel = Library:Create("TextLabel", {
                    Position = UDim2.fromOffset(14, 0),
                    Size = UDim2.new(1, -18, 1, 0),
                    Text = tostring(value),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 513,
                    ["@TextColor3"] = "FontColor",
                    Parent = itemButton,
                })

                itemButton.MouseButton1Click:Connect(function()
                    select(value)
                end)

                table.insert(itemButtons, {
                    Value = value,
                    Button = itemButton,
                    Label = itemLabel,
                    Marker = marker,
                })
            end
        end
        refreshItems()
        resizeMenu()
    end

    local function buildMenu()
        menu = Library:Create("Frame", {
            Name = "DropdownMenu",
            Size = UDim2.fromOffset(180, 100),
            Visible = false,
            ZIndex = 510,
            ["@BackgroundColor3"] = "BackgroundColor",
            Parent = Library.PopupLayer,
        })
        Library:AddCorner(menu, 6)
        Library:AddStroke(menu, "AccentColor", 1, 0.4)

        if dropdown.Searchable then
            local frame, box = Library:CreateTextBox(menu, {
                Position = UDim2.fromOffset(4, 4),
                Size = UDim2.new(1, -8, 0, 22),
                Placeholder = "Search...",
                ZIndex = 511,
                BackgroundKey = "MainColor",
            })
            searchBox = box
            box:GetPropertyChangedSignal("Text"):Connect(function()
                filterText = string.lower(box.Text)
                buildItems()
            end)
        end

        scroll = Library:Create("ScrollingFrame", {
            ZIndex = 511,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = Library.Theme.AccentColor,
            Parent = menu,
        })
        Library:AddPadding(scroll, 4)
        Library:AddList(scroll, 0)
        buildItems()
    end

    function dropdown:Show()
        if self.Disabled then
            return
        end
        if not menu then
            buildMenu()
        end
        Library:CloseAllPopups(menu)
        self.Open = true
        menu.Visible = true
        filterText = ""
        if searchBox then
            searchBox.Text = ""
        end
        buildItems()
        Library:PositionPopup(menu, button, nil, 4)
        chevron:SetOpen(true)
        Library:Tween(buttonStroke, { Color = Library.Theme.AccentColor }, Library.FastTweenInfo)
        Library:OpenPopup(menu, function()
            dropdown:Close()
        end, button)
        self.PositionHandle = Library:AddAnimation(function()
            if not dropdown.Open or not button.Parent then
                return
            end
            Library:PositionPopup(menu, button, nil, 4)
        end)
    end

    function dropdown:Close()
        if not self.Open then
            return
        end
        self.Open = false
        if menu then
            menu.Visible = false
            Library:ClosePopup(menu)
        end
        chevron:SetOpen(false)
        Library:Tween(buttonStroke, { Color = Library.Theme.OutlineColor }, Library.FastTweenInfo)
        if self.PositionHandle then
            self.PositionHandle:Stop()
            self.PositionHandle = nil
        end
    end

    -- ── Public API ───────────────────────────────────────────────────────
    function dropdown:SetValue(value, silent)
        if self.Multi then
            local new = {}
            if type(value) == "table" then
                for k, v in pairs(value) do
                    if type(k) == "number" then
                        new[v] = true
                    elseif v then
                        new[k] = true
                    end
                end
            end
            self.Value = new
        else
            if type(value) == "number" and self.Values[value] ~= nil then
                value = self.Values[value]
            end
            if value ~= nil and not indexOf(self.Values, value) then
                value = nil
            end
            self.Value = value
        end
        self:Display()
        if menu then
            refreshItems()
        end
        if not silent then
            Library:SafeCallback(self.Callback, self.Value)
            self.Changed:Fire(self.Value)
            Library:UpdateDependencyBoxes()
        end
    end

    function dropdown:SetValues(values)
        self.Values = values or {}
        if self.Multi then
            for key in pairs(self.Value) do
                if not indexOf(self.Values, key) then
                    self.Value[key] = nil
                end
            end
        elseif self.Value ~= nil and not indexOf(self.Values, self.Value) then
            self.Value = nil
        end
        self:Display()
        if menu then
            buildItems()
        end
    end

    function dropdown:AddValues(values)
        if type(values) == "string" then
            values = { values }
        end
        for _, value in ipairs(values) do
            if not indexOf(self.Values, value) then
                table.insert(self.Values, value)
            end
        end
        if menu then
            buildItems()
        end
    end

    function dropdown:SetDisabledValues(list)
        self.DisabledValues = {}
        for _, value in ipairs(list or {}) do
            self.DisabledValues[value] = true
        end
        if menu then
            refreshItems()
        end
    end

    function dropdown:SetDisabled(state)
        self.Disabled = state and true or false
        if self.Disabled then
            self:Close()
        end
        button.BackgroundTransparency = self.Disabled and 0.5 or 0
        display.TextTransparency = self.Disabled and 0.5 or 0
    end

    function dropdown:SetText(text)
        self.Text = text
        if textLabel then
            textLabel.Text = text
        end
    end

    function dropdown:OnChanged(fn)
        return self.Changed:Connect(fn)
    end

    function dropdown:GetValue()
        return self.Value
    end

    function dropdown:Refresh()
        if self.SpecialType == "Player" then
            self:SetValues(Library:GetPlayerNames(self.ExcludeLocalPlayer))
        elseif self.SpecialType == "Team" then
            self:SetValues(Library:GetTeamNames())
        end
    end

    -- Defaults
    local default = info.Default
    if default ~= nil then
        if dropdown.Multi then
            local initial = {}
            if type(default) == "table" then
                for k, v in pairs(default) do
                    if type(k) == "number" then
                        local name = type(v) == "number" and dropdown.Values[v] or v
                        if name ~= nil then
                            initial[name] = true
                        end
                    elseif v then
                        initial[k] = true
                    end
                end
            end
            dropdown.Value = initial
        else
            if type(default) == "number" and dropdown.Values[default] ~= nil then
                dropdown.Value = dropdown.Values[default]
            elseif indexOf(dropdown.Values, default) then
                dropdown.Value = default
            end
        end
    end

    if dropdown.SpecialType then
        local function refresh()
            task.defer(function()
                dropdown:Refresh()
            end)
        end
        if dropdown.SpecialType == "Player" then
            Library:Connect(Players.PlayerAdded, refresh)
            Library:Connect(Players.PlayerRemoving, refresh)
        end
    end

    button.MouseButton1Click:Connect(function()
        if dropdown.Open then
            dropdown:Close()
        else
            dropdown:Show()
        end
    end)

    button.MouseEnter:Connect(function()
        if not dropdown.Open then
            Library:Tween(buttonStroke, { Color = Library:MixColors(Library.Theme.OutlineColor,
                Library.Theme.AccentColor, 0.5) }, Library.FastTweenInfo)
        end
    end)
    button.MouseLeave:Connect(function()
        if not dropdown.Open then
            Library:Tween(buttonStroke, { Color = Library.Theme.OutlineColor }, Library.FastTweenInfo)
        end
    end)

    if info.Tooltip then
        Library:AddTooltip(info.Tooltip, holder)
    end

    Library:OnThemeChanged(holder, function()
        dropdown:Display()
        if menu then
            refreshItems()
        end
    end)

    holder.Destroying:Connect(function()
        if menu then
            menu:Destroy()
        end
        dropdown:Close()
    end)

    Library:MakeVisibilityController(dropdown, holder)
    if hasLabel then
        Library:RegisterSearch(dropdown, info.Text, self)
    end

    dropdown:Display()
    dropdown:SetDisabled(dropdown.Disabled)

    if idx then
        Library.Options[idx] = dropdown
    end
    return dropdown
end

