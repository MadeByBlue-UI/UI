local BaseFuncs = {}
Library.BaseFuncs = BaseFuncs

--- Run `fn` on theme changes for as long as `instance` exists.
function Library:OnThemeChanged(instance, fn)
    local connection = self.ThemeChanged:Connect(fn)
    instance.Destroying:Connect(function()
        connection:Disconnect()
    end)
    return connection
end

function BaseFuncs:NextOrder()
    self.Order = (self.Order or 0) + 1
    return self.Order
end

function BaseFuncs:CreateHolder(height, name)
    local holder = Library:Create("Frame", {
        Name = name or "Element",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = self:NextOrder(),
        ZIndex = 3,
        Parent = self.Container,
    })
    return holder
end

function BaseFuncs:CreateAddonContainer(holder, rightOffset)
    local addons = Library:Create("Frame", {
        Name = "Addons",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -(rightOffset or 0), 0.5, 0),
        Size = UDim2.fromOffset(0, 18),
        AutomaticSize = Enum.AutomaticSize.X,
        ZIndex = 6,
        Parent = holder,
    })
    Library:AddList(addons, 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right,
        Enum.VerticalAlignment.Center)
    return addons
end

local function ParseOverloads(a, b, c)
    -- (idx, info) | (info) | (text, extra)
    if type(a) == "string" and type(b) == "table" then
        return a, b
    elseif type(a) == "table" then
        return nil, a
    end
    return nil, { Text = a, Extra = b, Extra2 = c }
end

local function Register(element, idx, bucket)
    if idx then
        element.Index = idx
        bucket[idx] = element
    end
end

