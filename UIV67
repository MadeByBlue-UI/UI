	local function colorView(e)
		local it = e.Item
		return {
			title = e.Name,
			build = function()
				local cur = safeGet(it)
				local out = {}
				for _, p in ipairs(COLOR_PRESETS) do
					local c = p[2]
					local same = typeof(cur) == "Color3"
						and math.abs(cur.R - c.R) + math.abs(cur.G - c.G) + math.abs(cur.B - c.B) < 0.02
					out[#out + 1] = {
						Name = p[1], Sub = "", Color = c, On = same and true or nil, Tab = e.Tab, Block = e.Block,
						Run = function()
							pcall(function() it.Set(c) end)
							flash(e.Name .. " : " .. p[1])
							popView()
						end,
					}
				end
				out[#out + 1] = {
					Name = "Hex...", Sub = "#RRGGBB", Tab = e.Tab, Block = e.Block,
					Run = function()
						local hex = typeof(cur) == "Color3" and cur:ToHex() or ""
						pushView(textInputView(e, hex, "RRGGBB", function(txt)
							local ok, c = pcall(Color3.fromHex, (string.gsub(txt, "#", "")))
							if ok and typeof(c) == "Color3" then
								pcall(function() it.Set(c) end)
								flash(e.Name .. " : #" .. c:ToHex())
							end
						end))
