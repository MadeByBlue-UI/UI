-- ════════════════════════════════════════════════════════════════════════

--- Register an open popup. It closes when the user clicks outside of `frame`
--- and outside of the optional `owner` (the button that opened it).
function Library:OpenPopup(frame, closeFn, owner)
    local entry = { Frame = frame, Close = closeFn, Owner = owner }
    table.insert(self.OpenedPopups, entry)
    return entry
end

function Library:ClosePopup(frame)
    for i = #self.OpenedPopups, 1, -1 do
        local entry = self.OpenedPopups[i]
        if entry.Frame == frame then
            table.remove(self.OpenedPopups, i)
            break
        end
    end
end

function Library:CloseAllPopups(except)
    local list = self.OpenedPopups
    for i = #list, 1, -1 do
        local entry = list[i]
        if entry.Frame ~= except then
            table.remove(list, i)
            self:SafeCallback(entry.Close)
        end
    end
end

Library.Maid:Give(UserInputService.InputBegan:Connect(function(input)
    if not Library:IsClick(input) and not Library:IsRightClick(input) then
        return
    end
    if #Library.OpenedPopups == 0 then
        return
    end
    local point = Library:GetInputPosition(input)
    local list = Library.OpenedPopups
    for i = #list, 1, -1 do
        local entry = list[i]
        local inside = Library:IsPointInside(entry.Frame, point)
        local insideOwner = entry.Owner and Library:IsPointInside(entry.Owner, point)
        if not inside and not insideOwner then
            table.remove(list, i)
            Library:SafeCallback(entry.Close)
        end
    end
end))

--- Keep a popup glued to an anchor (below it by default) and inside the screen.
function Library:PositionPopup(popup, anchor, width, offsetY)
    local scale = self.DPIScale
    local viewport = self:GetViewportSize() / scale
    local anchorPos = anchor.AbsolutePosition / scale
    local anchorSize = anchor.AbsoluteSize / scale
    local popupSize = popup.AbsoluteSize / scale
    width = width or anchorSize.X

    local x = anchorPos.X
    local y = anchorPos.Y + anchorSize.Y + (offsetY or 4)

    if x + width > viewport.X - 6 then
        x = viewport.X - width - 6
    end
    if x < 6 then
        x = 6
    end
    if y + popupSize.Y > viewport.Y - 6 then
        y = anchorPos.Y - popupSize.Y - (offsetY or 4)
    end
    if y < 6 then
        y = 6
    end
    popup.Position = UDim2.fromOffset(x, y)
end

