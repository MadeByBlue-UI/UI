--
--   local n = Library:Notify({
--       Title, Content,
--       Type     = "Info" | "Success" | "Warning" | "Error" | "Loading",
--       Duration = 4            (0 = reste affichée jusqu'à fermeture),
--       Progress = 0..1         (barre de progression, la notif reste jusqu'à 100 % puis passe en « Success »),
--       Loading  = true         (barre indéterminée + spinner),
--       Actions  = { { Text = "Annuler", Callback = function(n) end, Keep = false } },
--       OnClick  = function(n) end,      OnDismiss = function(raison) end,
--       Stack = false (pas de regroupement des doublons),  Force = true (passe même en « Ne pas déranger »),
--       Dismissable = false (pas de fermeture au clic / swipe),
--   })
--   n:Update({ Title, Content, Type, Progress, Duration })   n:SetProgress(0.5)   n:SetTitle("...")
--   n:SetContent("...")   n:SetType("Success")   n:Dismiss()   n:Pause()   n:Resume()   n:IsAlive()
--
--   Library:NotifyInfo / NotifySuccess / NotifyWarning / NotifyError (titre, contenu, durée)
--   Library:NotifyProgress({...})   Library:ClearNotifications()   Library:SetNotifMuted(true)
--   Library:GetNotifHistory() / ClearNotifHistory()   Window:CreateNotifLogTab("Historique")
--   Réglages : Library.NotifColored / NotifPauseOnHover / NotifStack / NotifMax / NotifWidth / NotifColors
-- ============================================================================
local notifGui, notifHolder, notifList
local notifCount = 0
local activeNotifs = {}
local notifEntries = {}
local NOTIF_ICON = { Info = "i", Success = "+", Warning = "!", Error = "x", Loading = "" }
local NOTIF_LOGO = "rbxassetid://5436396975"   -- logo affiché à la place de la pastille blanche (Library.NotifLogo pour le changer)
local NOTIF_LOGO_SIZE = 40                      -- taille du logo en pixels (Library.NotifLogoSize pour changer ; ~44 max avant d'être rogné)
local NOTIF_POS = { TopLeft = true, TopRight = true, TopCenter = true,
	BottomLeft = true, BottomRight = true, BottomCenter = true, Custom = true }

-- Position personnalisée : coin d'ancrage de la pile (fractions de l'écran) + côté. Réglée en glissant une
-- notification test (Paramètres > Notifications > « Placer les notifications »).
--   Library:StartNotifPlacement() · Library:SetNotifCustom({ X, Y, Left, Top }) · Library:ResetNotifCustom()
local function getCustom()
	local c = Library.NotifCustom
	if type(c) == "table" and tonumber(c.X) and tonumber(c.Y) then return c end
	return { X = 0.985, Y = 0.97, Left = false, Top = false }
end

Library.NotifColors = {
	Success = Color3.fromRGB(61, 220, 151),
	Warning = Color3.fromRGB(255, 200, 87),
	Error   = Color3.fromRGB(255, 77, 94),
}
Library.NotifColored      = false  -- false = tout en noir & blanc (défaut) ; true = pastille colorée par type (vert / orange / rouge)
Library.NotifPauseOnHover = true   -- le minuteur se met en pause quand la souris est sur la notification
Library.NotifStack        = true   -- les doublons s'empilent en « x2, x3... » au lieu de se répéter
Library.NotifMax          = 5      -- nombre maximum affiché en même temps
Library.NotifWidth        = 300
Library.NotifMuted        = false  -- « Ne pas déranger » : seules les erreurs passent
Library.NotifHistory      = Library.NotifHistory or {}

-- Position : "TopLeft" | "TopCenter" | "TopRight" | "BottomLeft" | "BottomCenter" | "BottomRight"
local function notifSide()
	local p = tostring(Library.NotifPos or "BottomRight")
	if p == "Custom" then
		local c = getCustom()
		return c.Top ~= false, c.Left == true, false
	end
	local top = p:sub(1, 3) == "Top"
	local center = p:find("Center", 1, true) ~= nil
	local left = (not center) and p:sub(-4) == "Left"
	return top, left, center
end

local function applyNotifPos()
	if not (notifHolder and notifList) then return end
	local top, left, center = notifSide()
	if Library.NotifPos == "Custom" then
		local c, vp = getCustom(), viewport()
		local x, y = math.clamp(c.X, 0, 1) * vp.X, math.clamp(c.Y, 0, 1) * vp.Y
		notifHolder.Size = UDim2.new(0, Library.NotifWidth or 300, 0, math.max(top and (vp.Y - y) or y, 120))
		notifHolder.AnchorPoint = Vector2.new(left and 0 or 1, top and 0 or 1)
		notifHolder.Position = UDim2.fromOffset(x, y)
		notifList.VerticalAlignment = top and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom
		notifList.HorizontalAlignment = left and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right
		return
	end
	notifHolder.Size = UDim2.new(0, Library.NotifWidth or 300, 1, -32)
	if center then
		notifHolder.AnchorPoint = Vector2.new(0.5, top and 0 or 1)
		notifHolder.Position = UDim2.new(0.5, 0, top and 0 or 1, top and 16 or -16)
	else
		notifHolder.AnchorPoint = Vector2.new(left and 0 or 1, top and 0 or 1)
		notifHolder.Position = UDim2.new(left and 0 or 1, left and 16 or -16, top and 0 or 1, top and 16 or -16)
	end
	notifList.VerticalAlignment = top and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom
	notifList.HorizontalAlignment = center and Enum.HorizontalAlignment.Center
		or (left and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right)
end

local function ensureNotif()
	if notifGui and notifGui.Parent then
		if Library.NotifPos == "Custom" then applyNotifPos() end   -- suit la taille de l'écran
		return
	end
	notifGui = new("ScreenGui", { Name = "SolarisNotify", ResetOnSpawn = false, DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
	mount(notifGui)
	notifHolder = new("Frame", {
		Size = UDim2.new(0, Library.NotifWidth or 300, 1, -32), BackgroundTransparency = 1,
	}, notifGui)
	notifList = new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = BYORDER }, notifHolder)
	applyNotifPos()
end

function Library:SetNotifPosition(p)
	if NOTIF_POS[p] then
		Library.NotifPos = p
		applyNotifPos()
	end
end

function Library:SetNotifCustom(c)
	if type(c) ~= "table" or not (tonumber(c.X) and tonumber(c.Y)) then return false end
	Library.NotifCustom = { X = math.clamp(tonumber(c.X), 0, 1), Y = math.clamp(tonumber(c.Y), 0, 1),
		Left = c.Left == true, Top = c.Top ~= false }
	Library.Flags["ui.notifcustom"] = copyVal(Library.NotifCustom)
	if notifHolder then applyNotifPos() end
	return true
end
function Library:ResetNotifCustom()
	Library.NotifCustom = nil
	Library.Flags["ui.notifcustom"] = nil
	if notifHolder then applyNotifPos() end
end
Library._registerNotifCustom = function()
	if Library.NotifCustom then Library.Flags["ui.notifcustom"] = copyVal(Library.NotifCustom) end
	Library.Items["ui.notifcustom"] = {
		Get = function() return Library.NotifCustom end,
		Set = function(_, c) Library:SetNotifCustom(c) end,
	}
end

-- Placement à la main : une notification test reste à l'écran, tu la glisses où tu veux, puis « Valider ».
local placeGui
function Library:StartNotifPlacement()
	if placeGui and placeGui.Parent then return end
	local gui = new("ScreenGui", { Name = "SolarisNotifPlace", ResetOnSpawn = false, DisplayOrder = 1003,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
	mount(gui)
	placeGui = gui
	local vp = viewport()
	local w, h = Library.NotifWidth or 300, 118
	local BLACK = Color3.new(0, 0, 0)

	local dim = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1,
		BorderSizePixel = 0 }, gui)
	tween(dim, { BackgroundTransparency = 0.55 }, 0.3)
	local hint = new("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 28),
		Size = UDim2.fromOffset(math.min(vp.X - 30, 420), 40), BackgroundTransparency = 1, TextWrapped = true,
		Text = "Glisse la notification à l'endroit voulu, puis clique sur Valider.", TextColor3 = T.Text,
		TextSize = 14, Font = F_MED, TextTransparency = 1 }, gui)
	tween(hint, { TextTransparency = 0 }, 0.4)

	-- position de départ : celle des notifications actuelles
	local top, left, center = notifSide()
	local cx = center and vp.X / 2 or (left and (16 + w / 2) or (vp.X - 16 - w / 2))
	local cy = top and (16 + h / 2) or (vp.Y - 16 - h / 2)
	if Library.NotifPos == "Custom" then
		local c = getCustom()
		local px, py = c.X * vp.X, c.Y * vp.Y
		cx = left and (px + w / 2) or (px - w / 2)
		cy = top and (py + h / 2) or (py - h / 2)
	end
	local pos = Vector2.new(cx, cy)
	local function clampPos(p)
		return Vector2.new(math.clamp(p.X, w / 2, math.max(vp.X - w / 2, w / 2)), math.clamp(p.Y, h / 2, math.max(vp.Y - h / 2, h / 2)))
	end
	pos = clampPos(pos)

	local card = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(pos.X, pos.Y),
		Size = UDim2.fromOffset(w, h), BackgroundColor3 = T.Main, BackgroundTransparency = 0.03, BorderSizePixel = 0,
		Active = true }, gui)
	new("UICorner", { CornerRadius = UDim.new(0, 22) }, card)
	local cst = new("UIStroke", { Color = T.Accent, Thickness = 1.5, Transparency = 0.35, ApplyStrokeMode = BORDER }, card)
	local sc = new("UIScale", { Scale = 0.85 }, card)
	tween(sc, { Scale = 1 }, 0.5, BACK)
	local ico = new("Frame", { Position = UDim2.fromOffset(14, 13), Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 1, BorderSizePixel = 0 }, card)
	new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(Library.NotifLogoSize or NOTIF_LOGO_SIZE, Library.NotifLogoSize or NOTIF_LOGO_SIZE),
		BackgroundTransparency = 1, BorderSizePixel = 0, Image = Library.NotifLogo or NOTIF_LOGO, ScaleType = Enum.ScaleType.Fit }, ico)
	label(card, "Notification test", 14, { Font = F_BOLD, Position = UDim2.fromOffset(56, 13), Size = UDim2.new(1, -72, 0, 18) })
	label(card, "Les notifications apparaîtront ici.", 12, { Position = UDim2.fromOffset(56, 33), Size = UDim2.new(1, -72, 0, 16),
		TextColor3 = T.ElementAccent })

	local function btn(text, x, wd)
		local b = new("TextButton", { Position = UDim2.new(0, x, 1, -38), Size = UDim2.fromOffset(wd, 26),
			BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, Text = text, TextColor3 = T.Text, TextSize = 12,
			Font = F_MED, AutoButtonColor = false, BorderSizePixel = 0 }, card)
		new("UICorner", { CornerRadius = UDim.new(0, 13) }, b)
		b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.76 }, 0.15) end)
		b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = 0.9 }, 0.2) end)
		return b
	end
	local bw = math.floor((w - 28 - 12) / 3)
	local okB = btn("Valider", 14, bw)
	okB.BackgroundColor3, okB.BackgroundTransparency, okB.TextColor3 = T.Accent, 0.1, T.Main
	local resetB = btn("Défaut", 14 + bw + 6, bw)
	local cancelB = btn("Annuler", 14 + (bw + 6) * 2, bw)

	local closing = false
	local function close()
		if closing then return end
		closing = true
		tween(dim, { BackgroundTransparency = 1 }, 0.25)
		tween(hint, { TextTransparency = 1 }, 0.2)
		tween(sc, { Scale = 0.85 }, 0.25)
		tween(card, { BackgroundTransparency = 1 }, 0.25)
		tween(cst, { Transparency = 1 }, 0.25)
		task.delay(0.3, function() gui:Destroy() end)
	end

	card.InputBegan:Connect(function(i)
		if not isPress(i) or closing then return end
		local start = Vector2.new(i.Position.X, i.Position.Y)
		local origin = pos
		tween(cst, { Transparency = 0.05 }, 0.15)
		startDrag(function(p)
			pos = clampPos(origin + (Vector2.new(p.X, p.Y) - start))
			card.Position = UDim2.fromOffset(pos.X, pos.Y)
		end, nil, i.Position, function() tween(cst, { Transparency = 0.35 }, 0.25) end)
	end)

	okB.MouseButton1Click:Connect(function()
		local l, t = pos.X < vp.X / 2, pos.Y < vp.Y / 2
		local x = l and (pos.X - w / 2) or (pos.X + w / 2)
		local y = t and (pos.Y - h / 2) or (pos.Y + h / 2)
		Library:SetNotifCustom({ X = x / vp.X, Y = y / vp.Y, Left = l, Top = t })
		Library:SetNotifPosition("Custom")
		local it = Library.Items["ui.notifpos"]
		if it and it.Set then pcall(it.Set, it, Library.Names.NotifPos.Custom) end
		close()
		task.delay(0.35, function()
			Library:Notify({ Title = "Position enregistrée", Content = "Les notifications apparaîtront ici.",
				Type = "Success", Duration = 3 })
		end)
	end)
	resetB.MouseButton1Click:Connect(function()
		pos = clampPos(Vector2.new(vp.X - 16 - w / 2, vp.Y - 16 - h / 2))
		tween(card, { Position = UDim2.fromOffset(pos.X, pos.Y) }, 0.4)
	end)
	cancelB.MouseButton1Click:Connect(close)
end

function Library:SetNotifDuration(d)
	Library.NotifDuration = math.clamp(tonumber(d) or 4, 1, 30)
