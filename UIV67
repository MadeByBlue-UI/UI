function Library:ResolveIcon(icon)
    if not icon then
        return nil
    end
    local mapped = self.Icons[icon]
    if mapped then
        return { Text = mapped }
    end
    if type(icon) == "number" then
        return { Image = "rbxassetid://" .. icon }
    end
    if type(icon) == "string" and (icon:find("rbxasset") or icon:find("http")) then
        return { Image = icon }
    end
    return { Text = tostring(icon):sub(1, 2) }
end

function Library:CreateIcon(parent, icon, size, zindex)
    local resolved = self:ResolveIcon(icon)
    if not resolved then
        return nil
    end
    if resolved.Image then
        return self:Create("ImageLabel", {
            Size = UDim2.fromOffset(size, size),
            Image = resolved.Image,
            ZIndex = zindex or 5,
            ["@ImageColor3"] = "AccentColor",
            Parent = parent,
        })
    end
    return self:Create("TextLabel", {
        Size = UDim2.fromOffset(size, size),
        Text = resolved.Text,
        TextSize = size - 2,
        Font = Enum.Font.GothamBold,
        ZIndex = zindex or 5,
        ["@TextColor3"] = "AccentColor",
        Parent = parent,
    })
end

