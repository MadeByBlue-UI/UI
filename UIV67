			Default = Library.NotifSilenceButton ~= false,
			Tooltip = "Propose de masquer une notification qui se répète (à partir de la 2e fois).",
			Callback = function(v) Library.NotifSilenceButton = v and true or false end })
		local list = Library.Flags["ui.silenced"] or {}
		if #list == 0 then
			NS:CreateParagraph({ Title = "Aucune notification masquée",
				Content = "Quand une notification se répète (x2), un bouton « Ne plus afficher » apparaît dessus." })
		else
			NS:CreateParagraph({ Title = #list .. (#list > 1 and " notifications masquées" or " notification masquée"),
				Content = "Clique sur « Réactiver » pour les revoir." })
			for _, e in ipairs(list) do
				local f = makeRow(NS, 42, e.Title)
				label(f, tostring(e.Title or "Notification"), 13, { Position = UDim2.new(0, 12, 0, 4), Size = UDim2.new(1, -108, 0, 18) })
				label(f, tostring(e.Content or ""), 10, { Position = UDim2.new(0, 12, 0, 23), Size = UDim2.new(1, -108, 0, 14),
					TextColor3 = T.ElementAccent, TextTransparency = 0.2 })
				local b = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
					Size = UDim2.new(0, 84, 0, 26), BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0,
					Text = "Réactiver", TextColor3 = T.Text, TextSize = 12, Font = F_MED, AutoButtonColor = false }, f)
				corner(b, 6)
				trackStyled(b, stroke(b, 0.9), "input")
				b.MouseButton1Click:Connect(function() Library:UnsilenceNotif(e.Key) end)
			end
			NS:CreateButton({ Name = "Tout réactiver", Favorite = false, Callback = function() Library:UnsilenceAllNotifs() end })
		end
		nsBuilding = false
	end
	Library._onSilencedChanged = function()
		if nsQueued then return end
		nsQueued = true
