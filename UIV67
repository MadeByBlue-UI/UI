function Library:SetFont(name)
	local fam = FONT_FAMILIES[name]
	if not fam then return end
	local base = { F_REG, F_MED, F_BOLD }
	local fonts = {}
	for i = 1, 3 do
		local ok, f = pcall(function() return Enum.Font[fam[i]] end)
		fonts[i] = (ok and f) or base[i]
	end
	Library.FontFamily = name
	Library.Fonts = (name ~= "Gotham") and fonts or nil
	local use = Library.Fonts or base
	for _, root in ipairs(guiRoots()) do
		for _, d in ipairs(root:GetDescendants()) do
			if TEXTCLASS[d.ClassName] then
				local r = d:GetAttribute("FontRole")
				if r then d.Font = use[r] end
			end
		end
	end
end

