	local function buildRow(e, idx)
		local b = BUILD[e.Kind]
		if not b then return nil end
		local f, st, sc = newCard(S.list, idx)
		local ok, primary = pcall(b, f, e)
		if not ok then
			f:Destroy()
			warn("[Ui-Lib] Spotlight : " .. tostring(primary))
			return nil
		end
		f.MouseEnter:Connect(function() uiSnd("hover") tween(st, { Transparency = 0.5 }, 0.2) end)
		f.MouseLeave:Connect(function() tween(st, { Transparency = 0.86 }, 0.3) end)
		task.delay((idx - 1) * 0.035, function()
			if f.Parent then tween(sc, { Scale = 1 }, 0.45, BACK) end
		end)
		return { frame = f, primary = (type(primary) == "function") and primary or nil }
	end

	local function refresh()
		if not (S.open and S.list and S.list.Parent) then return end
		for _, r in ipairs(S.rows) do
			if r.frame then r.frame:Destroy() end
		end
		S.rows = {}
		local out, cap = results(S.box.Text)
		for i, e in ipairs(out) do
			local r = buildRow(e, i)
			if r then S.rows[#S.rows + 1] = r end
		end
		S.caption.Text = cap
		S.list.CanvasPosition = Vector2.new(0, 0)
	end

	-- ───────────── Fermeture ─────────────
	local function escape()
		if S.capture then S.capture() return end
		if S.box and S.box.Text ~= "" then
			S.box.Text = ""
			return
		end
		Library:CloseSpotlight()
	end

	local function casHandler(_, state, input)
		if not S.open then return PASS end
		if state == Enum.UserInputState.Begin and input.KeyCode == KC.Escape then escape() end
		return SINK
	end

	local function teardown(sess)
		pcall(function() if sess.hb then sess.hb:Disconnect() end end)
		for _, tw in ipairs(sess.tweens) do pcall(function() tw:Cancel() end) end
		pcall(function() sess.gui:Destroy() end)
	end

	function Library:CloseSpotlight()
		if not S.open then return end
		S.open = false
		uiSnd("spotclose")
		if S.capture then pcall(S.capture) end
		pcall(function() CAS:UnbindAction("UiLibSpotlight") end)
		Library:ReleaseCursor("spotlight")
		if S.box then pcall(function() S.box:ReleaseFocus() end) end
		local sess = S.sess
		if sess then
			sess.target = 0
			if S.ui and canvasSupported then tween(S.ui, { GroupTransparency = 1 }, 0.25) end
			if S.barScale then tween(S.barScale, { Scale = 0.92 }, 0.3) end
			if S.dim then tween(S.dim, { BackgroundTransparency = 1 }, 0.35) end
			if S.stageScale then tween(S.stageScale, { Scale = 0 }, 0.4, QUINT, IN) end
			task.delay(0.5 / math.max(Library.AnimSpeed or 1, 0.05) + 0.05, function()
				teardown(sess)
				if S.sess == sess then
					S.sess = nil
					S.box, S.list, S.caption, S.ui, S.barScale, S.dim, S.stageScale = nil, nil, nil, nil, nil, nil, nil
				end
			end)
		end
		S.rows = {}
		-- la fenêtre revient si elle était ouverte (ou si on a demandé « Ouvrir l'interface »)
		local w = Library.Window
		local reopen = S.hid or S.openAfter
		S.hid, S.openAfter = false, false
		if reopen and w and w.Toggle then Library._quietWin = true w:Toggle(true) Library._quietWin = false end
		pcall(setBlurTarget, (w and w.Open) and Library.BlurSize or 0)
	end

	-- ───────────── Ouverture ─────────────
	function Library:OpenSpotlight()
		if S.open or not Library.SpotlightEnabled then return end
		if Library.IsPaletteOpen and Library:IsPaletteOpen() then Library:ClosePalette() end
		S.open = true
		uiSnd("spotopen")
		S.openAt = os.clock()
		S.capture = nil
		S.rows = {}
		S.openAfter = false

		local w = Library.Window
		S.hid = false
		if Library.SpotlightHideWindow and w and w.Open then
			S.hid = true
			Library._quietWin = true
			w:Toggle(false)
			Library._quietWin = false
		end
		pcall(setBlurTarget, Library.BlurSize or 0)

		local vp = viewport()
		local vw, vh = vp.X, vp.Y
		local barW = math.clamp(vw - 40, 280, 620)
		local barY = math.clamp(math.floor(vh * 0.22), 64, 200)
		S.barW = barW

		local gui = new("ScreenGui", { Name = "SolarisSpotlight", ResetOnSpawn = false, DisplayOrder = 1002,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
		mount(gui)
		local sess = { gui = gui, tweens = {}, fade = 0, target = 1, stars = {} }
		S.sess = sess

		-- voile noir (bouton « Modal » : libère aussi le curseur en vue première personne) ; clic dehors = fermer
		local dim = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0 }, gui)
		dim.MouseButton1Click:Connect(function() Library:CloseSpotlight() end)
		tween(dim, { BackgroundTransparency = 0.1 }, 0.35)
		S.dim = dim

		-- trou noir : anneaux d'accrétion inclinés + horizon des événements, centrés sur la barre
		local stage = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, barY),
			Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, BorderSizePixel = 0 }, gui)
		local stageScale = new("UIScale", { Scale = 0 }, stage)
		S.stageScale = stageScale
		tween(stageScale, { Scale = math.clamp(vw / 1100, 0.5, 1.1) }, 0.8, BACK)
		local ringCol = ColorSequence.new(T.Accent, T.Accent:Lerp(Color3.new(0, 0, 0), 0.55))
		local function orbit(w0, h0, thick, tr, rot, dur, parent)
			local fr = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0),
				Size = UDim2.fromOffset(w0, h0), BackgroundTransparency = 1, BorderSizePixel = 0, Rotation = rot }, parent or stage)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, fr)
			local st = new("UIStroke", { Color = T.Accent, Thickness = thick, Transparency = tr, ApplyStrokeMode = BORDER }, fr)
			local g = new("UIGradient", { Color = ringCol, Transparency = ringSeq() }, st)
			local tw = TweenService:Create(g, TweenInfo.new(math.abs(dur), LINEAR, OUT, -1),
				{ Rotation = (dur > 0) and 360 or -360 })
			tw:Play()
			sess.tweens[#sess.tweens + 1] = tw
			return fr
		end
		orbit(980, 320, 1, 0.78, -7, 26)
		orbit(760, 250, 1.5, 0.55, -7, -17)
		orbit(560, 180, 2, 0.35, -7, 11)
		local core = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0),
			Size = UDim2.fromOffset(170, 170), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, stage)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, core)
		local cst = new("UIStroke", { Color = T.Accent, Thickness = 2.5, Transparency = 0.1, ApplyStrokeMode = BORDER }, core)
		local cg = new("UIGradient", { Color = ringCol, Transparency = ringSeq() }, cst)
		local ctw = TweenService:Create(cg, TweenInfo.new(8, LINEAR, OUT, -1), { Rotation = 360 })
		ctw:Play()
		sess.tweens[#sess.tweens + 1] = ctw
		orbit(232, 232, 1, 0.6, 0, -14)

		-- étoiles qui spiralent vers le trou noir
		local rng = Random.new()
		local R = math.sqrt(vw * vw + vh * vh) * 0.55
		local nStars = math.clamp(math.floor(tonumber(Library.SpotlightStars) or 0), 0, 140)
		for i = 1, nStars do
			local sz = rng:NextInteger(1, 3)
			local sf = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sz, sz),
				BackgroundColor3 = (i % 4 == 0) and Color3.new(1, 1, 1) or T.Accent, BackgroundTransparency = 1,
				BorderSizePixel = 0 }, gui)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, sf)
			sess.stars[i] = { f = sf, rad = rng:NextNumber(40, R), ang = rng:NextNumber(0, math.pi * 2),
				v = rng:NextNumber(4, 16), a = rng:NextNumber(0.4, 0.95), ph = rng:NextNumber(0, 6.28),
				ts = rng:NextNumber(1, 3), dir = (rng:NextInteger(0, 9) == 0) and -1 or 1 }
		end
		sess.hb = Ticker.connect(function(dt)
			sess.fade = sess.fade + (sess.target - sess.fade) * (1 - math.exp(-dt * 5))
			local step = math.min(dt, 0.1)
			local now = os.clock()
			for _, s in ipairs(sess.stars) do
				local rad = s.rad - (s.v + 9000 / (s.rad + 60)) * step
				s.ang = s.ang + (0.04 + 260 / (rad + 100)) * step * s.dir
				if rad < 30 then
					rad = R * (0.75 + math.random() * 0.25)
					s.ang = math.random() * math.pi * 2
				end
				s.rad = rad
				s.f.Position = UDim2.new(0.5, math.cos(s.ang) * rad, 0, barY + math.sin(s.ang) * rad * 0.55)
				local a = s.a * math.clamp((rad - 30) / 90, 0, 1) * math.clamp((R - rad) / 80, 0, 1)
					* (0.75 + 0.25 * math.sin(now * s.ts + s.ph)) * sess.fade
				s.f.BackgroundTransparency = 1 - a
			end
		end, { rate = 30, deco = true })

		-- interface : barre + légende + liste de résultats (au-dessus du fond)
		local ui = new(canvasSupported and "CanvasGroup" or "Frame", { Name = "UI", Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1, BorderSizePixel = 0 }, gui)
		if canvasSupported then
			ui.GroupTransparency = 1
			tween(ui, { GroupTransparency = 0 }, 0.35)
		end
		S.ui = ui

		local bar = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, barY),
			Size = UDim2.fromOffset(barW, 54), BackgroundColor3 = T.Main, BackgroundTransparency = 0.04,
			BorderSizePixel = 0, Active = true }, ui)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
		local bst = new("UIStroke", { Color = T.Accent, Thickness = 1.6, Transparency = 0.2, ApplyStrokeMode = BORDER }, bar)
		local bg = new("UIGradient", { Color = ringCol, Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.15, 0.5), NumberSequenceKeypoint.new(0.3, 0.9),
			NumberSequenceKeypoint.new(0.7, 0.9), NumberSequenceKeypoint.new(0.85, 0.5), NumberSequenceKeypoint.new(1, 0) }) }, bst)
		local btw = TweenService:Create(bg, TweenInfo.new(6, LINEAR, OUT, -1), { Rotation = 360 })
		btw:Play()
		sess.tweens[#sess.tweens + 1] = btw
		local barScale = new("UIScale", { Scale = 0.85 }, bar)
		tween(barScale, { Scale = 1 }, 0.6, BACK)
		S.barScale = barScale

		-- loupe dessinée à la main
		local lens = new("Frame", { Position = UDim2.new(0, 22, 0.5, -9), Size = UDim2.fromOffset(14, 14),
			BackgroundTransparency = 1, BorderSizePixel = 0 }, bar)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, lens)
		new("UIStroke", { Color = T.Text, Thickness = 2, Transparency = 0.15, ApplyStrokeMode = BORDER }, lens)
		local hd = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 37, 0.5, 6),
			Size = UDim2.fromOffset(8, 2), Rotation = 45, BackgroundColor3 = T.Text, BackgroundTransparency = 0.15,
			BorderSizePixel = 0 }, bar)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, hd)

		local showChip = barW >= 360
		local box = new("TextBox", { Position = UDim2.new(0, 52, 0, 0), Size = UDim2.new(1, showChip and -134 or -68, 1, 0),
			BackgroundTransparency = 1, Text = "", PlaceholderText = "Rechercher un réglage, un bouton, une option...",
			PlaceholderColor3 = Color3.fromRGB(125, 125, 132), TextColor3 = T.Text, TextSize = 17, Font = F_MED,
			ClearTextOnFocus = false, TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd,
			BorderSizePixel = 0 }, bar)
		Library._attachTextFade(box)
		if showChip then
			local chip = new("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0),
				Size = UDim2.fromOffset(56, 24), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, Text = "Échap",
				TextColor3 = T.ElementAccent, TextSize = 10, Font = F_BOLD, BorderSizePixel = 0 }, bar)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, chip)
		end

		local caption = new("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, barY + 38),
			Size = UDim2.fromOffset(barW, 16), BackgroundTransparency = 1, Text = "", TextColor3 = T.ElementAccent,
			TextSize = 11, Font = F_MED, TextXAlignment = CENTER, TextTruncate = Enum.TextTruncate.AtEnd }, ui)

		local listTop = barY + 64
		local list = new("ScrollingFrame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, listTop),
			Size = UDim2.fromOffset(barW, math.max(120, vh - listTop - 20)), BackgroundTransparency = 1,
			BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent, ScrollBarImageTransparency = 0.5,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = AY, Active = true }, ui)
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = BYORDER }, list)
		new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 14) }, list)

		S.box, S.list, S.caption = box, list, caption

		local token = 0
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local txt = box.Text
			-- la touche d'ouverture (ex. « t » de Ctrl+T) ne doit pas s'écrire dans la barre
			if os.clock() - (S.openAt or 0) < 0.3 and #txt == 1 and low(txt) == low(Library.SpotlightKey.Name) then
				box.Text = ""
				return
			end
			token += 1
			local my = token
			task.delay(0.07, function()
				if token == my then refresh() end
			end)
		end)
		box.FocusLost:Connect(function(enter)
			if not (S.open and enter) then return end
			local r = S.rows[1]
			if r and r.primary then r.primary() end
			task.defer(function()
				if S.open and S.box == box then box:CaptureFocus() end
			end)
		end)

		-- Échap : bloqué côté jeu (sinon il ouvre le menu Roblox) ; curseur libre
		pcall(function() CAS:BindActionAtPriority("UiLibSpotlight", casHandler, false, 3000, KC.Escape) end)
		Library:AcquireCursor("spotlight", true)

		refresh()
		task.delay(0.08, function()
			if S.open and S.box == box then box:CaptureFocus() end
		end)
	end

	function Library:ToggleSpotlight()
		if S.open then Library:CloseSpotlight() else Library:OpenSpotlight() end
	end
	function Library:IsSpotlightOpen() return S.open end
	function Library:SetSpotlightEnabled(v)
		Library.SpotlightEnabled = v and true or false
		if not Library.SpotlightEnabled then Library:CloseSpotlight() end
	end
	function Library:SetSpotlightKey(key, needCtrl)
		if typeof(key) == "EnumItem" then Library.SpotlightKey = key end
		if needCtrl ~= nil then Library.SpotlightNeedCtrl = needCtrl and true or false end
	end

	track(UIS.InputBegan:Connect(function(i, processed)
		if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if i.KeyCode ~= Library.SpotlightKey then return end
		if Library.SpotlightNeedCtrl and not ctrlDown() then return end
		if S.open then
			if S.capture then return end
			if not Library.SpotlightNeedCtrl and S.box and S.box:IsFocused() then return end
			Library:CloseSpotlight()
			return
		end
		if processed or Library._listening or not Library.SpotlightEnabled then return end
		Library:OpenSpotlight()
	end))

	Library._destroySpotlight = function()
		S.open = false
		pcall(function() CAS:UnbindAction("UiLibSpotlight") end)
		Library:ReleaseCursor("spotlight")
		if S.sess then teardown(S.sess) end
		S.sess, S.box, S.list, S.caption, S.ui, S.barScale, S.dim, S.stageScale = nil, nil, nil, nil, nil, nil, nil, nil
		S.rows = {}
	end
end)
if not spotOk then warn("[Ui-Lib] Barre de recherche indisponible : " .. tostring(spotErr)) end

-- ============================================================================
-- FENÊTRE
-- ============================================================================
function Library:CreateWindow(cfg)
	cfg = cfg or {}
	if cfg.Theme then
		for k, v in pairs(cfg.Theme) do T[k] = v end
	end
	refreshTheme()
	snapshotColors()
	if cfg.Shape then Library.Shape = (cfg.Shape == "Vague") and "Arrondie" or cfg.Shape end
	if cfg.Style and STYLES[cfg.Style] then Library:SetStyle(cfg.Style) end
	if cfg.LayoutStyle and Library.LayoutStyleInfo[cfg.LayoutStyle] then Library.LayoutStyle = cfg.LayoutStyle end
	if type(cfg.Eclipse) == "table" then
		for k, v in pairs(cfg.Eclipse) do
			if Library.Eclipse[k] ~= nil then Library.Eclipse[k] = v end
		end
	end
	if cfg.Blur ~= nil then Library.BlurSize = math.clamp(tonumber(cfg.Blur) or 0, 0, 56) end
	local transp = tonumber(cfg.Transparency) or 0.04
	Library.ConfigFolder = cfg.ConfigFolder or Library.ConfigFolder or "Ui-Lib"
	if cfg.Animations ~= nil then Library.Animations = cfg.Animations and true or false end
	if cfg.AnimSpeed then Library.AnimSpeed = math.clamp(tonumber(cfg.AnimSpeed) or 1, 0.25, 4) end
	if cfg.WindowAnim ~= nil then Library.WindowAnim = cfg.WindowAnim and true or false end
	if cfg.LockPosition ~= nil then Library.LockPosition = cfg.LockPosition and true or false end
	if cfg.ToggleStyle and TOGGLE_STYLES[cfg.ToggleStyle] then Library.ToggleStyle = cfg.ToggleStyle end
	if cfg.FreeCursor ~= nil then Library.FreeCursor = cfg.FreeCursor and true or false end
	if cfg.BlockGameKeys ~= nil then Library.BlockGameKeys = cfg.BlockGameKeys and true or false end
	if type(cfg.BlockedKeys) == "table" then Library.BlockedKeys = cfg.BlockedKeys end

	-- Nettoie une ancienne instance (relance du script)
	for _, p in ipairs({ CoreGui, LP:FindFirstChild("PlayerGui") }) do
		local old = p and p:FindFirstChild("SolarisUI")
		if old then old:Destroy() end
	end
	if cfg.ConfigFolder then
		pcall(function()
			if makefolder and isfolder and not isfolder(cfg.ConfigFolder) then makefolder(cfg.ConfigFolder) end
		end)
	end

	-- Taille / position (la fenêtre ne dépasse jamais de l'écran)
	local vp   = viewport()
	local size = cfg.Size or UDim2.new(0, 480, 0, 560)
	local W = math.min(size.X.Offset + size.X.Scale * vp.X, vp.X - 16)
	local H = math.min(size.Y.Offset + size.Y.Scale * vp.Y, vp.Y - 16)
	local W0, H0 = W, H
	local center
	if cfg.Position then
		local pos = cfg.Position
		center = Vector2.new(pos.X.Offset + pos.X.Scale * vp.X + W / 2, pos.Y.Offset + pos.Y.Scale * vp.Y + H / 2)
	else
		center = vp / 2
	end
	local minW = (cfg.MinSize and cfg.MinSize.X) or 380
	local minH = (cfg.MinSize and cfg.MinSize.Y) or 320

	-- Position + taille mémorisées automatiquement entre deux lancements (fichier <ConfigFolder>/_window.json)
	local remember = cfg.RememberLayout ~= false
	local layoutFile = Library.ConfigFolder .. "/_window.json"
	if remember then
		pcall(function()
			if isfile and readfile and isfile(layoutFile) then
				local d = HttpService:JSONDecode(readfile(layoutFile))
				if type(d) == "table" and tonumber(d.w) and tonumber(d.h) then
					W = math.clamp(math.floor(d.w), minW, math.max(minW, vp.X - 16))
					H = math.clamp(math.floor(d.h), minH, math.max(minH, vp.Y - 16))
					center = Vector2.new(
						math.clamp((tonumber(d.cx) or 0.5) * vp.X, 90, vp.X - 90),
						math.clamp((tonumber(d.cy) or 0.5) * vp.Y, H / 2, vp.Y - 40 + H / 2)
					)
				end
			end
		end)
	end

	local gui = new("ScreenGui", { Name = "SolarisUI", ResetOnSpawn = false, DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
	mount(gui)

	-- ------------------------------------------------------------------
	-- Ciel : étoiles qui rebondissent sur les bords de l'écran, DERRIÈRE la fenêtre.
	-- Créé AVANT la fenêtre = dessiné derrière. La logique est plus bas (boucle Heartbeat).
	-- ------------------------------------------------------------------
	local sky = new("Frame", { Name = "Sky", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, Visible = false }, gui)
	local refreshSky       -- défini plus bas
	local skyTarget = 1    -- 1 = visible (fenêtre ouverte), 0 = s'éteint en fondu

	-- CanvasGroup = fondu d'ouverture, mais coûteux. NoCanvasGroup = true -> simple Frame, beaucoup plus fluide.
	local useCanvas = canvasSupported and not cfg.NoCanvasGroup and not Library.NoCanvasGroup
	local main = new(useCanvas and "CanvasGroup" or "Frame", {
		Name = "MainBackground", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(W, H),
		Position = UDim2.fromOffset(center.X, center.Y), BackgroundColor3 = T.Main,
		BackgroundTransparency = 1 - (1 - transp) * Sty.WinAlpha, BorderSizePixel = 0, ClipsDescendants = true,
		Active = true, -- absorbe les clics : rien de ce qui est fait dans l'UI n'est transmis au jeu
	}, gui)
	local mainCorner = corner(main, 26)
	local mainEntry = Library.CornerObjects[#Library.CornerObjects]
	local uiScale = new("UIScale", { Scale = 1 }, main)
	local scaleBase = 1

	-- ------------------------------------------------------------------
	-- Etat de la fenêtre : position / taille lissées
	-- ------------------------------------------------------------------
	local curPos, tgtPos = center, nil
	local curSize, tgtSize = Vector2.new(W, H), nil
	local lastSize = Vector2.new(W, H)
	-- Taille « dépliée » de référence : jamais déduite d'une taille intermédiaire d'animation.
	-- Elle ne change que par un vrai redimensionnement, ApplyLayout, Reset ou SetColumns.
	local fullSize = Vector2.new(W, H)
	local rsDir = Vector2.new(0, 0)   -- bord fixe lors d'un redimensionnement (0 = centre, 1 = haut/gauche fixe, -1 = bas/droite fixe)
	local rsSmooth = false            -- true = animation lissée (réduction, reset), false = suit directement le curseur
	local collapsed, preSize = false, nil
	local setMinimized
	local ec = { collapsedH = 44 }   -- tout ce qui concerne le type d'interface « Éclipse » (une seule variable locale)
	local statsOn = cfg.ShowStats ~= false

	local function clampCenter(c)
		local v = viewport()
		local w, h = main.Size.X.Offset * scaleBase, main.Size.Y.Offset * scaleBase
		return Vector2.new(
			math.clamp(c.X, 90 - w / 2, v.X - 90 + w / 2),
			math.clamp(c.Y, h / 2, v.Y - 40 + h / 2)
		)
	end
	local function setMainPos()
		main.Position = UDim2.fromOffset(math.floor(curPos.X + 0.5), math.floor(curPos.Y + 0.5))
	end
	local function applySize(sz)
		-- tailles paires + positions entières = pas de tremblement
		local nw = math.floor(sz.X / 2 + 0.5) * 2
		local nh = math.floor(sz.Y / 2 + 0.5) * 2
		local ns = Vector2.new(nw, nh)
		if ns == lastSize then return false end
		local shift = (ns - lastSize) * scaleBase * rsDir / 2
		curPos = curPos + shift
		-- si un déplacement lissé est en cours, sa cible suit le même décalage : sinon elle « rattrape » la fenêtre
		-- et le bord censé rester fixe (haut lors d'une réduction) glisse tout seul
		if tgtPos then tgtPos = tgtPos + shift end
		lastSize = ns
		main.Size = UDim2.fromOffset(nw, nh)
		-- taille finale (aucune animation lissée en cours) et fenêtre dépliée : c'est la nouvelle taille de référence
		if not collapsed and not tgtSize then fullSize = ns end
		return true
	end
	local persistReady = false
	local function saveWin()
		local v = viewport()
		-- on sauvegarde l'état FINAL (pas une taille intermédiaire d'animation) et, si la fenêtre est réduite,
		-- la taille / le centre de la fenêtre dépliée (bord haut fixe)
		local p = tgtPos or curPos
		local sz = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
		if tgtSize and rsSmooth then
			p = p + (tgtSize - lastSize) * scaleBase * rsDir / 2
			sz = tgtSize
		end
		if collapsed then
			p = Vector2.new(p.X, p.Y + (fullSize.Y - sz.Y) * scaleBase / 2)
			sz = fullSize
		end
		Library.Flags["__window"] = {
			cx = p.X / v.X, cy = p.Y / v.Y,
			w = sz.X, h = sz.Y,
		}
		if remember and persistReady and writefile then
			pcall(function()
				if makefolder and isfolder and not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
				writefile(layoutFile, HttpService:JSONEncode(Library.Flags["__window"]))
			end)
		end
	end
	local function saveWinLater() task.delay(0.5, saveWin) end

	-- ------------------------------------------------------------------
	-- Fond : trou noir + étoiles (derrière tout le reste)
	-- ------------------------------------------------------------------
	local space = new("Frame", { Name = "Space", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		ClipsDescendants = true, BorderSizePixel = 0 }, main)
	-- Style « Verre » : voile de lumière + reflet qui balaie la vitre (visibles seulement dans les styles de verre)
	local sheen = new("Frame", { Name = "GlassSheen", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, Visible = false }, main)
	sheen:SetAttribute("NoAccent", true)
	corner(sheen, 26)
	local sheenEntry = Library.CornerObjects[#Library.CornerObjects]
	new("UIGradient", { Rotation = 35, Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.82), NumberSequenceKeypoint.new(0.4, 0.94),
		NumberSequenceKeypoint.new(0.7, 1), NumberSequenceKeypoint.new(1, 0.95) }) }, sheen)
	local glint = new("Frame", { Name = "GlassGlint", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, Visible = false }, main)
	glint:SetAttribute("NoAccent", true)
	corner(glint, 26)
	local glintEntry = Library.CornerObjects[#Library.CornerObjects]
	local glintGrad = new("UIGradient", { Rotation = 20, Offset = Vector2.new(-1, 0), Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.42, 1), NumberSequenceKeypoint.new(0.5, 0.9),
		NumberSequenceKeypoint.new(0.58, 1), NumberSequenceKeypoint.new(1, 1) }) }, glint)

	local HOLE_POS = {
		TopRight = { 1, -66, 0, 54 }, TopLeft = { 0, 66, 0, 54 }, BottomRight = { 1, -66, 1, -54 },
		BottomLeft = { 0, 66, 1, -54 }, Center = { 0.5, 0, 0.5, 0 },
	}
	local function holePos()
		local p = HOLE_POS[Library.HolePos] or HOLE_POS.Center
		return UDim2.new(p[1], p[2], p[3], p[4])
	end
	local function holeCenter(w, h)
		local p = HOLE_POS[Library.HolePos] or HOLE_POS.Center
		return p[1] * w + p[2], p[3] * h + p[4]
	end
	local hole = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = holePos(),
		Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Visible = Library.HoleVisible ~= false }, space)
	local holeScaleObj = new("UIScale", { Scale = Library.HoleScale or 1 }, hole)

	local function ring(parent, w, h, thick, tr, speed, rot)
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0, 0),
			Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, Rotation = rot or 0 }, parent)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		local st = new("UIStroke", { Color = T.Accent, Thickness = thick, Transparency = tr, ApplyStrokeMode = BORDER }, f)
		spin(new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(95, 95, 100)),
			Transparency = ringSeq(),
		}, st), speed)
		return f
	end
	ring(hole, 230, 230, 1, 0.82, 14)
	ring(hole, 160, 160, 1.5, 0.62, -22)
	ring(hole, 96, 96, 6, 0.9, 30)
	ring(hole, 250, 36, 1.5, 0.5, 70, -16)   -- disque d'accrétion
	local core = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.fromOffset(60, 60), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, hole)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, core)
	local coreSt = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0.1, ApplyStrokeMode = BORDER }, core)
	spin(new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(70, 70, 75)),
		Transparency = ringSeq() }, coreSt), 110)
	ring(hole, 210, 26, 1, 0.72, -90, -16)

	-- Étoiles aspirées par le trou noir (optionnelles : Library.HoleStars)
	local rng = Random.new()
	local stars = {}
	if cfg.Stars ~= nil then Library.StarCount = math.clamp(math.floor(tonumber(cfg.Stars) or 0), 0, 80) end
	local function respawn(s, w, h, cx, cy)
		for _ = 1, 6 do
			s.x, s.y = rng:NextNumber(0, w), rng:NextNumber(0, h)
			local dx, dy = cx - s.x, cy - s.y
			if dx * dx + dy * dy > 130 * 130 then break end
		end
		s.born = os.clock()
		s.a = rng:NextNumber(0.3, 0.95)
		s.v = rng:NextNumber(4, 12)
	end
	local function addStar()
		local sz = rng:NextInteger(1, 2)
		local f = new("Frame", { Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = T.Accent, BorderSizePixel = 0,
			BackgroundTransparency = 1 }, space)
		local s = { f = f }
		respawn(s, W, H, W - 66, 54)
		s.born = os.clock() - rng:NextNumber(0, 1)
		stars[#stars + 1] = s
	end
	for _ = 1, 22 do addStar() end

	-- Fond animé : "full" (tout), "light" (moitié d'étoiles), "off" (aucun fond, le plus fluide)
	local bgMode = cfg.Background or "light"
	local starLim = #stars
	local function applyBg()
		space.Visible = bgMode ~= "off"
		starLim = (bgMode == "light") and math.ceil(#stars / 2) or #stars
		if Library.HoleVisible == false or not Library.HoleStars then starLim = 0 end
		for n, st in ipairs(stars) do st.f.Visible = n <= starLim end
		if refreshSky then refreshSky() end
	end
	applyBg()

	-- ------------------------------------------------------------------
	-- Barre de titre
	-- ------------------------------------------------------------------
	local titleBar = new("Frame", { Name = "TitleBar", Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1 }, main)
	local dragZone = new("Frame", { Size = UDim2.new(1, -56, 1, 0), BackgroundTransparency = 1 }, titleBar)
	local tx = 16
	if cfg.CustomIcon and cfg.CustomIcon ~= "" then
		ec.logo = new("ImageLabel", { BackgroundTransparency = 1, Image = cfg.CustomIcon, Size = UDim2.new(0, 20, 0, 20),
			Position = UDim2.new(0, 14, 0.5, -10) }, titleBar)
		tx = 42
	else
		-- petit trou noir en guise de logo
		local logo = new("Frame", { Position = UDim2.new(0, 14, 0.5, -9), Size = UDim2.new(0, 18, 0, 18),
			BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, titleBar)
		ec.logo = logo
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, logo)
		local lst = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0.05, ApplyStrokeMode = BORDER }, logo)
		spin(new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(70, 70, 75)),
			Transparency = ringSeq() }, lst), 160)
		tx = 42
	end
	local titleRaw = tostring(cfg.Title or "UI")
	local title = label(titleBar, titleRaw, 16, { TextScaled = true, Position = UDim2.new(0, tx, 0, 0),
		Size = UDim2.new(1, -tx - 190, 1, 0), Font = F_BOLD })
	local titleGrad = new("UIGradient", { Color = Library._titleSeq(T.Accent), Rotation = 12 }, title)
	new("UITextSizeConstraint", { MaxTextSize = 17, MinTextSize = 9 }, title)
	local titleStroke = new("UIStroke", { Color = T.Accent, Thickness = 0.9, Transparency = 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, title)
	Library._titleGrad = titleGrad
	title:SetAttribute("FontRole", nil)   -- le titre a sa propre police

	local hideBtn = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 28, 0, 24), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.93,
		Text = "-", TextColor3 = T.Text, TextSize = 16, Font = F_BOLD, AutoButtonColor = false }, titleBar)
	corner(hideBtn, 7)
	hideBtn.MouseEnter:Connect(function() tween(hideBtn, { BackgroundTransparency = 0.8 }, 0.2) end)
	hideBtn.MouseLeave:Connect(function() tween(hideBtn, { BackgroundTransparency = 0.93 }, 0.25) end)

	-- bouton « tout replier / tout déplier » (onglet courant)
	local foldBtn = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -46, 0.5, 0),
		Size = UDim2.new(0, 28, 0, 24), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.93,
		Text = "=", TextColor3 = T.Text, TextSize = 15, Font = F_BOLD, AutoButtonColor = false }, titleBar)
	corner(foldBtn, 7)
	foldBtn.MouseEnter:Connect(function() tween(foldBtn, { BackgroundTransparency = 0.8 }, 0.2) end)
	foldBtn.MouseLeave:Connect(function() tween(foldBtn, { BackgroundTransparency = 0.93 }, 0.25) end)
	attachTip(foldBtn, "Tout replier / tout déplier (onglet actuel)")

	-- indicateur FPS / ping
	local fpsLabel = label(titleBar, "", 11, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -80, 0.5, 0),
		Size = UDim2.new(0, 104, 0, 16), TextXAlignment = RIGHT, Font = F_REG, TextColor3 = T.ElementAccent,
		Visible = statsOn })
	Library._rollText(fpsLabel)
	-- bouton « Annuler » : à gauche de l'indicateur FPS / ping, visible seulement quand celui-ci l'est
	local undoBtn = new("TextButton", { Name = "UndoButton", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -192, 0.5, 0),
		Size = UDim2.new(0, 58, 0, 24), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.93,
		Text = "Annuler", TextColor3 = T.Text, TextSize = 11, Font = F_MED, AutoButtonColor = false,
		TextTransparency = 0.55, Visible = statsOn }, titleBar)
	corner(undoBtn, 7)
	local undoTok = 0
	Library._undoRefresh = function()
		local has = #Library.UndoStack > 0
		tween(undoBtn, { TextTransparency = has and 0 or 0.55 }, 0.18)
	end
	undoBtn.MouseEnter:Connect(function()
		if #Library.UndoStack > 0 then tween(undoBtn, { BackgroundTransparency = 0.8 }, 0.2) end
		undoTok += 1
		local my = undoTok
		task.delay(0.4, function()
			if undoTok ~= my or not tipLabel then return end
			local n = #Library.UndoStack
			Library._tipShow(n > 0 and ("Annuler : " .. tostring(Library.UndoStack[n].Label) .. "  (Ctrl+Z)") or "Rien à annuler", undoBtn)
		end)
	end)
	undoBtn.MouseLeave:Connect(function()
		tween(undoBtn, { BackgroundTransparency = 0.93 }, 0.25)
		undoTok += 1
		Library._tipHide()
	end)
	undoBtn.MouseButton1Click:Connect(function()
		uiSnd("click")
		Library:Undo()
	end)
	ec.titleLine = fadeLine(main, { Position = UDim2.new(0, 14, 0, 42), Size = UDim2.new(1, -28, 0, 1) })

	-- Tooltip global
	tipLabel = new("TextLabel", { Name = "Tooltip", AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = T.Second, BackgroundTransparency = 1, TextTransparency = 1, TextColor3 = T.Text, TextSize = 12, Font = F_REG,
		TextWrapped = true, TextXAlignment = LEFT, Visible = false, ZIndex = 500, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0) }, gui)
	tipShown = false
	Library._tipCorner = corner(tipLabel, 7)
	Library._tipStroke = stroke(tipLabel, 1)
	new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, tipLabel)
	new("UISizeConstraint", { MaxSize = Vector2.new(300, 400) }, tipLabel)

	-- ------------------------------------------------------------------
	-- Recherche + barre latérale + contenu
	-- ------------------------------------------------------------------
	-- Barre de recherche « verre » : pilule bien arrondie, large et visible, placée dans la barre du titre (voir ec.placeSearch)
	local function glassEdge(parent, tr)
		local st = new("UIStroke", { Color = T.Text, Thickness = 1, Transparency = tr, ApplyStrokeMode = BORDER }, parent)
		new("UIGradient", { Rotation = 40, Transparency = GLASS_EDGE }, st)   -- bord lumineux en haut à gauche, qui s'éteint vers le bas
		return st
	end
	local function roundOf(parent)   -- coins en pilule, gardés ronds même dans le type Carré
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c:SetAttribute("KeepRound", true)
		c.Parent = parent
		return c
	end
	local search = new("TextBox", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 21), Size = UDim2.fromOffset(240, 30),
		BackgroundColor3 = T.Text, BackgroundTransparency = 0.9, Text = "", PlaceholderText = "Rechercher",
		PlaceholderColor3 = Color3.fromRGB(150, 150, 158), TextColor3 = T.Text, TextSize = 13, Font = F_MED,
		ClearTextOnFocus = false, TextXAlignment = LEFT, BorderSizePixel = 0,
	}, main)
	roundOf(search)
	local sst = glassEdge(search, 0.3)
	new("UIPadding", { PaddingLeft = UDim.new(0, 36), PaddingRight = UDim.new(0, 14) }, search)
	Library._attachTextFade(search)
	-- loupe dessinée (le padding décale les enfants : on la recale à gauche)
	local sIcon = new("Frame", { Name = "SearchIcon", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5),
