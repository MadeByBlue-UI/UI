--  Spotlight search (Ctrl+F) — centered search bar over a blurred backdrop
-- ════════════════════════════════════════════════════════════════════════

Library.Spotlight = {
    Enabled = true,
    Blur = true,
    BlurSize = 14,
    DimTransparency = 0.72,
    Open = false,
    Token = 0,
    Results = {},
    Items = {},
    Selected = 1,
}

local KIND_ORDER = { Tab = 1, Group = 2 }

function Library:CollectSpotlightEntries()
    local entries = {}

    for _, tab in ipairs(self.Tabs) do
        if tab.Window and tab.Button and tab.Button.Visible then
            table.insert(entries, {
                Title = tab.Name,
                Sub = "Tab",
                Kind = "Tab",
                Search = string.lower(tab.Name),
                SubSearch = "",
                Tab = tab,
            })
            for _, groupbox in ipairs(tab.Groupboxes or {}) do
                if groupbox.Name and groupbox.Frame and groupbox.UserVisible ~= false then
                    table.insert(entries, {
                        Title = groupbox.Name,
                        Sub = tab.Name,
                        Kind = "Group",
                        Search = string.lower(groupbox.Name),
                        SubSearch = string.lower(tab.Name),
                        Tab = tab,
                        Target = groupbox.Frame,
                    })
                end
            end
        end
    end

    for _, entry in ipairs(self.SearchRegistry) do
        local element = entry.Element
        local owner = entry.Owner
        local target = element and (element.Holder or element.Frame)
        local tab = owner and owner.Tab
        local usable = target and target.Parent and tab and tab.Button and tab.Button.Visible
            and element.UserVisible ~= false
            and not (owner.Type == "DependencyBox" and owner.Satisfied == false)
        if usable then
            local groupName = owner.Groupbox and owner.Groupbox.Name or "Tabbox"
            table.insert(entries, {
                Title = entry.Display or entry.Text,
                Sub = tab.Name .. "  ›  " .. groupName,
                Kind = element.Type or "Item",
                Search = entry.Text,
                SubSearch = string.lower(tab.Name .. " " .. groupName),
                Tab = tab,
                Target = target,
                Owner = owner,
            })
        end
    end

    return entries
end

function Library:QuerySpotlight(query)
    query = string.lower(self:Trim(query or ""))
    local entries = self:CollectSpotlightEntries()
    local results = {}

    if query == "" then
        for _, entry in ipairs(entries) do
            if entry.Kind == "Tab" or entry.Kind == "Group" then
                entry.Score = KIND_ORDER[entry.Kind]
                table.insert(results, entry)
            end
        end
    else
        local words = self:SplitString(query, " ")
        for _, entry in ipairs(entries) do
            local matched = true
            local score = 10
            for index, word in ipairs(words) do
                local position = string.find(entry.Search, word, 1, true)
                local subPosition = string.find(entry.SubSearch, word, 1, true)
                if not position and not subPosition then
                    matched = false
                    break
                end
                if index == 1 then
                    if position == 1 then
                        score = 0
                    elseif position then
                        score = 2 + math.min(position, 20) / 10
                    else
                        score = 6
                    end
                end
            end
            if matched then
                entry.Score = score + (KIND_ORDER[entry.Kind] or 3) * 0.1
                table.insert(results, entry)
            end
        end
    end

    table.sort(results, function(a, b)
        if a.Score ~= b.Score then
            return a.Score < b.Score
        end
        return #a.Title < #b.Title
    end)

    local limited = {}
    for index = 1, math.min(#results, 40) do
        limited[index] = results[index]
    end
    return limited
end

function Library:FlashTarget(target)
    if not target or not target.Parent then
        return
    end
    local overlay = self:Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, 8, 1, 4),
        BackgroundTransparency = 1,
        ZIndex = 40,
        ["@BackgroundColor3"] = "AccentColor",
        Parent = target,
    })
    self:AddCorner(overlay, 6)
    local stroke = self:AddStroke(overlay, "AccentColor", 1.5, 1)

    task.spawn(function()
        for _ = 1, 2 do
            self:Tween(overlay, { BackgroundTransparency = 0.7 }, self.FastTweenInfo)
            self:Tween(stroke, { Transparency = 0.1 }, self.FastTweenInfo)
            task.wait(0.22)
            self:Tween(overlay, { BackgroundTransparency = 1 }, self.TweenInfo)
            self:Tween(stroke, { Transparency = 1 }, self.TweenInfo)
            task.wait(0.28)
        end
        overlay:Destroy()
    end)
end

function Library:SpotlightGo(entry)
    if not entry then
        return
    end
    self:CloseSpotlight()
    self:Toggle(true)

    local tab = entry.Tab
    if tab and tab.Window then
        tab.Window:SelectTab(tab)
    end
    if entry.Owner and entry.Owner.Type == "TabboxTab" and entry.Owner.Groupbox.Select then
        entry.Owner.Groupbox:Select(entry.Owner)
    end

    if entry.Target then
        task.delay(0.15, function()
            local target = entry.Target
            if not target.Parent then
                return
            end
            local scroller = target:FindFirstAncestorOfClass("ScrollingFrame")
            if scroller then
                local delta = (target.AbsolutePosition.Y - scroller.AbsolutePosition.Y) / self.DPIScale
                scroller.CanvasPosition = Vector2.new(0, math.max(0, scroller.CanvasPosition.Y + delta - 24))
            end
            self:FlashTarget(target)
        end)
    end
end

function Library:BuildSpotlight()
    local spotlight = self.Spotlight

    -- Real blur of the game world behind the interface
    local blur = Instance.new("BlurEffect")
    blur.Name = "SingularityBlur"
    blur.Size = 0
    blur.Enabled = false
    pcall(function()
        blur.Parent = GetService("Lighting")
    end)
    self.Maid:Give(blur)
    self.SpotlightBlur = blur

    -- Dim layer: blocks clicks below and closes on outside click
    local layer = self:Create("Frame", {
        Name = "Spotlight",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Active = true,
        ZIndex = 850,
        Parent = self.Root,
    })
    self.SpotlightLayer = layer

    -- Everything fades through this CanvasGroup
    local column = self:Create("CanvasGroup", {
        Name = "Column",
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.2, 0),
        Size = UDim2.new(0.92, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        ZIndex = 851,
        Parent = layer,
    })
    self:Create("UISizeConstraint", { MaxSize = Vector2.new(560, 9999), Parent = column })
    self:AddPadding(column, 16, 16, 16, 16)
    self:AddList(column, 12)
    local columnScale = self:Create("UIScale", { Scale = 0.97, Parent = column })

    -- ── Pill search bar (soft raised look) ───────────────────────────────
    local bar = self:Create("Frame", {
        Name = "Bar",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 52),
        LayoutOrder = 1,
        ZIndex = 852,
        Parent = column,
    })

    local shadow = self:Create("Frame", {
        Name = "Shadow",
        Position = UDim2.fromOffset(4, 5),
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.4,
        ZIndex = 852,
        Parent = bar,
    })
    self:AddCorner(shadow, 9999)

    local light = self:Create("Frame", {
        Name = "Highlight",
        Position = UDim2.fromOffset(-3, -3),
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.92,
        ZIndex = 852,
        Parent = bar,
    })
    self:AddCorner(light, 9999)

    local pill = self:Create("Frame", {
        Name = "Pill",
        Size = UDim2.fromScale(1, 1),
        ZIndex = 855,
        ["@BackgroundColor3"] = "MainColor",
        Parent = bar,
    })
    self:AddCorner(pill, 9999)

    local rim = self:Create("UIStroke", {
        Thickness = 1.2,
        Transparency = 0.3,
        Color = Color3.new(1, 1, 1),
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = pill,
    })
    local rimGradient = self:Create("UIGradient", {
        Color = self.DiskColorSequence(self.Theme),
        Transparency = self.DiskTransparency,
        Parent = rim,
    })
    self:OnThemeChanged(pill, function()
        rimGradient.Color = self.DiskColorSequence(self.Theme)
    end)

    local box = self:Create("TextBox", {
        Name = "Input",
        Position = UDim2.fromOffset(26, 0),
        Size = UDim2.new(1, -86, 1, 0),
        Text = "",
        PlaceholderText = "SEARCH...",
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextSize = self.TextSize + 2,
        ZIndex = 856,
        ["@TextColor3"] = "FontColor",
        ["@PlaceholderColor3"] = "MutedColor",
        Parent = pill,
    })

    -- Magnifier drawn with two frames (no image asset needed)
    local magnifier = self:Create("Frame", {
        Name = "Magnifier",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -26, 0.5, 0),
        Size = UDim2.fromOffset(22, 22),
        BackgroundTransparency = 1,
        ZIndex = 856,
        Parent = pill,
    })
    local ring = self:Create("Frame", {
        Position = UDim2.fromOffset(1, 1),
        Size = UDim2.fromOffset(14, 14),
        BackgroundTransparency = 1,
        ZIndex = 857,
        Parent = magnifier,
    })
    self:AddCorner(ring, 9999)
    self:AddStroke(ring, "MutedColor", 2)
    local handle = self:Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(17.5, 17.5),
        Size = UDim2.fromOffset(8, 2),
        Rotation = 45,
        ZIndex = 857,
        ["@BackgroundColor3"] = "MutedColor",
        Parent = magnifier,
    })
    self:AddCorner(handle, 9999)

    -- ── Results card (fades in only when something is typed) ─────────────
    local card = self:Create("CanvasGroup", {
        Name = "Results",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        Visible = false,
        LayoutOrder = 2,
        ZIndex = 852,
        BackgroundTransparency = 0.08,
        ["@BackgroundColor3"] = "MainColor",
        Parent = column,
    })
    self:AddCorner(card, 18)
    self:AddStroke(card, "OutlineColor", 1)
    self:AddPadding(card, 8, 8, 8, 8)

    -- The list lives inside its own CanvasGroup so every keystroke can
    -- cross-fade the old results into the new ones.
    local fade = self:Create("CanvasGroup", {
        Name = "Fade",
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        GroupTransparency = 0,
        ZIndex = 853,
        Parent = card,
    })

    local results = self:Create("ScrollingFrame", {
        Name = "List",
        Size = UDim2.fromScale(1, 1),
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self.Theme.AccentColor,
        ZIndex = 853,
        Parent = fade,
    })
    self:AddList(results, 2)

    spotlight.Box = box
    spotlight.Column = column
    spotlight.Bar = bar
    spotlight.Card = card
    spotlight.CardScale = columnScale
    spotlight.ResultsShown = false
    spotlight.ResultsToken = 0

    -- ── Fade helpers ─────────────────────────────────────────────────────
    local fadeInfo = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    local function showResults(show)
        if show == spotlight.ResultsShown then
            return
        end
        spotlight.ResultsShown = show
        spotlight.ResultsToken = spotlight.ResultsToken + 1
        local token = spotlight.ResultsToken
        if show then
            card.Visible = true
            self:Tween(card, { GroupTransparency = 0 }, fadeInfo)
        else
            self:Tween(card, { GroupTransparency = 1 }, fadeInfo)
            task.delay(0.3, function()
                if spotlight.ResultsToken == token and not spotlight.ResultsShown then
                    card.Visible = false
                end
            end)
        end
    end

    -- ── Result list handling ─────────────────────────────────────────────
    local function setSelected(index, scrollIntoView)
        local count = #spotlight.Items
        if count == 0 then
            spotlight.Selected = 0
            return
        end
        index = ((index - 1) % count) + 1
        spotlight.Selected = index
        for i, item in ipairs(spotlight.Items) do
            local active = i == index
            self:Tween(item.Button, { BackgroundTransparency = active and 0.88 or 1 }, self.FastTweenInfo)
            self:Tween(item.Bar, { BackgroundTransparency = active and 0 or 1 }, self.FastTweenInfo)
        end
        if scrollIntoView then
            local item = spotlight.Items[index].Button
            local top = item.AbsolutePosition.Y - results.AbsolutePosition.Y
            local bottom = top + item.AbsoluteSize.Y
            local view = results.AbsoluteSize.Y
            if top < 0 then
                results.CanvasPosition = Vector2.new(0, math.max(0, results.CanvasPosition.Y + top / self.DPIScale - 2))
            elseif bottom > view then
                results.CanvasPosition = Vector2.new(0, results.CanvasPosition.Y + (bottom - view) / self.DPIScale + 2)
            end
        end
    end

    local function clearItems()
        for _, item in ipairs(spotlight.Items) do
            item.Button:Destroy()
        end
        spotlight.Items = {}
        for _, child in ipairs(results:GetChildren()) do
            if child:IsA("TextLabel") then
                child:Destroy()
            end
        end
    end

    local softInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local quickInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    -- Builds the rows for the current query and returns (height, count).
    local function populate()
        clearItems()
        spotlight.Results = self:QuerySpotlight(box.Text)
        local count = #spotlight.Results

        if count == 0 then
            self:Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 40),
                Text = "No results",
                ZIndex = 854,
                ["@TextColor3"] = "MutedColor",
                Parent = results,
            })
            spotlight.Selected = 0
            return 44, 0
        end

        for index, entry in ipairs(spotlight.Results) do
            local button = self:Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 42),
                Text = "",
                LayoutOrder = index,
                BackgroundTransparency = 1,
                ZIndex = 854,
                ["@BackgroundColor3"] = "AccentColor",
                Parent = results,
            })
            self:AddCorner(button, 12)

            local selectBar = self:Create("Frame", {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 6, 0.5, 0),
                Size = UDim2.fromOffset(3, 18),
                BackgroundTransparency = 1,
                ZIndex = 856,
                ["@BackgroundColor3"] = "AccentColor",
                Parent = button,
            })
            self:AddCorner(selectBar, 9999)

            self:Create("TextLabel", {
                Position = UDim2.fromOffset(20, 5),
                Size = UDim2.new(1, -110, 0, 18),
                Text = entry.Title,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 855,
                ["@TextColor3"] = "FontColor",
                Parent = button,
            })
            self:Create("TextLabel", {
                Position = UDim2.fromOffset(20, 23),
                Size = UDim2.new(1, -110, 0, 14),
                Text = entry.Sub,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextSize = self.TextSize - 3,
                ZIndex = 855,
                ["@TextColor3"] = "MutedColor",
                Parent = button,
            })
            self:Create("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.fromOffset(80, 16),
                Text = string.lower(entry.Kind),
                TextXAlignment = Enum.TextXAlignment.Right,
                TextSize = self.TextSize - 3,
                ZIndex = 855,
                ["@TextColor3"] = "MutedColor",
                Parent = button,
            })

            button.MouseEnter:Connect(function()
                setSelected(index, false)
            end)
            button.MouseButton1Click:Connect(function()
                self:SpotlightGo(entry)
            end)

            table.insert(spotlight.Items, { Button = button, Bar = selectBar, Entry = entry })
        end

        results.CanvasPosition = Vector2.zero
        return math.clamp(count, 1, 6) * 44 + 4, count
    end

    -- Soft update on every keystroke: the old rows fade out, the new rows
    -- slide up and fade in while the card smoothly grows or shrinks.
    local function rebuild()
        spotlight.RebuildToken = (spotlight.RebuildToken or 0) + 1
        local token = spotlight.RebuildToken

        if self:Trim(box.Text) == "" then
            clearItems()
            showResults(false)
            return
        end

        local wasShown = spotlight.ResultsShown

        local function apply()
            if token ~= spotlight.RebuildToken or not spotlight.Open then
                return
            end
            local height, count = populate()
            if not wasShown then
                fade.Size = UDim2.new(1, 0, 0, height)
            end
            fade.Position = UDim2.fromOffset(0, 6)
            self:Tween(fade, {
                Size = UDim2.new(1, 0, 0, height),
                Position = UDim2.fromOffset(0, 0),
                GroupTransparency = 0,
            }, softInfo)
            if count > 0 then
                setSelected(1, false)
            end
            showResults(true)
        end

        if wasShown then
            self:Tween(fade, { GroupTransparency = 1 }, quickInfo)
            task.delay(0.1, apply)
        else
            fade.GroupTransparency = 1
            apply()
        end
    end

    spotlight.Rebuild = rebuild
    spotlight.SetSelected = setSelected
    spotlight.ShowResults = showResults

    box:GetPropertyChangedSignal("Text"):Connect(function()
        if spotlight.Open then
            rebuild()
        end
    end)

    box.FocusLost:Connect(function(enterPressed)
        if enterPressed and spotlight.Open then
            local item = spotlight.Items[spotlight.Selected]
            if item then
                self:SpotlightGo(item.Entry)
            end
        end
    end)

    layer.InputBegan:Connect(function(input)
        if not self:IsClick(input) then
            return
        end
        local overBar = self:IsMouseOver(bar)
        local overCard = card.Visible and self:IsMouseOver(card)
        if not overBar and not overCard then
            self:CloseSpotlight()
        end
    end)

    -- Slow rim rotation (only while open)
    self:AddAnimation(function(dt)
        if spotlight.Open then
            rimGradient.Rotation = (rimGradient.Rotation + 30 * dt) % 360
        end
    end)

    -- ── Keyboard: Ctrl+F, arrows, escape ─────────────────────────────────
    self.Maid:Give(UserInputService.InputBegan:Connect(function(input)
        if self.Unloaded or input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
            or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)

        if input.KeyCode == Enum.KeyCode.F and ctrl then
            self:ToggleSpotlight()
            return
        end

        if not spotlight.Open then
            return
        end

        if input.KeyCode == Enum.KeyCode.Escape then
            self:CloseSpotlight()
        elseif input.KeyCode == Enum.KeyCode.Down then
            spotlight.SetSelected(spotlight.Selected + 1, true)
        elseif input.KeyCode == Enum.KeyCode.Up then
            spotlight.SetSelected(spotlight.Selected - 1, true)
        elseif input.KeyCode == Enum.KeyCode.Return and not box:IsFocused() then
            local item = spotlight.Items[spotlight.Selected]
            if item then
                self:SpotlightGo(item.Entry)
            end
        end
    end))
end

function Library:OpenSpotlight()
    local spotlight = self.Spotlight
    if not spotlight.Enabled or spotlight.Open or not self.SpotlightLayer then
        return
    end
    self:CloseAllPopups()
    spotlight.Open = true
    spotlight.Token = spotlight.Token + 1

    local info = TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    self.SpotlightLayer.Visible = true
    self:Tween(self.SpotlightLayer, { BackgroundTransparency = self.Spotlight.DimTransparency }, info)

    spotlight.Column.GroupTransparency = 1
    spotlight.Column.Position = UDim2.new(0.5, 0, 0.2, 14)
    spotlight.CardScale.Scale = 0.97
    self:Tween(spotlight.Column, {
        GroupTransparency = 0,
        Position = UDim2.new(0.5, 0, 0.2, 0),
    }, info)
    self:Tween(spotlight.CardScale, { Scale = 1 }, info)

    if spotlight.Blur and self.SpotlightBlur and spotlight.BlurSize > 0 then
        self.SpotlightBlur.Enabled = true
        self:Tween(self.SpotlightBlur, { Size = spotlight.BlurSize }, info)
    end

    spotlight.Box.Text = ""
    spotlight.Rebuild()

    -- Focus on the next frame so the "F" of Ctrl+F is not typed into the box
    task.defer(function()
        if spotlight.Open then
            spotlight.Box:CaptureFocus()
            RunService.Heartbeat:Wait()
            if spotlight.Open and spotlight.Box.Text ~= "" then
                spotlight.Box.Text = ""
            end
        end
    end)
end

function Library:CloseSpotlight()
    local spotlight = self.Spotlight
    if not spotlight.Open then
        return
    end
    spotlight.Open = false
    spotlight.Token = spotlight.Token + 1
    local token = spotlight.Token

    if spotlight.Box:IsFocused() then
        spotlight.Box:ReleaseFocus()
    end

    local info = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    self:Tween(self.SpotlightLayer, { BackgroundTransparency = 1 }, info)
    self:Tween(spotlight.Column, {
        GroupTransparency = 1,
        Position = UDim2.new(0.5, 0, 0.2, 10),
    }, info)
    self:Tween(spotlight.CardScale, { Scale = 0.97 }, info)
    if self.SpotlightBlur then
        self:Tween(self.SpotlightBlur, { Size = 0 }, info)
    end

    task.delay(0.28, function()
        if spotlight.Token == token and not spotlight.Open then
            self.SpotlightLayer.Visible = false
            spotlight.ResultsShown = false
            spotlight.Card.Visible = false
            spotlight.Card.GroupTransparency = 1
            if self.SpotlightBlur then
                self.SpotlightBlur.Enabled = false
            end
        end
    end)
end

function Library:ToggleSpotlight()
    if self.Spotlight.Open then
        self:CloseSpotlight()
    else
        self:OpenSpotlight()
    end
end

function Library:SetSpotlightEnabled(state)
    self.Spotlight.Enabled = state and true or false
    if not self.Spotlight.Enabled then
        self:CloseSpotlight()
    end
end

function Library:SetSpotlightBlurSize(size)
    self.Spotlight.BlurSize = size
    if self.Spotlight.Open and self.SpotlightBlur then
        self.SpotlightBlur.Enabled = size > 0 and self.Spotlight.Blur
        self:Tween(self.SpotlightBlur, { Size = self.Spotlight.Blur and size or 0 }, self.FastTweenInfo)
    end
end

