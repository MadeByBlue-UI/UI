-- ============================================================================
-- BOUCLE D'ANIMATION PARTAGÉE (Ticker)
-- UNE seule connexion Heartbeat pour toutes les animations de la lib (fond, étoiles, graphiques, chiffres, ressorts,
-- défilement, couleurs, repli des blocs...). Avant : une quinzaine de connexions Heartbeat / RenderStepped séparées.
--   Ticker.connect(fn, opts) -> poignée avec :Disconnect() (compatible track())
--     fn(dt, now)  dt = temps écoulé depuis le dernier appel de CETTE tâche
--     opts.rate    appels max par seconde (nombre ou fonction qui renvoie un nombre) ; absent = à chaque image
--     opts.gate    Instance (la tâche dort tant qu'elle n'est pas affichée) ou fonction -> bool (false = elle dort)
--     opts.deco    true = décoratif : en pause quand la fenêtre Roblox n'a pas le focus
--   Les tâches endormies ne coûtent rien. Si TOUTES dorment (fenêtre cachée...), la connexion Heartbeat est coupée ;
--   elle repart avec Ticker.wake() ou par un sondage léger toutes les 0.25 s. Ticker.Fps = FPS mesuré (une seule mesure).
-- ============================================================================
local Ticker = { Fps = 60 }
Library.Ticker = Ticker
do
	local tasks, hb, dead = {}, nil, 0
	local waiters = {}   -- coroutines en attente de la prochaine image (Ticker.wait)
	local focused = true
	local fpsN, fpsT0, lastOpen = 0, os.clock(), os.clock()
	local shownCache = setmetatable({}, { __mode = "k" })

	-- Instance affichée ? (toute la chaîne de parents visible), résultat gardé 0.25 s
	function Ticker.shown(inst, now)
		now = now or os.clock()
		local c = shownCache[inst]
		if c and now - c.t < 0.25 then return c.v end
		local v, p = true, inst
		while p and p:IsA("GuiObject") do
			if not p.Visible then v = false break end
			p = p.Parent
		end
		if v then
			if p and p:IsA("ScreenGui") then v = p.Enabled else v = p ~= nil end
		end
		shownCache[inst] = { t = now, v = v }
		return v
	end

	local function isOpen(t, now)
		local g = t.gate
		if g ~= nil then
			if type(g) == "function" then
				if not g() then return false end
			elseif not Ticker.shown(g, now) then
				return false
			end
		end
		if t.deco and not focused then return false end
		return true
	end

	local start, poll
	local function loop(dt)
		local now = os.clock()
		fpsN += 1
		if now - fpsT0 >= 0.5 then
			Ticker.Fps = fpsN / (now - fpsT0)
			fpsN, fpsT0 = 0, now
		end
		local anyOpen = false
		if #waiters > 0 then
			local list = waiters
			waiters, anyOpen = {}, true
			for i = 1, #list do task.spawn(list[i], dt) end
		end
		for i = 1, #tasks do
			local t = tasks[i]
			if t.alive then
				if isOpen(t, now) then
					anyOpen = true
					t.acc += dt
					local r = t.rate
					if type(r) == "function" then r = r() end
					local due = true
					if r and r > 0 then
						-- échéances : à 60 Hz sur un écran à 60 images/s la tâche passe à CHAQUE image (l'ancien cumul de dt en
						-- sautait une sur deux dès que le dt tombait à 16.6 ms au lieu de 16.7 ms)
						local per = 1 / r
						if not t.due then t.due = now + per end
						due = now + dt * 0.5 >= t.due
						if due then
							t.due += per
							if t.due < now - per then t.due = now end   -- trop en retard : on repart de maintenant
						end
					end
					if due then
						local step = t.acc
						t.acc = 0
						local ok, err = pcall(t.fn, step, now)
						if not ok and not t.warned then
							t.warned = true
							warn("[Ui-Lib] Boucle partagée : " .. tostring(err))
						end
					end
				else
					t.acc, t.due = 0, nil   -- endormie : pas de gros dt au réveil
				end
			end
		end
		if dead > 0 then
			local keep = {}
			for i = 1, #tasks do
				if tasks[i].alive then keep[#keep + 1] = tasks[i] end
			end
			tasks, dead = keep, 0
		end
		if #tasks == 0 and #waiters == 0 then
			if hb then hb:Disconnect() hb = nil end
			return
		end
		if anyOpen then
			lastOpen = now
		elseif now - lastOpen > 0.3 and hb then
			-- tout dort : on coupe la connexion, un sondage léger surveille le réveil
			hb:Disconnect()
			hb = nil
			task.delay(0.25, poll)
		end
	end

	function start()
		if hb or (#tasks == 0 and #waiters == 0) then return end
		fpsN, fpsT0, lastOpen = 0, os.clock(), os.clock()
		hb = RunService.Heartbeat:Connect(loop)
	end

	function poll()
		if hb then return end
		local now = os.clock()
		for i = 1, #tasks do
			local t = tasks[i]
			if t.alive and isOpen(t, now) then start() return end
		end
		if #tasks > 0 then task.delay(0.25, poll) end
	end

	-- remplace RunService.Heartbeat:Wait() : reprend à la prochaine image de la boucle partagée, renvoie dt
	function Ticker.wait()
		waiters[#waiters + 1] = coroutine.running()
		if not hb then start() end
		return coroutine.yield()
	end

	function Ticker.wake()
		if not hb and #tasks > 0 then start() end
	end

	function Ticker.connect(fn, opts)
		opts = opts or {}
		local t = { fn = fn, rate = opts.rate, gate = opts.gate, deco = opts.deco, acc = 0, alive = true }
		tasks[#tasks + 1] = t
		start()
		local h = { Connected = true }
		function h:Disconnect()
			if not t.alive then return end
			t.alive, h.Connected = false, false
			dead += 1
		end
		return h
	end

	UIS.WindowFocused:Connect(function() focused = true Ticker.wake() end)
	UIS.WindowFocusReleased:Connect(function() focused = false end)
end

-- Appel direct, SAUF pendant un redimensionnement de la fenêtre : au plus 20 appels/s (le dernier est toujours exécuté).
-- Sert aux mises en page de texte (mesures TextService) qui réagissent à chaque changement de largeur : le cadre de la
-- fenêtre reste à pleine cadence, le recalcul du texte à l'intérieur suit à 20 Hz.
function Library._lazy(fn)
	local pending, last = false, 0
	return function(...)
		if not Library._resizing then return fn(...) end
		local now = os.clock()
		if now - last >= 0.05 then last = now return fn(...) end
		if pending then return end
		pending = true
		task.delay(0.05 - (now - last), function()
			pending, last = false, os.clock()
			fn()
		end)
	end
end

local TEXTCLASS = { TextLabel = true, TextButton = true, TextBox = true }

-- type « Carré » : vrai si `parent` est dans la fenêtre principale (les notifications gardent leurs coins)
local function sqUnder(parent)
	local w = Library.Window
	return Library.SquareMode == true and w ~= nil and w.Main ~= nil and parent ~= nil and parent:IsDescendantOf(w.Main)
end

local function new(class, props, parent)
	local intro = Library._intro
	if intro then intro.tick() end   -- intro de chargement : progression + respiration du rendu
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if class == "UICorner" and sqUnder(parent) then
		o:SetAttribute("SqOrig", o.CornerRadius)
		o.CornerRadius = UDim.new(0, 0)
	end
	if TEXTCLASS[class] then
		-- taille de base mémorisée : permet la « taille de police globale »
		o:SetAttribute("BaseSize", o.TextSize)
		local role = (o.Font == F_BOLD and 3) or (o.Font == F_MED and 2) or 1
		o:SetAttribute("FontRole", role)
		if Library.Fonts then o.Font = Library.Fonts[role] end
		if Library.FontScale ~= 1 then
			o.TextSize = math.max(8, math.floor(o.TextSize * Library.FontScale + 0.5))
		end
	end
	if parent then o.Parent = parent end
	if class == "TextBox" and Library._attachSelection then Library._attachSelection(o) end
	if class == "ScrollingFrame" and Library._regScroll then Library._regScroll(o) end
	return o
end

-- TweenInfo mis en cache (évite d'en recréer des centaines) + multiplicateur de vitesse / mode sans animation
local tweenInfoCache = {}
Library.DefaultEase = Enum.EasingStyle.Cubic   -- Quint : la fin traînait d'un pixel (nil = ancien comportement)
local function tween(o, props, t, style, dir)
	t = t or 0.25
	-- Back / Elastic dépassent la valeur cible : sur une COULEUR ou une TRANSPARENCE ça fait un flash (noir <-> blanc
	-- pas net). On sépare donc : géométrie avec l'easing demandé, couleurs / transparences en douceur (sans dépassement).
	if style == BACK or style == Enum.EasingStyle.Elastic or style == Enum.EasingStyle.Bounce then
		local smooth, geo
		for k, v in pairs(props) do
			if typeof(v) == "Color3" or string.find(k, "Transparency", 1, true) then
				smooth = smooth or {}
				smooth[k] = v
			else
				geo = geo or {}
				geo[k] = v
			end
		end
		if smooth and geo then
			tween(o, smooth, t, nil, dir)
			return tween(o, geo, t, style, dir)
		elseif smooth then
			style = nil
		end
	end
	style = style or Library.DefaultEase or QUINT
	dir = dir or OUT
	if not Library.Animations then
		t = 0
	else
		t = t / math.max(Library.AnimSpeed or 1, 0.05)
	end
	local key = tostring(t) .. "|" .. tostring(style) .. "|" .. tostring(dir)
	local info = tweenInfoCache[key]
	if not info then
		info = TweenInfo.new(t, style, dir)
		tweenInfoCache[key] = info
	end
	local tw = TweenService:Create(o, info, props)
	tw:Play()
	return tw
end

-- ============================================================================
-- RESSORTS : une animation « ressort » garde sa VITESSE quand on l'interrompt (un tween repart de zéro et saccade).
-- Library._spring(objet, { Position = UDim2, Size = ..., BackgroundColor3 = ..., Propriete = nombre }, "snappy" | "bouncy" | "smooth" | "soft")
-- Library._springStop(objet [, propriete]) : arrête (à appeler avant de poser une valeur directement).
-- Une seule boucle partagée, active uniquement pendant qu'un ressort bouge. Library.Springs = false : retour aux tweens.
-- ============================================================================
Library.Springs = true
Library.SpringPresets = {   -- { raideur (rad/s), amortissement }  (amortissement < 1 = léger rebond, 1 = sans dépassement)
	snappy = { 26, 0.84 }, bouncy = { 22, 0.6 }, smooth = { 24, 1 }, soft = { 16, 1 },
}
do -- (portée réduite : limite de 200 locals)
local springs, springConn = {}, nil

-- ressort amorti, solution exacte (stable quel que soit dt)
function Library._springStep(x, v, target, w, z, dt)
	local d = x - target
	if z >= 0.999 then
		local e = math.exp(-w * dt)
		return target + e * (d * (1 + w * dt) + v * dt), e * (v * (1 - w * dt) - d * w * w * dt)
	end
	local wd = w * math.sqrt(1 - z * z)
	local e = math.exp(-z * w * dt)
	local c, sn = math.cos(wd * dt), math.sin(wd * dt)
	local k = z * w / wd
	return target + e * (d * (c + k * sn) + v * sn / wd), e * (v * (c - k * sn) - d * (w * w / wd) * sn)
end

local function springDecode(val)
	local t = typeof(val)
	if t == "number" then return { val }, { 0.001 }, t, { false } end
	if t == "UDim2" then return { val.X.Scale, val.X.Offset, val.Y.Scale, val.Y.Offset }, { 0.0012, 0.03, 0.0012, 0.03 }, t, { false, true, false, true } end
	if t == "Color3" then return { val.R, val.G, val.B }, { 0.002, 0.002, 0.002 }, t, { false, false, false } end
	if t == "Vector2" then return { val.X, val.Y }, { 0.03, 0.03 }, t, { true, true } end
	return nil
end
local function springEncode(kind, x)
	if kind == "number" then return x[1] end
	if kind == "UDim2" then return UDim2.new(x[1], x[2], x[3], x[4]) end
	if kind == "Color3" then return Color3.new(math.clamp(x[1], 0, 1), math.clamp(x[2], 0, 1), math.clamp(x[3], 0, 1)) end
	return Vector2.new(x[1], x[2])
end

local function springLoop(dt)
	dt = math.min(dt, 1 / 20) * math.max(Library.AnimSpeed or 1, 0.05)
	for obj, props in pairs(springs) do
		if not obj.Parent then
			springs[obj] = nil
		else
			for prop, st in pairs(props) do
				local rest = true
				for i = 1, #st.x do
					local nx, nv = Library._springStep(st.x[i], st.v[i], st.t[i], st.w, st.z, dt)
					if st.px and st.px[i] then
						-- composante en PIXELS : l'écran arrondit au pixel, la queue d'un ressort « rampe » donc d'un pixel à la fois, par à-coups.
						-- À moins d'1 px de la cible on termine net ; sans dépassement, on avance d'au moins ~1 px par image jusque-là.
						local ox, tg = st.x[i], st.t[i]
						if math.abs(tg - nx) < 1 and (st.z >= 0.999 or math.abs(nv) < 80) then
							nx, nv = tg, 0
						elseif st.z >= 0.999 then
							local minStep = 75 * dt
							local dir = (tg >= ox) and 1 or -1
							if (nx - ox) * dir < minStep then
								nx = ox + dir * minStep
								if (tg - nx) * dir <= 0 then nx = tg end
								nv = dir * 75
							end
						end
					end
					st.x[i], st.v[i] = nx, nv
					if math.abs(nx - st.t[i]) > st.eps[i] or math.abs(nv) > st.eps[i] * 20 then rest = false end
				end
				if rest then
					for i = 1, #st.x do st.x[i], st.v[i] = st.t[i], 0 end
					props[prop] = nil
				end
				obj[prop] = springEncode(st.kind, st.x)
			end
			if next(props) == nil then springs[obj] = nil end
		end
	end
	if next(springs) == nil and springConn then
		springConn:Disconnect()
		springConn = nil
	end
end

function Library._springStop(obj, prop)
	local ps = springs[obj]
	if not ps then return end
	if prop then ps[prop] = nil else springs[obj] = nil end
end

function Library._spring(obj, props, preset)
	if Library.Springs == false or Library.Animations == false then
		for k in pairs(props) do Library._springStop(obj, k) end
		if Library.Animations == false then
			for k, v in pairs(props) do obj[k] = v end
		else
			tween(obj, props, 0.3)
		end
		return
	end
	local pr = Library.SpringPresets[preset or "snappy"] or Library.SpringPresets.snappy
	local ps = springs[obj]
	if not ps then ps = {} springs[obj] = ps end
	for prop, target in pairs(props) do
		local tx, eps, kind, pxf = springDecode(target)
		if tx then
			local st = ps[prop]
			local cx = springDecode(obj[prop])
			if st and st.kind == kind then
				-- quelqu'un a posé la valeur à la main entre-temps : on repart de la vraie valeur, sans vitesse
				for i = 1, #cx do
					if math.abs(cx[i] - st.x[i]) > eps[i] * 2 then
						for j = 1, #cx do st.x[j], st.v[j] = cx[j], 0 end
						break
					end
				end
			else
				local vz = {}
				for i = 1, #cx do vz[i] = 0 end
				st = { kind = kind, x = cx, v = vz, eps = eps, px = pxf }
				ps[prop] = st
			end
			st.t, st.w = tx, pr[1]
			st.z = (kind == "Color3") and math.max(pr[2], 1) or pr[2]
		end
	end
	if not springConn then springConn = Ticker.connect(springLoop) end
end
end -- fin de la portée réduite

-- ============================================================================
-- DÉFILEMENT FLUIDE (molette) : au lieu de sauter de quelques lignes, le contenu glisse vers sa position avec un ressort
-- (inertie). Le saut natif est annulé avant l'affichage ; les autres modes (barre de défilement, tactile, code) restent natifs.
-- Library.SmoothScroll = false pour couper · Library.SmoothScrollSpeed (raideur, 16) · Library.SmoothScrollGain (distance, 1).
-- ============================================================================
Library.SmoothScroll      = true
Library.SmoothScrollSpeed = 16
Library.SmoothScrollGain  = 1
do -- (portée réduite : limite de 200 locals)
local scrollActive, scrollConn, wheelAt = {}, nil, 0
track(UIS.InputChanged:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseWheel then wheelAt = os.clock() end
end))

local function scrollLoop(dt)
	dt = math.min(dt, 1 / 20)
	local w = Library.SmoothScrollSpeed or 16
	for sf, st in pairs(scrollActive) do
		if not sf.Parent then
			scrollActive[sf] = nil
		else
			local p, v = Library._springStep(st.pos, st.vel, st.target, w, 1, dt)
			st.pos, st.vel = p, v
			local done = math.abs(st.target - p) < 0.35 and math.abs(v) < 4
			if done then p = st.target end
			local old = st.last
			sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, p)
			local act = sf.CanvasPosition.Y
			st.prev, st.last, st.known = old, act, act
			if math.abs(act - p) > 1 then   -- haut / bas du contenu atteint
				st.pos, st.vel, st.target = act, 0, act
				done = true
			end
			if done then scrollActive[sf] = nil end
		end
	end
	if next(scrollActive) == nil and scrollConn then
		scrollConn:Disconnect()
		scrollConn = nil
	end
end

local function scrollChanged(sf, st)
	local y = sf.CanvasPosition.Y
	if (st.last and math.abs(y - st.last) < 1) or (st.prev and math.abs(y - st.prev) < 1) then
		st.known = y   -- notre propre écriture
		return
	end
	local wheel = Library.SmoothScroll ~= false and sf.ScrollingEnabled and (os.clock() - wheelAt) < 0.15
		and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	if wheel then
		local delta = y - st.known
		if math.abs(delta) < 1 then return end
		local active = scrollActive[sf] ~= nil
		st.target = (active and st.target or st.known) + delta * (Library.SmoothScrollGain or 1)
		if not active then st.pos, st.vel = st.known, 0 end
		-- on annule le saut natif : la position affichée reste où elle était, le ressort la fait avancer
		local back = st.pos
		sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, back)
		st.prev, st.last, st.known = st.last, sf.CanvasPosition.Y, sf.CanvasPosition.Y
		scrollActive[sf] = st
		if not scrollConn then scrollConn = Ticker.connect(scrollLoop) end
	else
		-- changement venu d'ailleurs (barre de défilement, tactile, code) : on abandonne le glissement
		scrollActive[sf] = nil
		st.known = y
	end
end

function Library._regScrollLegacy(sf)
	local st = { known = sf.CanvasPosition.Y, pos = 0, vel = 0, target = 0 }
	local queued = false
	sf:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if queued then return end
		queued = true
		task.defer(function()   -- après l'événement de molette de la même image
			queued = false
			if sf.Parent then scrollChanged(sf, st) end
		end)
	end)
end
end -- fin de la portée réduite

local function corner(parent, base)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, math.floor(base * Library.GlobalCornerValue / 10))
	c.Parent = parent
	if sqUnder(parent) then
		c:SetAttribute("SqOrig", c.CornerRadius)
		c.CornerRadius = UDim.new(0, 0)
	end
	table.insert(Library.CornerObjects, { Corner = c, BaseRadius = base })
	return c
end

local function stroke(parent, transparency, thickness)
	return new("UIStroke", {
		Color = T.Accent, Transparency = transparency or 0.9, Thickness = thickness or 1,
		ApplyStrokeMode = BORDER,
	}, parent)
end

-- Registre des éléments qui changent d'apparence avec le style (lignes, blocs, tiroirs, champs)
local STYLE_KIND = {
	row   = { "RowTr", "StrokeTr" },
	block = { "BlockTr", "BlockStroke" },
	panel = { "PanelTr", "PanelStroke" },
	input = { "InputTr", "InputStroke" },
}
-- reflet de verre sur les bordures : lumineuse en haut à gauche, qui s'éteint vers le bas à droite
local GLASS_EDGE = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.45, 0.5),
	NumberSequenceKeypoint.new(1, 0.82),
})
local styled, stylePrune = {}, 300

local function styleOne(e)
	local inst, st = e.inst, e.st
	if not (inst and inst.Parent) then return false end
	local k = STYLE_KIND[e.kind]
	inst.BackgroundTransparency = Sty[k[1]]
	if st then
		st.Transparency = Sty[k[2]]
		local g = st:FindFirstChild("GlassGrad")
		if Sty.Glass then
			if not g then
				g = Instance.new("UIGradient")
				g.Name = "GlassGrad"
				g.Rotation = 40
				g.Transparency = GLASS_EDGE
				g.Parent = st
			end
			g.Enabled = true
		elseif g then
			g.Enabled = false
		end
	end
	return true
end

local function trackStyled(inst, st, kind)
	local e = { inst = inst, st = st, kind = kind }
	styled[#styled + 1] = e
	styleOne(e)
	if #styled >= stylePrune then
		local keep = {}
		for _, x in ipairs(styled) do
			if x.inst and x.inst.Parent then keep[#keep + 1] = x end
		end
		styled = keep
		stylePrune = #styled + 300
	end
end

local function label(parent, text, size, props)
	local p = {
		BackgroundTransparency = 1, Text = tostring(text), TextColor3 = T.Text, TextSize = size or 13,
		Font = F_MED, TextXAlignment = LEFT,
		TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 1, 0),
	}
	for k, v in pairs(props or {}) do p[k] = v end
	return new("TextLabel", p, parent)
end

-- Mesure d'un texte (TextService) : retourne un Vector2 (jamais d'erreur). Utilisé par les dropdowns / barres de progression.
local TextServiceG = game:GetService("TextService")
local function measureText(text, size, font, width)
	local ok, v = pcall(TextServiceG.GetTextSize, TextServiceG, tostring(text), size, font, Vector2.new(width or 10000, 10000))
	if ok and typeof(v) == "Vector2" then return v end
	return Vector2.new(#tostring(text) * size * 0.55, size + 2)
end
-- Au-delà de ce nombre de caractères, une valeur affichée à droite devient une boîte de texte sous le nom (Library.LongTextChars)
Library.LongTextChars = Library.LongTextChars or 27
local function isLongText(t) return (utf8.len(tostring(t)) or #tostring(t)) >= (tonumber(Library.LongTextChars) or 27) end

-- Appelle un callback sans jamais casser l'UI
local function fire(cb, ...)
	if type(cb) ~= "function" then return end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(cb, table.unpack(args, 1, args.n))
		if not ok then warn("[Ui-Lib] Callback : " .. tostring(err)) end
	end)
end

-- Permet d'appeler item.Set(v) ET item:Set(v)
local function unself(self, ...)
	if (...) == self then return select(2, ...) end
	return ...
end

local function copyVal(v)
	if type(v) ~= "table" then return v end
	local c = {}
	for k, x in pairs(v) do c[k] = copyVal(x) end
	return c
end

local function register(flag, item, value)
	if flag then
		Library.Flags[flag] = value
		Library.Items[flag] = item
		Library.Defaults[flag] = copyVal(value)
		-- config auto-chargée : les éléments créés APRÈS le chargement reçoivent quand même leur valeur sauvegardée
		local pend = Library._pendingFlags
		if pend and pend[flag] ~= nil and string.sub(flag, 1, 3) ~= "ui." and type(item) == "table" and item.Set then
			local v = copyVal(pend[flag])
			task.defer(function()
				Library._silentSound = (Library._silentSound or 0) + 1
				Library._cfgCapture = (Library._cfgCapture or 0) + 1   -- notifications du callback retenues (voir Library:Notify)
				local fmt = Library._cfgFmt
				local old = Library.Flags[flag]
				pcall(item.Set, item, v)
				Library._silentSound = math.max((Library._silentSound or 1) - 1, 0)
				task.delay(0.6, function() Library._cfgCapture = math.max((Library._cfgCapture or 1) - 1, 0) end)
				-- on ajoute le changement à la liste du chargement en cours (Réglages > Changements de config)
				local last = Library.CfgChanges and Library.CfgChanges[#Library.CfgChanges]
				if last and fmt and fmt(old) ~= fmt(v) then
					last.List[#last.List + 1] = { Flag = flag, Old = fmt(old), New = fmt(v) }
					Library._cfgDirtyTok = (Library._cfgDirtyTok or 0) + 1
					local tok = Library._cfgDirtyTok
					task.delay(0.5, function()
						if tok == Library._cfgDirtyTok and Library._onCfgChanges then pcall(Library._onCfgChanges) end
					end)
				end
			end)
		end
	end
end

local function mount(gui)
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(gui)
		elseif protectgui then protectgui(gui) end
	end)
	local ok = pcall(function() gui.Parent = CoreGui end)
	if not ok or not gui.Parent then
		gui.Parent = LP:WaitForChild("PlayerGui")
	end
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function guiInset()
	local ok, v = pcall(function() return GuiService:GetGuiInset() end)
	return ok and v or Vector2.new(0, 0)
end

-- Position du pointeur dans le MÊME repère que AbsolutePosition (les ScreenGui sont en IgnoreGuiInset = true).
-- Souris : GetMouseLocation, moins le réglage manuel (Library.PointerOffset) et moins la correction APPRISE toute seule
-- (Library._ptrLearn, voir Library._ptrCheck). Tactile : InputObject.Position décalé de l'inset.
Library._ptrLearn = Library._ptrLearn or 0
Library._pointerPos = function(p)
	local okT, last = pcall(function() return UIS:GetLastInputType() end)
	if okT and last == Enum.UserInputType.Touch then
		return Vector2.new(p.X, p.Y + guiInset().Y)
	end
	local c = Library._ptrCorrect and Library._ptrCorrect() or Vector2.new(0, 0)
	return UIS:GetMouseLocation() - c
end

local function viewport()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if v.X < 100 or v.Y < 100 then v = Vector2.new(1280, 720) end
	return v
end

-- Correction du décalage entre GetMouseLocation et le repère réel des ScreenGui de l'UI.
-- Manuel : Library.PointerOffset (Paramètres > Fenêtre). Auto : Library._ptrLearn, appris à l'appui sur le carré / la barre
-- de teinte / la barre d'opacité du color picker (voir Library._ptrCheck). Les deux s'additionnent.
Library.PointerOffset = Library.PointerOffset or Vector2.new(0, 0)
Library._ptrCorrect = function()
	local man = Library.PointerOffset
	return Vector2.new(man and man.X or 0, (man and man.Y or 0) + (Library._ptrLearn or 0))
end

-- Auto-calibrage : un événement d'appui n'arrive QUE si le vrai pointeur est dans la zone cliquée. Si, avec la correction
-- actuelle, le pointeur calculé tombe hors de cette zone, le repère est décalé : on cherche la correction qui le remet
-- dedans (décalages connus : barre du haut 36 / 58 px, GetGuiInset), sinon on recale sur le centre de la zone.
-- Aucun effet tant que le pointeur calculé est bien dans la zone : un réglage qui marche déjà n'est jamais touché.
Library._ptrCheck = function(gui)
	local okT, last = pcall(function() return UIS:GetLastInputType() end)
	if okT and last == Enum.UserInputType.Touch then return end
	if not (gui and gui.Parent) then return end
	local raw = UIS:GetMouseLocation()
	local man = Library.PointerOffset
	local base = raw.Y - (man and man.Y or 0)
	local ap, as = gui.AbsolutePosition, gui.AbsoluteSize
	local function inside(c) local y = base - c return y >= ap.Y - 1 and y <= ap.Y + as.Y + 1 end
	if inside(Library._ptrLearn or 0) then return end
	local ins = guiInset().Y
	for _, c in ipairs({ 0, ins, 58, 36, -ins, -36, -58 }) do
		if inside(c) then Library._ptrLearn = c return end
	end
	Library._ptrLearn = base - (ap.Y + as.Y / 2)
end
function Library:ResetPointerCalibration() Library._ptrLearn = 0 end

-- Échelle réelle de la fenêtre (UIScale + animation), pour convertir pixels écran <-> pixels UI
local function pxScale()
	local win = Library.Window
	local m = win and win.Main
	if m and m.Size.X.Offset > 0 and m.AbsoluteSize.X > 0 then
		return m.AbsoluteSize.X / m.Size.X.Offset
	end
	return 1
end

