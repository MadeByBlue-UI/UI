		or i.UserInputType == Enum.UserInputType.Touch) then
		local e = activeEnd
		activeDrag, activeEnd = nil, nil
		if dragScroll then dragScroll.ScrollingEnabled = true dragScroll = nil end
		if e then e() end
	end
end))

-- Dégradés qui tournent (anneaux du trou noir, bordure de la fenêtre...)
local spinners = {}
local function spin(g, speed)
	spinners[#spinners + 1] = { g = g, speed = speed }
	return g
end

-- Effet de survol fluide sur une ligne
local function hover(f, st, hit)
	hit = hit or f
	hit.MouseEnter:Connect(function()
		tween(f, { BackgroundTransparency = Sty.RowHot }, 0.2)
		if st then tween(st, { Transparency = Sty.StrokeHot }, 0.2) end
	end)
	hit.MouseLeave:Connect(function()
		tween(f, { BackgroundTransparency = Sty.RowTr }, 0.3)
		if st then tween(st, { Transparency = Sty.StrokeTr }, 0.3) end
	end)
end

-- Onde qui s'étend depuis le point de clic (le cadre hôte doit avoir ClipsDescendants = true)
local function ripple(host, tint)
	if not (Library.Ripple and Library.Animations) then return end
	local sc = pxScale()
	local m = UIS:GetMouseLocation()
	local ax, ay = host.AbsoluteSize.X / sc, host.AbsoluteSize.Y / sc
	local rx = math.clamp((m.X - host.AbsolutePosition.X) / sc, 0, ax)
	local ry = math.clamp((m.Y - host.AbsolutePosition.Y) / sc, 0, ay)
	local d = math.max(ax, ay) * 2.3
	local r = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(rx, ry),
		Size = UDim2.fromOffset(0, 0), BackgroundColor3 = tint or T.Accent, BackgroundTransparency = 0.8,
		BorderSizePixel = 0, ZIndex = 4 }, host)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, r)
	tween(r, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 }, 0.6)
	task.delay(0.65 / math.max(Library.AnimSpeed or 1, 0.05) + 0.05, function() r:Destroy() end)
end

-- Tiroir animé (utilisé par le dropdown et le color picker)
local function drawer(parent, order)
	local wrap = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true,
		Visible = false, LayoutOrder = order, BorderSizePixel = 0,
	}, parent)
	local d = { Wrap = wrap, Open = false, Height = 0 }
	local token = 0
	d.Set = function(self, open, h)
		if h then self.Height = h end
		self.Open = open and true or false
		token = token + 1
		local my = token
		Library._busyUntil = os.clock() + 0.4
		if self.Open then
			wrap.Visible = true
			tween(wrap, { Size = UDim2.new(1, 0, 0, self.Height) }, 0.34)
		else
			local tw = tween(wrap, { Size = UDim2.new(1, 0, 0, 0) }, 0.26)
			tw.Completed:Connect(function()
				if token == my then wrap.Visible = false end
			end)
		end
	end
	d.Resize = function(self, h)
		self.Height = h
		if self.Open then tween(wrap, { Size = UDim2.new(1, 0, 0, h) }, 0.25) end
	end
	return d
end

local function ringSeq()
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.22, 0.65),
		NumberSequenceKeypoint.new(0.5, 1),
		NumberSequenceKeypoint.new(0.78, 0.65),
		NumberSequenceKeypoint.new(1, 0),
	})
end

local function fadeLine(parent, props)
	local f = new("Frame", {
		BackgroundColor3 = T.Accent, BorderSizePixel = 0,
	}, nil)
	for k, v in pairs(props or {}) do f[k] = v end
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, f)
	f.Parent = parent
	return f
end

-- ============================================================================
-- FLOU D'ARRIÈRE-PLAN  (BlurEffect dans Lighting : floute le jeu derrière l'interface)
-- ============================================================================
local blurFx
local blurToken = 0
local function setBlurTarget(size, instant)
	blurToken += 1
	local my = blurToken
	size = math.clamp(tonumber(size) or 0, 0, 56)
	if size <= 0 and not (blurFx and blurFx.Parent) then return end
	if not (blurFx and blurFx.Parent) then
		local ok, fx = pcall(function()
			local b = Instance.new("BlurEffect")
			b.Name = "UILibBlur"
			b.Size = 0
			b.Parent = Lighting
			return b
		end)
		if not ok or not fx then return end
		blurFx = fx
	end
	if instant or not Library.Animations then
		blurFx.Size = size
		blurFx.Enabled = size > 0
		return
	end
	blurFx.Enabled = true
	local tw = tween(blurFx, { Size = size }, 0.45)
	if size <= 0 then
		tw.Completed:Connect(function()
			if blurToken == my and blurFx then blurFx.Enabled = false end
		end)
	end
end

function Library:SetBlur(n)
	Library.BlurSize = math.clamp(tonumber(n) or 0, 0, 56)
	local w = Library.Window
	setBlurTarget((w and w.Open) and Library.BlurSize or 0)
end

