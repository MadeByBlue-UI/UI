		new("UICorner", { CornerRadius = UDim.new(1, 0) }, abar)
		aFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = col, BorderSizePixel = 0 }, abar)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, aFill)
		new("UIGradient", { Transparency = NumberSequence.new(1, 0) }, aFill)
		aMark = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(alpha, 0, 0.5, 0),
			Size = UDim2.new(0, 6, 1, 6), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, abar)
		aMark:SetAttribute("NoAccent", true)
		new("UICorner", { CornerRadius = UDim.new(0, 3) }, aMark)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.3 }, aMark)
		local aHit = new("TextButton", { Position = UDim2.new(0, 0, 0, -6), Size = UDim2.new(1, 0, 1, 12),
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, abar)
		aHit.InputBegan:Connect(function(i)
			if isPress(i) then
				Library._ptrCheck(aHit)
				startDrag(function(p)
					alpha = (norm(abar, p))
					commit()
				end, self.Scroll, i.Position, function() Library:PushRecentColor(Color3.fromHSV(h, s, v)) end)
			end
		end)
		y = y + 22
	end

	-- Hexadécimal + boutons Copier / Coller / Pipette
	local hex = new("TextBox", {
		Position = UDim2.new(0, 8, 0, y), Size = UDim2.new(1, -16, 0, 24), BackgroundColor3 = T.Off,
		BackgroundTransparency = 0.4, Text = "", PlaceholderText = "#FFFFFF", TextColor3 = T.Text, TextSize = 12,
		Font = F_MED, ClearTextOnFocus = false, BorderSizePixel = 0,
	}, panel)
	corner(hex, 6)
	trackStyled(hex, nil, "input")
	Library._attachTextFade(hex)
	y = y + 30

	local row = new("Frame", { Position = UDim2.new(0, 8, 0, y), Size = UDim2.new(1, -16, 0, 24), BackgroundTransparency = 1 }, panel)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = BYORDER }, row)
	local function mkBtn(text, order)
		local b = new("TextButton", { Size = UDim2.new(1 / 3, -3, 1, 0), BackgroundColor3 = T.Off, BackgroundTransparency = 0.4,
			Text = text, TextColor3 = T.Text, TextSize = 12, Font = F_MED, AutoButtonColor = false, BorderSizePixel = 0,
			LayoutOrder = order }, row)
		corner(b, 6)
		trackStyled(b, stroke(b, 0.9), "input")
		b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.2 }, 0.15) end)
		b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = Sty.InputTr }, 0.2) end)
		return b
	end
	local copyBtn, pasteBtn, pipBtn = mkBtn("Copier", 1), mkBtn("Coller", 2), mkBtn("Pipette", 3)
	y = y + 30

	-- Couleurs récentes (partagées par tous les color pickers)
	local rrow = new("Frame", { Position = UDim2.new(0, 8, 0, y), Size = UDim2.new(1, -16, 0, 22), BackgroundTransparency = 1 }, panel)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = BYORDER,
		VerticalAlignment = Enum.VerticalAlignment.Center }, rrow)

	local item = {}
	local function hexText()
		local t = "#" .. string.upper(col:ToHex())
		if useAlpha and alpha < 0.999 then t = t .. string.format("%02X", math.floor(alpha * 255 + 0.5)) end
		return t
	end
	local function refreshHex()
		if not hex:IsFocused() then hex.Text = hexText() end
	end
	-- glissement des poignées : fx.glide = true seulement quand la couleur vient d'ailleurs que du pointeur (hexadécimal,
	-- collage, pipette, couleur récente, script). Pendant un glisser à la souris : réglage direct, aucun retard.
	local fx = { glide = false, tw = {} }
	local function put(key, obj, props)
		local old = fx.tw[key]
		if old then old:Cancel() fx.tw[key] = nil end
		if fx.glide and Library.Animations then
			Library._spring(obj, props, "smooth")   -- ressort : si une autre couleur arrive en plein glissement, la vitesse est conservée
		else
			for k2, val in pairs(props) do
				Library._springStop(obj, k2)
				obj[k2] = val
			end
		end
	end
	local function visuals()
		put("svbg", sv, { BackgroundColor3 = Color3.fromHSV(h, 1, 1) })
		put("cursor", cursor, { Position = UDim2.new(s, 0, 1 - v, 0), BackgroundColor3 = Color3.fromHSV(h, s, v) })
		put("hue", hueMark, { Position = UDim2.new(h, 0, 0.5, 0) })
		put("swatch", swatch, { BackgroundColor3 = col, BackgroundTransparency = (1 - alpha) * 0.8 })
		if aFill then
			put("afill", aFill, { BackgroundColor3 = col })
			put("amark", aMark, { Position = UDim2.new(alpha, 0, 0.5, 0) })
		end
		refreshHex()
	end
	commit = function(silent)
		col = Color3.fromHSV(h, s, v)
		if o.Flag then Library.Flags[o.Flag] = { R = col.R, G = col.G, B = col.B, A = alpha } end
		visuals()
		if not silent then fire(o.Callback, col, alpha) end
	end

	local function applyColor(c, a)
		local nh, ns, nv = c:ToHSV()
		if ns > 0.001 and nv > 0.001 then h = nh end
		s, v = ns, nv
		if useAlpha and tonumber(a) then alpha = math.clamp(tonumber(a), 0, 1) end
		fx.glide = true
		commit()
		col = c   -- on garde exactement la couleur demandée
		put("swatch", swatch, { BackgroundColor3 = c, BackgroundTransparency = (1 - alpha) * 0.8 })
		if aFill then put("afill", aFill, { BackgroundColor3 = c }) end
		fx.glide = false
		refreshHex()
	end

	local function applyHex(txt)
		local c, a = Library._parseHex(txt)
		if not c then return false end
		applyColor(c, a)
		Library:PushRecentColor(col)
		return true
	end

	svHit.InputBegan:Connect(function(i)
		if isPress(i) then
			Library._ptrCheck(svHit)
			startDrag(function(p)
				local nx, ny = norm(sv, p)
				s, v = nx, 1 - ny
				commit()
			end, self.Scroll, i.Position, function() Library:PushRecentColor(col) end)
		end
	end)
	hueHit.InputBegan:Connect(function(i)
		if isPress(i) then
			Library._ptrCheck(hueHit)
			startDrag(function(p)
				local nx = norm(hue, p)
				h = math.min(nx, 0.999)
				commit()
			end, self.Scroll, i.Position, function() Library:PushRecentColor(col) end)
		end
	end)
	head.MouseButton1Click:Connect(function() uiSnd(dr.Open and "close" or "open") dr:Set(not dr.Open) end)

	hex:GetPropertyChangedSignal("Text"):Connect(function()
		if not hex:IsFocused() then return end
		local digits = (string.gsub(hex.Text, "[#%s]", ""))
		if #digits ~= 6 and #digits ~= 8 then return end
		local c, a = Library._parseHex(hex.Text)
		if c then applyColor(c, a) end   -- glisse jusqu'à la couleur tapée (sans l'ajouter aux récentes avant la validation)
	end)
	hex.FocusLost:Connect(function()
		if not applyHex(hex.Text) then hex.Text = hexText() end
	end)

	copyBtn.MouseButton1Click:Connect(function()
		uiSnd("click")
		local ok = Library:CopyText(hexText())
		Library:Notify({ Title = "Couleur", Type = ok and "Success" or "Warning", Duration = 2.5,
			Content = ok and (hexText() .. " copié dans le presse-papiers.") or "Presse-papiers indisponible : copie le code du champ." })
	end)
	pasteBtn.MouseButton1Click:Connect(function()
		uiSnd("click")
		local getc = (type(getclipboard) == "function" and getclipboard) or (type(fromclipboard) == "function" and fromclipboard) or nil
		local ok, txt = false, nil
		if getc then ok, txt = pcall(getc) end
		if ok and type(txt) == "string" and applyHex(txt) then
			Library:Notify({ Title = "Couleur", Type = "Success", Duration = 2.5, Content = "Collée : " .. hexText() })
		else
			Library:Notify({ Title = "Couleur", Type = "Warning", Duration = 3.5,
				Content = getc and "Le presse-papiers ne contient pas de code hexadécimal valide."
					or "Lecture du presse-papiers indisponible : colle (Ctrl+V) directement dans le champ hexadécimal." })
		end
	end)
	pipBtn.MouseButton1Click:Connect(function()
		uiSnd("click")
		Library:PickScreenColor(function(c)
			applyColor(c)
			Library:PushRecentColor(col)
		end)
	end)

	local function refreshRecent()
		for _, c in ipairs(rrow:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		local L = Library.RecentColors
		if #L == 0 then
			label(rrow, "Aucune couleur récente", 10, { Size = UDim2.new(1, 0, 1, 0), TextColor3 = T.ElementAccent })
			return
		end
		for idx, hx in ipairs(L) do
			local okc, c = pcall(Color3.fromHex, hx)
			if okc and typeof(c) == "Color3" then
				local b = new("TextButton", { Size = UDim2.fromOffset(22, 22), BackgroundColor3 = c, Text = "",
					AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = idx }, rrow)
				corner(b, 6)
				new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.75, ApplyStrokeMode = BORDER }, b)
				b.MouseEnter:Connect(function() tween(b, { Size = UDim2.fromOffset(25, 25) }, 0.15, BACK) end)
				b.MouseLeave:Connect(function() tween(b, { Size = UDim2.fromOffset(22, 22) }, 0.2) end)
				b.MouseButton1Click:Connect(function()
					uiSnd("pick")
					applyColor(c)
					Library:PushRecentColor(c)
				end)
			end
		end
	end
	Library._recentViews[#Library._recentViews + 1] = { inst = panel, refresh = refreshRecent }
	refreshRecent()

	item.Set = function(...)
		local c, a = unself(item, ...)
		if type(c) == "string" then
			local pc, pa = Library._parseHex(c)
			c, a = pc, (a ~= nil) and a or pa
		elseif type(c) == "table" then
			a = (a ~= nil) and a or c.A or c.a
			c = Color3.new(c.R or c.r or 1, c.G or c.g or 1, c.B or c.b or 1)
		end
		if typeof(c) ~= "Color3" then return end
		applyColor(c, a)
	end
	item.Get = function() return col end
	item.GetAlpha = function() return alpha end
	item.SetAlpha = function(...)
		local a = tonumber((unself(item, ...)))
		if a and useAlpha then
			alpha = math.clamp(a, 0, 1)
			fx.glide = true
			commit()
			fx.glide = false
		end
	end
	item.GetHex = hexText

	commit(true)
	register(o.Flag, item, { R = col.R, G = col.G, B = col.B, A = alpha })
	if Library.FireDefaults then fire(o.Callback, col, alpha) end
	return item
end

