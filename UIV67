-- ── Auto save ────────────────────────────────────────────────────────────
-- Every change of a saveable element (toggle, slider, input, dropdown, color
-- picker, key picker) marks the config dirty. The file is written shortly
-- after the last change (debounced), and at least every MaxWait seconds while
-- the user keeps changing things.

SaveManager.AutoSave = {
    Enabled = false,
    Name = "autosave",
    Delay = 0.8,
    MaxWait = 3,
    Notify = false,
    Dirty = false,
    Scheduled = false,
    LastChange = 0,
    FirstChange = nil,
}

function SaveManager:ReadText(path)
    if not FileSystemAvailable() then
        return nil
    end
    local ok, contents = pcall(function()
        if FS.isfile(path) then
            return FS.readfile(path)
        end
    end)
    if ok then
        return contents
    end
    return nil
end

function SaveManager:EnableAutoSave(name, options)
    options = options or {}
    local auto = self.AutoSave
    auto.Name = name or auto.Name or "autosave"
    auto.Delay = options.Delay or auto.Delay
    auto.MaxWait = options.MaxWait or auto.MaxWait
    auto.Notify = options.Notify == true
    auto.Enabled = true

    self:BuildFolderTree()
    local state = self:ReadText(self:ConfigPath() .. "/autosave_state.txt")
    if state == "off" then
        auto.Enabled = false
    end

    if not auto.UnloadHooked then
        auto.UnloadHooked = true
        Library:OnUnload(function()
            self:FlushAutoSave()
        end)
    end
    return auto.Enabled
end

function SaveManager:SetAutoSaveEnabled(state)
    local auto = self.AutoSave
    auto.Enabled = state and true or false
    if FileSystemAvailable() then
        self:BuildFolderTree()
        pcall(FS.writefile, self:ConfigPath() .. "/autosave_state.txt", auto.Enabled and "on" or "off")
    end
    if auto.Enabled then
        self:MarkDirty()
    end
end

function SaveManager:MarkDirty()
    local auto = self.AutoSave
    if not auto.Enabled or self.Loading then
        return
    end
    local now = os.clock()
    auto.Dirty = true
    auto.LastChange = now
    auto.FirstChange = auto.FirstChange or now
    if auto.Scheduled then
        return
    end
    auto.Scheduled = true
    task.spawn(function()
        while auto.Dirty and not Library.Unloaded do
            task.wait(0.2)
            local current = os.clock()
            if current - auto.LastChange >= auto.Delay or current - (auto.FirstChange or current) >= auto.MaxWait then
                auto.Dirty = false
                auto.FirstChange = nil
                self:RunAutoSave()
            end
        end
        auto.Scheduled = false
    end)
end

function SaveManager:RunAutoSave()
    local auto = self.AutoSave
    if not auto.Enabled then
        return false
    end
    local ok, err = self:Save(auto.Name)
    if ok then
        if Library.AutoSaveLabel then
            Library.AutoSaveLabel:SetText("Last auto save: " .. os.date("%H:%M:%S"))
        end
        if auto.Notify then
            Library:Notify({ Title = "Saved", Description = "Settings saved automatically.", Time = 1.5 })
        end
    elseif Library.AutoSaveLabel then
        Library.AutoSaveLabel:SetText("Auto save failed: " .. tostring(err))
    end
    return ok
end

--- Write immediately if something is still waiting to be saved.
function SaveManager:FlushAutoSave()
    local auto = self.AutoSave
    if auto.Enabled and auto.Dirty then
        auto.Dirty = false
        auto.FirstChange = nil
        self:RunAutoSave()
    end
end

--- Load the auto save on startup (falls back to the autoload config).
function SaveManager:LoadStartup()
    local path = self:ConfigPath() .. "/" .. self.AutoSave.Name .. ".json"
    local exists = false
    pcall(function()
        exists = FileSystemAvailable() and FS.isfile(path)
    end)
    if exists then
        local ok = self:Load(self.AutoSave.Name)
        if ok then
            return true
        end
    end
    self:LoadAutoloadConfig()
    return false
end

--- Shortcut: Library:EnableAutoSave("MyFolder")
function Library:EnableAutoSave(folder, name, options)
    if folder then
        SaveManager:SetFolder(folder)
    end
    return SaveManager:EnableAutoSave(name, options)
end

local function HookElement(idx, element)
    if type(element) ~= "table" or not element.Changed or not SaveManager.Parser[element.Type] then
        return
    end
    element.Changed:Connect(function()
        if element.TickFire then
            return
        end
        if SaveManager:IsIgnored(idx) then
            return
        end
        Library.AnyChanged:Fire(idx, element)
        SaveManager:MarkDirty()
    end)
end

for _, bucket in ipairs({ "Options", "Toggles" }) do
    setmetatable(Library[bucket], {
        __newindex = function(tbl, key, value)
            rawset(tbl, key, value)
            HookElement(key, value)
        end,
    })
end

