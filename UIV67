		end
		if not ec.minCover then
			ec.minCover = new("Frame", { Name = "MinimizeFade", BorderSizePixel = 0, ZIndex = 90, Active = false, Visible = false }, main)
			new("UICorner", { CornerRadius = mainCorner.CornerRadius }, ec.minCover)
		end
		local cv = ec.minCover
		cv.BackgroundColor3 = T.Main
		cv.Position = UDim2.new(0, 0, 0, ec.collapsedH)
		cv.Size = UDim2.new(1, 0, 1, -ec.collapsedH)
