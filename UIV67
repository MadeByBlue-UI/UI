local V6 = {}
do
-- ============================================================================
-- V6 : SONS PAR TYPE · PASTILLE « +N » · EFFET « TROU NOIR » À LA FERMETURE
-- ============================================================================

-- ───────────── Sons (un par type, réglables dans Paramètres > Sons des notifications) ─────────────
-- Les sons « rbxasset:// » viennent du dossier de contenu du client Roblox. Si l'un manque sur ta version,
-- choisis « Personnalisé » et donne un ID (123456), un rbxassetid://..., ou un fichier du workspace (mon_son.mp3).
local SOUND_PRESETS = {
	{ Name = "Aucun" },
	{ Name = "Ping",          Id = "rbxasset://sounds/electronicpingshort.wav", Speed = 1 },
	{ Name = "Ping aigu",     Id = "rbxasset://sounds/electronicpingshort.wav", Speed = 1.45 },
	{ Name = "Ping grave",    Id = "rbxasset://sounds/electronicpingshort.wav", Speed = 0.7 },
	{ Name = "Clic",          Id = "rbxasset://sounds/clickfast.wav", Speed = 1 },
	{ Name = "Interrupteur",  Id = "rbxasset://sounds/switch.wav", Speed = 1 },
	{ Name = "Claquement",    Id = "rbxasset://sounds/snap.mp3", Speed = 1 },
	{ Name = "Basse",         Id = "rbxasset://sounds/bass.wav", Speed = 1 },
	{ Name = "Victoire",      Id = "rbxasset://sounds/victory.wav", Speed = 1 },
	{ Name = "Uh-oh",         Id = "rbxasset://sounds/uuhhh.mp3", Speed = 1 },
	{ Name = "Personnalisé" },
}
local SOUND_BY_NAME, SOUND_NAMES = {}, {}
for _, p in ipairs(SOUND_PRESETS) do
	SOUND_BY_NAME[p.Name] = p
	SOUND_NAMES[#SOUND_NAMES + 1] = p.Name
end
Library.SoundPresetNames = SOUND_NAMES
Library.NotifSound  = true
Library.NotifVolume = 0.6
Library.NotifSounds = {
	Info    = { Preset = "Ping",         Custom = "" },
	Success = { Preset = "Ping aigu",    Custom = "" },
	Warning = { Preset = "Interrupteur", Custom = "" },
	Error   = { Preset = "Basse",        Custom = "" },
	Loading = { Preset = "Aucun",        Custom = "" },
}
Library.NotifBlackHole = true      -- effet « aspiré par le trou noir » à la fermeture
Library.NotifOverflow  = "Pill"    -- "Pill" = pastille +N au-delà du max | "Close" = ferme les plus anciennes
Library._silentSound   = 0         -- >0 : pas d'aperçu sonore (chargement d'une config)

local notifSoundObjs, lastSndAt = {}, 0

local function resolveSound(spec)
	if type(spec) ~= "table" then return nil end
	if spec.Preset == "Personnalisé" then
		local c = tostring(spec.Custom or ""):match("^%s*(.-)%s*$")
		if c == "" then return nil end
		if tonumber(c) then return "rbxassetid://" .. c, 1 end
		if c:find("^rbx") then return c, 1 end
		local ok, r = pcall(function()
			if isfile and getcustomasset and isfile(c) then return getcustomasset(c) end
		end)
		if ok and r then return r, 1 end
		return nil
	end
	local p = SOUND_BY_NAME[spec.Preset]
	if p and p.Id then return p.Id, p.Speed or 1 end
	return nil
end

local function playNotifSound(kind, preview)
	if not preview then
		if not Library.NotifSound then return end
		local now = os.clock()
		if now - lastSndAt < 0.12 then return end
		lastSndAt = now
	end
	local id, speed = resolveSound(Library.NotifSounds[kind])
	if not id then return end
	ensureNotif()
	local s = notifSoundObjs[kind]
	if not (s and s.Parent) then
		s = Instance.new("Sound")
		s.Name = "Snd" .. tostring(kind)
		s.Parent = notifGui
		notifSoundObjs[kind] = s
	end
	if s.SoundId ~= id then s.SoundId = id end
	s.PlaybackSpeed = speed or 1
	s.Volume = math.clamp(tonumber(Library.NotifVolume) or 0.6, 0, 1)
	s.TimePosition = 0
	s:Play()
end

function Library:PlayNotifSound(kind) playNotifSound(NOTIF_ICON[kind] and kind or "Info", true) end
function Library:GetSoundPresets() return table.clone(SOUND_NAMES) end

-- Library:SetNotifSound("Error", "Basse")  |  Library:SetNotifSound("Success", "123456789")  (ID perso)
function Library:SetNotifSound(kind, preset, custom)
	local spec = Library.NotifSounds[kind]
	if not spec then return false end
	if SOUND_BY_NAME[preset] then
		spec.Preset = preset
		if custom ~= nil then spec.Custom = tostring(custom) end
	elseif preset ~= nil then
		spec.Preset, spec.Custom = "Personnalisé", tostring(preset)
	end
	return true
end
function Library:SetNotifSoundEnabled(v) Library.NotifSound = v and true or false end
function Library:SetNotifVolume(v) Library.NotifVolume = math.clamp(tonumber(v) or 0.6, 0, 1) end

-- ───────────── Pastille « +N » (notifications masquées au-delà du maximum) ─────────────
local pillHost, pillBtn, pillScale, pillGrad
local pillCount = 0

local function pillAlign()
	local _, left, center = notifSide()
	return center and 0.5 or (left and 0 or 1)
end

local function ensurePill()
	if pillHost and pillHost.Parent then return end
	ensureNotif()
	pillHost = new("Frame", { Name = "OverflowPill", Size = UDim2.fromOffset(112, 30), BackgroundTransparency = 1,
		BorderSizePixel = 0, Visible = false }, notifHolder)
	pillBtn = new("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(64, 26), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.04,
		Text = "+1", TextColor3 = T.Text, TextSize = 12, Font = F_BOLD, AutoButtonColor = false,
		BorderSizePixel = 0 }, pillHost)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, pillBtn)
	local st = new("UIStroke", { Color = T.Accent, Thickness = 1.5, Transparency = 0.25, ApplyStrokeMode = BORDER }, pillBtn)
	pillGrad = new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(70, 70, 78)),
		Transparency = ringSeq() }, st)
	TweenService:Create(pillGrad, TweenInfo.new(3.5, LINEAR, OUT, -1), { Rotation = 360 }):Play()
	pillScale = new("UIScale", { Scale = 1 }, pillBtn)
	local function txt(hover) pillBtn.Text = "+" .. pillCount .. (hover and "  ·  vider" or "") end
	pillBtn.MouseEnter:Connect(function()
		txt(true)
		tween(pillBtn, { Size = UDim2.fromOffset(108, 26) }, 0.25)
	end)
	pillBtn.MouseLeave:Connect(function()
		txt(false)
		tween(pillBtn, { Size = UDim2.fromOffset(64, 26) }, 0.25)
	end)
	pillBtn.MouseButton1Click:Connect(function()
		for _, e in ipairs(table.clone(notifEntries)) do
			if e.hidden and not e.dead then pcall(e.handle.Dismiss) end
		end
	end)
end

local function updatePill(n)
	if n <= 0 then
		if pillHost and pillHost.Visible and pillCount > 0 then
			pillCount = 0
			-- la pastille est « aspirée » à son tour
			tween(pillScale, { Scale = 0 }, 0.3, BACK, Enum.EasingDirection.In)
			local host = pillHost
			task.delay(0.32 / math.max(Library.AnimSpeed or 1, 0.05), function()
				if pillCount == 0 and host.Parent then host.Visible = false end
			end)
		end
		return
	end
	ensurePill()
	local top = notifSide()
	local ax = pillAlign()
	pillHost.LayoutOrder = top and 1000000000 or -1000000000
	pillBtn.AnchorPoint = Vector2.new(ax, 0.5)
	pillBtn.Position = UDim2.new(ax, 0, 0.5, 0)
	local grew = n ~= pillCount
	local first = not pillHost.Visible
	pillCount = n
	pillBtn.Text = "+" .. n
	pillHost.Visible = true
	if first then
		pillScale.Scale = 0
		tween(pillScale, { Scale = 1 }, 0.45, BACK)
	elseif grew then
		pillScale.Scale = 1.3
		tween(pillScale, { Scale = 1 }, 0.45, BACK)
	end
end

-- Cache les plus anciennes au-delà du max (leur minuteur est mis en pause) et met la pastille à jour
local function refreshStack()
	if not notifHolder then return end
	local max = math.max(math.floor(tonumber(Library.NotifMax) or 5), 1)
	local live = {}
	for _, e in ipairs(notifEntries) do
		if not e.dead then live[#live + 1] = e end
	end
	local nHidden = (Library.NotifOverflow == "Pill") and math.max(#live - max, 0) or 0
	for idx, e in ipairs(live) do
		if e.setHidden then e.setHidden(idx <= nHidden) end
	end
	updatePill(nHidden)
end

function Library:SetNotifMax(n)
	Library.NotifMax = math.clamp(math.floor(tonumber(n) or 5), 1, 12)
	if Library.NotifOverflow == "Pill" then
		refreshStack()
	else
		while #activeNotifs > Library.NotifMax do activeNotifs[1]() end
	end
end

function Library:SetNotifOverflow(m)
	Library.NotifOverflow = (m == "Close" or m == false) and "Close" or "Pill"
	refreshStack()
	if Library.NotifOverflow == "Close" then
		while #activeNotifs > math.max(tonumber(Library.NotifMax) or 5, 1) do activeNotifs[1]() end
	end
end

function Library:SetNotifBlackHole(v) Library.NotifBlackHole = v and true or false end

-- ───────────── Effet « aspiré par le trou noir » ─────────────
-- Un petit trou noir apparaît sur la carte, qui se tord, tourne sur elle-même et s'engouffre dedans ;
-- quelques étincelles spiralent vers le centre, puis une onde de choc referme tout.
local function blackHoleOut(slot, card, cardScale, h, accent)
	local k = 1 / math.max(Library.AnimSpeed or 1, 0.05)
	local cw = card.AbsoluteSize.X / math.max(cardScale.Scale, 0.01)
	if cw < 10 then cw = Library.NotifWidth or 300 end
	local cy = h / 2
	local dirSpin = (math.random() < 0.5) and -1 or 1
	local IN = Enum.EasingDirection.In

	-- on fige la carte et on la recentre pour qu'elle tourne autour de son milieu
	card.AutomaticSize = AN
	card.Size = UDim2.new(1, 0, 0, h)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.new(0.5, 0, 0, cy)

	local sing = new("Frame", { Name = "Singularity", AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, cy), Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 30 }, slot)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, sing)
	local sst = new("UIStroke", { Color = accent, Thickness = 2, Transparency = 0.05 }, sing)
	local sgr = new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(70, 70, 78)),
		Transparency = ringSeq() }, sst)
	TweenService:Create(sgr, TweenInfo.new(0.8 * k, LINEAR, OUT), { Rotation = 360 * dirSpin }):Play()

	local halo = new("Frame", { Name = "Halo", AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, cy), Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 29 }, slot)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, halo)
	local hst = new("UIStroke", { Color = accent, Thickness = 1.5, Transparency = 0.35 }, halo)

	-- 1) le trou noir s'ouvre, la carte frémit
	tween(sing, { Size = UDim2.fromOffset(30, 30) }, 0.25, BACK)
	tween(halo, { Size = UDim2.fromOffset(84, 84) }, 0.45)
	tween(hst, { Transparency = 1 }, 0.5)
	tween(card, { Rotation = -4 * dirSpin }, 0.12)
	tween(cardScale, { Scale = 1.03 }, 0.12)

	-- 2) la carte est étirée, tourne et disparaît dans le trou
	task.delay(0.12 * k, function()
		if not card.Parent then return end
		tween(card, { Rotation = 220 * dirSpin, Size = UDim2.new(0.3, 0, 0, h * 1.15) }, 0.5, QUINT, IN)
		tween(cardScale, { Scale = 0.02 }, 0.5, QUINT, IN)
		task.delay(0.08 * k, function()
			if not card.Parent then return end
			if canvasSupported then tween(card, { GroupTransparency = 1 }, 0.4)
			else tween(card, { BackgroundTransparency = 1 }, 0.4) end
		end)
	end)

	-- 3) étincelles en spirale
	local parts = {}
	for i = 1, 10 do
		local sz = (i % 3 == 0) and 4 or 3
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sz, sz),
			BackgroundColor3 = (i % 2 == 0) and accent or Color3.new(1, 1, 1), BackgroundTransparency = 1,
			BorderSizePixel = 0, ZIndex = 28 }, slot)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		parts[i] = { f = f, a = math.random() * math.pi * 2, r = 40 + math.random() * math.max(cw / 2 - 50, 20),
			d = 0.08 + math.random() * 0.3, s = 3 + math.random() * 3 }
	end
	task.spawn(function()
		local t0 = os.clock()
		while slot.Parent do
			local t = (os.clock() - t0) / k
			if t > 1.05 then break end
			for _, p in ipairs(parts) do
				local u = math.clamp((t - p.d) / 0.5, 0, 1)
				if u > 0 then
					local ease = u * u
					local rad = p.r * (1 - ease)
					local ang = p.a + p.s * ease
					p.f.Position = UDim2.new(0.5, math.cos(ang) * rad, 0, cy + math.sin(ang) * rad * 0.55)
					local tr = 1 - math.min(u * 6, 1) * 0.9
					if u > 0.8 then tr = math.min(1, 0.1 + (u - 0.8) * 4.5) end
					p.f.BackgroundTransparency = tr
				end
			end
			RunService.Heartbeat:Wait()
		end
		for _, p in ipairs(parts) do p.f:Destroy() end
	end)

	-- 4) le trou noir se referme dans une onde de choc, la place se résorbe
	task.delay(0.55 * k, function()
		if not sing.Parent then return end
		tween(sing, { Size = UDim2.fromOffset(0, 0) }, 0.22, QUINT, IN)
		tween(sst, { Transparency = 1 }, 0.22)
		halo.Size = UDim2.fromOffset(24, 24)
		hst.Transparency = 0.15
		tween(halo, { Size = UDim2.fromOffset(64, 64) }, 0.4)
		tween(hst, { Transparency = 1 }, 0.4)
	end)
	task.delay(0.5 * k, function()
		if slot.Parent then tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, 0.3) end
	end)
end

	V6.play, V6.refresh, V6.hole = playNotifSound, refreshStack, blackHoleOut
end

function Library:Notify(o)
	if type(o) ~= "table" then o = { Content = tostring(o) } end
	local kind = NOTIF_ICON[o.Type] and o.Type or "Info"
	if (o.Progress ~= nil or o.Loading) and not NOTIF_ICON[o.Type] then kind = "Loading" end

	-- historique (même si « Ne pas déranger »)
	local hist = Library.NotifHistory
	hist[#hist + 1] = { Time = os.time(), Title = tostring(o.Title or "Notification"),
		Content = tostring(o.Content or ""), Type = kind }
	while #hist > 50 do table.remove(hist, 1) end
	if Library.NotifMuted and not o.Force and kind ~= "Error" then return noopHandle() end

	-- doublon : on empile (x2, x3...) au lieu d'ajouter une carte
	local stackable = (o.Stack ~= false) and o.Progress == nil and not o.Loading
		and kind ~= "Loading" and not o.Actions
	local key = kind .. "|" .. tostring(o.Title or "") .. "|" .. tostring(o.Content or "")
	if stackable and Library.NotifStack then
		for _, e in ipairs(notifEntries) do
			if not e.dead and e.stackable and e.key == key then
				e.bump()
				V6.play(kind)
				return e.handle
			end
		end
	end

	ensureNotif()
	V6.play(kind)
	notifCount = notifCount + 1
	local top, left, center = notifSide()
	local width = Library.NotifWidth or 300

	-- mode : timer | progress | loading | sticky
	local dur = o.Duration
	if dur == nil then dur = Library.NotifDuration or 4 end
	dur = tonumber(dur) or 4
	local finiteDur = dur > 0 and dur < math.huge
	local mode
	if o.Progress ~= nil then mode = "progress"
	elseif o.Loading or kind == "Loading" then mode = "loading"
	elseif not finiteDur then mode = "sticky"
	else mode = "timer" end
	if not finiteDur then dur = Library.NotifDuration or 4 end
	local progress = math.clamp(tonumber(o.Progress) or 0, 0, 1)

	local function farOffset(sign)
		if center then return UDim2.new(0, 0, 0, top and -90 or 90) end
		local s = sign or (left and -1 or 1)
		return UDim2.new(0, s * (width + 40), 0, 0)
	end
	local inward = center and 0 or (left and 1 or -1)
	local nudge = UDim2.new(0, inward * 6, 0, center and (top and 3 or -3) or 0)
	local ZERO = UDim2.new(0, 0, 0, 0)

	-- ---------------------------------------------------------------- carte
	local slot = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AN, BackgroundTransparency = 1, BorderSizePixel = 0,
		LayoutOrder = top and -notifCount or notifCount,
	}, notifHolder)
	local card = new(canvasSupported and "CanvasGroup" or "Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Position = farOffset(),
		BackgroundColor3 = T.Second, BackgroundTransparency = Sty.NotifTr, BorderSizePixel = 0,
		ClipsDescendants = not canvasSupported,
	}, slot)
	if canvasSupported then card.GroupTransparency = 1 end
	local cardCorner = corner(card, 10)
	local cardScale = new("UIScale", { Scale = 0.9 }, card)

	local inner = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
		ZIndex = 6 }, card)
	new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 14),
		PaddingLeft = UDim.new(0, 46), PaddingRight = UDim.new(0, 12) }, inner)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = BYORDER }, inner)
	local titleL = label(inner, o.Title or "Notification", 13, { Font = F_BOLD, Size = UDim2.new(1, -30, 0, 17),
		LayoutOrder = 1, TextTransparency = 1, ZIndex = 6 })
	local contentL = label(inner, o.Content or "", 12, { TextColor3 = T.ElementAccent, TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None, AutomaticSize = AY, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2,
		TextTransparency = 1, ZIndex = 6 })
	contentL.Visible = contentL.Text ~= ""

	local actRow = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1,
		LayoutOrder = 3, Visible = false, ZIndex = 6 }, inner)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
		SortOrder = BYORDER }, actRow)
	new("UIPadding", { PaddingTop = UDim.new(0, 7) }, actRow)

	-- liseré de couleur à gauche
	local strip = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 3, 0, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0, Visible = false,
		ZIndex = 6 }, card)

	-- pastille d'icône (+ onde, + spinner)
	local icoHold = new("Frame", { Position = UDim2.new(0, 11, 0, 10), Size = UDim2.new(0, 24, 0, 24),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6 }, card)
	local pulse = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1, BorderSizePixel = 0 }, icoHold)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, pulse)
	local pulseSt = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 1 }, pulse)
	local ico = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9,
		BorderSizePixel = 0 }, icoHold)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, ico)
	local icoScale = new("UIScale", { Scale = 0 }, ico)
	local icoText = label(ico, "i", 14, { Font = F_BOLD, TextXAlignment = CENTER })
	local spinRing = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false }, ico)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, spinRing)
	local spinSt = new("UIStroke", { Color = T.Accent, Thickness = 2, Transparency = 0 }, spinRing)
	local spinGrad = new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0.2),
		NumberSequenceKeypoint.new(0.62, 1), NumberSequenceKeypoint.new(1, 1) }) }, spinSt)
	local spinTw

	-- badge « x2 » (doublons)
	local badge = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 9),
		Size = UDim2.new(0, 26, 0, 16), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.86,
		BorderSizePixel = 0, Visible = false, ZIndex = 6 }, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, badge)
	local badgeScale = new("UIScale", { Scale = 1 }, badge)
	local badgeL = label(badge, "x2", 10, { Font = F_BOLD, TextXAlignment = CENTER, ZIndex = 6 })

	-- contour intérieur + piste de durée / progression
	local outline = new("Frame", { Position = UDim2.new(0, 1, 0, 1), Size = UDim2.new(1, -2, 1, -2),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 7 }, card)
	new("UICorner", { CornerRadius = UDim.new(0, 9) }, outline)
	local outSt = stroke(outline, 0.82)
	local track = new("Frame", { Position = UDim2.new(0, 12, 1, -6), Size = UDim2.new(1, -24, 0, 3),
		BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, BorderSizePixel = 0, ClipsDescendants = true,
		ZIndex = 6 }, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
	local fill = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = T.Accent,
		BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 6 }, track)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	-- reflet qui balaie la carte
	local shine = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, Visible = false, ZIndex = 8 }, card)
	new("UICorner", { CornerRadius = UDim.new(0, 10) }, shine)
	local shineGrad = new("UIGradient", { Rotation = 20, Offset = Vector2.new(-1.3, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 1), NumberSequenceKeypoint.new(0.5, 0.82),
			NumberSequenceKeypoint.new(0.6, 1), NumberSequenceKeypoint.new(1, 1) }) }, shine)

	local clickArea = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, ZIndex = 5 }, card)

	-- ---------------------------------------------------------------- état
	local dead = false
	local entry, handle
	local token, remaining, startedAt, paused, barTw, loadTw = 0, dur, 0, false, nil, nil
	local count = 1
	local baseTr = 0.82
	local hov = 0
	local dismiss, runTimer

	local function stopBar()
		if barTw then barTw:Cancel() barTw = nil end
	end

	local function shinePlay()
		if not Library.Animations then return end
		local t = 0.8 / math.max(Library.AnimSpeed or 1, 0.05)
		shine.Visible = true
		shineGrad.Offset = Vector2.new(-1.3, 0)
		tween(shineGrad, { Offset = Vector2.new(1.3, 0) }, 0.8)
		local my = (shine:GetAttribute("S") or 0) + 1
		shine:SetAttribute("S", my)
		task.delay(t + 0.1, function()
			if shine:GetAttribute("S") == my then shine.Visible = false end
		end)
	end

	local function applyKind(k)
		kind = k
		local c = notifKindColor(k)
		local ac = c or T.Accent
		ico.BackgroundColor3 = ac
		ico.BackgroundTransparency = c and 0.05 or 0.9
		icoText.Text = NOTIF_ICON[k] or ""
		icoText.Visible = k ~= "Loading"
		icoText.TextColor3 = c and Color3.fromRGB(14, 14, 16) or T.Text
		strip.BackgroundColor3 = ac
		strip.Visible = c ~= nil
		outSt.Color = ac
		baseTr = c and 0.55 or 0.82
		outSt.Transparency = baseTr
		fill.BackgroundColor3 = ac
		pulseSt.Color = ac
		spinSt.Color = ac
		spinRing.Visible = k == "Loading"
		if spinTw then spinTw:Cancel() spinTw = nil end
		if k == "Loading" then
			spinTw = TweenService:Create(spinGrad, TweenInfo.new(0.9, LINEAR, OUT, -1), { Rotation = 360 })
			spinTw:Play()
		end
	end

	local function playIcon()
		icoScale.Scale = 0
		ico.Rotation = (kind == "Success") and -90 or 0
		tween(icoScale, { Scale = 1 }, 0.5, BACK)
		if kind == "Success" then tween(ico, { Rotation = 0 }, 0.5) end
		pulse.Size = UDim2.fromOffset(24, 24)
		pulseSt.Transparency = 0.15
		tween(pulse, { Size = UDim2.fromOffset(52, 52) }, 0.75)
		tween(pulseSt, { Transparency = 1 }, 0.75)
		if not Library.Animations then return end
		if kind == "Error" then
			task.spawn(function()
				task.wait(0.2)
				for _, dx in ipairs({ -4, 4, -3, 3, -2, 2, 0 }) do
					if dead then return end
					tween(icoHold, { Position = UDim2.new(0, 11 + dx, 0, 10) }, 0.05, LINEAR)
					task.wait(0.05)
				end
			end)
		elseif kind == "Warning" then
			task.spawn(function()
				task.wait(0.2)
				for _, r in ipairs({ -16, 14, -9, 6, 0 }) do
					if dead then return end
					tween(ico, { Rotation = r }, 0.07, LINEAR)
					task.wait(0.07)
				end
			end)
		end
	end

	-- ---------------------------------------------------------------- minuteur
	runTimer = function()
		if mode ~= "timer" or dead then return end
		if entry and entry.hidden then
			-- masquée derrière la pastille +N : le minuteur démarre quand elle redevient visible
			paused = true
			startedAt = os.clock()
			fill.Size = UDim2.new(math.clamp(remaining / dur, 0, 1), 0, 1, 0)
			return
		end
		token += 1
		local my = token
		stopBar()
		paused = false
		startedAt = os.clock()
		fill.Size = UDim2.new(math.clamp(remaining / dur, 0, 1), 0, 1, 0)
		barTw = TweenService:Create(fill, TweenInfo.new(math.max(remaining, 0.01), LINEAR, OUT),
			{ Size = UDim2.new(0, 0, 1, 0) })
		barTw:Play()
		task.delay(remaining, function()
			if token == my and not dead then dismiss(nil, "timeout") end
		end)
	end

	local function pauseTimer()
		if mode ~= "timer" or paused or dead then return end
		paused = true
		token += 1
		stopBar()
		remaining = math.max(remaining - (os.clock() - startedAt), 0.25)
		fill.Size = UDim2.new(math.clamp(remaining / dur, 0, 1), 0, 1, 0)
	end

	local function resumeTimer()
		if paused and not dead then runTimer() end
	end

	local function applyMode()
		if dead then return end
		stopBar()
		if loadTw then loadTw:Cancel() loadTw = nil end
		token += 1
		paused = false
		fill.Position = UDim2.new(0, 0, 0, 0)
		if mode == "timer" then
			track.Visible = true
			remaining = dur
			runTimer()
		elseif mode == "progress" then
			track.Visible = true
			tween(fill, { Size = UDim2.new(progress, 0, 1, 0) }, 0.25)
		elseif mode == "loading" then
			track.Visible = true
			fill.Size = UDim2.new(0.35, 0, 1, 0)
			fill.Position = UDim2.new(-0.35, 0, 0, 0)
			loadTw = TweenService:Create(fill, TweenInfo.new(1.1, Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut, -1), { Position = UDim2.new(1, 0, 0, 0) })
			loadTw:Play()
		else
			track.Visible = false
		end
	end

	-- ---------------------------------------------------------------- fermeture
	dismiss = function(dir, reason)
		if dead then return end
		dead = true
		entry.dead = true
		token += 1
		stopBar()
		if loadTw then loadTw:Cancel() loadTw = nil end
		if spinTw then spinTw:Cancel() spinTw = nil end
		for idx, fn in ipairs(activeNotifs) do
			if fn == entry.overflow then table.remove(activeNotifs, idx) break end
		end
		for idx, e in ipairs(notifEntries) do
			if e == entry then table.remove(notifEntries, idx) break end
		end
		if o.OnDismiss then fire(o.OnDismiss, reason or "api") end

		local function dropCorner()
			for idx, c in ipairs(Library.CornerObjects) do
				if c.Corner == cardCorner then table.remove(Library.CornerObjects, idx) break end
			end
		end
		task.defer(V6.refresh)   -- une notification masquée peut reprendre sa place, la pastille se met à jour
		if entry.hidden then
			dropCorner()
			slot:Destroy()
			return
		end
		local h = slot.AbsoluteSize.Y
		slot.AutomaticSize = AN
		slot.Size = UDim2.new(1, 0, 0, h)
		local sign = (type(dir) == "number" and dir ~= 0) and dir or nil

		-- effet « trou noir » (sauf swipe : là, la carte suit le doigt / la souris)
		if Library.NotifBlackHole ~= false and Library.Animations and not sign and h > 4 then
			V6.hole(slot, card, cardScale, h, notifKindColor(kind) or T.Accent)
			task.delay(1.0 / math.max(Library.AnimSpeed or 1, 0.05), function()
				dropCorner()
				slot:Destroy()
			end)
			return
		end

		if canvasSupported then tween(card, { GroupTransparency = 1 }, 0.35) end
		tween(card, { Position = farOffset(sign) }, 0.42)
		tween(cardScale, { Scale = 0.94 }, 0.3)
		task.delay(0.22, function()
			if slot.Parent then tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, 0.3) end
		end)
		task.delay(0.6, function()
			dropCorner()
			slot:Destroy()
		end)
	end

	-- ---------------------------------------------------------------- survol (pause + petit décalage)
	local function hoverChange(delta)
		if dead then return end
		hov = math.max(hov + delta, 0)
		if hov > 0 then
			if Library.NotifPauseOnHover ~= false then pauseTimer() end
			tween(card, { Position = nudge }, 0.25)
			tween(outSt, { Transparency = math.max(baseTr - 0.3, 0.05) }, 0.25)
		else
			task.delay(0.06, function()
				if hov == 0 and not dead then
					resumeTimer()
					tween(card, { Position = ZERO }, 0.3)
					tween(outSt, { Transparency = baseTr }, 0.3)
				end
			end)
		end
	end
	clickArea.MouseEnter:Connect(function() hoverChange(1) end)
	clickArea.MouseLeave:Connect(function() hoverChange(-1) end)

	-- ---------------------------------------------------------------- boutons d'action
	local function buildActions(list)
		for _, c in ipairs(actRow:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		actRow.Visible = type(list) == "table" and #list > 0
		if type(list) ~= "table" then return end
		for idx, a in ipairs(list) do
			local btn = new("TextButton", { Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = T.Accent, BackgroundTransparency = 0.9, Text = tostring(a.Text or a.Name or "OK"),
				TextColor3 = T.Text, TextSize = 12, Font = F_MED, AutoButtonColor = false, BorderSizePixel = 0,
				LayoutOrder = idx, ZIndex = 6 }, actRow)
			new("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)
			new("UIPadding", { PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 11) }, btn)
			btn.MouseEnter:Connect(function()
				tween(btn, { BackgroundTransparency = 0.76 }, 0.15)
				hoverChange(1)
			end)
			btn.MouseLeave:Connect(function()
				tween(btn, { BackgroundTransparency = 0.9 }, 0.2)
				hoverChange(-1)
			end)
			btn.MouseButton1Click:Connect(function()
				btn.BackgroundTransparency = 0.3
				tween(btn, { BackgroundTransparency = 0.76 }, 0.4)
				fire(a.Callback, handle)
				if a.Keep ~= true then dismiss(nil, "action") end
			end)
		end
	end

	-- ---------------------------------------------------------------- clic / swipe pour fermer
	clickArea.InputBegan:Connect(function(i)
		if not isPress(i) or dead then return end
		local start = Vector2.new(i.Position.X, i.Position.Y)
		local moved, dx = false, 0
		pauseTimer()
		startDrag(function(p)
			dx = p.X - start.X
			if math.abs(dx) > 6 and o.Dismissable ~= false and not center then moved = true end
			if moved and not dead then
				card.Position = UDim2.new(0, dx, 0, 0)
				if canvasSupported then card.GroupTransparency = math.clamp(math.abs(dx) / 260, 0, 0.8) end
			end
		end, nil, i.Position, function()
			if dead then return end
			if not moved then
				if o.OnClick then fire(o.OnClick, handle) end
				if o.Dismissable ~= false then dismiss(nil, "click") else resumeTimer() end
			elseif math.abs(dx) > 90 then
				dismiss(dx > 0 and 1 or -1, "swipe")
			else
				tween(card, { Position = (hov > 0) and nudge or ZERO }, 0.4, BACK)
				if canvasSupported then tween(card, { GroupTransparency = 0 }, 0.3) end
				if hov == 0 then resumeTimer() end
			end
		end)
	end)

	-- ---------------------------------------------------------------- mise à jour
	local function setProgress(p)
		progress = math.clamp(tonumber(p) or 0, 0, 1)
		if mode ~= "progress" then
			mode = "progress"
			applyMode()
		end
		tween(fill, { Size = UDim2.new(progress, 0, 1, 0) }, 0.25)
		if progress >= 1 and o.AutoComplete ~= false then
			task.delay(0.35, function()
				if dead or progress < 1 then return end
				if kind == "Loading" then
					applyKind("Success")
					playIcon()
					V6.play("Success")
				end
				shinePlay()
				mode = "timer"
				applyMode()
			end)
		end
	end

	local function update(d)
		if type(d) ~= "table" or dead then return end
		entry.stackable = false
		if d.Title ~= nil then
			titleL.Text = tostring(d.Title)
			titleL.TextTransparency = 0.7
			tween(titleL, { TextTransparency = 0 }, 0.3)
		end
		if d.Content ~= nil then
			contentL.Text = tostring(d.Content)
			contentL.Visible = contentL.Text ~= ""
			contentL.TextTransparency = 0.7
			tween(contentL, { TextTransparency = 0 }, 0.3)
		end
		local typeChanged = false
		if d.Type and NOTIF_ICON[d.Type] and d.Type ~= kind then
			applyKind(d.Type)
			playIcon()
			V6.play(d.Type)
			typeChanged = true
		end
		if d.Duration ~= nil then
			local nd = tonumber(d.Duration) or dur
			if nd > 0 and nd < math.huge then
				dur = nd
				mode = "timer"
			else
				mode = "sticky"
			end
			applyMode()
		elseif typeChanged and (mode == "loading" or mode == "progress") and kind ~= "Loading" and d.Progress == nil then
			mode = "timer"
			applyMode()
		end
		if d.Progress ~= nil then setProgress(d.Progress) end
		if typeChanged or d.Title ~= nil or d.Content ~= nil then shinePlay() end
	end

	handle = {}
	handle.Update = function(...) update((unself(handle, ...))) end
	handle.SetProgress = function(...)
		local v = unself(handle, ...)
		update({ Progress = v })
	end
	handle.SetTitle = function(...) update({ Title = (unself(handle, ...)) }) end
	handle.SetContent = function(...) update({ Content = (unself(handle, ...)) }) end
	handle.SetType = function(...) update({ Type = (unself(handle, ...)) }) end
	handle.Dismiss = function() dismiss(nil, "api") end
	handle.Pause = function() pauseTimer() end
	handle.Resume = function() resumeTimer() end
	handle.IsAlive = function() return not dead end

	entry = { key = key, handle = handle, stackable = stackable, dead = false }
	entry.overflow = function() dismiss(nil, "overflow") end
	entry.hidden = false
	-- masquée (au-delà du max, derrière la pastille +N) / de nouveau visible
	entry.setHidden = function(hide)
		if dead or entry.hidden == hide then return end
		entry.hidden = hide
		if hide then
			slot.Visible = false
			if startedAt > 0 and not paused then pauseTimer() end
		else
			slot.Visible = true
			cardScale.Scale = 0.88
			if canvasSupported then card.GroupTransparency = 0.6 end
			tween(cardScale, { Scale = 1 }, 0.45, BACK)
			if canvasSupported then tween(card, { GroupTransparency = 0 }, 0.3) end
			if hov == 0 then resumeTimer() end
		end
	end
	entry.bump = function()
		if dead then return end
		count += 1
		badgeL.Text = "x" .. count
		badge.Visible = true
		badgeScale.Scale = 1.6
		tween(badgeScale, { Scale = 1 }, 0.45, BACK)
		card.Position = UDim2.new(0, inward * 10, 0, 0)
		tween(card, { Position = (hov > 0) and nudge or ZERO }, 0.45, BACK)
		shinePlay()
		if mode == "timer" then
			remaining = dur
			if paused then fill.Size = UDim2.new(1, 0, 1, 0) else runTimer() end
		end
	end

	applyKind(kind)
	buildActions(o.Actions)
	notifEntries[#notifEntries + 1] = entry
	activeNotifs[#activeNotifs + 1] = entry.overflow
	if Library.NotifOverflow == "Pill" then
		V6.refresh()
	else
		while #activeNotifs > math.max(tonumber(Library.NotifMax) or 5, 1) do activeNotifs[1]() end
	end

	-- ---------------------------------------------------------------- animation d'entrée
	task.spawn(function()
		RunService.Heartbeat:Wait()
		if dead then return end
		local h = card.AbsoluteSize.Y / math.max(cardScale.Scale, 0.01)
		if h < 4 then
			RunService.Heartbeat:Wait()
			h = card.AbsoluteSize.Y / math.max(cardScale.Scale, 0.01)
		end
		local grow = tween(slot, { Size = UDim2.new(1, 0, 0, h) }, 0.38)
		grow.Completed:Connect(function()
			if not dead then
				slot.AutomaticSize = AY
				slot.Size = UDim2.new(1, 0, 0, 0)
			end
		end)
		tween(card, { Position = ZERO }, 0.6)
		tween(cardScale, { Scale = 1 }, 0.55, BACK)
		if canvasSupported then tween(card, { GroupTransparency = 0 }, 0.35) end
		if strip.Visible then tween(strip, { Size = UDim2.new(0, 3, 1, 0) }, 0.55) end
		task.delay(0.12, function() if not dead then playIcon() end end)
		task.delay(0.15, function() if not dead then tween(titleL, { TextTransparency = 0 }, 0.3) end end)
		task.delay(0.25, function() if not dead then tween(contentL, { TextTransparency = 0 }, 0.3) end end)
		task.delay(0.2, function() if not dead then shinePlay() end end)
		task.delay(0.3, function() if not dead then applyMode() end end)
	end)

	return handle
end

