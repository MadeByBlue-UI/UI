function Library:SetStyle(name)
	local st = STYLES[name]
	if not st then return false end
	Library.StyleName = name
	for k, v in pairs(STYLES["Standard"]) do Sty[k] = v end
	for k, v in pairs(st) do Sty[k] = v end
	local keep = {}
	for _, e in ipairs(styled) do
		if styleOne(e) then keep[#keep + 1] = e end
	end
	styled = keep
	-- flou proposé par le style (le curseur « Flou » suit)
	local it = Library.Items["ui.blur"]
	if it and it.Set then pcall(it.Set, it, Sty.BlurSize) else Library:SetBlur(Sty.BlurSize) end
	local w = Library.Window
	if w and w.ApplyStyle then w:ApplyStyle() end
	if Library.RefreshNotifStyle then Library.RefreshNotifStyle() end   -- les notifications suivent le style
	return true
end

