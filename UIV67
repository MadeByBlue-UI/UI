function Library:SetToggleStyle(name)
	if not TOGGLE_STYLES[name] then name = "Pilule" end
	Library.ToggleStyle = name
	for i = #toggleSkins, 1, -1 do
		local e = toggleSkins[i]
		if e.f and e.f.Parent then pcall(e.skin) else table.remove(toggleSkins, i) end
	end
end

function Library:NextToggleStyle(step)
	local idx = table.find(TOGGLE_ORDER, Library.ToggleStyle) or 1
	idx = ((idx - 1 + (step or 1)) % #TOGGLE_ORDER) + 1
	local nm = TOGGLE_ORDER[idx]
	local it = Library.Items and Library.Items["ui.togglestyle"]
	if it and it.Set then pcall(it.Set, it, nm) else Library:SetToggleStyle(nm) end
	return nm
end

-- Toggle. Option Keybind = Enum.KeyCode.X (ou true) : ajoute une puce de touche (clic = changer, Retour arrière = effacer)
-- et appuyer sur la touche bascule le toggle. KeyCallback = function(touche). HUD = false : caché du HUD des actifs.
function Block:CreateToggle(o)
	o = o or {}
	local f, st = makeRow(self, 34, o.Name)
	-- touche : donnée par le script (Keybind = ...) ou assignable par le joueur (clic droit sur la ligne)
	local explicitKey = o.Keybind ~= nil and o.Keybind ~= false
	local keyOk = o.Keybind ~= false and not self._noFav and not (self.Tab and self.Tab._isSettings)
	local hasKey = explicitKey or keyOk
	local nameLbl = label(f, o.Name or "Toggle", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, explicitKey and -190 or -70, 1, 0) })
	-- conteneur de l'interrupteur : son dessin dépend du style choisi (Paramètres > Style des toggles)
	local sw = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 38, 0, 20), BackgroundTransparency = 1, BorderSizePixel = 0,
	}, f)
	local btn = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, f)
	hover(f, st, btn)

	local state = o.Default and true or false
	local keyMode = "Toggle"   -- Toggle / Hold / Always (sélecteur sur la ligne)
	local paint
	local function skin()
		for _, c in ipairs(sw:GetChildren()) do c:Destroy() end
		paint = (TOGGLE_STYLES[Library.ToggleStyle] or TOGGLE_STYLES["Pilule"])(sw)
		paint(state, true)
	end
	toggleSkins[#toggleSkins + 1] = { f = f, skin = skin }
	if #toggleSkins % 200 == 0 then   -- nettoie les lignes détruites
		local keep = {}
		for _, e in ipairs(toggleSkins) do
			if e.f and e.f.Parent then keep[#keep + 1] = e end
		end
		toggleSkins = keep
	end
	local function apply(v, silent)
		if keyMode == "Always" then v = true end
		state = v
		if o.Flag then Library.Flags[o.Flag] = v end
		paint(v)
		if Library._hudRefresh then Library._hudRefresh() end
		if not silent then fire(o.Callback, v) end
	end
	local item = {}
	item.Set = function(...) apply((unself(item, ...)) and true or false) end
	item.Get = function() return state end
	f.ClipsDescendants = true
	btn.MouseButton1Click:Connect(function() ripple(f) apply(not state) uiSnd(state and "on" or "off") end)

	-- ---- touche liée : option Keybind = Enum.KeyCode.X, ou clic droit sur le toggle pour en assigner une
	--      (Échap = annuler, Retour / Suppr = retirer la touche ; Keybind = false = pas de touche pour ce toggle)
	if hasKey then
		local key = (typeof(o.Keybind) == "EnumItem") and o.Keybind or Enum.KeyCode.Unknown
		local kb = new("Frame", { Name = "KeyBox", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -58, 0.5, 0),
			Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, BorderSizePixel = 0,
			ZIndex = 3, Visible = explicitKey or key ~= Enum.KeyCode.Unknown }, f)
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = BYORDER,
			HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center }, kb)
		keyMode = (o.KeyMode == "Hold" or o.KeyMode == "Always") and o.KeyMode or "Toggle"
		-- sélecteur de mode (clic = Toggle > Hold > Always)
		local modeChip = new("TextButton", { Name = "KeyMode", Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 1, BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0, Text = keyMode,
			TextColor3 = T.ElementAccent, TextSize = 10, Font = F_MED, AutoButtonColor = false, ZIndex = 3 }, kb)
		corner(modeChip, 6)
		new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, modeChip)
		trackStyled(modeChip, stroke(modeChip, 0.9), "input")
		local chip = new("TextButton", {
			Size = UDim2.new(0, 0, 0, 20), LayoutOrder = 2,
			AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.Off, BackgroundTransparency = 0.4,
			BorderSizePixel = 0, Text = shortKey(key) or "—", TextColor3 = T.Text, TextSize = 11, Font = F_MED,
			AutoButtonColor = false, ZIndex = 3,
		}, kb)
		corner(chip, 6)
		new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, chip)
		local cst = stroke(chip, 0.9)
		trackStyled(chip, cst, "input")

		local listening, lastBind = false, 0
		local keyItem = {}
		local registered, bindConn = false, nil
		local endConn
		local MODE_ORDER = { "Toggle", "Hold", "Always" }
		local modeItem = {}
		local function setMode(m)
			if not table.find(MODE_ORDER, m) then return end
			local prev = keyMode
			keyMode = m
			modeChip.Text = m
			if o.Flag then Library.Flags[o.Flag .. ".mode"] = m end
			if m == "Always" then apply(true) elseif m == "Hold" or prev == "Always" then apply(false) end
			fire(o.ModeCallback, m)
		end
		modeChip.MouseButton1Click:Connect(function()
			uiSnd("click")
			setMode(MODE_ORDER[((table.find(MODE_ORDER, keyMode) or 1) % 3) + 1])
		end)
		modeItem.Get = function() return keyMode end
		modeItem.Set = function(...) setMode((unself(modeItem, ...))) end

		local function refreshLook()
			local has = key ~= Enum.KeyCode.Unknown
			kb.Visible = explicitKey or has or listening
			nameLbl.Size = UDim2.new(1, (explicitKey or has or listening) and -190 or -70, 1, 0)
		end

		-- l'entrée n'apparaît dans « Raccourcis clavier » qu'une fois qu'une touche existe
		local function ensureEntry()
			if registered or self._noFav then return end
			registered = true
			Library.KeybindEntries[#Library.KeybindEntries + 1] = { Name = tostring(o.Name or "Toggle") .. " (touche)",
				Tab = self.Tab, Block = self, Frame = f, Item = keyItem, BadgeX = -124 }
			if Library._onKeybindAdded then pcall(Library._onKeybindAdded) end
		end

		-- un seul écouteur clavier par toggle, créé seulement quand une touche est définie
		local function ensureConn()
			if bindConn then return end
			bindConn = track(UIS.InputBegan:Connect(function(i, gp)
				if gp or listening or Library._listening then return end
				if not Library._kb.hit(i, key) then return end
				if keyMode == "Always" then return end
				if os.clock() - lastBind < 0.2 or not f.Parent then return end
				if UIS:GetFocusedTextBox() then return end
				if keyMode == "Hold" then apply(true) else apply(not state) end
				uiSnd(state and "on" or "off")
			end))
			endConn = track(UIS.InputEnded:Connect(function(i)
				if keyMode == "Hold" and state and Library._kb.hit(i, key) then
					apply(false)
					uiSnd("off")
				end
			end))
		end

		local function setKey(k, silent)
			key = k
			chip.Text = shortKey(k) or "—"
			lastBind = os.clock()
			if k ~= Enum.KeyCode.Unknown then ensureEntry() ensureConn() end
			refreshLook()
			if o.Flag then Library.Flags[o.Flag .. ".key"] = k.Name end
			if Library._hudRefresh then Library._hudRefresh() end
			if Library.RefreshKeybindConflicts then Library:RefreshKeybindConflicts() end
			if Library._onKeybindChanged then pcall(Library._onKeybindChanged) end
			if not silent then
				if Library._notifyKeyConflict then Library:_notifyKeyConflict(f, k) end
				fire(o.KeyCallback, k)
			end
		end

		local function startListen()
			if listening or Library._listening then return end
			listening = true
			Library._listening = true
			chip.Text = "..."
			refreshLook()
			uiSnd("focus")
			tween(cst, { Transparency = 0.25 }, 0.2)
			local c
			local function stop()
				if c then c:Disconnect() c = nil end
				listening = false
				Library._listening = false
				Library._abortListen = nil
				tween(cst, { Transparency = Sty.InputStroke }, 0.3)
			end
			-- l'interface se masque pendant l'écoute : on annule (sinon la prochaine touche du jeu serait capturée)
			Library._abortListen = function() stop() chip.Text = shortKey(key) or "—" refreshLook() end
			c = Library._kb.listen(function(k)   -- touche du clavier OU clic gauche / droit / milieu
				stop()
				if k == Enum.KeyCode.Escape then
					chip.Text = shortKey(key) or "—"   -- annulé : la touche actuelle est gardée
					refreshLook()
				elseif k == Enum.KeyCode.Backspace or k == Enum.KeyCode.Delete then
					setKey(Enum.KeyCode.Unknown)
				else
					setKey(k)
				end
			end)
		end
		chip.MouseButton1Click:Connect(startListen)
		btn.MouseButton2Click:Connect(startListen)   -- clic droit sur la ligne du toggle

		keyItem.Set = function(...)
			local k = unself(keyItem, ...)
			if type(k) == "string" then k = Library._kb.parse(k) end
			if typeof(k) == "EnumItem" then setKey(k, (Library._silentSound or 0) > 0) end   -- config / auto-load : silencieux
		end
		keyItem.Get = function() return key end
		item.SetKey = function(...) keyItem.Set(...) end
		item.GetKey = function() return key end
		item.SetMode = function(...) modeItem.Set(...) end
		item.GetMode = function() return keyMode end
		if o.Flag then register(o.Flag .. ".mode", modeItem, keyMode) end
		if o.Flag then register(o.Flag .. ".key", keyItem, key.Name) end
		if key ~= Enum.KeyCode.Unknown then ensureEntry() ensureConn() end
		refreshLook()
		if explicitKey and Library.RefreshKeybindConflicts then Library:RefreshKeybindConflicts() end
	end

	skin()
	register(o.Flag, item, state)
	if keyMode == "Always" then apply(true, true) end
	if Library.FireDefaults then fire(o.Callback, state) end
	return item
end

function Block:CreateSlider(o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local step = o.Step or o.Increment
	local def = math.clamp(o.Default or min, min, max)
	local dec = o.Rounding
	if dec == nil then
		local frac = (min % 1 ~= 0) or (max % 1 ~= 0) or (def % 1 ~= 0) or (step and step % 1 ~= 0)
		dec = frac and 2 or 0
	end
	local mult = 10 ^ dec
	local suffix = o.Suffix and tostring(o.Suffix) or ""

	-- exact = true (saisie au clavier / item:Set) : aucune accroche sur le pas, précision libre (jusqu'à 6 décimales).
	-- exact = false (glisser la poignée) : accroche sur Step / Rounding comme avant.
	local function snap(v, exact)
		v = math.clamp(v, min, max)
		if exact then
			v = math.floor(v * 1e6 + 0.5) / 1e6
		else
			if step and step > 0 then v = min + math.floor((v - min) / step + 0.5) * step end
			v = math.floor(v * mult + 0.5) / mult
		end
		return math.clamp(v, min, max)
	end
	local function fmt(v) return tostring(v) .. suffix end

	local f, st = makeRow(self, 50, o.Name)
	label(f, o.Name or "Slider", 13, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -110, 0, 18) })
	local valBox = new("TextBox", {
		Position = UDim2.new(1, -92, 0, 6), Size = UDim2.new(0, 80, 0, 18), BackgroundColor3 = T.Off,
		BackgroundTransparency = 1, Text = "", TextColor3 = T.ElementAccent, TextSize = 12, Font = F_MED,
		TextXAlignment = RIGHT, ClearTextOnFocus = false, BorderSizePixel = 0,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, f)
	corner(valBox, 5)
	new("UIPadding", { PaddingRight = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5) }, valBox)

	local bar = new("Frame", {
		Position = UDim2.new(0, 12, 0, 34), Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = T.Off, BorderSizePixel = 0,
	}, f)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, bar)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 12, 0, 12),
		BackgroundColor3 = T.Accent, BorderSizePixel = 0,
	}, bar)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	stroke(knob, 0.6, 2)
	local hit = new("TextButton", { Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1, Text = "" }, f)
	hover(f, st)

	local value
	local shownV, numTok, fillTw, knobTw = nil, 0, nil, nil
	-- le chiffre défile jusqu'à la nouvelle valeur (pendant un glisser continu : direct)
	local function showNumber(v, animate)
		numTok += 1
		local my = numTok
		if valBox:IsFocused() then shownV = v return end
		if not animate or not Library.Animations or shownV == nil or shownV == v then
			shownV = v
			valBox.Text = fmt(v)
			return
		end
		local from, to = shownV, v
		local dur = 0.3 / math.max(Library.AnimSpeed or 1, 0.05)
		local t0 = os.clock()
		task.spawn(function()
			while numTok == my and f.Parent do
				local a = math.clamp((os.clock() - t0) / dur, 0, 1)
				local cur = from + (to - from) * TweenService:GetValue(a, QUINT, OUT)
				shownV = (a >= 1) and to or cur
				if not valBox:IsFocused() then
					valBox.Text = (a >= 1) and fmt(to) or fmt(math.floor(cur * mult + 0.5) / mult)
				end
				if a >= 1 then break end
				Ticker.wait()
			end
		end)
	end
	local function apply(v, silent, instant, exact)
		v = snap(v, exact)
		if v == value and not silent then return end
		value = v
		local span = max - min
		local ratio = span == 0 and 0 or (v - min) / span
		if instant then
			Library._springStop(fill)
			Library._springStop(knob, "Position")
			fill.Size = UDim2.new(ratio, 0, 1, 0)
			knob.Position = UDim2.new(ratio, 0, 0.5, 0)
		else
			Library._spring(fill, { Size = UDim2.new(ratio, 0, 1, 0) }, "smooth")
			Library._spring(knob, { Position = UDim2.new(ratio, 0, 0.5, 0) }, "smooth")
		end
		showNumber(v, not instant)
		if o.Flag then Library.Flags[o.Flag] = v end
		if not silent then fire(o.Callback, v) end
	end
	local item = {}
	item.Set = function(...)
		local v = tonumber((unself(item, ...)))
		if v then apply(v, false, false, true) end
	end
	item.Get = function() return value end

	hit.InputBegan:Connect(function(i)
		if isPress(i) then
			Library._spring(knob, { Size = UDim2.new(0, 17, 0, 17) }, "bouncy")
			local firstHit = true   -- premier point = clic sur la barre : la poignée glisse et le chiffre défile ; ensuite direct
			startDrag(function(p)
				local t = math.clamp((p.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
				apply(min + t * (max - min), false, not firstHit)
				firstHit = false
			end, self.Scroll, i.Position, function()
				Library._spring(knob, { Size = UDim2.new(0, 12, 0, 12) }, "snappy")
			end)
		end
	end)

	valBox.Focused:Connect(function() uiSnd("focus")
		tween(valBox, { BackgroundTransparency = 0.5, TextColor3 = T.Text }, 0.2)
	end)
	valBox.FocusLost:Connect(function()
		tween(valBox, { BackgroundTransparency = 1, TextColor3 = T.ElementAccent }, 0.25)
		-- virgule acceptée, ".5" / "-.5" acceptés, saisie exacte (pas d'accroche sur le pas)
		local txt = string.gsub(valBox.Text, ",", ".")
		local n = tonumber(string.match(txt, "-?%d*%.?%d+"))
		if n then apply(n, false, false, true) end
		valBox.Text = fmt(value)
		shownV = value
	end)

	apply(def, true, true, true)
	register(o.Flag, item, value)
	if Library.FireDefaults then fire(o.Callback, value) end
	return item
end

-- Slider à deux poignées (plage min / max). Options : Name, Min, Max, Step, MinGap (écart minimal), Suffix, Rounding,
-- Default = { Low = a, High = b } (ou DefaultLow / DefaultHigh), Flag, Callback = function(low, high).
-- item.Get() = { Low, High } · item.Set({ Low, High }) ou item.Set(low, high) · GetLow / GetHigh / SetLow / SetHigh
function Block:CreateRangeSlider(o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local step = o.Step or o.Increment
	local gap = math.max(tonumber(o.MinGap) or 0, 0)
	local d = o.Default
	local dl, dh = o.DefaultLow, o.DefaultHigh
	if type(d) == "table" then dl, dh = dl or d.Low or d[1], dh or d.High or d[2] end
	dl, dh = tonumber(dl) or min, tonumber(dh) or max
	local dec = o.Rounding
	if dec == nil then
		local frac = (min % 1 ~= 0) or (max % 1 ~= 0) or (dl % 1 ~= 0) or (dh % 1 ~= 0) or (step and step % 1 ~= 0)
		dec = frac and 2 or 0
	end
	local mult = 10 ^ dec
	local suffix = o.Suffix and tostring(o.Suffix) or ""

	local function snap(v)
		v = math.clamp(v, min, max)
		if step and step > 0 then v = min + math.floor((v - min) / step + 0.5) * step end
		v = math.floor(v * mult + 0.5) / mult
		return math.clamp(v, min, max)
	end
	local function fmt(v) return tostring(v) .. suffix end

	local f, st = makeRow(self, 56, o.Name)
	label(f, o.Name or "Plage", 13, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -176, 0, 18) })
	local function mkBox(x)
		local b = new("TextBox", {
			Position = UDim2.new(1, x, 0, 6), Size = UDim2.new(0, 62, 0, 18), BackgroundColor3 = T.Off,
			BackgroundTransparency = 1, Text = "", TextColor3 = T.ElementAccent, TextSize = 12, Font = F_MED,
			TextXAlignment = CENTER, ClearTextOnFocus = false, BorderSizePixel = 0,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, f)
		corner(b, 5)
		return b
	end
	local lowBox = mkBox(-150)
	label(f, "–", 12, { Position = UDim2.new(1, -86, 0, 6), Size = UDim2.new(0, 10, 0, 18), TextXAlignment = CENTER,
		TextColor3 = T.ElementAccent })
	local highBox = mkBox(-74)

	local bar = new("Frame", { Position = UDim2.new(0, 12, 0, 38), Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = T.Off, BorderSizePixel = 0 }, f)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, bar)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
	local function mkKnob()
		local k = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 12, 0, 12), BackgroundColor3 = T.Accent, BorderSizePixel = 0, ZIndex = 3 }, bar)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, k)
		stroke(k, 0.6, 2)
		return k
	end
	local kLow, kHigh = mkKnob(), mkKnob()
	local hit = new("TextButton", { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1, Text = "" }, f)
	hover(f, st)

	local low, high = min, max
	local function ratioOf(v)
		local span = max - min
		return span == 0 and 0 or math.clamp((v - min) / span, 0, 1)
	end
	local function paint(instant)
		local rl, rh = ratioOf(low), ratioOf(high)
		if instant then
			Library._springStop(fill)
			Library._springStop(kLow, "Position")
			Library._springStop(kHigh, "Position")
			fill.Position, fill.Size = UDim2.new(rl, 0, 0, 0), UDim2.new(rh - rl, 0, 1, 0)
			kLow.Position, kHigh.Position = UDim2.new(rl, 0, 0.5, 0), UDim2.new(rh, 0, 0.5, 0)
		else
			Library._spring(fill, { Position = UDim2.new(rl, 0, 0, 0), Size = UDim2.new(rh - rl, 0, 1, 0) }, "smooth")
			Library._spring(kLow, { Position = UDim2.new(rl, 0, 0.5, 0) }, "smooth")
			Library._spring(kHigh, { Position = UDim2.new(rh, 0, 0.5, 0) }, "smooth")
		end
		if not lowBox:IsFocused() then lowBox.Text = fmt(low) end
		if not highBox:IsFocused() then highBox.Text = fmt(high) end
	end
	local function commit(l, h, silent, instant)
		l, h = snap(l), snap(h)
		if h < l then l, h = h, l end
		if h - l < gap then
			h = math.min(max, l + gap)
			if h - l < gap then l = math.max(min, h - gap) end
		end
		if l == low and h == high and not silent then return end
		low, high = l, h
		paint(instant)
		if o.Flag then Library.Flags[o.Flag] = { Low = low, High = high } end
		if not silent then fire(o.Callback, low, high) end
	end
	local function setLow(v, instant) commit(math.min(snap(v), high - gap), high, false, instant) end
	local function setHigh(v, instant) commit(low, math.max(snap(v), low + gap), false, instant) end

	local item = {}
	item.Set = function(...)
		local a, b = unself(item, ...)
		local l, h
		if type(a) == "table" then l, h = tonumber(a.Low or a[1]), tonumber(a.High or a[2])
		else l, h = tonumber(a), tonumber(b) end
		if l or h then commit(l or low, h or high) end
	end
	item.Get = function() return { Low = low, High = high } end
	item.GetLow = function() return low end
	item.GetHigh = function() return high end
	item.SetLow = function(...)
		local v = tonumber((unself(item, ...)))
		if v then setLow(v) end
	end
	item.SetHigh = function(...)
		local v = tonumber((unself(item, ...)))
		if v then setHigh(v) end
	end

	hit.InputBegan:Connect(function(i)
		if not isPress(i) then return end
		local function valueAt(p)
			return min + math.clamp((p.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1) * (max - min)
		end
		local v0 = valueAt(i.Position)
		local dL, dH = math.abs(v0 - low), math.abs(v0 - high)
		local which
		if dL < dH then which = "low" elseif dH < dL then which = "high" else which = (v0 >= high) and "high" or "low" end
		local function setActive(w)
			which = w
			Library._spring(kLow, { Size = UDim2.new(0, w == "low" and 17 or 12, 0, w == "low" and 17 or 12) }, "bouncy")
			Library._spring(kHigh, { Size = UDim2.new(0, w == "high" and 17 or 12, 0, w == "high" and 17 or 12) }, "bouncy")
		end
		setActive(which)
		startDrag(function(p)
			local v = valueAt(p)
			-- les poignées peuvent se croiser : on bascule sur l'autre quand on dépasse
			if which == "high" and v < low then setActive("low") end
			if which == "low" and v > high then setActive("high") end
			if which == "low" then setLow(v, true) else setHigh(v, true) end
		end, self.Scroll, i.Position, function()
			Library._spring(kLow, { Size = UDim2.new(0, 12, 0, 12) }, "snappy")
			Library._spring(kHigh, { Size = UDim2.new(0, 12, 0, 12) }, "snappy")
		end)
	end)

	local function boxEvents(box, setter)
		box.Focused:Connect(function()
			tween(box, { BackgroundTransparency = 0.5, TextColor3 = T.Text }, 0.2)
		end)
		box.FocusLost:Connect(function()
			tween(box, { BackgroundTransparency = 1, TextColor3 = T.ElementAccent }, 0.25)
			local n = tonumber(string.match(box.Text, "-?%d+%.?%d*"))
			if n then setter(n) end
			paint(true)
		end)
	end
	boxEvents(lowBox, function(n) setLow(n) end)
	boxEvents(highBox, function(n) setHigh(n) end)

	commit(dl, dh, true, true)
	register(o.Flag, item, { Low = low, High = high })
	if Library.FireDefaults then fire(o.Callback, low, high) end
	return item
end

-- ============================================================================
-- KEYBINDS DANS LES LISTES DÉROULANTES  (Paramètres > Fenêtre > « Keybinds dans les listes »)
--   Option activée : clic droit sur une entrée d'une liste -> petit menu en fondu pour lui assigner une touche.
--   Appuyer ensuite sur cette touche choisit l'entrée (liste à choix multiples : la coche / décoche), même fenêtre fermée.
--   Les touches sont retenues dans la config : « <Flag>.keys » (ou « ddkeys/onglet/bloc/nom » si la liste n'a pas de Flag).
--   Block:CreateDropdown({ ..., Keys = false }) exclut une liste.
--   Library:SetDropdownKeys(bool) · Library:ClearDropdownKeys() -> nombre de touches retirées
--   (bloc isolé dans un do ... end : la librairie est proche de la limite de 200 variables locales)
-- ============================================================================
do
	local ddPop          -- menu partagé : créé au premier clic droit

	local function keyOf(name)
		if type(name) ~= "string" then return nil end
		local ok, k = pcall(function() return Enum.KeyCode[name] end)
		if ok and typeof(k) == "EnumItem" and k ~= Enum.KeyCode.Unknown then return k end
		return nil
	end
	Library._ddKeyOf = keyOf

	-- prévient si la touche est déjà prise par une autre entrée de liste ou par un keybind / toggle
	local function conflict(entry, text, kn)
		if Library.KeybindConflictWarn == false then return end
		local who
		for _, e in ipairs(Library.DDKeyEntries) do
			if e.Frame and e.Frame.Parent then
				for t, k in pairs(e.Keys) do
					if k == kn and not (e == entry and t == text) then who = t break end
				end
			end
			if who then break end
		end
		if not who then
			for _, e in ipairs(Library.KeybindEntries) do
				local ok, cur = pcall(function() return e.Item.Get() end)
				if ok and typeof(cur) == "EnumItem" and cur.Name == kn and e.Frame and e.Frame.Parent then
					who = e.Name
					break
				end
			end
		end
		if who then
			Library:Notify({ Title = "Touche déjà utilisée", Content = kn .. " sert déjà à « " .. tostring(who) .. " »",
				Type = "Warning", Duration = 3 })
		end
	end

	local CARD_W, CARD_H = 200, 86

	-- change un texte avec un petit fondu (évite le « clignotement » sec)
	local function swapText(lbl, txt, instant)
		if lbl.Text == txt then return end
		lbl.Text = txt
		if instant then lbl.TextTransparency = 0 return end
		lbl.TextTransparency = 0.7
		tween(lbl, { TextTransparency = 0 }, 0.18)
	end

	local function close(entry)
		local p = ddPop
		if not (p and p.Open) then return end
		if entry and p.Entry ~= entry then return end
		p.Open = false
		p.Tok += 1
		local my = p.Tok
		if p.Listening then p.StopListen() end
		tween(p.Card, { GroupTransparency = 1, Position = UDim2.fromOffset(p.X or 0, (p.Y or 0) + 4) }, 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(p.Scale, { Scale = 0.97 }, 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.18 / math.max(Library.AnimSpeed or 1, 0.05), function()
			if ddPop == p and p.Tok == my and not p.Open then p.Card.Visible = false end
		end)
	end
	Library._ddKeyClose = close
	-- vrai si le point (écran) est dans la fenêtre de keybind ouverte (pour ne pas fermer un dropdown en cliquant dedans)
	Library._ddPopHit = function(m)
		local p = ddPop
		if not (p and p.Open and p.Card and p.Card.Visible) then return false end
		local ap, as = p.Card.AbsolutePosition, p.Card.AbsoluteSize
		return m.X >= ap.X and m.Y >= ap.Y and m.X <= ap.X + as.X and m.Y <= ap.Y + as.Y
	end

	local function build()
		if ddPop and ddPop.Card and ddPop.Card.Parent then return ddPop end
		local gui = Library.Window and Library.Window.Gui
		if not gui then return nil end
		local p = { Tok = 0, Open = false, Listening = false, PulseTok = 0 }
		local card = new("CanvasGroup", { Name = "DropdownKeyMenu", Size = UDim2.fromOffset(CARD_W, CARD_H),
			BackgroundColor3 = T.Second, BackgroundTransparency = 0.04, BorderSizePixel = 0, Visible = false,
			ZIndex = 600, GroupTransparency = 1 }, gui)
		corner(card, 10)
		stroke(card, 0.8)
		local sc = new("UIScale", { Scale = 0.96 }, card)

		-- en-tête : nom de l'entrée + croix « retirer la touche » (elle apparaît en fondu seulement s'il y a une touche)
		local title = label(card, "", 11, { Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -44, 0, 16),
			TextColor3 = T.ElementAccent })
		local clr = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 7),
			Size = UDim2.fromOffset(20, 18), BackgroundTransparency = 1, BorderSizePixel = 0, Text = "",
			TextColor3 = T.ElementAccent, TextSize = 11, Font = F_BOLD, AutoButtonColor = false,
			Active = false }, card)
		-- croix dessinée avec deux barres (le caractère « ✕ » s'affiche en carré avec certaines polices)
		local clrBars = {}
		for _, rot in ipairs({ 45, -45 }) do
			clrBars[#clrBars + 1] = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(10, 2), Rotation = rot, BackgroundColor3 = T.ElementAccent,
				BackgroundTransparency = 1, BorderSizePixel = 0 }, clr)
		end
		local function clrPaint(tr, col, t)
			for _, b in ipairs(clrBars) do
				local pr = { BackgroundTransparency = tr }
				if col then pr.BackgroundColor3 = col end
				tween(b, pr, t)
			end
		end

		-- « keycap » : affiche la touche (ou invite à en choisir une) ; un clic lance l'écoute
		local chip = new("TextButton", { Position = UDim2.fromOffset(10, 30), Size = UDim2.new(1, -20, 0, 30),
			BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0, Text = "",
			TextColor3 = T.Text, TextSize = 13, Font = F_BOLD, AutoButtonColor = false }, card)
		corner(chip, 8)
		local cst = stroke(chip, 0.88)
		local hint = label(card, "", 10, { Position = UDim2.fromOffset(12, 66), Size = UDim2.new(1, -24, 0, 14),
			TextColor3 = T.ElementAccent, Font = F_REG, TextTransparency = 0.25 })

		local function paint(instant)
			local e, text = p.Entry, p.Text
			if not e then return end
			local k = keyOf(e.Keys[text])
			swapText(title, tostring(text), instant)
			if p.Listening then
				swapText(chip, "Appuie sur une touche…", instant)
				chip.TextColor3 = T.ElementAccent
				chip.TextSize = 12
				swapText(hint, "Échap : annuler  ·  Retour : retirer", instant)
			elseif k then
				swapText(chip, shortKey(k) or k.Name, instant)
				chip.TextColor3 = T.Accent
				chip.TextSize = 14
				swapText(hint, "Clique pour changer", instant)
			else
				swapText(chip, "Aucune touche", instant)
				chip.TextColor3 = T.ElementAccent
				chip.TextSize = 12
				swapText(hint, "Clique pour assigner", instant)
			end
			local showClr = (k ~= nil) and not p.Listening
			clr.Active = showClr
			clrPaint(showClr and 0.2 or 1, nil, 0.18)
		end

		chip.MouseEnter:Connect(function() if not p.Listening then tween(cst, { Transparency = 0.55 }, 0.15) end end)
		chip.MouseLeave:Connect(function() if not p.Listening then tween(cst, { Transparency = 0.88 }, 0.2) end end)
		clr.MouseEnter:Connect(function() if clr.Active then clrPaint(0, T.Accent, 0.12) end end)
		clr.MouseLeave:Connect(function() clrPaint(clr.Active and 0.2 or 1, T.ElementAccent, 0.15) end)

		local conn
		function p.StopListen()
			if conn then conn:Disconnect() conn = nil end
			p.PulseTok += 1
			if p.Listening then
				p.Listening = false
				Library._listening = false
			end
			tween(cst, { Transparency = 0.88 }, 0.2)
			tween(chip, { BackgroundTransparency = 0.4 }, 0.2)
		end

		-- pulsation douce de la bordure pendant l'écoute
		local function pulse()
			p.PulseTok += 1
			local my = p.PulseTok
			task.spawn(function()
				local low = true
				while p.Listening and p.PulseTok == my do
					tween(cst, { Transparency = low and 0.15 or 0.55 }, 0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
					low = not low
					task.wait(0.5 / math.max(Library.AnimSpeed or 1, 0.05))
				end
			end)
		end

		chip.MouseButton1Click:Connect(function()
			if p.Listening or Library._listening or not p.Entry then return end
			p.Listening = true
			Library._listening = true
			uiSnd("focus")
			tween(chip, { BackgroundTransparency = 0.2 }, 0.15)
			paint()
			pulse()
			conn = track(UIS.InputBegan:Connect(function(i)
				if i.UserInputType ~= Enum.UserInputType.Keyboard or i.KeyCode == Enum.KeyCode.Unknown then return end
				local kc, e, text = i.KeyCode, p.Entry, p.Text
				p.StopListen()
				Library._ddLastBind = os.clock()
				if kc == Enum.KeyCode.Escape then
					-- annulé : rien ne change
				elseif kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete then
					e.SetKey(text, nil)
				else
					e.SetKey(text, kc)
					conflict(e, text, kc.Name)
					uiSnd("on")
				end
				paint()
			end))
		end)

		clr.MouseButton1Click:Connect(function()
			if not p.Entry or not clr.Active then return end
			p.Entry.SetKey(p.Text, nil)
			uiSnd("off")
			paint()
		end)

		p.Card, p.Scale, p.Paint = card, sc, paint
		ddPop = p
		return p
	end

	-- ouvre le menu près de la souris : fondu + léger glissement vers le haut + zoom doux (taille fixe, plus de saut de hauteur)
	Library._ddOpen = function(entry, text)
		local p = build()
		if not p then return end
		if Library._listening and not p.Listening then return end   -- une touche est déjà en cours d'assignation ailleurs
		if p.Listening then p.StopListen() end
		local card = p.Card
		local fresh = (not card.Visible) or card.GroupTransparency > 0.85
		p.Entry, p.Text = entry, text
		p.Tok += 1
		p.Open = true
		p.OpenedAt = os.clock()
		p.Paint(true)
		local m, v = UIS:GetMouseLocation(), viewport()
		local x = math.clamp(m.X + 8, 4, math.max(4, v.X - CARD_W - 4))
		local y = m.Y + 8
		if y + CARD_H > v.Y - 4 then y = math.max(4, m.Y - CARD_H - 8) end
		p.X, p.Y = x, y
		if fresh then
			card.Position = UDim2.fromOffset(x, y + 6)
			p.Scale.Scale = 0.96
			card.GroupTransparency = 1
			card.Visible = true
		end
		tween(card, { Position = UDim2.fromOffset(x, y), GroupTransparency = 0 }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		tween(p.Scale, { Scale = 1 }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end

	Library._ddConflict = conflict
	Library._ddDestroy = function() ddPop = nil end

	-- un seul écouteur pour tout : fermeture du menu (clic dehors / Échap) + touches liées aux entrées
	track(UIS.InputBegan:Connect(function(i, gp)
		local p = ddPop
		if p and p.Open then
			local ut = i.UserInputType
			if ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.MouseButton2
				or ut == Enum.UserInputType.MouseButton3 or ut == Enum.UserInputType.Touch then
				if os.clock() - (p.OpenedAt or 0) > 0.2 then
					local m = (ut == Enum.UserInputType.Touch) and Vector2.new(i.Position.X, i.Position.Y + guiInset().Y)
						or UIS:GetMouseLocation()
					local ap, as = p.Card.AbsolutePosition, p.Card.AbsoluteSize
					if m.X < ap.X or m.Y < ap.Y or m.X > ap.X + as.X or m.Y > ap.Y + as.Y then close() end
				end
			elseif ut == Enum.UserInputType.Keyboard and i.KeyCode == Enum.KeyCode.Escape and not p.Listening then
				close()
			end
		end
		if gp or not Library.DropdownKeys or Library._listening then return end
		if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if os.clock() - (Library._ddLastBind or 0) < 0.25 then return end
		if UIS:GetFocusedTextBox() then return end
		local kn = i.KeyCode.Name
		local list = Library.DDKeyEntries
		for idx = #list, 1, -1 do
			local e = list[idx]
			if not (e.Frame and e.Frame.Parent) then
				table.remove(list, idx)
			else
				for text, key in pairs(e.Keys) do
					if key == kn then task.spawn(e.Trigger, text) end
				end
			end
		end
	end))

	function Library:SetDropdownKeys(v)
		Library.DropdownKeys = v and true or false
		if not Library.DropdownKeys then close() end
		for _, e in ipairs(Library.DDKeyEntries) do
			if e.Refresh then pcall(e.Refresh) end
		end
	end

	-- retire toutes les touches des listes ; renvoie le nombre de touches retirées
	function Library:ClearDropdownKeys()
		close()
		local n = 0
		for _, e in ipairs(Library.DDKeyEntries) do
			if e.Frame and e.Frame.Parent then
				for _ in pairs(e.Keys) do n += 1 end
				if e.Clear then pcall(e.Clear) end
			end
		end
		return n
	end
end

-- ============================================================================
-- TIROIR ANIMÉ (liste déroulante, color picker) : dr.Wrap = cadre rogné qui s'ouvre / se ferme en glissant,
-- dr:Set(bool), dr:Resize(hauteur), dr.Open, dr.Height. Stocké dans Library (pas de variable locale en plus).
-- ============================================================================
Library._drawer = function(holder, order, gap)
	gap = gap or 0   -- écart au-dessus du contenu, animé AVEC le tiroir (sinon il disparaît d'un coup à la fin de la fermeture)
	local d = { Open = false, Height = 0 }
	local wrap = new("Frame", { Name = "Drawer", Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, ClipsDescendants = true, LayoutOrder = order or 2, Visible = false }, holder)
	d.Wrap = wrap
	local gen = 0
	function d:Resize(h)
		d.Height = h
		if d.Open then tween(wrap, { Size = UDim2.new(1, 0, 0, h + gap) }, 0.28, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out) end
	end
	function d:Set(v)
		v = v and true or false
		if v == d.Open then return end
		d.Open = v
		gen += 1
		local my = gen
		if v then
			wrap.Visible = true
			tween(wrap, { Size = UDim2.new(1, 0, 0, d.Height + gap) }, 0.34, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
		else
			-- InOut : plus de ralentissement final suivi d'une disparition brusque
			local tw = tween(wrap, { Size = UDim2.new(1, 0, 0, 0) }, 0.3, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut)
			tw.Completed:Connect(function()
				if gen == my and not d.Open then wrap.Visible = false end
			end)
		end
	end
	return d
end

function Block:CreateDropdown(o)
	o = o or {}
	local multi = (o.Multi == true) or (o.MultiSelect == true) or (o.MultipleOptions == true)
	local items = {}
	do
		local seen = {}
		for _, v in ipairs(o.Items or o.Options or {}) do
			local t = tostring(v)
			if not seen[t] then seen[t] = true items[#items + 1] = t end
		end
	end

	local selected, selSet = nil, {}
	do
		local d = o.Default
		if (d == nil or d == "") and o.CurrentOption and o.CurrentOption ~= "" then d = o.CurrentOption end
		if multi then
			if type(d) == "table" then
				for _, v in ipairs(d) do selSet[tostring(v)] = true end
			elseif d ~= nil and d ~= "" then
				selSet[tostring(d)] = true
			end
		else
			if type(d) == "table" then d = d[1] end
			if d ~= nil and d ~= "" then selected = tostring(d) end
		end
	end

	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundTransparency = 1 }, self.Body)
	new("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = BYORDER }, holder)
	self:_reg(holder, o.Name)

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 0.4,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = 1,
	}, holder)
	corner(head, 8)
	local hst = stroke(head, 0.93)
	trackStyled(head, hst, "row")
	hover(head, hst)
	local nameL = label(head, o.Name or "Dropdown", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.5, -12, 1, 0) })
	local valL = label(head, "", 12, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -34, 0, 0), Size = UDim2.new(0.5, -34, 1, 0),
		TextXAlignment = RIGHT, TextColor3 = T.ElementAccent, TextTruncate = Enum.TextTruncate.AtEnd })
	local arrow = label(head, ">", 13, { Position = UDim2.new(1, -26, 0, 0), Size = UDim2.new(0, 16, 1, 0),
		TextXAlignment = CENTER, Font = F_BOLD, TextColor3 = T.ElementAccent })
	-- largeur partagée selon le texte : la valeur choisie passe en priorité, le nom est raccourci (…) seulement si besoin.
	-- Valeur très longue (27 caractères ou plus) : elle devient une boîte de texte sous le nom (retour à la ligne).
	local headH, lastKey, firstLay = 34, nil, true
	local boxPad = new("UIPadding", {}, valL)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, valL)
	arrow.Size = UDim2.new(0, 16, 0, 34)
	valL.AnchorPoint = Vector2.new(0, 0)   -- ancre fixe : la position peut ainsi être animée d'un mode à l'autre
	-- transition fluide entre « valeur à droite » et « boîte sous le nom » (direct au tout premier calcul)
	local function go(obj, props)
		if firstLay then
			for k, v in pairs(props) do obj[k] = v end
		else
			tween(obj, props, 0.32)
		end
	end
	local function layoutHead()
		local W = head.AbsoluteSize.X / math.max(pxScale(), 0.05)
		if W <= 0 then return end
		local txt = valL.Text
		local key = txt .. "|" .. math.floor(W) .. "|" .. nameL.Text
		if key == lastKey then return end
		lastKey = key
		if isLongText(txt) then
			local bh = math.ceil(measureText(txt, valL.TextSize, valL.Font, math.max(W - 24 - 16, 40)).Y) + 12
			nameL.TextXAlignment = CENTER   -- nom centré au-dessus de la boîte (marges égales : la flèche reste à droite)
			valL.TextWrapped = true
			valL.TextTruncate = Enum.TextTruncate.None
			valL.TextXAlignment = LEFT
			valL.TextYAlignment = Enum.TextYAlignment.Top
			valL.BackgroundColor3 = T.Off
			go(nameL, { Position = UDim2.new(0, 34, 0, 0), Size = UDim2.new(1, -68, 0, 34) })
			go(valL, { Position = UDim2.new(0, 12, 0, 32), Size = UDim2.new(1, -24, 0, bh), BackgroundTransparency = 0.5 })
			go(boxPad, { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) })
			headH = 34 + bh + 8
		else
			nameL.TextXAlignment = LEFT
			valL.TextWrapped = false
			valL.TextTruncate = Enum.TextTruncate.AtEnd
			valL.TextXAlignment = RIGHT
			valL.TextYAlignment = Enum.TextYAlignment.Center
			local avail = W - 12 - 34 - 8
			local nameNeed = measureText(nameL.Text, nameL.TextSize, nameL.Font).X + 2
			local valNeed = measureText(txt, valL.TextSize, valL.Font).X + 2
			local valW
			if nameNeed + valNeed <= avail then
				valW = valNeed
			else
				valW = math.min(valNeed, math.max(avail * 0.5, avail - nameNeed))
			end
			valW = math.max(valW, 20)
			go(nameL, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0, math.max(avail - valW, 20), 1, 0) })
			go(valL, { Position = UDim2.new(1, -34 - valW, 0, 0), Size = UDim2.new(0, valW, 1, 0), BackgroundTransparency = 1 })
			go(boxPad, { PaddingLeft = UDim.new(0, 0), PaddingRight = UDim.new(0, 0), PaddingTop = UDim.new(0, 0), PaddingBottom = UDim.new(0, 0) })
			headH = 34
		end
		go(head, { Size = UDim2.new(1, 0, 0, headH) })
		firstLay = false
	end
	head:GetPropertyChangedSignal("AbsoluteSize"):Connect(Library._lazy(layoutHead))
	nameL:GetPropertyChangedSignal("Text"):Connect(layoutHead)
	valL:GetPropertyChangedSignal("Text"):Connect(layoutHead)
	task.defer(layoutHead)

	local dr = Library._drawer(holder, 2, 4)
	local panel = new("Frame", {
		Position = UDim2.new(0, 0, 0, 4), Size = UDim2.new(1, 0, 0, 100), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, BorderSizePixel = 0,
	}, dr.Wrap)
	corner(panel, 8)
	trackStyled(panel, stroke(panel, 0.9), "panel")
	local search = new("TextBox", {
		Position = UDim2.new(0, 6, 0, 6), Size = UDim2.new(1, -12, 0, 24), BackgroundColor3 = T.Off,
		BackgroundTransparency = 0.45, Text = "", PlaceholderText = "Rechercher...",
		PlaceholderColor3 = Color3.fromRGB(120, 120, 126), TextColor3 = T.Text, TextSize = 12, Font = F_REG,
		ClearTextOnFocus = false, TextXAlignment = CENTER, Visible = false, BorderSizePixel = 0,
	}, panel)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, search)   -- pilule : totalement arrondie
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, search)
	Library._attachTextFade(search)
	local list = new("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0, 100), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent, ScrollBarImageTransparency = 0.5,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = AY,
	}, panel)
	new("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = BYORDER }, list)
	new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, list)

	local btns = {}
	local pressedPick = false  -- 🛠️ FIX : la souris choisit dès l'APPUI ; le « Click » (relâchement) ne doit alors pas rechoisir
	local firstLayout = true   -- vrai tant que la liste vient d'être (re)construite : pas d'animation
	local restyle, layout, setOpen, setItems

	local function getMulti()
		local out = {}
		for _, v in ipairs(items) do
			if selSet[v] then out[#out + 1] = v end
		end
		return out
	end
	local function valueText()
		if multi then
			local m = getMulti()
			if #m == 0 then return "Choisir..." end
			if #m <= 2 then return table.concat(m, ", ") end
			return #m .. " sélectionnés"
		end
		return selected or "Choisir..."
	end
	local function show() valL.Text = valueText() end
	local function isOn(text)
		if multi then return selSet[text] == true end
		return selected == text
	end
	local function commit(silent)
		local val
		if multi then val = getMulti() else val = selected end
		if o.Flag then Library.Flags[o.Flag] = val end
		show()
		restyle()
		if not silent then fire(o.Callback, val) end
	end
	local function pick(text)
		if multi then
			if selSet[text] then selSet[text] = nil else selSet[text] = true end
			commit()
		else
			selected = text
			commit()
			setOpen(false)
		end
	end

	-- ---- touches par entrée (clic droit) : voir « KEYBINDS DANS LES LISTES DÉROULANTES » plus haut
	local keys = {}   -- [texte de l'entrée] = nom de la touche
	local keysOk = (o.Keys ~= false) and not self._noFav and not (self.Tab and self.Tab._isSettings)
	local keyFlag
	if keysOk then
		keyFlag = o.Flag and (o.Flag .. ".keys")
			or ("ddkeys/" .. tostring(self.Tab and self.Tab.Name or "") .. "/" .. tostring(self.Name or "") .. "/" .. tostring(o.Name or ""))
	end
	local ddEntry
	local function refreshTags()
		for text, b in pairs(btns) do
			local k = Library.DropdownKeys and Library._ddKeyOf(keys[text]) or nil
			local txt = k and (shortKey(k) or k.Name) or nil
			if txt then
				local was = b.Tag.Visible
				b.Tag.Text = txt
				b.Pad.PaddingRight = UDim.new(0, 26 + math.max(18, #txt * 6.5 + 10) + 6)
				b.Tag.Visible = true
				if not was then
					b.Tag.TextTransparency, b.Tag.BackgroundTransparency = 1, 1
					tween(b.Tag, { TextTransparency = 0, BackgroundTransparency = 0.35 }, 0.2)
				end
			else
				b.Tag.Visible = false
				b.Pad.PaddingRight = UDim.new(0, 26)
			end
		end
	end
	local function keysChanged()
		if keyFlag then
			local c = {}
			for t2, k2 in pairs(keys) do c[t2] = k2 end
			Library.Flags[keyFlag] = c
		end
		refreshTags()
	end
	if keysOk then
		ddEntry = {
			Frame = holder, Keys = keys, Name = o.Name,
			Trigger = function(text)
				if not table.find(items, text) then return end
				uiSnd("pick")
				pick(text)
			end,
			Refresh = refreshTags,
			SetKey = function(text, kc)
				if kc then keys[text] = kc.Name else keys[text] = nil end
				keysChanged()
			end,
			Clear = function() table.clear(keys) keysChanged() end,
		}
	end

	restyle = function()
		for text, b in pairs(btns) do
			local on = isOn(text)
			if b.On ~= on then
				b.On = on
				tween(b.Btn, { BackgroundTransparency = on and 0.86 or 1, TextColor3 = on and T.Accent or T.ElementAccent }, 0.18)
				tween(b.Ind, { BackgroundTransparency = on and 0 or 1 }, 0.18)
			end
		end
	end

	layout = function()
		local q = string.lower(search.Text)
		local count = 0
		for idx, text in ipairs(items) do
			local b = btns[text]
			if b then
				local vis = q == "" or string.find(string.lower(text), q, 1, true) ~= nil
				if vis then count = count + 1 end
				-- apparition / disparition fluide : la ligne grandit en se révélant, ou se replie en s'effaçant
				if b.Shown ~= vis then
					b.Shown = vis
					b.Tok = (b.Tok or 0) + 1
					local my, btn, row = b.Tok, b.Btn, b.Row
					if vis then
						row.Visible = true
						if firstLayout then
							row.Size = UDim2.new(1, 0, 0, 26)
							btn.TextTransparency = 0
						else
							row.Size = UDim2.new(1, 0, 0, 0)
							btn.TextTransparency = 1
							tween(row, { Size = UDim2.new(1, 0, 0, 26) }, 0.28)
							tween(btn, { TextTransparency = 0 }, 0.22)
						end
					else
						-- même durée que la hauteur de la liste : pas de vide qui reste puis disparaît
						tween(btn, { TextTransparency = 1 }, 0.18)
						local tw = tween(row, { Size = UDim2.new(1, 0, 0, 0) }, 0.28)
						tw.Completed:Connect(function()
							if b.Tok == my and not b.Shown then row.Visible = false end
						end)
					end
				end
			end
		end
		firstLayout = false
		local showSearch = (o.Search == true) or (o.Search ~= false and #items >= 7)
		search.Visible = showSearch
		local sh = showSearch and 36 or 0
		local lh = math.clamp(math.max(count, 1) * 26 + 8, 34, 150)
		list.Position = UDim2.new(0, 0, 0, sh)
		tween(list, { Size = UDim2.new(1, 0, 0, lh) }, 0.28)
		tween(panel, { Size = UDim2.new(1, 0, 0, sh + lh) }, 0.28)
		dr:Resize(sh + lh)
	end

	local function rebuild()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		table.clear(btns)
		firstLayout = true
		if #items == 0 then
			label(list, "(vide)", 12, { Size = UDim2.new(1, 0, 0, 24), TextColor3 = T.ElementAccent, TextXAlignment = CENTER })
		end
		for idx, text in ipairs(items) do
			local row = new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
				BorderSizePixel = 0, LayoutOrder = idx, ClipsDescendants = true }, list)
			local b = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
				Text = text, TextColor3 = T.ElementAccent, TextSize = 12, Font = F_REG,
				TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false, BorderSizePixel = 0, ClipsDescendants = true,
			}, row)
			local pad = new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 26) }, b)
			new("UICorner", { CornerRadius = UDim.new(0, 5) }, b)
			local ind
			if multi then
				ind = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 18, 0.5, 0),
					Size = UDim2.new(0, 12, 0, 12), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
					BorderSizePixel = 0 }, b)
				new("UICorner", { CornerRadius = UDim.new(0, 3) }, ind)
				stroke(ind, 0.45)
			else
				ind = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 20, 0.5, 0),
					Size = UDim2.new(0, 6, 0, 6), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
					BorderSizePixel = 0 }, b)
				new("UICorner", { CornerRadius = UDim.new(1, 0) }, ind)
			end
			local tag = new("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.Off,
				BackgroundTransparency = 0.35, Text = "", TextColor3 = T.Accent, TextSize = 10, Font = F_MED,
				Visible = false, BorderSizePixel = 0 }, b)
			new("UICorner", { CornerRadius = UDim.new(0, 4) }, tag)
			new("UIPadding", { PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5) }, tag)
			btns[text] = { Btn = b, Row = row, Ind = ind, Shown = true, Tag = tag, Pad = pad }
			b.MouseEnter:Connect(function()
				if not isOn(text) then tween(b, { BackgroundTransparency = 0.93 }, 0.15) end
			end)
			b.MouseLeave:Connect(function()
				if not isOn(text) then tween(b, { BackgroundTransparency = 1 }, 0.2) end
			end)
			-- 🛠️ FIX dropdown : avant, le choix n'était pris qu'au relâchement (MouseButton1Click). Si la liste bougeait / se
			-- refermait entre l'appui et le relâchement (animation, clic jugé « hors liste »), le choix était perdu et il fallait
			-- recliquer. Maintenant : souris = choix immédiat à l'appui ; tactile / manette = Click comme avant.
			b.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 then
					pressedPick = true
					uiSnd("pick")
					pick(text)
				end
			end)
			b.MouseButton1Click:Connect(function()
				if pressedPick then pressedPick = false return end
				uiSnd("pick")
				pick(text)
			end)
			b.MouseButton2Click:Connect(function()
				if ddEntry and Library.DropdownKeys then Library._ddOpen(ddEntry, text) end
			end)
		end
		restyle()
		layout()
		refreshTags()
	end

	setItems = function(newItems, clear)
		local nl = {}
		do
			local seen = {}
			for _, v in ipairs(newItems or {}) do
				local t = tostring(v)
				if not seen[t] then seen[t] = true nl[#nl + 1] = t end
			end
		end
		-- 🛠️ FIX : liste identique (ex. un script qui rafraîchit les joueurs toutes les 3 s) -> on NE reconstruit PAS.
		-- Avant, chaque Refresh détruisait puis recréait tous les boutons : un clic (ou la recherche en cours) pouvait tomber
		-- pile pendant la reconstruction, d'où des éléments impossibles à choisir « parfois, sur certaines listes ».
		if clear ~= true and #nl == #items then
			local same = true
			for i2, t2 in ipairs(nl) do
				if items[i2] ~= t2 then same = false break end
			end
			if same then return end
		end
		items = nl
		if clear == true then
			selSet = {}
			selected = nil
		else
			if selected and not table.find(items, selected) then selected = nil end
			for k in pairs(selSet) do
				if not table.find(items, k) then selSet[k] = nil end
			end
		end
		if o.Flag then
			if multi then Library.Flags[o.Flag] = getMulti() else Library.Flags[o.Flag] = selected end
		end
		show()
		rebuild()
	end

	local isOpen = false
	local outsideConn, keyConn
	local CAS = game:GetService("ContextActionService")
	Library._ddNavId = (Library._ddNavId or 0) + 1
	local NAV_ACT = "UiLibDDNav" .. Library._ddNavId
	local hiText, typeBuf, typeAt = nil, "", 0

	local function visibleItems()
		local out = {}
		for _, t in ipairs(items) do
			local b = btns[t]
			if b and b.Shown then out[#out + 1] = t end
		end
		return out
	end

	-- surligne la ligne visée au clavier et la fait défiler dans la vue
	local function setHi(text)
		hiText = text
		for t, b in pairs(btns) do
			local hi = (t == text)
			if b.Hi ~= hi then
				b.Hi = hi
				tween(b.Btn, { BackgroundTransparency = hi and 0.8 or (isOn(t) and 0.86 or 1) }, 0.12)
			end
		end
		local b = text and btns[text]
		if b then
			local sc = (list.Size.Y.Offset > 0 and list.AbsoluteSize.Y > 0) and (list.AbsoluteSize.Y / list.Size.Y.Offset) or 1
			local top = (b.Btn.AbsolutePosition.Y - list.AbsolutePosition.Y) / sc + list.CanvasPosition.Y
			local bottom = top + 24
			local view = list.AbsoluteSize.Y / sc
			if top < list.CanvasPosition.Y then
				list.CanvasPosition = Vector2.new(0, math.max(top - 4, 0))
			elseif bottom > list.CanvasPosition.Y + view then
				list.CanvasPosition = Vector2.new(0, bottom - view + 4)
			end
		end
	end

	local function moveHi(d)
		local vis = visibleItems()
		if #vis == 0 then return end
		local idx = hiText and table.find(vis, hiText)
		if idx then
			idx = idx + d
		else
			local cur = (not multi and selected) and table.find(vis, selected) or nil   -- 1re frappe : on part de la sélection
			idx = cur and (cur + d) or (d > 0 and 1 or #vis)
		end
		setHi(vis[((idx - 1) % #vis) + 1])
	end

	local function typeChar(ch)
		if search.Visible then
			-- liste avec recherche : la frappe filtre, la 1re ligne restante est visée
			search.Text = search.Text .. ch
			setHi(visibleItems()[1])
			return
		end
		local now = os.clock()
		if now - typeAt > 1 then typeBuf = "" end
		typeAt = now
		typeBuf = typeBuf .. string.lower(ch)
		local vis, found = visibleItems(), nil
		for _, t in ipairs(vis) do
			if string.sub(string.lower(t), 1, #typeBuf) == typeBuf then found = t break end
		end
		if not found then
			for _, t in ipairs(vis) do
				if string.find(string.lower(t), typeBuf, 1, true) then found = t break end
			end
		end
		if found then setHi(found) end
	end

	-- renvoie vrai si la touche a été utilisée
	local function handleKey(kc)
		if kc == Enum.KeyCode.Escape then
			if Library.DropdownEscape == false then return false end
			if search:IsFocused() then search:ReleaseFocus() end
			if search.Text ~= "" then
				search.Text = ""
				setHi(nil)
			else
				setOpen(false)
			end
			return true
		end
		if Library.DropdownKeyNav == false then return false end
		if kc == Enum.KeyCode.Up then moveHi(-1) return true end
		if kc == Enum.KeyCode.Down then moveHi(1) return true end
		if kc == Enum.KeyCode.Return or kc == Enum.KeyCode.KeypadEnter then
			if hiText and table.find(items, hiText) then
				uiSnd("pick")
				pick(hiText)
				return true
			end
			return false   -- rien de surligné : Entrée reste disponible pour le jeu
		end
		if kc == Enum.KeyCode.Backspace then
			if search.Visible then
				search.Text = string.sub(search.Text, 1, -2)
				setHi(visibleItems()[1])
			else
				typeBuf = string.sub(typeBuf, 1, -2)
			end
			return true
		end
		local ok, ch = pcall(function() return UIS:GetStringForKeyCode(kc) end)
		if kc == Enum.KeyCode.Space then ch = " " end
		if ok and type(ch) == "string" and #ch == 1 then
			typeChar(ch)
			return true
		end
		return false
	end

	local function navKeyList()
		local l = {}
		if Library.DropdownEscape ~= false then l[#l + 1] = Enum.KeyCode.Escape end
		if Library.DropdownKeyNav ~= false then
			for _, kc in ipairs({ Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter }) do
				l[#l + 1] = kc
			end
			-- lettres / chiffres / espace : seulement si la frappe dans les listes est activée (désactivée par défaut,
			-- sinon E, WASD, etc. sont « mangées » par la liste tant qu'elle est ouverte)
			if Library.DropdownTypeAhead == true then
				l[#l + 1] = Enum.KeyCode.Backspace
				l[#l + 1] = Enum.KeyCode.Space
				for c = 65, 90 do l[#l + 1] = Enum.KeyCode[string.char(c)] end
				for _, n in ipairs({ "Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine" }) do
					l[#l + 1] = Enum.KeyCode[n]
				end
			end
		end
		return l
	end

	local function stopOutside()
		if outsideConn then outsideConn:Disconnect() outsideConn = nil end
		if keyConn then keyConn:Disconnect() keyConn = nil end
		pcall(function() CAS:UnbindAction(NAV_ACT) end)
	end

	local function startNav()
		hiText, typeBuf = nil, ""
		setHi(nil)
		local keys = navKeyList()
		if #keys > 0 then
			pcall(function()
				CAS:BindActionAtPriority(NAV_ACT, function(_, state, input)
					if not holder.Parent or not isOpen then
						pcall(function() CAS:UnbindAction(NAV_ACT) end)   -- sécurité : ne jamais garder des touches bloquées
						return Enum.ContextActionResult.Pass
					end
					-- relâchements : toujours transmis (sinon une touche de déplacement tenue avant l'ouverture resterait « coincée »)
					if state ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
					local kc = input.KeyCode
					local mod = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
						or UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt)
					if mod and kc ~= Enum.KeyCode.Escape then return Enum.ContextActionResult.Pass end   -- Ctrl+K, Ctrl+R... restent possibles
					return handleKey(kc) and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
				end, false, 3000, table.unpack(keys))
			end)
		end
		-- champ de recherche sélectionné : les touches sont déjà prises par la zone de texte, on écoute à côté
		keyConn = track(UIS.InputBegan:Connect(function(i)
			if i.UserInputType ~= Enum.UserInputType.Keyboard or not isOpen or not search:IsFocused() then return end
			local kc = i.KeyCode
			if kc == Enum.KeyCode.Up or kc == Enum.KeyCode.Down or kc == Enum.KeyCode.Return
				or kc == Enum.KeyCode.KeypadEnter or kc == Enum.KeyCode.Escape then
				handleKey(kc)
			end
		end))
	end

	-- ouverture : les options apparaissent une à une (fondu + léger glissement de gauche à droite)
	local cascadeGen = 0
	local function cascadeIn()
		if not Library.Animations then return end
		cascadeGen += 1
		local my = cascadeGen
		local rows = {}
		for _, text in ipairs(items) do
			local b = btns[text]
			if b and b.Shown then rows[#rows + 1] = b end
		end
		local step = math.min(0.04, 0.36 / math.max(#rows, 1)) / math.max(Library.AnimSpeed or 1, 0.05)
		for i, b in ipairs(rows) do
			b.Btn.TextTransparency = 1
			b.Pad.PaddingLeft = UDim.new(0, 24)
			task.delay((i - 1) * step, function()
				if cascadeGen ~= my or not b.Btn.Parent then return end
				tween(b.Btn, { TextTransparency = 0 }, 0.3)
				tween(b.Pad, { PaddingLeft = UDim.new(0, 10) }, 0.34)
			end)
		end
	end

	setOpen = function(v)
		v = v and true or false
		if v == isOpen then return end
		if v then
			local prev = Library._openDD
			if prev and prev ~= setOpen then prev(false) end
			Library._openDD = setOpen
			if type(o.UpdateList) == "function" then
				local ok, res = pcall(o.UpdateList)
				if ok and type(res) == "table" then setItems(res, false) end
			end
			search.Text = ""
			pressedPick = false
			layout()
			cascadeIn()
			-- 🛠️ FIX : si la liste dépasse en bas de la zone visible, on fait défiler pour qu'elle soit entièrement cliquable
			task.delay(0.38, function()
				if not isOpen or not holder.Parent then return end
				local scroller = holder.Parent
				while scroller and not scroller:IsA("ScrollingFrame") do scroller = scroller.Parent end
				if not scroller then return end
				local sc = (head.AbsoluteSize.Y > 0) and (head.AbsoluteSize.Y / headH) or 1
				local need = holder.AbsolutePosition.Y + (headH + 4 + dr.Height) * sc + 10
				local have = scroller.AbsolutePosition.Y + scroller.AbsoluteSize.Y
				if need > have then
					local target = scroller.CanvasPosition.Y + (need - have) / sc
					pcall(function() tween(scroller, { CanvasPosition = Vector2.new(scroller.CanvasPosition.X, target) }, 0.25) end)
				end
			end)
			-- clic en dehors du dropdown (en-tête + liste) = fermeture
			stopOutside()
			local openedAt = os.clock()
			outsideConn = UIS.InputBegan:Connect(function(i)
				if not holder.Parent then stopOutside() return end
				if not isOpen then return end
				local ut = i.UserInputType
				if ut ~= Enum.UserInputType.MouseButton1 and ut ~= Enum.UserInputType.MouseButton2
					and ut ~= Enum.UserInputType.Touch then return end
				if os.clock() - openedAt < 0.1 then return end
				local m = (ut == Enum.UserInputType.Touch) and Vector2.new(i.Position.X, i.Position.Y + guiInset().Y)
					or UIS:GetMouseLocation()
				-- 🛠️ FIX : on compare à la taille FINALE du dropdown (en-tête + liste ouverte), pas à celle de l'animation en cours
				-- (sinon un clic sur les dernières lignes pendant l'ouverture / un redimensionnement fermait la liste sans choisir)
				local ap, as = holder.AbsolutePosition, holder.AbsoluteSize
				local sc = (head.AbsoluteSize.Y > 0) and (head.AbsoluteSize.Y / headH) or 1
				local fullH = math.max(as.Y, (headH + 4 + dr.Height) * sc)
				if m.X >= ap.X - 4 and m.Y >= ap.Y - 4 and m.X <= ap.X + as.X + 4 and m.Y <= ap.Y + fullH + 4 then return end
				if Library._ddPopHit and Library._ddPopHit(m) then return end
				setOpen(false)
			end)
			startNav()
		else
			stopOutside()
			if Library._openDD == setOpen then Library._openDD = nil end
			if ddEntry and Library._ddKeyClose then Library._ddKeyClose(ddEntry) end
		end
		isOpen = v
		dr:Set(v)
		-- même durée et même courbe que le tiroir : la flèche pivote exactement pendant que la liste se déploie
		tween(arrow, { Rotation = v and 90 or 0 }, v and 0.34 or 0.26)
	end

	search:GetPropertyChangedSignal("Text"):Connect(function()
		layout()
		if isOpen then
			if search.Text ~= "" then setHi(visibleItems()[1]) else setHi(nil) end
		end
	end)
	head.MouseButton1Click:Connect(function() uiSnd(isOpen and "close" or "open") setOpen(not isOpen) end)

	local item = {}
	item.Set = function(...)
		local v = unself(item, ...)
		if multi then
			selSet = {}
			if type(v) == "table" then
				for _, x in ipairs(v) do selSet[tostring(x)] = true end
			elseif v ~= nil and v ~= "" then
				selSet[tostring(v)] = true
			end
		else
			if type(v) == "table" then v = v[1] end
			if v ~= nil then selected = tostring(v) else selected = nil end
		end
		commit()
	end
	item.Get = function()
		if multi then return getMulti() end
		return selected
	end
	item.Refresh = function(...)
		local newItems, clear = unself(item, ...)
		setItems(newItems, clear)
	end
	item.SetItems = function(...)
		local newItems = unself(item, ...)
		setItems(newItems, false)
	end
	item.Open = function() setOpen(true) end
	item.Close = function() setOpen(false) end

	show()
	rebuild()
	local initial
	if multi then initial = getMulti() else initial = selected end
	register(o.Flag, item, initial)
	if keysOk then
		local keysItem = {}
		keysItem.Set = function(...)
			local v = unself(keysItem, ...)
			table.clear(keys)
			if type(v) == "table" then
				for t2, k2 in pairs(v) do
					if type(t2) == "string" and Library._ddKeyOf(k2) then keys[t2] = k2 end
				end
			end
			keysChanged()
		end
		keysItem.Get = function()
			local c = {}
			for t2, k2 in pairs(keys) do c[t2] = k2 end
			return c
		end
		register(keyFlag, keysItem, {})
		Library.DDKeyEntries[#Library.DDKeyEntries + 1] = ddEntry
		Library.ResetEntries[#Library.ResetEntries + 1] = { Kind = "DDKeys", Item = keysItem, Frame = holder }
	end
	if Library.FireDefaults and ((multi and #getMulti() > 0) or ((not multi) and selected)) then
		fire(o.Callback, initial)
	end
	return item
end

-- ============================================================================
-- FONDU DU TEXTE (champs de saisie) : chaque lettre tapée apparaît en fondu, chaque lettre supprimée s'efface en fondu.
-- Un calque RichText (transparence par lettre) est posé sur la TextBox ; la vraie TextBox devient transparente (le curseur de saisie
-- reste). Si le texte dépasse le champ (défilement), on revient au texte normal. Library.TextFade = false pour désactiver.
-- ============================================================================
Library.TextFade = true
function Library._attachTextFade(tb)
	if not tb or Library.TextFade == false then return end
	local IN_T, OUT_T = 0.18, 0.14
	local ESC = { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;", ["'"] = "&apos;" }

	local ov = Instance.new("TextLabel")
	ov.Name = "FadeText"
	ov.BackgroundTransparency = 1
	ov.BorderSizePixel = 0
	ov.Active = false
	ov.RichText = true
	ov.TextWrapped = tb.TextWrapped
	ov.TextTruncate = Enum.TextTruncate.None
	ov.Size = UDim2.fromScale(1, 1)
	ov.ZIndex = tb.ZIndex + 1
	ov.Visible = false
	ov.Text = ""
	ov.Parent = tb

	local function sync()
		ov.Font = tb.Font
		ov.TextSize = tb.TextSize
		ov.TextColor3 = tb.TextColor3
		ov.TextXAlignment = tb.TextXAlignment
		ov.TextYAlignment = tb.TextYAlignment
		ov.LineHeight = tb.LineHeight
	end
	sync()
	for _, p in ipairs({ "Font", "TextSize", "TextColor3", "TextXAlignment", "TextYAlignment" }) do
		tb:GetPropertyChangedSignal(p):Connect(sync)
	end

	local function split(s)
		local t = {}
		local ok = pcall(function()
			for _, cp in utf8.codes(s) do t[#t + 1] = utf8.char(cp) end
		end)
		if not ok then
			t = {}
			for i = 1, #s do t[i] = string.sub(s, i, i) end
		end
		return t
	end

	local real = split(tb.Text)   -- lettres réelles du champ
	local chars = {}              -- lettres affichées : { c, a (opacité), from, to, t0, dur, ghost }
	for i, c in ipairs(real) do chars[i] = { c = c, a = 1, from = 1, to = 1, t0 = 0, dur = 1 } end

	local function render()
		local out, run, runT = {}, {}, nil
		local function flush()
			if #run == 0 then return end
			local s = table.concat(run)
			if runT and runT > 0 then
				s = string.format('<font transparency="%.2f">%s</font>', runT, s)
			end
			out[#out + 1] = s
			run = {}
		end
		for _, ch in ipairs(chars) do
			local tr = math.floor((1 - ch.a) * 20 + 0.5) / 20
			if runT ~= tr then flush() runT = tr end
			run[#run + 1] = (string.gsub(ch.c, "[&<>\"']", ESC))
		end
		flush()
		ov.Text = table.concat(out)
	end

	local function layoutCheck()
		local sc = pxScale()
		local aw, ah = ov.AbsoluteSize.X / sc, ov.AbsoluteSize.Y / sc
		local tbx, tby = tb.TextBounds.X, tb.TextBounds.Y
		local over = (aw > 0 and tbx > aw + 1) or (tb.MultiLine and ah > 0 and tby > ah + 1)
		local active = (not over) and (tb.Text ~= "" or #chars > 0)
		ov.Visible = active
		tb.TextTransparency = (active and tb.Text ~= "") and 1 or 0
	end

	local conn
	local function step()
		if not ov.Parent then
			if conn then conn:Disconnect() conn = nil end
			return
		end
		local now = os.clock()
		local busy, i = false, 1
		while i <= #chars do
			local ch = chars[i]
			if ch.a ~= ch.to then
				local k = math.clamp((now - ch.t0) / ch.dur, 0, 1)
				local e = 1 - (1 - k) * (1 - k)
				ch.a = (k >= 1) and ch.to or (ch.from + (ch.to - ch.from) * e)
			end
			if ch.ghost and ch.a <= 0.001 then
				table.remove(chars, i)
			else
				if ch.a ~= ch.to then busy = true end
				i += 1
			end
		end
		render()
		layoutCheck()
		if not busy and conn then conn:Disconnect() conn = nil end
	end
	local function kick()
		if not conn then conn = Ticker.connect(step) end
	end

	local function onText()
		local new = split(tb.Text)
		local old = real
		if table.concat(new) == table.concat(old) then return end
		local animate = tb:IsFocused()
		local now = os.clock()
		-- préfixe / suffixe communs
		local p = 0
		local minLen = math.min(#old, #new)
		while p < minLen and old[p + 1] == new[p + 1] do p += 1 end
		local s = 0
		while s < minLen - p and old[#old - s] == new[#new - s] do s += 1 end

		local list = {}
		for i = 1, p do list[#list + 1] = chars[i] end
		local inserted = #new - p - s
		for i = 1, inserted do
			local a = (animate and inserted <= 120) and 0 or 1
			list[#list + 1] = { c = new[p + i], a = a, from = a, to = 1, t0 = now, dur = IN_T }
		end
		for i = #old - s + 1, #old do list[#list + 1] = chars[i] end
		-- lettres supprimées à la fin du texte : elles s'effacent en fondu
		if animate and s == 0 then
			for i = p + 1, #old do
				local ch = chars[i]
				if ch then
					ch.ghost, ch.from, ch.to, ch.t0, ch.dur = true, ch.a, 0, now, OUT_T
					list[#list + 1] = ch
				end
			end
		end
		-- anciennes lettres encore en train de disparaître
		for i = #old + 1, #chars do
			local ch = chars[i]
			if ch and ch.ghost and animate then list[#list + 1] = ch end
		end
		chars, real = list, new
		for _, ch in ipairs(chars) do
			if not animate and not ch.ghost then ch.a, ch.from, ch.to = 1, 1, 1 end
		end
		render()
		layoutCheck()
		task.defer(layoutCheck)
		kick()
	end

	tb:GetPropertyChangedSignal("Text"):Connect(onText)
	ov:GetPropertyChangedSignal("AbsoluteSize"):Connect(Library._lazy(layoutCheck))
	render()
	task.defer(layoutCheck)
end

-- ============================================================================
-- SURLIGNAGE DE SÉLECTION (tous les champs de texte) : un rectangle bleu vif balaie le texte sélectionné depuis la gauche
-- (Ctrl+A, double-clic, glisser...). Roblox ne permet pas de changer la couleur native de la sélection : ce calque se pose
-- par-dessus (translucide, le texte reste lisible). Champs multi-lignes (TextArea) : sélection native conservée.
-- Library.SelectionColor / Library.SelectionTransparency / Library.SelectionAnim = false pour couper l'animation.
-- ============================================================================
Library.SelectionColor        = Color3.fromRGB(0, 110, 255)
Library.SelectionTransparency = 0.3
Library.SelectionAnim         = true
function Library._attachSelection(tb)
	if not tb or tb.MultiLine then return end
	local host = Instance.new("Frame")
	host.Name = "SelHost"
	host.BackgroundTransparency = 1
	host.BorderSizePixel = 0
	host.Active = false
	host.ClipsDescendants = true
	host.Size = UDim2.fromScale(1, 1)
	host.ZIndex = tb.ZIndex
	host.Parent = tb
	local hl = Instance.new("Frame")
	hl.Name = "Sel"
	hl.AnchorPoint = Vector2.new(0, 0.5)
	hl.BackgroundColor3 = Library.SelectionColor
	hl.BackgroundTransparency = 1
	hl.BorderSizePixel = 0
	hl.Active = false
	hl.Visible = false
	hl.ZIndex = tb.ZIndex
	hl.Parent = host
	local cr = Instance.new("UICorner")
	cr.CornerRadius = UDim.new(0, 3)
	cr.Parent = hl

	local lastA, lastB, tok = nil, nil, 0

	local function localScale()
		local k, p = 1, tb
		while p do
			if p:IsA("GuiObject") or p:IsA("LayerCollector") then
				for _, ch in ipairs(p:GetChildren()) do
					if ch:IsA("UIScale") then k = k * ch.Scale end
				end
			end
			p = p.Parent
		end
		return math.max(k, 0.05)
	end

	local function range()
		if not tb:IsFocused() then return nil end
		local cp, ss = tb.CursorPosition, tb.SelectionStart
		if cp < 1 or ss < 1 or cp == ss then return nil end
		local a, b = math.min(cp, ss), math.max(cp, ss)
		return a, math.min(b, #tb.Text + 1)
	end

	-- position / largeur du surlignage (en pixels UI, dans la zone de texte du champ)
	local function geometry(a, b)
		local txt, size, font = tb.Text, tb.TextSize, tb.Font
		local sc = localScale()
		local cw = host.AbsoluteSize.X / sc
		local total = measureText(txt, size, font).X
		local pre = (a > 1) and measureText(string.sub(txt, 1, a - 1), size, font).X or 0
		local upTo = measureText(string.sub(txt, 1, b - 1), size, font).X
		local off = 0
		local al = tb.TextXAlignment
		if total <= cw then
			if al == CENTER then off = (cw - total) / 2 elseif al == RIGHT then off = cw - total end
		else
			off = cw - total   -- texte qui défile : la fin est visible
			if a <= 1 then off = 0 end
		end
		local x0 = math.clamp(off + pre, 0, cw)
		local x1 = math.clamp(off + upTo, 0, cw)
		return x0, math.max(x1 - x0, 0)
	end

	local function place(x0, w, animate, dur)
		local hh = tb.TextSize + 4
		local ya = tb.TextYAlignment
		local yS, yO = 0.5, 0
		if ya == Enum.TextYAlignment.Top then yS, yO = 0, hh / 2
		elseif ya == Enum.TextYAlignment.Bottom then yS, yO = 1, -hh / 2 end
		hl.Position = UDim2.new(0, x0, yS, yO)
		local goal = UDim2.new(0, w, 0, hh)
		if animate then
			tween(hl, { Size = goal }, dur or 0.3)
		else
			hl.Size = goal
		end
	end

	local function apply()
		local a, b = range()
		if a == lastA and b == lastB then return end
		local had = lastA ~= nil
		lastA, lastB = a, b
		tok += 1
		local my = tok
		if not a then
			local tw = tween(hl, { BackgroundTransparency = 1 }, 0.16)
			tw.Completed:Connect(function()
				if tok == my then hl.Visible = false end
			end)
			return
		end
		local x0, w = geometry(a, b)
		hl.BackgroundColor3 = Library.SelectionColor
		hl.Visible = true
		if not had and Library.SelectionAnim ~= false then
			-- nouvelle sélection : balayage depuis la gauche
			hl.BackgroundTransparency = 1
			hl.Position = UDim2.new(0, x0, 0.5, 0)
			hl.Size = UDim2.new(0, 0, 0, tb.TextSize + 4)
			place(x0, w, true, 0.32)
			tween(hl, { BackgroundTransparency = Library.SelectionTransparency }, 0.2)
		else
			-- la sélection change (glisser à la souris, Maj + flèches) : le surlignage suit sans retard
			hl.BackgroundTransparency = Library.SelectionTransparency
			place(x0, w, had, 0.07)
		end
	end

	local function refresh()
		lastA, lastB = nil, nil
		if tb:IsFocused() then
			local a, b = range()
			if a then
				local x0, w = geometry(a, b)
				lastA, lastB = a, b
				hl.Visible = true
				hl.BackgroundTransparency = Library.SelectionTransparency
				place(x0, w, false)
				return
			end
		end
		tok += 1
		hl.Visible = false
		hl.BackgroundTransparency = 1
	end

	tb:GetPropertyChangedSignal("SelectionStart"):Connect(apply)
	tb:GetPropertyChangedSignal("CursorPosition"):Connect(apply)
	tb:GetPropertyChangedSignal("Text"):Connect(function() task.defer(apply) end)
	tb.Focused:Connect(function() task.defer(apply) end)
	tb.FocusLost:Connect(refresh)
	host:GetPropertyChangedSignal("AbsoluteSize"):Connect(Library._lazy(function()
		if lastA then refresh() end
	end))
	for _, pn in ipairs({ "Font", "TextSize", "TextXAlignment" }) do
		tb:GetPropertyChangedSignal(pn):Connect(function() if lastA then refresh() end end)
	end
end

function Block:CreateInput(o)
	o = o or {}
	local f, st = makeRow(self, 34, o.Name)
	local lbl = label(f, o.Name or "Input", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.4, -12, 1, 0) })
	local tb = new("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0.6, -14, 0, 24),
		BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0,
		Text = o.Default and tostring(o.Default) or "", PlaceholderText = o.Placeholder or o.PlaceholderText or "",
		PlaceholderColor3 = Color3.fromRGB(125, 125, 132), TextColor3 = T.Text, TextSize = 12,
		Font = F_REG, ClearTextOnFocus = o.ClearOnFocus == true, TextTruncate = Enum.TextTruncate.None,
		TextXAlignment = LEFT, ClipsDescendants = true, ZIndex = 2,
	}, f)
	corner(tb, 6)
	local tst = stroke(tb, 0.9)
	trackStyled(tb, tst, "input")
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, tb)
	Library._attachTextFade(tb)
	hover(f, st)

	-- ------------------------------------------------------------------------
	-- Le champ s'AGRANDIT (vers la gauche, avec une transition) quand le texte est trop long, au lieu d'afficher « ... ».
	-- Il grandit jusqu'à la largeur de la ligne (le nom du champ s'efface en fondu quand il passe dessous) ; si le texte
	-- dépasse encore, il défile pendant la saisie et se termine par « ... » seulement quand le champ n'est pas sélectionné.
	-- ------------------------------------------------------------------------
	local TextService = game:GetService("TextService")
	local PADX, LEAD, STEP = 22, 14, 6          -- marges internes + curseur / pas d'agrandissement (évite un tween à chaque lettre)
	local lastW, focused = nil, false
	local function rowW() return f.AbsoluteSize.X / pxScale() end
	local function fit(animate, force)
		local rw = rowW()
		if rw < 60 then return end   -- ligne pas encore mise en page (ou bloc replié)
		local base, max = rw * 0.6 - 14, rw - 16
		local want = base
		if tb.Text ~= "" then
			local ok, b = pcall(TextService.GetTextSize, TextService, tb.Text, tb.TextSize, tb.Font, Vector2.new(10000, 100))
			if ok then want = math.ceil((b.X + PADX + LEAD) / STEP) * STEP end
		end
		local w = math.clamp(want, base, max)
		tb.TextTruncate = (want > max and not focused) and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None
		if not force and lastW and math.abs(w - lastW) < 0.5 then return end
		lastW = w
		local size = UDim2.new(0, w, 0, 24)
		local hide = (rw - 8 - w) < (12 + lbl.TextBounds.X + 10)   -- le champ recouvre le nom -> on l'efface
		if animate then
			Library._spring(tb, { Size = size }, "smooth")   -- ressort : la vitesse est gardée quand une nouvelle lettre change la cible
			tween(lbl, { TextTransparency = hide and 1 or 0 }, 0.22)
		else
			Library._springStop(tb, "Size")
			tb.Size = size
			lbl.TextTransparency = hide and 1 or 0
		end
	end
	f:GetPropertyChangedSignal("AbsoluteSize"):Connect(Library._lazy(function() fit(false, true) end))
	fit(false, true)
	task.defer(fit, false, true)

	tb.Focused:Connect(function()
		focused = true
		uiSnd("focus")
		tween(tst, { Transparency = 0.35 }, 0.2)
		fit(true)
	end)
	tb.FocusLost:Connect(function()
		focused = false
		tween(tst, { Transparency = Sty.InputStroke }, 0.3)
		fit(true)
		fire(o.Callback, tb.Text)
	end)
	tb:GetPropertyChangedSignal("Text"):Connect(function()
		if o.Numeric then
			local clean = string.gsub(tb.Text, "[^%d%.%-]", "")
			local neg = string.sub(clean, 1, 1) == "-"
			clean = string.gsub(clean, "%-", "")
			local a, b = string.find(clean, ".", 1, true)
			if a then clean = string.sub(clean, 1, a) .. string.gsub(string.sub(clean, a + 1), "%.", "") end
			if neg then clean = "-" .. clean end
			if clean ~= tb.Text then tb.Text = clean return end
		end
		if o.Flag then Library.Flags[o.Flag] = tb.Text end
		fit(true)
		if o.LiveUpdate then fire(o.Callback, tb.Text) end
	end)

	local item = {}
	item.Set = function(...)
		tb.Text = tostring((unself(item, ...)) or "")
		fire(o.Callback, tb.Text)
	end
	item.Get = function() return tb.Text end
	item.Instance = tb
	register(o.Flag, item, tb.Text)
	return item
end

function Block:CreateKeybind(o)
	o = o or {}
	local key = o.Default or Enum.KeyCode.Unknown
	local f, st = makeRow(self, 34, o.Name)
	label(f, o.Name or "Keybind", 13, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -190, 1, 0) })
	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 88, 0, 24),
		BackgroundColor3 = T.Off, BackgroundTransparency = 0.4, BorderSizePixel = 0, Text = Library._kb.text(key),
		TextColor3 = T.Text, TextSize = 12, Font = F_MED, AutoButtonColor = false,
	}, f)
	corner(btn, 6)
	local bst = stroke(btn, 0.9)
	trackStyled(btn, bst, "input")
	hover(f, st)

	-- mode : Toggle / Hold / Always (sélecteur sur la ligne)
	local mode = (o.Mode == "Hold" or o.Mode == "Always") and o.Mode or "Toggle"
	local active = (mode == "Always")
	local MODE_ORDER = { "Toggle", "Hold", "Always" }
	local modeBtn = new("TextButton", { Name = "KeyMode", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -102, 0.5, 0),
		Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.Off,
		BackgroundTransparency = 0.4, BorderSizePixel = 0, Text = mode, TextColor3 = T.ElementAccent, TextSize = 11,
		Font = F_MED, AutoButtonColor = false }, f)
	corner(modeBtn, 6)
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, modeBtn)
	trackStyled(modeBtn, stroke(modeBtn, 0.9), "input")
	local function setActive(a)
		if a == active then return end
		active = a
		if Library._hudRefresh then Library._hudRefresh() end
		fire(o.OnState, active)
	end
	local function setMode(m)
		if not table.find(MODE_ORDER, m) then return end
		local prev = mode
		mode = m
		modeBtn.Text = m
		if o.Flag then Library.Flags[o.Flag .. ".mode"] = m end
		if m == "Always" then setActive(true) elseif m == "Hold" or prev == "Always" then setActive(false) end
		fire(o.ModeCallback, m)
	end
	modeBtn.MouseButton1Click:Connect(function()
		uiSnd("click")
		setMode(MODE_ORDER[((table.find(MODE_ORDER, mode) or 1) % 3) + 1])
	end)

	local function apply(k, silent)
		key = k
		btn.Text = Library._kb.text(k)
		if o.Flag then Library.Flags[o.Flag] = k.Name end
		if Library._hudRefresh then Library._hudRefresh() end
		if Library.RefreshKeybindConflicts then Library:RefreshKeybindConflicts() end
		if Library._onKeybindChanged then pcall(Library._onKeybindChanged) end
		if not silent then
			if Library._notifyKeyConflict then Library:_notifyKeyConflict(f, k) end
			fire(o.Callback, k)
		end
	end
	local listening = false
	btn.MouseButton1Click:Connect(function()
		if listening or Library._listening then return end   -- une seule assignation à la fois
		listening = true
		Library._listening = true
		btn.Text = "..."
		uiSnd("focus")
		tween(bst, { Transparency = 0.25 }, 0.2)
		local c
		local function stop()
			if c then c:Disconnect() c = nil end
			listening = false
			Library._listening = false
			Library._abortListen = nil
			tween(bst, { Transparency = Sty.InputStroke }, 0.3)
		end
		local function label0() btn.Text = Library._kb.text(key) end
		Library._abortListen = function() stop() label0() end   -- interface masquée pendant l'écoute
		c = Library._kb.listen(function(k)   -- touche du clavier OU clic gauche / droit / milieu
			stop()
			if k == Enum.KeyCode.Escape then
				label0()                                  -- annulé : la touche actuelle est gardée
			elseif k == Enum.KeyCode.Backspace or k == Enum.KeyCode.Delete then
				apply(Enum.KeyCode.Unknown)               -- retirer la touche
			else
				apply(k)
			end
		end)
	end)


	local item = {}
	item.Set = function(...)
		local k = unself(item, ...)
		if type(k) == "string" then k = Library._kb.parse(k) end
		if typeof(k) == "EnumItem" then apply(k) end
	end
	item.Get = function() return key end
	item.IsActive = function() return mode == "Always" or active end
	item.GetMode = function() return mode end
	item.SetMode = function(...) setMode((unself(item, ...))) end
	-- la touche agit selon le mode : Hold = actif tant qu'elle est tenue, Toggle = bascule, Always = toujours actif
	track(UIS.InputBegan:Connect(function(i, gp)
		if gp or Library._listening or not Library._kb.hit(i, key) then return end
		if mode == "Always" then return end
		if UIS:GetFocusedTextBox() or not f.Parent then return end
		if mode == "Hold" then setActive(true) else setActive(not active) end
	end))
	track(UIS.InputEnded:Connect(function(i)
		if mode == "Hold" and Library._kb.hit(i, key) then setActive(false) end
	end))
	local modeItem = {}
	modeItem.Get = function() return mode end
	modeItem.Set = function(...) setMode((unself(modeItem, ...))) end
	if o.Flag then register(o.Flag .. ".mode", modeItem, mode) end
	register(o.Flag, item, key.Name)
	return item
end

-- ============================================================================
-- COLOR PICKER : opacité, pipette, couleurs récentes, copier / coller hexadécimal
--   Callback = function(couleur, opacite)  ·  item.Get() = Color3  ·  item.GetAlpha() / SetAlpha(0..1)  ·  item.Set(couleur, opacite)
--   Options : Opacity = false (pas de barre d'opacité), DefaultAlpha = 0..1.   Flag = { R, G, B, A }
--   Library:PickScreenColor(function(couleur) end) : pipette seule. Library:PushRecentColor(couleur) / Library.RecentColors
-- ============================================================================
do
	Library._recentViews = Library._recentViews or {}

	-- "#RGB" / "#RGBA" / "#RRGGBB" / "#RRGGBBAA"  ->  Color3, opacité (ou nil)
	Library._parseHex = function(txt)
		txt = (string.gsub(tostring(txt or ""), "[#%s]", ""))
		if #txt == 3 or #txt == 4 then txt = (string.gsub(txt, "(%x)", "%1%1")) end
		if (#txt ~= 6 and #txt ~= 8) or not string.match(txt, "^%x+$") then return nil end
		local ok, c = pcall(Color3.fromHex, string.sub(txt, 1, 6))
		if not ok or typeof(c) ~= "Color3" then return nil end
		local a
		if #txt == 8 then a = (tonumber(string.sub(txt, 7, 8), 16) or 255) / 255 end
		return c, a
	end

	function Library:_refreshRecentViews()
		local v = Library._recentViews
		for i = #v, 1, -1 do
			local e = v[i]
			if e.inst and e.inst.Parent then pcall(e.refresh) else table.remove(v, i) end
		end
	end

	function Library:PushRecentColor(c)
		if typeof(c) ~= "Color3" then return end
		local hx = string.upper(c:ToHex())
		local L = Library.RecentColors
		for i = #L, 1, -1 do
			if L[i] == hx then table.remove(L, i) end
		end
		table.insert(L, 1, hx)
		while #L > (Library.RecentColorMax or 8) do table.remove(L) end
		Library.Flags["ui.recentcolors"] = table.clone(L)
		Library:_refreshRecentViews()
	end

	-- sauvegardé avec les réglages (clé « ui.recentcolors »)
	function Library:_registerRecentColors()
		Library.Flags["ui.recentcolors"] = table.clone(Library.RecentColors)
		Library.Defaults["ui.recentcolors"] = {}
		Library.Items["ui.recentcolors"] = {
			Get = function() return table.clone(Library.RecentColors) end,
			Set = function(_, list)
				table.clear(Library.RecentColors)
				if type(list) == "table" then
					for _, hx in ipairs(list) do
						if type(hx) == "string" and string.match(hx, "^%x%x%x%x%x%x$")
							and #Library.RecentColors < (Library.RecentColorMax or 8) then
							Library.RecentColors[#Library.RecentColors + 1] = string.upper(hx)
						end
					end
				end
				Library.Flags["ui.recentcolors"] = table.clone(Library.RecentColors)
				Library:_refreshRecentViews()
			end,
		}
	end

	-- ───────────── Pipette ─────────────
	-- Clique sur un élément d'interface (couleur de fond) ou sur un objet du monde (couleur de la pièce / du terrain).
	local pip
	local function sampleAt(m)
		local inset = guiInset()
		local gx, gy = m.X - inset.X, m.Y - inset.Y
		for _, root in ipairs({ CoreGui, LP:FindFirstChild("PlayerGui") }) do
			if root then
				local ok, objs = pcall(function() return root:GetGuiObjectsAtPosition(gx, gy) end)
				if ok and type(objs) == "table" then
					for _, g in ipairs(objs) do
						if not (pip and g:IsDescendantOf(pip.gui)) and g.BackgroundTransparency < 0.9 then
							return g.BackgroundColor3
						end
					end
				end
			end
		end
		local cam = workspace.CurrentCamera
		if cam then
			local ray = cam:ViewportPointToRay(m.X, m.Y)
			local ok, res = pcall(function() return workspace:Raycast(ray.Origin, ray.Direction * 1500) end)
			if ok and res and res.Instance then
				if res.Instance:IsA("Terrain") then
					local ok2, c = pcall(function() return workspace.Terrain:GetMaterialColor(res.Material) end)
					if ok2 and typeof(c) == "Color3" then return c end
				elseif res.Instance:IsA("BasePart") then
					return res.Instance.Color
				end
			end
		end
		return nil
	end

	local function closePip()
		local p = pip
		if not p then return end
		pip = nil
		for _, c in ipairs(p.conns) do pcall(function() c:Disconnect() end) end
		pcall(function() p.gui:Destroy() end)
		Library:ReleaseCursor("pipette")
	end
	Library._destroyPipette = closePip

	function Library:PickScreenColor(onPick)
		if pip then return false end
		local gui = new("ScreenGui", { Name = "SolarisPipette", ResetOnSpawn = false, DisplayOrder = 1200,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true })
		mount(gui)
		local P = { gui = gui, conns = {} }
		pip = P
		Library:AcquireCursor("pipette", true)

		local catcher = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
			AutoButtonColor = false, BorderSizePixel = 0, Active = true }, gui)
		local card = new("Frame", { Size = UDim2.fromOffset(112, 38), BackgroundColor3 = T.Main, BackgroundTransparency = 0.05,
			BorderSizePixel = 0, ZIndex = 5 }, gui)
		corner(card, 10)
		stroke(card, 0.5)
		local sw = new("Frame", { Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(26, 26),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 6 }, card)
		corner(sw, 6)
		new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.4, ApplyStrokeMode = BORDER }, sw)
		local lb = label(card, "#FFFFFF", 12, { Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -44, 1, 0),
			Font = F_BOLD, ZIndex = 6 })
		local hint = label(gui, "Clique pour choisir une couleur  ·  Échap pour annuler", 13, { AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 30), Size = UDim2.fromOffset(420, 24), TextXAlignment = CENTER, ZIndex = 6,
			TextStrokeTransparency = 0.5 })

		local current
		local acc = 0
		P.conns[#P.conns + 1] = Ticker.connect(function(dt)
			local m = UIS:GetMouseLocation()
			local vp = viewport()
			card.Position = UDim2.fromOffset(math.clamp(m.X + 18, 0, vp.X - 120), math.clamp(m.Y + 18, 0, vp.Y - 46))
			acc += dt
			if acc < 1 / 30 then return end
			acc = 0
			local c = sampleAt(m)
			if c then
				current = c
				sw.BackgroundColor3 = c
				lb.Text = "#" .. string.upper(c:ToHex())
			else
				current = nil
				lb.Text = "—"
			end
		end)
		P.conns[#P.conns + 1] = catcher.InputBegan:Connect(function(i)
			if not isPress(i) then return end
			local c = sampleAt(UIS:GetMouseLocation()) or current
			closePip()
			if c then fire(onPick, c) end
		end)
		P.conns[#P.conns + 1] = UIS.InputBegan:Connect(function(i)
			if i.KeyCode == Enum.KeyCode.Escape then closePip() end
		end)
		return true
	end
end

