Library.TooltipText = nil
Library.TooltipStart = 0

function Library:AddTooltip(text, hoverInstance)
    if not text or text == "" or not hoverInstance then
        return
    end
    local tooltip = { Text = text, Hover = hoverInstance, Disabled = false }

    hoverInstance.MouseEnter:Connect(function()
        if tooltip.Disabled or Library.IsMobile then
            return
        end
        Library.TooltipText = tooltip.Text
        Library.TooltipStart = Library.Clock
    end)

    hoverInstance.MouseLeave:Connect(function()
        if Library.TooltipText == tooltip.Text then
            Library.TooltipText = nil
        end
    end)

    function tooltip:SetText(newText)
        self.Text = newText
    end

    function tooltip:Destroy()
        self.Disabled = true
        if Library.TooltipText == self.Text then
            Library.TooltipText = nil
        end
    end

    return tooltip
end

function Library:BuildTooltip()
    local frame = self:Create("Frame", {
        Name = "Tooltip",
        AutomaticSize = Enum.AutomaticSize.XY,
        Size = UDim2.fromOffset(0, 0),
        Visible = false,
        ZIndex = 900,
        ["@BackgroundColor3"] = "BackgroundColor",
        Parent = self.Root,
    })
    self:AddCorner(frame, 4)
    self:AddStroke(frame, "AccentColor", 1, 0.4)
    self:AddPadding(frame, 5, 8, 5, 8)

    local label = self:Create("TextLabel", {
        AutomaticSize = Enum.AutomaticSize.XY,
        Size = UDim2.fromOffset(0, 0),
        Text = "",
        TextSize = self.TextSize - 1,
        TextWrapped = true,
        ZIndex = 901,
        ["@TextColor3"] = "FontColor",
        Parent = frame,
    })
    self:Create("UISizeConstraint", { MaxSize = Vector2.new(280, 400), Parent = frame })

    self.TooltipFrame = frame
    self.TooltipLabel = label

    self:AddAnimation(function()
        local text = self.TooltipText
        if text and self.Clock - self.TooltipStart > 0.35 and self.Toggled then
            if label.Text ~= text then
                label.Text = text
            end
            local mouse = UserInputService:GetMouseLocation() / self.DPIScale
            frame.Position = UDim2.fromOffset(mouse.X + 14, mouse.Y + 12)
            frame.Visible = true
        else
            frame.Visible = false
        end
    end)
end

-- ════════════════════════════════════════════════════════════════════════
--  Black hole visuals
-- ════════════════════════════════════════════════════════════════════════

local BlackHole = {}
BlackHole.__index = BlackHole

local function DiskColorSequence(theme)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.DiskColor1),
        ColorSequenceKeypoint.new(0.35, theme.DiskColor2),
        ColorSequenceKeypoint.new(0.7, theme.DiskColor3),
        ColorSequenceKeypoint.new(1, theme.DiskColor1),
    })
end

local DISK_TRANSPARENCY = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0),
    NumberSequenceKeypoint.new(0.25, 0.35),
    NumberSequenceKeypoint.new(0.5, 1),
    NumberSequenceKeypoint.new(0.75, 0.35),
    NumberSequenceKeypoint.new(1, 0),
})

Library.DiskTransparency = DISK_TRANSPARENCY
Library.DiskColorSequence = DiskColorSequence

--- Build the black hole background inside `parent`.
--- options: Center (UDim2 scale, default 0.74 / 0.6), Radius (px), ZIndex
function BlackHole.new(parent, options)
    options = options or {}
    local self = setmetatable({}, BlackHole)
    self.Parent = parent
    self.CenterScale = options.Center or Vector2.new(0.74, 0.6)
    self.Radius = options.Radius or 54
    self.ZIndex = options.ZIndex or 1
    self.Stars = {}
    self.Rings = {}
    self.Time = 0
    self.LastStarColor = nil
    self.Visible = true
    self.Destroyed = false

    self.Root = Library:Create("Frame", {
        Name = "BlackHole",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = self.ZIndex,
        ClipsDescendants = true,
        Parent = parent,
    })

    self.StarLayer = Library:Create("Frame", {
        Name = "Stars",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = self.ZIndex,
        Parent = self.Root,
    })

    self.DiskLayer = Library:Create("Frame", {
        Name = "Disk",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(self.CenterScale.X, self.CenterScale.Y),
        Size = UDim2.fromOffset(10, 10),
        ZIndex = self.ZIndex + 1,
        Parent = self.Root,
    })

    self:BuildDisk()
    self:BuildStars()

    self.Animation = Library:AddAnimation(function(dt)
        self:Update(dt)
    end)

    self.ThemeConnection = Library.ThemeChanged:Connect(function()
        self:ApplyTheme()
    end)

    return self
end

function BlackHole:BuildDisk()
    for _, ring in ipairs(self.Rings) do
        ring.Frame:Destroy()
    end
    self.Rings = {}

    local radius = self.Radius
    local theme = Library.Theme

    -- Rings are drawn from the outside in. Elliptical rings fake the tilted
    -- accretion disk, the circular ring behind the core fakes gravitational
    -- lensing.
    local definitions = {
        { W = radius * 7.4, H = radius * 1.5, Thick = 1, Speed = 14, Alpha = 0.78, Z = 1 },
        { W = radius * 6.2, H = radius * 1.25, Thick = 2, Speed = -22, Alpha = 0.62, Z = 2 },
        { W = radius * 5.0, H = radius * 1.0, Thick = 3, Speed = 34, Alpha = 0.48, Z = 3 },
        { W = radius * 3.7, H = radius * 0.75, Thick = 3, Speed = -46, Alpha = 0.36, Z = 4 },
        { W = radius * 2.6, H = radius * 2.6, Thick = 2, Speed = 60, Alpha = 0.4, Z = 5 },
        { W = radius * 2.25, H = radius * 2.25, Thick = 4, Speed = -80, Alpha = 0.3, Z = 6 },
    }

    for index, def in ipairs(definitions) do
        local frame = Library:Create("Frame", {
            Name = "Ring" .. index,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(def.W, def.H),
            BackgroundTransparency = 1,
            ZIndex = self.ZIndex + def.Z,
            Parent = self.DiskLayer,
        })
        Library:AddCorner(frame, 9999)

        local stroke = Library:Create("UIStroke", {
            Thickness = def.Thick,
            Transparency = def.Alpha,
            Color = Color3.new(1, 1, 1),
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = frame,
        })
        local gradient = Library:Create("UIGradient", {
            Color = DiskColorSequence(theme),
            Transparency = DISK_TRANSPARENCY,
            Rotation = math.random(0, 360),
            Parent = stroke,
        })

        table.insert(self.Rings, {
            Frame = frame,
            Stroke = stroke,
            Gradient = gradient,
            Speed = def.Speed,
            Alpha = def.Alpha,
            Base = def,
        })
    end

    -- Soft glow behind the core
    self.Glow = Library:Create("Frame", {
        Name = "Glow",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(radius * 3.2, radius * 3.2),
        BackgroundColor3 = theme.DiskColor2,
        BackgroundTransparency = 0.93,
        ZIndex = self.ZIndex,
        Parent = self.DiskLayer,
    })
    Library:AddCorner(self.Glow, 9999)

    -- Event horizon (the actual black hole)
    self.Core = Library:Create("Frame", {
        Name = "Core",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(radius * 1.9, radius * 1.9),
        BackgroundColor3 = Color3.new(0, 0, 0),
        ZIndex = self.ZIndex + 8,
        Parent = self.DiskLayer,
    })
    Library:AddCorner(self.Core, 9999)
    self.CoreStroke = Library:Create("UIStroke", {
        Thickness = 2,
        Transparency = 0.15,
        Color = Color3.new(1, 1, 1),
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = self.Core,
    })
    self.CoreGradient = Library:Create("UIGradient", {
        Color = DiskColorSequence(theme),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(0.5, 0.7),
            NumberSequenceKeypoint.new(1, 0),
        }),
        Parent = self.CoreStroke,
    })
end

function BlackHole:BuildStars()
    for _, star in ipairs(self.Stars) do
        star.Frame:Destroy()
    end
    self.Stars = {}

    local count = Library.Effects.StarCount
    for index = 1, count do
        local size = math.random(10, 26) / 10
        local frame = Library:Create("Frame", {
            Name = "Star" .. index,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(size, size),
            BackgroundColor3 = Library.Theme.StarColor,
            BackgroundTransparency = 1,
            ZIndex = self.ZIndex,
            Parent = self.StarLayer,
        })
        Library:AddCorner(frame, 9999)

        table.insert(self.Stars, {
            Frame = frame,
            R = 0.15 + math.random() * 1.05,
            Theta = math.random() * math.pi * 2,
            Size = size,
            Phase = math.random() * math.pi * 2,
            Twinkle = 0.6 + math.random() * 1.6,
            Fall = 0.6 + math.random() * 0.8,
        })
    end
end

function BlackHole:ApplyTheme()
    local theme = Library.Theme
    local sequence = DiskColorSequence(theme)
    for _, ring in ipairs(self.Rings) do
        ring.Gradient.Color = sequence
    end
    if self.CoreGradient then
        self.CoreGradient.Color = sequence
    end
    if self.Glow then
        self.Glow.BackgroundColor3 = theme.DiskColor2
    end
end

function BlackHole:Update(dt)
    if self.Destroyed then
        return
    end
    local effects = Library.Effects
    local visible = Library.Toggled and effects.Enabled and self.Parent.Visible
    if self.Root.Visible ~= (effects.Enabled == true) then
        self.Root.Visible = effects.Enabled == true
    end
    if not visible then
        return
    end

    local speed = effects.Speed
    local intensity = effects.Intensity
    self.Time = self.Time + dt * speed

    -- Disk
    self.DiskLayer.Visible = effects.Disk
    if effects.Disk then
        for _, ring in ipairs(self.Rings) do
            ring.Gradient.Rotation = (ring.Gradient.Rotation + ring.Speed * dt * speed) % 360
            ring.Stroke.Transparency = math.clamp(1 - (1 - ring.Alpha) * intensity, 0, 1)
        end
        self.Glow.BackgroundTransparency = math.clamp(1 - (0.07 * intensity), 0.5, 1)
        local pulse = 1 + math.sin(self.Time * 1.4) * 0.03
        local core = self.Radius * 1.9 * pulse
        self.Core.Size = UDim2.fromOffset(core, core)
        self.CoreGradient.Rotation = (self.CoreGradient.Rotation + 40 * dt * speed) % 360
    end

    -- Stars
    self.StarLayer.Visible = effects.Stars
    if not effects.Stars then
        return
    end

    local absolute = self.Root.AbsoluteSize
    if absolute.X < 2 or absolute.Y < 2 then
        return
    end
    local cx = absolute.X * self.CenterScale.X
    local cy = absolute.Y * self.CenterScale.Y
    local maxR = math.max(absolute.X, absolute.Y) * 0.72
    local starColor = Library.Theme.StarColor
    local recolor = self.LastStarColor ~= starColor
    self.LastStarColor = starColor

    -- Visible star count follows the setting without rebuilding
    local wanted = effects.StarCount
    if wanted ~= #self.Stars then
        self:BuildStars()
    end

    for _, star in ipairs(self.Stars) do
        local r = star.R
        -- Orbital speed grows closer to the singularity, stars slowly spiral in.
        local angular = 0.22 / (r ^ 1.5 + 0.06)
        star.Theta = star.Theta + angular * dt * speed
        star.R = r - (0.010 * star.Fall / (r + 0.25)) * dt * speed

        if star.R < 0.09 then
            star.R = 1.05 + math.random() * 0.2
            star.Theta = math.random() * math.pi * 2
        end

        local px = cx + math.cos(star.Theta) * star.R * maxR
        local py = cy + math.sin(star.Theta) * star.R * maxR * 0.5
        star.Frame.Position = UDim2.fromOffset(px, py)

        local edgeFade = math.clamp((star.R - 0.09) / 0.3, 0, 1)
        local twinkle = 0.55 + 0.45 * math.sin(self.Time * star.Twinkle + star.Phase)
        local alpha = edgeFade * twinkle * 0.85 * intensity
        star.Frame.BackgroundTransparency = math.clamp(1 - alpha, 0, 1)

        local shrink = 0.4 + 0.6 * edgeFade
        local s = star.Size * shrink
        star.Frame.Size = UDim2.fromOffset(s, s)
        if recolor then
            star.Frame.BackgroundColor3 = starColor
        end
    end
end

function BlackHole:Rebuild()
    self:BuildDisk()
    self:BuildStars()
end

function BlackHole:SetRadius(radius)
    self.Radius = radius
    self:BuildDisk()
end

function BlackHole:Destroy()
    self.Destroyed = true
    if self.Animation then
        self.Animation:Stop()
    end
    if self.ThemeConnection then
        self.ThemeConnection:Disconnect()
    end
    if self.Root then
        self.Root:Destroy()
    end
end

