	local function defaultHint()
		local v = P.view
		if not v then return "" end
		if v.hint then return v.hint end
		if P.emptyNow then return "Aucun résultat" end
		if v.root then return "1-0 choisir · Tab filtre · / chercher" end
		return "1-0 choisir · Échap retour"
	end

	setHint = function(txt)
		if P.hint then P.hint.Text = txt or P.flashText or defaultHint() end
	end

	flash = function(text)
		P.flashText = text
		P.flashToken = (P.flashToken or 0) + 1
		local my = P.flashToken
		setHint(nil)
		task.delay(1.6, function()
			if P.flashToken == my then
				P.flashText = nil
				if P.open then setHint(nil) end
			end
		end)
	end

	local function resetQuery()
		P.query = ""
		P.settingText = true
		P.search.Text = ""
		P.settingText = false
	end

	render = function(anim, fly)
		local v = P.view
		if not (v and P.slots[1]) then return end
		local items = visibleItems(v)
		local pages = math.max(1, math.ceil(#items / PER))
		P.page = math.clamp(P.page, 1, pages)
		P.pages = pages
		P.emptyNow = (#items == 0) and not (v.input or v.capture)
		local base = (P.page - 1) * PER
		local animOn = Library.Animations
		for i = 1, PER do
			local it = items[base + i]
			local s = P.slots[i]
			P.shown[i] = it
			if it then
				local was = s.btn.Visible
				s.btn.Visible = true
				s.name.Text = it.Name
				s.sub.Text = it.Sub or ""
				s.name.TextColor3, s.sub.TextColor3 = T.Text, T.ElementAccent
				s.btn.BackgroundColor3 = it.Armed and Color3.fromRGB(110, 32, 38) or T.Second
				s.st.Color = it.Armed and Color3.fromRGB(255, 77, 94) or T.Accent
				s.st.Transparency = it.On and 0.3 or 0.7
				s.dot.Visible = it.On ~= nil
				s.dot.BackgroundColor3 = it.On and T.Accent or T.Off
				if it.Color then
					local c = it.Color
					s.badge.BackgroundColor3 = c
					s.badge.BackgroundTransparency = 0.05
					s.num.TextColor3 = ((c.R * 0.3 + c.G * 0.59 + c.B * 0.11) > 0.55) and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
				else
					s.badge.BackgroundColor3 = T.Accent
					s.badge.BackgroundTransparency = 0.88
					s.num.TextColor3 = T.Text
				end
				if anim then
					local d = animOn and (i - 1) * 0.018 or 0
					s.btn.Position = fly and UDim2.fromOffset(0, 0) or s.pos
					s.sc.Scale = 0.01
					task.delay(d, function()
						if not P.open then return end
						tween(s.sc, { Scale = 1 }, 0.4, BACK)
						if fly then tween(s.btn, { Position = s.pos }, 0.5, QUINT) end
					end)
				elseif not was then
					s.btn.Position = s.pos
					s.sc.Scale = 1
				end
			else
				s.btn.Visible = false
			end
		end
		local title = v.title or FILTERS[P.filter]
		if pages > 1 then title = title .. "  " .. P.page .. "/" .. pages end
		P.title.Text = title
		P.search.Visible = not v.capture
		P.search.PlaceholderText = v.input and v.input.placeholder or "Rechercher..."
		P.prev.Visible, P.next.Visible = pages > 1, pages > 1
		setHint(nil)
	end

	-- ───────────── Navigation ─────────────
	pushView = function(v)
		P.stack[#P.stack + 1] = P.view
		P.view = v
		P.page = 1
		resetQuery()
		if v.capture then Library._listening = true end
		render(true)
		if v.input then
			P.settingText = true
			P.search.Text = v.input.text or ""
			P.settingText = false
			task.delay(0.06, function()
				if P.open and P.view == v then P.search:CaptureFocus() end
			end)
		end
	end

	popView = function()
		if P.view and P.view.capture then Library._listening = false end
		if #P.stack == 0 then return end
		P.search:ReleaseFocus()
		P.view = table.remove(P.stack)
		P.page = 1
		resetQuery()
		render(true)
	end

	pick = function(i)
		local it = P.shown[i]
		if not (it and it.Run) then return end
		local ok, err = pcall(it.Run, shiftDown())
		if not ok then warn("[Ui-Lib] Palette : " .. tostring(err)) end
	end

	changePage = function(d)
		local v = P.view
		if not v or v.input or v.capture or P.pages <= 1 then return end
		P.page = ((P.page - 1 + d) % P.pages) + 1
		render(true)
	end

	cycleFilter = function(d)
		local v = P.view
		if not v or not v.root then return end
		P.filter = ((P.filter - 1 + d) % #FILTERS) + 1
		P.page = 1
		render(true)
	end

	focusSearch = function()
		local v = P.view
		if not v or v.input or v.capture then return end
		P.focusAt = os.clock()
		task.defer(function()
			if P.open then P.search:CaptureFocus() end
		end)
	end

	escape = function()
		if os.clock() - (P.lastEsc or 0) < 0.15 then return end
		P.lastEsc = os.clock()
		local v = P.view
		if v and (v.input or v.capture or #P.stack > 0) then
			popView()
		elseif P.query ~= "" then
			P.search:ReleaseFocus()
			resetQuery()
			P.page = 1
			render(false)
		else
			Library:ClosePalette()
		end
	end

	local function casHandler(_, state, input)
		if not P.open then return PASS end
		local ut, kc = input.UserInputType, input.KeyCode
		if ut == Enum.UserInputType.MouseWheel then
			changePage(input.Position.Z > 0 and -1 or 1)
			return SINK
		end
		if state ~= Enum.UserInputState.Begin then return SINK end
		if P.view and P.view.capture then
			if kc == KC.Escape then escape() return SINK end
			return PASS
		end
		local n = DIGIT[kc]
		if n then
			pick(n)
		elseif kc == KC.Tab then
			cycleFilter(shiftDown() and -1 or 1)
		elseif kc == KC.Left then
			changePage(-1)
		elseif kc == KC.Right then
			changePage(1)
		elseif kc == KC.Backspace then
			if #P.stack > 0 then popView() end
		elseif kc == KC.Slash then
			focusSearch()
		elseif kc == KC.Escape then
			escape()
		end
		return SINK
	end

	-- ───────────── Ouverture / fermeture ─────────────
	local function stopSpin()
		for _, tw in ipairs(seqSpin) do pcall(function() tw:Cancel() end) end
		table.clear(seqSpin)
	end

	function Library:OpenPalette()
		if P.open or not Library.PaletteEnabled then return end
		buildGui()
		P.open = true
		uiSnd("palopen")
		P.stack = {}
		P.filter = P.filter or 1
		P.view = rootView()
		P.page = 1
		P.armedKey = nil
		P.flashText = nil
		P.gui.Enabled = true
		applyColors()
		resetQuery()

		local vp = viewport()
		P.rootScale.Scale = math.clamp(math.min((vp.Y - 30) / 480, (vp.X - 30) / 560), 0.5, 1.15)

		P.dim.BackgroundTransparency = 1
		tween(P.dim, { BackgroundTransparency = 0.45 }, 0.3)
		if (Library.BlurSize or 0) > 0 then pcall(setBlurTarget, Library.BlurSize * 0.7) end

		P.coreScale.Scale = 0
		tween(P.coreScale, { Scale = 1 }, 0.55, BACK)

		stopSpin()
		P.g1.Rotation, P.g2.Rotation, P.g3.Rotation = 0, 0, 0
		seqSpin[1] = TweenService:Create(P.g1, TweenInfo.new(7, LINEAR, OUT, -1), { Rotation = 360 })
		seqSpin[2] = TweenService:Create(P.g2, TweenInfo.new(11, LINEAR, OUT, -1), { Rotation = -360 })
		seqSpin[3] = TweenService:Create(P.g3, TweenInfo.new(4.5, LINEAR, OUT, -1), { Rotation = 360 })
		for _, tw in ipairs(seqSpin) do tw:Play() end

		-- on bloque les touches du jeu (chiffres, Tab, flèches, molette...) et on garde le curseur libre
		pcall(function() CAS:BindActionAtPriority("UiLibPalette", casHandler, false, 3000, table.unpack(CAS_KEYS)) end)
		pcall(function()
			RunService:BindToRenderStep("UiLibPaletteMouse", Enum.RenderPriority.Camera.Value + 10, function()
				UIS.MouseBehavior = Enum.MouseBehavior.Default
				UIS.MouseIconEnabled = true
			end)
		end)

		render(true, true)
	end

	function Library:ClosePalette()
		if not P.open then return end
		P.open = false
		uiSnd("palclose")
		pcall(function() CAS:UnbindAction("UiLibPalette") end)
		pcall(function() RunService:UnbindFromRenderStep("UiLibPaletteMouse") end)
		if P.view and P.view.capture then Library._listening = false end
		P.typing = false
		if P.search then P.search:ReleaseFocus() end
		stopSpin()

		-- tout est aspiré vers le centre
		for i, s in ipairs(P.slots) do
			if s.btn.Visible then
				local d = Library.Animations and (i - 1) * 0.012 or 0
				task.delay(d, function()
					if P.open then return end
					tween(s.btn, { Position = UDim2.fromOffset(0, 0) }, 0.3, QUINT, IN)
					tween(s.sc, { Scale = 0 }, 0.3, QUINT, IN)
				end)
			end
		end
		task.delay(0.12, function()
			if not P.open then tween(P.coreScale, { Scale = 0 }, 0.3, QUINT, IN) end
		end)
		tween(P.dim, { BackgroundTransparency = 1 }, 0.35)
		local w = Library.Window
		pcall(setBlurTarget, (w and w.Open) and Library.BlurSize or 0)
		task.delay(0.5 / math.max(Library.AnimSpeed or 1, 0.05), function()
			if not P.open and P.gui then P.gui.Enabled = false end
		end)
	end

	function Library:TogglePalette()
		if P.open then Library:ClosePalette() else Library:OpenPalette() end
	end
	function Library:IsPaletteOpen() return P.open end
	function Library:SetPaletteEnabled(v)
		Library.PaletteEnabled = v and true or false
		if not Library.PaletteEnabled then Library:ClosePalette() end
	end
	function Library:SetPaletteKey(key, needCtrl)
		if typeof(key) == "EnumItem" then Library.PaletteKey = key end
		if needCtrl ~= nil then Library.PaletteNeedCtrl = needCtrl and true or false end
	end

	track(UIS.InputBegan:Connect(function(i, processed)
		if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local kc = i.KeyCode
		if P.open then
			local capturing = P.view and P.view.capture
			if kc == Library.PaletteKey and not capturing and (not Library.PaletteNeedCtrl or ctrlDown())
				and not (P.typing and not ctrlDown()) then
				Library:ClosePalette()
				return
			end
			if capturing then
				if kc ~= KC.Escape then
					local cap = P.view.capture
					popView()
					cap(kc)
				end
				return
			end
			if kc == KC.Escape then escape() end
			return
		end
		if processed or Library._listening or not Library.PaletteEnabled then return end
		if kc == Library.PaletteKey and (not Library.PaletteNeedCtrl or ctrlDown()) then
			Library:OpenPalette()
		end
	end))

	-- nettoyage complet (Library:Destroy)
	Library._destroyPalette = function()
		P.open = false
		pcall(function() CAS:UnbindAction("UiLibPalette") end)
		pcall(function() RunService:UnbindFromRenderStep("UiLibPaletteMouse") end)
		stopSpin()
		if P.gui then pcall(function() P.gui:Destroy() end) end
		P.gui, P.slots, P.shown, P.stack, P.view = nil, {}, {}, {}, nil
	end
end)(...)

-- ============================================================================
-- V7 : BARRE DE RECHERCHE « TROU NOIR »  (Ctrl+T)
--   Une barre de recherche façon Google / Spotlight au milieu de l'écran, SANS la fenêtre : juste le fond noir,
--   un trou noir et des étoiles qui spiralent vers lui. En tapant, les résultats apparaissent avec leurs vrais
--   contrôles (interrupteur, curseur, bouton, liste, champ, couleur, touche) que tu règles directement.
--     Ctrl+T : ouvrir / fermer   ·   Entrée : lance / bascule le premier résultat   ·   Échap : efface puis ferme
--   API : Library:OpenSpotlight() / CloseSpotlight() / ToggleSpotlight() / SetSpotlightEnabled(v) /
--         SetSpotlightKey(KeyCode, needCtrl)
--   Options : Library.SpotlightStars (0-140) / SpotlightMax (3-14) / SpotlightHideWindow / SpotlightNeedCtrl / SpotlightKey
--   Les éléments { Palette = false } sont exclus (comme dans la palette Ctrl+K).
-- ============================================================================
local spotOk, spotErr = pcall(function()
	local CAS = game:GetService("ContextActionService")
	local KC = Enum.KeyCode
	local SINK, PASS = Enum.ContextActionResult.Sink, Enum.ContextActionResult.Pass
	local IN = Enum.EasingDirection.In

	Library.SpotlightEnabled    = true
	Library.SpotlightNeedCtrl   = true
	Library.SpotlightKey        = KC.T
	Library.SpotlightStars      = 70
	Library.SpotlightHideWindow = true
	Library.SpotlightMax        = 8

	local S = { open = false, rows = {}, recent = {} }
	local BUILD = {}
	local PRESET_COLORS = {
		Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 77, 94), Color3.fromRGB(255, 150, 60),
		Color3.fromRGB(255, 214, 80), Color3.fromRGB(61, 220, 151), Color3.fromRGB(80, 220, 235),
		Color3.fromRGB(80, 130, 255), Color3.fromRGB(160, 100, 255), Color3.fromRGB(255, 110, 200),
	}

	-- ───────────── Outils ─────────────
	local function low(s)
		if s == nil then return "" end
		return string.lower(tostring(s))
	end
	local function ctrlDown() return UIS:IsKeyDown(KC.LeftControl) or UIS:IsKeyDown(KC.RightControl) end
	local function safeGet(it)
		if type(it) ~= "table" or type(it.Get) ~= "function" then return nil end
		local ok, v = pcall(it.Get)
		if ok then return v end
		return nil
	end
	local function pathOf(e)
		local t, b = tostring(e.Tab or ""), tostring(e.Block or "")
		if t ~= "" and b ~= "" and t ~= b then return t .. "  ·  " .. b end
		return (t ~= "") and t or b
	end
	local function remember(e)
		if not (e and e.Key) then return end
		for i = #S.recent, 1, -1 do
			if S.recent[i] == e.Key then table.remove(S.recent, i) end
		end
		table.insert(S.recent, 1, e.Key)
		while #S.recent > 6 do table.remove(S.recent) end
	end

	-- ───────────── Contenu : éléments de l'interface + commandes intégrées ─────────────
	local function builtins()
		return {
			{ Kind = "Action", Name = "Ouvrir l'interface", Tab = "Spotlight", Block = "Interface",
				Extra = "fenêtre menu afficher ui", Opts = { Callback = function()
					S.openAfter = true
					Library:CloseSpotlight()
				end } },
			{ Kind = "Action", Name = "Ouvrir la palette de commandes", Tab = "Spotlight", Block = "Interface",
				Extra = "ctrl k roue", Opts = { Callback = function()
					Library:CloseSpotlight()
					task.delay(0.4, function() Library:OpenPalette() end)
				end } },
			{ Kind = "Action", Name = "Recentrer la fenêtre", Tab = "Spotlight", Block = "Interface",
				Extra = "reset position", Opts = { Callback = function()
					local w = Library.Window
					if w and w.Reset then w:Reset() end
				end } },
			{ Kind = "Action", Name = "Notifications : tout fermer", Tab = "Spotlight", Block = "Notifications",
				Extra = "effacer vider", Opts = { Callback = function() Library:ClearNotifications() end } },
		}
	end

	local function allEntries()
		local list, keep = {}, {}
		for _, e in pairs(Library.CmdEntries) do
			if e.Frame and e.Frame.Parent then list[#list + 1] = e end
		end
		table.sort(list, function(a, b) return (a.Seq or 0) < (b.Seq or 0) end)
		for _, t in ipairs(Library.TxtEntries) do
			if t.Frame and t.Frame.Parent then
				keep[#keep + 1] = t
				local ok, ti, co = pcall(t.Get)
				if ok then
					ti, co = tostring(ti or ""), tostring(co or "")
					t.TitleText, t.BodyText = ti, co
					t.Name = (ti ~= "") and ti or co
					t.Extra = co
					list[#list + 1] = t
				end
			end
		end
		Library.TxtEntries = keep
		return list
	end

	local function scoreOf(e, q, words)
		local n = low(e.Name)
		local hay = n .. " " .. low(e.Tab) .. " " .. low(e.Block) .. " " .. low(e.Extra)
		for _, w in ipairs(words) do
			if not string.find(hay, w, 1, true) then return 0 end
		end
		local s = 1
		local at = string.find(n, q, 1, true)
		if at == 1 then s = 4
		elseif at then s = 3
		elseif string.find(n, words[1], 1, true) then s = 2 end
		if e.Kind == "Text" then s = s - 0.5 end
		if e.Key and Library.Favorites[e.Key] then s = s + 0.25 end
		return s
	end

	local function results(query)
		local max = math.clamp(math.floor(tonumber(Library.SpotlightMax) or 8), 3, 14)
		local q = string.match(low(query), "^%s*(.-)%s*$") or ""
		local list = allEntries()
		local out = {}
		if q == "" then
			local seen = {}
			for _, key in ipairs(S.recent) do
				local e = Library.CmdEntries[key]
				if e and e.Frame and e.Frame.Parent and not seen[key] then
					seen[key] = true
					out[#out + 1] = e
				end
			end
			for _, e in ipairs(list) do
				if #out >= max then break end
				if e.Key and e.Kind ~= "Text" and Library.Favorites[e.Key] and not seen[e.Key] then
					seen[e.Key] = true
					out[#out + 1] = e
				end
			end
			while #out > max do table.remove(out) end
			if #out == 0 then
				for _, b in ipairs(builtins()) do
					if #out < max then out[#out + 1] = b end
				end
				return out, "Suggestions  ·  tape pour chercher un réglage, un bouton, une couleur..."
			end
			return out, "Récents et favoris"
		end
		for _, b in ipairs(builtins()) do list[#list + 1] = b end
		local words = {}
		for w in string.gmatch(q, "%S+") do words[#words + 1] = w end
		local scored = {}
		for idx, e in ipairs(list) do
			local s = scoreOf(e, q, words)
			if s > 0 then scored[#scored + 1] = { e = e, s = s, i = idx } end
		end
		table.sort(scored, function(a, b)
			if a.s ~= b.s then return a.s > b.s end
			return a.i < b.i
		end)
		local total = #scored
		for i = 1, math.min(total, max) do out[i] = scored[i].e end
		local cap
		if total == 0 then
			cap = "Aucun résultat pour « " .. q .. " »"
		elseif total > #out then
			cap = #out .. " sur " .. total .. " résultats  ·  affine ta recherche"
		else
			cap = total .. ((total == 1) and " résultat" or " résultats")
		end
		return out, cap
	end

	-- ───────────── Cartes de résultats ─────────────
	local function newCard(parent, order)
		local f = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, BackgroundColor3 = T.Second,
			BackgroundTransparency = 0.1, BorderSizePixel = 0, LayoutOrder = order, Active = true }, parent)
		new("UICorner", { CornerRadius = UDim.new(0, 14) }, f)
		local st = new("UIStroke", { Color = T.Accent, Thickness = 1, Transparency = 0.86, ApplyStrokeMode = BORDER }, f)
		new("UIListLayout", { SortOrder = BYORDER }, f)
		local sc = new("UIScale", { Scale = 0 }, f)
		return f, st, sc
	end

	local function newHeader(f, e, rw)
		local hdr = new("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, LayoutOrder = 1 }, f)
		label(hdr, e.Name, 13, { Position = UDim2.new(0, 16, 0, 8), Size = UDim2.new(1, -(rw + 32), 0, 18), Font = F_BOLD })
		label(hdr, pathOf(e), 10, { Position = UDim2.new(0, 16, 0, 27), Size = UDim2.new(1, -(rw + 32), 0, 14),
			TextColor3 = T.ElementAccent })
