-- ════════════════════════════════════════════════════════════════════════
--  "Ui" API compatibility layer
--  Lets scripts written for the "Ui" library run on Singularity unchanged:
--
--      local Window = Library:CreateWindow({ Title = "My UI", ToggleKey = Enum.KeyCode.RightControl })
--      local Tab, Activate = Window:CreateTab("Main", true, "rbxassetid://123")   -- (name, twoColumn, icon, internal, tooltip)
--      local Block = Tab:CreateBlock({ Name = "Combat", Side = "Left" })           -- Side = "Left" | "Right"
--      Block:CreateToggle({ Name = "Aimbot", Flag = "Aimbot", Default = false, Callback = function(v) end })
--      Block:CreateSlider({ Name = "FOV", Min = 0, Max = 120, Decimals = 0, Suffix = "°", Default = 60, Callback = function(v) end })
--      Block:CreateDropdown({ Name = "Mode", Items = { "A", "B" }, Multi = false, Default = "A", Callback = function(v) end })
--      Block:CreateColorPicker({ Name = "Color", Default = Color3.new(1, 0, 0), Callback = function(c) end })
--      Block:CreateKeybind({ Name = "Panic", Default = Enum.KeyCode.K, Callback = function(key) end })
--      Block:CreateInput({ Name = "Name", Placeholder = "Type...", Callback = function(text) end })
--      Block:CreateButton({ Name = "Run", Callback = function() end })
--      Block:CreateLabel({ Text = "Hello" }) / CreateParagraph / CreateDivider / CreateSection / CreateProgressBar
--      Library:Notify({ Title = "Hi", Content = "Text", Duration = 3, Type = "Success" })
--      Library.Flags.Aimbot  /  Library.Items.Aimbot.Set(true)
--
--  The native Singularity API (AddTab, AddLeftGroupbox, AddToggle, ...) keeps
--  working exactly as before. Both APIs can be mixed freely.
-- ════════════════════════════════════════════════════════════════════════

do
    Library.Flags = Library.Flags or {}
    Library.Items = Library.Items or {}
    Library.ToggleKey = Library.ToggleKeybind
    Library.ConfigFolder = Library.ConfigFolder or SaveManager.Folder
    Library.Synonyms = Library.Synonyms or {}
    Library.UiApi = true

    local autoCount = 0
    local function autoFlag(prefix)
        autoCount = autoCount + 1
        return "Ui" .. prefix .. autoCount
    end

    local function copyTable(source)
        local out = {}
        for key, value in pairs(source or {}) do
            out[key] = value
        end
        return out
    end

    local function tipOf(cfg)
        return cfg.Tooltip or cfg.Description
    end

    -- "Ui" elements return plain functions (obj.Set(v)); accept obj:Set(v) as well.
    local function dual(api, fn)
        return function(first, ...)
            if first == api then
                return fn(...)
            end
            return fn(first, ...)
        end
    end

    local function makeApi(element, setFn, getFn)
        local api = { Element = element }
        api.Set = dual(api, setFn)
        api.Get = dual(api, getFn)
        return api
    end

    local function registerItem(flag, api)
        Library.Items[flag] = { Set = api.Set, Get = api.Get }
    end

    local function normalizeIcon(icon)
        if type(icon) == "string" and icon:match("^%d+$") then
            return tonumber(icon)
        end
        return icon
    end

    -- ── Notifications: Content / Duration aliases ─────────────────────────
    local OriginalNotify = Library.Notify

    function Library:Notify(info, time)
        if type(info) == "table" then
            info = copyTable(info)
            if info.Description == nil and info.Content ~= nil then
                info.Description = tostring(info.Content)
            end
            if info.Time == nil and info.Duration ~= nil then
                info.Time = info.Duration
            end
            if info.Type == nil then
                local title = string.lower(tostring(info.Title or ""))
                if title:find("error") or title:find("erreur") then
                    info.Type = "Error"
                elseif title:find("success") or title:find("saved") or title:find("loaded")
                    or title:find("exported") or title:find("imported") then
                    info.Type = "Success"
                end
            end
        end
        return OriginalNotify(self, info, time)
    end

    -- ── Tooltips: AddTooltip(obj, text) order + SetTooltipsEnabled ───────
    local OriginalAddTooltip = Library.AddTooltip
    local tooltipList = setmetatable({}, { __mode = "k" })
    Library.TooltipsEnabled = true

    function Library:AddTooltip(first, second)
        if typeof(first) == "Instance" and type(second) == "string" then
            first, second = second, first
        end
        local tooltip = OriginalAddTooltip(self, first, second)
        if tooltip then
            tooltip.Disabled = not Library.TooltipsEnabled
            tooltipList[tooltip] = true
        end
        return tooltip
    end

    function Library:SetTooltipsEnabled(state)
        Library.TooltipsEnabled = state and true or false
        for tooltip in pairs(tooltipList) do
            tooltip.Disabled = not Library.TooltipsEnabled
        end
        if not Library.TooltipsEnabled then
            Library.TooltipText = nil
        end
    end

    -- ── Misc Library functions ───────────────────────────────────────────
    function Library:Destroy()
        self:Unload()
        self.Flags = {}
        self.Items = {}
    end

    function Library:SetKeybindHud(visible)
        self:SetKeybindListVisibility(visible and true or false)
    end

    function Library:FocusSearch()
        self:OpenSpotlight()
    end

    function Library:OpenSearch(text)
        self:OpenSpotlight()
        if type(text) == "string" and text ~= "" then
            task.delay(0.12, function()
                local spotlight = Library.Spotlight
                if spotlight and spotlight.Open and spotlight.Box then
                    spotlight.Box.Text = text
                end
            end)
        end
    end

    function Library:AddSynonym(word, list)
        self.Synonyms[string.lower(tostring(word))] = list
    end

    function Library:GetKeybindEntries()
        local list = { { Name = "Quick Search", Key = "Ctrl + F", Static = true } }
        for flag, picker in pairs(self.KeybindToggles or {}) do
            table.insert(list, {
                Name = picker.DisplayText or picker.Text or flag,
                Key = self:ShortKeyName(picker.Value),
                Raw = picker.Value,
                Flag = flag,
            })
        end
        table.sort(list, function(a, b)
            if (a.Static or false) ~= (b.Static or false) then
                return a.Static == true
            end
            return tostring(a.Name):lower() < tostring(b.Name):lower()
        end)
        return list
    end

    -- ── Configs (Ui names, stored by the Singularity SaveManager) ────────
    local function collectFlags()
        local out = {}
        for flag, value in pairs(Library.Flags) do
            if type(flag) == "string" and flag:sub(1, 9) ~= "Settings_" then
                out[flag] = value
            end
        end
        return out
    end

    function Library:GetConfigs()
        return SaveManager:RefreshConfigList()
    end

    function Library:GetThemes()
        return ThemeManager:GetCustomThemeNames()
    end

    function Library:SaveConfig(name)
        local ok, err = SaveManager:Save(name)
        if ok then
            self:Notify({ Title = "Config Saved", Content = "Successfully saved " .. tostring(name), Duration = 3 })
        else
            self:Notify({ Title = "Config Error", Content = tostring(err), Duration = 4, Type = "Error" })
        end
        return ok
    end

    function Library:LoadConfig(name)
        local ok, err = SaveManager:Load(name)
        if ok then
            self:Notify({ Title = "Config Loaded", Content = "Successfully loaded " .. tostring(name), Duration = 3 })
        else
            self:Notify({ Title = "Config Error", Content = tostring(err), Duration = 4, Type = "Error" })
        end
        return ok
    end

    function Library:DeleteConfig(name)
        local ok = SaveManager:Delete(name)
        if ok then
            self:Notify({ Title = "Config Deleted", Content = "Deleted " .. tostring(name), Duration = 3 })
        end
        return ok
    end

    function Library:ExportConfig()
        local window = self.CurrentWindow
        local str = HttpService:JSONEncode({
            _type = "config",
            title = window and window.Title or "",
            flags = collectFlags(),
        })
        if self:CopyToClipboard(str) then
            self:Notify({ Title = "Config Exported", Content = "Copied to clipboard (" .. #str .. " chars)", Type = "Success" })
        else
            warn("[Export] Clipboard unavailable. Config string:\n" .. str)
            self:Notify({ Title = "Export", Content = "Clipboard unavailable, string printed in console", Type = "Warning", Duration = 5 })
        end
        return str
    end

    function Library:ImportConfig(str, saveAs)
        local ok, data = pcall(function()
            return HttpService:JSONDecode(str)
        end)
        if not ok or type(data) ~= "table" then
            self:Notify({ Title = "Import Error", Content = "Invalid config data", Type = "Error" })
            return false
        end
        local flags = type(data.flags) == "table" and data.flags or data
        for flag, value in pairs(flags) do
            local item = type(flag) == "string" and Library.Items[flag]
            if item and flag:sub(1, 9) ~= "Settings_" then
                task.spawn(function()
                    local setOk, err = pcall(item.Set, value)
                    if not setOk then
                        warn("[Import] " .. flag .. ": " .. tostring(err))
                    end
                end)
            end
        end
        if type(saveAs) == "string" and saveAs ~= "" then
            task.delay(0.4, function()
                SaveManager:Save(saveAs)
            end)
        end
        self:Notify({ Title = "Config Imported", Content = "Config applied", Type = "Success" })
        return true
    end

    -- ════════════════════════════════════════════════════════════════════
    --  Elements (added to BaseFuncs: groupboxes, tabbox tabs, dependency boxes)
    -- ════════════════════════════════════════════════════════════════════

    function BaseFuncs:CreateSection(text)
        return self:AddLabel({ Text = "<b>" .. tostring(text or "") .. "</b>" })
    end

    function BaseFuncs:CreateDivider(cfg)
        if type(cfg) ~= "table" then
            cfg = { Text = cfg }
        end
        local text = cfg.Text ~= nil and tostring(cfg.Text) or ""
        return self:AddDivider(text ~= "" and text or nil)
    end

    function BaseFuncs:CreateLabel(cfg)
        if type(cfg) ~= "table" then
            cfg = { Text = cfg }
        end
        local label = self:AddLabel({
            Text = tostring(cfg.Text or cfg.Name or "Label"),
            DoesWrap = true,
            Alignment = cfg.Centered and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
            Muted = cfg.TextColor == nil,
            Tooltip = tipOf(cfg),
        })
        if cfg.TextSize then
            label.TextLabel.TextSize = cfg.TextSize
        end
        if cfg.TextColor then
            label:SetColor(cfg.TextColor)
        end
        local api = { Element = label }
        api.SetText = dual(api, function(text)
            label:SetText(tostring(text))
        end)
        api.SetColor = dual(api, function(color)
            label:SetColor(color)
        end)
        return api
    end

    function BaseFuncs:CreateParagraph(cfg)
        cfg = cfg or {}
        local rich = cfg.RichText ~= false
        local function escape(text)
            if rich then
                return text
            end
            return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
        end

        local title = tostring(cfg.Title or cfg.Name or "")
        local content = tostring(cfg.Content or cfg.Text or "")
        local titleLabel
        if title ~= "" then
            titleLabel = self:AddLabel({
                Text = "<b>" .. escape(title) .. "</b>",
                DoesWrap = true,
                Tooltip = tipOf(cfg),
            })
        end
        local contentLabel = self:AddLabel({ Text = escape(content), DoesWrap = true, Muted = true })

        local api = { Element = contentLabel, TitleElement = titleLabel }
        api.SetTitle = dual(api, function(text)
            if titleLabel then
                titleLabel:SetText("<b>" .. escape(tostring(text)) .. "</b>")
            end
        end)
        api.SetContent = dual(api, function(text)
            contentLabel:SetText(escape(tostring(text)))
        end)
        return api
    end

    function BaseFuncs:CreateButton(cfg)
        cfg = cfg or {}
        local callback = cfg.Callback
        return self:AddButton({
            Text = cfg.Name or "Button",
            Func = function()
                if callback then
                    callback()
                end
            end,
            Tooltip = tipOf(cfg),
        })
    end

    function BaseFuncs:CreateToggle(cfg)
        cfg = cfg or {}
        local flag = cfg.Flag or cfg.Name or autoFlag("Toggle")
        local callback = cfg.Callback
        local toggle = self:AddToggle(flag, {
            Text = cfg.Name or "Toggle",
            Default = cfg.Default and true or false,
            Tooltip = tipOf(cfg),
            Callback = function(value)
                Library.Flags[flag] = value
                if callback then
                    callback(value)
                end
            end,
        })
        Library.Flags[flag] = toggle.Value
        toggle:OnChanged(function(value)
            Library.Flags[flag] = value
        end)

        local api = makeApi(toggle, function(value)
            if value ~= nil then
                toggle:SetValue(value)
            end
        end, function()
            return toggle.Value
        end)
        registerItem(flag, api)

        if cfg.Default and callback then
            Library:SafeCallback(callback, true)
        end
        return api
    end

    function BaseFuncs:CreateSlider(cfg)
        cfg = cfg or {}
        local flag = cfg.Flag or cfg.Name or autoFlag("Slider")
        local callback = cfg.Callback

        local decimals = cfg.Decimals
        if decimals == nil then
            decimals = 0
            if cfg.Step then
                local fraction = tostring(cfg.Step):match("%.(%d+)")
                decimals = fraction and #fraction or 0
            end
        end
        decimals = math.clamp(decimals, 0, 6)

        local slider = self:AddSlider(flag, {
            Text = cfg.Name or "Slider",
            Min = cfg.Min or 0,
            Max = cfg.Max or 100,
            Default = cfg.Default,
            Rounding = decimals,
            Step = cfg.Step,
            Suffix = cfg.Suffix or "",
            Tooltip = tipOf(cfg),
            Callback = function(value)
                Library.Flags[flag] = value
                if callback then
                    callback(value)
                end
            end,
        })
        Library.Flags[flag] = slider.Value
        slider:OnChanged(function(value)
            Library.Flags[flag] = value
        end)

        local api = makeApi(slider, function(value)
            if type(value) == "number" then
                slider:SetValue(value)
            end
        end, function()
            return slider.Value
        end)
        registerItem(flag, api)

        if callback then
            Library:SafeCallback(callback, slider.Value)
        end
        return api
    end

    function BaseFuncs:CreateInput(cfg)
        cfg = cfg or {}
        local flag = cfg.Flag or cfg.Name or autoFlag("Input")
        local callback = cfg.Callback

        local input = self:AddInput(flag, {
            Text = cfg.Name,
            Default = cfg.Default,
            Placeholder = cfg.Placeholder or "Type...",
            Finished = true,
            Tooltip = tipOf(cfg),
            Callback = function(text)
                Library.Flags[flag] = text
                if callback then
                    callback(text)
                end
            end,
        })
        Library.Flags[flag] = input.Value
        input:OnChanged(function(text)
            Library.Flags[flag] = text
        end)

        local api = makeApi(input, function(text)
            input:SetValue(text or "")
        end, function()
            return input.Value
        end)
        registerItem(flag, api)

        if cfg.Default and callback then
            task.spawn(callback, cfg.Default)
        end
        return api
    end

    function BaseFuncs:CreateDropdown(cfg)
        cfg = cfg or {}
        local flag = cfg.Flag or cfg.Name or autoFlag("Dropdown")
        local callback = cfg.Callback
        local values = cfg.Items or {}
        local dropdown

        local function currentValue()
            if dropdown.Multi then
                return dropdown:GetActiveValues()
            end
            return dropdown.Value
        end

        local searchable = cfg.Search
        if searchable == nil then
            searchable = #values > 8
        end

        dropdown = self:AddDropdown(flag, {
            Text = cfg.Name,
            Values = values,
            Multi = cfg.Multi == true,
            Default = cfg.Default,
            Searchable = searchable and true or false,
            AllowNull = cfg.AllowNull,
            MaxVisibleDropdownItems = cfg.MaxHeight and math.max(3, math.floor(cfg.MaxHeight / 22)) or nil,
            Tooltip = tipOf(cfg),
            Callback = function()
                local value = currentValue()
                Library.Flags[flag] = value
                if callback then
                    callback(value)
                end
            end,
        })
        Library.Flags[flag] = currentValue()
        dropdown:OnChanged(function()
            Library.Flags[flag] = currentValue()
        end)

        if cfg.UpdateList then
            dropdown.Button.MouseButton1Click:Connect(function()
                local ok, list = pcall(cfg.UpdateList)
                if ok and type(list) == "table" then
                    dropdown:SetValues(list)
                end
            end)
        end

        local api = makeApi(dropdown, function(value)
            dropdown:SetValue(value)
        end, currentValue)
        api.Refresh = dual(api, function(list)
            if type(list) == "table" then
                dropdown:SetValues(list)
            end
        end)
        registerItem(flag, api)

        if cfg.Default ~= nil and callback then
            Library:SafeCallback(callback, currentValue())
        end
        return api
    end

    function BaseFuncs:CreateColorPicker(cfg)
        cfg = cfg or {}
        local flag = cfg.Flag or cfg.Name or autoFlag("Color")
        local callback = cfg.Callback
        local color = cfg.Default or Color3.fromRGB(255, 255, 255)

        local label = self:AddLabel({ Text = cfg.Name or "Color", Tooltip = tipOf(cfg) })
        label:AddColorPicker(flag, {
            Default = color,
            Title = cfg.Name or "Color",
            Callback = function(value)
                Library.Flags[flag] = { R = value.R, G = value.G, B = value.B }
                if callback then
                    callback(value)
                end
            end,
        })
        local picker = Library.Options[flag]
        Library.Flags[flag] = { R = color.R, G = color.G, B = color.B }

        local api = makeApi(picker, function(value)
            if type(value) == "table" then
                picker:SetValueRGB(Color3.new(value.R or 0, value.G or 0, value.B or 0))
            elseif typeof(value) == "Color3" then
                picker:SetValueRGB(value)
            end
        end, function()
            return picker.Value
        end)
        registerItem(flag, api)
        return api
    end

    function BaseFuncs:CreateKeybind(cfg)
        cfg = cfg or {}
        local flag = cfg.Flag or cfg.Name or autoFlag("Keybind")
        local callback = cfg.Callback
        local default = cfg.Default or Enum.KeyCode.RightControl
        local defaultName = typeof(default) == "EnumItem" and default.Name or tostring(default)

        local label = self:AddLabel({ Text = cfg.Name or "Keybind", Tooltip = tipOf(cfg) })
        label:AddKeyPicker(flag, {
            Default = defaultName,
            Text = cfg.Name or flag,
            Mode = "Toggle",
        })
        local picker = Library.Options[flag]
        Library.Flags[flag] = picker.Value

        picker:OnChanged(function(key)
            Library.Flags[flag] = key
        end)
        picker:OnClick(function()
            if not callback then
                return
            end
            local ok, keyCode = pcall(function()
                return Enum.KeyCode[picker.Value]
            end)
            if ok and keyCode then
                Library:SafeCallback(callback, keyCode)
            end
        end)

        local api = makeApi(picker, function(keyName)
            if typeof(keyName) == "EnumItem" then
                keyName = keyName.Name
            end
            if type(keyName) == "string" then
                picker:SetValue({ keyName })
            end
        end, function()
            return picker.Value
        end)
        registerItem(flag, api)
        return api
    end

    -- Ui shows a live list of all keybinds; Singularity has a global keybind list, so this
    -- adds a switch that shows / hides it.
    function BaseFuncs:CreateKeybindList(cfg)
        cfg = cfg or {}
        local visible = Library.KeybindFrame and Library.KeybindFrame.Visible or false
        return self:CreateToggle({
            Name = cfg.Name or "Keybind list",
            Flag = cfg.Flag or "UiKeybindList",
            Default = visible,
            Tooltip = tipOf(cfg),
            Callback = function(value)
                Library:SetKeybindListVisibility(value)
            end,
        })
    end

    function BaseFuncs:CreateProgressBar(cfg)
        cfg = cfg or {}
        local progress = self:AddProgress(cfg.Flag, {
            Text = cfg.Name,
            Min = cfg.Min or 0,
            Max = cfg.Max or 100,
            Default = cfg.Default,
            Suffix = cfg.Suffix or "",
            Percent = cfg.Suffix == nil or cfg.Suffix == "%",
        })

        local token = 0
        local api = makeApi(progress, function(value)
            if type(value) ~= "number" then
                return
            end
            token = token + 1
            progress:SetValue(value)
        end, function()
            return progress.Value
        end)
        api.SetIndeterminate = dual(api, function(state)
            token = token + 1
            if not state then
                return
            end
            local mine = token
            task.spawn(function()
                local ratio, direction = 0, 1
                while token == mine and not Library.Unloaded do
                    ratio = ratio + direction * 0.04
                    if ratio >= 1 or ratio <= 0 then
                        ratio = math.clamp(ratio, 0, 1)
                        direction = -direction
                    end
                    progress.Value = progress.Min + (progress.Max - progress.Min) * ratio
                    progress:Display()
                    task.wait(0.03)
                end
            end)
        end)
        if cfg.Indeterminate then
            api.SetIndeterminate(true)
        end
        return api
    end

    -- ════════════════════════════════════════════════════════════════════
    --  Window: CreateTab / CreateBlock, CreateWindow settings, KeySystem
    -- ════════════════════════════════════════════════════════════════════

    local ELEMENT_FUNCTIONS = {
        "CreateSection", "CreateLabel", "CreateButton", "CreateToggle", "CreateSlider",
        "CreateInput", "CreateDropdown", "CreateColorPicker", "CreateKeybind",
        "CreateKeybindList", "CreateParagraph", "CreateDivider", "CreateProgressBar",
    }

    local function attachUiTabApi(tab, tabName)
        -- Elements created straight on the tab go into one default groupbox (left column).
        function tab:GetDefaultGroupbox()
            if not self.DefaultGroupbox then
                self.DefaultGroupbox = self:AddLeftGroupbox(tabName)
            end
            return self.DefaultGroupbox
        end

        for _, functionName in ipairs(ELEMENT_FUNCTIONS) do
            tab[functionName] = function(self, ...)
                local groupbox = self:GetDefaultGroupbox()
                return groupbox[functionName](groupbox, ...)
            end
        end

        function tab:CreateBlock(cfg)
            cfg = cfg or {}
            local name = cfg.Name or "Block"
            local icon = normalizeIcon(cfg.ImageID)
            local groupbox
            if cfg.Side == "Right" or cfg.Side == 2 then
                groupbox = self:AddRightGroupbox(name, icon)
            else
                groupbox = self:AddLeftGroupbox(name, icon)
            end
            if tipOf(cfg) then
                Library:AddTooltip(tipOf(cfg), groupbox.Header)
            end
            return groupbox
        end
    end

    local OriginalCreateWindow = Library.CreateWindow

    function Library:CreateWindow(settings)
        local info = copyTable(settings)

        if info.ToggleKey and not info.ToggleKeybind then
            info.ToggleKeybind = info.ToggleKey
        end
        if info.CustomIcon and not info.Icon then
            info.Icon = info.CustomIcon
        end
        -- Ui themes use other keys than Singularity themes: only keep valid preset names.
        if type(info.Theme) == "string" then
            if not Library.ThemePresets[info.Theme] then
                info.Theme = nil
            end
        elseif type(info.Theme) == "table" and info.Theme.AccentColor == nil then
            info.Theme = nil
        end
        -- Ui corner radius uses a different scale.
        info.CornerRadius = nil

        if info.ConfigFolder then
            Library.ConfigFolder = info.ConfigFolder
            SaveManager:SetFolder(info.ConfigFolder)
        end

        local window = OriginalCreateWindow(self, info)
        self.ToggleKey = self.ToggleKeybind

        local watermark = info.ShowWatermark
        if watermark == false or (type(watermark) == "table" and watermark.Enabled == false) then
            self:SetWatermarkVisibility(false)
        elseif watermark ~= nil then
            self:SetWatermarkVisibility(true)
            self:EnableStatsWatermark(info.Title)
        end

        -- Window:CreateTab(name, twoColumn, icon, internal, tooltip) -> tab, activate
        function window:CreateTab(name, twoColumn, icon, internal, tooltip)
            name = tostring(name or "Tab")
            local tab = self:AddTab(name, normalizeIcon(icon))
            if tooltip and tooltip ~= "" then
                Library:AddTooltip(tooltip, tab.Button)
            end
            if not twoColumn then
                tab.LeftColumn.Size = UDim2.new(1, 0, 1, 0)
                tab.RightColumn.Visible = false
            end
            if internal then
                tab:SetVisible(false)
            end
            attachUiTabApi(tab, name)
            return tab, function()
                self:SelectTab(tab)
            end
        end

        return window
    end

    -- Library:KeySystem({ Key = "abc" | { "abc", "def" }, Link = "https://...", Title = "..." })
    -- Blocks until a valid key is entered, then closes its small window.
    function Library:KeySystem(settings)
        settings = settings or {}
        local key = settings.Key
        if key == nil or key == "" then
            return
        end
        local keys = type(key) == "table" and key or { tostring(key) }

        local window = OriginalCreateWindow(self, {
            Title = settings.Title or "Security Access",
            Footer = "Key system",
            Size = Vector2.new(460, 330),
            ShowSearch = false,
            Resizable = false,
        })
        local tab = window:AddKeyTab("Key System", {
            Title = settings.Title or "Security Access",
            KeyLink = settings.Link and tostring(settings.Link) or nil,
            Keys = keys,
        })
        window:SelectTab(tab)

        while not tab.Valid and not Library.Unloaded do
            task.wait(0.1)
        end
        task.wait(0.5)
        window:Destroy()
    end
end

