	if type(v) == "boolean" then return v and "ON" or "OFF" end
	if type(v) == "table" then
		local ok, str = pcall(function() return HttpService:JSONEncode(v) end)
		return ok and str or "{...}"
	end
	if v == nil then return "—" end
	return tostring(v)
end

-- configName fourni (chargement / import d'une config) : capture des notifications + liste des changements.
-- Sans nom (restauration des réglages au lancement) : comportement d'avant, rien n'est retenu.
function Library:_applyFlags(data, configName)
	local cfgFmt = Library._cfgFmt
	local capture = configName ~= nil
	if capture then Library._cfgCapture = (Library._cfgCapture or 0) + 1 end
	Library._silentSound = (Library._silentSound or 0) + 1
	local changes = {}
	local function setFlag(flag, value)
		local it = Library.Items[flag]
		if not (it and it.Set) then return end
		local old = Library.Flags[flag]
		pcall(it.Set, it, value)
		if capture and string.sub(flag, 1, 3) ~= "ui." and cfgFmt(old) ~= cfgFmt(value) then
			changes[#changes + 1] = { Flag = flag, Old = cfgFmt(old), New = cfgFmt(value) }
		end
	end
	-- les réglages d'interface d'abord, pour que le reste s'affiche déjà avec le bon thème
	local later = {}
	do
		local sty = data["ui.style"]
		local sit = Library.Items["ui.style"]
		if sty ~= nil and sit and sit.Set then pcall(sit.Set, sit, sty) end
		local lay = data["ui.layoutstyle"]
		local lit = Library.Items["ui.layoutstyle"]
		if lay ~= nil and lit and lit.Set then pcall(lit.Set, lit, lay) end
	end
	for flag, value in pairs(data) do
		if flag == "ui.shape" and value == "Vague" then value = "Arrondie" end
		if flag == "ui.style" or flag == "ui.layoutstyle" then
			-- déjà appliqué plus haut
		elseif string.sub(flag, 1, 3) == "ui." then
			setFlag(flag, value)
		else
			later[flag] = value
		end
	end
	for flag, value in pairs(later) do setFlag(flag, value) end
	Library._silentSound = math.max((Library._silentSound or 1) - 1, 0)

	if capture then
		-- les callbacks sont lancés par task.spawn : leurs notifications arrivent juste après, on garde la capture ouverte un instant
		task.delay(0.6, function() Library._cfgCapture = math.max((Library._cfgCapture or 1) - 1, 0) end)
		table.sort(changes, function(a, b) return a.Flag < b.Flag end)
		local hist = Library.CfgChanges
		hist[#hist + 1] = { Time = os.time(), Config = tostring(configName), List = changes }
		while #hist > 10 do table.remove(hist, 1) end
		Library._lastCfgCount = #changes
		if Library._onCfgChanges then pcall(Library._onCfgChanges) end
	end
	return changes
end

function Library:ExportConfig()
	return "UILIB-CONFIG:" .. HttpService:JSONEncode(Library.Flags)
end

function Library:ImportConfig(str)
	str = tostring(str or "")
	str = string.gsub(str, "^%s+", "")
	str = string.gsub(str, "^UILIB%-CONFIG:", "")
	str = string.gsub(str, "%s+$", "")
	local ok, data = pcall(function() return HttpService:JSONDecode(str) end)
	if not ok or type(data) ~= "table" then return false, "code invalide" end
	Library:_applyFlags(data, "import")
	return true
end

function Library:ResetConfig(includeUi)
	local n = 0
	for flag, def in pairs(Library.Defaults) do
		local internal = string.sub(flag, 1, 2) == "__"
		local isUi = string.sub(flag, 1, 3) == "ui."
		if not internal and (includeUi or not isUi) then
			local it = Library.Items[flag]
			if it and it.Set then
				pcall(it.Set, it, copyVal(def))
				n += 1
			end
		end
	end
	return n
end

function Library:DuplicateConfig(a, b)
	a, b = safeName(a), safeName(b)
	if a == "" or b == "" then return false, "nom vide" end
	if not (readfile and writefile and isfile) then return false, "fichiers indisponibles" end
	local pa = Library.ConfigFolder .. "/" .. a .. ".json"
	local pb = Library.ConfigFolder .. "/" .. b .. ".json"
	if not isfile(pa) then return false, "introuvable" end
	local ok, err = pcall(function() writefile(pb, readfile(pa)) end)
	return ok, err
end

function Library:RenameConfig(a, b)
	local ok, err = Library:DuplicateConfig(a, b)
	if ok and safeName(a) ~= safeName(b) then Library:DeleteConfig(a) end
	return ok, err
end

function Library:SetBackground(m)
	if Library.Window then Library.Window:SetBackground(m) end
end

function Library:SetCornerRadius(v)
	Library.GlobalCornerValue = v
	for _, c in ipairs(Library.CornerObjects) do
		if c.Corner and c.Corner.Parent and c.Corner:GetAttribute("SqOrig") == nil then
			c.Corner.CornerRadius = UDim.new(0, math.floor(c.BaseRadius * v / 10))
		end
	end
end

