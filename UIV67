--- info:
---   Title, Footer, Icon, Size (Vector2 / UDim2), Position (UDim2 | nil = centred)
---   SidebarWidth, ShowSearch, Resizable, MinSize, ToggleKeybind, Theme,
---   MobileButton, AutoShow, NotifySide, CornerRadius, DPIScale, Font
function Library:CreateWindow(info)
    info = info or {}
    self:Init()

    if info.Icon then
        self:SetLogo(info.Icon)
    end
    if info.Font then
        self:SetFont(info.Font)
    end
    if info.Theme then
        self:SetTheme(info.Theme)
    end
    if info.CornerRadius then
        self:SetCornerRadius(info.CornerRadius)
    end
    if info.DPIScale then
        self:SetDPIScale(info.DPIScale)
    end
    if info.NotifySide then
        self.NotifySide = info.NotifySide
    end
    if info.ToggleKeybind then
        self.ToggleKeybind = info.ToggleKeybind
