			cv.BackgroundTransparency = 0
			task.delay(0.08, function()
				if ec.minGen ~= my then return end
				local tw = tween(cv, { BackgroundTransparency = 1 }, 0.34)
				tw.Completed:Connect(function()
					if ec.minGen == my then cv.Visible = false end
				end)
			end)
		end
	end
	setMinimized = function(v)
		v = v and true or false
		if v == collapsed then return end
		collapsed = v
		local sz = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
		-- Un dépliage est encore en cours : la vraie taille est sa cible, pas la taille intermédiaire
		-- (sinon la fenêtre se « rapetisse » toute seule à la réouverture).
		local fullSz = Vector2.new(math.max(fullSize.X, minW), math.max(fullSize.Y, minH))
		curSize, lastSize, rsDir, rsSmooth = sz, sz, Vector2.new(0, 1), true
		ec.fadeCover(v)
		if v then
			preSize = fullSz
			tgtSize = Vector2.new(fullSz.X, ec.collapsedH)
			task.delay(0.35, function()
				if collapsed then
					for _, p in ipairs(parts) do p.Visible = false end
					if ec.vis then ec.vis() end
				end
			end)
		else
			for _, p in ipairs(parts) do p.Visible = true end
			if ec.vis then ec.vis() end
			local back = fullSize
			tgtSize = Vector2.new(math.max(back.X, minW), math.max(back.Y, minH))
		end
		for _, h in ipairs(handles) do h.Visible = not v end
		Library._busyUntil = os.clock() + 0.6
		task.delay(0.7, saveWin)
		if not v and not win.Open then win:Toggle(true) end   -- barre gardée à l'écran puis dépliée : l'interface repasse en « ouverte »
	end

	local function evenSize(n) return math.floor(n / 2 + 0.5) * 2 end

	function win:ApplyLayout(d)
		if collapsed then
			collapsed = false
			for _, p in ipairs(parts) do p.Visible = true end
			if ec.vis then ec.vis() end
			for _, h in ipairs(handles) do h.Visible = true end
		end
		local v = viewport()
		local nw = evenSize(math.clamp(tonumber(d.w) or W0, minW, math.max(minW, v.X / scaleBase - 10)))
		local nh = evenSize(math.clamp(tonumber(d.h) or H0, minH, math.max(minH, v.Y / scaleBase - 10)))
		tgtSize, tgtPos = nil, nil
		main.Size = UDim2.fromOffset(nw, nh)
		fullSize = Vector2.new(nw, nh)
		lastSize, curSize = Vector2.new(nw, nh), Vector2.new(nw, nh)
		curPos = clampCenter(Vector2.new((tonumber(d.cx) or 0.5) * v.X, (tonumber(d.cy) or 0.5) * v.Y))
		setMainPos()
		saveWin()
	end

	function win:Reset()
		if collapsed then setMinimized(false) end
		local v = viewport()
		curSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
		lastSize = curSize
		rsDir, rsSmooth = Vector2.new(0, 0), true
		tgtSize = Vector2.new(math.max(minW, math.min(W0, v.X / scaleBase - 16)), math.min(H0, v.Y / scaleBase - 16))
		tgtPos = clampCenter(v / 2)
		Library._busyUntil = os.clock() + 0.8
		task.delay(0.9, saveWin)
	end

	-- ------------------------------------------------------------------
	-- Colonnes de blocs (1 à 4) : la fenêtre s'agrandit toute seule si elle est trop étroite
	-- ------------------------------------------------------------------
	local COL_GAP, SIDE_PAD = 10, 156
	local baseMinW = minW
	local function reqWidth(n) return n * (Library.ColumnMinWidth or 255) + (n - 1) * COL_GAP + SIDE_PAD end
	local function fitCols(n)   -- réduit si l'écran est trop petit pour n colonnes
		local avail = viewport().X / scaleBase - 10
		while n > 1 and reqWidth(n) > avail do n = n - 1 end
		return n
	end

	function win:SetColumns(n)
		n = math.clamp(math.floor(tonumber(n) or 1), 1, 4)
		local oldEff = win.EffCols
		win.Columns, Library.Columns = n, n
		local eff = fitCols(n)
		win.EffCols, win.TwoCols = eff, eff >= 2
		minW = math.max(baseMinW, reqWidth(eff))

		local curW = (collapsed and preSize) and preSize.X or main.Size.X.Offset
		if curW < minW then
			local nw = evenSize(minW)
			if collapsed and preSize then
				preSize = Vector2.new(nw, preSize.Y)
				fullSize = Vector2.new(nw, fullSize.Y)
			else
				local h = main.Size.Y.Offset
				curSize = Vector2.new(main.Size.X.Offset, h)
				lastSize = curSize
				rsDir, rsSmooth = Vector2.new(0, 0), true
				tgtSize = Vector2.new(nw, h)
				local v = viewport()
				local half = nw * scaleBase / 2
				local lo = half + 8
				tgtPos = Vector2.new(math.clamp(curPos.X, lo, math.max(lo, v.X - half - 8)), curPos.Y)
				Library._busyUntil = os.clock() + 0.8
				task.delay(0.9, saveWin)
			end
		end

		for _, t in ipairs(win.Tabs) do t:SetColumns(eff) end

		if oldEff and oldEff ~= eff and win.Veil and not collapsed and not Library._glideOn then
			win.VeilToken = (win.VeilToken or 0) + 1
			local my = win.VeilToken
			win.Veil.Visible = true
			win.Veil.BackgroundTransparency = Sty.VeilTr
			local tw = tween(win.Veil, { BackgroundTransparency = 1 }, 0.42)
			tw.Completed:Connect(function()
				if win.VeilToken == my then win.Veil.Visible = false end
			end)
		end
		return eff
	end
	function win:GetColumns() return win.Columns, win.EffCols end

	-- ------------------------------------------------------------------
	-- Types d'interface : « Classique » (d'origine) ou « Éclipse ». Tout est repositionné ici, rien n'est recréé.
	-- ------------------------------------------------------------------
	-- visibilité des éléments propres à chaque type (la barre réduite garde la marque Éclipse + l'en-tête)
	ec.vis = function()
		local on = Library.LayoutStyle == "Éclipse"
		local o = Library.Eclipse
		local open = not collapsed
		vline.Visible = open and not on and Library.LayoutStyle ~= "Carré"
		ec.side.Visible = open and on
		ec.brand.Visible = on
		ec.user.Visible = open and on and o.UserCard ~= false
		ec.bar.Visible = open and on and o.FooterBar ~= false
		modChip.Visible = open
	end

	-- textes (nom, version, slogan, statut)
	ec.texts = function()
		local o = Library.Eclipse
		ec.brandName.Text = titleRaw
		ec.brandTag.Text = tostring(o.Tagline or "")
		ec.brandTag.Visible = tostring(o.Tagline or "") ~= ""
		ec.barName.Text = titleRaw .. "  v" .. tostring(Library.Version or "1.0")
		ec.barTag.Text = tostring(o.Tagline or "")
		ec.barTag.Visible = tostring(o.Tagline or "") ~= ""
		ec.userStatus.Text = tostring(o.Status or "")
	end

	-- en-tête : titre de la page affichée + sous-titre
	ec.page = function(tab)
		tab = tab or win.Current
		local on = Library.LayoutStyle == "Éclipse"
		local o = Library.Eclipse
		ec.pageTitle.Visible = on
		if not on then
			ec.pageSub.Visible = false
			return
		end
		ec.pageTitle.Text = tab and tostring(tab.Name) or titleRaw
		local sub = tostring((tab and tab.Subtitle) or o.DefaultSubtitle or "")
		local showSub = o.Subtitle ~= false and sub ~= ""
		ec.pageSub.Text = sub
		ec.pageSub.Visible = showSub
		ec.pageTitle.Position = UDim2.new(0, 4, 0, showSub and 7 or 15)
	end
	win._ecPage = ec.page

	-- bouton d'onglet : hauteur, arrondi, contour de sélection (barre latérale cachée en Éclipse)
	ec.styleTab = function(tab)
		local btn = tab.Button
		if not btn then return end
		local txt = tab.Label
		local on = Library.LayoutStyle == "Éclipse"
		local sq = Library.LayoutStyle == "Carré"
		-- état d'origine (mémorisé au tout premier passage, avant toute modification)
		local orig = tab._sqOrig
		if not orig and txt then
			orig = { pos = txt.Position, size = txt.Size, align = txt.TextXAlignment, order = btn.LayoutOrder }
			tab._sqOrig = orig
		end
		local docked = btn.Parent == footer
		local isChild = tab.ParentTab ~= nil
		-- taille du bouton : en Carré, la largeur suit le texte (barre horizontale)
		if sq then
			if docked then
				btn.Size = UDim2.new(1, 0, 1, 0)
			else
				local w = 60
				if txt then
					local ok, b = pcall(function()
						return game:GetService("TextService"):GetTextSize(txt.Text, txt.TextSize, txt.Font, Vector2.new(1000, 100))
					end)
					w = ((ok and b) and math.ceil(b.X) or (#txt.Text * 8)) + 28
				end
				btn.Size = UDim2.new(0, w, 1, 0)
			end
		else
			btn.Size = UDim2.new(1, 0, 0, isChild and 30 or ((on and not docked) and 38 or 34))
		end
		if tab.Corner and not sq then tab.Corner.CornerRadius = UDim.new(0, on and 12 or 8) end
		local st = btn:FindFirstChild("EcSel")
		if on and not st then
			st = new("UIStroke", { Name = "EcSel", Color = T.Accent, Thickness = 1, ApplyStrokeMode = BORDER,
				Transparency = 1 }, btn)   -- le contour de sélection est dessiné par la pastille de la sidebar
		end
		if st then st.Enabled = on end
		if tab.Bar then tab.Bar.Visible = not on and not sq end
		-- type Carré : soulignement de l'onglet actif
		local ln = btn:FindFirstChild("SqLine")
		if sq and not ln then
			ln = new("Frame", { Name = "SqLine", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 6, 1, 0),
				Size = UDim2.new(1, -12, 0, 2), BackgroundColor3 = T.Accent, BorderSizePixel = 0, BackgroundTransparency = 1 }, btn)
		end
		if ln then
			ln.Visible = sq
			ln.BackgroundTransparency = (sq and win.Current == tab and not (win._selOwns and win._selOwns(tab))) and 0 or 1
		end
		-- texte : centré dans la barre du haut (Carré), position d'origine sinon (le bouton docké garde sa mise en page)
		if txt and not docked and orig then
			if sq then
				txt.Position = UDim2.new(0, 4, 0, 0)
				txt.Size = UDim2.new(1, -8, 1, 0)
				txt.TextXAlignment = Enum.TextXAlignment.Center
				txt:SetAttribute("BaseX", 4)
			else
				txt.Position = orig.pos
				local sz = orig.size
				if tab._arrow then sz = UDim2.new(sz.X.Scale, sz.X.Offset - 20, sz.Y.Scale, sz.Y.Offset) end
				txt.Size = sz
				txt.TextXAlignment = orig.align
				txt:SetAttribute("BaseX", nil)
			end
		end
		if tab.Dot then
			if sq then
				tab.Dot.AnchorPoint = Vector2.new(1, 0)
				tab.Dot.Position = UDim2.new(1, -3, 0, 3)
			else
				tab.Dot.AnchorPoint = Vector2.new(1, 0.5)
				tab.Dot.Position = UDim2.new(1, -8, 0.5, 0)
			end
		end
		if tab._arrow then tab._arrow.Visible = not sq end
		-- les onglets enfants passent à plat dans la barre du haut, puis reviennent dans leur parent
		if isChild and orig then
			if sq then
				if btn.Parent ~= sidebar then btn.Parent = sidebar end
			else
				local inner = tab.ParentTab._holder and tab.ParentTab._holder.Inner
				if inner and btn.Parent ~= inner then btn.Parent = inner end
				btn.LayoutOrder = orig.order
			end
		elseif not isChild and not docked and not sq and tab._sqRealOrder then
			btn.LayoutOrder = tab._sqRealOrder
			tab._sqRealOrder = nil
		end
		if win.Current == tab then
			btn.BackgroundTransparency = (win._selOwns and win._selOwns(tab)) and 1 or (on and 0.88 or 0.92)
		end
		if sq and ec.sqOrder then ec.sqOrder() end
	end

	-- ordre des onglets dans la barre du haut : chaque onglet suivi de ses enfants
	ec.sqOrder = function()
		local tops = {}
		for _, t in ipairs(win.Tabs) do
			if not t.ParentTab and t.Button and t.Button.Parent == sidebar then
				if t._sqRealOrder == nil then t._sqRealOrder = t.Button.LayoutOrder end
				tops[#tops + 1] = t
			end
		end
		table.sort(tops, function(a, b) return a._sqRealOrder < b._sqRealOrder end)
		for n, t in ipairs(tops) do
			t.Button.LayoutOrder = n * 100
			if t._arrow then   -- la flèche des sous-menus (créée après le 1er passage) n'a pas sa place dans la barre du haut
				t._arrow.Visible = false
				if t.Label and t.Button.Parent == sidebar then t.Label.Size = UDim2.new(1, -8, 1, 0) end
			end
			local k = 0
			for _, c in ipairs(t.Children) do
				if c.Button and c.Button.Parent == sidebar then
					k += 1
					c.Button.LayoutOrder = n * 100 + k
				end
			end
		end
	end

	-- ------------------------------------------------------------------
	-- Pastille de sélection de la sidebar : UNE pastille qui glisse (ressort) vers l'onglet actif, comme celle des
	-- sous-onglets, au lieu d'un fond qui s'allume sur place. Elle suit aussi le bouton si la mise en page bouge
	-- (déploiement d'un onglet parent, changement de style, défilement). Éclipse : avec contour ; Carré : soulignement.
	-- Un onglet « docké » hors de la sidebar garde l'ancien affichage.
	-- ------------------------------------------------------------------
	do
		local selHost = new("Frame", { Name = "SelHost", Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1,
			BorderSizePixel = 0, LayoutOrder = 2147483000, ZIndex = 0 }, sidebar)
		local selPill = new("Frame", { Name = "SelPill", Size = UDim2.fromOffset(0, 0), BackgroundColor3 = T.Accent,
			BackgroundTransparency = 0.92, BorderSizePixel = 0, Visible = false, ZIndex = 0 }, selHost)
		local selCorner = new("UICorner", { CornerRadius = UDim.new(0, 8) }, selPill)
		local selStroke = new("UIStroke", { Color = T.Accent, Thickness = 1, ApplyStrokeMode = BORDER, Transparency = 1 }, selPill)
		local selBar = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 3, 0, 16), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, selPill)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, selBar)

		local selTab, selConns, selBorn, selQueued = nil, {}, 0, false

		local function owns(tab)
			local b = tab and tab.Button
			return b ~= nil and b.Parent ~= nil and b:IsDescendantOf(sidebar)
		end

		local function style()
			local ls = Library.LayoutStyle
			local sqm, ecl = ls == "Carré", ls == "Éclipse"
			selBar.Visible = not sqm and not ecl
			selStroke.Transparency = ecl and 0.72 or 1
			selPill.BackgroundTransparency = sqm and 0 or (ecl and 0.88 or 0.92)
			if not sqm then selCorner.CornerRadius = UDim.new(0, ecl and 12 or 8) end
		end

		local function target(tab)
			if not owns(tab) then return nil end
			local ls = Library.LayoutStyle
			if tab.ParentTab and ls ~= "Carré" and not tab.ParentTab.Expanded then return nil end
			local sc = math.max(pxScale(), 0.05)
			local ap, hp, as = tab.Button.AbsolutePosition, selHost.AbsolutePosition, tab.Button.AbsoluteSize
			local x, y, w, h = (ap.X - hp.X) / sc, (ap.Y - hp.Y) / sc, as.X / sc, as.Y / sc
			if w <= 0 or h <= 0 then return nil end
			if ls == "Carré" then
				return UDim2.fromOffset(math.floor(x + 6 + 0.5), math.floor(y + h - 2 + 0.5)), UDim2.fromOffset(math.max(math.floor(w - 12 + 0.5), 0), 2)
			end
			return UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5)), UDim2.fromOffset(math.floor(w + 0.5), math.floor(h + 0.5))
		end

		local function place(instant)
			if not selTab then selPill.Visible = false return end
			local pos, size = target(selTab)
			if not pos then selPill.Visible = false Library._springStop(selPill) return end
			local first = not selPill.Visible
			if first then selBorn = os.clock() end
			selPill.Visible = true
			-- les premiers instants (mise en page pas encore stable) : placement direct, sans glisser depuis un coin
			if first or instant or os.clock() - selBorn < 0.35 or Library.Animations == false or Library.Springs == false then
				Library._springStop(selPill)
				selPill.Position, selPill.Size = pos, size
			else
				Library._spring(selPill, { Position = pos, Size = size }, "snappy")
			end
		end

		local function queue()
			if selQueued then return end
			selQueued = true
			task.defer(function() selQueued = false place(false) end)
		end

		local function follow(tab)
			for _, c in ipairs(selConns) do c:Disconnect() end
			selConns = {}
			if not owns(tab) then return end
			local b = tab.Button
			selConns[1] = b:GetPropertyChangedSignal("AbsolutePosition"):Connect(queue)
			selConns[2] = b:GetPropertyChangedSignal("AbsoluteSize"):Connect(queue)
			selConns[3] = selHost:GetPropertyChangedSignal("AbsolutePosition"):Connect(queue)
		end

		-- appelé par Tab:Select : true = la pastille prend en charge l'affichage de l'onglet actif
		win._selSet = function(tab)
			selTab = owns(tab) and tab or nil
			follow(selTab)
			style()
			place(false)
			return selTab ~= nil
		end
		win._selOwns = function(tab) return selTab == tab and owns(tab) end
		win._selRefresh = function()
			style()
			if selTab then place(true) end
		end
		track({ Disconnect = function() for _, c in ipairs(selConns) do c:Disconnect() end selConns = {} end })
	end

	win._ecStyleTab = ec.styleTab

	win._ecTabSelected = function(tab)
		if Library.LayoutStyle == "Carré" then
			for _, t in ipairs(win.Tabs) do
				local l = t.Button and t.Button:FindFirstChild("SqLine")
				if l then tween(l, { BackgroundTransparency = ((t == tab) and not (win._selOwns and win._selOwns(t))) and 0 or 1 }, 0.2) end
			end
		end
		if Library.LayoutStyle == "Éclipse" then
			for _, t in ipairs(win.Tabs) do
				local st = t.Button and t.Button:FindFirstChild("EcSel")
				if st then tween(st, { Transparency = ((t == tab) and not (win._selOwns and win._selOwns(t))) and 0.72 or 1 }, 0.25) end
			end
			tween(tab.Button, { BackgroundTransparency = (win._selOwns and win._selOwns(tab)) and 1 or 0.88 }, 0.25)
		end
		ec.page(tab)
	end

	-- type Carré : coins à 0 dans toute la fenêtre, police monospace, blocs à titre sur la bordure (ne refait rien si l'état est inchangé)
	ec.squareApply = function(sq)
		if ec.sqState == sq then return end
		ec.sqState = sq
		Library.SquareMode = sq
		for _, d in ipairs(main:GetDescendants()) do
			if d:IsA("UICorner") and d:GetAttribute("KeepRound") == nil then
				if sq then
					if d:GetAttribute("SqOrig") == nil then d:SetAttribute("SqOrig", d.CornerRadius) end
					d.CornerRadius = UDim.new(0, 0)
				else
					local orig = d:GetAttribute("SqOrig")
					if orig ~= nil then
						d.CornerRadius = orig
						d:SetAttribute("SqOrig", nil)
					end
				end
			end
		end
		if not sq then
			Library:SetCornerRadius(Library.GlobalCornerValue)
			if win.RefreshShape then win:RefreshShape() end
		end
		Library:SetFont(Library.FontFamily or "Gotham")
		Library._sqRefreshAll(win)
	end

	-- barre de recherche : à droite du titre, centrée dans la fenêtre (ou dans l'espace libre s'il est trop étroit), large
	ec.placeSearch = function()
		local ls = Library.LayoutStyle
		if ls == "Éclipse" then return end
		local sqm = ls == "Carré"
		local W = main.Size.X.Offset
		local tbw = 0
		pcall(function() tbw = title.TextBounds.X end)
		if tbw <= 0 then tbw = #tostring(title.Text) * 9 end
		local left = (sqm and 10 or tx) + tbw + 18
		local right = undoBtn.Visible and 256 or 88          -- boutons FPS / annuler / replier / réduire
		local h = sqm and 24 or 30
		local gap = 8
		local avail = W - left - right
		local w = math.floor(math.clamp(avail - h - gap, 90, 400))
		local cy = sqm and 14 or 21
		local cx = W / 2
		if cx - w / 2 < left or cx + w / 2 + gap + h > W - right then
			cx = math.max(left + (avail - (w + gap + h)) / 2 + w / 2, left + w / 2)
		end
		search.AnchorPoint = Vector2.new(0.5, 0.5)
		search.Position = UDim2.fromOffset(math.floor(cx + 0.5), cy)
		search.Size = UDim2.fromOffset(w, h)
		modChip.AnchorPoint = Vector2.new(0, 0.5)
		modChip.Position = UDim2.fromOffset(math.floor(cx + w / 2 + gap + 0.5), cy)
		modChip.Size = UDim2.fromOffset(h, h)
	end
	for _, sig in ipairs({ main:GetPropertyChangedSignal("Size"), title:GetPropertyChangedSignal("TextBounds"),
		undoBtn:GetPropertyChangedSignal("Visible") }) do
		track(sig:Connect(function() ec.placeSearch() end))
	end

	-- applique le type d'interface courant (positions, tailles, visibilité)
	ec.apply = function(flash)
		local on = Library.LayoutStyle == "Éclipse"
		local o = Library.Eclipse
		win.LayoutStyle = Library.LayoutStyle
		local sw = math.clamp(math.floor(tonumber(o.SidebarWidth) or 176), 150, 240)
		local userOn = on and o.UserCard ~= false
		local barOn = on and o.FooterBar ~= false
		local oldPad = SIDE_PAD
		local sq = Library.LayoutStyle == "Carré"
		ec.squareApply(sq)
		-- valeurs communes (le type Carré les redéfinit plus bas)
		footer.AnchorPoint = Vector2.new(0, 0)
		title.Position = UDim2.new(0, tx, 0, 0)
		title.Size = UDim2.new(1, -tx - 190, 1, 0)

		if on then
			local cx = sw + 18                 -- x du contenu
			SIDE_PAD = cx + 10
			ec.collapsedH = 58
			ec.side.Position = UDim2.fromOffset(8, 8)
			ec.side.Size = UDim2.new(0, sw, 1, -16)
			ec.brand.Position = UDim2.fromOffset(8, 8)
			ec.brand.Size = UDim2.fromOffset(sw, 62)
			ec.user.Position = UDim2.new(0, 14, 1, -64)
			ec.user.Size = UDim2.new(0, sw - 12, 0, 50)
			local footTop = userOn and 102 or 48
			footer.Position = UDim2.new(0, 14, 1, -footTop)
			footer.Size = UDim2.new(0, sw - 12, 0, 34)
			sidebar.Position = UDim2.new(0, 12, 0, 74)
			sidebar.Size = UDim2.new(0, sw - 8, 1, -(74 + footTop + 6))
