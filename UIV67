--[[
	Ui-Lib Simple (noir & blanc)
	Compatible avec Help_1_fixed.txt

	Utilisation (remplace la ligne 845 du script) :
		local Library = loadstring(readfile("Ui-Lib-Simple.lua"))()
	ou, si tu l'héberges :
		local Library = loadstring(game:HttpGet("TON_LIEN_RAW"))()

	API fournie (celle qu'utilise le script) :
		Library:CreateWindow({...})            -> Window
		Window:CreateTab(nom, _, icone)        -> Tab
		Tab:CreateBlock({Name, Side, ImageID}) -> Block
		Block:CreateSection / CreateLabel / CreateButton / CreateToggle /
		      CreateSlider / CreateDropdown / CreateInput /
		      CreateColorPicker / CreateKeybind
		Library:Notify({Title, Content, Duration})
		Library.Flags / Library.Items / Library.CornerObjects / Library.GlobalCornerValue
]]

local Players      = game:GetService("Players")
local UIS          = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui      = game:GetService("CoreGui")
local LP           = Players.LocalPlayer

local Library = {
	Flags             = {},
	Items             = {},
	CornerObjects     = {},
	GlobalCornerValue = 10,   -- 10 = rayon normal (le script le change via son slider)
	FireDefaults      = false, -- true = appelle les Callback avec la valeur Default à la création
}

local Block, Tab, Window = {}, {}, {}
Block.__index  = Block
Window.__index = Window
Tab.__index = function(t, k)
	if Tab[k] then return Tab[k] end
	-- Permet Tab:CreateToggle(...) / Tab:CreateSlider(...) directement sur un onglet
	if type(k) == "string" and k:sub(1, 6) == "Create" and Block[k] then
		return function(self, ...)
			if not self.DefaultBlock then
				self.DefaultBlock = Tab.CreateBlock(self, { Name = self.Name, Side = "Left" })
			end
			return Block[k](self.DefaultBlock, ...)
		end
	end
	return nil
end

-- ============================================================================
-- THÈME
-- ============================================================================
local function lighten(c, a) return c:Lerp(Color3.new(1, 1, 1), a) end

local T = {
	Main          = Color3.fromRGB(0, 0, 0),
	Second        = Color3.fromRGB(10, 10, 15),
	Accent        = Color3.fromRGB(255, 255, 255),
	ElementAccent = Color3.fromRGB(200, 200, 200),
	Text          = Color3.fromRGB(255, 255, 255),
	GradientStart = Color3.fromRGB(255, 255, 255),
	GradientEnd   = Color3.fromRGB(180, 180, 180),
}
T.Element = lighten(T.Second, 0.10)
T.Off     = lighten(T.Second, 0.24)

-- ============================================================================
-- OUTILS
-- ============================================================================
local Conns = {}
local function track(c) Conns[#Conns + 1] = c return c end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end

local function tween(o, props, t)
	local tw = TweenService:Create(o, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function corner(parent, base)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, math.floor(base * Library.GlobalCornerValue / 10))
	c.Parent = parent
	table.insert(Library.CornerObjects, { Corner = c, BaseRadius = base })
	return c
end

local function stroke(parent, transparency)
	return new("UIStroke", {
		Color = T.Accent, Transparency = transparency or 0.9, Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function label(parent, text, size, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Text = tostring(text), TextColor3 = T.Text, TextSize = size or 13,
		Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 1, 0),
	})
	for k, v in pairs(props or {}) do l[k] = v end
	l.Parent = parent
	return l
end

-- Appelle un callback sans jamais casser l'UI
local function fire(cb, ...)
	if type(cb) ~= "function" then return end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(cb, table.unpack(args, 1, args.n))
		if not ok then warn("[Ui-Lib] Callback : " .. tostring(err)) end
	end)
end

-- Permet d'appeler item.Set(v) ET item:Set(v)
local function unself(self, ...)
	if (...) == self then return select(2, ...) end
	return ...
end

local function register(flag, item, value)
	if flag then
		Library.Flags[flag] = value
		Library.Items[flag] = item
	end
end

local function mount(gui)
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(gui)
		elseif protectgui then protectgui(gui) end
	end)
	local ok = pcall(function() gui.Parent = CoreGui end)
	if not ok or not gui.Parent then
		gui.Parent = LP:WaitForChild("PlayerGui")
	end
end

-- Gestion centralisée du glisser (sliders, color picker, déplacement de la fenêtre)
local activeDrag, dragScroll
local function startDrag(fn, scroll, pos)
	activeDrag = fn
	if scroll then dragScroll = scroll scroll.ScrollingEnabled = false end
	fn(pos)
end
track(UIS.InputChanged:Connect(function(i)
	if activeDrag and (i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch) then
		activeDrag(i.Position)
	end
end))
track(UIS.InputEnded:Connect(function(i)
	if activeDrag and (i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch) then
		activeDrag = nil
		if dragScroll then dragScroll.ScrollingEnabled = true dragScroll = nil end
	end
end))

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

-- ============================================================================
-- NOTIFICATIONS
-- ============================================================================
local notifGui, notifHolder
local function ensureNotif()
	if notifGui and notifGui.Parent then return end
	notifGui = new("ScreenGui", { Name = "SolarisNotify", ResetOnSpawn = false, DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
	mount(notifGui)
	notifHolder = new("Frame", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14),
		Size = UDim2.new(0, 280, 1, -28), BackgroundTransparency = 1,
	}, notifGui)
	new("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
	}, notifHolder)
end

local function fadeCard(card, visible, t)
	tween(card, { BackgroundTransparency = visible and 0.08 or 1 }, t)
	for _, d in ipairs(card:GetDescendants()) do
		if d:IsA("TextLabel") then tween(d, { TextTransparency = visible and 0 or 1 }, t) end
		if d:IsA("UIStroke") then tween(d, { Transparency = visible and 0.8 or 1 }, t) end
	end
end

function Library:Notify(o)
	if type(o) ~= "table" then o = { Content = tostring(o) } end
	ensureNotif()
	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Second, BackgroundTransparency = 1, BorderSizePixel = 0,
		LayoutOrder = math.floor(os.clock() * 100) % 1000000,
	}, notifHolder)
	corner(card, 8)
	local st = stroke(card, 1)
	new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, card)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, card)
	label(card, o.Title or "Notification", 13, { Font = Enum.Font.GothamBold, TextTransparency = 1,
		Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1 })
	label(card, o.Content or "", 12, { TextTransparency = 1, TextColor3 = T.ElementAccent, TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None, AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2 })
	st.Transparency = 1
	fadeCard(card, true, 0.25)
	task.delay(tonumber(o.Duration) or 4, function()
		if card.Parent then
			fadeCard(card, false, 0.3)
			task.wait(0.35)
			card:Destroy()
		end
	end)
end

-- ============================================================================
-- ÉLÉMENTS (Block)
-- ============================================================================
local function makeRow(self, h)
	local f = new("Frame", {
		Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = T.Element,
		BackgroundTransparency = 0.25, BorderSizePixel = 0,
	}, self.Body)
	corner(f, 6)
	return f
end

function Block:CreateSection(text)
	if type(text) == "table" then text = text.Name or text.Text end
	local l = label(self.Body, text or "", 12, {
		Size = UDim2.new(1, 0, 0, 22), Font = Enum.Font.GothamBold, TextColor3 = T.ElementAccent,
	})
	new("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1),
		BackgroundColor3 = T.Accent, BackgroundTransparency = 0.88, BorderSizePixel = 0 }, l)
	local item = {}
	item.SetText = function(...) l.Text = tostring((unself(item, ...))) end
	return item
end

function Block:CreateLabel(o)
	if type(o) ~= "table" then o = { Text = tostring(o) } end
	local l = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Text = o.Text or "", TextColor3 = o.TextColor or T.Text, TextSize = o.TextSize or 13,
		Font = Enum.Font.Gotham, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, self.Body)
	new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }, l)
	local item = {}
	item.SetText = function(...) l.Text = tostring((unself(item, ...))) end
	item.Set = item.SetText
	item.Instance = l
	return item
end

function Block:CreateButton(o)
	o = o or {}
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.Element, BackgroundTransparency = 0.25,
		Text = o.Name or "Button", TextColor3 = T.Text, TextSize = 13, Font = Enum.Font.GothamMedium,
		AutoButtonColor = false, BorderSizePixel = 0, TextTruncate = Enum.TextTruncate.AtEnd,
	}, self.Body)
	corner(b, 6)
	stroke(b, 0.92)
	b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.05 }) end)
	b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = 0.25 }) end)
	b.MouseButton1Click:Connect(function()
		b.BackgroundTransparency = 0
		tween(b, { BackgroundTransparency = 0.25 }, 0.25)
		fire(o.Callback)
	end)
	local item = {}
	item.SetText = function(...) b.Text = tostring((unself(item, ...))) end
	item.Instance = b
	return item
end

function Block:CreateToggle(o)
	o = o or {}
	local f = makeRow(self, 32)
	label(f, o.Name or "Toggle", 13, { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -62, 1, 0) })
	local sw = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 36, 0, 18), BackgroundColor3 = T.Off, BorderSizePixel = 0,
	}, f)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, sw)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.new(0, 14, 0, 14), BackgroundColor3 = T.Text, BorderSizePixel = 0,
	}, sw)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	local btn = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, f)

	local state = o.Default and true or false
	local function paint(v, instant)
		local t = instant and 0 or 0.15
		tween(sw, { BackgroundColor3 = v and T.Accent or T.Off }, t)
		tween(knob, {
			Position = v and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
			BackgroundColor3 = v and T.Main or T.Text,
		}, t)
	end
	local function apply(v, silent)
		state = v
		if o.Flag then Library.Flags[o.Flag] = v end
		paint(v)
		if not silent then fire(o.Callback, v) end
	end
	local item = {}
	item.Set = function(...) apply((unself(item, ...)) and true or false) end
	item.Get = function() return state end
	btn.MouseButton1Click:Connect(function() apply(not state) end)

	paint(state, true)
	register(o.Flag, item, state)
	if Library.FireDefaults then fire(o.Callback, state) end
	return item
end

function Block:CreateSlider(o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local def = math.clamp(o.Default or min, min, max)
	local dec = o.Rounding
	if dec == nil then dec = (min % 1 ~= 0 or max % 1 ~= 0 or def % 1 ~= 0) and 2 or 0 end
	local mult = 10 ^ dec

	local f = makeRow(self, 46)
	label(f, o.Name or "Slider", 13, { Position = UDim2.new(0, 10, 0, 5), Size = UDim2.new(1, -90, 0, 16) })
	local valL = label(f, "", 12, { Position = UDim2.new(1, -80, 0, 5), Size = UDim2.new(0, 70, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.ElementAccent })
	local bar = new("Frame", {
		Position = UDim2.new(0, 10, 0, 30), Size = UDim2.new(1, -20, 0, 6),
		BackgroundColor3 = T.Off, BorderSizePixel = 0,
	}, f)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, bar)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
	local hit = new("TextButton", { Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1, Text = "" }, f)

	local value
	local function apply(v, silent)
		v = math.clamp(v, min, max)
		v = math.floor(v * mult + 0.5) / mult
		if v == value and not silent then return end
		value = v
		local span = max - min
		fill.Size = UDim2.new(span == 0 and 0 or (v - min) / span, 0, 1, 0)
		valL.Text = tostring(v)
		if o.Flag then Library.Flags[o.Flag] = v end
		if not silent then fire(o.Callback, v) end
	end
	local item = {}
	item.Set = function(...)
		local v = tonumber((unself(item, ...)))
		if v then apply(v) end
	end
	item.Get = function() return value end

	hit.InputBegan:Connect(function(i)
		if isPress(i) then
			startDrag(function(p)
				local t = math.clamp((p.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
				apply(min + t * (max - min))
			end, self.Scroll, i.Position)
		end
	end)

	apply(def, true)
	register(o.Flag, item, value)
	if Library.FireDefaults then fire(o.Callback, value) end
	return item
end

function Block:CreateDropdown(o)
	o = o or {}
	local items = {}
	for _, v in ipairs(o.Items or o.Options or {}) do items[#items + 1] = tostring(v) end
	local selected = o.Default
	if (selected == nil or selected == "") and o.CurrentOption and o.CurrentOption ~= "" then
		selected = o.CurrentOption
	end
	if type(selected) == "table" then selected = selected[1] end
	if selected ~= nil then selected = tostring(selected) end

	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1 }, self.Body)
	new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, holder)

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.Element, BackgroundTransparency = 0.25,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = 1,
	}, holder)
	corner(head, 6)
	label(head, o.Name or "Dropdown", 13, { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0.5, -10, 1, 0) })
	local valL = label(head, "", 12, { Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -28, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.ElementAccent })
	local arrow = label(head, "+", 14, { Position = UDim2.new(1, -22, 0, 0), Size = UDim2.new(0, 16, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold })

	local list = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 100), BackgroundColor3 = lighten(T.Second, 0.04), BackgroundTransparency = 0.2,
		BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.Accent,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false, LayoutOrder = 2,
	}, holder)
	corner(list, 6)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, list)

	local open = false
	local function restyle()
		for _, b in ipairs(list:GetChildren()) do
			if b:IsA("TextButton") then
				local on = (b.Text == selected)
				b.BackgroundTransparency = on and 0.82 or 1
				b.TextColor3 = on and T.Accent or T.ElementAccent
			end
		end
	end
	local function show()
		valL.Text = selected or "Select..."
	end
	local function apply(v, silent)
		selected = v
		if o.Flag then Library.Flags[o.Flag] = v end
		show()
		restyle()
		if not silent then fire(o.Callback, v) end
	end
	local function rebuild()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
		end
		if #items == 0 then
			label(list, "(vide)", 12, { Size = UDim2.new(1, 0, 0, 24), TextColor3 = T.ElementAccent,
				TextXAlignment = Enum.TextXAlignment.Center })
		end
		for idx, text in ipairs(items) do
			local b = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
				Text = text, TextColor3 = T.ElementAccent, TextSize = 12, Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = idx,
			}, list)
			new("UIPadding", { PaddingLeft = UDim.new(0, 8) }, b)
			new("UICorner", { CornerRadius = UDim.new(0, 4) }, b)
			b.MouseButton1Click:Connect(function()
				apply(text)
				open = false
				list.Visible = false
				arrow.Text = "+"
			end)
		end
		list.Size = UDim2.new(1, 0, 0, math.clamp(#items * 26 + 8, 34, 140))
		restyle()
	end
	local function setItems(newItems, clear)
		items = {}
		for _, v in ipairs(newItems or {}) do items[#items + 1] = tostring(v) end
		if clear == true or (selected and not table.find(items, selected)) then
			selected = nil
			if o.Flag then Library.Flags[o.Flag] = nil end
		end
		show()
		rebuild()
	end

	head.MouseButton1Click:Connect(function()
		open = not open
		if open and type(o.UpdateList) == "function" then
			local ok, res = pcall(o.UpdateList)
			if ok and type(res) == "table" then setItems(res, false) end
		end
		list.Visible = open
		arrow.Text = open and "-" or "+"
	end)

	local item = {}
	item.Set = function(...)
		local v = unself(item, ...)
		apply(v ~= nil and tostring(v) or nil)
	end
	item.Get = function() return selected end
	item.Refresh = function(...)
		local newItems, clear = unself(item, ...)
		setItems(newItems, clear)
	end
	item.SetItems = function(...)
		local newItems = unself(item, ...)
		setItems(newItems, false)
	end

	show()
	rebuild()
	register(o.Flag, item, selected)
	if Library.FireDefaults and selected then fire(o.Callback, selected) end
	return item
end

function Block:CreateInput(o)
	o = o or {}
	local f = makeRow(self, 32)
	label(f, o.Name or "Input", 13, { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0.4, -10, 1, 0) })
	local tb = new("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0.6, -14, 0, 22),
		BackgroundColor3 = T.Off, BackgroundTransparency = 0.3, BorderSizePixel = 0,
		Text = o.Default and tostring(o.Default) or "", PlaceholderText = o.Placeholder or o.PlaceholderText or "",
		PlaceholderColor3 = Color3.fromRGB(130, 130, 130), TextColor3 = T.Text, TextSize = 12,
		Font = Enum.Font.Gotham, ClearTextOnFocus = false, TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, f)
	corner(tb, 5)
	new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, tb)

	tb:GetPropertyChangedSignal("Text"):Connect(function()
		if o.Flag then Library.Flags[o.Flag] = tb.Text end
	end)
	tb.FocusLost:Connect(function() fire(o.Callback, tb.Text) end)

	local item = {}
	item.Set = function(...)
		tb.Text = tostring((unself(item, ...)) or "")
		fire(o.Callback, tb.Text)
	end
	item.Get = function() return tb.Text end
	item.Instance = tb
	register(o.Flag, item, tb.Text)
	return item
end

function Block:CreateKeybind(o)
	o = o or {}
	local key = o.Default or Enum.KeyCode.Unknown
	local f = makeRow(self, 32)
	label(f, o.Name or "Keybind", 13, { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -110, 1, 0) })
	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 84, 0, 22),
		BackgroundColor3 = T.Off, BackgroundTransparency = 0.3, BorderSizePixel = 0, Text = key.Name,
		TextColor3 = T.Text, TextSize = 12, Font = Enum.Font.GothamMedium, AutoButtonColor = false,
	}, f)
	corner(btn, 5)

	local function apply(k, silent)
		key = k
		btn.Text = k.Name
		if o.Flag then Library.Flags[o.Flag] = k.Name end
		if not silent then fire(o.Callback, k) end
	end
	local listening = false
	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		Library._listening = true
		btn.Text = "..."
		local c
		c = UIS.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Keyboard then
				c:Disconnect()
				listening = false
				Library._listening = false
				if i.KeyCode == Enum.KeyCode.Escape then btn.Text = key.Name else apply(i.KeyCode) end
			end
		end)
	end)

	local item = {}
	item.Set = function(...)
		local k = unself(item, ...)
		if type(k) == "string" then
			local ok, res = pcall(function() return Enum.KeyCode[k] end)
			k = ok and res or nil
		end
		if typeof(k) == "EnumItem" then apply(k) end
	end
	item.Get = function() return key end
	register(o.Flag, item, key.Name)
	return item
end

function Block:CreateColorPicker(o)
	o = o or {}
	local col = o.Default or Color3.new(1, 1, 1)
	local h, s, v = col:ToHSV()

	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1 }, self.Body)
	new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, holder)

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.Element, BackgroundTransparency = 0.25,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = 1,
	}, holder)
	corner(head, 6)
	label(head, o.Name or "Color", 13, { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -62, 1, 0) })
	local swatch = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 34, 0, 18),
		BackgroundColor3 = col, BorderSizePixel = 0,
	}, head)
	corner(swatch, 4)
	stroke(swatch, 0.6)

	local panel = new("Frame", {
		Size = UDim2.new(1, 0, 0, 104), BackgroundColor3 = lighten(T.Second, 0.04), BackgroundTransparency = 0.2,
		BorderSizePixel = 0, Visible = false, LayoutOrder = 2,
	}, holder)
	corner(panel, 6)

	-- Carré saturation / valeur
	local sv = new("Frame", { Position = UDim2.new(0, 8, 0, 8), Size = UDim2.new(1, -40, 1, -16),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0 }, panel)
	new("UICorner", { CornerRadius = UDim.new(0, 4) }, sv)
	local white = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, sv)
	new("UICorner", { CornerRadius = UDim.new(0, 4) }, white)
	new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
	local black = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, sv)
	new("UICorner", { CornerRadius = UDim.new(0, 4) }, black)
	new("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90 }, black)
	local cursor = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 10, 0, 10),
		BackgroundTransparency = 1, BorderSizePixel = 0 }, sv)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, cursor)
	new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }, cursor)
	local svHit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, sv)

	-- Barre de teinte
	local hue = new("Frame", { Position = UDim2.new(1, -26, 0, 8), Size = UDim2.new(0, 18, 1, -16),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, panel)
	new("UICorner", { CornerRadius = UDim.new(0, 4) }, hue)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
		ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
		ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
		ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
		ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
		ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
	}) }, hue)
	local hueMark = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 4, 0, 4),
		Position = UDim2.new(0.5, 0, 0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, hue)
	new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, hueMark)
	local hueHit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, hue)

	local function visuals()
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		cursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueMark.Position = UDim2.new(0.5, 0, h, 0)
		swatch.BackgroundColor3 = col
	end
	local function commit(silent)
		col = Color3.fromHSV(h, s, v)
		if o.Flag then Library.Flags[o.Flag] = { R = col.R, G = col.G, B = col.B } end
		visuals()
		if not silent then fire(o.Callback, col) end
	end

	svHit.InputBegan:Connect(function(i)
		if isPress(i) then
			startDrag(function(p)
				s = math.clamp((p.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
				v = 1 - math.clamp((p.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
				commit()
			end, self.Scroll, i.Position)
		end
	end)
	hueHit.InputBegan:Connect(function(i)
		if isPress(i) then
			startDrag(function(p)
				h = math.min(math.clamp((p.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 1), 0.999)
				commit()
			end, self.Scroll, i.Position)
		end
	end)
	head.MouseButton1Click:Connect(function() panel.Visible = not panel.Visible end)

	local item = {}
	item.Set = function(...)
		local c = unself(item, ...)
		if type(c) == "table" then
			c = Color3.new(c.R or c.r or 1, c.G or c.g or 1, c.B or c.b or 1)
		end
		if typeof(c) ~= "Color3" then return end
		local nh, ns, nv = c:ToHSV()
		if ns > 0.001 and nv > 0.001 then h = nh end
		s, v = ns, nv
		commit()
		-- on garde exactement la couleur demandée
		col = c
		swatch.BackgroundColor3 = c
	end
	item.Get = function() return col end

	commit(true)
	register(o.Flag, item, { R = col.R, G = col.G, B = col.B })
	if Library.FireDefaults then fire(o.Callback, col) end
	return item
end

