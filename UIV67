		Background = Color3.fromRGB(135, 206, 235), FloorColor = Color3.fromRGB(240, 248, 255), Yaw = 180, Pitch = -0.04, RigType = "R6",
		Options = { Box = false, Name = false, Health = false, Distance = false, Floor = true, AutoRotate = false, Wave = true, Animate = true, Emotes = Library.HomeEmotes ~= false } })
	-- première arrivée : animation de bienvenue (2 sauts, bras levés) ; ensuite un petit saut à chaque retour sur Home > Info.
	-- Dans les deux cas le coucou continue en boucle (une fois la lib entièrement chargée). Library.HomeWelcome = false : sauts seuls.
	do
		local welcomed = false
		local function greet()
			if not welcomed and Library.HomeWelcome ~= false then
				welcomed = true
				pv.Welcome()
			else
				pv.Jump()
			end
		end
		local prevSel = tab.OnSelect
		tab.OnSelect = function(...)
			if prevSel then prevSel(...) end
			if tab.CurrentSub == subInfo or tab.CurrentSub == nil then greet() end
		end
		subInfo.OnShow = function() greet() end
		greet()
	end
	prof:CreateButton({ Name = "Actualiser l'aperçu", Favorite = false, Callback = function() pv:Refresh() end })
